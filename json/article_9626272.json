      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND PURPOSE",
          "content": "The purpose of this study was to investigate the general magnitude and relative contributions of anthropometric, lifestyle, and medical history factors and familial aggregation (combined effects of genes and early environment) as determinants of paraspinal muscle cross-sectional area (CSA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "The subjects were 65 pair of male monozygotic twins aged 35 to 65 years (mean = 49, SD = 8)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Study methods included magnetic resonance imaging, percentage body fat determination, and a detailed interview."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Most of the anthropometric factors were associated with the CSAs. Familial aggregation was the strongest determinant, however, explaining 66% to 73% of the variance in the outcomes beyond what age alone predicted. Levels of occupational, sport, and leisure-time physical activities reported by the subjects had negligible effects."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION AND DISCUSSION",
          "content": "The CSAs of the paraspinal muscles were influenced more by some combination of genes and early environmental factors than by anthropometric factors and lifestyle choices in adulthood."
        }
      ]},
