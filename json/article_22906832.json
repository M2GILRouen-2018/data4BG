      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Asociación Española de Pediatría. Published by Elsevier Espana. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Despite there being various guidelines and consensus statements on asthma, great variability still exists in its treatment approach; although this has been little discussed in Emergency Departments (ED)."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe the usual management of asthma exacerbations in Spanish ED, and to determine the degree of variability among different professionals, as well as analyse factors that may influence their management."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "A questionnaire was developed based on clinical cases, which was distributed among members of the Spanish Society of Paediatric Emergencies and attendees at the meeting in 2011."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 300 surveys were analysed. In 190 cases the place of work was in a tertiary care hospital. There was high agreement in the assessment of the severity of the cases mentioned. Over 90% use inhaled β2 agonists in mild asthma exacerbations, 75.3% used oral corticosteroids in moderate exacerbations, and 79% use ipratropium bromide in severe exacerbations. Almost all (98%) considered Therapeutic Education important in the Emergency Department. Only 8 (2.7%) used peak expiratory flow measurements. Respondents working in a tertiary hospital used severity scales more frequently (90.5% vs 80%, P=.009) and administered parenteral corticosteroids less frequently (53.2% vs 66.4%, P=.017)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Although a high percentage of paediatricians working in the ED follow Clinical Practice Guidelines, some different points of the approach among professionals have been identified."
          }
        ]
      },
