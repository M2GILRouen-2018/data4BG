      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the therapeutic effect of lisuride maleate on premenstrual mastalgia in premenopausal women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Double-blind randomized prospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Department of obstetrics and gynecology at a university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Sixty women with premenstrual mastalgia were included in the study. Study and control groups consisted of 30 women each."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Women enrolled in the study and control group were given one tablet daily (0.2 mg) of lisuride maleate or placebo orally for 2 months. Severity of mastalgia was evaluated using the visual analog scale."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Severity of mastalgia and side effects of the drug administered."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Mastalgia subsided significantly in women receiving lisuride maleate compared with controls. There were no significant side effects from lisuride maleate. Prolactin levels decreased significantly in the group receiving lisuride, which correlated well with pain resolution."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Lisuride maleate may be useful for the symptomatic treatment of premenstrual mastalgia."
        }
      ]},
