      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Hanley & Belfus. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Randomized controlled trial."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Two-point discrimination (2PD) test can be used to assess both clinical condition and the effects of therapy in carpal tunnel syndrome (CTS) patients."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE OF THE STUDY",
            "content": "To determine whether there are specific differences in 2PD between symptomatic and asymptomatic hands in CTS patients and to evaluate the impact of 2 therapy regimes on 2PD in patients with CTS."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Therapy for the neurodynamic mobilization group was based on manual therapy and neurodynamic techniques. Therapy for the electrophysical modalities group was based on red and infrared laser and ultrasound therapy using a contact method applied in the transverse ligament area. Therapeutic cycle consisted of 20 therapy sessions delivered at twice-weekly intervals."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After therapy, 2PD in the symptomatic limbs in the neurodynamic mobilization and electrophysical modalities groups significantly improved (p < .001). However, there was no statistically significant difference between the treatment groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Both therapy programs used in this study were beneficial for improving 2PD."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": 2
          }
        ]
      },
