      "Abstract": {
        "CopyrightInformation": "© 2015 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim of this review is to make specialists in a variety of disciplines familiar with basic aspects of spinal cord stimulation and the role of mathematical modeling in understanding its mechanisms of action and the solution of basic problems."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The paper is divided into five sections. The content of each section also covers aspects of various disciplines. Most aspects are presented in an unusual way, likely resulting in new viewpoints and further developments in the growing field of neuromodulation."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A special, integrating role is the mathematical modeling of spinal cord stimulation and the simulation studies of various aspects, such as the stimulation in axial low-back pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In particular the conclusions from several computer simulation studies are relevant and of interest to specialists in many disciplines."
          }
        ]
      },
