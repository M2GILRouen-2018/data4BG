      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the association between antimüllerian hormone (AMH) levels and menstrual-cycle and lifestyle characteristics among young Japanese women."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Female students aged 20-22 years (n=65) who had never used oral contraceptives."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Participants completed a questionnaire on reproductive and lifestyle characteristics, and kept a menstrual-cycle diary for 5 consecutive months. Serum AMH was measured once during the study period."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Serum AMH concentration."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Compared with women with very mild menstrual pain, serum AMH concentration was 49.6% (95% CI 6.5%-72.8%) lower among women with severe menstrual pain. Higher AMH concentration was associated with irregular menstrual cycles. Even after adjusting for menstrual-cycle regularity and its interaction, more-severe menstrual pain was associated with significantly lower AMH concentration."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Circulating AMH concentration was significantly lower among young Japanese women who had more-severe menstrual pain. Underlying physiological mechanisms need to be addressed in future studies."
          }
        ]
      },
