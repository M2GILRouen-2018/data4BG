      "Abstract": {
        "CopyrightInformation": "© 2016 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS AND OBJECTIVES",
            "content": "The aim of this study is to assess the factors associated with self-care agency in postpercutaneous coronary intervention patients."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Patients after percutaneous coronary intervention need to perform self-care to reduce the side effects and increase the quality of life. Self-care agency is considered to be an important factor in guaranteeing self-care actions."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "In this descriptive study a total number of 300 postpercutaneous coronary intervention patients participated. Data were collected from the four hospitals affiliated with Shahid Beheshti University of Medical Sciences in Iran between February-May 2015."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The data were gathered using demographic and basic conditioning factors questionnaire and appraisal of self-care agency scale. Data analysis was performed by anova and t-test."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The mean age of the participants was 62·10 ± (8·14), which included 52·7% men and 47·3% women. Most patients (72%) had good level of self-care agency. Self-care agency had higher level in married and higher income patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Self-care agency is influenced by economic and marital situation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "RELEVANCE TO CLINICAL PRACTICE",
            "content": "Identifying factors associated with self-care agency can help healthcare professionals to consider these factors in self-care planning."
          }
        ]
      },
