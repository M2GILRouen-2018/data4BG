      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To provide an overview of normal sleep, describe common sleep disorders, and discuss underlying sleep regulatory processes and how cancer, cancer treatment, and associated patient responses may adversely affect sleep."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Published peer-reviewed articles and textbooks."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "DATA SYNTHESIS",
          "content": "The duration, structure, and timing of sleep have a profound impact on health, well-being, and performance. Patients with cancer may be at risk for disturbances in sleeping and waking resulting from disease- and nondisease-related circumstances that interfere with normal sleep regulation, including demographic, lifestyle, psychological, and disease- and treatment-related factors."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Patients with cancer are at high risk for sleep-wake disturbances."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "An understanding of normal sleep, sleep pathology, and the factors that can precipitate sleep disturbance provides a context for nurses to interpret sleep complaints in their patients, evaluate responses to sleep-promoting interventions, and guide decision making regarding referrals."
        }
      ]},
