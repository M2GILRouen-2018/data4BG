      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To summarize advances of studies on treatment of dysmenorrhea with acupoint application in recent 10 years so as to provide references and basis for scientific research and clinical works in future."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The literature about treatment of dysmenorrhea with acupoint application in the recent 10 years are reviewed from treatment based on syndrome types, acupoint selection, selection of excipients, application time, assessment of therapeutic effects, adverse effects and other aspects."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Acupoint application has a definite therapeutic effect on dysmenorrhea, but with some problems in clinical research."
        }
      ]},
