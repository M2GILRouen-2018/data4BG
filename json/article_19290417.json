      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To investigate the correlation between interleukin-1 receptor antagonist (IL-1ra) genotype and chronic periodontitis in patients with coronary heart disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Genomic DNA was obtained from buccal swabs in 86 patients with coronary heart disease,of which 45 patients with chronic periodontitis, the other without chronic periodontitis. Genotypes of IL-1RN intron 2 VNTR were analyzed by SSP-PCR method. Then the differences in distribution of each genotype were analyzed with SPSS 13.0 software package."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A significant over-representation of IL-1 RN intron 2 VNTR allele 2 was found in patients with coronary heart disease and chronic periodontitis group (chi(2)=4.960,P=0.026)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "IL-1RN intron 2 VNTR allele 2 may be a risk indicator for the susceptibility of chronic periodontitis in patients with coronary heart disease."
        }
      ]},
