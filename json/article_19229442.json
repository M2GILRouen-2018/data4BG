      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of this study was to analyse the efficacy of multidisciplinary interventions on return to work for people on sick leave due to low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A systematic review of published studies was performed, including a meta-analysis. Identified publications were assessed for relevance and study quality."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A meta-analysis based on 5 studies from Scandinavia verified the scientific evidence for the efficacy of multidisciplinary interventions on return to work."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Although long-term sick leave due to low back pain represents a large problem for the community and multidisciplinary interventions are often advocated, surprisingly few published studies have return to work as an outcome. There is evidence for a clinically relevant effect of multidisciplinary interventions on return to work."
        }
      ]},
