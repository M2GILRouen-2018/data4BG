      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A combined therapy of fluticasone propionate nasal drops (FPND) and functional endoscopic sinus surgery (FESS) can improve quality of life (QoL). When compared with prior data, the results imply that a generic measure of psychological aspects of QoL may be better than measures of respiratory symptoms and clinical parameters to capture a patient's perception of the disease and its treatment."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To better understand effects of FPND and FESS on generic QoL."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Sixty nasal polyposis patients with concomitant asthma completed participation in a randomized, double-blind, placebo-controlled, 14-week study in which they responded to the General Well-Being Schedule (GWBS)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "GWBS scores (i) increased significantly after administration of FPND, independent of FESS (from lower than normal to normal), (ii) increased after FESS independent of FPND (from lower than normal to normal), and (iii) increased additively after FPND and FESS."
        }
      ]},
