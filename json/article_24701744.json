      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "Label": "UNLABELLED",
          "content": "Surgery has proven to be the treatment of choice for distal humerus fractures if one wants to obtain the best results. However, this involves a high degree of complexity and therefore there are poor results."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Is it possible to improve the stability of osteosynthesis for osteoporotic distal humerus fractures using standard plates placed together using a screw 4.5 mm in diameter?"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "In an eight-month period a total of six female patients with distal humerus fractures underwent surgery at IMSS Trauma Emergencies Hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "TECHNIQUE",
          "content": "A 1/3 tubular lateral plate was fixed to a reconstruction plate 3.5 mm medially using a 4.5 mm cortical screw going from lateral to medial."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "ASSESSMENT",
          "content": "The Mayo Scale was used to assess the elbow."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Mean follow-up was 23.3 months; three right and three left elbows were operated; mean age of females was 78.83 years; three excellent, one good and two fair results were reported, and no poor results."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "It is possible to achieve adequate stability with standard implants; good results are obtained."
        }
      ]},
