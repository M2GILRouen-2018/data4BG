      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Telomere shortening is correlated with cell turnover and aging, but it has been recently suggested to occur not only by aging but by several biochemical factors of metabolic disorders predisposing to atherosclerosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "We compared telomere length of peripheral blood mononuclear cells of patients with the metabolic disorders, hypercholesterolemia (HC) and diabetes mellitus (DM), according to the presence or absence of coronary diseases."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The results demonstrated that HC and/or DM patients with coronary diseases have significantly shorter telomere length than healthy controls (p = 0.0014)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Telomere shortening may be involved in the mechanisms that promote coronary diseases under some circumstances of metabolic disorders."
        }
      ]},
