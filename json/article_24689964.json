      "Abstract": {
        "CopyrightInformation": "© 2014 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Studies of autopsies of military members dying in three US wars indicate that the prevalence of atherosclerosis in successive cohorts of healthy young men and women has dramatically decreased over the past half century."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The objective of this study was to compare the decline in the prevalence of atherosclerosis and myocardial infarction with previously published studies on the decline in the prevalence of duodenal ulcer."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A plot of the prevalence of coronary atherosclerosis and the prevalence of myocardial infarction in three cohorts of young men and women born from 1930 to 1980 was constructed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The figure shows a marked decline in prevalence in atherosclerosis beginning in a military cohort born around 1930 and a similar marked decline in prevalence of myocardial infarction in the US population beginning in 1970. In published studies duodenal ulcer began to decline in prevalence in 1960. As duodenal ulcers began to occur at age 30 and myocardial infarctions began to occur at age 40 at the time of peak prevalence, the cohort born in 1930 was the first to experience a decline in prevalence of both duodenal ulcer and heart attacks."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The study shows that the decline in heart attacks is temporally related to the decline in duodenal ulcer and by inference, Helicobacter pylori infection."
          }
        ]
      },
