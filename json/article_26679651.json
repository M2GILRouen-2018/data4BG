      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To elucidate the correlation between urinary 11-dehydro-thromboxane B2 (11dhTxB2) and clinical efficacy of aspirin treatment in patients with type 2 diabete and coronary artery disease (CAD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In this prospective cohort study, 169 aged patients with type 2 diabete accompanying CAD in Peking University First Hospital were enrolled. The level of urinary 11dhTxB2 was detected using enzyme-linked immuno-sorbent assay. Low aspirin response or high on aspirin platelet reactivity (HAPR) was defined as urinary 11dhTxB2>1 500 ng/g. All the included patients were divided into two groups based on the results, HAPR group and No-HAPR group."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Baseline urinary 11dhTxB2 of the patients with type 2 diabete accompanying CAD was (3 687±3 052) ng/g, while the urinary 11dhTxB2 was (1 954±859) ng/g in patients after 100 mg/d aspirin treatment (P<0.001). Prevalence of HAPR in patients with type 2 diabete accompanying CAD were 32.5%. Within a mean follow-up time of 12 months, the outcomes occurred more frequently in HAPR group than in No-HAPR group (P<0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Urinary 11dhTxB2 can be recognized as an effective indicator in evaluating aspirin clinical efficacy of patients with type 2 diabete accompanying CAD."
        }
      ]},
