      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The objective of this study was to assess the effectiveness of apipuncture treatment for central post-stroke pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Two (2) female subjects with central post-stroke pain were treated with apipuncture."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Both patients experienced a reduction in the intensity of pain after receiving apipuncture treatment without adverse effects."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Apipuncture is an effective and safe intervention to treat central post-stroke pain."
        }
      ]},
