      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Guided by a life-course approach to chronic disease, this study examined the ways in which childhood deprivation (low parental education and father's manual occupation) may be associated with coronary heart disease (CHD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Multilevel modeling techniques and a nationally representative sample of Americans above age 50 from the Health and Retirement Study (HRS; N = 18,465) were used to examine childhood and CHD relationships over the course of 6 years (1998-2004)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Having a father with <\/=8 years of education was associated with 11% higher odds of CHD, accounting for demographic characteristics, adult socioeconomic status (SES; education, income, and wealth), CHD risks (diabetes, hypertension, cigarette smoking, and obesity), and other factors (childhood health, exercise, stroke, and marital status)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Policies and programs aimed at improving the conditions of poor children and their families may effectively reduce the prevalence of CHD in later life."
        }
      ]},
