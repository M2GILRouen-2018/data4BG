      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "Ocular signs and symptoms that occurred in people exposed to sarin gas in a subway sarin gas attack were studied."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Among victims of sarin gas exposure, 96 were treated by us."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Ocular signs and symptoms caused by sarin gas exposure included miosis, conjunctival injection, and ocular pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Ocular signs and symptoms spontaneously resolved between three and 21 days after exposure in most cases. Treatment with 0.5% tropicamide ophthalmic solution was effective in decreasing ocular pain."
        }
      ]},
