      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the effectiveness of intravenous steroids at induction of anaesthetic to reduce post-operative nausea and vomiting and pain after adult tonsillectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, double-blind, randomized, placebo controlled trial, with ethical approval, following Consolidated Standards of Reporting Trials guidelines."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "District General Hospital in Scotland, UK."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Seventy-two adults between 16 and 70 years, American Association of Anaethetists (ASA) 1, listed for elective tonsillectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Single dose of either 10 mg of dexamethasone or 2 mL of saline after induction with a consistent anaesthetic technique."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Patients filled in a visual analogue scale relating to pain and post-operative nausea and vomiting for the day of operation and 7 days after operation. The time to first ingestion of food and drink after operation was also noted."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Data completion rate of 64% (46 of 72 patients enrolled). Statistically significant relative decrease (62%P = 0.001) in the incidence of post-operative nausea and vomiting was seen in those treated with dexamethasone. Statistically significant relative decrease (23%P = 0.016) in post-operative pain scores for the day of operation was seen in those treated with dexamethasone. Significant decrease (17.5%, P < 0.001) in mean pain score for seven post-operative days was seen in those treated with dexamethasone. No adverse effects were seen."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Dexamethasone given as a single dose of 10 mg at induction of anaesthesia for adult tonsillectomy is an effective, safe and inexpensive method for reducing morbidity in adult tonsillectomy."
        }
      ]},
