      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Excessive tracheal cuff pressure reduces tracheal mucosal blood flow and increases tracheal morbidity. Inserting a transoesophageal echocardiography (TOE) probe has been shown to increase tracheal cuff pressure."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effect of inserting a TOE probe on tracheal cuff pressure and compare the effect in patients who received a single-lumen endotracheal tube (SLT) with those who received a double-lumen endotracheal tube (DLT)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective, observational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Single-centre trial, study period from October 2013 to January 2014."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Forty-four adult patients scheduled for elective cardiothoracic surgery requiring intraoperative TOE monitoring."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "After tracheal intubation with a SLT (n = 22) or DLT (n = 22), the tracheal cuff was inflated to 18 mmHg (25 cmH2O) with air. Tracheal cuff pressure was monitored continuously for 5 min after inserting the TOE probe."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The primary endpoint was steady-state tracheal cuff pressure after insertion of the TOE probe."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Median (interquartile range, IQR) tracheal cuff pressure stabilised at 3 (2 to 3) min in the SLT group and at 2 (1 to 3) min in the DLT group. Steady-state cuff pressure was significantly higher in the DLT group than that in the SLT group [36.7 (31.3 to 44.1) vs. 31.3 (29.6 to 35.7) cmH2O; (P = 0.03)]. Steady-state cuff pressure more than 40 cmH2O was observed in two patients (18.2%) in the SLT group and nine patients (40.9%) in the DLT group (P = 0.02)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Insertion of a TOE probe increased tracheal cuff pressure in both the SLT and DLT groups. The increase in cuff pressure was greater in patients who received a DLT. Frequent measurement and adjustment of cuff pressure should be emphasised particularly when TOE is used in patients receiving a DLT."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "TRIAL REGISTRATION",
          "content": "Clinicaltrials.gov identifier: NCT02034643."
        }
      ]},
