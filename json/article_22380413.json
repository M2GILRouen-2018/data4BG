      "Abstract": {
        "CopyrightInformation": "© 2012 Blackwell Publishing Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To explore and debate nursing leadership and challenges on organizational and group levels when conducting rehabilitation groups for people suffering from chronic pain."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Group approaches based on cognitive behavioural therapy are generally described as effective. Leadership in group approaches offered to people suffering from chronic pain is a great challenge for nurses on an organizational as well as a group level."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "One overall leader and nine group leaders conducting 13 groups constituted the sample. Qualitative content analysis was used by identifying categories, subthemes and themes."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The results from the content analysis revealed one main theme ('Complexity in nursing leadership') and three subthemes ('Challenges in leadership on organizational level', 'Challenges in leadership on teamwork level' and 'Challenges in leadership on group level'."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The results show how important it is to have firm overall leadership and trained group leaders with a common purpose, interdependent roles and complementary skills, who are thus well prepared to prevent or deal with challenging group processes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR NURSING MANAGEMENT",
            "content": "The leaders of both levels, which are highly interrelated, should have a current theoretical understanding of pain theory, group leadership skills and a cognitive behavioural approach."
          }
        ]
      },
