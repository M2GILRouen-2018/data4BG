      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "This study examines whether experience of famine during late childhood affect late life health."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cross sectional cohort survey carried out from 2001-2004."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Community in Hong Kong."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "1,906 men and 1,826 women aged >or= 65 years living in the community."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "We examined the impact of experience of famine during late childhood, defined as caloric restriction for at least one year, on body mass index, body composition using DEXA, grip strength, walking speed and stride length, blood pressure, and ankle-brachial index,using logistic regression adjusting for various co-variates (age, lifestyle, socioeconomic factors)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Participants who had been exposed to a period of undernutrition in late childhood were shorter, had higher body mass index (BMI) and appendicular lean mass/height2, higher prevalence of recurrent falls, higher prevalence of myocardial infarct, arthritis and back pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Late childhood undernutrition has some adverse impact on late life health and functional outcomes."
        }
      ]},
