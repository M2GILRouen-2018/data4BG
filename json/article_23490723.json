      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Academy of Physical Medicine and Rehabilitation. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine the presence of a fibronectin-aggrecan complex (FAC) in the disk space of persons with chronic low back pain as relates to provocative diskography."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A single-center prospective consecutive case series."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A single private practice setting."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Thirty-seven patients with symptomatic degenerative disk disease of the cervical, thoracic, or lumbar spine undergoing provocative diskography to identify a source of pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Diskographic lavage for analysis was simultaneously performed at each disk level injected during diskography."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Visual analog scale (VAS) pain scores, Pfirrmann magnetic resonance imaging grade, and biochemical analysis of disk material were statistically analyzed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 105 levels in 37 patients had a complete set of data (mean age 43.2 ± 11.9 years; 15 male/22 female). The FAC was present in 43 of 108 levels and in at least one level in 25 of 37 patients. The Pfirrmann magnetic resonance imaging grade did not differ between complex-positive and negative levels (P = .125), nor did the intraoperative VAS (IO-VAS) score for pain by level (P = .206). A significant but loose correlation was found between Pfirrmann grade and IO-VAS (R(2) = 0.4, P < .001), but no significant correlation was found between VAS or IO-VAS and complex concentration (R(2) = 0.08, P = .11 and R(2) = 0.003, P = .5)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The FAC was identified in some painful disks by diskography. There was no significant correlation between the Pfirrmann grade or pre/intraoperative pain scores during diskography and complex concentrations within the disk measured by disk lavage."
          }
        ]
      },
