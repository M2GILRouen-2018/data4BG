      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "RATIONALE",
          "content": "Abdominal cocoon and peritoneal loose body are both rare abdominal diseases."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "PATIENT CONCERNS",
          "content": "The patient reported in this case was a 47-year-old man who suffered from abdominal pain and distension for 3 days."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DIAGNOSIS",
          "content": "X-ray, computed tomography, and magnetic resonance imaging revealed multiple peritoneal loose body and small bowel obstruction, characterized by a total encapsulation of the small bowel with a fibrous membrane."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "The patient underwent surgical treatment and exploratory laparotomy confirmed the diagnosis of abdominal cocoon."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "OUTCOMES",
          "content": "Histopathological examination of pelvic nodules confirmed peritoneal loose body."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "LESSONS",
          "content": "To our knowledge, the herein reported case is the first abdominal cocoon that was accompanied by multiple peritoneal loose body."
        }
      ]},
