      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Excess weight is a key risk factor for chronic disease, and the systematic collection, analysis and reporting of key trends are important to surveillance of overweight and obesity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We used univariate analyses to calculate current prevalence estimates of excess weight among Canadian children and youth."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Almost 1 in 7 children and youth is obese. Rates vary based on sociodemographic factors such as age, sex, socioeconomic status and place of residence. Overall, the rates of excess weight have been relatively stable over the past decade."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ongoing monitoring of childhood obesity will provide useful information to assist with sustained actions to promote healthy weights."
        }
      ]},
