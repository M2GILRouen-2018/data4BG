      "Abstract": {
        "CopyrightInformation": "© 2015 American Academy of Neurology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The objective of this study was to evaluate the association between chronic respiratory diseases (asthma and chronic obstructive pulmonary disease) and spinal cord injury (SCI) in a large representative sample."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Data were compiled from more than 60,000 individuals from the 2010 cycle of the cross-sectional Canadian Community Health Survey (CCHS). Multivariable logistic regression analysis was conducted to examine this relationship, adjusting for confounders, and using probability weighting to account for the CCHS sampling method."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After adjusting for age, sex, and smoking status, SCI was associated with a significant increased odds of asthma (adjusted odds ratio = 1.59 [95% confidence interval 1.11, 2.26]; p < 0.05) and chronic obstructive pulmonary disease (1.87 [1.20, 2.91]; p < 0.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These heightened odds highlight the exigent need for targeted interventions and prevention strategies for respiratory health among individuals with SCI."
          }
        ]
      },
