      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the effect of a land-based, physical exercise program versus water aerobics on low back or pelvic pain and sick leave during pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized controlled clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Three antenatal care centers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "390 healthy pregnant women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "A land-based physical exercise program or water aerobic once a week during pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Sick leave, pregnancy-related low back pain or pregnancy-related pelvic girdle pain, or both."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Water aerobics diminished pregnancy-related low back pain (p=.04) and sick leave due to pregnancy-related low back pain (p=.03) more than a land-based physical exercise program."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Water aerobics can be recommended for the treatment of low back pain during pregnancy. The benefits of a land-based physical exercise program are questionable and further evaluation is needed."
        }
      ]},
