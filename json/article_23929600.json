      "Abstract": {
        "CopyrightInformation": "© 2013 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Debit card payment systems are known to induce more frivolous purchases in adults, but their impact on children is unknown."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "Using a national survey of 2,314 public school students in the United States, food purchases in schools with debit-only systems to those in schools with both debit and cash options are compared."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Students in debit and cash schools purchase more fresh fruit and vegetables and fewer total calories."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Payment systems with cash options have a lower purchase incidence of less healthy foods and higher purchase incidence of more healthy foods."
          }
        ]
      },
