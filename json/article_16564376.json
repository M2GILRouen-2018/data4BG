      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the presence of fungi in the sinus mucosa of patients with and without chronic rhinosinusitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN AND SETTING",
          "content": "Prospective observational study using polymerase chain reaction and conventional culture to detect fungi in the sinus mucosa. Middle meatus mucosal samples were collected from 31 patients with chronic rhinosinusitis and 14 control subjects."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Fungi were detected in 6.5% of subjects with chronic rhinosinusitis and in none of the control subjects using polymerase chain reaction. Fungi were detected in 29% of subjects with the combination of inhalant allergies, nasal polyposis, and asthma. Fungi were detected in none of the subjects without the combination of these three comorbidities (P = 0.03)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Polymerase chain reaction assay appears to be able to detect fungi in chronic rhinosinusitis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SIGNIFICANCE",
          "content": "Fungi may not be implicated in the pathogenesis of most chronic rhinosinusitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "EBM RATING",
          "content": "B-3b."
        }
      ]},
