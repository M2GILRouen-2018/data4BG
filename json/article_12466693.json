      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of this study was to determine whether a common bromelain regimen or common ibuprofen regimen are effective in resolving pain and muscle dysfunction associated with delayed onset muscle soreness of the elbow flexors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A randomized, double-blinded, repeated measures design was used for this study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The study was performed in the Sports Injury Research Lab at an NCAA Division I university."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Forty subjects who had not participated in an upper body resistance-training program 3 months prior to the study, suffered pain or injury in the nondominant arm, or experienced an adverse response to nonsteroidal anti-inflammatory drugs or pineapple (bromelain source) were recruited. Thirty-nine subjects finished the study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Active range of motion (ROM), perceived pain, and peak concentric torque measurements of the nondominant arm were taken prior to and 24, 48, 72, and 96 hours following an eccentric exercise protocol of the elbow flexors. Subjects were assigned to one of four treatment groups (bromelain 300 mg t.i.d., ibuprofen 400 mg t.i.d., placebo t.i.d., and control) and began treatment immediately following the exercise protocol."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "No differences among treatments were observed for any of the dependent variables at any time. ROM deficits and pain peaked between 48 and 72 hours. Peak torque deficiencies were observed between 24 and 72 hours."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Ingestion of bromelain and ibuprofen had no effect on elbow flexor pain, loss of ROM, or loss of concentric peak torque as a result of an eccentric exercise regimen."
        }
      ]},
