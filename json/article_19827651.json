      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To analyse the results of using transesophageal pacing (TEP) for correction of atrial fibrillation of type I (AF)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "The study included 1283 patients with coronary heart disease (CHD) and newly diagnosed AF. All the patients were examined with transthoracic echocardiography, received basic antianginal treatment. AF was corrected with TEP."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Sinus rhythm was reestablished in 83.48% patients, in 67.33% TEP was made without previous antiarrhythmic therapy, in the rest patients with this pretreatment. The best result was observed in pre-pacing administration of amiodaron or its combination with hinidin-durules. Only 2.88% patients retained AF after TEP."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "TEP is an effective method of type I AF treatment."
        }
      ]},
