        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Previous reports of cutaneous neoplastic lesions secondary to Fingolimod treatment among multiple sclerosis patients."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Reporting a case of cutaneous large cell lymphoma in a multiple sclerosis patient during Fingolimod treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Case study."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT",
            "content": "Our patient developed CD30+ cutaneous large cell lymphoma two years after initiation of Fingolimod treatment and her symptoms regressed following the cessation of treatment."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This report indicates that cutaneous lymphoid neoplasms should be considered a possible side effect among patients receiving Fingolimod."
          }
        ]
      },
