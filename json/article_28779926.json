      "Abstract": {
        "CopyrightInformation": "Copyright © 2017. Published by Elsevier Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "This study aimed to investigate the effect of transcutaneous electrical nerve stimulation on labor pain among nulliparous women referred to a hospital in an urban area of Iran."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "Samples were consisted of 90 nulliparous women. They were randomly assigned into three groups with equal number in each groups: experiment group, placebo group and control. Pain was measured using the visual pain severity scale."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "The mean of the severity of labor pain indicated a statistically significant difference after the intervention. The severity of pain indicated a statistically significant difference in the second stage of labor, and 4 h after the labor in the groups. The duration of the first stage of labor was significantly different between the groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The application of transcutaneous electrical nerve stimulation affected pain relief in the first and second stages of labor and 4 h after labor."
          }
        ]
      },
