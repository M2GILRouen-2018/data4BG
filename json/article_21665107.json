      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of this study is to evaluate the effect of different training methods in physiotherapy on pain relief and change in proprioception and kinesthesia of the shoulder. Further, the connections between pain relief and change in motor function of the shoulder will be investigated."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomised trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Ambulatory care."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Two groups of unspecific shoulder pain patients (group1 n = 12, group2 n = 10). One group (n = 8) of non-symptomatic subjects."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "The first shoulder-pain group was trained using flexible foil, whilst flexible bands were used to train the patients in the second group. Training period was 12 weeks."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Pain of the shoulder was evaluated through functional pain assessment (Constant-Murley score) before, halfway through and after intervention. Proprioceptive and kinaesthetic ability was measured by an active-active angle-replication test for the shoulder before and after intervention. The data of the shoulder patients was compared to the group of non-symptomatic subjects."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pain was reduced significantly in both groups (p < .05) whereas no changes were measured for the ability to replicate angles of the shoulder."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This suggests that pain relief in the shoulder is not associated with enhancement of the investigated parameters in motor function."
          }
        ]
      },
