      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Fever can be treated with a higher priority than pain in the pediatric emergency department (ED) population."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The primary objective was to assess whether patients with a fever are treated with acetaminophen or ibuprofen more promptly than they are treated for pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A retrospective descriptive study was performed on all patients between the ages of 3 and 19 years who received acetaminophen or ibuprofen in the pediatric ED from February 1, 2010 to January 31, 2011. The time interval from arrival to treatment with acetaminophen or ibuprofen was compared for those patients with a fever (≥100.4°F) and those without a fever and had reported pain. Other measurable points (time of vital signs, bed assignment, and medication order) on the medical record were compared to further describe any differences."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pediatric patients with fever (n = 1097) received ibuprofen or acetaminophen a median of 54.0 min (interquartile range [IQR], 35.4-89.3 min) after arrival. The corresponding median time for afebrile patients (n = 1861) that received the same medications was 83.2 min (IQR, 52.7-136.1). The difference between medians was 24.6 min (95% confidence interval 21.3-27.9 min)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Fever is treated more promptly than pain in the pediatric ED. This difference is associated with prevailing and largely unfounded concerns about fever and the undertreatment of pain (oligoanalgesia)."
          }
        ]
      },
