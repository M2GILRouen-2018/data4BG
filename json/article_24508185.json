      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the association between body mass index (BMI) and the functional progress of patients with stroke, admitted to a rehabilitation hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A retrospective cohort study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A freestanding university rehabilitation hospital stroke unit."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "All patients (N=819) admitted to the stroke unit of a rehabilitation hospital during the study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Not applicable."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "The primary study outcome measure was the FIM efficiency of patients by BMI category."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "For the 819 patients admitted during the observation period, BMI was compared with FIM score changes per day (FIM efficiency). After adjusting for age and sex, the FIM efficiency differed by BMI. The underweight group had the lowest FIM efficiency, followed by the obese and normal-weight subgroups. The overweight group had the highest FIM efficiency (P=.05) when compared with the obese subgroup."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Among patients admitted to an acute rehabilitation hospital for stroke rehabilitation, overweight patients had better functional progress than did patients in the other weight categories."
          }
        ]
      },
