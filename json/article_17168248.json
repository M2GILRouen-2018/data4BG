      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Both behavioural and physiological factors have been proposed as mechanisms that may explain the negative effect of depression on coronary heart disease (CHD). Our aim is to review some of the most important findings since our prior review."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "We searched MEDLINE, PsycINFO, and other sources for recent studies of candidate mechanisms, with an emphasis on publications since 2002."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Physiological pathways have received far greater attention than behavioural ones in the emerging literature. Recent studies have identified shared genetic determinants, inflammation, blood clotting, and vascular mechanisms as plausible explanatory mechanisms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Future research should focus on relations between behavioural and physiological mechanisms and on the effects of pharmacologic and psychotherapeutic treatments for depression on candidate mechanisms."
        }
      ]},
