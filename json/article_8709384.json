      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "A prospective, randomized, double-blind study was done to determine whether alkalization of prostaglandin E1 decreases pain associated with intracavernous injection."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Ten subjects with a history of pain following at least 70% of injections of prostaglandin E1 received 2 injections of prostaglandin E1, 1 with and 1 without sodium bicarbonate. Patients reported the duration and intensity of pain following each injection."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Comparing injections of prostaglandin E1 with and without bicarbonate, there were no significant differences in number of subjects reporting pain, or duration and intensity of pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Addition of sodium bicarbonate does not alleviate penile pain associated with injection of prostaglandin E1."
        }
      ]},
