      "Abstract": {
        "CopyrightInformation": "© 2011 Wolters Kluwer Health | Lippincott Williams & Wilkins",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Cancer-related fatigue and insomnia are common distressing symptoms and may affect mood and performance status."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The objective of this study was to describe fatigue, sleep, pain, mood, and performance status and the relationships among these variables in 187 patients with newly diagnosed multiple myeloma (MM) and conduct an analysis using the correlates of fatigue."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Data were from baseline measures from the study, using the Profile of Mood States and the Functional Assessment of Cancer Therapy-Fatigue to assess fatigue, the actigraph to measure sleep, the Wong/Baker Faces Pain Rating Scale to assess pain, the Profile of Mood States to assess mood, and the 6-minute walk test along with a back/leg/chest dynamometer to test muscle strength to assess performance status. Data analysis consisted of descriptive statistics, Pearson and Spearman ρ correlations, and multiple regression analysis using fatigue as the dependent variable. All P values were 2-sided, and P<.05 was considered significant."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patients with newly diagnosed MM presented with fatigue, pain, sleep and mood disturbances, and diminished functional performance. The regression model, which included all of these variables along with age, sex, and stage of disease, was statistically significant with a large measure of effect. Mood was a significant individual contributor to the model."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Among patients with MM, fatigue, pain, sleep, mood, and functional performance are interrelated."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR PRACTICE",
            "content": "Interventions are needed to decrease fatigue and pain and to improve sleep, mood, and functional performance."
          }
        ]
      },
