      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To characterize prevalence and features of low back pain (LBP) in Moscow outpatients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "The questionnaire designed in the Rheumatology Institute of Russian Medical Academy was used in the trial performed for a month with participation of 1300 Moscow outpatients aged 18 to 50 years."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "LBP is a frequent cause of consulting a physician in an outpatient practice. Most of the outpatients complained of acute and subacute moderate or severe LBP. This pain often caused disability. Of diagnostic tools most frequent was x-ray investigation of the spine."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Spinal osteochondrosis is the most frequent diagnosis made in LBP outpatients. Detectability of threat marks in LBP patients is not more than 10%."
        }
      ]},
