      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate pain incidence and intensity in patients undergoing septorhinoplasty, and to assess analgesic treatment effectiveness, in the first 7 days after surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective outcomes analysis using visual analogue scale assessment of pain intensity in the first 7 post-operative days."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Fifty-seven patients were enrolled in the study, 29 women and 28 men, aged 18 to 51 years. All were treated for post-traumatic deformity of the external nose and/or nasal septum, with either septorhinoplasty or septoplasty."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In the first 3 days after septorhinoplasty, patients' mean visual analogue scale pain score exceeded the range denoting 'analgesic success', and showed considerable exacerbation in the evening. Patients' pain decreased to a mean score of 15.4 one hour after administration of a nonsteroidal anti-inflammatory drug (metamizole)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Analgesia is recommended for all patients in the first 3 days after septorhinoplasty, especially in the early evening."
        }
      ]},
