      "Abstract": {
        "CopyrightInformation": "Copyright © 2014. Published by Masson Doyma México S.A.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Haemorrhoidal disease is a common disorder. Surgical treatment is indicated in cases of advanced disease. However, postoperative pain, operative time, and technical difficulties have prompted the search for new procedures and improve the existing ones. A modification is proposed to the technique of PPH (Procedure for Prolapse and Haemorrhoids) stapled haemorrhoidectomy that facilitates and standardises the procedure without altering its benefits."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe the postoperative results and short-term evolution of patients with internal haemorrhoidal disease, who underwent stapled mucosectomy with PPH with a modified technique."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "This is a retrospective review of 35 patients who underwent stapled haemorrhoidectomy with a modified technique by the same surgical team."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Twenty-five patients were men (71%) and 10 women (29%). Sixteen patients had grade III internal haemorrhoid disease (46%) and 19 grade IV (54%). The mean operative time was 31 minutes. Six patients had acute urinary retention. There were no cases of severe pain, bleeding, haematoma, stenosis, incontinence, thrombosis, or re-operation. The median hospital stay was 1 day."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The proposed modification of PPH haemorrhoidectomy is performed with greater technical ease without increased morbidity, preserving the advantages of the original technique."
          }
        ]
      },
