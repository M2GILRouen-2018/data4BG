      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 AEC. Publicado por Elsevier España, S.L.U. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Weight loss depends directly on the adhesion to the postoperative diet in patients undergoing a sleeve gastrectomy. The aim of this study is to evaluate the effect of different preoperative feeding patterns and the adhesion to a preoperative diet on short and mid- term postoperative weight loss."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "A prospective study of all morbidly obese patients undergoing a laparoscopic sleeve gastrectomy as a bariatric procedure between 2008 and 2012 was performed. Preoperative feeding patterns and weight loss, preoperatively and postoperatively at 12 and 24 months, were evaluated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 50 patients were included, with a mean preoperative BMI of 51,2+7,9 kg/m(2). All the patients presented a feeding pattern of big eaters, 44% of snackers, 40% of sweet eaters and 48% reported regular ingestion of «light» soft drinks. Mean preoperative excess weight loss (EWL) was 13,4% (range 10-31,4%). At 12 months mean EWL was 83,7% and at 24 months 82,4%. Pre and postoperative EWL showed a direct correlation at 12 and 24 months. Mean EWL was significantly lower in snackers, sweet eaters and those drinking «light» soft drinks regularly."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Preoperative weight loss correlates directly with postoperative weight loss at 1 and 2 years. Snackers, sweet eaters and «light» soft drink consumers, associated with a big eater pattern, achieve a significantly lower postoperative weight loss."
          }
        ]
      },
