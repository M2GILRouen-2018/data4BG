      "Abstract": {
        "CopyrightInformation": "© 2014 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Fibromyalgia is characterized by a diffuse and predominantly axial and chronic pain, for which there is no explicit rationale for treatment options."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This qualitative study aims to understand the medication experience of patients with fibromyalgia and their relationship with the doctors derived from treatment negotiation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A qualitative approach was used, based on interviews with patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING AND PARTICIPANTS",
            "content": "Semi-structured interviews were held in a public hospital, with 35 patients diagnosed with fibromyalgia. Qualitative content analysis was performed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The first axis is centred on the unsuccessful quest for an effective treatment for pain and the feeling of dismissal of patients, who are in search of validation and recognition. The second part of the accounts explains the medication adjustments and the search for collaboration. Developing a model of partnership with the doctor enables the patients to shape their own illness, through the medication."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "It is by mediating their relationship with medication that patients gain access to this state of co-expertise and that they put sense into the collaboration they develop with their doctors. Through this collaboration, useful drugs are identified and adjusted to treat the pain."
          }
        ]
      },
