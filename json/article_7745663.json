      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Report of management of blunt, intrapericardial inferior vena caval injury."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN, MATERIALS AND METHODS",
          "content": "A seven-year-old boy, after falling from the back of a motorcycle, had a laceration of the intrapericardial, inferior vena cava with cardiac tamponade. He presented with hypotension and a distended abdomen. There was no evidence of thoracic trauma."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Laparotomy demonstrated a tensely distended liver without intra-abdominal bleeding. Median sternotomy revealed a vena caval laceration, which was repaired."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Increasing abdominal distention with an enlarging liver suggests traumatic laceration to the suprahepatic vena cava. Vascular repair is best accomplished by median sternotomy."
        }
      ]},
