      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of this study was to identify biological markers for early diagnosis of acute aortic dissection (AAD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "76 patients presented to the emergency room with acute chest pain within 6 h of occurrence were recruited for this study, and AAD diagnosed by aortic CTA. Biomarkers were measured by ELISA. ROC curve and Pearson correlation analysis were used to evaluate the sensitivity and specificity to diagnosis of AAD."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The serum levels of α-SMA, smMHC, sELAF, PC1 and D-dimer were significantly higher in AAD patients than in other groups (P < 0.05). Significant correlations between smMHC, sELAF, PC1, and D-dimer level were observed in AAD. Any combination of two markers showed good sensitivity (94.29%) and specificity (85.37%)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "smMHC, sELAF, PC1, or D-dimer alone is a biomarker for early diagnosis of AAD, but the combination of these markers has significantly higher diagnostic value."
          }
        ]
      },
