      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report an unusual presentation of a patient with unicornuate uterus and a noncommunicating functional rudimentary horn and discuss related patient management issues."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT",
          "content": "A 27-year-old woman who presented with cyclic abdominal pain after a postpartum tubal ligation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Diagnostic studies followed by a laparotomy and resection of the rudimentary horn."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Resolution of patient's symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Patients with a unicornuate uterus and a rudimentary horn recognized for the first time during a tubal ligation require individualized management depending in part on the precise nature of the horn."
        }
      ]},
