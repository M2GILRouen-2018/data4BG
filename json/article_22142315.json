      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Abscesses are one of many complications of diverticulitis and can be found intra-abdominally or in the pelvis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Case report and review of the pertinent English-language literature."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "We describe an unusual presentation of a diverticular abscess, tracking down the inguinal canal and causing acute scrotum possibly secondary to a hernia."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A deviation from the usual clinical presentation of diverticulitis should prompt the physician to obtain further radiologic evaluation. Computed tomography scanning is recommended, especially when an abscess is suspected."
        }
      ]},
