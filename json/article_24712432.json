      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Leptin and total homocysteine (tHcy) may participate in the pathogenesis of coronary artery disease (CAD) through nitric oxide (NO) depletion. We sought to investigate whether leptin, tHcy and NO are suitable predictors of CAD."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS & METHODS",
          "content": "This study contained 50 control subjects and 50 stable and 50 unstable angina patients. Plasma leptin, tHcy and NO levels were determined using enzyme immunoassay, HPLC fluorescence and spectrophotometric methods, respectively. Other conventional risk factors were also determined."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Leptin and tHcy levels were highest in unstable angina patients, followed by stable angina patients and then controls (p < 0.001). Controls had significantly higher NO than patients (p <0.001). Leptin and tHcy had a positive and NO a negative association with the presence of CAD."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Some athrogenic effects of leptin may be mediated by affecting tHcy and NO levels. Plasma leptin, tHcy and NO levels showed significant contribution to CAD prediction and discrimination."
        }
      ]},
