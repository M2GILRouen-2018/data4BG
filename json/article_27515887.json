      "Abstract": {
        "CopyrightInformation": "Copyright © 2016. Published by Elsevier Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate clinical effects of auricular acupuncture treatments for pain based on a revised auricular mapping and diagnostic paradigm (RAMP-uP)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective chart review."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A major US Veterans Affairs Medical Centre located in the Southeaster United States."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Pain and efficacy rating scores based on visual analogue scales during each clinical visit. Duration of acupuncture treatment effects based on clinic notes documentation."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patients' average pain score decreased by almost 60% (p<0.0001). The treatment effects lasted 1-3 months (47%). The overall efficacy reported by most patients was helpful (83.6%)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The observed clinical effects of auricular acupuncture based on RAMP-uP are promising. Further research is needed to assess its feasibility to generalize and generate clinical effects in randomized controlled clinical trials."
          }
        ]
      },
