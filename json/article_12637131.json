      "Abstract": {
        "CopyrightInformation": "© 2015, Copyright the Authors Journal compilation © 2015, The American Geriatrics Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To examine whether sleep disturbance is associated with poor physical function in older veterans in an adult day healthcare (ADHC) program."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "One ADHC program in a Veterans Affairs Ambulatory Care Center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Older veterans (N = 50) enrolled in a randomized controlled trial of a sleep intervention program who had complete baseline data."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Information on participant characteristics (e.g., age, depression, relationship to caregiver, pain, comorbidity) was collected using appropriate questionnaires. Physical function was measured using activity of daily living (ADL) and instrumental ADL (IADL) total scores from the Older Americans Resources and Services Multidimensional Functional Assessment Questionnaire. Sleep was assessed subjectively (Pittsburgh Sleep Quality Index, Insomnia Severity Index) and objectively (wrist actigraphy)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Participants required substantial assistance with ADLs and IADLs. A regression model showed that participant characteristics (marital status, use of sleep medication, comorbidity, posttraumatic stress disorder) and living arrangement (living with a spouse or others) were significantly associated with poor physical function. Poorer objective sleep (total sleep time, total numbers of awakenings, total wake time) was significantly associated with poor physical function, accounting for a significant proportion of the variance other than participant characteristics."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Objective measures of nighttime sleep disturbance were associated with poor physical function in older veterans in an ADHC program. Further research is needed to determine whether interventions to improve sleep will delay functional decline in this vulnerable population."
          }
        ]
      },
