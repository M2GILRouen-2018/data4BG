      "Abstract": {
        "CopyrightInformation": "© The Author [2014]. Published by Oxford University Press. All rights reserved. For Permissions, please email: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Compare efficacy of 0.5% proparacaine eye drops and oral 25% dextrose in reducing pain during screening for retinopathy of prematurity (ROP)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Double-blinded randomized controlled trial. Twenty eligible babies were randomized. Group I received 0.5% proparacaine eye drops at first ROP screening, while Group II received 25% dextrose orally. At second examination, babies received no intervention. Pain was assessed using Premature Infant Pain Profile (PIPP) score."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The mean ( ± SD) PIPP during procedure in Group I were 15.5 ± 2.06 and 14 ± 2.4 at first and second screening (p = 0.259). The mean ( ± SD) PIPP in Group II were 14.2 ± 1. 8 and 14.9 ± 2.5 at the first and second screening (p = 0.428). Differences were not statistically significant. The PIPP scores of Group I and Group II at the first screening were also not significantly different (p = 0.165)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "ROP screening causes moderate to severe pain and neither proparacaine nor dextrose is an effective analgesic."
          }
        ]
      },
