      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To assess the efficacy of local infiltrative anesthesia with lidocaine hydrochloride in patients undergoing the surgical repair of a simple vesico-vaginal fistula."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The study was carried out with 21 patients undergoing the repair of a simple midvaginal vesico-vaginal fistula. The patients' perception of pain was evaluated intraoperatively."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Most patients indicated that the anesthetic agent provided adequate analgesia, and all fistulas were repaired successfully without postoperative complications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Repairing simple vesico-vaginal fistulas is feasible with a local infiltrative anesthetic."
        }
      ]},
