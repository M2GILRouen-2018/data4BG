        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To review research highlights of manuscripts published in 2016 that pertain to all aspects of the clinical practice of anesthesiology."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Narrative review."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "N/A."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS",
            "content": "The major themes address broad categories of general anesthesia including airway management, abdominal surgery, and obstetrical and gynaecological anesthesia. In addition, recent advancements in specialties of anesthesiology including regional anesthesia are reviewed."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "N/A."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "N/A."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This recent body of evidence will both help inform anesthesiologists of the developing trends in anesthesiology and will also pose new challenges for further studies."
          }
        ]
      },
