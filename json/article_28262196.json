      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 IMSS. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND AIMS",
            "content": "Chemerin plays an important role in metabolic syndrome (MetS) including nonalcoholic fatty liver disease (NAFLD). L-carnitine (LC) may reduce plasma glucose, lipid profile, and improve liver function. The aim of the study was to assess serum chemerin in obese children with suspected NAFLD, the effect of LC on NAFLD grade, chemerin and metabolic profile."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Fifty obese children were compared to 50 controls. All were subjected to anthropometric assessment, liver function, fasting lipid profile, glucose/insulin (G/I) ratio, homeostasis model assessment (HOMA) index, serum chemerin and abdominal ultrasonography before and after LC."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Serum chemerin was higher in cases than controls. Eighty percent of cases had NAFLD with increase in chemerin as severity of NAFLD increased. There was a decrease in frequency of NAFLD and its severity after LC therapy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Noninvasive monitoring of serum chemerin in obese patients with suspected NAFLD could be used to diagnose NAFLD. LC supplementation is effective in treatment of NAFLD and reducing chemerin."
          }
        ]
      },
