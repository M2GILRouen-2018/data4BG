      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Different antibiotics, antagonist H2 and others have been used for elimination and/or eradication of Helicobacter pylori."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "Evaluate elimination of Helicobacter pylori with amoxicillin, bismuth subsalicylate and ranitidine; and the improvement of recurrent abdominal pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "20 children with recurrent abdominal pain associated to gastritis and histologic identification of Helicobacter pylori were studied under a period of 18 months (January 1992 to June 1993), at Instituto Nacional de Pediatría, México, D.F. All children were treated simultaneously with: Amoxicillin, 15 days, plus ranitidine and bismuth subsalicylate for one month."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Helicobacter pylori was eliminated in 14 of 20 children studied. All these children had an important improvement of recurrent abdominal pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Elimination of Helicobacter pylori and clinical improvement was present in 14 of 20 children studied (70%)."
        }
      ]},
