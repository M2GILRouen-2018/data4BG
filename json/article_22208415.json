      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To track changes in U.S. children's early weight status (normal, at-risk, or obese) from infancy through preschool."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Patterns of change in individual children's weight status are established using three time points from the Early Childhood Longitudinal Study-Birth cohort."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Nationally representative sample of U.S. preschool children surveyed at 9 months (n = 8900), with follow-up at 2 years (n = 7500) and preschool (n = 7000)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASURES",
          "content": "Individual children's weight status was determined from Centers for Disease Control and Prevention growth charts at multiple time periods."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANALYSIS",
          "content": "Layered, categorical data analysis of changes in weight status patterns at three time periods during infancy through preschool."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Young children whose early weight status was normal tend to retain a normal weight status and not to develop an unfavorable status (at-risk, obese). In contrast, children who were obese at an early age were more likely to have an at-risk or obese weight category at a later age. Overall, both favorable and unfavorable early weight statuses were highly associated with subsequent status at preschool."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Early weight status can provide important information relevant for early entry point prevention and treatment of childhood obesity."
        }
      ]},
