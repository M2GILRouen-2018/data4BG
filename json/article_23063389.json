      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to compare anxiety and pain levels during anesthesia and efficacy of Quicksleeper intraosseous (IO) injection system, which delivers computer-controlled IO anesthesia and conventional inferior alveolar nerve block (IANB) in impacted mandibular third molars."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Forty subjects with bilateral impacted mandibular third molars randomly received IO injection or conventional IANB at 2 successive appointments. The subjects received 1.8 mL 2% articaine."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "IO injection has many advantages, such as enabling painless anesthesia with less soft tissue numbness and quick onset of anesthesia as well as lingual and palatal anesthesia with single needle penetration."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Although IO injection is a useful technique commonly used during various treatments in dentistry, the duration of injection takes longer than conventional techniques, there is a possibility of obstruction at the needle tip, and, the duration of the anesthetic effect is inadequate for prolonged surgical procedures."
          }
        ]
      },
