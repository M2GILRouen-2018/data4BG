      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We developed a measure of allostatic load from electronic medical records (EMRs), which we named \"Index of Cardiometabolic Health\" (ICMH)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Data were collected from participants' EMRs and a written survey in 2005. We computed allostatic load scores using the ICMH score and two previously described approaches."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "We included 1865 employed adults who were 25-59 years old. Although the magnitude of the association was small, all methods of were predictive of SF-12 physical component subscales (all p\u2009<\u20090.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "We found that the ICMH had similar relationships with health-related quality of life as previously reported in the literature."
        }
      ]},
