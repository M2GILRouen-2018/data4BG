      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To investigate the current level of Chinese nurses' knowledge of pain and pain management in older people."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Most research about nurses' knowledge regarding pain has taken place in developed countries; however, limited research in this area has taken place in developing countries and particularly in China."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Registered Nurses (n = 621) in three different hospitals were surveyed with the questionnaire about pain and pain management with respect to older people."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The finding showed that a significant knowledge deficit in this area exists. There were no significant differences among nurses in terms of education background, position and whether or not there was attendance in an educational session on pain management. However, there were statistically significant differences based on age; hospital of employment and clinical area in which employed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This survey suggested that nurses' knowledge of pain in older people should be improved. Basic and continuing education of nurses in this area should be enhanced and their active participation in pain management should be encouraged."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RELEVANCE TO CLINICAL PRACTICE",
          "content": "The findings in this survey highlight a significant pain management knowledge deficit among the nurses in the clinical practice. The findings may help the nurses realize their knowledge deficit in this area and may also suggest curriculum changes for the nurses to improve pain management knowledge."
        }
      ]},
