      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To develop and validate a specific simple measure of insulin sensitivity using oral glucose tolerance test (OGTT) values for lean polycystic ovary syndrome (PCOS) women."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Gynecologic Outpatient Clinic of University Hospital, affiliated with Unit of Gynecologic Endocrinology."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Totals of 201 lean and 198 overweight/obese (ov-ob) nondiabetic PCOS patients were retrospectively selected."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "None."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "All patients underwent OGTT, euglycemic-hyperinsulinemic clamp, and androgenic and biochemical assays. The predictive performance of each insulin resistance (IR) index was analyzed with the use of receiver operating characteristic (ROC) curves."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Higher correlation coefficients with clamp studies were obtained with the Belfiore Area (RS=0.579) and the homeostasis-model assessment (HOMA)-M120 (RS=-0.576) in lean PCOS patients and with the Sib (RS=0.697) in ov-ob PCOS patients. The best predictive index of IR in lean PCOS was a HOMA-M120 value of ≥12.8 or more (area under the ROC curve [AUC] 92.4%). In the ov-ob PCOS population, the best predictive performance was obtained by a Sib of ≤10.2 or less (AUC 85.7%)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "IR should be assessed in all PCOS women, both lean and ov-ob subjects. The HOMA-M120 resulted as a very simple tool, validated specifically for the lean PCOS woman whose cardiometabolic impairment is more frequently misunderstood."
          }
        ]
      },
