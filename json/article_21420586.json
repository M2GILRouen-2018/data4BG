      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 ASCRS and ESCRS. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To assess the prophylactic effect of preoperative application of topical diclofenac on postoperative pain control in patients having photorefractive keratectomy (PRK)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Farabi Eye Hospital, Tehran University of Medical Sciences, Tehran, Iran."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized masked clinical trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In this paired-eye study, patients having bilateral PRK received 1 drop of diclofenac 0.1% in 1 eye and 1 drop of placebo in the fellow eye 2 hours before PRK. Postoperatively, both arms of the trial (both eyes of each patient) received topical diclofenac every 6 hours for 2 days. One day and 2 days postoperatively, patients were asked to rate the perceived pain in each eye using an 11-point verbal numerical rating scale. A trained examiner noted the eye-specific responses."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "All 70 patients (140 eyes) completed the study and were included in the statistical analysis. Twenty-four hours after PRK, patients reported pain scores that were clinically and statistically significantly lower in the eyes pretreated with diclofenac than in the fellow eyes (0.97 versus 2.09) (P=.018). Pain scores at 2 days did not differ significantly (P=.877)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Administration of a single drop of topical diclofenac 0.1% 2 hours before PRK seemed to increase the efficacy of postoperative pain management in a clinically and statistically significant manner."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "FINANCIAL DISCLOSURE",
            "content": "No author has a financial or proprietary interest in any material or method mentioned."
          }
        ]
      },
