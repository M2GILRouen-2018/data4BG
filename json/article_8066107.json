      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND PURPOSE",
          "content": "The purpose of this study was to determine the intertherapist reliability of judgments of stiffness and pain at L-1 to L-5 made using posteroanterior (PA) central pressure testing."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Three pairs of manipulative physical therapists with a minimum of 5 years of experience were asked to rate pain and stiffness in a total of 90 patients with low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Each pair of therapists assessed 30 patients within their own clinic, using their preferred technique to perform an examination using the PA central pressure test at the five lumbar levels. Each pair of therapists recorded their ratings of pain and stiffness. Reliability of judgments was evaluated by intraclass correlation coefficients (ICC) and percentage of exact agreement scores."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The ICC values for pain judgments for the group as a whole ranged from .67 to .72, with agreement scores ranging from 31% to 43%. The ICC values for stiffness judgments ranged from .03 to .37, with agreement scores ranging from 21% to 29%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION AND DISCUSSION",
          "content": "Judgments of stiffness made by experienced manipulative physical therapists examining patients in their own clinics were found to have poor reliability, whereas pain judgments had good reliability. Further investigation of this test is required in order to develop a more reliable method of assessing PA stiffness."
        }
      ]},
