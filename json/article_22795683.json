      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 American Society for Reproductive Medicine. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether laparo-endoscopic single-site surgery (LESS) results in less postoperative pain and a better cosmetic surgical scar compared with conventional laparoscopy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective randomized controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A county hospital in Norway."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Forty women with benign adnexal disease or a hereditary cancer risk scheduled for laparoscopic adnexal surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "LESS or conventional laparoscopy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Postoperative pain 24 hours after surgery."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "There was no difference in pain at 24 hours after surgery, with a mean score of 3.0 (SD 2.1) in the LESS group and 2.5 (SD 1.5) in the conventional laparoscopy group. Significantly more shoulder tip pain was reported by women undergoing LESS compared with those having conventional surgery at 6 and 24 hours after surgery. A high satisfaction with the cosmetic result was reported in both groups, with no significant difference in the Manchester scar scale score."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Although similar levels of postoperative pain are experienced by women having LESS and conventional laparoscopic surgery, women having LESS report significantly more shoulder tip pain compared to those having conventional laparoscopic surgery. This may relate to a significantly longer operation time in the LESS group."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CLINICAL TRIAL REGISTRATION NUMBER",
            "content": "NCT01288599."
          }
        ]
      },
