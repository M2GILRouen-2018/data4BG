      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Electronic reporting of Influenza-like illness (eILI) from primary care was implemented and evaluated in three general medical practices in New Zealand during May to September 2015."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To measure the uptake of eILI and to identify the system's strength and limitations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Analysis of transactional data from the eILI system; comparative study of influenza-like illness cases reported using manual methods and eILI; questionnaire administered to clinical and operational stakeholders."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Over the study period 66% of total ILI cases were reported using eILI. Reporting timeliness improved significantly compared to manual reporting with an average of 24 minutes from submission by the clinician to processing in the national database. Users found the system to be user-friendly."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "eILI assists clinicians to report ILI cases to public health authorities within a stipulated time period and is associated with faster, more reliable and improved information transfer."
        }
      ]},
