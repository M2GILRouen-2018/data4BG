      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Women experience chronic pain and use pain-related health care at higher rates than men. It is not known whether the pain-related health care female veterans receive is consistent with clinical practice guideline recommendations or whether receipt of this care differs between men and women."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to identify whether sex differences in chronic pain management care exist for patients served by the Veterans Health Administration (VHA)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Data on patient demographics, diagnostic criteria, and health care utilization were extracted from VHA administrative databases for fiscal year 2010 (FY10)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Patients in this study included all VHA patients (excluding metastatic cancer patients) who received more than 90 days of a short-acting opioid medication or a long-acting opioid medication prescription in FY10 study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASURES",
            "content": "Multilevel logistic regressions were conducted to identify sex differences in receipt of guideline-recommended chronic pain management."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 480,809 patients met inclusion criteria. Female patients were more likely to receive most measures of guideline-recommended care for chronic pain including mental health assessments, psychotherapy, rehabilitation therapy, and pharmacy reconciliation. However, women were more likely to receive concurrent sedative prescriptions, which is inconsistent with guideline recommendations. Most of the observed sex differences persisted after controlling for key demographic and diagnostic differences."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Findings suggest that female VHA patients are more likely to receive an array of pain management practices than male patients, including both contraindicated and recommended polypharmacy. Quality improvement efforts to address underutilization of mental health and rehabilitative services for pain by male patients and polypharmacy in female patients should be considered."
          }
        ]
      },
