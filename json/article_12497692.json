      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A viable intrauterine pregnancy with salpingitis has been reported rarely."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "A 27-year-old woman at 10 weeks' gestation developed abdominal pain, fever, leukocytosis, peritoneal signs, closed cervix and a viable pregnancy. Progression from acute salpingitis to septic abortion was documented."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Acute salpingitis in the presence of a viable pregnancy warrants aggressive intervention."
        }
      ]},
