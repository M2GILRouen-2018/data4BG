      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Microsurgical spermatic cord denervation (MSCD) is an effective surgical technique to manage chronic orchalgia, but it has not been readily adopted by Canadian urosurgeons. This paper reviews the early experience of a single urosurgeon in Canada."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Nine consecutive testicular units underwent MSCD over a 24 month period. These patients underwent MSCD after ruling out reversible causes and after a successful diagnostic spermatic cord block."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of these patients, 77% (7/9) had a complete resolution and 22% (2/9) had a partial resolution of their pain symptoms following MSCD. There were no failures or complications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "MSCD is an effective, safe, and reproducible surgical technique that should be included in the treatment armamentarium for chronic orchalgia."
        }
      ]},
