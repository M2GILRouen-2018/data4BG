      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report a case of CRB1-associated retinal dystrophy characterized by vitritis, retinal capillaritis, and cystoid macular edema (CME)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A case report."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "An 8-year-old boy was diagnosed with intermediate uveitis and treated with corticosteroids. He was subsequently diagnosed with retinal dystrophy and found to have two CRB1 mutations."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Retinal capillaritis, vitritis, and CME could be inflammatory features of CRB1 retinal dystrophy in our young patient."
        }
      ]},
