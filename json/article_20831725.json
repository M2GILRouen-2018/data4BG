      "Abstract": {
        "CopyrightInformation": "© 2010, Copyright the Authors. Journal compilation © 2010, The American Geriatrics Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To determine whether foot pain and plantar pressure are associated with falls in community-dwelling older adults."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Community-based cohort study with 12-month prospective falls follow-up."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Sydney and Illawarra statistical regions of New South Wales, Australia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Randomly recruited, community-dwelling adults (158 men and 154 women) aged 60 and older."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Manchester Foot Pain and Disability Index to establish baseline foot pain and dynamic plantar pressures. Participants were then classified as fallers (n=107) or nonfallers (n=196) based on their falls incidence over the following 12 months."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Fallers had a significantly higher prevalence of foot pain than nonfallers (57.9% vs 42.1%; chi-square=4.0; P=.04). Fallers also generated a significantly higher peak pressure and pressure-time integral under the foot than non-fallers. In addition, individuals with foot pain had a significantly higher peak pressure and pressure-time integral under the foot than those without foot pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "High plantar pressures generated during gait may contribute to foot pain and risk of falls. Providing interventions to older people with foot pain and high plantar pressures may play a role in reducing their falls risk."
          }
        ]
      },
