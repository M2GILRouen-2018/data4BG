      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To review our experience with diagnostic and operative transvaginal hydrolaparoscopy (THL), a procedure that is less invasive than operative laparoscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, observational cohort study (Canadian Task Force classification II-2)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Private institute and university-affiliated hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Twenty-nine women with infertility and 11 with pelvic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Diagnostic and operative THL."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Thirty-five (88%) diagnostic THLs were performed in the office and the other five were done in hospital for insurance reasons; all six operative THLs were performed in the office under conscious sedation. The procedure was conclusive (all organs seen) in 37 patients (93%). Based on THL, no further surgical intervention was recommended in 18 (62%) infertile women and 5 (45%) of those with pain. Further surgical intervention was required in 5 (56%) of 9 infertility patients with a previous normal hysterosalpingogram (HSG) and 6 (32%) of 19 infertility patients with no previous HSG."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Transvaginal hydrolaparoscopy can be performed in the office with minimal pain, with a conclusive examination anticipated in 93% of cases. The procedure is more accurate than HSG and similar to laparoscopy."
        }
      ]},
