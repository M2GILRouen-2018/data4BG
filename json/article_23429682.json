      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a unique case of sciatica secondary to sciatic neuritis developed after spine decompression surgery."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Sciatica may arise within the spinal canal, the pelvis, or along the extrapelvic journey of the nerve. Sciatica after spine surgery is less common and can be secondary to nerve root compression from hematoma, seroma, or abscess. The purpose of this article was to present a unique case of a 68-year-old female with sciatica secondary to sciatic neuritis developed after lumbar decompression surgery complicated by dural tear."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A single patient with radicular leg pain after lumbar decompression surgery is reported."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pelvic magnetic resonance imaging revealed marked left sciatic nerve inflammation. The patient showed immediate pain relief after steroid administration."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This is the first reported case of sciatica secondary to sciatic neuritis developed after spine decompression surgery."
        }
      ]},
