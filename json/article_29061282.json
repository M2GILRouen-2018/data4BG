      "Abstract": {
        "CopyrightInformation": "Copyright © 2017. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Postoperative pain management is a major contributor to recovery and discharge in bariatric surgery. Local anesthetic agents are of particular interest: they're non-sedating and may reduce postoperative pain and hospital length of stay (LOS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Researchers queried the Bariatric Surgery Service Database for patients undergoing laparoscopic weight loss surgery from January 2012-December 2014. Patients were divided between those who did and did not receive liposomal bupivacaine intra-operatively. Measures included demographics, narcotic use, LOS, antiemetic use, and pain scales."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The liposomal group consisted of 233 patients and the PCA group consisted of 243 patients. The liposomal group had significantly less narcotic use than the PCA group in terms of IV morphine equivalents. This did not translate into a reduction in LOS in the liposomal group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "TAP block using liposomal bupivacaine provides effective analgesia comparable to PCA."
          }
        ]
      },
