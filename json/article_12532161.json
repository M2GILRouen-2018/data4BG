      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Identification of weight change patterns may allow tailored interventions to improve long-term weight loss."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To identify patterns of weight change over 18 months, and assess participant characteristics and intervention adherence factors associated with weight change patterns in a sample of 359 overweight/obese adults."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Weight loss (0-6 months) was achieved with reduced energy intake and increased physical activity (PA). Maintenance (7-18 months) provided adequate energy to maintain weight and continued PA."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Latent profile analysis identified three weight change profiles. During weight loss/maintenance, participants in profiles 2 and 3 (18-month weight loss ∼14 %) attended more behavioral sessions and performed more PA compared with profile 1 (18-month weight loss <1 %). Self-efficacy for both weight management and exercise barriers were higher in profiles 2 and 3 compared with profile 1 following weight loss and during maintenance."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Weight change patterns can be identified and are associated with both participant characteristics and intervention adherence."
        }
      ]},
