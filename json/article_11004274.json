      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report acute angle-closure glaucoma associated with albuterol nebulizer treatment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Case report and review of the relevant literature."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In a 75-year-old woman with asthma, acute angle-closure glaucoma in the right eye was probably caused by local absorption of albuterol after nebulizer administration."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "As albuterol is widely used in the management of patients with asthma, increased awareness by health care professionals of the potential for acute angle-closure glaucoma secondary to albuterol may decrease the incidence of this complication."
        }
      ]},
