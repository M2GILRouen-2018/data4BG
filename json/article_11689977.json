      "Abstract": {
        "CopyrightInformation": "Copyright 2001 by the American Congress of Rehabilitation Medicine and the American Academy of Physical Medicine and Rehabilitation",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the validity, reliability, and responsiveness of the fingertip-to-floor test to assess total mobility when bending forward in standing position."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Experimental, prospective, correlational."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Rehabilitation and radiology departments in a university hospital in France."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Ten patients (6 women, 4 men; mean age, 42yr) with chronic low back pain (LBP) in the validity study; 32 LBP patients (16 women, 16 men; mean age, 52yr) in the reliability study; and 72 LBP patients (22 women, 50 men; mean age, 30yr) in the responsiveness study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Dynamic radiographs and fingertip-to-floor test."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "For the validity study, 2 lateral radiographs of the upper dorsal spine, 1 in neutral position, and then 1 in full trunk flexion, were made. Validity was assessed by means of Spearman's correlation coefficient. Reliability was studied by using intraclass correlation coefficient (ICC) and the Bland and Altman method. Responsiveness was assessed by the effect size and the standardized response mean (SRM)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The Spearman's correlation coefficient for trunk flexion assessed by the test and the radiologic measure was excellent (r(s) = -.96). The intra- and interobserver reliability were excellent (ICC = .99). The Bland and Altman method showed no systematic trend. The values observed for the test were .97 for SRM and .87 for effect size."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Because the fingertip-to-floor test has excellent validity, reliability, and responsiveness, it can be used in clinical practice and therapeutic trials."
          }
        ]
      },
