      "Abstract": {
        "CopyrightInformation": "© 2017 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "The purpose of this analysis is to determine US minority nurses' job satisfaction and turnover using three outcome variables: job dissatisfaction; change of jobs; and intent to quit."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "A balanced nursing workforce is essential for supporting a racially diverse nation. Understanding minority nurses' job satisfaction is the first step in achieving this balance."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A secondary data analysis was conducted using the 2008 National Sample Survey of Registered Nurses. The association between race and job satisfaction was examined using logistic regression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Black nurses were more likely to intend to quit than white ones (OR = 1.46, 95% CI = 1.31-1.64), as were Hispanics (OR = 1.35, 95% CI = 1.18-1.55). Asians were less dissatisfied (OR = 0.69, 95% CI = 0.57-0.84), and less likely to have changed jobs (OR = 0.71, 95% CI = 0.60-85) or intend to quit (OR = 0.84, 95% CI = 0.75-0.95) than white nurses."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This analysis demonstrated that black and Hispanic nurses are more likely to intend to quit, even while controlling for dissatisfaction. The reasons for this, and the increased job satisfaction demonstrated by Asian nurses, are directions for future research."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR NURSING MANAGEMENT",
            "content": "Nurse managers should endeavour to create a workplace free of discrimination. Efforts to increase the job satisfaction of all nurses are of equal importance."
          }
        ]
      },
