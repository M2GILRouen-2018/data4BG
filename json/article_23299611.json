      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "IMPORTANCE",
          "content": "Continuous morphine infusion as standard postoperative analgesic therapy in young infants is associated with unwanted adverse effects such as respiratory depression."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether intravenous paracetamol (acetaminophen) would significantly (>30%) reduce morphine requirements in neonates and infants after major surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN, SETTING, AND PATIENTS",
          "content": "Single-center, randomized, double-blind study conducted in a level 3 pediatric intensive care unit in Rotterdam, The Netherlands. Patients were 71 neonates or infants younger than 1 year undergoing major thoracic (noncardiac) or abdominal surgery between March 2008 and July 2010, with follow-up of 48 hours."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "All patients received a loading dose of morphine 30 minutes before the end of surgery, followed by continuous morphine or intermittent intravenous paracetamol up to 48 hours postsurgery. Infants in both study groups received morphine (boluses and/or continuous infusion) as rescue medication on the guidance of the validated pain assessment instruments."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Primary outcome was cumulative morphine dose (study and rescue dose). Secondary outcomes were pain scores and morphine-related adverse effects."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The cumulative median morphine dose in the first 48 hours postoperatively was 121 (interquartile range, 99-264) μg/kg in the paracetamol group (n = 33) and 357 (interquartile range, 220-605) μg/kg in the morphine group (n = 38), P < .001, with a between-group difference that was 66% (95% CI, 34%-109%) lower in the paracetamol group. Pain scores and adverse effects were not significantly different between groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION AND RELEVANCE",
          "content": "Among infants undergoing major surgery, postoperative use of intermittent intravenous paracetamol compared with continuous morphine resulted in a lower cumulative morphine dose over 48 hours."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "TRIAL REGISTRATION",
          "content": "trialregister.nl Identifier: NTR1438."
        }
      ]},
