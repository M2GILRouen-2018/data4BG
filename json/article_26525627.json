      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study emotional state and parameters of cognitive evoked potentials (P300) to target emotional stimuli in patients with chronic back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "A study included 62 patients. Trait and state anxiety was measured using the Spilberger-Khanin questionnaire. Cognitive evoked potentials were investigated."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RESULTS AND CONCLUSION",
          "content": "The changes in parameters and topographic distribution of cognitive evoked potentials to target emotional stimuli in patients with chronic back pain with different emotional/affective states were identified. Recording of P300 elicited by emotional stimuli allows to evaluate the characteristics of chronification of pain syndromes."
        }
      ]},
