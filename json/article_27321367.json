      "Abstract": {
        "CopyrightInformation": "© 2016 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "WHAT IS KNOWN AND OBJECTIVE",
            "content": "Calciphylaxis is a rare and potentially life-threatening cause of skin necrosis and is poorly recognized by clinicians in non-uraemic patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE DESCRIPTION",
            "content": "We report five cases of warfarin-induced calciphylaxis in patients with normal renal function. In four cases, sodium thiosulphate was successfully used as a treatment. No other predisposing factors besides obesity and warfarin were found in these patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "WHAT IS NEW AND CONCLUSION",
            "content": "Previously only few cases of solely warfarin-induced calciphylaxis have been described. Treatment with sodium thiosulphate has shown promising results, and there is thus a need to improve the recognition of calciphylaxis."
          }
        ]
      },
