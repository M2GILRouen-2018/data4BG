      "Abstract": {
        "CopyrightInformation": "Published by Elsevier Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The initial nursing clinical practice is the necessary practicum required for nursing students. Because of the changing learning style, many of them are under great pressure for environmental change and therefore their daily routine is severe affected. Interacting directly with patients in a female-dominated occupation, along with the general gender stereotypes, the impact is especially significant to male nursing students than to female nursing students."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose of this preliminary qualitative study is to explore the gendered experiences of male nursing students during their first initial nursing clinical practice."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Both focus group interviews and individual interviews are conducted with twenty-two sophomore nursing students from a university of technology in northern Taiwan, with ten male students and twelve female students."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Two main themes emerge from the gendered experiences shared by the nursing students: Gender consciousness awakening and thus maintaining masculinity, and male advantage in the learning environments."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The results identify the specific gendered experiences of nursing students, providing implications for future nursing education and counseling service. Further, this study may serve to promote an active yet gender-sensitive nursing education for training nursing professionals."
          }
        ]
      },
