      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine if there was a relationship between level of somatic awareness and coronary artery disease (CAD) in women with chest pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive, correlational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Urban, university-affiliated, tertiary care hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "Fifty-five women without a previous history of heart disease admitted to the hospital for evaluation of chest pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASURES",
          "content": "Modified Somatic Perception Questionnaire (MSPQ); Patterson and Horowitz clinical criteria for classification of chest pain; Supplemented Rose Questionnaire for angina; age; and CAD risk factors."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A small but significant inverse correlation was found between level of somatic awareness as measured by MSPQ scores and degree of CAD (r = 0.2932, p < 0.05). MSPQ scores significantly differed between women with CAD (lower scores) and women without CAD (higher scores) (p < 0.05). MSPQ score was the most important factor in a logistic regression model that modestly but significantly predicted presence or absence of CAD."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Somatic awareness may be an important factor to consider in evaluating the awareness and response of women to symptoms of myocardial ischemia and to chest pain of both cardiac and noncardiac etiologies."
        }
      ]},
