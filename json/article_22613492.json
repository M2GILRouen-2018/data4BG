      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 International Federation of Gynecology and Obstetrics. Published by Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the effects of epidural analgesia on uterine artery, umbilical, and fetal cerebral Doppler velocities during labor."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In a prospective study at Beaujon Hospital, Paris, France, between September and December 2010, uterine artery, umbilical, and fetal cerebral Doppler flow velocities were measured in 12 pregnant women during spontaneous labor with epidural analgesia. The data were registered in a period of uterine relaxation before, and 20 and 60 minutes after the first administration of epidural analgesic drugs. The changes in Doppler velocimetry values and fetal heart rate after epidural analgesia were analyzed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Uterine artery velocities, but neither umbilical nor fetal cerebral Doppler velocities, were decreased significantly at 20 minutes and 1 hour after epidural analgesia (P<0.005). Women with the greatest decrease in uterine artery Doppler flow velocities delivered neonates with the lowest values of umbilical artery blood pH."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The data suggest that the Doppler flow velocity of uterine arteries is affected by epidural analgesia during labor. Numerous Doppler flow studies of the effect of neuraxial blockade during labor on umbilical and uterine arteries have been published with incredibly variable and inconsistent results."
          }
        ]
      },
