      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate the self-esteem and quality of life in adolescents with extreme obesity before and one year after laparoscopic sleeve gastrectomy as obesity is a major challenging medical problem, not only in adults but also in children and adolescents in Saudi Arabia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In a prospective cohort study, 32 adolescents (aged 13-17 years) with extreme obesity (Group 1) presenting for laparoscopic sleeve gastrectomy (LSG) were compared with 32 matched, healthy, nonobese adolescents (aged 14-17 years) (Group 2) with regards to self-esteem and quality of life. Assessment was done using the Rosenberg Self-Esteem Scale and Pediatric Quality of Life Inventory version 4.0 (self- and parent report), respectively. Body mass index (BMI) Z scores were calculated for both groups."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We found significantly poor self-esteem and impairment in all domains of quality of life (self- and parent report) in Group 1 compared with Group 2 (P<.001). Self esteem and quality of life (self- and parent reports) significantly improved 1 year after LSG (P<.001), and the weight loss induced by LSG, reflected by a decrease in BMI Z scores, was a significant predictor for the improvement in self-esteem (R2=0.28 and P=.003) and quality of life (R(2)=0.67 and P<.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "LSG was found to be a safe and effective operation in adolescents with extreme obesity: LSG leads to weight loss, with subsequent improvement in self-esteem and quality of life."
          }
        ]
      },
