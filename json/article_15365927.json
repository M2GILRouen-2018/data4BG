      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Ketorolac is a potent nonsteroidal analgesic agent used to treat postoperative pain. It produces excellent analgesia without the sedating side effects of opioid analgesics. Routine use of ketorolac after cardiac surgery is limited by concerns of bleeding complications. The purpose of this study was to evaluate the risk of bleeding complications of ketorolac for treatment of pain after congenital heart surgery in infants and children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective randomized, controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Pediatric cardiac intensive care unit in tertiary teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Seventy infants and children, median age 10 months (range 2.5-174), who underwent congenital heart surgery requiring cardiopulmonary bypass were randomized in the trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Pain control was performed with ketorolac and opioid analgesics in one arm of the study and opioid analgesics alone in the other arm."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "The main outcome evaluated was bleeding complications measured by chest-tube drainage and wound and gastrointestinal bleeding."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Thirty-five patients were randomized to each treatment arm. In the ketorolac group, the median chest-tube drainage was 13.3 (range 4-22) mL/kg/d, no patient had significant wound bleeding, and 1 (0.03%) patient had gastrointestinal bleeding. In the control group, the median chest-tube drainage was 16.5 (range 3-24) mL/kg/d, 1 (0.03%) patient had wound bleeding, and no patient had gastrointestinal bleeding."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ketorolac can be used to treat pain after congenital heart surgery without an increased risk of bleeding complications."
        }
      ]},
