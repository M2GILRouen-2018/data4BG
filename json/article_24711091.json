      "Abstract": {
        "CopyrightInformation": "© 2014 Association of Rehabilitation Nurses.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose of our study was to present options for the application of tensegrity massage to manage pain caused by the overload of soft tissues in musicians."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Tensegrity massage was applied to a 34-year-old male violinist."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The methodology included a correct positioning and tensegrity massage with individually designed procedure."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "After therapy, the patient achieved complete pain relief, and relaxation of muscles in the shoulder girdle and free part of the upper arm. The analgesic effect lasted for 6 months after the end of therapy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Massage is an effective method in eliminating pain caused by the overload of soft tissues. If used regularly before physical effort, it can prevent muscle overload."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL RELEVANCE",
            "content": "The presented massage procedure is an effective therapy in pain caused by the overload of soft tissues in musicians and it can be one of the elements of complex physiotherapy in active musicians."
          }
        ]
      },
