      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To compare lower-limb overuse injury and low back pain incidence among cadets with and without limb length inequality (LLI) over 1 year of military training and athletic participation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 1,100 cadets were screened for LLIs; 126 of 1,100 were identified to have a LLI of > 0.5 cm and were assigned a matched control cadet. Injury rates, numbers of visits to sick call, and numbers of days spent on medical excusal during a 1-year period were then compared for the 252 cadets."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was no difference in prevalence of injury between the groups and no significant differences (p > 0.05) between the groups in injury rates, visits to sick call, or number of days spent on medical excusal."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These findings do not support any increased incidence of injuries in a young, healthy, athletic, military population with mild LLIs, compared with matched control subjects without LLIs, over 1 year."
        }
      ]},
