      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Hanley & Belfus. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Randomized controlled trial."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE OF THE STUDY",
            "content": "To study the effect of adding rotator cuff (RC) muscles strengthening to joint mobilization and transcutaneous electrical nerve stimulation (TENS) in patients with adhesive capsulitis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A prospective, parallel-group, randomised clinical trial was conducted on 42 patients. One group received TENS and joint mobilization and in the other group RC muscles strengthening was added. Treatment was given for 12 sessions within 4 weeks."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "When compared between the groups statistically significant changes were seen in all the outcome measures in the group that received RC muscle strengthening exercises vs TENS and mobilization. VAS 12.76 ± 1.04 vs 4.05 ± 1.32; SPADI 34.66 ± 6.69 vs 54.29 ± 12.17; PFPS 3.06 ± 0.80 vs 4.70 ± 0.81; and ROM (elevation >125 vs >110 degrees and rotations >70 vs >48 degrees)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Addition of a structured RC strengthening program to TENS and joint mobilization in the treatment of adhesive capsulitis resulted in improvement in pain, ROM and function."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "1b."
          }
        ]
      },
