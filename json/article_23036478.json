      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The effect of obesity on ovarian follicular suppression in women using low-estrogen dose contraceptive patches has not been determined."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "A Phase II, parallel-group, multicenter, three-cycle study evaluated three patches containing different ethinyl estradiol (EE) and levonorgestrel (LNG) doses. Serum levels of EE, LNG, sex hormone-binding globulin and progesterone were compared in 41 obese [body mass index (BMI) ≥30] and 75 nonobese (BMI <30) women."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Suppression of ovulation during the luteal phase was dose dependent, with the highest dose (AG200-15) preventing progesterone increases in all women (cycles 2-3). In the follicular phase, the lowest-dose patch had the highest rate of increased progesterone in nonobese subjects. Progesterone levels ≥3.0 ng/mL in the follicular phase were more common in obese than nonobese women."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "AG200-15 suppresses ovulation in obese and nonobese women. All three patches found increased progesterone in the follicular phase, albeit more in obese versus nonobese women."
          }
        ]
      },
