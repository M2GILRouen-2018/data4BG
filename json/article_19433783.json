      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© The Author 2015. Published by Oxford University Press.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "MOTIVATION",
            "content": "Approaches to identifying new risk loci, training risk prediction models, imputing untyped variants and fine-mapping causal variants from summary statistics of genome-wide association studies are playing an increasingly important role in the human genetics community. Current summary statistics-based methods rely on global 'best guess' reference panels to model the genetic correlation structure of the dataset being studied. This approach, especially in admixed populations, has the potential to produce misleading results, ignores variation in local structure and is not feasible when appropriate reference panels are missing or small. Here, we develop a method, Adapt-Mix, that combines information across all available reference panels to produce estimates of local genetic correlation structure for summary statistics-based methods in arbitrary populations."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We applied Adapt-Mix to estimate the genetic correlation structure of both admixed and non-admixed individuals using simulated and real data. We evaluated our method by measuring the performance of two summary statistics-based methods: imputation and joint-testing. When using our method as opposed to the current standard of 'best guess' reference panels, we observed a 28% decrease in mean-squared error for imputation and a 73.7% decrease in mean-squared error for joint-testing."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "AVAILABILITY AND IMPLEMENTATION",
            "content": "Our method is publicly available in a software package called ADAPT-Mix available at https://github.com/dpark27/adapt_mix."
          }
        ]
      },
