      "Abstract": {
        "CopyrightInformation": "© 2011, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The study sought to determine if race/ethnicity, age, gender, and poverty index influence the development of overweight (OW) or obesity (OB) in children 6-11 years of age and whether a desirable time to intervene could be established."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A descriptive and comparative analysis was conducted using data from the 1999-2008 National Health and Nutrition Examination Survey."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Advancing age was the single largest predictor of OW or OB followed by race/ethnicity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Culturally sensitive interventions targeting children in their early elementary school years could reduce the consequences of OW and OB in childhood."
          }
        ]
      },
