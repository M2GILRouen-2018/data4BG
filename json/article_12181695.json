      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND PURPOSE",
          "content": "We report a case of sudden onset pharyngeal pain due to dissection of the vertebral artery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE DESCRIPTION",
          "content": "A 65-year-old patient presented with sudden onset of unilateral pharyngeal pain, which was first, diagnosed as idiopathic glossopharyngeal neuralgia. Magnetic resonance image and cerebral angiography revealed a dissecting vertebral artery aneurysm. The anatomical site of the aneurysm may explain this complication."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Sudden onset of pharyngeal pain, although rare, should be considered as a complication of dissection of the vertebral artery even though there are no other general or neurological symptoms."
        }
      ]},
