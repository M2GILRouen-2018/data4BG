      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the genetic cause for two children with omphalocele."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The patients were examined, and the medical history of their families was collected. Methylation-specific multiplex ligation-dependent probe amplification (MS-MLPA) was performed to detect potential mutation in the patients."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Loss of methylation of imprinting center 2 (IC2) at the 11p15.5 region of the maternal chromosome was detected in both children."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The two patients were diagnosed with Beckwith-Wiedemann syndrome by MS-MLPA. The loss of methylation of IC2 probably underlies the disease in both patients."
        }
      ]},
