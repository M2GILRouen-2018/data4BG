      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To compare postoperative morphine use, analgesic efficacy, and side effect profiles in patients following orthotopic liver transplantation (OLTx) and liver resection (LR)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Liver transplant and liver resection surgery at a university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "25 ASA physical status I, II, III, and IV patients undergoing OLTx or liver resection."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Morphine use was significantly decreased in the OLTx patients at 6,12, 24, 48, and 72 hours following commencement of patient-controlled analgesia. After commencement of patient-controlled analgesia, pain scores were significantly reduced in the OLTx group compared with those in the liver resection group at 6 and 12 hours."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Orthotopic liver transplant patients experienced less pain and used less morphine postoperatively than did liver resection patients."
        }
      ]},
