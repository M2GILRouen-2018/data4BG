      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To establish the validity and clinical usefulness of a modified pain assessment scale, the Pain Assessment in Neonates (PAIN) scale."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Correlational design to compare scores obtained on the PAIN with scores obtained on the Neonatal Infant Pain Scale (NIPS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "A convenience sample of 196 neonates from an NICU and a step-down unit with gestational ages of 26 to 47 weeks."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Bedside nurses observed the neonates for two minutes and then scored their responses on both scales. The scales were scored sequentially and in a randomized order."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME VARIABLE",
          "content": "Correlation of individual item scores and total scores on the PAIN and the NIPS."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The scores for individual items on the PAIN were significantly associated with scores obtained on the NIPS. Overall correlation between the scales was 0.93. These associations suggest that the PAIN is a valid scale for assessment of neonatal pain."
        }
      ]},
