      "Abstract": {
        "CopyrightInformation": "Copyright Â© 2011 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To determine if epidural anesthesia is a reasonable technique for anterior lumbar interbody fusion."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective chart review."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Academic university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "The charts of patients who underwent an anterior lumbar interbody fusion between January 1, 2001 and November 1, 2008 were reviewed. A total of 102 consecutive patients, of whom 19 received an epidural and 83 underwent general anesthesia, met inclusion criteria. Postoperative pain, nausea, opioid administration, operating room time, anesthesia time, Postanesthesia Care Unit (PACU) time, and total hospital time were compared."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "In the PACU, patients receiving epidural anesthesia showed reductions in median immediate [numerical rating scale (NRS) 0 vs 7; P < 0.001] and peak (NRS 4 vs 8; P = 0.001) postoperative pain scores, and postoperative mean arterial pressure (69.7 vs 90.3; P < 0.001). Epidural anesthesia patients also needed significantly less intravenous morphine-equivalent medication both intraoperatively (5 vs 29; P < 0.001) and postoperatively (3.34 vs 10; P = 0.021)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Epidural anesthesia for anterior lumbar interbody fusion is potentially beneficial compared with general anesthesia, showing improved perioperative pain control."
          }
        ]
      },
