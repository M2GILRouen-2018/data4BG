      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "We sought to document the efficacy of interlaminar epidural steroid injections (ESIs) for the relief of low back pain in a rural population."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We conducted a prospective observational cohort study with brief follow-up telephone interviews at 1, 3 and 6 months after interlaminar ESI."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 47 ESIs were administered to the 24 participants. In an intention-to-treat analysis, pain relief was achieved in 78.7%, 55.3% and 27.7% of participants at 1, 3 and 6 months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Interlaminar ESIs, without fluoroscopic guidance, were effective for up to 3 months of symptom relief."
        }
      ]},
