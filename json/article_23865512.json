      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We examined whether auricular acupressure (AA) can alleviate postoperative pain and decrease narcotic consumption and its adverse effects for osteoarthritis patients after total knee arthroplasty (TKA)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A prospective, randomized, sham control trial comparing AA and a sham control."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Department of Orthopedics, the first Hospital affiliated to Zhejiang University of Traditional Chinese Medicine, Hangzhou, China."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "Ninety patients with degenerative osteoarthritis undergoing TKA."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "The AA group received true AA by embedding vaccaria seeds at four specific AA points (knee joint, shenmen, subcortex, sympathesis) ipsilateral to the surgery site, while the control group received four nonacupuncture points on the auricular helix."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Visual analog scale (VAS), the consumption of analgesic via patient-controlled analgesia, the incidence of analgesia-related adverse effects, Hospital for Special Surgery scores (HSS), and range of motion (ROM) were recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "VAS scores were similar at 12, 24, 36, and 48\u2009h postsurgery (P\u2009>\u20090.05), but AA group scores were lower than those of the control group at 3, 4, 5, and 7 days (P\u2009<\u20090.05). Patients in the AA group consumed lower doses of analgesic than those in the control group after surgery (P\u2009<\u20090.05). The incidence of analgesia-related adverse effects in the AA group was lower than that in the control group (P\u2009<\u20090.05). Although HSS scores were similar in the two groups preoperatively and at 3 months postoperatively (P\u2009>\u20090.05), HSS scores 2 weeks postoperatively were higher in the AA group than in the control group (P\u2009<\u20090.05), but there was no difference between groups in ROM (P\u2009>\u20090.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Applying auricular acupoint acupressure in the perioperative period of TKA is favorable for alleviating postoperative pain, decreasing opioid consumption and its adverse effects, and promoting early rehabilitation. Also, this intervention has the advantage of lower costs, fewer complications, simple application, and high safety."
          }
        ]
      },
