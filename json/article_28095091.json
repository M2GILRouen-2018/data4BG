      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Fear of reinjury is associated with cessation of sport after anterior cruciate ligament (ACL) reconstruction despite normal postoperative knee function. The objective of this study is to describe factors informing athletes' experience of fear of reinjury post ACL reconstruction, in athletes who cited fear as the sole reason for not returning to their pre-injury level of sport."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Mixed-methods study design of qualitative and a preliminary quantitative component."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A conveniently selected private hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Ten male and two female athletes, aged between 19 and 45 years, were eligible for the interview from 68 male and 32 female potential participants (age range 17-50) who underwent an ACL reconstruction using any graft type, excluding revision or multi-ligament surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "To explore factors informing fear of reinjury in participants citing fear of reinjury as the sole reason for not returning to sport, albeit normal knee function."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "From the participant interview, four themes emerged: undergoing the surgery and recovery again, nature of the pre-injury sport imposing risk of reinjury, personality traits, and social priorities."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Clinicians should be aware of factors informing fear of reinjury post ACL reconstruction. Modifiable fears including pain, mode and length of rehabilitation and psychological factors should be considered during rehabilitation to potentially improve the return to sport rate."
        }
      ]},
