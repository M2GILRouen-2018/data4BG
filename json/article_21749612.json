      "Abstract": {
        "CopyrightInformation": "© 2011 The Authors Journal compilation © RCOG 2011 BJOG An International Journal of Obstetrics and Gynaecology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the role of acupuncture for analgesia during labour."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Double-blind study of manual, electro and sham acupuncture, and single-blind study comparing acupuncture with a control group for analgesia for labour induction."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A major obstetric unit in the UK."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "POPULATION",
            "content": "A cohort of 105 nulliparae undergoing labour induction at term."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twenty-three subjects needed to be randomised to each group to have an 80% power of detecting a 50% relative reduction in epidural rate with an alpha value of 0.05."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "The primary end point was the rate of intrapartum epidural analgesia, and the secondary end points were parenteral analgesia requirement, labour length, delivery mode, neonatal condition and postpartum haemorrhage."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was no difference in epidural analgesia between acupuncture and sham acupuncture, relative risk 1.18 (95% CI 0.8-1.74), or between acupuncture and control, relative risk 0.88 (95% CI 0.66-1.19). There were no significant differences in the secondary end points between the acupuncture groups and the control group. Side effects or complications of acupuncture were not identified."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Using the protocols studied, there was no analgesic benefit with acupuncture for pain relief during induced labour in nulliparae."
          }
        ]
      },
