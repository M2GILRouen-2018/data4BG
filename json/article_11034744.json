      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Leukotriene receptor antagonists are a new class of drug that were initially identified for use in asthma. As they have an effect on neutrophil mediated inflammation, they may be of benefit in bronchiectasis."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine whether leukotriene receptor antagonists have any additive benefit over and above conventional treatment for bronchiectasis (usually consisting of antibiotics and postural drainage)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SEARCH STRATEGY",
          "content": "The Cochrane Airways Group clinical trials register derived from MEDLINE, EMBASE and hand searching of major journals was searched using the terms:Bronchiec* AND leukotrien* OR anti-leuk* OR cysteinyl, Bronchiec* AND monteluk*, Bronchiec* AND zafirluk*"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SELECTION CRITERIA",
          "content": "Only randomised, controlled trials were considered"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA COLLECTION AND ANALYSIS",
          "content": "The results of searches were analysed by both authors"
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MAIN RESULTS",
          "content": "No randomised, controlled trials were identified"
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "REVIEWER'S CONCLUSIONS",
          "content": "Further research is required to establish any benefit from the use of leukotriene antagonists in bronchiectasis."
        }
      ]},
