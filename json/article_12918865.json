      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Single-blind, placebo control, randomized, crossover, experimental study with repeated measures."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the initial effects of a taping technique on grip strength and pain in individuals with lateral epicondylalgia."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Taping techniques are advocated for chronic musculoskeletal conditions such as lateral epicondylalgia, a prevalent disorder with significant impact on the individual and community. Little evidence exists supporting the effects of taping techniques on musculoskeletal pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS AND MEASURES",
          "content": "Sixteen participants (mean age +/- SD, 45.8 +/- 10.2 years) with chronic lateral epicondylalgia (mean duration +/- SD, 13.1 +/- 9.9 months) participated in a placebo control study of an elbow taping technique. Outcome measures were pain-free grip strength and pressure pain threshold taken before, immediately after, and 30 minutes after application of tape."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The taping technique significantly improved pain-free grip strength by 24% from baseline (P = .028). The treatment effect was greater than that for placebo and control conditions. Changes in pressure pain threshold (19%), although positive, were not statistically significant."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This preliminary study demonstrated an initial ameliorative effect of a taping technique for lateral epicondylalgia and suggests that it should be considered as an adjunct in the management of this condition."
        }
      ]},
