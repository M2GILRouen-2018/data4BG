      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "The American Academy of Pediatrics recommends that pediatricians promote smoking cessation among caregivers at every visit. Currently, there are inconsistencies between recommendations and clinical practice. This study aims to compare results generated from 3 intervention methods on the rate at which pediatricians screen for secondhand smoke exposure (SHSe)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Pediatricians were randomly assigned to 1 of 3 intervention groups: no lecture, changes in electronic health record (EHR) (G1); lecture, no changes in the EHR (G2); or a lecture and EHR changes (G3). Data between groups were compared using a 1-way analysis of variance."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Documentation of SHSe was statistically significantly greater in G3, when compared with G1 and G2 ( P < .01). Documentation of SHSe was statistically significantly greater in G1, when compared with G2 ( P < .05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A brief lecture with EHR prompts may be a simple way to increase screening for SHSe in the pediatric primary care setting."
        }
      ]},
