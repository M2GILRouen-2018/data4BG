      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To estimate the prevalence of non-nutritive sweeteners (NNS) consumption in a sample of patients with diabetes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "We applied two questionnaires, one of food frequency adapted to products containing NNS and the other of beliefs related to NNS. The prevalence of NNS consumption was determined and correlated with the body mass index, energy and sugar consumption, waist circumference, glycated hemoglobin, triglycerides, diabetes type, education and socioeconomic status."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The prevalence of NNS consumption was 96%; the consumption was greater in men and in patients with type 1 diabetes. A negative correlation was found between the consumption and age and a positive correlation with glycated hemoglobin and education."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The prevalence of NNS consumption is high due to the great availability of products in the market."
        }
      ]},
