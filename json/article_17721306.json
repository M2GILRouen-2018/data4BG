      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report a case of corneal melting associated with the use of the topical nonsteroidal anti-inflammatory agent Nepafenac."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Case report and literature review."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A 62-year-old woman with a complicated ocular history developed corneal melting associated with the use of Nepafenac. On discontinuation of Nepafenac, the melt rapidly resolved."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Topical nonsteroidal anti-inflammatory agents have been associated with corneal ulceration and stromal melts. This is, to our knowledge, the first reported case involving the new agent, Nepafenac."
        }
      ]},
