      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To analyse systolic (SBP) and diastolic blood pressure (DBP), partial oxygen saturation (SpO2) and heart rate (HR) disorders for an hour after short and long acting beta2-agonists."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Twenty-four severe persistent asthma Pulmonology outpatients at Hospital Universitário Gaffrée e Guinle were selected. SBP, DBP, SpO2 and HR values were determined before and after 400 microg of salbutamol and 12 microg of formoterol, on different days, with a minimum interval of 24 hours."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All patients showed ventilatory obstruction, as seen by a reduced FEV1/FVC ratio. There was no statistical SBP/DBP/HR difference after bronchodilator agents, but SpO2 increased with salbutamol."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A standard dose of salbutamol and formoterol does not cause haemodynamic disorder."
        }
      ]},
