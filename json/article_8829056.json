      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare laparoscopic presacral neurectomy and laparoscopic uterine nerve ablation for primary dysmenorrhea."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Sixty-eight patients with primary dysmenorrhea and a poor response to medical treatment were randomized into two groups. One group (33 patients) had laparoscopic presacral neurectomy (LPSN) and the other group (35 patients), laparoscopic uterine nerve ablation (LUNA)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no complications, and all the patients left the hospital within 24 hours after surgery. The efficacy of both surgical methods was almost equal (87.9% vs. 82.9%) at the 3-month postoperative follow-up visit, but the efficacy of LPSN was significantly better than that of LUNA (81.8% vs 51.4%) at the 12-month visit."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "LPSN is a valid option for treating primary dysmenorrhea."
        }
      ]},
