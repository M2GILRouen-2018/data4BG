      "Abstract": {
        "CopyrightInformation": "Georg Thieme Verlag KG Stuttgart · New York.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "Lichtenstein's hernia repair (LHR) is presented as a technically feasible procedure for inguinal hernia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INDICATION",
            "content": "LHR is a standard procedure for open mesh techniques with very good postoperative results."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "We demonstrate an LHR step by step with preservation of the iliohypogastricus and ilioinguinalis nerves."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "LHR is a technically feasible and safe procedure which should have a firm place in a general surgical education."
          }
        ]
      },
