      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND/AIMS",
          "content": "Obesity is one of the most serious public health problems. Laparoscopic sleeve gastrectomy (LSG), a type of bariatric surgery, is emerging as the new promising therapy for the treatment of morbid obesity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODOLOGY",
          "content": "In the present study we aimed to assess the effects of LSG on body weight and other obesity related pathological conditions."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 19 obese subjects underwent LSG surgery. All patients underwent complete evaluation including anthropometric/clinical parameters and laboratory tests. Hypertension (HT), diabetes mellitus (DM), body mass index (BMI), and hyperlipidemia were significantly reduced after LSG."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Results of this study demonstrate that LSG induces stable weight loss and resolution of obesity-associated comorbidities."
        }
      ]},
