    "Article": {
      "Pagination": {"MedlinePgn": "899-904"},
      "PublicationTypeList": {"PublicationType": [
        {
          "UI": "D003160",
          "content": "Comparative Study"
        },
        {
          "UI": "D016428",
          "content": "Journal Article"
        }
