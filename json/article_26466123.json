      "Abstract": {
        "CopyrightInformation": "© 2015 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The objective was to determine the effects of the probiotic, VSL#3, on body and fat mass, insulin sensitivity, and skeletal muscle substrate oxidation following 4 weeks of a high-fat diet."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twenty non-obese males (18-30 years) participated in the study. Following a 2-week eucaloric control diet, participants underwent dual X-ray absorptiometry to determine body composition, an intravenous glucose tolerance test to determine insulin sensitivity, and a skeletal muscle biopsy for measurement of in vitro substrate oxidation. Subsequently, participants were randomized to receive either VSL#3 or placebo daily during 4 weeks of consuming a High-fat (55% fat), hypercaloric diet (+1,000 kcal day(-1) ). Participants repeated all measurements following the intervention."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Body mass (1.42\u2009±\u20090.42 kg vs. 2.30\u2009±\u20090.28 kg) and fat mass (0.63\u2009±\u20090.09 kg vs. 1.29\u2009±\u20090.27 kg) increased less following the High-fat diet in the VSL#3 group compared with placebo. However, there were no significant changes in insulin sensitivity or in vitro skeletal muscle pyruvate and fat oxidation with the High-fat diet or VSL#3."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "VSL#3 supplementation appears to have provided some protection from body mass gain and fat accumulation in healthy young men consuming a High-fat and high-energy diet."
          }
        ]
      },
