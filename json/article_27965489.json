      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "To evaluate the effect of audioanalgesia in 6- to 12-year-old children during dental treatment procedure."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "A total of 40 children were selected and divided into two groups, study group - with audioanalgesia and control group - without audioanalgesia. The value of their pain was evaluated using Venham's pain rating scale. Data were compared using one-sample t-test using Statistical Package for the Social Sciences (SPSS) (Inc.; Chicago, IL, USA), version 17.0."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The difference in the control group and study group was statistically significant (p < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The method of distraction using audioanalgesia instills better positive dental attitude in children and decreases their pain perception."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CLINICAL SIGNIFICANCE",
          "content": "Playing or hearing music during dental procedure significantly alters the perception of pain in 6- to 12-year-old children."
        }
      ]},
