      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Society for Bariatric Surgery. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "While laparoscopic gastric plication (LGP) results in a rapid weight loss in the first postoperative months, changes in body composition after LGP have not been studied previously."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the body composition after LGP."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A tertiary referral hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "This is a consecutive case series. Body composition was measured using bioimpedance analysis with a Tanita BC-418 by 1 nutritionist. Weight, fat mass (FM), fat-free mass (FFM), and total body water (TBW) were measured at baseline and at 1, 3, and 6 months postoperative."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Sixteen consecutive patients underwent LGP. No intraoperative or major postoperative complications occurred during the follow-up period. No patient was lost to follow-up at any point during the study period. Mean postoperative total weight loss was 31 kg after 6 months, of which 25.5 kg (83%) was due to FM reduction. %FM was decreased by 15% after 6 months, whereas %TBW increased by 11%."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Most of the weight loss caused by LGP is attributable to FM loss, and FFM loss is minimal after LGP. Therefore, LGP shifts body composition toward normal."
          }
        ]
      },
