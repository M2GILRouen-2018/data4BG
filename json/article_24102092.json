      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "CONTEXT AND OBJECTIVE",
          "content": "The findings showed that the low-affinity IgE receptor plays a pivotal role in allergic immune response and it is a pharmacogenetic predictor in asthma disease. This study aims to investigate the association of genetic variations: rs28364072 and rs7249320 with asthma and its severity in north Indian children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Case-control-based genetic association study was performed among 550 children."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Statistical analysis demonstrated significant association between asthma and genotypes frequency of both the SNPs."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Our data indicate that the studied variations are strongly associated with asthma susceptibility and might be risk factor among north Indian asthmatic children."
        }
      ]},
