      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To investigate the potential benefit of postoperatively providing a patient-controlled anxiolytic agent, midazolam, in addition to morphine."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A double-blinded, placebo-controlled trial of patient-controlled midazolam."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A Community hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "29 patients undergoing elective spinal surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Postoperatively, via two separate patient-controlled pumps, the treatment group received morphine and midazolam, and the control group received morphine and saline solution."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Repeated measures using numerical rating scales of the primary outcomes of pain and anxiety were obtained every two hours postoperatively. Amount of morphine and midazolam/placebo administered was assessed, as were other secondary outcomes."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Anxiety level in the treatment group declined more rapidly over the 24 hours after surgery than in the control group. The treatment group used less morphine than the control. Preoperative positive affect was the only significant psychological predictor of postoperative outcomes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Patients who received both midazolam and morphine experienced a more rapid decline in anxiety and used less opioid medication than those receiving morphine alone."
          }
        ]
      },
