      "Abstract": {
        "CopyrightInformation": "© 2014 The Author(s).",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "We review the surgical management of 4 adult patients with ball-and-socket ankle deformity who developed end-stage subtalar and/or ankle joint arthritis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We retrospectively reviewed a series of 4 adult patients with ball-and-socket ankle configurations who underwent surgical treatment for either end-stage tibiotalar or subtalar arthritis, with either subtalar arthrodesis or total ankle replacement (TAR). Clinical outcome, including subjective pain assessment, limitation of activities, and difficulty with shoe wear, were assessed at follow-up."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 5 ankles in 4 patients were identified that met the inclusion criteria. There were 3 subtalar arthrodeses in 2 patients and 2 primary TARs in 2 patients. At an average follow-up of 30.5 (range = 17 to 59) months, there were no failures, although 1 patient who underwent TAR was considered an impending failure with aseptic component loosening. Of the 4 patients, 3 resumed normal activity with minimal pain and were very pleased with their overall outcome."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Standard surgical interventions for ankle and subtalar arthritis, such as total ankle arthroplasty and subtalar arthrodesis, can be successfully performed in patients with ball-and-socket ankles; clinical outcome and survivorship, however, may be inferior to that in patients with normal ankle configurations."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVELS OF EVIDENCE",
            "content": "Therapeutic, Level IV: Case Series."
          }
        ]
      },
