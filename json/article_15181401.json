      "Language": "ita",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Anaesthetics may have protective effect against myocardial ischemia. We aimed to investigate if sevoflurane administration could exert myocardial protection during following coronary occlusion in patients with coronary artery disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "a)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "EXPERIMENTAL DESIGN",
          "content": "prospective, randomized study. b)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University Hospital, cardiac surgical operative theatre. c)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "42 patients with coronary artery disease, scheduled to undergo coronary surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INCLUSION CRITERIA",
          "content": "severe coronary stenosis of anterior descending coronary artery; no collateral flow on angiography; at least two normokinetic segments in the myocardial region supplied by the vessel being bypassed. PATIENTS were randomized to receive (group S) or not (group C) sevoflurane administration for 15 min just before coronary occlusion. d)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Transoesophageal Tissue Doppler echocardiographic examination of myocardial systolic and early diastolic velocities in both groups basally and 60 s after coronary occlusion by the surgeon. e)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASURES",
          "content": "systolic and early diastolic velocities were registered by Tissue Doppler from a long-axis view of the interventricular septum or the anterior wall of the left ventricle."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In group C a significant reduction of systolic and diastolic intramyocardial velocities was found during myocardial ischemia due to coronary occlusion."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Treatment with sevoflurane before coronary occlusion seem effective in reducing functional myocardial impairment due to ischemia."
        }
      ]},
