      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To determine predictors of fall events in hospitalized patients with cancer and develop a scoring system to predict fall events."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective medical record review."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A 1,200-bed tertiary care hospital in northeastern Ohio."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "145 patients with cancer who did not have a fall event were randomly selected from all oncology admissions from February 2006-January 2007 and compared to 143 hospitalized patients with cancer who had a fall event during the same period."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Multivariable logistic regression models predicting falls were fit. Risk score analysis was completed using bootstrap samples to evaluate discrimination between patients who did or did not fall and agreement between predicted and actual fall status. A nomogram of risk scores was created."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Fall episodes during hospitalization and patient characteristics that predict falls."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "While patients were hospitalized for cancer care, their predictors of a fall episode were low pain level, abnormal gait, cancer type, presence of metastasis, antidepressant and antipsychotic medication use, and blood product use (all p < 0.02); risk model c-statistic was 0.89."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "For hospitalized patients with cancer, predictors reflecting greater fall episode risk can be assessed easily by nursing staff and acted on when the risk is sufficiently high."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "Understanding specific risk factors of falls in an adult oncology population may lead to interventions that reduce fall risk."
        }
      ]},
