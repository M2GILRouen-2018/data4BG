      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether patterns of facial expressions of patients complaining of chest pain can aid in the diagnosis of myocardial infarctions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Exploratory."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Southeastern university medical center emergency department (ED)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Twenty-eight patients in the ED who presented with chest pain. Age range was 40 to 84 years, with a mean of 65.4 years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Common patterns of facial expressions among patients diagnosed with myocardial infarction."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "On admission to the ED, patients were videotaped during physical examination. Videotapes were reviewed to code the facial action units exhibited by the patients. The presence or absence of creatine kinase (CK) enzymes was determined; these results were blinded to the coders until after all facial actions were coded."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "With use of the Facial Action Coding System, 4 facial expressions were found to be associated with true myocardial infarction: lowering the brow, pressing the lips, parting the lips, and turning the head left."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Additional research with a larger sample of patients presenting with chest pain is needed to validate the findings of this study. However, if these findings are supported, instruction regarding assessment of specific facial expressions in clinical settings may be warranted."
        }
      ]},
