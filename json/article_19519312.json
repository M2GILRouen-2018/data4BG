      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Music has been found to improve sleep and reduce anxiety."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This article reports a 78-year-old Chinese female who had been diagnosed with early dementia underwent an 8-week music-with-movement intervention delivered by her husband at home after being trained in a day care center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Both the patient and the husband's data were collected through repeated interviews and regular observations."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The results indicated signs of improvement of the patient in terms of sleep quality and depressive symptoms."
        }
      ]},
