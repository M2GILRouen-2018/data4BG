      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "To evaluate the effect of comorbid depression and pain on an early biopsychosocial intervention for acute temporomandibular disorder (TMD) patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Depressed (either current or lifetime; n=32) or nondepressed (n=31) acute TMD patients received a biopsychosocial intervention, and were evaluated at preintervention and again 12 months postintervention by Characteristic Pain Intensity, the Beck Depression Inventory, and a masticatory function test."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Findings revealed that both depressed and nondepressed patients reported comparable pain decreases at 12 months postintervention. Moreover, there were no significant differences between patient groups in masticatory function."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "With appropriate early biopsychosocial intervention, acute TMD patients, regardless of the presence or absence of vulnerability to depression symptomatology, can be effectively treated."
        }
      ]},
