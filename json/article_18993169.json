      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe a case of leiomyoma in a patient with Mayer-Rokitansky-Kuster-Hauser (MRKH) syndrome."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Department of Obstetrics and Gynecology, \"Sacra Famiglia Hospital,\" Novafeltria, Italy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 47-year-old woman with MRKH syndrome with lower abdominal pain and pelvic tumescence."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Results on ultrasound scan and magnetic resonance imaging."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "A pelvic leiomyoma originating from uterine remnant; resection of the mass was performed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Even though magnetic resonance imaging is useful for the diagnosis of leiomyoma of the rudimentary uterus in MRKH syndrome, surgery might be the only definitive solution. Removal of the opposite uterine remnant could also be proposed."
        }
      ]},
