      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND OBJECTIVES",
          "content": "Apart from a few case reports, the effectiveness of stellate ganglion block (SGB) as a monotherapy in acute nociceptive pain has not been determined. We aimed to assess the effects of SGB on postoperative pain after arthroscopic shoulder surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Randomized, blind, controlled, clinical trial"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University Hospital outpatient"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Forty-six patients undergoing arthroscopic shoulder surgery were assigned randomly to 2 groups: group S included patients who underwent SGB prior to surgery and group C did not. In group S, subfascial ultrasound-guided SGB was conducted with 4 mL of 0.375% levobupivacaine. For the first postoperative 48 hours, postoperative visual analog scale (VAS) and analgesic requirements were compared."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The results of 40 patients were included in the study. There was no difference between groups with regards to analgesics requirement for the first postoperative 48 hours and no difference in VAS score (P > 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "LIMITATIONS",
          "content": "Small number of patients in study."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Preoperative ultrasound-guided SGB did not reduce postoperative acute pain in arthroscopic shoulder surgery."
        }
      ]},
