      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Single-subject, A-B-A-B format."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effects of a foot orthosis on pain and function by controlling forefoot pronation."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Foot orthoses have been recommended to treat patellofemoral pain by controlling excessive pronation, but few studies have used an experimental design to validate this approach."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS AND MEASURES",
          "content": "A 19-year-old collegiate softball player had an acute onset of patellofemoral pain in her left knee. A visual analog scale was used to assess pain intensity and a functional index questionnaire (FIQ) was used to measure the subject's perceived functional level."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Statistical analysis using the celeration line technique showed significant improvements between all the consecutive baseline and intervention phases of the VAS data and in 7 of the 9 paired phases of the FIQ data."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Limiting pronation with a thermoplastic orthosis was an effective treatment for this subject."
        }
      ]},
