      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the significance of timing of low-density lipoprotein (LDL) cholesterol evaluation in patients with chest pain as it relates to subsequent National Cholesterol Education Program (NCEP) treatment decisions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, observational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A university-affiliated tertiary care hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Sixty-two patients with coronary heart disease who were not receiving lipid-lowering therapy and whose LDL levels were obtained 25-48 hours after onset of chest pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "We evaluated laboratory test results of patients with chest pain admitted to the cardiac care unit to determine risk to patients when LDL levels obtained inappropriately are used to make decisions regarding antihyperlipidemic therapy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Inpatient and outpatient LDL levels were compared, and changes in NCEP treatment decisions analyzed. Differences between inpatient and outpatient LDL levels were significant (p<0.05), which frequently resulted in changes in therapy using the NCEP guidelines. The LDL levels of most inpatients were consistent with NCEP goals for patients with coronary heart disease, whereas the outpatient levels showed a need for drug therapy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Lipid values obtained 25-48 hours after hospital admission in patients with acute coronary syndromes do not represent baseline values and may significantly alter the treatment approach; thus, they should not be used to direct drug therapy."
        }
      ]},
