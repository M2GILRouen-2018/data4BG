      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Laboratory animal allergy (or LAA) is an important threat to the occupational health of those who work with rats, mice and other species."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "This review examines the risk factors for LAA and the effectiveness of control measures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A literature review was performed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "An extensive literature was identified regarding LAA and the use of control measures. The contribution that these measures can make to the overall effectiveness of an occupational health and safety programme is discussed in the context of the literature currently available."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The incidence of this disease can be reduced by effective, integrated health risk management, with the conscientious use of engineering, procedural and personal control measures."
        }
      ]},
