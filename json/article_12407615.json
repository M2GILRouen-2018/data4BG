      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright 2002, Elsevier Science (USA). All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare the analgesic efficacy of a traditional epidurally delivered bupivacaine/fentanyl combination with a repeat bolus intrathecal morphine technique in the management of post-thoracotomy pain and to assess further the effect of cyclooxygenase (COX) inhibition on both modalities."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, randomized, blinded study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University teaching hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Patients having thoracic surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Epidural and intrathecal catheters were inserted. Blood and urine samples were collected for analysis. COX-1 and COX-2 inhibition with ibuprofen and nimesulide (COX-2 selective) was instituted."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "Pain was assessed at rest and coughing by visual analog scale. Peak expiratory flow rate, patient satisfaction rating, sedation score, analgesic requirements, and preoperative and postoperative urinary creatinine levels were measured. The spinal and nimesulide combination showed the lowest pain scores (p < 0.001), least reduction in peak expiratory flow rate (p < 0.001), and highest patient satisfaction rating (p = 0.02). COX inhibition did not affect analgesic requirements in the epidural group or increase urinary creatinine in any group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The intrathecal morphine and nimesulide combination offered significantly better analgesia than any other combination studied. The efficacious interaction between opioids and nonsteroidal anti-inflammatory drugs may be COX-2 mediated."
          }
        ]
      },
