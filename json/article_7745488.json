      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To identify the effectiveness of \"facilitated tucking,\" a nonpharmacologic nursing intervention, as a comfort measure in modulating preterm neonates' physiologic and behavioral responses to minor pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, repeated measure, random sequencing, and experimental."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Level III neonatal intensive-care unit of a tertiary care university pediatric hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Thirty preterm neonates, 25-35 weeks gestation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Heart rate, oxygen saturation, and sleep state were recorded 12 minutes before, during, and 15 minutes after two heelsticks, one with and one without facilitated tucking."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "HYPOTHESIS",
          "content": "Premature neonates will have less variation in heart rate and hemoglobin oxygen saturation, shorter crying and sleep disruption times, and less fluctuation in sleep states in response to the painful stimulus of a heelstick with facilitated tucking than without."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Neonates demonstrated a lower mean heart rate 6-10 minutes post-stick (p < 0.04), shorter mean crying time (p < 0.001), shorter mean sleep disruption time (p < 0.001), and fewer sleep-state changes (p = 0.003) after heelstick with facilitated tucking than without."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Facilitated tucking is an effective comfort measure in attenuating premature neonates' psychologic and behavioral responses to minor pain."
        }
      ]},
