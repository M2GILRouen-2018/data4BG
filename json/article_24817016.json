      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Previous research in cardiac patients suggested that type D personality, defined as a combination of negative affectivity (NA) and social inhibition (SI), was associated with adverse outcome."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The objective of this prospective study was to examine the independent prognostic value of type D in patients with coronary artery disease (CAD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 465 patients completed the Type D Scale (DS14) questionnaire before undergoing stent implantation and were followed up for 5 years."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In a Cox regression model adjusted for selected confounders, we found a trend towards NA for the prediction of nonfatal major adverse cardiovascular event (MACE, hazard ratio (HR)\u2009=\u20091.07, 95 % confidence intervals (CIs)\u2009=\u20090.99-1.14, p\u2009=\u20090.074), while, in contrast, SI was a significant and independent predictor of better outcome (HR\u2009=\u20090.92, 95 % CI\u2009=\u20090.86-0.99, p\u2009=\u20090.027)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In a cohort of CAD patients, the type D pattern was not linked to adverse outcome, whereas SI was negatively associated with MACE."
        }
      ]},
