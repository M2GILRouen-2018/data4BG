      "Abstract": {
        "CopyrightInformation": "© 2013 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The aims of this study were to compare job demand-control (JDC) and effort-reward imbalance (ERI) models in examining the association of job stress with work-related musculoskeletal symptoms and to evaluate the utility of a combined model."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This study analyzed cross-sectional survey data obtained from a nationwide random sample of 304 intensive-care unit (ICU) nurses. Demographic and job factors were controlled in the analyses using logistic regression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Both JDC and ERI variables had strong and statistically significant associations with work-related musculoskeletal symptoms. Effort-reward imbalance had stronger associations than job strain or iso-strain with musculoskeletal symptoms. Effort-reward imbalance alone showed similar or stronger associations with musculoskeletal symptoms compared to combined variables of the JDC and ERI models."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The ERI model appears to capture the magnitude of the musculoskeletal health risk among nurses associated with job stress at least as well and possibly better than the JDC model. Our findings suggest that combining the two models provides little gain compared to using effort-reward imbalance only."
          }
        ]
      },
