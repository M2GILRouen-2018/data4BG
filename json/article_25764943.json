      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate children's risk of being overweight associated with maternal underestimation of weight status and health behaviors."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "One hundred forty mother-child dyads were included. Children whose weight status was underestimated by their mothers were at greater risks of being overweight compared to those whose weigh status was correctly perceived (adjusted OR 2.31, 95% CI 1.11-4.81). Less television viewing time was associated with a 63% reduced risk of being overweight (adjusted OR .37, 95% CI .17-.83)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Maternal underestimation of weight status was common among overweight and normal-weight children, and it was associated with an increased children's risk of being overweight."
          }
        ]
      },
