      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Increased prevalence of cardiovascular disease (CVD) in psoriasis patients could be due to a greater prevalence of traditional cardiovascular (CV) risk factors or increased inflammatory disease burden."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To critically evaluate evidence on the etiology and magnitude of CV risk in psoriasis patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 497 articles were identified for review through a PubMed search using the terms \"CVD and psoriasis\"; 43 were selected. Data measuring the risk of comorbidities and CV risk factors in psoriasis were retrieved."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Psoriasis patients have an increased prevalence of CV risk factors. Evidence suggests an increased risk of CV morbidity and mortality associated with psoriasis itself. Risk estimates vary across studies (OR range 1.13-6.48), possibly due to heterogeneous study design and incomplete data."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Although additional data are required, increased awareness of the association of psoriasis with CV risk factors could lead to early diagnosis and treatment of comorbidities, with resultant improvement in morbidity and mortality."
        }
      ]},
