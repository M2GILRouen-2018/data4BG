      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The prevalence of overweight and obesity defined as BMI≥25kg/m(2) is increasing, also among head and neck cancer patients. It is unknown whether the presence of high BMI influences disease-related mortality, overall survival and recurrence in these patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We reviewed available literature using Pubmed and Web of Science. Human observational studies were included if they reported the impact of high BMI on mortality, recurrence or survival for head and neck cancer."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Eleven full articles and two abstracts met the inclusion criteria: six prospective and seven retrospective cohort studies, which comprised 8.306 patients. Patients with higher BMI had increased overall survival and decreased disease-related mortality and recurrence rate compared with underweight and normal weight patients. Most studies were adjusted for potentially confounding variables, such as stage of disease and smoking habits."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "High BMI is associated with a better outcome in head and neck cancer."
          }
        ]
      },
