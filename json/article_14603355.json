      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To examine the unique and combined effects of pain intensity, pain-related distress, analgesic prescription, and negative mood on interference with daily life because of pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive, cross-sectional."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Two cancer clinics in academic medical centers in the southeastern United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "64 ambulatory patients with cancer who had pain that required analgesics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Participants completed a number of self-report instruments during a regularly scheduled clinic visit. Standard instruments were selected to measure the main research variables."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Worst pain intensity, pain-related distress, analgesic adequacy, negative mood, and interference with daily life."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Patients with higher levels of worst pain, pain-related distress, and negative mood and inadequately prescribed analgesics reported greater interference with daily life because of pain. Multiple regression analysis indicated that interference with daily life was explained by the combination of these four predictors. All variables except negative mood were significant predictors of interference. The unique variance explained by pain-related distress exceeded that explained by worst pain intensity or inadequately prescribed analgesics."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Data suggest that pain-related distress may be an important factor when investigating interference with daily life caused by pain. In addition, pain-related distress may provide a target for future intervention studies aimed at improving the impact of cancer-related pain on daily life."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "Assessment of pain-related distress may be important in planning interventions. Common nursing interventions may be employed to reduce pain intensity and pain-related distress, which may result in enhanced physical and emotional well-being."
        }
      ]},
