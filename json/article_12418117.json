      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To study relationships between changes in solar and geomagnetic activity and a course of unstable angina pectoris with neuron nets."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Heliogeophysical variables were studied in 67 male patients at the age of 42 to 75 years with unstable angina pectoris."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The neuronetwork analysis has revealed marked non-linear relations between angina episodes and heliogeophysical factors."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Small-amplitude changes in solar and geomagnetic activity may influence the course of unstable angina pectoris."
        }
      ]},
