      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A 14-year-old accidentally inserted a slim fit tampon into her urethra. Such a case could occur again in young teenagers who otherwise have never inserted a tampon and especially have yet to see a gynecologist for their first gynecologic examination."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "Accidental insertion of a slim fit tampon into the urethra by a 14-year-old necessitated cystoscopic resection of the engorged tampon."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Although this is the only case reported of urethral tampon placement, one must include it as part of the differential diagnosis in assessing acute onset of pain or hematuria after the placement of a slim fit tampon."
        }
      ]},
