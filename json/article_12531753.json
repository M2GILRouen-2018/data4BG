      "Abstract": {
        "CopyrightInformation": "Copyright 2003 American Orthopaedic Society for Sports Medicine",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Clinical data on the efficacy of laser capsulorrhaphy for the treatment of multidirectional instability of the shoulder are limited."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "HYPOTHESIS",
            "content": "The diagnosis of multidirectional instability includes a spectrum of pathologic symptoms that warrants subclassification; laser capsulorrhaphy alone is not uniformly effective for all subtypes."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Retrospective review of prospectively collected data."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twenty-five shoulders in 21 patients were treated with laser capsulorrhaphy for multidirectional instability. Functional outcomes at a mean duration of 32 months' follow-up (range, 24 to 48 months) were recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Instability recurred in 60% of patients with congenital multidirectional instability, 17% of patients with acquired multidirectional instability, and 33% of patients with posttraumatic multidirectional instability (overall recurrence rate, 40%). Generalized ligamentous laxity was a risk factor for recurrence. Patient satisfaction rates were 40%, 83%, and 22% for the congenital, acquired, and posttraumatic subgroups. Reasons for dissatisfaction included recurrent instability, persistent pain, and inability to return to athletic activity at desired capacity. The overall mean postoperative Simple Shoulder Test score was 84%. The mean postoperative numeric rating score for pain was 3.3 (10-point scale)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Laser capsulorrhaphy may be effective for patients with acquired multidirectional instability secondary to repetitive microtrauma but is less predictable in the other subgroups."
          }
        ]
      },
