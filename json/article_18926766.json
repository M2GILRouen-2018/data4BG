      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the effects of soreness evoked by eccentric jaw exercises on two types of brainstem reflexes: the short-latency stretch reflex and the longer-latency exteroceptive suppression (ES), and to test for possible relationships between magnitude of soreness and reflex responses."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The brainstem reflexes of jaw-closing muscles were recorded before (Baseline), immediately after (Post-task), and 1 day after (1-day-after) a 30-min eccentric exercise in 15 healthy men. All subjects participated in a control session without exercise."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Soreness sensations at rest and during maximum biting were significantly elevated until 1-day-after the eccentric exercise (P<0.014). The ES responses tended to be increased (more inhibition) at Post-task and 1-day-after. There was a significant correlation between the ES response and the soreness sensation during maximum biting (P<0.04). The jaw-stretch reflex did not show significant change after the eccentric exercise."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Muscle soreness associated with eccentric jaw exercises has a differential impact on the jaw-stretch reflex and the ES response."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SIGNIFICANCE",
          "content": "Experimentally induced acute muscle pain has previously been shown to influence both the ES and the jaw-stretch reflex, thus, different types of muscle pain and symptoms can be speculated to have different effects on a variety of brainstem reflexes."
        }
      ]},
