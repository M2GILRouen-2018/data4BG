      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effect of acupressure administered during the active phase of labor on nulliparous women's ratings of labor pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Public hospital in India."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "Seventy-one women randomized to receive acupressure at acupuncture point spleen 6 (SP6) on both legs during contractions over a 30-minute period (acupressure group), 71 women to receive light touch at SP6 on both legs during the same period of time (touch group) and 70 women to receive standard care (standard care group)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Experience of in-labor pain was assessed by visual analog scale at baseline before treatment, immediately after treatment, and at 30, 60 and 120 minutes after treatment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Labor pain intensity at different time intervals after treatment compared with before treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A reduction of in-labor pain was found in the acupressure group and was most noticeable immediately after treatment (acupressure group vs. standard care group p < 0.001; acupressure group vs. touch group p < 0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Acupressure seems to reduce pain during the active phase of labor in nulliparous women giving birth in a context in which social support and epidural analgesia are not available. However, the treatment effect is small which suggests that acupressure may be most effective during the initial phase of labor."
        }
      ]},
