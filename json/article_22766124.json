      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 AAGL. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare the analgesic efficacy of oral tramadol and naproxen sodium on pain during insertion of an intrauterine device (IUD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized, double-blinded, clinical trial (Canadian Task Force classification I)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University-affiliated hospital. Single-center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "One hundred three patients scheduled for insertion of an IUD."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients were randomly assigned to receive oral tramadol 50 mg capsules (n = 35) or naproxen sodium 550 mg tablets (n = 34) or placebo (n = 34) 1 hour before insertion of the IUD. After insertion of the IUD, pain intensity was evaluated using a visual analog scale (VAS, 0-10). Adverse effects, patient satisfaction with the medication, and preference for using it during future insertions were also recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "The VAS scores were significantly different during IUD insertion among the 3 groups (p = .001). Pain scores in the tramadol group were significantly lower than in the naproxen group (p = .003), and the scores in the naproxen group was significantly lower than in the control group (p = .001). Patient satisfaction with the medication and preference for its future use were significantly lower in the control group than in the other 2 groups (p = .001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Prophylactic analgesia using 50 mg tramadol and 550 mg naproxen, delivered orally, can be used to relieve pain during IUD insertion. However, tramadol capsules were found to be more effective than naproxen tablets."
          }
        ]
      },
