      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Pigeon breeders disease usually affects adults. Children are more likely to be affected when they share living space with a backyard poultry or pigeon breeding."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "CASE CHARACTERISTICS",
          "content": "A 12-year-old girl with persistent cough for 3 years and dyspnea for 2 years."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "OBERVATION",
          "content": "She was dignosed to be having allergy to pigeon droppings, based on reports of lung biopsy and allergy testing."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "MESSAGE",
          "content": "Pigeon breaders disease should be considered in a child who presents with features of chronic hypersensiticity pneumonitis."
        }
      ]},
