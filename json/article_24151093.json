      "Abstract": {
        "CopyrightInformation": "© 2013 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To test the association between workplace abuse exposure and injury risk among hospital workers. We hypothesized that exposed workers would have higher injury rates than unexposed workers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Survey of direct-care workers (n\u2009=\u20091,497) in two hospitals. Exposure to workplace abuse was assessed through self-report; occupational injury reports were extracted from employee records. We tested associations between non-physical workplace violence and injury using log-binomial regression and multilevel modeling."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Adjusted prevalence ratio (PR) for injury associated with being yelled at was 1.52 (95% CI 1.19, 1.95); for experiencing hostile/offensive gestures 1.43 (1.11, 1.82); and for being sworn at 1.41 (1.09, 1.81). In analyses by injury subtypes, musculoskeletal injuries were more strongly associated with abuse than were acute traumatic injuries. Associations operated on group and individual levels and were most consistently associated with abuse perpetrated by patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Exposure to workplace abuse may be a risk factor for injuries among hospital workers."
          }
        ]
      },
