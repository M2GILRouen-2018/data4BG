      "Abstract": {"AbstractText": [
        {
          "Label": "UNLABELLED",
          "content": "A gymanast developed ulnar wrist pain caused by pisotriquetral instability. Pisotriquetral arthrodesis resulted in pain relief and sufficient functional return to allow her to return to gymnastics. Pisotriquetral arthrodesis is a feasible alternative to pisiform excision worth consideration in high-demand patients with symptomatic pisotriquetral instability or arthrosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "TYPE OF STUDY/LEVEL OF EVIDENCE",
          "content": "Therapeutic, Level V."
        }
