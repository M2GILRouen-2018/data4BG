      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This paper will describe the impact on the human lung of haze from forest fires in Indonesia based on data collected from different provinces."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODOLOGY",
          "content": "Data were collected from personal reports from pulmonologists working in the area as well as from province/district health offices and hospitals."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "These data show that there was a significant impact of haze to the human lung. There was a significant increase in respiratory conditions, lung function complaints and other related impacts."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Further studies, especially cohort studies, should be undertaken so that the long-term' impact of pollution from forest fires can be known."
        }
      ]},
