      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To describe a case of obturator nerve entrapment, a previously unreported cause of chronic groin pain in athletes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE SUMMARY",
          "content": "A 23-year-old man, an elite Australian rules footballer, presented with a 2-year history of groin pain. Conservative treatment was unsuccessful. Examination postexercise revealed adductor weakness and medial thigh paraesthesia. Diagnosis of obturator nerve entrapment was confirmed by EMG and nerve block. Surgical neurolysis was performed. The patient returned to sport and has remained symptom free."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Although intrapelvic obturator nerve entrapment has been reported following surgical trauma, no cases of sport-related entrapment have been described."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RELEVANCE",
          "content": "Obturator nerve entrapment should be considered as a potential cause of chronic groin pain in athletes."
        }
      ]},
