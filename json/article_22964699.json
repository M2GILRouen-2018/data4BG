      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "We hypothesize that dopaminergic receptors of dura mater may play a possible role in headache."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "The dopaminergic receptors of cranial dura mater in man were studied by examining several dural zones (vascular, peri-vascular, inter-vascular) in different brain regions (basal, calvarial, tentorial, occipital, frontal, parietal, temporal)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Our results demonstrate that dopaminergic receptors are present in human cranial dura mater and that these receptors show a specific morphological location. There are more dural dopaminergic receptors in the basal region than in the calvarial one. Moreover, these receptors are more abundant in the vascular and perivascular dural zone than in the intervascular one."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The location of dopaminergic receptors in the dura mater may represent an important factor in the pathogenesis of headache. Further studies will be necessary in order to determine the role of dopaminergic system in this disease."
        }
      ]},
