      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Idiopathic stabbing headache, which is a brief, sharp, severe jabbing pain that is confined to the head, responds well to treatment with indomethacin sodium. It may occur as a primary entity but more likely is associated with other types of headache, including migraine."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Emergency department of a teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT",
          "content": "A 27-year-old man presented to the emergency department with stabbing, sharp pain in the right temporal area associated with complete of loss vision in his right eye. The patient had a history of migraine with aura since 1995."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "The patient was treated with oxygen inhalation and indomethacin, with complete resolution of his symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A case of idiopathic stabbing headache associated with monocular visual loss was relieved by oxygen and indomethacin therapy."
        }
      ]},
