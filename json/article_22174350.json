      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To explore a possible relationship between vasodilatation and delayed headache we examined the effect of pituitary adenylate cyclase-activating polypeptide-38 (PACAP38) on the middle meningeal artery (MMA) and middle cerebral artery (MCA) using high resolution magnetic resonance angiography (MRA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In a double-blind, randomized, placebo-controlled study 14 healthy volunteers were scanned repeatedly after infusion (20\u2009min) of 10\u2009pmol/kg/min PACAP38 or placebo. In addition, four participants were scanned following subcutaneous sumatriptan (6\u2009mg)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "We found significant dilatation of the MMA (p\u2009=\u20090.00001), but not of the MCA (p\u2009=\u20090.50) after PACAP38. There was no change after placebo (p\u2009>\u20090.40). Vasodilatation (range 16-23%) lasted more than 5\u2009h. Sumatriptan selectively contracted the MMA by 12.3% (p\u2009=\u20090.043)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "PACAP38-induced headache is associated with prolonged dilatation of the MMA but not of the MCA. Sumatriptan relieves headache in parallel with contraction of the MMA but not of the MCA."
        }
      ]},
