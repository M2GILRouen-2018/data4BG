      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the diagnostic effectiveness and treatment of women with chronic lower abdominal pain due to residual ovaries or ovarian remnants."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective observational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary referral pelvic pain clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Seventeen women complaining of chronic pelvic pain of up to 25 years' duration, of whom seven had residual ovaries and 10 ovarian remnant(s)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Persistent lower abdominal pain, pelvic tenderness and quality of life one year post-operatively."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Six of the seven women with residual ovaries, and nine of the 10 women with presumed ovarian remnants experienced relief of the original pain, loss of pelvic tenderness and an improved quality of life."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Residual ovaries after hysterectomy and ovarian remnants are established causes of chronic pelvic pain. Diagnosis and surgical removal is frequently difficult. Management strategies are proposed for both conditions."
        }
      ]},
