      "Abstract": {
        "CopyrightInformation": "© 2014 The Authors. Pediatric Obesity © 2014 World Obesity.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Obese adolescents with high proportion of visceral fat are at higher risk of developing the metabolic syndrome."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The study aims to investigate if echocardiographic epicardial fat thickness (EF) could be predictive of visceral obesity (VO) early in life and to provide EF threshold values specific for male adolescents. Further aim was to investigate the association between EF, lifestyle and metabolic disease familiarity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Anthropometric data were collected from 102 normal weight and overweight, healthy male adolescents (mean age: 14.91\u2009±\u2009\u20091.98 years); bioelectrical impedance analysis and transthoracic echocardiogram were performed in the same sample. Each participant fulfilled a validated self-administered lifestyle questionnaire."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We found higher EF values in sedentary adolescents (P\u2009<\u20090.05), in those who never eat fruit and vegetables (P\u2009<\u20090.05), and in those with overweight mothers (P\u2009<\u20090.05). The strongest independent predictor of EF was waist circumference (P\u2009<\u20090.0001). Using the waist to height ratio as a marker of VO, logistic regression analysis revealed that 1\u2009mm EF gain is responsible for seven times higher VO risk (P\u2009<\u20090.0001). Receiver Operating Characteristic (ROC) analysis showed that the optimal cut-off for EF thickness associated to youth VO is 3.2\u2009mm."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Ultrasonography EF measurement might be a second-level assessment tool, useful to detect early cardiometabolic damage stage."
          }
        ]
      },
