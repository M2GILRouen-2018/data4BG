      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "The aim of this study was to compare intravenous and epidural analgesia for patients undergoing total knee replacements. Side effects of analgesia were assessed to see whether they influenced patient satisfaction."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Patients were randomly allocated to either the intravenous or epidural group. Their experience of pain was assessed using visual analogue scales and a questionnaire."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was no evidence to support claims that epidural analgesia provides more consistent pain relief and more rapid rehabilitation. There was no correlation between length of stay and the route by which post-operative analgesia was administered."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Patients undergoing total knee replacement can have their post-operative pain equally well controlled with either intravenous or epidural analgesia."
        }
      ]},
