      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe a case of Mayer-Rokitansky-Küster-Hauser (MRKH) syndrome associated with bilateral myomas in uterine remnants."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 35-year-old woman with MRKH syndrome and pelvic pain, in whom leiomyomas were diagnosed by imaging techniques."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Diagnostic laparoscopy followed by excision of leiomyomas and uterine remnants by laparotomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Resolution of symptoms and histologic confirmation of the clinic diagnosis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "After a 6-month follow-up period, the patient was asymptomatic. The histologic examination confirmed MRKH syndrome associated with multiple myomas in both rudimentary uteri."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "This is an unusual case of MRKH syndrome associated with bilateral leiomyomas. The excision of the tumors with the adjacent uterine remnants is indicated when they are symptomatic."
        }
      ]},
