      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Talonavicular (TN) fusion is an effective means of treating hindfoot deformity and pain. At the cost of a certain limited morbidity, it allows lasting stabilization of all of the torque joints. Non-union rates, however, are high, due to insufficient mechanical stability of the fixation. The present study assessed radiological and clinical results in TN fusion fixed by two retrograde compression screws and a dorsal locking plate."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHOD",
            "content": "A retrospective single-surgeon study recruited 26 TN fusions performed in 25 patients (13 male, 12 female; mean age, 54.6±15.4years) between March 1st, 2010 and February 28th, 2014. Mean follow-up was 14.9±8.7months. Bone fusion and anatomic results were assessed on dorsoplantar, lateral and Méary weight-bearing radiographs."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Radiologic fusion was achieved in all cases, at a mean 2.7±0.7months. Mean TN coverage angle was 21.7±10.5° preoperatively and 3.8±1.8° at follow-up. Mean AOFAS score improved significantly, from 37.2±11.8 (range, 20-53) preoperatively to 79.4±11.4 (range, 45-98) at follow-up."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "TN fusion fixed by two retrograde compression screws and a dorsal locking plate provided a high rate of consolidation without loss of angular correction and with satisfactory clinical results."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "IV."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "TYPE OF STUDY",
            "content": "Retrospective."
          }
        ]
      },
