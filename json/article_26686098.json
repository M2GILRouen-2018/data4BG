      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Sociedade Brasileira de Pediatria. Published by Elsevier Editora Ltda. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the association between general and abdominal obesity with high blood pressure in adolescents of both genders from the public school system."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This was an epidemiological, descriptive, exploratory study, with a quantitative approach and local scope whose sample consisted of 481 high school students (aged 14-19), selected by using a random cluster sampling strategy. Blood pressure was measured through the use of automated monitor and was considered high when the pressure values were at or above the 95th percentile. The analyses were performed using the chi-squared test and binary logistic regression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The prevalence of high blood pressure was 6.4%, and it was higher among boys (9.0% vs. 4.7%, p<0.05). There was no significant difference between general (p=0.903) and abdominal obesity (p=0.157) when genders were compared. After adjusting for age, high blood pressure was associated with general (OR=6.4; p<0.001) and abdominal obesity (OR=7.0; p<0.001) only among boys, when comparing the fourth quartile with the first quartile of body mass index (≤ 18.6 kg/m(2)vs. ≥ 23.5 kg/m(2)) and waist circumference (≤ 69 cm vs. ≥ 80.1cm)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "It was observed that general and abdominal obesity are associated with high blood pressure only in boys, regardless of age."
          }
        ]
      },
