      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2015 Reprints and permissions: sagepub.co.uk/journalsPermissions.nav.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the incidence and risk factors for emergence agitation in the postanaesthetic care unit (PACU), in adult patients undergoing urological surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Medical records were retrospectively reviewed. Preoperative, intraoperative and postoperative variables were evaluated. Emergence agitation was defined as a Riker sedation-agitation score ≥ 5. Logistic regression analysis was used to determine independent risk factors for emergence agitation."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Emergence agitation was observed in 48/488 (9.8%) patients. Chronic lung disease (odds ratio [OR] 2.72, 95% confidence interval [CI] 1.03, 7.17), duration of surgery (OR 1.01, 95% CI 1.00, 1.01), history of social drinking (OR 2.48, 95% CI 1.25, 4.93), postoperative pain score (OR 1.32, 95% CI 1.14, 1.53), voiding urgency (OR 2.20, 95% CI 1.01, 4.77) and presence of gastric tube (OR 2.85, 95% CI 1.07, 7.54) were independent risk factors for emergence agitation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Adequate postoperative pain management and prevention of catheter-related bladder discomfort may be helpful in reducing the incidence of emergence agitation in urology patients."
          }
        ]
      },
