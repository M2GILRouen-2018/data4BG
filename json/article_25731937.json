      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To assess the prevalence of fatigue, pain, anxiety, and depression in adults with Duchenne muscular dystrophy (DMD), and to analyze their relationship with health-related quality of life."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Home of participants."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Adults (N=80) with DMD."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Not applicable."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Fatigue was assessed with the Fatigue Severity Scale; pain with 1 item of the Medical Outcomes Study 36-Item Short-Form Health Survey and by interview; and anxiety and depression by using the Hospital Anxiety and Depression Scale. Health-related quality of life was assessed using the World Health Organization Quality of Life Scale-Brief Version. Associations between these conditions and quality of life were assessed by means of univariate and multivariate logistic regression analyses."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Symptoms of fatigue (40.5%), pain (73.4%), anxiety (24%), and depression (19%) were frequently found. Individuals often had multiple conditions. Fatigue was related to overall quality of life and to the quality-of-life domains of physical health and environment; anxiety was related to the psychological domain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Fatigue, pain, anxiety, and depression, potentially treatable symptoms, occur frequently in adults with DMD and significantly influence health-related quality of life."
          }
        ]
      },
