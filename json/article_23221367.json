      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Randomized clinical trial."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the short-term effects of thoracic spine thrust manipulation combined with cervical spine nonthrust manipulation (experimental group) versus cervical spine nonthrust manipulation alone (comparison group) in individuals with mechanical neck pain."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Research has demonstrated improved outcomes with both nonthrust manipulation directed at the cervical spine and thrust manipulation directed at the thoracic spine in patients with neck pain. Previous studies have not determined if thoracic spine thrust manipulation may increase benefits beyond those provided by cervical nonthrust manipulation alone."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Sixty-four participants with mechanical neck pain were randomized into 1 of 2 groups, an experimental or comparison group. Both groups received 2 treatment sessions of cervical spine nonthrust manipulation and a home exercise program consisting of active range-of-motion exercises, and the experimental group received additional thoracic spine thrust manipulations. Outcome measures were collected at baseline and at a 1-week follow-up, and included the numeric pain rating scale, the Neck Disability Index, and the global rating of change."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Participants in the experimental group demonstrated significantly greater improvements (P<.001) on both the numeric pain rating scale and Neck Disability Index at the 1-week follow-up compared to those in the comparison group. In addition, 31 of 33 (94%) participants in the experimental group, compared to 11 of 31 participants (35%) in the comparison group, indicated a global rating of change score of +4 or higher at the 1-week follow-up, with an associated number needed to treat of 2."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Individuals with neck pain who received a combination of thoracic spine thrust manipulation and cervical spine nonthrust manipulation plus exercise demonstrated better overall short-term outcomes on the numeric pain rating scale, the Neck Disability Index, and the global rating of change."
        }
      ]},
