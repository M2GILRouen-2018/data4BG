      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To document a case of cecal lecithin-vitamin B12 bezoar formation inducing abdominal discomfort."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "500-bed, community teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT",
          "content": "81-year-old man with a history of multiple abdominal surgeries who presented with a chief complaint of abdominal pain. Flat plate X-ray of the abdomen revealed multiple capsule-shaped objects lodged in the cecum."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Catharsis with bisacodyl, magnesium citrate, NaCl 0.9%; dissolution with heated, dilute barium administered rectally in conjunction with external manipulation; laparotomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "None planned; dissolution or transit of bezoar through gastrointestinal tract desired outcome."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RESULTS/DISCUSSION",
          "content": "Classification of bezoars and treatment discussed in relation to this case report."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Medicinal agents have been implicated in bezoar formation. Treatment options have included: cathartics, heated solvent enemas, and external manipulation and surgery."
        }
      ]},
