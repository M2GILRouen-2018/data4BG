      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 The Canadian Society of Clinical Chemists. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Asthma is a chronic inflammatory airway disorder associated with recruitment of inflammatory cells. This study aims to clarify the role of oxidative stress and antioxidant status in the deterioration accompanied asthma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "Vitamin E, Vitamin C, superoxide dismutase (SOD), glutathione peroxidase (GPx), reduced glutathione (GSH), total antioxidant status together with the concentrations of lipid peroxides, total nitrates and oxidative DNA damage (8-oxodeoxyguanine) were determined in plasma or whole blood of 47 Saudi asthmatic patients and compared to age-matching control samples."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The present study showed that asthmatic patients have significantly decreased levels of GSH, α-tocopherol, GPx, total antioxidant status and higher levels of SOD, lipid peroxides, total nitrate and 8-oxo-dG. Vitamin C recorded more or less similar levels in both groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Alteration of the selected measured parameters confirms that oxidative stress and defective antioxidant status could represent the primary causative factor in the pathogenesis of asthma."
          }
        ]
      },
