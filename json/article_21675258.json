      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To obtain objective information on the quality of pulmonological outpatient care for patients living in the North Administrative District (NAD) of Moscow; to propose methods of this care improvement."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "An epidemiological study of Moscow NAD population was made to detect respiratory diseases, to assess qualification of district physicians in management of most prevalent chronic diseases of the respiratory system: bronchial asthma (BA) and chronic obstructive pulmonary disease (COPD)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The epidemiological study has revealed standard errors of district physicians in management of BA and COPD patients. Effective measures on reduction of the typical mistakes are proposed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "More active detection of respiratory diseases in Moscow population is recommended."
        }
      ]},
      "ArticleTitle": "[Experience in perfection of outpatient pulmonological service].",
