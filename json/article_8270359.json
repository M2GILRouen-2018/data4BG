      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the frequency and etiology of psychiatric complications in patients with Fabry's disease. Method-Retrospective analysis and review of the records of thirty-three patients with confirmed Fabry's disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Six patients (18%) developed psychiatric disorders. Five patients suffered depression and two of these patients committed suicide. One patient developed an acute confusional episode with subsequent development of behavioral changes as a complication of cerebrovascular disease."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Psychiatric disorders, most commonly depression, complicate Fabry's disease and contribute to the morbidity and mortality of this disease."
        }
      ]},
