      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare electrosurgical bipolar vessel sealing (EBVS) with traditional suturing during vaginal hysterectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In a randomized controlled trial involving 68 women undergoing vaginal hysterectomy for benign disease, 37 procedures were performed using EBVS and 31 using traditional suturing. The end points were procedure time, blood loss, number of ligatures used, postoperative pain score, and number of days in hospital."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The procedure duration was shorter using EBVS (median duration, 32 vs. 40 min; P=.0003), with fewer ligatures (1 vs. 7; P<.0001) and less pain (median score, 4 vs. 6; P<.0001). There were no significant differences regarding blood loss (median, 100 vs. 160 mL; P=.36) and days in hospital (median, 2 vs. 2; P=.03)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The EBVS system provided advantages over traditional suturing with regard to procedure time, number of ligatures used, and postoperative pain score."
        }
      ]},
