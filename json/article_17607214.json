      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Metastatic involvement of the peritoneum from a lung cancer is infrequently encountered."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We present the case report of a patient with bronchial adenocarcinoma whose course is complicated by the occurrence of a peritoneal carcinomatosis, as documented by FDG-PET."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Unexplained abdominal pain in a lung cancer patient may be a peritoneal carcinomatosis. The diagnosis can be helped by PET-scan. However, the therapeutic opportunities are very limited."
        }
      ]},
