      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effects of using a gamma-hydroxybutyrate (GHB) administered in divided doses at night in 11 patients previously diagnosed with fibromyalgia (FM)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Subjects completed daily diaries assessing their pain and fatigue levels and slept in the sleep laboratory before and one month after initiating GHB treatment. Polysomnographic recordings were evaluated for sleep stages, sleep efficiency and the presence of the alpha anomaly in non-REM sleep."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was a significant improvement in both fatigue and pain, with an increase in slow wave sleep and a decrease in the severity of the alpha anomaly."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Further controlled studies are needed to characterize the clinical improvement and the polysomnographic changes we observed."
        }
      ]},
