      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Associação Brasileira de Otorrinolaringologia e Cirurgia Cérvico-Facial. Published by Elsevier Editora Ltda. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Nasal packing is routinely used in septal surgery to prevent postoperative bleeding."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To demonstrate the possibility of transeptal suture as a safe and effective way to avoid nasal packing and to improve efficiency."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This is a prospective, descriptive, inferential cost study comprising 92 patients. Two randomized groups of patients were analyzed, one with nasal packing and the other with transeptal suture."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In the group of transeptal suture no patient experienced postoperative bleeding, and a statistically significant reduction of pain and headache was demonstrated. At the same time, we improved efficiency by saving on material costs."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Transeptal suture is an effective and safe alternative to classic nasal packing in septal surgery. Moreover, it improves the efficiency of the intervention by saving costs."
          }
        ]
      },
