      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Background",
          "content": "Extradural hemangiomas are rare, have varied and challenging clinical presentations, and require special considerations from the management point of view."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Case Description",
          "content": "A 70-year-old female presented with back pain that was ultimately attributed to a thoracolumbar extra-dural \"dumbbell\" hemangioma. Following surgical resection, the patient did well."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Conclusion",
          "content": "Extradural hemangiomas may present as spinal extradural soft tissue masses that must be differentiated from dumbbell neurofibroma."
        }
      ]},
