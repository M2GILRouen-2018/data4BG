      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare self-reported measures of chronic lower back pain (CLBP) patients who were assigned to 2 subgroups based on their lifting patterns performed during a repetitive lifting task."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cross-sectional study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Research laboratory"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "CLBP subjects (n=81) and pain-free controls (n=53)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Not applicable."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Measures of lifting patterns and self-reported disability, pain, and psychosocial aspects."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Two CLBP subgroups were found: 1 group that lifts similarly to control subjects (n=35) and 1 group that lifts very differently from controls (n=46). The CLBP group that lifted differently than controls reported higher pain intensity (P=.005), higher pain severity (P=.025), and lower self-efficacy (P=.013) than the CLBP group that lifted similarly to controls."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A classification system based on lifting patterns identified 2 CLBP subgroups that were significantly different on lifting and self-reported measures, indicating the importance of physical functioning measures in classification systems."
        }
      ]},
