      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare dydrogesterone with placebos in the treatment of minimal to mild endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, double-blind, randomized study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Three Obstetrics and Gynaecology Departments in the United Kingdom."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Sixty-two premenopausal women with complaints of pain (n = 12) and infertility with or without pain (n = 50) with minimal to mild endometriosis diagnosed at laparoscopy. Thirty-nine women had a laparoscopy after treatment and 56 women were followed up 12 months after treatment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Two high doses of dydrogesterone (either 40 or 60 mg) or a placebo, which was given for 12 days, beginning 2 days after the LH surge for a treatment period of 6 months."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Change between before and after treatment endometriosis scores, pregnancy rates (PRs), and pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Treatment with dydrogesterone did not alter the natural history of endometriosis or PRs when compared with placebo. Pain was reduced significantly during treatment with 60 mg dydrogesterone and this improvement still was evident at 12-month follow-up."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Luteal phase dydrogesterone reduces pain associated with endometriosis."
        }
      ]},
