      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 The Canadian Society of Clinical Chemists. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Existence of low grade persistent inflammation in obese children may increase the risk of metabolic and cardiovascular events. The aim was to determine whether glucose intolerance has an influence on inflammatory markers in obese adolescents."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGNS AND METHODS",
            "content": "45 obese adolescents (mean BMI: 30.34±5.42 kg/m²) were grouped as normal or impaired glucose tolerance. IL-6 and CRP levels were analyzed by commercially available kits. Chitotriosidase activity was measured by a fluorescence method and neopterin levels were determined by ELISA. Data were expressed as mean±SD."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "IL-6 and CRP levels were similar in the two groups. Serum neopterin levels were not different between the groups. The chitotriosidase activity was significantly higher in the IGT group than NGT (124.33±51.97 μmol/L/h vs 84.50±53.99 μmol/L/h, p=0.04)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Serum chitotriosidase activity is increased in obese adolescents with impaired glucose tolerance."
          }
        ]
      },
