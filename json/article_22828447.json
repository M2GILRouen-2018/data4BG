      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "There is insufficient knowledge about the chondrocyte membranome and its molecular composition."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To develop a Triton X-114 based separation technique using nanoLC-MS/MS combined with shotgun proteomics to identify chondrocyte membrane proteins."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Articular chondrocytes from equine metacarpophalangeal joints were separated into hydrophobic and hydrophilic fractions; trypsin-digested proteins were analysed by nanoLC-MS/MS."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 315 proteins were identified. The phase extraction method yielded a high proportion of membrane proteins (56%) including CD276, S100-A6 and three VDAC isoforms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Defining the chondrocyte membranome is likely to reveal new biomarker targets for conventional and biological drug discovery."
        }
      ]},
