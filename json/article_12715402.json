      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "ISSUES AND PURPOSE",
          "content": "Professional organizations are embracing collaborative multisite research and research utilization projects. This report describes the strategies undertaken and lessons learned from SPN's first multisite study."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Infrastructure concerns (e.g., vision, communication, dissemination of results, resources, and human rights protections) and methodological issues specific to multisite research must be addressed to ensure a successful study."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "PRACTICE IMPLICATIONS",
          "content": "Multisite studies are an effective mechanism for more rapidly advancing nursing theory and evidence-based nursing practice."
        }
      ]},
