      }},
      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Reprint & Copyright © 2015 Association of Military Surgeons of the U.S.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose of this study was to identify subpopulations at high risk for body composition assessment (BCA) failure within the Navy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This study was an institutional review board-approved retrospective review of data retrieved from the Bureau of Medicine and Surgery Physical Readiness Information Management System. Data were considered clinically significant if a subpopulation's BCA failure rate was 10% or greater than that groups' gender average. The data obtained include the entire population, so no correction was necessary for sample bias and all differences are statistically significant."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The prevalence of obesity was 13.6%. High-risk populations included age 36 to 40, rank of E5 and E6, females with a height between 68 and 69 inches, females 161 lb or heavier, males 201 lb or heavier, females with a body mass index of 27 or greater, and males with a body mass index of 29 or greater."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This study identified multiple at risk populations for BCA failure. As we move forward with programs designed to combat increasing obesity rates, such as the Department of Defense Healthy Base Initiative, further resources and studies can be aimed toward these higher risk subpopulations."
          }
        ]
      },
