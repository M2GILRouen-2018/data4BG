      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Dysfunction of the cervicothoracic spine and the adjacent ribs (also called the shoulder girdle) is considered to predict occurrence and poor outcome of shoulder symptoms. It can be treated with manipulative therapy, but scientific evidence for the effectiveness of such therapy is lacking."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the effectiveness of manipulative therapy for the shoulder girdle in addition to usual medical care for relief of shoulder pain and dysfunction."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "General practices in Groningen, the Netherlands."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "150 patients with shoulder symptoms and dysfunction of the shoulder girdle."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "All patients received usual medical care from their general practitioners. Only the intervention group received additional manipulative therapy, up to 6 treatment sessions in a 12-week period."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Patient-perceived recovery, severity of the main complaint, shoulder pain, shoulder disability, and general health. Data were collected during and at the end of the treatment period (at 6 and 12 weeks) and during the follow-up period (at 26 and 52 weeks)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "During treatment (6 weeks), no significant differences were found between study groups. After completion of treatment (12 weeks), 43% of the intervention group and 21% of the control group reported full recovery. After 52 weeks, approximately the same difference in recovery rate (17 percentage points) was seen between groups. During the intervention and follow-up periods, a consistent between-group difference in severity of the main complaint, shoulder pain and disability, and general health favored additional manipulative therapy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "LIMITATIONS",
          "content": "The sample size was small, and assessment of end points was subjective."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Manipulative therapy for the shoulder girdle in addition to usual medical care accelerates recovery of shoulder symptoms."
        }
      ]},
