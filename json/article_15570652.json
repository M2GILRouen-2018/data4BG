      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe possible differences in psychological factors in men compared to women with fibromyalgia syndrome (FM)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Forty men and 160 women with FM were evaluated for anxiety, stress, and depression measured by ordinal scales and validated psychological instruments. Clinical and psychological variables were evaluated by a protocol."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Both men and women scored high in the psychological variables measured but the results were not significantly different between them."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "There was no significant difference between men and women with FM in their psychological status."
        }
      ]},
