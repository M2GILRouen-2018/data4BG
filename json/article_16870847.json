      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "This study is part of an active surveillance program for monitoring animal health status in endangered species, and was conducted to screen captive Barbary sheep (Ammotragus lervia) for hemoplasma infection."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "A total of 12 blood samples were collected, DNA extracted and further tested by a pan-hemoplasma polymerase chain reaction protocol."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Animals were clinically healthy and not infested by ectoparasites. Although housekeeping gene DNA was successfully amplified, all the Barbary sheep samples tested negative for Mycoplasma sp."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Notwithstanding the negative results, molecular pathogen surveys on Barbary sheep and other exotic wild mammals may provide insights regarding infection of endangered species caused by captivity stress in association with exposure to new pathogens worldwide."
        }
      ]},
