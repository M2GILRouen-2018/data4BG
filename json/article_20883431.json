      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This article provides a summary for advocacy, court testimony, assessment, treatment, prevention, and further research studies in the field of childhood sexual abuse."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "A literature review identifies the psychiatric, social, and disease disorders to which this population is predisposed. Adult survivors experience more depression, obesity, autoimmune disorders (irritable bowel syndrome, asthma, fibromyalgia), eating disorders, and addictions."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "PRACTICE IMPLICATIONS",
          "content": "A holistic perspective allows understanding of health consequences for survivors. A model through which to consider these phenomena is presented."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The long-term consequences of childhood sexual abuse must be assessed and addressed by healthcare professionals."
        }
      ]},
