      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Postprandial hyperlipidaemia may be a predictor of vascular risk."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "We evaluated postprandial lipaemia after an oral fat tolerance test (OFTT) in men (n=41) and women (n=21) with metabolic syndrome (MetS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Triglyceride (TG) levels were measured before and 2, 4, 6 and 8 h after the fat load."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Men showed a greater plasma TG response 8 h after the fat load (284+/-117 versus 224+/-126 mg/dl, P=0.029). Only fasting TG levels significantly predicted the TG area under the curve (AUC) and incremental AUC."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Men had a more pronounced postprandial hypertriglyceridaemia and seem to have delayed TG clearance."
        }
      ]},
