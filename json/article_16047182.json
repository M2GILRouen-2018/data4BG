      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the analgesic efficacy of preoperative rofecoxib in patients who underwent uterine curettage."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "This double-blinded, randomized, placebo-controlled trial included 80 women who underwent uterine curettage. Forty women were randomly assigned to rofecoxib 50 mg and 40 women to the placebo. The main outcome measure was the intensity of pain measured by the visual analog scale and categorical pain scores during and after the procedure. Chi-squared, Fisher exact, Student t test, and Mann-Whitney U tests were used for statistical analysis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The intensity of pain was not found to be different between groups over the course of procedure (P>0.05). There were no serious adverse effects in this study."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The preoperative administration of rofecoxib was not effective in reducing pain in uterine curettage."
        }
      ]},
