      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe electrophysiological studies, what they investigate, and their contribution and limitations in the assessment of pelvic and perineal pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHOD",
            "content": "Description of the electrophysiological techniques generally used to evaluate somatic nerves of the pelvic and perineal region (analytical electromyography, nerve conduction velocities, reflexology), their applications and the difficulties of interpretation."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Electrophysiological studies can demonstrate signs in favour of peripheral neuropathy, specify the axonal and/or demyelinating type of lesion, and provide topographic arguments on the type of trunk or nerve root involved (pudendal nerve, sacral nerve roots, ilioinguinal or iliohypogastric nerve, genitofemoral nerve, obturator nerve)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Electrophysiological studies require a technically skilled operator and can provide a better understanding of some types of pain, but are not sufficiently sensitive and specific. The conclusions of electrophysiological study reports must be closely correlated with clinical findings."
          }
        ]
      },
