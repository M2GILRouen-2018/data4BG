      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND CONTEXT",
          "content": "Pregnancy- and lactation-associated osteoporosis is an uncommon condition that may be a consequence of preexisting low bone density, loss of bone mineral content during pregnancy, and increased bone turnover."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To present a case of severe osteoporosis associated with pregnancy and lactation and its treatment protocol."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN/SETTING",
          "content": "A tertiary care hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT SAMPLE",
          "content": "A young female after twin pregnancy presenting with severe osteoporosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The diagnosis was done on the basis of bone mineral density (BMD) measurement. The patient was treated with first alendronate and then strontium ranelate. She was considered as a candidate for kyphoplasty."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A dramatic increase in the BMD and palliation of back pain were observed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Strontium ranelate may be a new alternative in the treatment of pregnancy- and lactation-associated osteoporosis."
        }
      ]},
