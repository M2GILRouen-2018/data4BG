      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To study effectiveness of enzyme medicine pancitrate 25,000 in the treatment of chronic pancreatitis (CP)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Pain, stool, creato- and steatorea, other signs of CP were examined before and after pancitrate treatment of 17 patients with chronic pancreatitis aged from 28 to 62 years."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pancitrate 25,000 reduced stomach pains in 16 of 17 patients. Stool returned to normal in 8 of 13 patients. Creato- and steatorea decreased."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "New dosage forms of the enzyme preparations (pancitrate 25,000, in particular) are highly effective both in deficiency of pancreatic external secretion and pain relief in exacerbation of CP."
        }
      ]},
