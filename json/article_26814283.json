      "Abstract": {
        "CopyrightInformation": "© 2015 American Academy of Pain Medicine. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Platelet-rich plasma (PRP) has been found to be effective for a variety of musculoskeletal conditions. The treatment of discogenic pain with PRP is under investigation."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess changes in pain and function in patients with discogenic low back pain after an intradiscal injection of PRP."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Prospective trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Patients were diagnosed with discogenic low back pain by clinical means, imaging, and exclusion of other structures. Provocation discography was used in a minority of the patients. Patients underwent a single treatment of intradiscal injection of PRP at one or multiple levels."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Patients were considered a categorical success if they achieved at least 50% improvement in the visual analog score and 30% decrease in the Oswestry Disability Index at 1, 2, and 6 months post-treatment."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "22 patients underwent intradiscal PRP. Nine patients underwent a single level injection, ten at 2 levels, two at 3 levels, and one at 5 levels. Categorical success rates were as follows: 1 month: 3/22\u2009=\u200914% (95% CI 0% to 28%), 2 months: 7/22\u2009=\u200932% (95% CI 12% to 51%), 6 months: 9/19\u2009=\u200947% (95% CI 25% to 70%)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This trial demonstrates encouraging preliminary 6 month findings, using strict categorical success criteria, for intradiscal PRP as a treatment for presumed discogenic low back pain. Randomized placebo controlled trials are needed to further evaluate the efficacy of this treatment."
          }
        ]
      },
