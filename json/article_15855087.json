      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Cardiac CT is rapidly becoming part of clinical practice. The objective of this article is to discuss and illustrate the current practice of coronary artery MDCT, including data acquisition, postprocessing, image display, and interpretation. The practice described reflects our experience with a series of patients referred in routine clinical practice."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The reader should gain an insight into the current clinical application of coronary artery CT."
        }
      ]},
