      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND OBJECTIVES",
          "content": "Pain resulting from head and neck cancer can be severe and difficult to manage. Avoiding hospitalization for as long as possible with a reasonable level of comfort requires a number of therapeutic modalities. The usefulness of self-administered sphenopalatine ganglion block was evaluated in a patient with lethal midline granuloma requiring large doses of morphine."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A 30-year-old woman with intractable pain from lethal midline granuloma was taught to self-administer 4% lidocaine, 1.5 mL topically into each nostril three times per day."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A 3-month follow-up examination showed substantial pain relief and reduction in morphine requirement. No adverse side effects or complications developed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In certain patients, sphenopalatine ganglion block can be effectively self-administered at home to manage chronic pain."
        }
      ]},
