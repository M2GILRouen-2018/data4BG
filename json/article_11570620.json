      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Acetaminophen hypersensitivity is rare and, when seen, is usually in association with sensitivity to nonsteroidal anti-inflammatory drugs."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This is a case report of an immediate reaction to acetaminophen, confirmed by a drug challenge, in a subject who tolerated ibuprofen."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After an oral challenge with 50 mg of acetaminophen, the subject had generalized pruritus, urticaria, and dyspnea."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This patient demonstrates a rare but potentially severe reaction to acetaminophen that may occur in patients who are not otherwise sensitive to other nonsteroidal anti-inflammatory drugs."
        }
      ]},
