      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The aim of the study was to evaluate the effect on articular pain of 100 mg of disodium-clodronate administered daily by intramuscular injection in patients affected by rheumatoid arthritis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We studied 24 patients with established rheumatoid arthritis, in the II and III stage according to Steinbrocker. Visual analogue pain scale, physician global assessment activity and patient global assessment activity were recorded at baseline, after 30 days and after 60 days of treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "VAS significant improvement after 30 days was found. The physician and patient global assessment activity were improved after 60 days of treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Disodium-clodronate given by intramuscular injection at the dose of 100 mg/die in rheumatoid patients vas effective in relieving joint pain during a two-month observation."
        }
      ]},
