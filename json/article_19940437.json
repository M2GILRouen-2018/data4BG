      "Abstract": {
        "CopyrightInformation": "Copyright 2009 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Psoriatic arthritis often affects patients with psoriasis."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the effect of adalimumab on psoriatic arthritis in patients with moderate to severe psoriasis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Data from patients with psoriasis and a reported history of comorbid psoriatic arthritis in 3 randomized, placebo-controlled psoriasis trials of adalimumab were analyzed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Adalimumab (n = 274) reduced the risk of psoriatic arthropathy adverse events by 75% versus placebo (1.1 vs. 4.8%; p = 0.025). Psoriasis/psoriatic arthritis-related pain was significantly reduced (-31.3 vs. -5.6 visual analog scale units; p < 0.0001). At week 16, adalimumab-treated patients were more likely to respond (56.9 vs. 4.5%; p < 0.001) and responded for a greater percentage of follow-up time (39.3 vs. 2.9%; p< 0.0001) than placebo-treated patients (regression model for PASI 75 and ACR 20 responses)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Adalimumab treatment of moderate to severe psoriasis reduced symptoms of comorbid psoriatic arthritis."
          }
        ]
      },
