      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Asthma is a genetically complex disease characterized by respiratory symptoms, intermittent airway obstruction and airway hyper-responsiveness due to airway inflammation and remodelling. The ADAM33 gene is associated with asthma and airway hyper-responsiveness and is postulated as a gene for airway remodelling."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate whether polymorphisms of the ADAM33 gene are associated with accelerated lung function decline in patients with asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In a cohort of 200 asthma patients followed over 20 years, eight single nucleotide polymorphisms of the ADAM33 gene were analysed to estimate their effect on annual FEV(1) decline."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The rare allele of the S_2 polymorphism was significantly associated with excess decline in FEV(1) (P<0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "These findings suggest that a variant in ADAM33 is not only important in the development of asthma but also in disease progression, possibly related to enhanced airway remodelling."
        }
      ]},
