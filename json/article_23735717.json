      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 The Society of Thoracic Surgeons. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Although peripheral arterial disease (PAD) is more prevalent among blacks, the effect of race on long-term survival after coronary artery bypass grafting (CABG) has not been examined in this population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A retrospective cohort study was conducted of CABG patients between 1992 and 2011. Long-term survival was compared in patients with and without PAD and stratified by race. Hazard ratios (HR) and 95% confidence intervals were computed using a Cox regression model."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 13,053 patients who underwent CABG, 1,501 (11%) had PAD, comprising 311 blacks and 1,190 whites. Median follow-up was 8.3 years. Long-term survival differed by race (no PAD: HR, 1.0; white PAD: adjusted HR, 1.5, 95% confidence interval, 1.4 to 1.6; black PAD: adjusted HR, 2.1, 95% confidence interval, 1.8 to 2.5; p < 0.0001 for trend)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Risk of death after CABG was comparatively higher among black PAD patients. This finding provides useful outcome information for surgeons and their patients."
          }
        ]
      },
