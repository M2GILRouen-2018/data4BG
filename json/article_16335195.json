      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe therapeutic effect of Ashi points Sihua needling method for treatment of acute soft tissue injury."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The patients were randomly divided into a treatment group (n = 105) and a control group (n = 108). They were treated respectively with Ashi points Sihua needling method and routine needling method. Their therapeutic effects and safety were assessed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The cured rate was 79.0% in the treatment group, better than 65.7% in the control group (P < 0.05); after treatment, the improvement degrees of pain, dysfunction and the total cumulative score in the treatment group were better than those in the control group (P < 0.05 or P < 0.01); the treatment group produced more quickly the effect with a shorter cured period as compared with the control group (P < 0.05 or P < 0.01)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ashi points Sihua needling method is safe and effective for acute soft tissue injury."
        }
      ]},
