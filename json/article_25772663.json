      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Editora Ltda. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "In this study, we aimed to investigate the presence of premenstrual syndrome (PMS), primary dysmenorrhea (PD) and depression among women with fibromyalgia (FM) and healthy females and to determine possible factors related with PMS and PD in FM."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "The present study was conducted on 98 female patients diagnosed with FM and 102 age and sex-matched healthy controls. All patients were evaluated for premenstrual syndrome (PMS) and primary dysmenorrhea (PD). Premenstrual syndrome was assessed among the patients for the presence of one or more affective or somatic symptoms within the five days preceding menses. The diagnosis of primary dysmenorrhea was defined as having abdominal pain or lower back pain lasting at least two days during a menstrual period. Dysmenorrhea was assessed via visual analog scale. Dysmenorrhea was rated via Multidimensional Scoring System. The Hamilton depression scale was applied to all patients."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Primary dysmenorrhea was established in 41% of FM patients and 28% of the control group. A statistically significant difference was found in PD between the two groups (p=0.03). PMS was established in 42% of the FM patients and 25% of the control group. A statistically significant difference was found in PMS between the two groups (p=0.03)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "There is an increased frequency of premenstrual syndrome and dysmenorrhea in FM patients. The patients with high symptom severity scores and high depression scores among the FM patients are at risk of PMS and PD."
          }
        ]
      },
