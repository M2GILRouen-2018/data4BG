      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "High-resolution magnetic resonance vessel wall imaging (MR-VWI) is increasingly used to study steno-occlusive cerebrovascular disease, but has not yet been applied to patients with aneurysmal subarachnoid hemorrhage (SAH)."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the ability of high-resolution MR-VWI to determine the site of rupture in patients with aneurysmal SAH."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Medical records of patients admitted with aneurysmal SAH between December 2011 and May 2012 were reviewed. MR-VWI was routinely performed for patients treated in the IMRIS Neurovascular Suite immediately before definitive treatment of the ruptured aneurysm."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "We report for the first time high-resolution MR-VWI in 5 patients with aneurysmal SAH. Three patients harbored multiple intracranial aneurysms. The ruptured aneurysms demonstrated thick vessel wall enhancement in all cases. None of the associated unruptured aneurysms demonstrated this MR imaging finding."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "High-resolution MR-VWI identified the site of rupture in patients with aneurysmal SAH, including those patients harboring multiple intracranial aneurysms. It may represent a useful tool in the investigation of aneurysmal SAH."
        }
      ]},
