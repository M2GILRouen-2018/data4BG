      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 John Wiley & Sons, Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "We designed an experiment to determine the comparative effectiveness of computer algorithms for performing automated long bone fracture reduction."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Automated reduction of 10 3D fracture models was performed using two computer algorithms, random sample matching (RANSAM) and Z-buffering (Z-Buffer), and one of five options of post-processing: none; iterative closest point algorithm (ICP); ICP-X1; ICP-X2; and ICP-X3. We measured the final alignment between the two fragments for each algorithm and post-processing option."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The RANSAM algorithm combined with postprocessing algorithm ICP-X1 or ICP-X3 resulted in the most accurate fracture reduction in the translational plane. No discernible difference was observed in the rotational plane. Automated reduction had more accurate translational displacement than telemanipulated manual reductions."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This study supports the use of the RANSAM algorithm for automated fracture reduction procedures. The use of ICP algorithms provides further optimization of the initial reduction."
          }
        ]
      },
