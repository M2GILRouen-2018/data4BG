      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case report of hydatid disease of the spine."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe an unusual case of hydatid disease of the sacrum affecting the sacroiliac joint and to discuss imaging, differential diagnosis, and treatment."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Hydatidosis or echinococcosis affecting the spine is rare and has a characteristic geographic distribution. Signs of sacroiliac joint involvement and accompanying neurologic deficits cause difficulties in differential diagnosis of this rare condition."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A case of 38-year-old female patient with low back pain and sciatica was presented."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Plain radiographs, computed tomography, and magnetic resonance imaging scans revealed destructive expansive lesion located on the right sacrum and extended through the right sacroiliac joint. Surgical enucleation of the cysts was performed together with mebendazole treatment and histopathologic examination confirmed hydatidosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This unusual disease should be kept in mind in the differential diagnosis of sacroiliac pain and sciatica, especially in endemic areas."
        }
      ]},
