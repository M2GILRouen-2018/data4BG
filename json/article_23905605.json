      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Association of maternal angiopoietin-like protein 6 (Angptl6) levels with subsequent development of pregnancy-induced hypertension (PIH)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "At 24 and 32 weeks of gestation in 47 relatively overweight (BMI\u2009≥\u200924\u2009kg/m(2)), nulliparous pregnant women serum concentrations of Angptl6 were quantified prospectively. Insulin sensitivity and lipids were measured at 24 weeks."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Angptl6 levels at 24 weeks, but not at 32 weeks, were significantly higher in women with subsequent PIH. Metabolic factors at 24 weeks did not correlate with Angptl6 levels."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This preliminary study suggests that in the second trimester, Angptl6 levels are higher in women with subsequent PIH."
        }
      ]},
