      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine whether watchful waiting was an appropriate strategy for patients with earache, when there was no clear indication to prescribe antibiotics at the first visit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case series of consecutive patients with unilateral earache."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Rural family practice clinic and walk-in centre."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "One hundred patients with unilateral earache."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients who clearly needed antibiotic treatment were given it; others were advised about symptom relief and were followed up as necessary."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Whether patients returned to the clinic, and whether antibiotics were subsequently prescribed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Two patients were prescribed antibiotics at the first visit. Of the remaining 98 people, only four returned to the clinic because of earache, and two of these were prescribed antibiotics. Thus, of 100 people with earache, four received antibiotic prescriptions."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Most people who present to primary care physicians with earache do not need antibiotics for what appears to be a mostly self-limiting condition. Both physicians and patients should be educated about this."
        }
      ]},
