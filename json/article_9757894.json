      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a simple technique for diagnosing stenosis of the external cervical os and to evaluate an association between stenosis of the external cervical os and endometriosis in women with chronic pelvic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case series."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Academic medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Twenty-five women with chronic pelvic pain and stenosis of the external cervical os."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Measurement of the diameter of the external cervical os."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Association between cervical stenosis and surgically documented endometriosis in women with chronic pelvic pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Endometriosis was visually documented at surgery for 24 of 25 women with chronic pelvic pain and stenosis of the external cervical os."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Endometriosis is a common finding in women with both stenosis of the external cervical os and chronic pelvic pain."
        }
      ]},
