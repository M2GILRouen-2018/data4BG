      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To study about the usefulness of Waist-Height Ratio as a clinical marker in patients with Metabolic Syndrome."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "A clinic-based study of patients attending a secondary level Diabetic Clinic and correlation of their Anthropometry data like waist circumference, height to other parameters namely body mass index (BMI), Waist-Hip Ratio, Blood pressure, Glycemic Control, Lipid Profile, and Duration of Diabetes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INCLUSION CRITERIA",
          "content": "Randomly selected 10 000 patients attending a secondary level diabetic clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "EXCLUSION CRITERIA",
          "content": "Type 1 DM, Gestational Diabetes."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "Waist-Height Ratio is a better parameter than Waist-Hip Ratio and it is significant in applying for people with different Stature with Normal BMI."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Waist-Height Ratio is a better and easier tool when compared with BMI or Waist-Hip Ratio and can be used for assessment of Cardio-metabolic parameter for public health."
        }
      ]},
