      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVES",
          "content": "To examine the effects of acute exposure to carbon monoxide and hypoxia on plasma lipids, lipoproteins, and apolipoproteins."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Random-order assignment to blinded, inhaled exposures of carbon monoxide and hypoxia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Research laboratory of ambulatory subjects."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "10 elderly, male nonsmokers with chronic stable angina."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Random-order two-hour inhaled exposure to clean air at sea level, carbon monoxide at sea level, carbon monoxide at high altitude, and clean air at high altitude."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Fasting plasma lipids, lipoproteins, and apolipoproteins before and after exposures."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No differences were noted between fasting plasma lipid, lipoprotein, or apolipoprotein levels before and after exposures."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Acute exposure to carbon monoxide and high altitude does not affect fasting plasma lipid, lipoprotein, or apolipoprotein levels."
        }
      ]},
