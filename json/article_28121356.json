      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of this study was to investigate the effect of the heparanase inhibitor OGT2115 on the tumorigenic properties of KB oral cancer cells."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "We treated KB cells with different concentrations of OGT2115. Then proliferation, invasion, and migration were detected using different assays. Cell cycle was explored using flow cytometry."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "We found that the treatment inhibited proliferation, invasion, and migration in a dose-dependent manner. OGT2115 also increased the apoptosis of KB cells and blocked cell cycle in S-phase."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Our results support the use of the heparanase inhibitor OGT2115 to inhibit several tumorigenic activities of KB oral cancer cells."
        }
      ]},
