      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the diagnostic accuracy of 128-multi detector row computed tomography coronary angiography (MDCTCA) with that of invasive conventional coronary angiography (CCA) in the diagnosis of coronary artery disease (CAD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHOD",
          "content": "Forty-two consecutive patients underwent both MDCTCA and CCA. All MDCTCA were evaluated for the presence of obstructive coronary stenosis by a blinded experts, and results were compared with quantitative CCA."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Three vessels and five segments were uninterpretable on MDCTCA. Therefore, 123 vessels and 558 segments from 42 patients were analyzed. Sensitivity, specificity and positive and negative predictive values of computed tomography for detecting detect > 50% luminal narrowing were 100%, 91%, 91%, and 100%, respectively, by patient, 98%, 98%, 96%, and 99%, respectively, by vessel, and 98%, 99%, 94%, and 99%, respectively, by segment. Moreover accuracy for detecting > 70% luminal narrowing were excellent by patient, vessel, and segment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Noninvasive 128-detector row CT coronary angiography provides high diagnostic accuracy on per segment, vessel, and patient analysis."
        }
      ]},
