      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Musculoskeletal disorders are an important cause of disability and absence from work in industrialized countries. A number of studies reported the importance of occupational, personal and psycho-social factors in the aetiology of these work-related disorders."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES AND METHODS",
          "content": "To stress the complex relationships existing between risk factors, reporting findings from reviews and original studies regarding two of the most significant musculoskeletal disorders: carpal tunnel syndrome (CTS) and low back pain (LBP)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "More detailed epidemiological studies are needed to explore the interactions between risk (and protective) factors, since these can play the role of determinants, confounders or effect modifiers."
        }
      ]},
