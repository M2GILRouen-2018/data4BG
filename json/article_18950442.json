      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To assess the influence of fear avoidance beliefs (FAB) and catastrophizing on low back pain (LBP)-related disability in Spanish community dwelling retirees."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Correlation between variables measured with previously validated instruments."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Majorca, Spain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "1,044 community dwelling subjects attending conferences for retired persons."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Visual analog scales for LBP and pain referred to the leg (LP), Roland Morris Questionnaire (RMQ) for disability, FAB-Phys questionnaire (FABQ) for FAB, and the Coping Strategies Questionnaire (CSQ) for catastrophizing."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In subjects without clinically relevant LBP, FAB correlated moderately with catastrophizing (r = 0.535) and disability (r = 0.390), and weakly with LP (r = 0.119) and LBP (r = 0.197). In subjects with LBP, FAB correlated moderately with catastrophizing (r = 0.418) and disability (r = 0.408), and weakly with LP (0.152), but not with LBP. Correlations among CSQ, FABQ, and RMQ were similar in subjects with and without current LBP. In regression models, the coefficient for effect of FAB on disability was 0.14 for participants with no LBP, and 0.28 for those with pain. Corresponding values for catastrophizing were 0.17 and 0.19."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In Spanish community dwelling retirees, the influence of FAB and catastrophizing on LBP-related disability is clinically small."
        }
      ]},
