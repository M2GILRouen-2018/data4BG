      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We report a case of a patient receiving apixaban who developed a spontaneous subdural hematoma and declining mental status that improved after administration of a single dose of factor eight inhibitor bypassing activity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Comprehensive Stroke Center, Neurocritical Care Unit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT",
          "content": "A 76-year-old man presented to an outside facility with a chief complaint of headache and pain behind his right eye. A CT scan of his head revealed a subdural hematoma. The patient was transferred to our facility with worsening clinical status."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "After a confirmatory cranial CT scan revealed a worsening subdural hematoma with midline shift, a single dose of factor VIII inhibitor bypassing activity (25 U/kg) was administered."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Coagulation tests following the administration of factor VIII inhibitor bypassing activity and a follow-up CT scan confirmed hemostasis. The patient was discharged home with no focal deficits."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Factor VIII inhibitor bypassing activity may be a viable, nonspecific reversal agent for life-threatening bleeding associated with apixaban."
        }
      ]},
