      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Available evidence to help guide efficacious nonsteroidal anti-inflammatory drug and opioid analgesic prescribing will be reviewed."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Review."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The available evidence can guide but cannot provide any prescriber with absolute knowledge regarding outcome for these frequently prescribed and potentially dangerous agents. Knowledge of the available evidence and application of such to our patients on an individualized basis hopefully will help to optimize therapeutic goals and minimize harms."
          }
        ]
      },
