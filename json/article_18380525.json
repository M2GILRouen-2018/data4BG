      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "This study aimed to evaluate the laser therapy efficacy in paediatric dentistry, considering the subjective tolerance and acceptance of therapy in children needing both dental and soft tissue treatments."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A group of 50 patients from 6 to 12 years of age, needing both hard and soft tissue therapy was selected and treated, without anesthesia, with an Er,Cr:YSGG laser 2780 nm and an Er:YAG laser 2940 nm for a total of 100 treatments performed; before and after the treatment the patients experience was tested with Wong-Baker modified facial image scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The study showed a good percentage of acceptance and tolerance of both laser treatments: a success rate of 90 % for hard tissues and 63% for soft tissues was obtained; for the total 100 treatments the acceptance was of 75%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The Erbium lasers are very effective in paediatric dentistry and are good treatment options."
        }
      ]},
