      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare prevalence of overweight/obesity among adolescent school children of government and private schools."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A school-based cross-sectional study was conducted in 1800 children aged 10-16 years. Body mass index (BMI), Waist circumference (WC), Hip circumference (HC), and Neck circumference (NC) were measured using standard guidelines."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The prevalence of overweight obesity was 27.8% (private schools 45.2%, government schools 10.5%). BMI, WC, NC, and Waist-hip ratio were significantly higher among private school students."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A differential strategic plan may be needed to prevent and control obesity among adolescent school children."
        }
      ]},
