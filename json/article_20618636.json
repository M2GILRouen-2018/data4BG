      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This study examined types of chronic diseases present and nursing procedures administered in school, health promotion and disease prevention efforts, collaborative efforts, perception of school nursing activities, documentation media of school nursing activities, and student academic outcomes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND METHODS",
          "content": "A nonexperimental research design was employed. The sample (N= 63) was practicing school nurses in New Jersey public schools."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The increased numbers of students with chronic illnesses in mainstream classrooms have increased the roles and responsibilities of school nurses."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "PRACTICE IMPLICATIONS",
          "content": "School nurses can use the findings as a framework to articulate their roles and responsibilities."
        }
      ]},
