      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The purpose of this study was to review the results of 800 scaphotrapeziotrapezoid fusions performed over a 27-year period."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The patients were evaluated for postoperative range of motion, grip and pinch strength, pain, return to work, arthritis, and complications."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The overall range of motion was 70% to 80% of the nonoperated side and strength was 69% to 89%. Of the patients 88% returned to previous employment. Arthritis developed in 1.8% of the patients. The overall complication rate was 13.4%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Scaphotrapeziotrapezoid fusion is a viable treatment option especially for a high-functional-demand young population with significant wrist pathology. Complications, specifically nonunion, can be minimized with careful technique."
        }
      ]},
