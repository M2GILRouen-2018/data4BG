      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 SIR. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To evaluate the effect of sacroplasty on patient mobility and pain when performed as a treatment for sacral insufficiency fractures."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "Imaging with computed tomography (CT), magnetic resonance imaging, or bone scan confirmed the diagnosis of sacral insufficiency fractures. Baseline clinical mobility scale (CMS) score and visual analog scale (VAS) pain score were recorded. Sacroplasty was performed under CT guidance. Follow-up CMS and VAS scores were assessed at 4, 24, and 48 weeks."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Eighteen elderly patients (age 80 y ± 8.5; 17 women) were treated. Repeated-measures analysis of variance was conducted to assess changes in CMS and VAS scores over time. Pairwise comparisons revealed a significant increase in average CMS score between baseline and all three follow-up points-4 weeks (P < .001), 24 weeks (P < .001), and 48 weeks (P < .001)-indicating improvement in mobility over time. Pairwise comparisons revealed significant differences in mean VAS scores between baseline and all three follow-up time points-4 weeks (P < .001), 24 weeks (P < .001), and 48 weeks (P < .001)-indicating improvement in overall pain level over time."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Treatment with CT-guided sacroplasty for sacral insufficiency fractures in this elderly population resulted in significant improvement in patient mobility."
          }
        ]
      },
