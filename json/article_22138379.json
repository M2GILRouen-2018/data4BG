      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Few studies have examined the relationship between chronic pain and opioid abuse in non-clinical populations. We sought to investigate this in a street-recruited sample of active opioid abusers in Cumberland County, Maine, USA, a locale that had experienced substantial increases in opioid abuse."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A community-based sample was recruited using respondent-driven sampling. Participants were screened to identify those who had consumed illicit opioids in the prior month and administered a structured survey that included the Addiction Severity Index (ASI) and Brief Pain Inventory® (BPI)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "More than 40% of the 237 individuals reported recurring pain that interfered with daily living. For more than three-quarters of those reporting chronic pain, opioid misuse preceded the onset of chronic pain. The order of onset was not associated with differences in sociodemographic, current levels of drug misuse, or ASI and BPI scores. BPI scores were associated with medical and psychological ASI domains. Compared to those not reporting chronic pain, those doing so were more likely to have a regular physician but were more likely to report difficulty gaining admission to substance abuse treatment programs."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Chronic pain was a common co-occurring condition among individuals misusing opioids. Better efforts are needed to integrate pain management and substance abuse treatment for this population."
          }
        ]
      },
