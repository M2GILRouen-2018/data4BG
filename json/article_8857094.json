      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To evaluate the feasibility and safety of transcatheter arterial embolization (TAE) with the use of HepaSphere microspheres for hypervascular tumors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "This was a prospective multicenter open label clinical trial involving six institutions in Japan. TAE was performed with the HepaSphere microspheres for hypervascular tumors in various locations. The endpoint of the study was the feasibility and safety of the procedure. The feasibility and safety were evaluated according to technical success and adverse events, respectively. Adverse events that were related to TAE were evaluated by using the Common Terminology Criteria for Adverse Events, version 4.0."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Twenty-four patients were enrolled. The technical success rate was 100 % (24/24). Twenty-two (92 %) patients developed a total of 50 symptomatic adverse events, including 30 grade 1 events, 17 grade 2 events, and 3 grade 3 events. The most frequent adverse event was fever with an incidence of 63 %, followed by abdominal pain (25 %)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "TAE for hypervascular tumors with the HepaSphere microspheres was feasible and rarely caused major adverse events."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "TRIAL REGISTRATION",
          "content": "This trial was registered in JAPIC Clinical Trials Information (JapicCTI-111534)."
        }
      ]},
