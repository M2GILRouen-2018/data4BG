      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the relationship between burnout and behavior-related health risk factors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We collected data from a population-based sample (n = 3264) through interviews, questionnaires, and health examinations. Burnout was assessed using the Maslach Burnout Inventory-General Survey. Smoking, alcohol consumption, and leisure-time physical activity were self-reported. Obesity was based on measurements at screening."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Burnout and exhaustion were associated with a higher likelihood of risk factors. More specifically, burnout syndrome was related to low physical activity and obesity, exhaustion dimension to low physical activity and heavy drinking, cynicism dimension to low physical activity, and diminished professional efficacy to low physical activity, obesity, and lower likelihood of heavy drinking."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Improving working conditions and psychoeducation on recommended ways of coping and recovery could help to prevent negative health consequences of chronic work stress."
        }
      ]},
