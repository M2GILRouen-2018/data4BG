      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Several new medications have become available to physicians for the treatment of patients with rheumatoid arthritis (RA)."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "LEARNING OBJECTIVES",
          "content": "To familiarize the reader with these new medications, including their benefits and side effects."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Data sources include published articles regarding the use of these medications. Study selection includes available information obtained from an online literature search (Mayo Search) regarding these agents, with additional information from the manufactures and our pharmacy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The results of this review indicate that leftunomide (Arava) and etanercept (Enbrel) are useful new agents for treatment of patients with rheumatoid arthritis."
        }
      ]},
