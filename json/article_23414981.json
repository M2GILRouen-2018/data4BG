      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 National Association of Pediatric Nurse Practitioners. Published by Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Much has been written regarding poor physician adherence to the National Asthma Education, Prevention Program (NAEPP) guidelines, but no data are available regarding nurse practitioners (NP) adherence. This descriptive study compared NP adherence to figures reported for medical doctors (MDs) in the 2001 and 2007 analyses by Cabana and colleagues."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A national, cross-sectional survey approach was used to assess NP knowledge, attitudes, and behaviors regarding the NAEPP guidelines. The survey was adapted from Cabana's 48-item questionnaire."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "NPs provided more prescriptions of inhaled corticosteroids (ICSs) to patients with daily symptoms than did physicians (NPs, 79%; MDs, 54%). Overall, compared with MDs, NPs reported higher adherence on three of the four NAEPP guideline components surveyed, two of which were statistically significant."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "This survey suggests that NPs have greater adherence to prescribing ICSs than do MDs. However, improved adherence still needs to be a goal for all providers because prescription of ICSs is the cornerstone of management of persistent asthma."
          }
        ]
      },
