      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Both adaptive and innate immune systems are involved in coronary artery disease (CAD). The aim of this study was to evaluate TH17 cytokines expression profiles in un-stimulated peripheral blood lymphocytes (PBMCs) of patients with coronary artery disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Expression profiles of IL-17, IL-23, and TGF-β1 were determined in individuals with and without CAD using Real-time PCR."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A significant decrease in IL-23 gene expression in un-stimulated PBMCs of patients with CAD compared to those without CAD was found (p=0.003, OR=0.045, 95% CI: 0.006-0.355)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Our data reinforce the potential role of the IL-23 as a critical regulatory molecule that bridges the innate and adaptive arms of the immune system in the complex mechanisms associated with the development of atherosclerosis."
        }
      ]},
