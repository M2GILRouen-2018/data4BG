      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "We assessed performance and safety of the NuvaRing® Applicator."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We randomized women (18-45 years) to insert a placebo ring using the applicator or fingers-only and then vice versa. We assessed outcomes post-insertion and then 24-72 h later."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Insertion was 100% successful using both methods (applicator, n=163; fingers-only, n=162). A total of 8.6% (applicator) and 4.3% (fingers-only) of subjects reported at least 1 treatment-related adverse event (AE); all were mild. Subjects reported 5 applicator-related AEs (vulvovaginal pain, 4; abdominal cramping, 1). There was no vaginal bleeding within 15 h post-applicator use. Ring expulsions were rare (applicator, 1; fingers-only, 2)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "NuvaRing Applicator is effective and well-tolerated (NCT02275546)."
          }
        ]
      },
