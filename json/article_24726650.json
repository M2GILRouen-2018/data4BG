      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American College of Allergy, Asthma & Immunology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To summarize the identified molecular and cellular mechanisms relevant to clinicians evaluating patients with hypereosinophilic syndrome (HES)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "Review of relevant peer-reviewed literature."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY SELECTIONS",
            "content": "Studies on the pathogenesis of HES in relation to consensus definitions, disease classification, mechanisms of disease, and diagnosis and treatment are included."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Changes to the definition of HES have been proposed based on recent studies identifying specific cellular and molecular disease phenotypes. Identification of specific mechanisms of disease may have clinical and therapeutic significance. Despite recent advances, in most cases the molecular pathogenesis of HES remains unknown."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Identification of specific HES disease mechanisms empowers the practicing clinician to offer specific mechanism-based treatment options to patients with HES in their clinical practice."
          }
        ]
      },
