      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 AWHONN, the Association of Women\u2019s Health, Obstetric and Neonatal Nurses. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To conduct an integrative review to evaluate current literature about nonpharmacologic, easily accessible management strategies for pregnancy-related low back and pelvic pain (PR-LBPP)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "PubMed, CINAHL, Cochrane Database of Systematic Reviews."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY SELECTION",
            "content": "Original research articles were considered for review if they were full-length publications written in English and published in peer-reviewed journals from 2005 through 2015, included measures of pain and symptoms related to PR-LBPP, and evaluated treatment modalities that used a physical exercise or yoga-based approach for the described conditions."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA EXTRACTION",
            "content": "Electronic database searches yielded 1,435 articles. A total of 15 articles met eligibility criteria for further review."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "DATA SYNTHESIS",
            "content": "These modalities show preliminary promise for pain relief and other related symptoms, including stress and depression. However, our findings also indicate several gaps in knowledge about these therapies for PR-LBPP and methodologic issues with the current literature."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Although additional research is required, the results of this integrative review suggest that clinicians may consider recommending nonpharmacologic treatment options, such as gentle physical activity and yoga-based interventions, for PR-LBPP and related symptoms."
          }
        ]
      },
