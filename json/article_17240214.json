      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Carotid dissection is a rare cause of headache in pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A 38-year-old woman gravida 5 para 3-0-1-3 presented at 21 weeks with a headache. Imaging revealed carotid artery dissection."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Carotid artery dissection may cause refractory headache in pregnancy. Prompt anticoagulation is required due to the potential for stroke."
        }
      ]},
