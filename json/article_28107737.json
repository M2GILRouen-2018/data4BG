      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "Our study evaluates patient preferences toward screening CESM versus MRI."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "As part of a prospective study, high-risk patients had breast MRI and CESM. Patients completed an anonymous survey to evaluate preferences regarding the two modalities."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "88% of participants completed the survey. 79% preferred CESM over MRI if the exams had equal sensitivity. 89% would be comfortable receiving contrast as part of an annual screening test."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "High-risk populations may accept CESM as a screening exam and may prefer it over screening MRI if ongoing trials demonstrate screening CESM to be clinically non-inferior MRI."
          }
        ]
      },
