      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "A number of countries have healthcare systems where access to elective surgery is constrained. The inevitable outcome is wait lists for surgery. The objective of this study is to report cross-sectional health data collected from a broad sample of patients awaiting elective surgery and shed light on potential non-surgical treatments to improve health."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "RESEARCH DESIGN",
            "content": "Prospective cross-sectional survey of patients newly enrolled on the surgical wait list in the Vancouver Coastal Health region. Multivariate regression models were used to estimate the associations between patient characteristics and health, pain and depression."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASURES",
            "content": "Health status instruments were used to measure study participants' general health, pain, and depression immediately after they were enrolled on the wait list for one of the targeted elective surgeries."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A majority of patients reported some problems with pain or discomfort, and a large portion reported problems associated with anxiety or depression. Orthopedic patients were significantly more likely to report problems with mobility, usual activities and pain/discomfort. Neurosurgery patients were the most likely to report significant and severe depression."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The high rates of pain and depression not only have implications for patients' immediate health, but may also affect long-term surgical outcomes. This study draws attention to recognizing a wider array of morbidity, some potentially requiring non-surgical interventions, while patients wait for elective surgery. Policy options include re-examining the surgical triage system and expanding surgical capacity to match self-reported health."
          }
        ]
      },
