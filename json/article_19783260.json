      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND OBJECTIVE",
          "content": "The B-type natriuretic peptide (BNP) has recently emerged as a prognostic marker in acute coronary syndromes (ACS). This role is based on results from randomized trials and other high selected population studies. The aim of this study was to determine the prognostic value of BNP in unselected patients with non-ST-elevated-ACS."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHOD",
          "content": "BNP plasma concentrations were measured in 100 consecutive patients admitted in 2007 with non-ST-elevated-ACS, taking as cut-off value 80pg/ml (high BNP levels on 48% of patients)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After one year-of follow-up, 21 major adverse cardiovascular events occurred: 12 ACS, 7 hospitalizations for heart failure and 2 sudden cardiac deaths. No relationship was found between BNP levels and events on follow-up. BNP >80pg/ml was the only independent predictor of heart failure and death. No relationship was found between high levels of BNP and coronary events during the follow-up."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "BNP was an independent predictor of heart failure and mortality in unselected patients with non-ST-elevated-ACS."
        }
      ]},
