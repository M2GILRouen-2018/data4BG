      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study examined the hypothesis that among chronic pain patients lacking participation in activities, perceived pain-relevant spousal support would act to compensate for a low level of social reinforcement and provide a buffer against depression."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Hierarchical regression analyses were conducted to examine the relative and cumulative effects of support and activity, and their interactions, in the prediction of depression severity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The study setting was a training and research oriented Veterans Administration Medical Center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Participants were 105 married, male chronic pain patients evaluated for a comprehensive pain management program."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Depression severity was measured by the Beck Depression Inventory."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Three categories of activity, and perceived interference of pain accounted for significant proportions of the variance in depression severity scores beyond that accounted for by age and pain severity. Support was not predictive of depression. Interactions between interference and support, and between two of the specific activities and support added significantly to the prediction of depression."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Results are consistent with a buffering model of social support in which perceived spousal support among chronic pain patients appears to moderate the potentially deleterious effects of a low level of activity."
        }
      ]},
