      "Abstract": {
        "CopyrightInformation": "Georg Thieme Verlag Stuttgart.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Adamantiades-Behçet's disease is an immune-mediated vasculitis with relapsing course. It is characterised by the classic clinical trias of oral aphthous ulcers, genital ulcers and uveitis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "HISTORY AND FINDINGS",
            "content": "A 37-year-old woman suffered from systemic Adamantiades-Behçet disease with recurrent uveitis, oral ulcers, genital ulcers, arthralgia, erythema nodosum and folliculitis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "COURSE AND TREATMENT",
            "content": "Longterm interferon-α-2a (IFNα-2a) led to reduction of the clinical manifestations except for occasional occurrence of oral ulcers. One year after initiation of treatment however, the patient developed symptomatic hyperprolactinemia of unknown etiology."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Even in otherwise successful treatment with IFNα-2a possible side effects and complications of treatment can affect the course. Mastodynia and hyperprolactinemia have not yet been described as potential side effects of IFNα-2a."
          }
        ]
      },
