      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To describe the knowledge and attitudes of North Carolina nurses toward the management of cancer-related pain. The analysis focused on knowledge, attitude, and perception of barriers to pain management."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Exploratory, descriptive."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "North Carolina."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "A survey of 1,400 RNs were stratified by educational background and Area Health Education Center regions of the state; the response rate was 24%."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "An adapted version of The Wisconsin Pain Initiative Survey mailed to participants."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Nurses' knowledge, attitudes, and perception of perceived barriers to managing cancer-related pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Nurses who have cared for patients with cancer are more knowledgeable and have more liberal attitudes toward pain management from nurses who have not cared for patients with cancer. North Carolina nurses report knowledge and perception of barriers to pain management similar to those of Wisconsin nurses."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The experience of caring for patients who have cancer and pain influences nurses to report more liberal attitudes toward pain management."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Although nurses report increased knowledge of pain management in general, deficits continue to exist. Further research is needed to more fully understand the effect of educational and experience on practice."
        }
      ]},
