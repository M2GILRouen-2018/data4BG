      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To map different areas of pain sensitivity and to determine the existence and/or pattern of referred pain from upon stimulating the sinonasal cavity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Experimental human study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Mechanical and electrical stimulations to various anatomical structures and areas of the nasal and sinus cavities were conducted on nine volunteers. Intensity, location and character of pain were recorded in all subjects."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The postero-superior (cephalic) aspect of the nasal cavity, primarily the anterior face of the sphenoid sinus and the superior turbinate, were the most sensitive sites, and the antero-inferior (caudal) region was the least sensitive. Referred pain to the head and face was reported by several subjects."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Topographical differences in pain sensitivity exist in the sinonasal cavity. The phenomenon of referred pain from the nasal cavity was demonstrated."
          }
        ]
      },
