      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Academy of Dermatology, Inc. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Hidradenitis suppurativa (HS) is a chronic inflammatory disease of apocrine-bearing skin. Treatment is challenging and long-standing. Surgery is one of the treatment options with varying reported success rates."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study provides a comprehensive systematic review of surgical approaches in the management of HS."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A systematic literature search and meta-analysis of proportions were performed on the included studies."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of a total of 1147 retrieved articles, 22 were included in the analysis. These were the estimated average recurrences: wide excision, 13.0% (95% confidence interval [CI], 5.0-22.0%); local incision, 22.0% (95% CI, 10.0-37.0%); and deroofing, 27.0% (95% CI, 23.0-31.0%). In the wide excision group, recurrence rates were as follows: 15% (95% CI, 0-72%) for primary closure, 8% (95% CI, 2.0-16.0%) for using flaps, and 6.0% (95% CI, 0.0-24.0%) for grafting. The secondary intention healing option was most commonly chosen after local excision and deroofing."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "There was poor quality evidence and potential improper reporting of the results."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This systematic review found lower recurrence rates with wide excision, using skin flaps or skin grafts as the closure methods. The heterogeneity of the patient populations was high and statistically significant within and across all types of excisions."
          }
        ]
      },
