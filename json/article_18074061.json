      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the prevalence of allergic rhinitis and the factors associated with the use of emergency care services by children and adolescents with acute asthma submitted to inhaled corticosteroid therapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A cross-sectional study was conducted with 126 patients treated with beclomethasone dipropionate for 3 years. The factors associated with emergency care services in the third year of beclomethasone dipropionate treatment were assessed using logistic regression models."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The prevalence of allergic rhinitis amounted to 74.6% (95%CI 65.9-81.7). The presence of allergic rhinitis (OR = 2.98, 95%CI 1.10-8.06) and asthma severity (OR = 2.09, 95%CI 1.05-4.44) were independent factors for emergency care services."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The prevalence of allergic rhinitis was high and that, combined with asthma severity, constituted the major risk factor for the necessity of emergency care services. Health professionals should attempt to make an early diagnosis of allergic rhinitis in asthmatic patients."
        }
      ]},
