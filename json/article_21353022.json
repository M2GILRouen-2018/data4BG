      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 The Society of Thoracic Surgeons. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The Hexalon system (Castlewood Surgical, Inc, Dallas, TX) is a new device that facilitates a clampless, hand-sutured, vein-to-aorta anastomoses in no-touch off-pump coronary artery bypass surgery. Hexalon-facilitated anastomoses are structurally equivalent to traditional sutured anastomoses, but can be placed during off-pump coronary artery bypass surgery. It follows that these facilitated anastomoses would show similar patency rates to traditional sutured anastomoses. This is the first published data validating mid-term patency of Hexalon-facilitated anastomoses."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESCRIPTION",
            "content": "Evaluation of bypass grafts by cardiac computed tomography angiography is highly accurate and has increasingly been used to assess graft patency in anastomotic device feasibility trials. We studied 15 proximal Hexalon-facilitated anastomoses for patency in 10 patients at least 6 months after off-pump coronary bypass surgery using gated cardiac computed tomography angiography."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "EVALUATION",
            "content": "All 15 facilitated anastomoses were patent. All 10 CT studies were of sufficient quality for accurate interpretation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The Hexalon system is a new and potentially valuable tool in advancing off-pump coronary artery bypass surgery."
          }
        ]
      },
