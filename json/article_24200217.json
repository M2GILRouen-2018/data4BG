      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the relationship between binge eating behavior and weight loss maintenance over a two-year period in adults."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Secondary data analysis using the Keep It Off study, a randomized trial evaluating an intervention to promote weight loss maintenance."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "419 men and women (ages: 20 to 70\u2009y; BMI: 20-44\u2009kg/m2) who had intentionally lost ≥10% of their weight during the previous year."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Body weight was measured and binge eating behavior over the past 6 months was reported at baseline, 12 months and 24 months. Height was measured at baseline."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Prevalence of binge eating at baseline was 19.4% (n = 76). Prevalence of binge eating at any time point was 30.1% (n = 126). Although rate of weight regain did not differ significantly between those who did or did not report binge eating at baseline, binge eating behavior across the study period (additive value of presence or absence at each time point) was significantly associated with different rates of weight regain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Tailoring weight loss maintenance interventions to address binge eating behavior is warranted given the prevalence and the different rates of weight regain experienced by those reporting this behavior."
        }
      ]},
