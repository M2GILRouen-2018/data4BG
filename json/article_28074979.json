      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The search of efficient exercise alternatives to treat obesity is worthwhile."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To demonstrate the effect of high intensity intermittent exercise on body fat reduction in overweight and obese subjects."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "A group of 65 overweight and obese adult subjects (25 men), aged 18-65 years, participated during 12 sessions in a high intensity physical exercise program, 3 days/week. Weight, height and body fat was measured before and after the intervention by bioimpedance. Each session consisted of 1 min stationary cycling exercise at high intensity, followed by 2 min inactive rest. This cycle was repeated 10 times, thus the method is called 1*2*10."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was a significant reduction of body fat of -1.88 ± 2.8 and -3.44 ± 2.7 kg, in women and men, respectively (p < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The 1*2*10 training protocol lasting 12 weeks in association with nutrition counseling is effective in reducing body fat in overweight persons."
        }
      ]},
