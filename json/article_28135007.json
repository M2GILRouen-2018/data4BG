      "Abstract": {
        "CopyrightInformation": "© 2017 The American College of Veterinary Surgeons.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To report on a series of 4 horses with supraglenoid tubercle fractures repaired with locking compression plates."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Case series."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANIMAL",
            "content": "Four horses ranging in age from 6 weeks to 20 months and weighing from 121 to 425 kg with supraglenoid tubercle fractures of 1 day to 6 weeks in duration."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Supraglenoid tubercle fractures were reduced and stabilized with transversely positioned locking compression plate(s) with and without additional tension band wiring."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "All fractures reached bony union. Two postoperative surgical site infections were managed with drainage and antibiotherapy. Three of the 4 horses continued onto athletic careers including flat racing, dressage, and hunter/jumper competition. The remaining horse was lame for a prolonged period, but was sound at 4 years."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The application of one or two, transversely positioned LCPs should be considered for the repair of SGT fractures because of the relative ease of the technique, and its elimination of a biceps brachii tenotomy. All screws can be inserted in a lateral to medial direction without transection or drill penetration of the biceps brachii tendon."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL RELEVANCE",
            "content": "SGT fractures of various durations can be repaired in a wide range of horses with transversely positioned LCPs, and allow return to athletic function."
          }
        ]
      },
