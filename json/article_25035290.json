      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2014 Reprints and permissions: sagepub.co.uk/journalsPermissions.nav.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Solid pseudopapillary tumour of the pancreas is a rare lesion with low malignant potential occurring predominantly in young women. This is a report of an extremely rare occurrence of synchronous presentation of pseudopapillary tumour in the pancreatic head and tail of a 16-year-old female patient."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE PRESENTATION",
            "content": "The patient presented with a three-month intermittent upper abdominal pain and swelling. Computed tomography scan showed two separate masses, involving the pancreatic head and tail. The patient underwent surgery, where successful tumour enucleation of both tumours was performed. Histological report confirmed solid pseudopapillary tumour of the pancreas with the low malignant potential."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "To the best of our knowledge, this is the first report of synchronous presentation of pseudopapillary tumour of the pancreas."
          }
        ]
      },
