      "Abstract": {
        "CopyrightInformation": "Copyright © 2009 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "To investigate the efficacy of implantation of sirolimus-eluting stents (SES) in the ostium of coronary arteries."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We assigned 96 patients with lesions located in ostias of the coronary circulation to receive a SES or a bare-metal stent (BMS)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "At follow-up the late lumen loss was 0.07 mm in the SES versus 1.06 mm in the BMS group (p<0.001); -0.04 mm versus 0.11 mm (p = 0.12) in the neighbour ostium. The rate of target lesion revascularisation was 2% with SES and 39% with BMS (p<0.001), and major adverse cardiac events (MACE) 6% versus 41% (p = 0.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In patients with ostial coronary lesions the angiographic outcome is improved and the long-term MACE rate is low after SES compared with BMS implantation."
          }
        ]
      },
