      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine associations between time perspective and smoking, body mass index, and exercise."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In this community-based survey, adults reported smoking and exercise habits and weight and height and completed the Zimbardo Time Perspective Inventory."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Subjects (N=265) who were more future oriented reported more frequent exercise, but were more likely to smoke. Fatalistic and hedonistic present orientations were not associated with smoking, obesity, or exercise."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Time perspective is not consistently associated with common health behaviors in adults."
        }
      ]},
