      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the changes of haemostatic risk factors for coronary heart disease during a weight reduction programme in obese children and adolescents."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A short-term longitudinal study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Thirty-seven obese white girls (age, 12+/-1.8 y; body mass index (BMI), 26.9+/-5.25) and 19 obese white boys (age, 11.9+/-1.7 y; BMI, 26.2+/-5.2)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Fibrinogen, factor VII coagulant activity, von Willebrand factor antigen, and soluble P-selectin were determined before and after a 3 week programme including energy restriction and physical activities."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All determined haemostatic risk factors decreased significantly during the programme. Changes in risk factors were correlated to changes in body composition. Children and adolescents with the highest initial concentrations showed the greatest decreases."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Energy restriction combined with physical activity improves the haemostatic risk profile in obese children and adolescents."
        }
      ]},
