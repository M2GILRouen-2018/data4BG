      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 by the American College of Rheumatology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To study the relationship between cherry intake and the risk of recurrent gout attacks among individuals with gout."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We conducted a case-crossover study to examine the associations of a set of putative risk factors with recurrent gout attacks. Individuals with gout were prospectively recruited and followed up online for 1 year. Participants were asked to provide the following information regarding gout attacks: the onset date of the gout attack, symptoms and signs, medications (including antigout medications), and exposure to potential risk factors (including daily intake of cherries and cherry extract) during the 2-day period prior to the gout attack. We assessed the same exposure information over 2-day control periods. We estimated the risk of recurrent gout attacks related to cherry intake using conditional logistic regression. Odds ratios (ORs) and 95% confidence intervals (95% CIs) were calculated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Our study included 633 individuals with gout. Cherry intake over a 2-day period was associated with a 35% lower risk of gout attacks compared with no intake (multivariate OR 0.65 [95% CI 0.50-0.85]). Cherry extract intake showed a similar inverse association (multivariate OR 0.55 [95% CI 0.30-0.98]). The effect of cherry intake persisted across subgroups stratified by sex, obesity status, purine intake, alcohol use, diuretic use, and use of antigout medications. When cherry intake was combined with allopurinol use, the risk of gout attacks was 75% lower than during periods without either exposure (OR 0.25 [95% CI 0.15-0.42])."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These findings suggest that cherry intake is associated with a lower risk of gout attacks."
          }
        ]
      },
