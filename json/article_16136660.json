      "Language": "fre",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To describe and compare practices and complications of induced abortions (IA) between 12 and 14 gestational weeks (GW) with those performed at lower terms (8-10 and 10-12 GW)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "Cohort study enrolled in two IA centers 411 women, 147 of them with 12-14 weeks gestation. Comparisons were made according to pregnancy term (8-10, 10-12 and 12-14 GW)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pregnancy term influenced the technical conditions of IA. Number and diameter of dilators and suction cannula as well as surgery time increase with gestational age--whether priming agents were used or not. Pain felt during surgery and early complications (within 15 days post IA) did not increase with gestational age."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Results of this study show that IA between 12 and 14 GW are as feasible as with lower terms."
        }
      ]},
