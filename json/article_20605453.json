      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Mastectomy due to breast cancer is associated with chronic pain and a negative impact on sexuality. The purposes of the study were to analyze the prevalence of pain and discomfort in the breasts, impact on sexuality, quality of life, and feelings of regret after bilateral prophylactic mastectomy and immediate reconstruction with implants."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Fifty-nine women operated 2004-2006 were included. A questionnaire was sent out two years after the procedure. Complications and re-operations were recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Mean follow-up time was 29 months. 93% of patients answered the questionnaire. 69% reported pain and 71% discomfort in the breasts. Lost or much reduced sexual sensations were reported by 85% and enjoyment of sex was negatively impacted for 75% of patients. Quality of life was not affected and feelings of regret were almost non-existent."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "It is important to inform women approaching this prophylactic procedure about the risk of having unwanted secondary effects."
          }
        ]
      },
