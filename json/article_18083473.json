      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To investigate the analgesic efficacy of preoperative flurbiprofen on postoperative pain after tonsillectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomized, nonblinded, non-placebo-controlled study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Municipal hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Twenty-five ASA physical status I patients older than 20 years of age, who were scheduled for tonsillectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients were randomly allocated to two groups to receive preoperative intravenous (IV) 50 mg flurbiprofen (group F) or not (group C). Anesthesia was induced with IV propofol two mg/kg and maintained with nitrous oxide and sevoflurane."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Pain scores at rest and at swallowing, intraoperative bleeding, vital signs during the postanesthetic period, interval until diclofenac sodium suppository rescue, and the total dose required for 12 hours postoperatively were all recorded."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MAIN RESULTS",
          "content": "Pain scores at rest as well as those recorded after swallowing 30 minutes after tonsillectomy were significantly lower in group F than in group C. During the first postoperative 1.5 hours, significantly fewer patients in group F required rescue diclofenac suppository than did group C patients. However, total dose of required rescue during the postoperative 12 hours in group F did not significantly differ from that of group C. There were no significant differences in intraoperative bleeding or in any vital signs during the postanesthetic period either."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Preoperative flurbiprofen suppressed immediate postoperative pain after tonsillectomy. The analgesic effect, however, disappeared in a few hours and was insufficient for overnight pain relief."
        }
      ]},
