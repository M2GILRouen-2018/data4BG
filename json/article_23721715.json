      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To study the effect of ketorolac, a potent anti-inflammatory medication, on in vitro fertilization (IVF) pregnancy outcomes when used at the time of oocyte retrieval."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective review of 454 patients from 2003-2009."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary hospital-affiliated fertility center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Consecutive subfertile women undergoing their first IVF cycle."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Ketorolac administration immediately after oocyte retrieval."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Pregnancy, implantation, live-birth, and miscarriage rates, and postsurgical visual analog pain score."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Of the 454 patients undergoing their first IVF cycle for all indications, 103 received intravenous ketorolac immediately after oocyte retrieval, based on anesthesiologist preference. Patient and procedural characteristics were similar between both groups. The use of ketorolac had no effect on the rates of implantation, miscarriage, pregnancy, live birth, or multiple pregnancy. The patients receiving ketorolac experienced statistically significantly less pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "This study suggests ketorolac has no apparent detrimental effect on IVF pregnancy outcomes when administered immediately after oocyte retrieval. Ketorolac appears to be a safe and effective analgesic to use at the time of oocyte retrieval."
          }
        ]
      },
