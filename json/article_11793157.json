      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "QUESTION",
          "content": "Which are the most effective treatments for acute and chronic low back pain?"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Systematic reviews were conducted including identification and selection of relevant trials, assessment of the methodological quality, data extraction (study populations, interventions, and outcomes), and data analysis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "acute low back pain. Nonsteroidal anti-inflammatory drugs (NSAIDs) and muscle relaxants relieve pain more than placebo; advice to stay active speeds up recovery and reduces chronic disability; bed rest and specific back exercises are not effective."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "chronic low back pain. Exercise therapy, back schools, behavioral therapy, and multidisciplinary programs are effective."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Scientific evidence shows that an active approach to low back pain patients is effective."
        }
      ]},
