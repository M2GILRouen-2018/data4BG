      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To discuss the evidence-based practice process for palliative care, from defining a clinical problem to implementation and evaluation of an evidence-based practice change."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Professional experience, literature, practice guidelines, and web sites related to evidence-based practice and palliative care."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Nurses caring for patients needing palliative care need evidence from multiple sources. Using a systematic process to find and appraise evidence followed by strategically planning for implementation and evaluation of evidence-based practice changes optimizes the likelihood of enhanced patient care."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "The integration of evidence-based practices into palliative care nursing will empower nurses to promote optimal patient outcomes and decrease practice variability."
        }
      ]},
