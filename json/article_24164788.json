      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the long-term outcome after intramedullary nailing of tibial shaft fracture."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective, cross-sectional study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Level I, Trauma Center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Retrospective review of 294 patients treated with intramedullary nailing after tibial shaft fracture from 1998 to 2008. The participants completed Knee injury and Osteoarthritis Outcome Score, and these data were compared with published reference population."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Intramedullary nailing of tibial shaft fracture."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Knee Injury and Osteoarthritis Outcome Score."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 223 patients agreed to participate (76%). Mean time of follow-up was 7.9 years. Compared to reference population, the study group reported 44% higher incidence of knee pain, 39% higher incidence of function in daily living limitations, 58% higher incidence of limitations in quality of life, and 60% higher incidence of limitations during sports activities. Comparison of age-related differences between the study group and reference population showed that the age group of 18-34 years reported the most difficulties."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Compared with reference population, 60% of the patients experienced limitations in activity and restrictions in quality of life and 44% reported knee pain. This was mainly evident among the young participants."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "LEVEL OF EVIDENCE",
          "content": "Therapeutic Level III. See Instructions for Authors for a complete description of levels of evidence."
        }
      ]},
