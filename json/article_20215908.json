      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare length of stay (LOS), clinical and psychological outcomes, and patient satisfaction before and after implementation of a chest pain critical pathway."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A pre- and post-test quasi-experimental design."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The Chest Pain Unit (CPU) of the Antwerp University Hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Patients admitted to the CPU with symptoms suggestive of an acute coronary syndrome older than 18 years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Implementation of a critical pathway focusing on implementation of the guidelines for the management of chest pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Patient satisfaction, length of stay and anxiety were evaluated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The median LOS of intervention subjects was almost 4 hours shorter than that of control subjects (without, P = 0.04, or with propensity correction, P = 0.019). The overall patient satisfaction with CPU care of the intervention group was significantly higher than that of the control group (without, P < 0.001, or with propensity correction, P < 0.001). Differences in anxiety and occurrences of major adverse cardiac events between the groups were not statistically significant."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A critical pathway can effectively and safely reduce LOS, increase patient satisfaction, and improve adherence to the guidelines for managing patients with chest pain. Anxiety is not statistically significantly reduced by this intervention."
        }
      ]},
