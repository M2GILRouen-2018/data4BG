      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study whether using 95% humidified, heated carbon dioxide (CO(2)) at laparoscopy reduces pain compared with dry, heated CO(2)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Patients were randomly assigned to either heated, 95% humidified CO(2) (study group) or heated, dry CO(2) (control group) during laparoscopy. Pain control was achieved per standard protocols. Pain scales were administered the first 4 hours and 24 and 48 hours postoperatively."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The 89 patients available in the intent-to-treat model revealed a decrease in total morphine equivalents and a decrease in pain scores at 1, 2, and 24 hours in the study group (directional P values < .05). Subgroup analysis in patients without chronic pelvic pain revealed lower mean pain scores at 1, 2, 24, and 48 hours and decreases in postoperative and total morphine equivalents (directional P values < .05) in the study group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "At laparoscopy, heated, 95% humidified CO(2) effectively decreases postoperative pain and narcotics usage compared with heated, dry CO(2)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "LEVEL OF EVIDENCE",
          "content": "II-2."
        }
      ]},
