      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the association between child care practices and child care provider knowledge and beliefs about their role in supporting children's healthful eating."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Longitudinal design using survey and observation data from baseline and year 1 of the Encouraging Healthy Activity and Eating in Childcare Environments (ENHANCE) pilot project."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Seventy-two child care providers from 45 child care settings."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Child care setting variables included the feeding environment, nutrition education, and family communication. Child care provider variables were efficacy, knowledge, and misconceptions about child feeding; and the priority placed on supporting children's healthful eating."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA ANALYSIS",
            "content": "Correlation and multiple linear regression were used to examine the association between variables."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Models indicated that changes in efficacy and feeding knowledge accounted for a significant portion of the variance in nutrition education changes (R(2) = 0.59) and family communication changes (R(2) = 0.29). A reduction in misconceptions was significantly associated with improved feeding practices (β = .71; P < .01; R(2) = 0.40)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Understanding child care providers' knowledge and beliefs regarding their role in children's healthful eating is an essential component of child care-based obesity prevention initiatives. Training should assess and address provider efficacy and misconceptions as well as educate providers about evidence-based practices related to child feeding, nutrition education, and family communication."
          }
        ]
      },
