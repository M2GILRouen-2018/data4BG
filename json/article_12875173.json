      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "ISSUES AND PURPOSE",
          "content": "To assess home asthma management among rural families with a school-age child who has asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND METHODS",
          "content": "Exploratory analysis of baseline data of a tri-ethnic sample of rural families with school-age children who have asthma."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Parents and children enact a moderate amount of asthma management behaviors. Preventive behaviors were correlated with the Asthma Behavior Inventory and treatment behaviors were correlated with the child's asthma severity. Factors that could affect asthma management include no insurance, no visits to providers in 12 months, or no asthma medications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "PRACTICE IMPLICATIONS",
          "content": "Nurses must use every contact with families to assess their asthma management and availability of resources, and to determine the fit between asthma severity and the asthma management plan."
        }
      ]},
