      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "QUESTION",
          "content": "Montelukast is used more and more by my patients with asthma. Is it safe to use during pregnancy?"
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "ANSWER",
          "content": "Cumulative data, including a recent Motherisk study, are very reassuring regarding the use of this drug to treat pregnant patients with asthma."
        }
      ]},
