      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Neck pain is a common presentation to the Emergency Department (ED), requiring appropriate evaluation to exclude serious pathology."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To review an atypical clinical presentation of neck pain and to distinguish this case and its associated radiographic features from more common clinical entities."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "We present an ED case of calcific tendonitis of the longus coli muscle."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "SUMMARY",
            "content": "Acute calcific retropharyngeal tendinitis is a rare, benign etiology of non-traumatic neck pain that is poorly recognized and often mistaken for other conditions secondary to infection or trauma. The importance of this disorder, as well as a review of the literature on the subject, is presented."
          }
        ]
      },
