      "Abstract": {
        "CopyrightInformation": "© Georg Thieme Verlag KG Stuttgart · New York.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Blood drawings are very painful and stressful for children. In a prospective control group study we investigated if using a picture book could reduce the children's pain expectation. In addition, the children's pain experience and the observed pain behaviour was monitored."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS/METHODS",
            "content": "Block-randomization were used and 120 children at the age of 6-12 years who were visiting the general pediatric and coagulation outpatient clinics were included in this study. Pain expectation and experience were assessed with the Face-Pain-Scale-Revised and the pain behavior with the Faces-Legs-Activity-Cry-Consolability Scale. Multivariate covariance analysis was used for data analysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The results showed that with statistical controlling the influence of the primary pain expectation (baseline) the pain expectation before blood withdrawal was reduced significantly (p=0.001) and effectively (ES=0.56) using the picture book. Children who received no local anaesthesia reported that they felt less pain during blood drawing after reading the picture book. The few children with local anaesthesia reported no benefit from the picture book. The observed use of local anaesthesia was very heterogeneous."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The results recommend the usage of this picture book in everyday practice, if the use of local anaesthesia could not be used in an appropriate way."
          }
        ]
      },
