      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the use of pre-operative leuprorelin acetate for reducing the morbidity from hysterectomy for nonfibroid menorrhagia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A double-blind, randomised, placebo-controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Gynaecology department in a large university teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "Fifty-one women without uterine fibroids awaiting abdominal or vaginal hysterectomy for dysfunctional uterine bleeding."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants received leuprorelin acetate or placebo for eight weeks prior to hysterectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Operative blood loss, operative difficulty, first day morphine use, speed of return to 'normal health'."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The study and control groups were similar as regards prognostic factors. Two women in the study group withdrew because of side-effects. Although a 34% reduction in uterine volume was seen in those treated with leuprorelin, there were no significant differences in operative blood loss (183 mL in the study group vs 285 mL in controls, P = 0.27), operation time (39 vs 49 min, P = 0.64) or operative difficulty (visual analogue scale 3.0 vs 4.0, P = 0.09). Furthermore, there was no difference between the groups in post-operative morbidity or rate of recovery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Treating women with leuprorelin acetate for 8 weeks prior to surgery for nonfibroid menorrhagia has no significant operative or post-operative benefits."
        }
      ]},
