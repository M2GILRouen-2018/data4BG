      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To ascertain the quality of analgesia provided by morphine in comparison to codeine."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "The study is a prospective, randomized, double-blind trial of analgesic effect employing validated pain scores."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Infants having primary cleft palate repair with informed parental consent to enter the study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Infants received one of two analgesics intraoperatively for immediate postoperative pain relief. Morphine was given by intravenous injection and codeine by the intramuscular route."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Pain scores in the immediate postoperative period for 2 hours following surgery; this outcome measure was decided prior to data collection."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The pain score and other outcome measures were all blinded. Measurements are all evident from the nature of the results."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "There was no clinically significant difference observed in the analgesic effect of either drug on the two groups studied."
        }
      ]},
