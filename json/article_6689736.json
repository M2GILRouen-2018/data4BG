      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Academy of Hospice and Palliative Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CONTEXT",
            "content": "Methadone is an important drug in the management of both cancer-related and non-cancer-related pain and is the main pharmacologic agent used in the treatment of opioid addiction. Unexpected hypoglycemia has been observed in patients receiving methadone, prompting a more detailed investigation."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate the incidence of hypoglycemia in a cohort of inpatients receiving methadone versus other opioids including fentanyl, hydromorphone, and morphine."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Retrospective observational cohort of inpatients in a tertiary cancer center admitted for more than 48 hours from November 1, 2011 to October 30, 2013. The main outcomes were lowest measured daily blood glucose (in mg/dL) and incidence of hypoglycemia (defined as blood glucose < 70 mg/dL, equivalent to 3.9 mmol/L) with variable methadone doses compared with other non-methadone opioids."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of the 641 eligible patients admitted during the study period who received at least one dose of methadone during admission, multivariable logistic regression showed significant associations between methadone and hypoglycemia at doses greater than 40 mg oral equivalents per day or with patient-controlled analgesia use. A dose-response relationship was observed, with an odds ratio of 3.1 (95% confidence interval 2.5, 3.6) when doses greater than 80 mg/day were used. No evidence of increased risk of hypoglycemia or of a dose-response curve was seen for the other opioids."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The risk of hypoglycemia is increased for patients taking more than 40 mg oral methadone equivalents per day. When starting methadone at or more than 40 mg/day, we recommend blood glucose monitoring."
          }
        ]
      },
