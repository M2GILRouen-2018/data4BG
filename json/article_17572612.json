      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To present a rare case of a notochordal cell tumor."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "We report on a 27-year-old female patient with pain at the lower back and muscle cramps in the area of the right hip. Image studies demonstrated a cystic lesion of the coccyx."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "As clinical symptoms became chronic and were resistant to conservative treatment, a resection of the coccyx was performed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Histology revealed an intraosseous benign notochordal cell tumor. This tumor represents a recently described notochordal cell proliferation biologically distinct from chordomas."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Overdiagnosis of these notochordal cell proliferations as chordomas may occur if clinicians and pathologists are unfamiliar with the spectrum of notochordal proliferations."
        }
      ]},
