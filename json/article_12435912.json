      "Abstract": {
        "CopyrightInformation": "Copyright 2002 S. Karger AG, Basel",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Diagnosis of small bowel volvulus is frequently delayed often resulting in bowel ischaemia and infarction and impairing clinical outcome. Instant and correct diagnosis and subsequent adequate surgery may improve the outcome."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We describe a 19-year-old female with small bowel obstruction due to volvulus in whom the diagnosis was suspected based on the finding of air in the bowel wall and in the portal vein on a plain abdominal radiograph."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Air, present in the portal vein and bowel wall on a plain abdominal X-ray, suggests bowel ischaemia or necrosis and that the need for laparotomy is urgent."
          }
        ]
      },
