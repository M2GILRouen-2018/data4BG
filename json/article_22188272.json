      "Abstract": {
        "CopyrightInformation": "© 2011, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The study examined the relationships between self-efficacy and physical activity in adolescent and parent dyads."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "A cross-sectional, correlational design was used to explore the relationships among levels of parent physical activity, parent-adolescent self-efficacy, and adolescent physical activity. Descriptive and multivariate regression analyses were conducted in a purposive sample of 94 adolescent/parent dyads."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Regression results indicated the overall model significantly predicted adolescent physical activity (R(2) = .20, R(2)(adj) = .14, F[5, 70]= 3.28, p= .01). Only one of the five predictor variables significantly contributed to the model. Higher levels of adolescent self-efficacy was positively related to greater levels of adolescent physical activity (β= .29, p= .01)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Practitioners are encouraged to examine the level of self-efficacy and physical activity in families in an effort to develop strategies that impact these areas and ultimately to mediate obesity-related challenges in families seeking care."
          }
        ]
      },
