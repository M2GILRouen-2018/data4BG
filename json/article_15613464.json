      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe current data evaluating the use of intensive lipid-lowering therapy in patients with coronary heart disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "A literature search using MEDLINE (1966-September 2004) was conducted using the search terms lipoproteins, low-density lipoprotein cholesterol (LDL-C), hydroxymethylglutaryl-coenzyme A reductase inhibitors, coronary arteriosclerosis, and coronary disease to identify published trials comparing the effects of intensive and conventional lipid-lowering therapy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "DATA SYNTHESIS",
          "content": "Intensive lipid-lowering therapy reduces LDL-C levels significantly more than conventional treatment and appears to reduce cardiovascular morbidity and mortality in patients who have recently experienced acute coronary syndrome (ACS). However, evidence suggesting clinical benefits in patients with stable coronary heart disease is currently lacking."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Although data are limited, patients with ACS may benefit from intensive lipid-lowering therapy. Several studies are underway to determine the appropriate role of intensive lipid-lowering therapy."
        }
      ]},
