      "Abstract": {
        "CopyrightInformation": "© 2017 International Federation of Gynecology and Obstetrics.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare the incidence of postoperative pain after suture- or mesh-based sacrospinous ligament suspension (SSLS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In a retrospective study, data were reviewed from patients who underwent suture- or mesh-based SSLS at a center in Skokie, IL, USA, between 2006 and 2011. The primary outcome was self-reported postoperative pain scores (range 0-10) on the day of surgery (day 0) and 1 day later (day 1)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Overall, 90 women were included in the study: 66 underwent mesh-based SSLS and 24 underwent suture-based SSLS. Day-0 mean pain score was 4.65 ± 1.57 in the mesh group and 5.24 ± 1.44 in the suture group (adjusted P=0.159). Day-1 mean pain score was 4.06 ± 1.78 in the mesh group and 4.31 ± 1.21 in the suture group (adjusted P=0.596)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Postoperative pain did not differ between patients undergoing suture-based and those undergoing mesh-based SSLS. These observations should be considered in preoperative counseling of patients."
          }
        ]
      },
