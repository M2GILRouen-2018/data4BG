      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "This study examined whether cardiac inpatients recall depression screening and how it is related to depressive symptoms and treatment one year later."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "2635 cardiac inpatients from 11 hospitals completed a survey and were mailed a follow-up survey one year later; both surveys included the BDI-II."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of the 1809 (68.7%) retained participants, 513 (30.0%) recalled depression screening. Recall was not significantly related to depressive symptoms at either time point (P > 0.05). Participants who were recommended antidepressants had higher BDI-II scores than those who were not, both as inpatients (P < 0.01) and one year later (P < 0.05). There was no significant change in depressive symptoms over time in patients who received any type of therapy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Less than one-third of cardiac inpatients recalled being screened for depression. Recall of screening was not significantly related to depressive symptoms, and use of treatment was related to greater symptoms."
          }
        ]
      },
