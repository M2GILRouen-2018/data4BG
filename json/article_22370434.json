      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the feasibility of integrating sleep management interventions with dietary and exercise interventions for obesity in a 12-week randomized trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We randomized 49 overweight or obese adult patients either to a better weight (BW) cognitive behavioral intervention, or to a combination of the BW intervention and a better sleep intervention, better weight-better sleep (BWBS)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The BWBS group lost weight faster (P=.04), and coping self-efficacy accelerated (P=.01)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These preliminary results merit replication in a larger primary care-based trial with a longer continuous intervention and follow-up period."
        }
      ]},
