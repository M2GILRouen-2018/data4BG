      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effectiveness of a peer-led asthma self-management program for adolescents."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized controlled trial comparing a peer-led asthma program (intervention group) and a conventional adult-led asthma program (control group). Each program was implemented at a full-day camp."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A city and adjacent suburbs in upstate New York."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "A total of 112 adolescents aged 13 to 17 years with persistent asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "A peer-led asthma self-management program implemented at a day camp."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The Child Attitude Toward Illness Scale and the Paediatric Asthma Quality of Life Questionnaire were administered at baseline and immediately and 3, 6, and 9 months after the intervention. Spirometry was conducted twice: before and 9 months after the intervention."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The intervention group reported more positive attitudes at 6 months (mean difference, 4.11; 95% confidence interval [CI], 0.65-7.56) and higher quality of life at 6 months (difference, 11.38; 95% CI, 0.96-21.79) and 9 months (difference, 12.97; 95% CI, 3.46-22.48) than the control group. The intervention was found to be more beneficial to adolescents of male gender or low family income, as shown by greater improvement in positive attitudes toward asthma and quality of life than their counterparts."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "An asthma self-management program led by peer leaders is a developmentally appropriate approach that can be effective in assisting adolescents with asthma in improving their attitudes and quality of life, particularly for males and those of low socioeconomic status."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "TRIAL REGISTRATION",
          "content": "clinicaltrials.gov Identifier: NCT01161225."
        }
      ]},
