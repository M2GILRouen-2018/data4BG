      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare changes in the concentrations of Lp(a) lipoprotein and other atherogenic lipids and lipoproteins in natural and hyperstimulated ovarian cycles."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Open, prospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Academic department in a teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Normal ovulatory women served as controls and the treatment group consisted of women undergoing ovarian hyperstimulation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "The treatment group received hMG on a fixed regimen."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Measurements of serum lipids and lipoproteins were made in both natural and hyperstimulated cycles."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "There was a significant increase in the median concentration of Lp(a) lipoprotein from 10.1 to 10.7 mg/dL in the luteal compared with the proliferative phase of unstimulated cycles. In hyperstimulated cycles, there was a significant increase in the median concentration of Lp(a) lipoprotein from 9.7 mg/dL in the proliferative phase to 11.3 mg/dL in the luteal phase. Reductions in concentrations of total cholesterol and low-density lipoprotein cholesterol were found in the luteal phase of hyperstimulated cycles."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Concentrations of Lp(a) lipoprotein increase during the luteal phase of both natural and hyperstimulated ovarian cycles."
        }
      ]},
