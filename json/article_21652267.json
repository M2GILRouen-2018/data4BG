      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To determine whether changes in food patterns over a period of 6 years were related to obesity in Tehranian adults."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Data on dietary intake, using the food frequency questionnaire, and anthropometry were obtained in 2 periods of the survey (1999-2001 and 2005-2007)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Participants of the Tehran Lipid and Glucose Study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Two hundred six adults."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Waist circumference, body mass index, and waist-to-hip ratio."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Food patterns were derived using factor analysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Three dietary patterns, the healthful (HDP), the western (WDP), and the mix, were identified. Increased WDP score was directly related to change in body mass index (β = .41, R(2) = 0.22, P < .001) among overweight/obese individuals. Alterations in waist circumference was better predicted by increased WDP score (β = .49, R(2) = 0.21, P < .01) than by increased HDP score (β = -.20, R(2) = 0.11, P < .05). Subjects in the higher quartile of increased HDP score had lesser change in waist-to-hip ratio (β = -.77, R(2) = 0.43, P < .01)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Results of this study indicate that increased adherence to the WDP and decreased adherence to the HDP could contribute to obesity."
          }
        ]
      },
