      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine the relationship between human leukocyte antigen (HLA) loci and restenosis after percutaneous transluminal coronary angioplasty (PTCA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND SETTING",
          "content": "Cross-sectional study in patients treated by PTCA at Juntendo University Hospital, Tokyo, Japan."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "A total of 65 patients (58 males and 7 females) with coronary artery stenosis who were consecutively selected between October 1994 and June 1995."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Significant relationships between the restenosis and the HLA-Cw1."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Among HLA-C locus, Cw1 was negatively related to restenosis (multivariate adjusted odds ratio, 0.19; 95% confidence interval, 0.06-0.63; P=.007)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In HLA typing, Cw1 may be a useful marker for the prediction of restenosis after PTCA."
        }
      ]},
