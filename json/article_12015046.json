      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the efficacy and toxicity of Serratia marcescens (S311) vaccine in the treatment of malignant pleural effusion."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Thirty-four patients with malignant pleural effusion were given S311 as intrapleural injection with a dose of 10(9) U (0.32 mg) on D 1, 8 and 15, and observed for four weeks."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The overall response rate (CR + PR) was 97.1% (CR in 12 patients and PR in 21 patients). The systemic toxicity was mild, including fever (82.4%), pleuritic pain (50.7%), nansea (26.5%), dyspnea (17.5%) and chills (5.9%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Serratia marcescens vaccine is effective for malignant pleural effusion, with tolerable toxic effects. Further study is warranted."
        }
      ]},
