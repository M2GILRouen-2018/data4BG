      "Abstract": {
        "CopyrightInformation": "Copyright 2010 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether nerve fibers can be detected in the endometrium and myometrium in women with painful uterine fibroids and adenomyosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A retrospective immunohistochemical study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "An academic training hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Thirty-seven women with uterine fibroids and 29 women with adenomyosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Histologic sections of contiguous endometrial and myometrial tissues were stained immunohistochemically using the highly specific polyclonal rabbit antiprotein gene product 9.5 (PGP9.5) and monoclonal mouse antineurofilament protein (NF)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Results were determined through immunohistochemical staining using PGP9.5 and NF."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "We detected PGP9.5-immunoactive nerve fibers in the functional layer of the endometrium in women with pain but not in women without pain. PGP9.5-immunoactive nerve fiber density in the basal layer of the endometrium or myometrium significantly increased in women with pain, however, PGP9.5-immunoactive nerve fiber density had no statistical differences between women with adenomyosis and uterine fibroids. We identified NF-immunoactive nerve fibers in the basal layer of the endometrium and myometrium in women with adenomyosis and uterine fibroids, but found no significant differences."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "These results suggest that PGP9.5-immunoactive nerve fibers appearing in the endometrium and myometrium of women with painful adenomyosis and uterine fibroids may play a role in pain generation in these two disorders."
          }
        ]
      },
