      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To investigate the long-term clinical outcome and to identify factors that predict that outcome, after conservative treatment of patients who have shoulder pain with or without accompanying stiffness."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cohort study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Eighty-two subjects who had participated in a randomized controlled trial that compared the short-term effectiveness of conservative treatment for chronic, unilateral shoulder pain of mechanical origin with and without accompanying stiffness, and who were available for longer term follow-up 6 months after the cessation of formal treatment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Conservative treatment consisting of various combinations of exercise therapy, passive joint mobilization, electrophysical modalities, and corticosteroid injections."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Pain intensity, functional limitation, perceived change in symptoms, active range of motion, muscle force, and clinical and demographic variables."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients showed significant improvement in all outcome measurements in the long-term whether or not their shoulder pain was accompanied by stiffness. Long-term outcome was not predicted by hand dominance, clinical history of the shoulder condition, severity of the shoulder problem, or shoulder mechanics."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Patients with chronic shoulder pain, with or without accompanying stiffness, can expect significant decreases in shoulder pain and improvements in shoulder function in the long term after conservative treatment."
        }
      ]},
