      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the effect of Buyang Huanwu Decoction (BYHWD) on the platelet function and fibrinolytic activity of unstable angina pectoris patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Using randomized single blind method divided 60 unstable angina pectoris patients into conventional treatment (control) group and conventional plus BYHWD (TCM) group."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "BYHWD could lower the levels of platelet aggregation, thromboxane B2 and the inhibitor of fibrinolysinogen activator (P < 0.05), but the activity of histo-type of fibrinolysinogen activator was enhanced."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "BYHWD was effective in treating unstable angina pectoris."
        }
      ]},
