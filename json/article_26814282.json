      "Abstract": {
        "CopyrightInformation": "© 2015 American Academy of Pain Medicine. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine the relationship between BMI and fluoroscopy time during intra-articular sacroiliac joint (SIJ) injections performed for a pain indication."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Multicenter retrospective cohort study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Three academic, outpatient pain treatment centers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "Patients who underwent fluoroscopy guided SIJ injection with encounter data regarding fluoroscopy time during the procedure and body mass index (BMI)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE",
            "content": "Median and 25-75% Interquartile Range (IQR) fluoroscopy time."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "459 SIJ injections (350 patients) were included in this study. Patients had a median age of 57 (IQR 44, 70) years, and 72% were female. The median BMI in the normal weight, overweight, and obese groups were 23 (IQR 21, 24), 27 (IQR 26, 29), and 35 (IQR 32, 40), respectively. There was no significant difference in the median fluoroscopy time recorded between these BMI classes (p\u2009=\u20090.45). First-time SIJ injection (p\u2009=\u20090.53), bilateral injection (p\u2009=\u20090.30), trainee involvement (p\u2009=\u20090.47), and new trainee involvement (trainee participation during the first 2 months of the academic year) (p\u2009=\u20090.85) were not associated with increased fluoroscopy time for any of the three BMI categories."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Fluoroscopy time during sacroiliac joint injection is not increased in patients who are overweight or obese, regardless of whether a first-time sacroiliac joint injection was performed, bilateral injections were performed, a trainee was involved, or a new trainee was involved."
          }
        ]
      },
