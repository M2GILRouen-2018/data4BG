      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the effects of sucrose on pain and biochemical markers of adenosine triphosphate (ATP) degradation and oxidative stress in preterm neonates experiencing a clinically required heel lance."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Preterm neonates that met study criteria (n = 131) were randomized into 3 groups: (1) control; (2) heel lance treated with placebo and non-nutritive sucking; and (3) heel lance treated with sucrose and non-nutritive sucking. Plasma markers of ATP degradation (hypoxanthine, xanthine, and uric acid) and oxidative stress (allantoin) were measured before and after the heel lance. Pain was measured with the Premature Infant Pain Profile. Data were analyzed by the use of repeated-measures ANOVA and Spearman rho."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We found significant increases in plasma hypoxanthine and uric acid over time in neonates who received sucrose. We also found a significant negative correlation between pain scores and plasma allantoin concentration in a subgroup of neonates who received sucrose."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "A single dose of oral sucrose, given before heel lance, significantly increased ATP use and oxidative stress in premature neonates. Because neonates are given multiple doses of sucrose per day, randomized trials are needed to examine the effects of repeated sucrose administration on ATP degradation, oxidative stress, and cell injury."
          }
        ]
      },
