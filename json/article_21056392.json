        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "How to propose psychotherapy in a patient with chronic pelvic and perineal pain?"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Description of the psychological and behavioural profile of patients with chronic pelvic and perineal pain, the indications for proposing psychotherapy and the reasons for choosing a particular type of psychotherapy."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Very few studies have analysed the impact of psychotherapy in the treatment of chronic pelvic and perineal pain and more extensive studies should be conducted."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Advice concerning the modalities of referring a patient to a psychotherapist, based on a multidisciplinary approach."
          }
        ]
      },
