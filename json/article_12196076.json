      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe heparin-induced thrombocytopenia (HIT or HIT-2), an immune-mediated adverse reaction to heparin or low-molecular-weight heparin. Available treatment options and considerations in developing a therapy approach are discussed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "A search of the National Library of Medicine (1992-June 2001) was done to identify pertinent literature. Additional references were reviewed from selected articles."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY SELECTION",
          "content": "Articles related to laboratory recognition and treatment options of HIT, including the use of agents in selected clinical conditions, were reviewed and included."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "HIT is a rare but potentially severe adverse reaction to heparin that was, until recently, poorly understood and had limited treatment options. Recent advances describing the recognition and clinical manifestations of immune-mediated HIT, including recently available antithrombotic treatment options, have dramatically changed outcomes for patients having this syndrome."
        }
      ]},
