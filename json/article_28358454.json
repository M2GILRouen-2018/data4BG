      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Objective",
          "content": "This study aims to observe the clinical efficacy of low-dose rituximab in patients with cryoglobulinaemia secondary to connective tissue diseases."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Methods",
          "content": "Rituximab (100 mg) was infused in patients once a week for four weeks, combined with prednisone (20 mg) once a day, and reduced regularly. Treatment effect was observed regularly."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Results",
          "content": "Joint pain, fever, rash and fatigue symptoms in patients eased. The serology (globulin, erythrocyte sedimentation rate, C-reactive protein, lactate dehydrogenase and others) parameters returned to normal."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Conclusion",
          "content": "Low-dose rituximab therapy for cryoglobulinaemia secondary to connective tissue diseases was safe and effective, and can be used as a treatment option in this condition."
        }
      ]},
