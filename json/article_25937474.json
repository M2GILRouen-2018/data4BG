      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 European Association for Cranio-Maxillo-Facial Surgery. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The present study evaluates the morbidity after iliac crest harvesting from the anterior iliac rim for oral onlay grafting and identifies influential factors."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "Twenty partially edentulous or edentulous patients (15 females and 5 males) with a mean age of 54.25 years (range 20-78 years, SD 13.86 years, remaining bone height <5 mm of the alveolar ridge) underwent iliac onlay bone grafting. The postoperative clinical morbidity was classified in minor and major complications and was evaluated with respect to body mass index (BMI)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The grafting procedure was successfully performed in all patients with a mean BMI of 23.34 (range 18-29, SD 3.36). A significant difference between BMI and walking aid necessity (p = 0.018) was demonstrated, but no difference between BMI and hip pain, duration of disturbance, gait disturbance, complication rate, and sensory loss was identified (p > 0.05). Between hip pain and scar length, age and hip/jaw pain did not demonstrate a significant difference (p > 0.05). Postoperative complications were minor and consisted of hematoma, seroma, and transient sensory disturbance."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Patients undergoing bone harvest from the anterior superior iliac crest with oral grafting show a low minor complication rate and a high overall satisfaction of 95%."
          }
        ]
      },
