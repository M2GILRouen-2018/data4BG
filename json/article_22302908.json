      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate gabapentin's role in head and neck cancer surgery following the demonstration of the effectiveness of gabapentin in reducing postoperative pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Non-randomised open-label trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Prince of Wales Hospital, Hong Kong."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Pain scores, analgesic usage, and the frequency of adverse effects."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "In patients undergoing anterolateral thigh flap reconstruction after resection of tongue carcinoma, those who had an oral dose of gabapentin before surgery were compared to those who did not."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Postoperative pain was reduced in the gabapentin group (1.2) compared to the control group (1.7) [P=0.05]. In the gabapentin group, mean morphine (patient-controlled analgesia) use (3.5 mg), sedation scores (1.0), and antiemetic usage (0 mg metoclopramide) were all significantly reduced in comparison to the controls with respective figures of 11.4 mg, 1.6, and 12.2 mg."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Single preoperative doses of gabapentin led to significant reductions in postoperative pain and nausea with reduced analgesic and antiemetic usage, without additional side-effects or increases in operative complications."
        }
      ]},
