      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To evaluate postoperative breathing patterns with a new monitoring device in patients given bupivacaine-morphine epidural analgesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Open explorative study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Inpatient anesthesia in a university hospital setting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "15 ASA physical status I and II patients aged 28 to 87 years and scheduled for major abdominal surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "All patients underwent abdominal surgery with epidural anesthesia combined with general anesthesia. Postoperatively, they continued with epidural analgesia consisting of bupivacaine and morphine. On the first postoperative night, the breathing pattern was studied with a new noninvasive monitoring device measuring respiratory frequency and apnea. Arterial blood gas analysis was performed in case of apnea or low respiratory frequency."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "A total of 84 alarm events were registered in 11 patients. Twenty-one percent (18/84) of the alarms were associated with arterial carbon dioxide tension (PaCO2) levels greater than 48.8 mmHg. Three of the four patients with PaCO2 levels greater than 48.8 mmHg were older than 80 years of age."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The tested noninvasive monitoring device may detect abnormal respiratory breathing patterns in patients at risk for respiratory depression during epidural analgesia with bupivacaine-morphine."
        }
      ]},
