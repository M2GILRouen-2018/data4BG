      "Language": "fre",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "To evaluate the efficiency of intraoral saccharose administration for analgesia among neonates born after at least 33 weeks of gestation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "POPULATION AND METHOD",
          "content": "Thirty-seven neonates from two neonatal units were tested using an objective scale of infants' pain. A double blind study of the heel prick response after saccharose vs. water administration was performed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Prior administration of saccharose significantly reduced the pain reaction (1.24 vs. 2.24, P < 10(-5))."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The analgesia obtained after an intraoral saccharose administration can be useful for repeated punctures for which common procedures of analgesia are ineffective. Beyond its use for heel prick, this procedure could be proposed for venous punctures when ELMA analgesia is not possible."
        }
      ]},
