      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE OF REVIEW",
          "content": "We provide a concise review of recent studies focusing on the management of patients with acute heart failure (AHF)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RECENT FINDINGS",
          "content": "In well designed randomized trials, no mortality benefit has been observed with the use of diuretics, ultrafiltration, inotropes and vasodilators in AHF. Recent trials examining the role of novel inotropes and vasodilators as well as the role of mineralocorticoid receptor antagonists in the AHF population, is reviewed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "The focus of therapy in AHF should be directed towards symptom management. No mortality benefit has been observed despite good quality studies."
        }
      ]},
