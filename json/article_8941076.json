      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of chronic pelvic pain associated with ovarian cholelithiasis and discuss prevention and management of this condition."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 39-year-old woman who presented with right lower abdominal pain after a laparoscopic cholecystectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Diagnostic laparoscopy followed by laparotomy with lysis of adhesions and removal of three to four dozen gallstones."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Patient's subjective report of pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Resolution of patient's pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Gallstones spilled into the peritoneal cavity may migrate and adhere to the dependent portions of the pelvis, potentially resulting in pelvic pain or infertility. This suggests the importance of removing inadvertently spilled gallstones at the time of surgery or using nonsurgical methods of gallstone management in reproductive-aged females."
        }
      ]},
