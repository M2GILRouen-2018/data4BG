      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Hanley & Belfus. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Randomized controlled trial."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Myofascial pain syndrome is characterized by myofascial trigger points (MTrPs) and fascia tenderness."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE OF THE STUDY",
            "content": "We investigated the effects of manual pressure release (MPR) alone or in combination with taping (MPR/MKT) in subjects with MTrPs."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Fifteen and 16 subjects received MPR and MPR/MKT respectively. Outcomes including Pressure pain threshold, muscle stiffness, mechanomyography were assessed at baseline, post-intervention and 7-days later."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pressure pain threshold improved significantly (d = 1.79, p < 0.005) in both groups. Significant improvement in muscle stiffness in the MPR/MKT group (0.27-0.49 mm) as compared to the MPR group (-0.02-0.23 mm). Mechanomyography amplitude in the MPR/MKT group was significantly higher than that of the MPR group (p < 0.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "MPR and MPR/MKT are effective in reducing pain in these subjects. MPR/MKT has a greater effect on muscle stiffness and contraction amplitude."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "IV."
          }
        ]
      },
