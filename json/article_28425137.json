      "Abstract": {
        "CopyrightInformation": "© 2017 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The case report details to use of three-dimensional (3D) printing as an aid to neuromodulation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A patient is described in whom previous attempts at spinal neuromodulation had failed due to lack of epidural or intrathecal access, and the use of a 3D printed model allowed for improved planning and ultimately, success."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Successful spinal cord stimulation was achieved with the plan developed by access to a 3D model of the patient's spine."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Neuromodulation techniques can provide the optimal analgesic techniques for individual patients. At times these can fail due to lack of access to the site for intervention, in this case epidural access. 3D printing may provide additional information to improve the likelihood of access when anatomy is distorted and standard approaches prove difficult."
          }
        ]
      },
