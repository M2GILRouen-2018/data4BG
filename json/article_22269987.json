      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of this study was to evaluate the impact of a workplace-based weight loss program (Workplace POWER [Preventing Obesity Without Eating like a Rabbit]) for male shift workers on a number of work-related outcomes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 110 overweight/obese (body mass index = 25-40) (mean [SD] age = 44.3 [8.6] years; body mass index = 30.5 [3.6]) male employees at Tomago Aluminium (New South Wales, Australia) were randomized to either (i) Workplace POWER program (n = 65) or (ii) a 14-week wait-list control group (n = 45). Men were assessed at baseline and 14-week follow-up for weight, quality of life, sleepiness, productivity at work (presenteeism), absenteeism, and workplace injuries."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Retention was 81%. Intention-to-treat analysis using linear mixed models revealed a significant intervention effect for weight, quality of life (mental), presenteeism, absenteeism, and injuries."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The Workplace POWER weight loss program improved a number of important work-related outcomes in male shift workers."
        }
      ]},
