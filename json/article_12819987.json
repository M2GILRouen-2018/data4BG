      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "The incidence of genital system hydatid disease in abdominal operation is 0.1%. During a period of 20 years (1957-1977), 12 cases were reported. This disease has no specific symptoms and findings. It is diagnosed intraoperatively."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "We report a 50-year-old patient admitted to our hospital with the complaint of abdominal pain and swelling, operated because of her adnexal mass and diagnosed as primary ovarian hydatid disease (echinococcosis)."
        }
      ]},
