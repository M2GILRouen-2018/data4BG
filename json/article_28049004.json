      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine metrologic properties of near-infrared spectroscopy (NIRS) versus transcutaneous oxygen tension (TcPO2) for microcirculatory assessment of vascular transtibial stumps at the stabilized period of prosthesis fitting, as a preliminary step before exploring its ability to predict stump healing, considering the previously identified limits of TcPO2 (borderline area between 15 and 35mmHg)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective single-center observational study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University-based rehabilitation center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Individuals with unilateral transtibial amputation for peripheral artery disease, at the definitive stage of prosthesis fitting, able to perform a 2-minute walk test (N=30)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Not applicable."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Test-retest, with the stump being evaluated in supine and inclined positions, first by NIRS (tissue saturation index [TSI], oxyhemoglobin, deoxyhemoglobin, and total hemoglobin) and second by TcPO2. Subjects carried out a 2-minute walk test and visual analog scales (wound healing and pain)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Feasibility and tolerance of NIRS were satisfactory. The reliability of NIRS and TcPO2 values was good (intraclass correlation coefficient >0.7; P<.05). No significant relation was found between NIRS and TcPO2. No responsiveness (inclined vs supine) was reported (P>.05). A significant relation between TSI and the 2-minute walk test (r>.49, P<.05) was found."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "NIRS is painless, complication-free, and feasible, with good reliability. NIRS evaluates others domain than TcPO2 that are more linked to metabolic adaptation. Its capacity to predict stump healing and tolerance to early prosthesis fitting is therefore interesting to estimate in future studies."
          }
        ]
      },
