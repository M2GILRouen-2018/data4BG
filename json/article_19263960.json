      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To evaluate simulation strategies used for adult branch nursing students in one university."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "A questionnaire was used to collect quantitative data and open comments (qualitative data). The evaluation was completed by 45 of a group of 60 second-year diploma nursing students."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "There was widespread agreement that simulation is a productive learning strategy that broadens theoretical learning and supports the practice element of nurse education. Areas commented on included developing confidence, individual support and linking theory to practice."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Simulation supports the practical learning experience. It will neither take the place of traditional methods of teaching nor replace good practice experience for nursing students, but can support both elements of nurse education."
        }
      ]},
