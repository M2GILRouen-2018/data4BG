      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 International Federation of Clinical Neurophysiology. Published by Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the effects neck-shoulder pain on the connectivity of surface electromyography (SEMG) signals during functional tasks."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twenty adults suffering from chronic neck-shoulder pain and 20 healthy controls were recruited. The SEMG signals from the left and right proximal cervical erector spinae, upper trapezius, lower trapezius and distal extensor carpi radialis, extensor digitorum, flexor digitorum superficialis and, abductor pollicis brevis were recorded during three functional tasks: unilateral and bilateral texting on a smart-phone and computer typing. Normalized mutual information (NMI) values were computed between homonymous proximal and distal muscle pairs as an index of the functional connectivity between muscles pairs."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "NMI among homonymous muscles pairs as well as among proximal and distal muscles pairs were lower among cases compared with controls. Moreover, NMI values in homonymous proximal muscles were higher during texting compared with computer typing with both hands."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our results show for the first time that chronic neck-shoulder pain affects the functional connectivity of muscle pairs."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "SIGNIFICANCE",
            "content": "The study furnishes novel information about the effects of chronic neck-shoulder pain on the interplay of muscle pairs during functional tasks."
          }
        ]
      },
