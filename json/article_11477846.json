      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe the therapeutic effect of Tongjing powder (TP) and understand the change in pathophysiology of dysmenorrhea, the blood flow parameters of uterine arteries and hemorheological data before and after the TP administration."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The blood of both uterine arteries of patients was examined by color doppler flow imaging. The hemorheological data was examined by conical viscosimeter. The two groups were compared with each other."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pulsation index (PI), resistance index (RI), systolic peak value/diastolic peak value (A/B value) of dysmenorrhea patients and hemorheological data except erythrocyte sedimentation rate of dysmenorrhea patients were significantly higher than the normal control group. After treating with TP, no difference existed between two groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The blood of dysmenorrhea patients appear to be viscous and adhesive, TP can improve the state of blood circulation and treat the dysmenorrhea effectively."
        }
      ]},
