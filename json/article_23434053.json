      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Canadian Cardiovascular Society. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "It has been suggested that more-complex fibrillation requires higher energy shocks to terminate. Furthermore, animal studies have demonstrated that shock timing also plays a role. The objective of this study was to test these assertions in a clinical context."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Near- and far-field electrograms were collected during defibrillation threshold testing. Fibrillation complexity was measured by quantifying the organization in the signals with wavelet-based methods, scaling exponent, and cross-correlation analysis. Receiver operator characteristic curves were used to determine predictive value. The effect of the phase at which defibrillation shocks were applied was also determined."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No measure was able to classify whether a particular shock would be successful. All performed very poorly. Shock timing played no role in defibrillation outcome."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Signal organization of a local electrogram and phase of shock delivery do not relate to minimum defibrillation shock energy immediately after ventricular fibrillation onset."
          }
        ]
      },
