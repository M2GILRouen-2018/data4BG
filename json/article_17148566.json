      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Leptin is associated with adiposity and insulin resistance and may play a direct role in vascular calcification. It is unclear, however, whether leptin is an independent predictor of atherosclerotic burden."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of this study was to examine the association between plasma leptin and coronary artery calcification (CAC) in an ethnically diverse cohort of older adult men and women free of clinical cardiovascular disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "This was a cross-sectional study with data collection between January 2002 and February 2004 as part of the ADVANCE Study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The study was conducted at an integrated health care delivery system in Northern California."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Participants included 949 men and women aged 60-69 yr old."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "There were no interventions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "The main outcome measure was CAC by multidetector row computed tomography."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In ordinal logistic regression, plasma leptin levels were positively associated with extent of CAC independently of age, race/ethnicity, and smoking status in women (odds ratio of higher CAC for the sex-specific upper tertile vs. lower tertile = 1.81; 95% confidence interval, 1.10-3.00) but not in men (odds ratio = 1.29; 95% confidence interval = 0.89-1.86). However, this association was explained by metabolic risk factors and adiposity measures."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Our findings support a role of leptin on vascular calcification in women but, in our sample of older adults, the association between leptin and CAC was not independent of other cardiac risk factors."
        }
      ]},
