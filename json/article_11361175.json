      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Duodenal obstruction occurred 4 years following gastric banding for morbid obesity, which had had a good result."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "A 56-year-old female with a history of gastric banding presented with duodenal obstruction."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "Physical and radiological examination was able to give the diagnosis. At surgery, the gastric band in the distal duodenum was removed. She was discharged on postoperative day 4, with no complication. At 6 months following discharge, her nausea and vomiting have not recurred."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Following gastric banding, band erosion through the gastric wall and internalization into the lumen can cause small bowel obstruction."
        }
      ]},
