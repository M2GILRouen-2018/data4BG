      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effects of triazolam upon insomnia and daytime sleepiness in patients with rheumatoid arthritis (RA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Triazolam or placebo was administered during two 7 night periods to 15 patients with RA in a double blind crossover study. Polysomnographic recordings were conducted on the last 2 nights of each condition, and multiple sleep latency tests and mood and arthritis assessments were performed during the intervening day in each condition."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In the triazolam condition, total sleep time was increased, daytime sleepiness was reduced, and morning stiffness was improved compared to placebo. Objective measures of sleep fragmentation were unchanged. Clinical arthritis assessments were similar during both conditions."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Short term hypnotic therapy improves sleep in patients with RA and appears to improve morning stiffness and daytime sleepiness."
        }
      ]},
