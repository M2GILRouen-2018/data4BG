      "Language": "rus",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To evaluate clinical and cost efficacy of urgent therapeutic measures for patients with acute bronchial asthma (BA) in a large industrial city."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHOD",
          "content": "380 patients with moderate and severe BA in emergency state were observed. 222 of them got berodual solution provided by pneumatic nebuliser, moistened oxygen and corticosteroids. 158 patients received standard emergency care. Bronchopulmonary and cardiovascular systems were studied."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The proposed therapy proved 1.6 and 2.6 times more effective in moderate and severe BA, respectively, than standard therapy. It made possible to reduce the treatment cost by 30%. An algorithm for emergency care for acute BA is designed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Differential emergency care is recommended for patients with acute bronchial asthma."
        }
      ]},
