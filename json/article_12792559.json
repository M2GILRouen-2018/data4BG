      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To investigate the potential pro-analgesic effect of the non-specific CCK antagonist proglumide on the analgesia produced by dihydrocodeine."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "A double-blind, placebo-controlled crossover study of 30 adult subjects."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Mean pain scores fell from a baseline of 8.12-7.89 during the placebo phase (N.S.) and to 6.82 during the proglumide phase (P < 0.05). Side effects were minor."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The CCK antagonist proglumide enhances the analgesic effect of dihydrocodeine."
        }
      ]},
