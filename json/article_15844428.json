      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To develop and validate a health-related quality-of-life scale for dogs with pain secondary to cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Questionnaire development."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANIMALS",
          "content": "40 healthy dogs with no history or signs of pain, 20 dogs with dermatologic disease but no signs of pain other than mild pruritus, and 20 dogs with cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PROCEDURE",
          "content": "Owners of all dogs completed a questionnaire containing 12 questions with 4 options for each question, and a quality-of-life score ranging from 0 to 36 was calculated. Scores for dogs with cancer were compared with scores for healthy dogs and dogs with dermatologic disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All owners indicated that the questionnaire was easy to complete. Scores for healthy dogs were significantly different from scores for dogs with cancer and scores for dogs with dermatologic disease. Scores for dogs with dermatologic disease were significantly different from scores for dogs with cancer."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS AND CLINICAL RELEVANCE",
          "content": "Results suggested that a simple questionnaire may be useful in assessing health-related quality of life in dogs with pain secondary to cancer, in that dogs with cancer had significantly lower scores than did healthy dogs and dogs with dermatologic disease."
        }
      ]},
