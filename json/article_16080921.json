      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND/PURPOSE",
          "content": "There are references in the medical literature that Henoch-Schönle purpura (HSP) and abdominal pain are contraindictions to performing contrast enemas (CEs) for diagnosis and possible reduction of intussusceptions. We investigated the safety of performing CEs in patients with abdominal pain and HSP."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A retrospective chart review and literature search were conducted."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "CEs were not associated with complications in patients with HSP and abdominal pain and intussusceptions."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "CEs are safe to perform in patients with HSP and suspected intussusceptions and may be useful for diagnosis and treatment."
        }
      ]},
