      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE OF REVIEW",
          "content": "Novel therapies, such as a heliox gaseous mixture and noninvasive bilevel positive pressure ventilation, are being utilized in the treatment of the patient with severe asthma who is unresponsive to conventional medical management. Aggressive treatment may prevent intubation and its untoward complications."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RECENT FINDINGS",
          "content": "Both heliox and bilevel positive pressure ventilation have demonstrated clinical improvement in studies of patients refractory to standard care, both in adults and children."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "The studies in children are limited but show promise, especially when these therapies are used early in the treatment course and in certain subsets of patients."
        }
      ]},
