      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Percutaneous tibial nerve stimulation (PTNS) is used to treat refractory urinary frequency, urgency, and urgency urinary incontinence. To date, it is not approved by the US Food and Drug Administration in the treatment of chronic pain syndromes, and its use in the treatment of chronic clitoral pain has not been reported."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We describe 2 cases of women who presented with symptoms of urgency urinary incontinence, urinary frequency, and clitoral pain. After inadequate response to conservative treatment of their urinary symptoms, they received PTNS."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "By the 12th session, significant improvement in urinary symptoms and resolution of clitoral pain were noted."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The findings of this report suggest that PTNS may be a therapeutic option in patients with idiopathic clitoral pain."
        }
      ]},
