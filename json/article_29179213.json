        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To present a case of a 6-month-old infant with melanotic neuroectodermal tumor of infancy (MNTI) in the upper arm."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CLINICAL PRESENTATION AND INTERVENTION",
            "content": "A 6-month-old female presented with a well circumscribed lesion of the upper arm at Children's Hospital Zagreb. Biopsy was performed and microscopy revealed two cell populations consisting of small neuroblastic cells and larger melanin-containing epithelial cells. Excisional biopsy performed one month later confirmed initial diagnosis of MNTI, but the tumor had increased in size since initial biopsy. After complete surgical excision patient recovered well with no recurrence."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The MNTI located in the upper arm was diagnosed on first biopsy and surgically excised completely and the patient recovered without recurrence in a follow-up of two and half years."
          }
        ]
      },
