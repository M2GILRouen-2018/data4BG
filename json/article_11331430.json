      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "A significant number of post-bariatric surgery (BS) patients present with eating disorders (EDs) symptoms that require specialized treatment. These cases are thought to be underreported due to their frequent sub-syndromal presentation. This article describes ED syndromes that develop subsequent to BS."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "The clinical charts of 12 individuals who were hospitalized on a specialized inpatient EDs unit were reviewed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Based on the new DSM-5 proposed criteria, six patients would meet criteria for an anorexia nervosa (AN) diagnosis: three with binge eating/purge AN subtype and three with restrictive AN subtype. An additional four met criteria for atypical AN, since they were at a normal weight, and two patients met criteria for bulimia nervosa."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Several similarities to the classical EDs were found. The findings that most distinguished these patients from those with classical EDs were their ages, and the age of onset of the ED for some patients."
          }
        ]
      },
