      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report our experience on laparoscopic resection of the cavitated noncommunicating rudimentary horn in 10 patients with unicornuate uterus."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A tertiary referral center for the treatment of female genital malformations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Ten consecutive patients operated between 1994 and 2002."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Laparoscopic removal of the rudimentary uterine horn."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Operating time, intraoperative and postoperative complications, relief of symptoms at a 6-month follow-up."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Median operating time was 65 minutes (range 40-92 minutes) with neither intraoperative nor postoperative complications. All patients were discharged within 72 hours from the procedure. Clinical follow-up during 6 months showed a marked improvement of symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Laparoscopy proves to be an effective surgical approach for the removal of the cavitated noncommunicating rudimentary horn in patients with unicornuate uterus."
        }
      ]},
