      "Abstract": {
        "CopyrightInformation": "© Georg Thieme Verlag KG Stuttgart · New York.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "Evaluation of the effectiveness of 2 implementation interventions - train-the-trainer workshops (TTT) and written implementation guideline (GL) - in terms of implementation fidelity of a back-training school within inpatient orthopedic rehabilitation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "An implementation trial was conducted using a mixed-methods approach for outcome evaluation in 10 rehabilitation clinics randomly assigned to the interventions. Data were assessed by questionnaires and observation forms."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Trainers in the TTT condition, as compared to trainers in the GL condition, rated both their patient-oriented back school practice (d=1.37) and achievement of manual-based educational goals (W=0.18) significantly higher. Patients in the TTT condition showed significantly higher treatment satisfaction compared to patients in the GL condition (d=0.44). There were no significant group effects regarding the observed fidelity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "An interactive TTT showed several benefits with regard to subjective outcomes compared to a written guideline."
          }
        ]
      },
