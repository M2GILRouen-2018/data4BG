      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 American Society for Reproductive Medicine. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe a case of acute portal vein thrombosis after IVF treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case report."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University teaching hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "A 39-year-old woman experienced worsening, right upper quadrant pain several days after oocyte retrieval; ET was withheld. Imaging studies revealed acute portal vein thrombosis with extension into the splenic and superior mesenteric veins."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Therapeutic anticoagulation; no ET was performed."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Improvement in symptoms, accurate diagnosis of condition."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Decreased size of portal vein thrombosis and partial vessel recanalization."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Thromboembolic events are a rare complication of assisted reproductive technology (ART). In women who present with upper abdominal pain during ART, portal vein thrombosis should be considered in the differential diagnosis."
          }
        ]
      },
