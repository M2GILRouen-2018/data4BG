      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Academy of Allergy, Asthma & Immunology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Allergic rhinitis (AR) is a common pediatric problem that significantly affects sleep, learning, performance, and quality of life. In addition, it is associated with significant comorbidities and complications."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim was to provide an update on the epidemiology, comorbidities, pathophysiology, current treatment, and future direction of pediatric AR."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Literature reviews in each of these areas were conducted, and the results were incorporated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The prevalence of AR is increasing in the pediatric population and is associated with significant morbidity, comorbidities, and complications. The mainstay of current treatment strategies includes allergen avoidance, pharmacotherapy, and allergen specific immunotherapy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In the future, diagnosis will be improved by microarrayed recombinant allergen testing and therapy will be expanded to include emerging treatments such as sublingual immunotherapy and combination products."
          }
        ]
      },
