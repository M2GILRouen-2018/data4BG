      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare college students' perceived disease risk with disease prevalence rates."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Data were analyzed from 625 college students collected with an Internet-based survey. Paired t-tests were used to separately compare participants' perceived 10-year and lifetime disease risk for 4 diseases: heart disease, cancer, diabetes, and overweight/obesity."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Respondents estimated their risk of developing heart disease as lower than cancer, yet rated their risk of developing heart disease as higher than diabetes and being overweight/obese."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Incongruence between college students' perceived disease risk and disease prevalence rates calls for improved public health education."
        }
      ]},
