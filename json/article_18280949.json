      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To evaluate the diagnostic value of intraoral palpation at the lateral pterygoid (LP) area as part of the physical examination to detect myofascial pain, according to modified research diagnostic criteria for temporomandibular disorders."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Forty-four women composed the myofascial pain group, and 33 symptom-free age-matched were the control group. One examiner calibrated and blinded to group distribution performed 2 intraoral bilateral palpations of the lateral pterygoid."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The LP area palpation showed sensitivity and specificity values of 79.55% and 77.27%, respectively, and positive and negative likelihood ratios of 3.50 and 0.26, respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Palpation at the LP area did not reach acceptable values of specificity, and care must be taken when judging positive response to this procedure."
        }
      ]},
