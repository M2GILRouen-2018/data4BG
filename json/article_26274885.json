        {
          "Label": "UNLABELLED",
          "content": "This study was conducted to determine patients' knowledge of pain agreements."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Descriptive quantitative survey design. A 28-item questionnaire regarding patients' knowledge of pain agreements was distributed to pain management office patients."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Participants (N = 76) scored 30%-100% (mean 80%) on knowledge of 10 pain agreement items."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Patients demonstrated moderate knowledge of terms."
        }
