      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 International Institute of Anticancer Research (Dr. John G. Delinassios), All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND/AIM",
            "content": "The novel static (sORP) and capacity (cORP) oxidation-reduction potential markers were examined for assessing oxidative stress in plasma of patients with sepsis. Moreover, the possible effect of obesity-induced oxidative stress on patients with sepsis was investigated."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "sORP and cORP markers, as well as the conventional oxidative stress biomarkers total antioxidant capacity (TAC), thiobarbituric acid-reactive substances (TBARS) and protein carbonyls (CARB), were assessed in plasma."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "sORP marker was increased significantly in the sepsis group, while cORP was significantly lower compared to the control group, indicating oxidative stress. Furthermore, in patients with sepsis, TAC was significantly lower compared to control group. However, obesity had no effect on sORP, cORP and TAC in patients with sepsis, although it increased levels of CARB and TBARS."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The present results suggest, for the first time, that ORP markers could be used for assessing oxidative stress in patients with sepsis."
          }
        ]
      },
