      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to evaluate the effect of jaw thrust on transesophageal echocardiography probe insertion and concomitant oropharyngeal injury."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A prospective, randomized study"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Medical center governed by a university hospital"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Forty-two adult patients undergoing cardiovascular surgery were included."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "After the induction of anesthesia, a transesophageal echocardiography probe was inserted using an anterior jaw lift technique (conventional group, n = 21) or a jaw thrust-assisted technique (jaw thrust group, n = 21)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "The incidence of oropharyngeal injury, number of insertion attempts, blood on the probe tip, and presence of persistent oropharyngeal bleeding were evaluated. In the conventional group, oropharyngeal injury occurred more frequently than in the jaw-thrust group (52.4% v 9.5%, respectively; p = 0.006). Regarding transesophageal echocardiography probe insertion, the conventional group required more attempts than the jaw-thrust group (p = 0.043). The incidence of blood on the probe tip was higher in the conventional group than in the jaw-thrust group (p = 0.020), but the presence of persistent oropharyngeal bleeding was similar between the 2 groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The jaw-thrust maneuver facilitated the insertion of the transesophageal echocardiography probe and reduced concomitant oropharyngeal injury."
          }
        ]
      },
