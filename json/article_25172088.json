      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2014.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "In this study, we investigated the reliability of the Nociception Coma Scale which has recently been developed to assess nociception in non-communicative, severely brain-injured patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective cross-sequential study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Semi-intensive care unit and long-term brain injury care."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "Forty-four patients diagnosed as being in a vegetative state (n=26) or in a minimally conscious state (n=18)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients were assessed by two experts (rater A and rater B) on two consecutive weeks to measure inter-rater agreement and test-retest reliability."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN MEASURES",
            "content": "Total scores and subscores of the Nociception Coma Scale."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We performed a total of 176 assessments. The inter-rater agreement was moderate for the total scores (k = 0.57) and fair to substantial for the subscores (0.33 ≤ k ≤ 0.62) on week 2. The test-retest reliability was substantial for the total scores (k = 0.66) and moderate to almost perfect for the subscores (0.53 ≤ k ≤ 0.96) for rater A. The inter-rater agreement was weaker on week 1, whereas the test-retest reliability was lower for the least experienced rater (rater B)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This study provides further evidence of the psychometric qualities of the Nociception Coma Scale. Future studies should assess the impact of practical experience and background on administration and scoring of the scale."
          }
        ]
      },
