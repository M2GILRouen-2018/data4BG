      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A 52-year-old man presented to hospital having experienced abdominal pain, abdominal distention and oliguria for 1 week. An abdominal CT scan revealed thrombosis in the superior mesenteric vein and in the right branch and the trunk of the portal vein."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INVESTIGATIONS",
          "content": "Physical examination, blood and urine analyses, color Doppler ultrasonography and abdominal CT scan."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DIAGNOSIS",
          "content": "Nephrotic syndrome complicated by portal vein thrombosis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MANAGEMENT",
          "content": "Treatment with batroxobin, low-molecular-weight heparin, prostaglandin E, dipyridamole and methylprednisolone."
        }
      ]},
