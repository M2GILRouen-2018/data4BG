      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To (1) investigate the immediate effects of myofascial induction (MI), with placebo electrotherapy as a control, on perceived pain, cervical/shoulder range of motion (ROM), and mood state in breast cancer survivors (BCSs) with shoulder/arm morbidity; and (2) examine the relationships between pain modifications and cervical/shoulder ROM on the side affected by breast cancer."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized, single-blind, placebo-controlled crossover study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Physical therapy laboratory."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "BCSs (N=21) who had a diagnosis of stage I-IIIA breast cancer and had completed adjuvant therapy (except hormonal treatment)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "During each session, the BCSs received either an MI (fascial unwinding) intervention focused on the upper limb area following the Pilat approach or placebo pulsed shortwave therapy (control group). Each session lasted 30 minutes, and an adequate washout period of 4 weeks between sessions was established."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "The visual analog scale (VAS) for pain and anxiety, shoulder-cervical goniometry for ROM, the Profile of Mood States for psychological distress, and the Attitudes Towards Massage Scale were used."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "An analysis of covariance (ANCOVA) revealed significant time × group interactions for VAS affected arm (P=.031) but not for VAS cervical (P=.332), VAS nonaffected arm (P=.698), or VAS anxiety (P=.266). The ANCOVA also revealed significant interactions for affected shoulder flexion (P<.001), abduction (P<.001), external rotation (P=.004), and internal rotation (P=.001). Significant interactions for affected cervical rotation (P=.022) and affected cervical lateral flexion (P=.038) were also found. A significant negative correlation was found between changes in VAS affected arm and shoulder/arm internal rotation ROM (r=-.46; P=.03)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A single MI session decreases pain intensity and improves neck-shoulder ROM to a greater degree than placebo electrotherapy for BCSs experiencing pain."
          }
        ]
      },
