      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To determine whether an automated intermittent bolus technique provides enhanced analgesia compared with a continuous infusion for femoral nerve block."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, single-blinded, randomized controlled trial (ClinicalTrials.gov Identifier: NCT01226927)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Perioperative areas and orthopedic surgical ward of a university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "45 ASA physical status 1, 2, and 3 patients undergoing unilateral primary total knee arthroplasty."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "All patients received single-injection sciatic and femoral nerve blocks plus femoral nerve catheter placement for postoperative analgesia. Patients were randomly assigned to an automated intermittent bolus (5 mL every 30 min with 0.1 mL/hr basal rate) or a continuous infusion (10.1 mL/hr) delivery method of 0.2% ropivacaine."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Consumption of intravenous patient-controlled analgesia (IV-PCA) and visual analog scale (VAS) pain scores were assessed postoperatively at set intervals until the morning of postoperative day (POD) 2."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "The mean (SEM) cumulative IV-PCA dose (mg of hydromorphone) for the 36-hour postoperative interval measured was 12.9 ± 2.32 in the continuous infusion rate group (n = 20) and 7.8 ± 1.02 in the intermittent bolus group [n = 21, t(39) = 2.04, P = 0.048; a 39 ± 14% difference in total usage]. Pain scores were statistically significantly lower in the intermittent bolus group in the afternoon of POD 1 (t(39) = 2.47, P = 0.018), but were otherwise similar."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "An automated intermittent bolus infusion technique for femoral nerve catheters is associated with clinically and statistically significantly less IV-PCA use (ie, an opioid-sparing effect) than a continuous infusion technique."
          }
        ]
      },
