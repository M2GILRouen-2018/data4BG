      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine the joint association of junk food consumption (JFC) and screen time (ST) with adiposity in children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Two hundred fourteen (121 girls, 93 boys) third-to-fifth-grade students (54% Hispanic, 35% African American, 8% white) completed a lifestyle behavior survey, which included self-reported JFC and ST, as part of a school-based lifestyle intervention program."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Neither JFC nor ST, independently or jointly, was associated with adiposity measures. JFC and ST were significantly correlated (r = .375)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The low achievement of physical activity and screen time recommendations and high prevalence of overweight/obesity in this mostly minority, low socioeconomic status population indicates a potential focus for intervention."
        }
      ]},
