      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the clinical and haemodynamic safety of NC100100, a new transpulmonary ultrasound contrast agent intended for vascular use."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Pulmonary artery pressures and gas exchange, left ventricular and systemic blood pressure and ECG were measured at baseline, after saline injection, and after each of two increasing doses of NC100100 injected intravenously."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "30 patients who were evaluated for suspected coronary artery disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No change was detected in any of the haemodynamic variables, or in haematological or clinical chemical parameters. Blood gases were unchanged, as were heart rhythm and arterial oxygen saturation. No serious adverse reactions were reported."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "NC100100 appeared to be haemodynamically inert and safe in patients with coronary artery disease."
        }
      ]},
