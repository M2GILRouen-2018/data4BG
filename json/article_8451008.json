      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Spontaneous/primary intracranial hypotension is characterised by orthostatic headache and is associated with characteristic magnetic resonance imaging findings."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "We present a case report of a patient with typical symptoms and classical radiological images."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Spontaneous intracranial hypotension is an under-recognised cause of headache and can be diagnosed by history of typical orthostatic headache and findings on MRI brain."
        }
      ]},
