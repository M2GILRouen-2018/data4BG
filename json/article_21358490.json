      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A report of two cases using custom-manufactured pedicle screws for revision spinal arthrodesis for pseudarthrosis in the setting of widely dilated pedicle screw tracts."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To present surgical outcomes of a previously unreported treatment for pseudarthrosis with widely dilated pedicle screw tracts."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Techniques for revision of lumbar pseudarthrosis with severe screw loosening and widely dilated pedicle screw tracts represent a challenging clinical scenario. If stable fixation cannot be achieved, fixation may fail or adjacent normal levels may need to be included in the construct."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Two patients presenting with painful pseudarthrosis after lumbar spinal fusion and instrumentation loosening with widely dilated pedicle screw tracts were treated with revision anterior and posterior spinal fusion using custom-manufactured large-diameter pedicle screws."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In both cases, the custom-manufactured pedicle screws achieved excellent purchase in the dilated pedicle screw tract. Both patients went on to solid fusion at 1 year after surgery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This is a previously unreported technique for revision spinal fusion in the setting of loose instrumentation with widely dilated pedicle screw tracts."
        }
      ]},
