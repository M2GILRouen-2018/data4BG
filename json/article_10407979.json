      "Language": "ger",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To evaluate the value of ultrasonography in the diagnosis of swelling and lesions of the sternoclavicular joint (SCG)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "We analysed the sonograms of 20 SCG of 18 patients with pain and swelling of the SCG. Ultrasonography was performed just after the clinical examination, using a 7.5 MHz linear scanner."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All examinations of the SCG produced distinct and clear sonographical findings. We showed that luxations of the SCG as well as tumors and local inflammation can be identified."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ultrasonographic examination is a noninvasive, time sparing and economical diagnostic tool for clarifying the differential diagnosis of lesions of the SCG and establish may a therapy regimen."
        }
      ]},
