      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The aim of this study is to evaluate complications of gastrectomy for gastric cancer in patients aged over 85 years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "Thirteen patients received curative gastrectomy between April 2007 and March 2008. The surgical complications were evaluated using the Clavien-Dindo classification."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were 11 patients aged 85-89 years and 2 who were over 90 years old. The median body mass index was 18. Nine patients underwent distal gastrectomy and 4 underwent total gastrectomy. The median operation time was 142 minutes and the median blood loss was 148 mL. Complications greater than Grade 2 were observed in 5 patients(38.5%). All complications were Grade 2. No surgical mortality was observed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "The morbidity rate in elderly patients over 85 years of age may be higher than in patients aged 75 and lower. Our results suggest that gastrectomy for patients aged over 85 years is acceptable."
        }
      ]},
