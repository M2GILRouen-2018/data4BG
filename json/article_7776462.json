      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "We determined the incidence of pain with injection of a new formulation of prostaglandin E1."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "A total of 63 subjects with erectile dysfunction underwent treatment with the new formulation of prostaglandin E1. Evidence of pain associated with injection was obtained by questionnaire and through questioning."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 451 injections was given to 63 subjects in the office, with 16 episodes (3.5%) of pain in 10 (15.9%). Then, 680 injections were performed by 38 subjects at home, with 15 episodes (2.2%) of pain in 8 (21%). Pain was not dose related."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The new formulation of prostaglandin E1 is less likely to be associated with pain compared with alcohol based formulations."
        }
      ]},
