      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To investigate the use of controlled-release morphine sulfate (MS Contin, Pharmacia) in Queensland, 1990-1993."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND DESIGN",
          "content": "Records of 434 patients notified to the Drugs of Dependence Unit (DDU) for prolonged use of MS Contin (as at 16 August 1993) were analysed, the information was verified, and the patients' diagnoses were coded (ICD-9). Estimates of daily drug consumption were calculated from computerised prescription data."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Controlled-release morphine sulfate was being used for indications other than its licensed indication \"chronic severe pain of cancer\": 39.9% of the patients received the drug for non-malignant conditions. The dose escalation for patients with non-malignant conditions was significantly less than that of the patients with malignant conditions (P = 0.002)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Despite controversy about the use of controlled-release morphine sulfate for chronic pain of non-malignant origin, its use is widespread."
        }
      ]},
