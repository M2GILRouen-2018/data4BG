      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether vertebroplasty is more effective than placebo for patients with pain of recent onset (≤ 6 weeks) or severe pain (score ≥ 8 on 0-10 numerical rating scale)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Meta-analysis of combined individual patient level data."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Two multicentred randomised controlled trials of vertebroplasty; one based in Australia, the other in the United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "209 participants (Australian trial n = 78, US trial n = 131) with at least one radiographically confirmed vertebral compression fracture. 57 (27%) participants had pain of recent onset (vertebroplasty n = 25, placebo n = 32) and 99 (47%) had severe pain at baseline (vertebroplasty n = 50, placebo n = 49)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Percutaneous vertebroplasty versus a placebo procedure."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Scores for pain (0-10 scale) and function (modified, 23 item Roland-Morris disability questionnaire) at one month."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "For participants with pain of recent onset, between group differences in mean change scores at one month for pain and disability were 0.1 (95% confidence interval -1.4 to 1.6) and 0.2 (-3.0 to 3.4), respectively. For participants with severe pain at baseline, between group differences for pain and disability scores at one month were 0.3 (-0.8 to 1.5) and 1.4 (-1.2 to 3.9), respectively. At one month those in the vertebroplasty group were more likely to be using opioids."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Individual patient data meta-analysis from two blinded trials of vertebroplasty, powered for subgroup analyses, failed to show an advantage of vertebroplasty over placebo for participants with recent onset fracture or severe pain. These results do not support the hypothesis that selected subgroups would benefit from vertebroplasty."
        }
      ]},
