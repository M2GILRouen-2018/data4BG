      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case of intraradicular, intervertebral disc herniation is reported."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "A rupture of en L5-S1 intervertebral disc into the left S1 nerve root is described."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "A review of the literature revealed five reported cases with some possible causes of this extremely rare phenomenon."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The diagnosis was made at the time of surgery during exploration of the L5-S1 disc space. The S1 nerve root was found to be adherent to the underlying disc space. Before surgery, this condition was believed to represent a large extradural and extraradicular disc herniation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The patient's pain was alleviated almost immediately after surgery, but the patient was left with some residual sensory loss in the leg."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "An unusual case of intraradicular, intervertebral disc herniation is presented."
        }
      ]},
