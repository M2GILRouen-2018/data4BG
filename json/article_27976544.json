      "Abstract": {
        "CopyrightInformation": "© 2016 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To study the contemporary, real-world clinical and economic burden associated with angina after percutaneous coronary intervention (PCI)."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Angina adversely affects quality of life and medical costs, yet data on real-world prevalence of angina following PCI and its associated economic consequences are limited."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In a multi-payer administrative claims database, we identified adults with incident inpatient PCI admissions between 2008 and 2011 who had at least 12 months of continuous medical and pharmacy benefits before and after the procedure. Patients were followed for up to 36 months. Using claims, we ascertained post-PCI outcomes: angina or chest pain, acute myocardial infarction, acute coronary syndrome, repeat PCI, healthcare service utilization, and costs."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Among 51,710 study patients (mean age 61.8, 72% male), post-PCI angina or chest pain was present in 28% by 12 months and 40% by 36 months. Compared with patients who did not experience chest pain, angina or ACS, total healthcare costs in the first year after the index PCI were 1.8 times greater for patients with angina or chest pain ($32,437 vs. $17,913, P\u2009<\u20090.001). These cost differentials continued to 36 months."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Angina after PCI is a frequent and expensive outcome. Further research is needed to identify risk factors and potentially improve outcomes for post-PCI angina. © 2016 Wiley Periodicals, Inc."
          }
        ]
      },
