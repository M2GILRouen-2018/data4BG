      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "This study is a case report."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of a patient with paraplegia and low back pain, who was diagnosed with acute infrarenal aortic thrombosis."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "There have been few reports in the literature regarding acute aortic thrombosis presenting with paraplegia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A 56-year-old man was referred to our emergency department with flaccid paraplegia and low back pain. Clinical examination and imaging revealed acute infrarenal aortic thrombosis, with lower limb ischemia. The patient underwent transcutaneous embolectomy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Despite successful revascularization, the patient finally died because of development of revascularization syndrome."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Acute aortic occlusion is a catastrophic event and may present with paraplegia, because of acute spinal cord ischemia. This can mislead the clinician to a wrong diagnosis and delay initiation of definite treatment."
        }
      ]},
