      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Sever's disease is a condition which has been described inconsistently in the literature with respect to pathology, aetiology and management. In particular, the impact of this condition has been overlooked, probably because it is usually self-limiting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "This study used a prospective comparative design study to determine the impact of Sever's disease on the quality of life of its sufferers."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Three scales--Happiness, Satisfaction with symptoms and Pain/comfort scale--from the POSNA musculoskeletal questionnaire showed significant differences between the symptomatic and control groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Although the condition may resolve with time, these results show that it has a considerable impact on children's lives."
        }
      ]},
