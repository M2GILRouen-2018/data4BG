      "Abstract": {
        "CopyrightInformation": "Georg Thieme Verlag KG Stuttgart · New York.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "This study evaluates the impact of gender in dialysis-dependent patients undergoing cardiac surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We retrospectively identified 204 dialysis-dependent patients (68.6% male, aged 66.6\u2009±\u20099.9 years) with end-stage renal disease undergoing cardiac surgery and compared them to a propensity-score-pair-matched control collective."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A 30-day mortality was 13.2% (14/106) for coronary artery bypass grafting (CABG), 19.3% (6/31) for aortic valve replacement (AVR), and 23.8% (16/67) for combined procedures. Postoperative chest tube output was significantly higher in men (1,007\u2009±\u2009946 mL) versus women (687\u2009±\u2009598 mL, p\u2009=\u20090.014). Compared with a propensity-score-pair-matched control collective of 204 patients, we identified significant differences in terms of 30-day mortality: overall mortality revealed 17.6 versus 4.6% (p\u2009=\u20090.0001), 13.2 versus 3.4% (p\u2009=\u20090.014) for CABG, 19.3 versus 0% (p\u2009=\u20090.051) for AVR, and 23.8 versus 9.1% (p\u2009=\u20090.02) for combined procedures."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Multivariate analysis identified preoperative myocardial infarction, prolonged extracorporeal circulation time, operation time, and surgical reexploration as independent predictors of 30-day mortality. There was a higher occurrence of bleeding complications in men that remained significant even after correction for body surface area."
          }
        ]
      },
