      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the efficacy of multidisciplinary treatment in altering chronic pain patient locus of control beliefs."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A before-and-after treatment design including demographics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Seventy-three chronic nonmalignant pain patients who completed study questionnaires both before and after treatment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Comprehensive, outpatient, multidisciplinary pain management program at a large Midwestern university medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Pain Locus of Control Scale and Survey of Pain Attitudes Control subscale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients' perceptions of personal control over pain increased from pretreatment to posttreatment, and patients' perceptions of external control over pain, such as fate or powerful others. decreased from pretreatment to posttreatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This study supports the efficacy of chronic pain management centers in altering patient beliefs about pain. The ability to increase patients' self-efficacy in their control over pain and to decrease external attributions are essential to successful pain management."
        }
      ]},
