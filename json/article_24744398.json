      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2014.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To describe the prevalence of chronic pain and the risk of opioid misuse in a palliative care clinic."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We reviewed patient records for 6 months for source of pain, treatment status, opioid misuse risk (Cut down, Annoyed, Guilty, and Eye-opener [CAGE] and Screener and Opioid Assessment for Patients with Pain version 1.0-Short Form [SOAPP-SF] scores), and urine drug screens."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 323 patients, 91% had cancer, 56% undergoing cancer treatment, while 28% had no evidence of disease. Eighty-six (27%) patients had noncancer pain. In all, 46% of new patients had positive scores on the SOAPP-SF and 15% had a positive CAGE. Of the less than 5% of visits that included a urine drug screen, 56% had aberrant results."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Chronic pain and indicators of opioid misuse risk were prevalent. Outpatient palliative care practices should develop policies to address these issues."
          }
        ]
      },
