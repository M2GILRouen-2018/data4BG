      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Editorial Council for the Journal of Prosthetic Dentistry. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "STATEMENT OF PROBLEM",
            "content": "The continuous positive airway pressure (CPAP) device yields optimum results in treating mild to moderate obstructive sleep apnea (OSA). However it may be bulky, noisy, and difficult to sleep with for the patient. Mandibular advancement devices (MAD) have shown better compliance but at the expense of lesser efficiency."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose of this study was to evaluate the patient's posttreatment subjective perception of the effectiveness of 2 common treatments of OSA."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "Thirty-two patients diagnosed with OSA filled out the Epworth Sleepiness Scale and Berlin Sleep Quality Questionnaire before treatment and again at 4 to 6 weeks after treatment. Two groups were formed (n=16 each); one group was treated with MAD and the other with CPAP. The data obtained were recorded and compared with the Mann Whitney U test (between groups) and the Wilcoxon signed rank test (within groups) (α=.05)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The analysis showed that the participants perceived significant posttreatment improvement (P<.05) for all variables of the Berlin Sleep Quality Questionnaire and the Epworth Sleepiness Scale for both the MAD and CPAP groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "According to the questionnaires, participants perceived significant improvement in OSA symptoms after treatment in both the MAD and CPAP groups. The study was inconclusive as to whether improvement of perceived symptoms was higher with MAD or CPAP."
          }
        ]
      },
