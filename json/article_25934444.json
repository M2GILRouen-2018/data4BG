      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 The Authors. Production and hosting by Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Lung cancer is the most common cause of cancer related death worldwide. Mostly these tumors present with cough, chest pain weight loss. However, presentation as breast mass and cardiac tamponade is very rare."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We are presenting a rare case of breast metastasis from primary lung cancer. This case presented as cardiac tamponade adding to the diagnostic dilemma."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The importance of this case is to highlight molecular profiling as an applicable tool to distinguish extra-mammary metastasis that masquerade as mammary neoplasm thereby preventing unnecessary need of surgery and radiation therapy."
          }
        ]
      },
