      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the safety of budesonide inhalation suspension (BIS) with placebo in infants 6 to 12 months of age with mild to moderate persistent asthma or recurrent wheeze."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "In this multicenter, randomized, double-blinded, parallel-group, placebo-controlled study, 141 patients received 0.5 mg BIS (n = 48), 1.0 mg BIS (n = 44), or placebo (n = 49) once daily for 12 weeks. The primary variable was adrenal function, based on cosyntropin-stimulated plasma cortisol levels. Spontaneous adverse events and clinical laboratory findings also were monitored."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Overall, the types and frequencies of adverse events reported during the study were comparable across treatment groups. The response to cosyntropin stimulation was similar across treatment groups, with no significant difference between BIS treatment and placebo."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The safety profile of BIS was similar to that of placebo, with no suppressive effect on adrenal function in patients 6 to 12 months of age with mild to moderate persistent asthma or recurrent wheeze."
        }
      ]},
