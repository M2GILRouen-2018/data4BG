      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVES",
          "content": "To evaluate the effectiveness of ketamine in the prevention of postoperative pain after tonsillectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, prospective, double-blind study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "90 ASA physical status I and II patients, aged 5 to 15 years, scheduled for tonsillectomy or adenotonsillectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients were divided into three groups. The pain preventive group received intravenous (IV) ketamine 0.5 mg/kg in 2 mL saline before the tonsils were surgically removed, followed by a continuous IV infusion of ketamine at 6 micro/(kg/min). In the ketamine group, 2 mL saline was given before the tonsils were surgically removed; saline infusion (10 mL/h) was continued until bleeding control, and 0.8 mg/kg ketamine was given during bleeding control in 2 mL saline. In the control group, only saline was given."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Cardiorespiratory system data, recovery from anesthesia and discharge parameters, tramadol requirement, and complications were recorded. Recovery from anesthesia and discharge parameters were similar among the groups. Total dose of tramadol was lower in the pain preventive group than in the other groups. In the pain preventive group, verbal pain scale scores were lower in the early postoperative period in the fourth and sixth hours (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Ketamine decreases postoperative analgesic requirements and has analgesic effects when used before surgery in tonsillectomy/adenotonsillectomy."
        }
      ]},
