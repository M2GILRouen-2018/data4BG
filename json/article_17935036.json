      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To present a case of a fracture of the unilateral pars interarticularis of the C2."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "There is confusion in the use of anatomic terminology of the pars interarticularis and pedicle of the C2 in literature. A fracture of the unilateral pars interarticularis of the C2 was diagnosed and treated nonsurgically by a Philadelphia collar."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "The patient was free of pain and obtained a full range of motion."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The presumed mechanism of injury in the fracture described here was hyperextension and axial loading."
        }
      ]},
