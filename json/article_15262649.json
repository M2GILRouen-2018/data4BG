      "Abstract": {
        "CopyrightInformation": "Copyright 2004 American Orthopaedic Society for Sports Medicine",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Treatment of patients with degenerative knees and varus malalignment presents a difficult clinical problem."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "HYPOTHESIS",
            "content": "Combining a medial opening wedge high tibial osteotomy with the microfracture chondral resurfacing procedure is a viable treatment option."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Retrospective review of prospectively collected data."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A group of 38 consecutive patients (mean age, 51.3 years; range, 34 to 72 years; 29 men and 10 women) with varus malalignment and chondral lesions who were treated with chondral resurfacing (an abrasion and microfracture technique) combined with a medial opening wedge high tibial osteotomy. All patients had >5 degrees of varus malalignment. Patients were evaluated preoperatively with the Lysholm and Western Ontario & McMasters Universities Osteoarthritis Index scoring systems and at a minimum of 2 years follow-up."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Thirty-three of 38 patients (87%) were available for 2-year follow-up (average, 45 months; range, 24 to 80 months). Lysholm scores improved from a preoperative score of 43.5 to 78.0 at follow-up; Western Ontario & McMasters Universities Osteoarthritis Index scores improved from 45.8 to 16.2. The average Tegner score was 5.0."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Combining a medial opening wedge high tibial osteotomy with the microfracture chondral resurfacing procedure in the varus knee is an effective method of decreasing pain and increasing function at a minimum of 2 years follow-up."
          }
        ]
      },
