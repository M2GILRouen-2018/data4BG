      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To evaluate the effectiveness of a cognitive behavioral intervention in decreasing symptom severity in patients with advanced cancer undergoing chemotherapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomized clinical trial based on cognitive behavioral theory."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Six urban cancer centers in the midwestern United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "124 patients 21 years of age or older were recruited and randomized to receive conventional care or conventional care and an intervention. Participants were newly diagnosed with stage III, stage IV, or recurrent cancer (solid tumor or non-Hodgkin lymphoma), undergoing chemotherapy, cognitively intact, and able to read and speak English."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Data were gathered via telephone interviews at baseline and 10 and 20 weeks after randomization. Nurses with experience in oncology delivered a five-contact, eight-week intervention aimed at teaching patients problem-solving techniques to affect symptom severity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Gender, site of cancer, age, symptom severity and depressive symptoms at baseline, group (i.e., experimental versus control), and total symptom severity."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Patients in the experimental group and those with lower symptom severity at baseline had significantly lower symptom severity at 10 and 20 weeks; the experimental difference at 20 weeks occurred primarily in those 60 years of age and younger. Depressive symptoms at baseline predicted symptom severity at 20 weeks; however, age, gender, and site of cancer did not affect symptom severity at either time point."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A cognitive behavioral intervention to teach problem-solving skills can be effective for patient symptom self-management during and following an intervention."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "Problem-solving strategies should be included in educational programs for patients with advanced cancer, particularly those 60 years of age and younger."
        }
      ]},
