    "OtherAbstract": {
      "Type": "Publisher",
      "Language": "por",
      "AbstractText": [
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "OBJETIVO",
          "content": "Comparar os resultados clínicos e radiológicos da via de acesso convencional com artrotomia medial e da via de acesso lateral na prótese total primária em joelho valgo."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "MÉTODOS",
          "content": "Neste ensaio clínico prospectivo, 21 pacientes com osteoartrite e deformidade em valgo foram divididos aleatoriamente em dois grupos de acordo com a via de acesso cirúrgico usada: medial ou lateral. O desfecho principal foi a medida radiográfica da inclinação lateral da patela. Outros desfechos foram a dor após a cirurgia (escala visual de dor), o sangramento (níveis séricos de hemoglobina) e o aspecto clínico da ferida operatória."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "RESULTADOS",
          "content": "Não houve diferença entre os grupos em relação a outras variáveis clínicas. A inclinação lateral média da patela no grupo lateral foi 3,1 graus ± 5,3 DP e no grupo medial foi 18 graus ± 10,2 DP (p = 0,02). Os outros desfechos não apresentaram diferenças entre os grupos."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "CONCLUSÃO",
          "content": "A via lateral proveu melhor inclinação lateral da patela pós-operatória nas artroplastias do joelho valgo."
        }
      ]
    }
