      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "Osteoarthritis is the most degenerative joint disease. The aim was to investigate the effects of ultrasound using mineral water or aqua sonic gel on severity of knee pain, measured by the visual analog scale and the Western Ontario and McMaster Universities Arthritis Index (WOMAC)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Thirty women with bilateral osteoarthritis of the knee were assigned to two groups: ultrasound with mineral water (group 1, n = 15) or with aqua sonic gel (group 2, n = 15). Both groups underwent 4 weeks intervention, three per week. The participants were assessed using the visual analog scale and the WOMAC. Tests were performed before and after interventions."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Both groups had significantly reduced pain and improved WOMAC compared with preintervention values."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "The ultrasound with mineral water group had more pronounced improvement at p-value < 0.001."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ultrasound with mineral water is preferable in treatment of knee OA."
        }
      ]},
