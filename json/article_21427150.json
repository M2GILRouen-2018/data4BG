      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the efficacy of intermittent cervical traction in the treatment of chronic neck pain over a 12-week follow-up."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Hospital-based outpatient practice."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Seventy-nine patients with chronic neck pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Subjects were randomly assigned to either experimental group (n\u2009=\u200939, mean age\u2009=\u200950.5\u2009±\u20099.8) or control group (n\u2009=\u200940, mean age\u2009=\u200948.8\u2009±\u20099.1). Experimental group received intermittent cervical traction and control group received infrared irradiation alone; twice a week over a period of six weeks."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASUREMENTS",
          "content": "The values of Chinese version of the Northwick Park Neck Pain Questionnaire (NPQ), verbal numerical pain scale (VNPS), and cervical active range of motion (AROM) were measured at baseline, six-week and 12-week follow-up."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No significant differences were found between the two groups in the NPQ (P\u2009>\u20090.05), VNPS (P\u2009>\u20090.05) and AROM (P\u2009>\u20090.05)."
        }
      ]},
