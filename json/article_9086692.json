      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To systematically examine the relationship between sleep duration and subsequent weight gain in observational longitudinal human studies."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Systematic review of twenty longitudinal studies published from 2004-October 31, 2010."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "While adult studies (n = 13) reported inconsistent results on the relationship between sleep duration and subsequent weight gain, studies with children (n = 7) more consistently reported a positive relationship between short sleep duration and weight gain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "While shorter sleep duration consistently predicts subsequent weight gain in children, the relationship is not clear in adults. We discuss possible limitations of the current studies: 1) the diminishing association between short sleep duration on weight gain over time after transition to short sleep, 2) lack of inclusion of appropriate confounding, mediating, and moderating variables (i.e., sleep complaints and sedentary behavior), and 3) measurement issues."
          }
        ]
      },
