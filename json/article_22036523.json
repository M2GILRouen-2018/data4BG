      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim of the study was to determine if Lyprinol(®) is effective in reducing pain, indicators of inflammation and muscle damage, and in turn improving performance in well trained athletes suffering from delayed onset muscle soreness (DOMS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A double blind randomised placebo controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Twenty well trained male volunteers, matched by VO(2max) were randomly assigned to consume 200mg of Lyprinol(®) or an indistinguishable placebo daily for 8 weeks prior to a downhill treadmill running episode designed to induce DOMS."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Performance measures (Kin-Com, counter movement and squat jump), pain assessments (visual analogue scale, algometer) and blood analyses (Interleukin-1, Interleukin-6, Interleukin-10, tumour necrosis factor-α, C-reactive protein, myoglobin, creatine kinase) were assessed at 7 time points over 5 days (pre, post, 4, 24, 48, 72 and 96h after the downhill run)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No statistically significant differences were identified in any parameters between the active and placebo groups at any time point."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "After 2 months ingestion of Lyprinol(®) at the currently recommended dosage (200mg/day) and a demanding eccentric exercise intervention, Lyprinol(®) did not convincingly affect DOMS and indicators of muscle damage."
          }
        ]
      },
