      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "Osteochondral fractures in skeletally immature patients are rare. A retrospective case series is reported looking at the use of Omnitech compression screws for these injuries."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Nine patients with a mean age of 14 were included in the study with a mean follow up of 26 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The average KOOS, IKDC and Tegner Lysholm Scores were 86.7, 90.34 and 96.1 respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The use of Omnitech screws in the acute setting for skeletally immature patients shows excellent short-term outcomes."
        }
      ]},
