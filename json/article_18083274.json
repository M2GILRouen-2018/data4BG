      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2016.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To investigate the role of body mass index (BMI) and weight in the long-term efficacy of etanercept in patients with psoriasis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Medical records were retrospectively analysed. Extracted data included weight, BMI, comorbidities and psoriasis area severity index (PASI). Patients were stratified by weight (<80\u2009kg or ≥80\u2009kg) and BMI (healthy, BMI 22 - 24.99\u2009kg/m(2); overweight, BMI 25 - 29.99\u2009kg/m(2); obese, BMI ≥30\u2009kg/m(2))."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The study included 66 patients. Body weight had no effect on etanercept efficacy. There was a significant reduction in etanercept efficacy in obese patients (n\u2009=\u200912) compared with healthy weight (n\u2009=\u200933) or overweight (n\u2009=\u200921) patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Obesity has a negative effect on the efficacy of etanercept in psoriasis."
          }
        ]
      },
