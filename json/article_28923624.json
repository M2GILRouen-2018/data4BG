      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Between January 2013 and September 2015, 135 consecutive renal transplant patients were screened prospectively with ultrasound for renal cell carcinoma (RCC)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Eighteen ultrasound abnormalities were identified with 4 solid lesions detected. Fifty-six other patients were screened retrospectively by referring nephrology groups, with 6 additional malignancies found."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "As a result of our data, we recommend and have instituted annual ultrasound screening of native kidneys in all renal transplant patients."
          }
        ]
      },
