      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND PURPOSE",
          "content": "Improving functional performance in patients with chronic low back pain is of primary importance. The purpose of this study was to examine the effects of 2 proprioceptive neuromuscular facilitation (PNF) programs on trunk muscle endurance, flexibility, and functional performance in subjects with chronic low back pain (CLBP)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Eighty-six women (40.2+/-11.9 [mean+/-SD] years of age) who had complaints of CLBP were randomly assigned to 3 groups: rhythmic stabilization training, combination of isotonic exercises, and control."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Subjects trained with each program for 4 weeks with the aim of improving trunk stability and strength. Static and dynamic trunk muscle endurance and lumbar mobility were measured before, at the end of, and 4 and 8 weeks after training. Disability and back pain intensity also were measured with the Oswestry Index."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Multivariate analysis of variance indicated that both training groups demonstrated significant improvements in lumbar mobility (8.6%-24.1%), static and dynamic muscle endurance (23.6%-81%), and Oswestry Index (29.3%-31.8%) measurements."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION AND CONCLUSION",
          "content": "Static and dynamic PNF programs may be appropriate for improving short-term trunk muscle endurance and trunk mobility in people with CLBP."
        }
      ]},
