      "Abstract": {
        "CopyrightInformation": "© 2017 John Wiley & Sons A/S. Published by John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PROBLEM",
            "content": "How does menstrual cup (MC) compare to other genital sampling methods for HIV RNA recovery?"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD OF STUDY",
            "content": "We compared HIV RNA levels between MC, endocervical swab (ECS), and ECS-enriched cervicovaginal lavage (eCVL) specimens in 51 HIV-positive, antiretroviral therapy-naive women at enrollment, 3 and 6 months, with order rotated by visit. Paired comparisons were analyzed with McNemar's exact tests, signed-rank tests, and an extension of Somer's D for pooled analyses across visits."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "MC specimens had the highest proportion of quantifiable HIV VL at enrollment and month 3, but more MC specimens (n=12.8%) were insufficient for testing, compared with ECS (2%, P=0.006) and eCVL (0%, P<0.001). Among sufficient specimens, median VL was significantly higher for MC (2.62 log10 copies/mL) compared to ECS (1.30 log10 copies/mL, P<0.001) and eCVL (1.60 log10 copies/mL, P<0.001) across visits."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "MC may be more sensitive than eCVL and CVS, provided insufficient specimens are reduced."
          }
        ]
      },
