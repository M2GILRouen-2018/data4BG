      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether the application of warmth after hernia surgery reduces pain and aids wound healing."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Forty-five patients were recruited and randomised to receive either no warming;two hours of warming immediately after surgery; or seven days of warming."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Postoperative pain scores were significantly lower after two hours of warming immediately after surgery compared with the non-warmed patients (p<0.05). Pain scores were lower on each of the first seven postoperative days in the warmed groups compared with the non-warmed subjects. Patients in the warmed groups also had lower ASEPSIS wound scores."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Warming may allow wounds to heal with fewer complications. In addition, warming for only two hours immediately after surgery may provide similar benefits to seven days of warming."
        }
      ]},
