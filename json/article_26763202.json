      "Abstract": {
        "CopyrightInformation": "© 2016 Special Care Dentistry Association and Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the prevalence and factors associated with mouth breathing among patients with developmental disabilities of a dental service."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We analyzed 408 dental records. Mouth breathing was reported by the patients' parents and from direct observation. Other variables were as -follows: history of asthma, bronchitis, palate shape, pacifier use, thumb -sucking, nail biting, use of medications, gastroesophageal reflux, bruxism, gender, age, and diagnosis of the patient. Statistical analysis included descriptive analysis with ratio calculation and multiple logistic regression. Variables with p < 0.25 were included in the model to estimate the adjusted OR (95% CI), calculated by the forward stepwise method. Variables with p \u200b\u200b< 0.05 were kept in the model."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Being male (p = 0.016) and use of centrally acting drugs (p = 0.001) were the variables that remained in the model."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Among patients with -developmental disabilities, boys and psychotropic drug users had a greater chance of being mouth breathers."
          }
        ]
      },
