      "Abstract": {
        "CopyrightInformation": "Copyright (c) 2007 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To reinforce the risk of heterotopic pregnancy in a natural cycle when intrauterine pregnancy and abdominal pain co-exist."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A single case report with a literature review."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Our case was associated with significant haemorrhage, laparotomy and salpingectomy. The obstetric outcome was favourable in this case. The literature review demonstrates the diagnostic difficulties as well as treatment options."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Sonographic diagnosis of a heterotopic pregnancy is not always possible. Patients with abdominal pain and intrauterine pregnancy should heighten the clinician's suspicion of a heterotopic pregnancy."
          }
        ]
      },
