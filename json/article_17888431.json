      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of endometrioid adenocarcinoma that arose in endometriosis mimicking colorectal cancer in a young woman with a Müllerian anomaly."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 31-year-old, white nulligravida woman with a history of two previous laparoscopies for infertility and chronic pelvic pain. A solid rectosigmoid mass adherent to the left pelvic sidewall was found in this patient."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "The patient was subjected to an exploratory laparotomy followed by adjuvant chemotherapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Surgical findings and histopathological observations are included in this report."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Intraoperative and histologic examinations revealed endometriosis-associated colorectal cancer."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Although a rare event, this condition should be considered in the diagnosis of women with a previous history of pelvic endometriosis, Müllerian malformation, abdominal pain, constipation, or rectal bleeding."
        }
      ]},
