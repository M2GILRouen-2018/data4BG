      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate brain activation in response to common food and nonfood logos in healthy weight and obese children."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Ten healthy weight children (mean body mass index in the 50th percentile) and 10 obese children (mean body mass index in the 97.9th percentile) completed self-report measures of self-control. They then underwent functional magnetic resonance imaging while viewing food and nonfood logos."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Compared with the healthy weight children, obese children showed significantly less brain activation to food logos in the bilateral middle/inferior prefrontal cortex, an area involved in cognitive control."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "When shown food logos, obese children showed significantly less brain activation than the healthy weight children in regions associated with cognitive control. This provides initial neuroimaging evidence that obese children may be more vulnerable to the effects of food advertising."
          }
        ]
      },
