      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND PURPOSE",
          "content": "Sinus venosus-type atrial septal defect can be associated with anomalous drainage of the upper right pulmonary vein into the superior vena cava. Surgical correction provides reconstruction of superior vena cava and rerouting of the pulmonary vein into the left atrium."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUMMARY OF CASE",
          "content": "We report the case of a young woman who experienced 2 strokes 11 years after surgical repair of sinus venosus-type atrial septal defect."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Interventional treatment resolved the superior vena cava stenosis, rerouted the pulmonary vein into the left atrium and abolished the right to left shunt."
        }
      ]},
