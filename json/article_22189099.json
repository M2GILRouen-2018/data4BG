      "Abstract": {
        "CopyrightInformation": "© 2011 International Society for Sexual Medicine.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The number of women with gestational diabetes mellitus (GDM) is growing worldwide in parallel with the obesity epidemic. The diagnosis of GDM leads to substantial modifications in the daily routine of these women, and these adjustments could potentially affect their sexual function. There are no previous studies on the sexual function of patients with GDM."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "The aim of this study was to investigate the sexual function of patients with GDM in comparison with healthy pregnant women at the same gestational age."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Brazilian women in the third trimester of pregnancy with and without GDM were invited to participate in this cross-sectional study while waiting for their antenatal care visits at a single public tertiary teaching institution between March and December 2010. The Brazilian version of the Female Sexual Function Index (FSFI) questionnaire was used to assess sexual function."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Desire, arousal, lubrication, orgasm, sexual satisfaction, and pain during and after coitus in the last 4 weeks, measured according to a standardized and validated questionnaire."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 87 participants were enrolled (43 healthy women and 44 with GDM). There were no significant differences in the sociodemographic characteristics of both groups. The total FSFI scores of GDM patients was 21.0±9.59 compared with 22.3±9.17 for healthy women (P=0.523). Difficulty in desire was the most common sexual dysfunction symptom in both groups, being reported by 42% and 50% of GDM and healthy women, respectively (P=0.585)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The sexual function of Brazilian patients with GDM does not differ significantly from that of healthy pregnant women at the same gestational age."
          }
        ]
      },
