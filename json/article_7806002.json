      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the nature of a condition called transient osteoporosis of the hip (TOH) in pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Fifty-three cases of this syndrome of unknown etiology have been reviewed and an additional case has been added."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RESULT AND CONCLUSION",
          "content": "TOH is characterized by hip joint pain during the 3rd trimester of pregnancy and signs of demineralization of the femoral head. The course is benign with recovery shortly after birth. No specific therapy is required except bed rest."
        }
      ]},
