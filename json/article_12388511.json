      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of this report is to describe the role of MR imaging in the diagnosis of focal pyomyositis surrounding the sciatic nerve in children."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In the absence of joint effusion on sonography, MR imaging should be considered in pediatric patients who present with a febrile illness and incapacitating pelvic pain."
        }
