      "Abstract": {
        "CopyrightInformation": "© 2013 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Despite high rates of women's use of intrapartum pain management techniques, little is known about the factors that influence such use."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Examine the determinants associated with women's use of labour pain management."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional survey of a substudy of women from the 'young' cohort of the Australian Longitudinal Study of Women's Health (ALSWH)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING AND PARTICIPANTS",
            "content": "Women aged 31-35 years who identified as being pregnant or recently given birth in the 2009 ALSWH survey (n = 2445) were recruited for the substudy. The substudy survey was completed by 1835 women (RR = 79.2%)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN VARIABLES STUDIED",
            "content": "Determinants examined included pregnancy health and maternity care [including complementary and alternative medicine (CAM)] for their most recent pregnancy and any previous pregnancies. Participants' attitudes and beliefs related to both CAM and maternity care were also included in the analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "The outcome measures examined were the use of both pharmacological and non-pharmacological pain management techniques (NPMT)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Differences were seen in the effects of demographics, health service utilization, health status, use of CAM, and attitudes and beliefs upon use of intrapartum pain management techniques across all categories. The only variable that was identified as a determinant for use of all types of pain management techniques was a previous caesarean section (CS)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION AND CONCLUSIONS",
            "content": "The effect of key determinants on women's use of pain management techniques differs significantly, and, other than CS, no one determinant is clearly influential in the use of all pain management options."
          }
        ]
      },
