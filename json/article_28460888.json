      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Atherosclerotic cardiovascular disease is the foremost cause of death for U.S. adults. The 2013 ACC/AHA Adult Cholesterol Guidelines recommend high-intensity dose statins for individuals with coronary artery disease (CAD)."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine healthcare provider compliance with the Cholesterol Guideline recommendation specific to high-intensity dose statins for patients with CAD."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A retrospective chart review was conducted to determine compliance rate. A questionnaire was developed to evaluate healthcare provider beliefs, attitudes, and self-confidence toward this recommendation."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of the 473 patients with CAD, 67% were prescribed a high-intensity dose statin. Patients with non-ST segment myocardial infarction and ST segment myocardial infarction were more likely to be prescribed a high-intensity dose statin versus a moderate or low-intensity dose. Healthcare providers strongly agreed with this guideline recommendation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "There exists a dichotomy between intention to prescribe and actual prescribing behaviors of high-intensity dose statin for patients with CAD."
          }
        ]
      },
