      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the clinical efficacy of extracorporeal shockwave lithotripsy (ESWL) for bilateral ureteral stones with renal colic in emergency."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We retrospectively analyzed the clinical data of 86 patients suffered with sudden renal colic due to bilateral ureteral stones and treated with ESWL between January 2005 and January 2009."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The success rate was 74.4% after a single ESWL session, and the overall success rate was 82.6%. Significant difference in stone length was observed between successful group and failed group (P<0.01). The stone position did not produce significant impact on the outcome of the treatment (P>0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "ESWL is an effective treatment modality in emergency for small-length and short-term obstruction bilateral ureteral stones with remal colic."
        }
      ]},
