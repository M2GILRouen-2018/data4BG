      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Previous studies of pain behavior in patients with chronic pain have shown that depressed patients exhibit more pain behavior than nondepressed patients. This study sought to extend these findings and to examine the possible causes of the observed differences."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Patients completed the short form of the Beck Depression Inventory, and their pain behavior was simultaneously rated by themselves and trained observers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Subjects were 37 inpatients in a chronic pain program."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Both depressed and nondepressed subjects rated themselves as exhibiting more pain behavior than did nurse ratings. While nurses rated pain behaviors as similar among the depressed and the nondepressed groups, patient ratings indicated significantly more pain behavior among depressed than nondepressed patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These results suggest that cognitive factors may influence self-ratings of pain behavior by depressed subjects."
        }
      ]},
