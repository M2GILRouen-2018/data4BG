      "Abstract": {
        "CopyrightInformation": "© Perry et al 2015.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To describe the findings in cerebrospinal fluid from patients with acute headache that could distinguish subarachnoid hemorrhage from the effects of a traumatic lumbar puncture."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A substudy of a prospective multicenter cohort study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "12 Canadian academic emergency departments, from November 2000 to December 2009."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Alert patients aged over 15 with an acute non-traumatic headache who underwent lumbar puncture to rule out subarachnoid hemorrhage."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE",
            "content": "Aneurysmal subarachnoid hemorrhage requiring intervention or resulting in death."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of the 1739 patients enrolled, 641 (36.9%) had abnormal results on cerebrospinal fluid analysis with >1 × 10(6)/L red blood cells in the final tube of cerebrospinal fluid and/or xanthochromia in one or more tubes. There were 15 (0.9%) patients with aneurysmal subarachnoid hemorrhage based on abnormal results of a lumbar puncture. The presence of fewer than 2000 × 10(6)/L red blood cells in addition to no xanthochromia excluded the diagnosis of aneurysmal subarachnoid hemorrhage, with a sensitivity of 100% (95% confidence interval 74.7% to 100%) and specificity of 91.2% (88.6% to 93.3%)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "No xanthochromia and red blood cell count <2000 × 10(6)/L reasonably excludes the diagnosis of aneurysmal subarachnoid hemorrhage. Most patients with acute headache who meet this cut off will need no further investigations and aneurysmal subarachnoid hemorrhage can be excluded as a cause of their headache."
          }
        ]
      },
