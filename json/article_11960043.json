      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To determine perioperative complication rates at primary and repeat endometrial ablations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective cohort study (Canadian Task Force classification II-2)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary care teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Seventy-five women who underwent a repeat ablation and 800 who had a primary ablation by the same surgeon (GAV) between 1990 and 2000 for a diagnosis of menorrhagia and/or dysmenorrhea."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Hysteroscopic ablation involving coagulation or resection of endometrium, and second ablation after failure of the first."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Serious perioperative complications were uterine perforation, hemorrhage, excess fluid absorption, and genital tract burns. They occurred in 9.3% of repeat ablations compared with 2.05% of primary ablations (p = 0.006)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Repeat endometrial ablation has a significantly higher rate of perioperative complications than primary ablation."
        }
      ]},
