      "Abstract": {
        "CopyrightInformation": "Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Chest pain is a common complaint in the Emergency Department that rarely can be attributed to anterior mediastinal masses."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "We review the differential diagnosis for anterior mediastinal masses and their potential consequences."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "An unusual case of chest pain in a young male patient is presented that is caused by an anterior mediastinal mass associated with pericarditis and right ventricular outflow obstruction."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Pericarditis and right ventricular outflow obstruction are potential complications of anterior mediastinal non-seminomatous germ cell tumors."
          }
        ]
      },
