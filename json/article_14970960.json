      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate whether amitriptyline is more effective than placebo in improving phantom limb pain or residual limb pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized controlled trial of amitriptyline for 6 weeks."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Thirty-nine persons with amputation-related pain lasting more than 6 months."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Six-week trial of amitriptyline (titrated up to 125 mg/d) or an active placebo (benztropine mesylate)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Analyses were conducted to examine whether there was a medication group effect on the primary outcomes (average pain intensity) and secondary outcome measures (disability, satisfaction with life, handicap)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No significant differences were found between the treatment groups in outcome variables when controlling for initial pain scores."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Our findings do not support the use of amitriptyline in the treatment of postamputation pain."
        }
      ]},
