      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the immediate postoperative pain and discomfort in patients who underwent operative laparoscopy under general anesthesia with or without peritoneal lidocaine and incisional bupivacaine instillations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Fifty-four participants were prospectively randomized to three groups: group I, intraperitoneal (IP) lidocaine + intraincisional bupivacaine; group II, intraincisional bupivacaine; and group III, no additional drugs after general anesthesia (controls)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University Hospital, Reproductive Endocrinology and Infertility Clinics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Private patients needing operative laparoscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "One hundred milligrams of lidocaine were instilled with the irrigation device into the peritoneal cavity at the completion of surgery. Twenty-five milligrams of bupivacaine were injected into infraumbilical and suprapubic incisions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The analgesic use and modified McGill Present Pain Intensity scores were used for pain evaluation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "McGill Present Pain Intensity scores for pain, and narcotic use in the recovery room were less in IP lidocaine-instilled group of patients (P less than 0.05). The mean maximum plasma lidocaine level achieved was 1.01 +/- 0.25 micrograms/mL."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Peritoneal lidocaine and incisional bupivacaine use in operative laparoscopy as described after general anesthesia is safe and effective in reducing postoperative pain in the recovery room."
        }
      ]},
