      "Abstract": {
        "CopyrightInformation": "© 2012 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The objective of this study was to report a case of new onset refractory pain from intrapleural migration of a spinal catheter five months after the implantation of an intrathecal drug delivery system (IDDS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "A 57-year-old man had intractable pain because of multiple intradural spinal explorations for tethered cord release. His pain was effectively treated with intrathecal morphine via an IDDS. Five months after the implantation, the patient developed return of the original pain more than two weeks after intrapleural migration of the intrathecal catheter."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The migration was documented by computed tomography, and repositioning of the catheter rendered the patient comfortable. The gradual onset of pain may have been due to decreasing delivery of drug to the cerebrospinal fluid as the catheter tip migrated further away from the dura. To our knowledge, this complication has not been reported in the literature."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Physicians and nursing staff that place and manage an IDDS should be aware of this complication."
          }
        ]
      },
