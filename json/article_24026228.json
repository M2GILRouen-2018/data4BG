      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Painful neuromas are a relatively common complication of hernia and abdominal wall surgery."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Surgical neurectomy has the potential to to provide durable relief for chronic pain; however, current surgical approaches are not without morbidity or anatomical challenges.We sought a surgical alternative."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In the treatment of a case of incapacitating inguinal pain, we performed an anterior transperitoneal approach using a surgical robot."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "This approach was facile and provided elegant anatomical visualization."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This case describes the first known robot-assisted laparoscopic triple neurectomy and details a simplified, transperitoneal approach."
        }
      ]},
