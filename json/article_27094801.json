      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To study the modulation of serum BDNF levels following integrated multimodal intervention in postherpetic neuralgia (PHN)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS & METHODS",
          "content": "A randomized, double-blind controlled study was undertaken among patients of thoracic PHN where 30 patients received pregabalin with pulsed radiofrequency and 30 controls received pregabalin with sham treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pain intensity (visual analog scale) was reduced earlier in intervention group (15.3 ± 5.7 at the fourth week) compared with control group (16.3 ± 6.6 at the eighth week). Serum BDNF level increased with time in both the groups with overall increase more pronounced in intervention group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Integrated multimodal therapy using minimally invasive pulsed radiofrequency and pregabalin in PHN was effective in early pain reduction with elevated serum BDNF levels."
        }
      ]},
