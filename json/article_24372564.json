      "Abstract": {
        "CopyrightInformation": "© 2013 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of this study was to describe differences in the cognitive processes of novice and expert public health nurses (PHNs) as they solved ill-structured problems commonly found in public health practice."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND SAMPLE",
            "content": "This descriptive/exploratory small group design used the think-aloud method, a qualitative technique of collecting verbal data about cognitive processes. Data were coded and analyzed using theoretical thematic analysis. The purposive sample consisted of 12 registered nurses: six novices and six experts."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASURES",
            "content": "Participants were asked to think-aloud as they solved two ill-structured public health problems (underage drinking and obesity)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Findings indicated that novice and expert PHNs solve ill-structured problems differently. Experts used cognitive strategies, such as conversion, to propel the problem-solving process forward, forming complex, detailed problem representations and solutions. Novices asked questions as a strategy in defining the problem and developed broad, superficial problem representations and solutions."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This study suggests the need for the development of strategies in the workplace and in academia that support PHNs in identifying and solving ill-structured problems as they transition from novice to expert."
          }
        ]
      },
