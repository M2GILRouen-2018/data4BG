      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the value about GINA escalation therapy of bronchial asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "64 asthma patients in investigation group were divided into several grades according to the severity degree and escalation therapy was carried out according to GINA. 62 asthma patients in control group were treated by routine method. The medical cost and clinical symptom of asthma were studied."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "The attack times, the days of cough and gasping, the times of hospitalization, FEV1 and PEF after treatment for 3 years were lower than those before treatment (P < 0.01). The above-mentioned markers in the investigation group were lower than those in the control group (P < 0.05). The medical cost in the investigation group was lower than that in the control group (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The effect of GINA project on preventing and curing asthma is better than that of routine method. The GINA project plays an important role in improving the quality of life and decreasing the medical cost."
        }
      ]},
