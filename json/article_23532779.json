      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Coronary angioplasty with stenting has revolutionized the treatment of coronary artery disease. This article describes the history of coronary angioplasty and stenting, reviews the contemporary stents and recommendations and highlights the on-going work and potential future directions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SOURCES OF DATA",
          "content": "This review examined the data on coronary stents available in PubMed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "AREAS OF AGREEMENT",
          "content": "Coronary artery stenting is the treatment of choice for patients requiring coronary angioplasty. Stents, and particularly drug-eluting stents, reduce the risk of restenosis, but may be associated with the hazard of late stent thrombosis. Dual anti-platelet treatment is recommended for patients receiving coronary stents."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "AREAS OF CONTROVERSY",
          "content": "The selection of stents for various lesions and patients and the duration of anti-platelet therapy remain debated areas."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "AREAS TIMELY FOR DEVELOPING RESEARCH",
          "content": "There are on-going preclinical and clinical studies to develop better stent platforms, more biocompatible polymers, novel anti-proliferative and anti-platelet drugs, pro-healing stents and bioresorbable scaffolds."
        }
      ]},
