      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Angina and depression are common in ischemic heart disease (IHD), but their association remains understudied."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This study was conducted in order to evaluate the association of 1 year change in depression with change in patient-reported outcomes of stable angina."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Five hundred sixty-nine stable angina patients completed the Seattle Angina Questionnaire and Patient Health Questionnaire (PHQ) at baseline and 1 year. Participants were divided into four groups: not depressed, new onset of depression at 1 year, remitted at 1 year, and persistently depressed. Associations between depression and angina symptoms were evaluated using regression models."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Compared to those not depressed, newly depressed participants reported more angina (β\u2009=\u2009-11.7, p\u2009<\u20090.001) and physical limitations (β\u2009=\u2009-11.8, p\u2009<\u20090.001) and lower treatment satisfaction (β\u2009=\u2009-15.03, p\u2009<\u20090.001) and quality of life (β\u2009=\u2009-15.4, p\u2009<\u20090.001). Persistently depressed participants reported physical limitations (β\u2009=\u2009-7.4, p\u2009<\u20090.05), lower treatment satisfaction (β\u2009=\u2009-10.1, p\u2009<\u20090.001), and poorer quality of life (β\u2009=\u2009-10.03, p\u2009<\u20090.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Changes in depression scores and angina outcomes were significantly associated."
        }
      ]},
