      "Abstract": {
        "CopyrightInformation": "© 2013 S. Karger GmbH, Freiburg.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND/AIMS",
            "content": "To examine whether body image mediates the association between overweight/obesity and chronic disease-related health practices (CDRHP), including lack of physical activity (PA), infrequent breakfast consumption (IBC), screen-based media use (SBM), and smoking."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The 2006 Health Behaviors in School-Age Children survey was administered to a nationally representative sample of US students (n = 8,028) in grades 6-10 (mean age = 14.3 years). Outcome variables included self-reported measures of PA, SBM, IBC, and smoking. Body image was assessed with 5 items from the Body Investment Scale (α = 0.87) asking for agreement/disagreement with statements about one's body. Stratifying on gender, an initial regression model estimated the association between overweight/obesity and CDRHP. Mediation models that included body image were then compared to the initial model to determine the role of body image in the relationship between overweight/obesity and CDRHP."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Among boys, body image mediated the relationships of overweight/obesity with SBM, and of obesity with IBC. Among girls, it mediated the relationships of obesity with PA, IBC, and smoking, and of overweight with SBM."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "As the prevalence of overweight/obesity among adolescent boys and girls remains high, efforts to improve their body image could result in less frequent engagement in CDRHP."
          }
        ]
      },
