      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2015.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Postoperative adhesions occur in the overwhelming majority of patients after laparotomy and laparoscopy. The clinical consequences of adhesions can be devastating. Adhesions are believed to contribute to infertility and are the most common cause of small bowel obstruction and abdominal pelvic pain. Our objective is to develop a model for ex vivo development of postoperative adhesions."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Peritoneal tissue strips were obtained from Sprague Dawley rats and were abraded by scraping the tissue surface with a scalpel. Tissues were incubated in a special medium, and visible adhesion bands were assessed. Experiments were performed in a university setting."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Adhesion bands were observed as early as 24 hours after abrasion. No adhesion bands were observed in the control tissue strips."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This is a model system for the creation of actual adhesive bands utilizing an ex vivo culture of peritoneal strips."
          }
        ]
      },
