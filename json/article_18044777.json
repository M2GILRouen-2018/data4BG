      "Abstract": {
        "CopyrightInformation": "Copyright 2007 Wiley-Liss, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this intravascular ultrasound (IVUS) study was to assess the efficacy of the AXXESS Plus stent system for the treatment of bifurcation coronary lesions."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The AXXESS Plus is a novel bifurcation drug-eluting stent, comprised of a self-expanding flare-shaped stent platform and bioabsorbable polymer coating that releases Biolimus A9."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Data were obtained from the AXXESS PLUS trial, a prospective, multicenter, nonrandomized, single-arm study to evaluate safety and efficacy. Six-month follow-up IVUS analysis was available in 49 cases. Volumetric analysis using Simpson's method within the AXXESS stent, and cross-sectional analysis at the ostium of main branch and/or side branch was performed. Impact of bifurcation angle on stent expansion at the carina was also evaluated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Within the AXXESS stent, neointimal volume obstruction percentage was 2.3% +/- 2.2%, with a minimum lumen area of 7.9 +/- 2.6 mm(2). Lumen area was 5.2 +/- 1.7 mm(2) at main branch ostium, and 4.0 +/- 1.5 mm(2) at side branch ostium. In two cases, incomplete stent apposition was observed at the proximal edge of the AXXESS stent. In one case, a gap between the AXXESS stent and an additional stent was observed. Greater bifurcation angle inversely correlated with smaller stent area at side branch ostium (r = -0.54, P = 0.03) but not at main branch ostium (r = -0.2, P = 0.29)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This novel self-expanding, drug-eluting bifurcation stent demonstrated effective lesion coverage along with significant neointimal suppression equivalent to current generation balloon-expandable drug-eluting stent technology."
          }
        ]
      },
