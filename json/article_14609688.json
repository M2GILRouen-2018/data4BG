      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND CONTEXT",
          "content": "Family physician compliance with acute lower back pain clinical practice guidelines remains uncertain."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To determine the degree of guideline compliance of family physicians managing patients with workers' compensation claims and acute mechanical lower back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Observational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT SAMPLE",
          "content": "One hundred thirty-nine family physicians in British Columbia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Compliance with guideline recommendations for history, examination procedures, diagnostic testing and treatments."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Physician workers' compensation board patient reports for acute lower back pain without leg symptoms and not greater than 2 to 3 weeks duration were scored for guideline adherence up until 12 weeks after onset."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Physicians demonstrated a high degree of compliance with the guideline-recommended history, examination procedures and medications, but low compliance with recommended imaging and many treatment recommendations."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Recently published clinical practice guidelines regarding the management of patients with acute mechanical lower back pain have not been fully implemented into the patterns of practice of the family physicians."
        }
      ]},
