      "Abstract": {
        "CopyrightInformation": "© 2014 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS AND OBJECTIVES",
            "content": "To explore the experiences of breast cancer screening for women with physical disabilities."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Despite women with disabilities having the same or greater risk of having breast cancer than women without disabilities, they are less likely to uptake breast cancer screening services."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Qualitative descriptive study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twelve women with physical disabilities were recruited for the purpose of this study. Data were collected via semi-structured face to face or telephone interviews. Interviews were transcribed and data were analysed thematically."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Overwhelmingly, participants conveyed that their breast screening experiences were negative. The following four themes describe the experiences of breast cancer screening for women with physical disabilities: feeling I'm not in control; being ignored and not listened to; being helpless, alone and afraid and; experiencing pain, torture and humiliation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Women with physical disabilities experience substantial barriers to breast cancer screening. This research highlights that the attitudes and poor communication skills of health professionals served as a deterrent to future screening for participants."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "RELEVANCE TO CLINICAL PRACTICE",
            "content": "By exploring experiences of women with physical disabilities of breast cancer screening, nurses and other health-care professionals can use this to develop and implement optimal approaches, such as collaborative models of care which empower women with disabilities."
          }
        ]
      },
