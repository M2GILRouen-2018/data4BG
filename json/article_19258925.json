      "Abstract": {
        "CopyrightInformation": "©2016 Foundation Acta Paediatrica. Published by John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "This study assessed the Helicobacter pylori (H. pylori) serum antibody test as a diagnostic screening tool in symptomatic inner city children."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This was a retrospective study of patients aged one to 18 years who were referred to our paediatric gastroenterology department from 2009 to 2013. We included all patients who had H. pylori serum antibodies and/or faecal antigens who underwent esophagogastroduodenoscopy (EGD) for histology, with or without a gastric tissue rapid urease test."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 395 patients had EGDs carried out to evaluate epigastric pain, heartburn and nausea or vomiting, and their overall socio-economic Z-score was -2.62. The histology was positive for H. pylori infection in 52 of 395 patients (13%), and epigastric pain was documented in 45 of these 52 patients (87%). Compared to histology, the serum H. pylori antibody test had a sensitivity of 88.4% and a specificity of 93.4%. The tissue rapid urease test and faecal antigen test had sensitivities of 89.3% and 55.6% and specificities of 89.9% and 98.9%, respectively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The serum H. pylori antibody test had high sensitivity and specificity, and it was a good diagnostic screening tool in our study. Epigastric pain was strongly associated with a current H. pylori infection in our population."
          }
        ]
      },
