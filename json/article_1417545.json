      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To study the distribution of isolates and antimicrobial susceptibility of gram-negative bacteria among culture-positive vitreous samples from patients with endophthalmitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The records from culture-positive vitreous isolates (endophthalmitis cases) during a 24-year period (December 1990 to December 2014), at the Microbiology Department of Bascom Palmer Eye Institute were reviewed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In the current study, gram-negative bacteria were reported in 246 (11.5%) of 2,134 vitreous isolates from endophthalmitis patients during 24-year period (December 1990 to December 2014) from a University Referral Center. The antimicrobial susceptibility to fluoroquinolones, aminoglycosides, carbapenems, and ceftazidime remained stable among gram-negative bacteria during the study period."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Antibiotic susceptibility pattern of gram-negative bacteria from vitreous isolates did not change significantly during the 24-year study period."
        }
      ]},
