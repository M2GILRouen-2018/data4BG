      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The risk factors underlying coronary heart disease (CHD) are well known."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of this study was to evaluate risk factors related to secondary prevention of working-age CHD patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "CHD patients with (n = 139) and without (n = 203) myocardial infarction were selected from a postal questionnaire study (n = 21 101) of randomly selected Finns aged 20-54 years (HeSSup study). Four age- and sex-matched controls were chosen for every patient."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "CHD patients still smoke, are obese and suffer hangovers more frequently than the control population."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The health care system has not succeeded in the secondary prevention of CHD."
        }
      ]},
