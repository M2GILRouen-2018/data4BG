      "Abstract": {
        "CopyrightInformation": "© 2011 The Authors Acta Obstetricia et Gynecologica Scandinavica\u2002© 2011 Nordic Federation of Societies of Obstetrics and Gynecology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess whether early or immediate removal of a 12F in-dwelling Foley catheter after total abdominal hysterectomy affects the level of subjective pain assessment postoperatively."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University Hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "POPULATION",
            "content": "Seventy women underwent total abdominal hysterectomies for various benign gynecological diseases."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Women were randomized to have the urinary catheter removed in the operating room after the surgical procedure or to have it removed on postoperative day 1."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "The primary outcome was patients' pain assessment and the secondary outcomes were rate of re-catheterization and symptomatic urinary tract infection."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was no difference in the pain assessment between the two groups. A significantly higher number of urinary retention episodes requiring re-catheterization were found in the immediate removal group compared with the delayed removal group (20 vs. 0%; p= 0.011). The incidence of symptomatic urinary tract infection did not differ between the two groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "There are pros and cons regarding the policy of one-day in-dwelling catheterization compared to immediate catheter removal."
          }
        ]
      },
