      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Academy of Hospice and Palliative Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Breathlessness is common in patients with advanced cancer. Using a multidisciplinary approach for relieving this challenging symptom was believed to be just a theory. The \"SOB Program\" was implemented in our institution in March 2013."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASURES",
            "content": "An audit of medical records before and after implementation of the \"SOB Program\" was performed to identify any changes in practice after implementation, specifically in the use of nonpharmacologic interventions."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "The \"SOB Program\" is a multidisciplinary service in our department, using both pharmacologic and nonpharmacologic interventions for all patients with advanced cancer who have dyspnea."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "OUTCOMES",
            "content": "There was a marked increase in the use of nonpharmacologic interventions after the \"SOB Program\" (26.86% preimplementation vs. 89.35% postimplementation). Patients joining the program also had satisfactory improvement in breathlessness."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS/LESSONS LEARNED",
            "content": "A multidisciplinary approach for breathlessness control is both feasible and practical. Similar services can be promoted in other palliative care centers."
          }
        ]
      },
