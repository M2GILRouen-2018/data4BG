      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine neonatal intensive-care unit nurses' judgments of pain intensity in term and preterm newborns and to describe the cues used to assess the possible presence of pain in newborns."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A combination of quantitative and qualitative approaches that included both parametric and nonparametric statistical procedures and a content analysis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A large, university-affiliated, tertiary-care hospital in central Canada."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Forty-five registered nurses employed in the neonatal intensive-care unit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Nurses viewed videotapes of term and preterm newborns and written vignettes. Visual analogue scales and open-ended questions were used."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Pain intensity ratings of full-term and preterm newborns and the cues identified as indicative of pain in newborns."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Nurses gave significantly higher pain intensity ratings to the full-term group than to the preterm group of newborns. Some differences were found in the cues identified by the nurses in assessing pain in term versus preterm newborns."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Nurses' judgments of pain intensity in newborns are influenced by the vigor and richness of the newborn's behavior response. Neonatal nurses must be provided with continuing education that focuses upon recognition of the signs and symptoms of pain in newborns."
        }
      ]},
