      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study examines the differences in frequency and distress caused by menopausal symptoms experienced by Canadian and Chinese women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cross-sectional surveys were conducted in Canada and China."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The Canadian studies were conducted in Toronto. The Chinese data were collected in Guangzhou City."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Women, 47-62 years old, 2-7 years after a natural menopause, were recruited."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Two hundred and eighty-two Canadians were recruited for two menopause studies. Data from 297 Chinese were obtained through a household survey. From a 105-item symptom questionnaire, women indicated the frequency and distress caused by symptoms in the previous month."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Frequency and mean distress score of problems were ranked and compared. Using the importance score method, a Chinese questionnaire was constructed and compared with the Menopause-Specific Quality of Life questionnaire."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The frequency of symptoms and distress experienced by Canadian and Chinese women differed markedly. Fourteen of the 29 items differed between the Chinese questionnaire and the Menopause-Specific Quality of Life questionnaire."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "There are striking differences between Chinese and Canadian women in the frequency and distress caused by menopausal symptoms. The Canadian questionnaire may not be relevant for Chinese women."
        }
      ]},
