      "Language": "rus",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "The study of physical performance of ischemic heart disease (IHD) patients in comfortable and uncomfortable (summer) weather conditions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Systemic reserves were assessed by physical performance tests in comfortable weather (equivalent-effective temperature--EET 18-24 degrees C) and in heat discomfort (EET 25-30 degrees C), i.e. in summer when atmospheric oxygen is low (hyperthermic hypoxia)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In uncomfortable weather, compared to comfortable one, general performance was significantly reduced evidencing uneffective function of the cardiovascular system. Comparison of the main ergometric parameters under the same load provides more accurate definition of the same trends in dynamics."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "General reserve in IHD patients is reduced under conditions of heart discomfort."
        }
      ]},
