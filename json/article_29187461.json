      "Abstract": {
        "CopyrightInformation": "Copyright© 2017, International Institute of Anticancer Research (Dr. George J. Delinasios), All rights reserved.",
        "AbstractText": [
          {
            "Label": "BACKGROUND",
            "content": "The aim of this meta-analysis was to estimate the survival after immediate complete lymph node dissection (CLND) compared to observation only (OO) or delayed CLND in patients with melanoma and lymph node metastasis."
          },
          {
            "Label": "MATERIALS AND METHODS",
            "content": "A systematic search was performed in: PubMed, Web of Science, Cochrane Library, CINAHL, Clinical trials and Embase. Eligible studies were randomized controlled trials (RCTs) comparing: CLND with OO, or immediate CLND with delayed CLND."
          },
          {
            "Label": "RESULTS",
            "content": "Four RCTs were included. There was no difference in melanoma-specific survival (MSS) (HR=0.91, 95% CI=0.77-1.08, p=0.29). In a sensitivity analysis, MSS was higher after immediate CLND compared to delayed CLND in patients with nodal metastasis (HR=0.63, 95% CI=0.35-0.74, p=0.0004) without evidence of heterogeneity."
          },
          {
            "Label": "CONCLUSION",
            "content": "CLND appears to have no additional survival benefit after SNB compared to OO. However, subgroup analysis suggests a time-dependent benefit for early surgical lymph node removal compared to delayed or none."
          }
        ]
      },
