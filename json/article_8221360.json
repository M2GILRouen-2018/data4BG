      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To treat diastolic dysfunction in patients with coronary artery disease (CAD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Open study of the intravenous injection of 5 mL of a solution containing 17% magnesium chloride (equal to 100 mg of elemental magnesium) during routine coronary angiography in patients with a raised left ventricular end-diastolic pressure (LVEDP)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A hospital department of cardiac hemodynamics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Ten patients with angiographically documented CAD."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After magnesium chloride injection, the LVEDP was significantly reduced in all patients, from a mean of 24 +/- 3 to 16 +/- 3 mmHg (P < 0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Under the short term conditions of the study, the injection of magnesium chloride effectively improved left ventricular diastolic function. Further study of the long term effect is required."
        }
      ]},
