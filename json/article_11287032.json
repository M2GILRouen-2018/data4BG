      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the response of adhesion and peritoneal fibroblasts to hypoxia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective experimental study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Primary cultures of fibroblasts established from the peritoneal and adhesion tissues of the same patients (n = 2) to minimize genetic variations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Hypoxia treatment of the primary cultured fibroblast."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Analyze the expression of extracellular matrix (ECM) components, metalloproteinases and their tissue inhibitors, growth factors, and cytokines in adhesion and peritoneal fibroblasts under normal and hypoxic conditions by reverse transcriptase/polymerase chain reaction analysis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Compared to peritoneal fibroblasts, adhesion fibroblasts had a significant increase in the basal mRNA levels for collagen I, fibronectin, MMP-1, TIMP-1, TGF-beta 1, TGF-beta 2, and IL-10. Hypoxia resulted in a further increase in collagen 1, fibronectin, TIMP-1, TGF-beta 1, TGF-beta 2, IL-10, and IFN-gamma mRNA levels in both peritoneal and adhesion fibroblasts. The increase was more profound in adhesion fibroblasts."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Hypoxia induces molecular changes in both peritoneal and adhesion fibroblasts, creating a milieu that favors adhesion development. The effect of hypoxia was more profound on adhesion fibroblasts."
        }
      ]},
