      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Cavernous malformations are characterized by enlarged vascular structures located in benign neural tissues within the cerebellum and spinal cord of the central nervous system. Cavernous hemangiomas (CHs) account for 5% to 12% of all spinal vascular malformations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "We removed a hemorrhagic thoracic mass in a 40-year-old male patient who presented with progressive neurological deficits."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "We found it appropriate to present this case due to its rarity."
        }
      ]},
