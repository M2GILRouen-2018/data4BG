      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "There is evidence for an association between Modic type 1 and pain in patients with low back pain (LBP), but little knowledge about its effect on clinical outcomes."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "(1) To assess the prevalence of Modic changes, (2) to determine if Modic changes influence the clinical course of LBP, and (3) to identify prognostic factors for recovery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN/SETTING",
          "content": "Prospective clinical cohort study, with a 1-year follow-up. The treatment consisted of brief intervention and instruction in stretching. PATIENT'S SAMPLE: Two hundred and sixty-nine patients with chronic low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Socio-demographic variables, education, profession, self-reported measures, degenerative changes on MRI."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Linear growth model and Cox regression analysis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Five percent had a normal MRI, 14 and 50% had Modic 1 and Modic 2 changes. Modic changes were not significant covariates for the clinical course of pain, function or fear avoidance beliefs. Education was a strong prognostic factor for recovery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Modic changes did not influence the clinical course of back pain and were not prognostic factors for recovery. Education was strongly associated with recovery."
        }
      ]},
