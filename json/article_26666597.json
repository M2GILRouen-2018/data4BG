      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study aimed to investigate the association between BMI at 65 years of age and the development of hypertension during the subsequent five years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 1,003 participants (65 years of age) who had no history of myocardial infarction and/or hypertension at baseline health check-ups (1996-2005) and participated in a secondary health check-up when the subjects reached 70 years of age were analyzed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Using fully adjusted models, men with a BMI of <18.5 [odds ratio (OR), 4.08; 95% confidence interval (CI), 1.32-1.83], BMI of 23.0-24.9 (OR, 2.00; 95% CI, 1.18-3.40) and BMI of ≥25.0 (OR, 1.98; 95% CI, 1.10-3.56) were found to be at higher risk of developing hypertension than did those with a BMI of 18.5-22.9."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Leanness or being overweight/obese at age 65 increases the risk of subsequent hypertension."
        }
      ]},
