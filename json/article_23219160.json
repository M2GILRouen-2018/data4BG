      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Australian College of Midwives. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Assessment of women's labor pain is seldom acknowledged in clinical practice or research. The words \"aching\" and \"hurting\" are frequently used by women to describe childbirth pain. The aim of this study was to determine the quantitative meanings midwifery students attribute to the terms \"hurt\", \"ache\" and \"pain\". Data was collected by self-administered questionnaire from students at seven Swedish midwifery programs. A total of 230 filled out and returned a completed questionnaire requesting them to rate, on a visual analog scale, the intensity of \"hurt\", \"ache\" or \"pain\" in the back, as reported by a fictitious parturient."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The midwifery students attributed, with substantial individual variation, different quantitative meanings to the studied pain descriptors."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "To be able to communicate about pain with a woman in labor, it is essential that the midwife be familiar with the value of different words and what they mean to her as this may affect her assessment when the woman describes her pain."
          }
        ]
      },
