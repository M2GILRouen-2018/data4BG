      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Asociación Mexicana de Gastroenterología. Published by Masson Doyma México S.A. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The different forms of lubrication are among the most simple, accessible, and economic techniques that have been implemented for improving the diagnostic performance of colonoscopy."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To determine whether the use of oil improved the number of complete colonoscopies, facilitated the procedure, reduced pain, or improved the study's diagnostic performance, compared with the conventional lubrication technique."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "One hundred and seventy-five patients referred for colonoscopy were alternately allocated to receive treatment with the standard lubrication method with chlorhexidine gel (group 1) or lubrication with corn oil administered through the working channel (group II). The number of complete colonoscopies, the length of time needed to reach the cecum, the degree of difficulty estimated by the endoscopist and the assistant, the level of pain at the end of the study estimated by the patient, and the endoscopic findings were all determined."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Eighty-eight patients made up group I and 87 made up group II. No statistically significant differences were found between the two groups in relation to general characteristics, the number of complete colonoscopies (93 vs. 97%, respectively), the time needed to reach the cecum (8:00 vs. 8:41min, respectively), the level of pain at the end of the study, or the detection of polyps. The degree of difficulty was slightly lower in group II, but with no statistical significance."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Lubrication with oil during colonoscopy did not improve the number of complete colonoscopies, did not facilitate the study, nor did it reduce pain or increase the diagnostic performance of the study, when compared with the conventional technique."
          }
        ]
      },
