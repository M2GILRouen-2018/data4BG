      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVES",
            "content": "Rapid-onset obesity with hypothalamic dysfunction, hypoventilation, and autonomic dysregulation (ROHHAD) is a rare pediatric disease of unknown cause. Here, in response to a recent case report describing a ROHHAD patient who suffered from secondary narcolepsy confirmed by an absence of hypocretin-1 in the cerebrospinal fluid, we consider whether the ROHHAD phenotype is owing to one or more mutations in genes specific to hypocretin protein signalling."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "DNA samples from 16 ROHHAD patients were analyzed using a combination of next-generation and Sanger sequencing to identify exonic sequence variations in three genes: HCRT, HCRTR1, and HCRTR2."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No rare or novel mutations were identified in the exons of HCRT, HCRTR1, or HCRTR2 genes in a set of 16 ROHHAD patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "ROHHAD is highly unlikely to be caused by mutations in the exons of the genes for hypocretin and its two receptors."
          }
        ]
      },
