      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare coronary angiography (CAG) and intravascular ultrasound (IVUS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "One hundred and twenty-five patients with typical angina who underwent CAG and IVUS were divided into stable angina group (Group SA) and unstable angina group (Group UA). Angiographic feature and ultrasound imaging were compared the two groups."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Coronary angiography showed no significant differences in the diseased artery and the degree of stenosis between the 2 groups. Intravascular ultrasound revealed that there were significantly more soft lesions in group UA than in Group SA, and that fibrous and calcific lesions were more prevalent in Group SA. Spontaneous dissection and thrombus were more frequently found in Group UA than in group SA."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "IVUS is superior to CAG for studying characteristics of coronary atherosclerotic plaque. IVUS is more important than CAG in selecting indications of coronary artery interventional operation."
        }
      ]},
