      "Abstract": {
        "CopyrightInformation": "© 2013 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To investigate the microorganisms in expressed prostatic secretions (EPS) of both chronic prostatitis patients and normal young male adults and to determine which microorganisms are associated with the degree of intraprostatic inflammation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Specific polymerase chain reaction (PCR) technology was performed to confirm Neisseria gonorrhoeae, Mycobacterium tuberculosis, Mycoplasma and Chlamydia trachomatis as well as human papilloma virus (HPV), herpes simplex virus type 2 (HSV-2) and cytomegalovirus (CMV). Universal primer PCR technology was carried out to detect 16S bacteria rDNA, followed by cloning and sequencing of the entire 16S rDNA product."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The total number of bacteria and/or viruses detected by PCR assays was significantly associated with disease severity (p < 0.001). The white blood cell count and lecithin level was significantly correlated with the number of detected bacteria and/or viruses (p = 0.001 and p = 0.046, respectively). 17 bacterial isolates were identified from 14 EPS samples by 16S rDNA sequencing."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Various microorganisms including Ureaplasma urealyticum, C. trachomatis, CMV, HPV and HSV-2 were identified in the EPS from patients with type III prostatitis. HPV infection may be associated with the degree of intraprostatic inflammation."
          }
        ]
      },
