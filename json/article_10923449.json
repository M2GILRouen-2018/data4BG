      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To inverstigate the effect of Caleitonin gene-related peptide (CGRP) on intracoronary thrombosis, thrombolysis, and reocclusion."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Thirty-six dogs were divided into three groups: saline solution (NS) group, nitroglycerin(NTG) group and CGRP group. The canine model of intracoronary thrombsis was established. Urokinase(UK) was administered intravenously. The time and rate of intracoronary thrombosis, patency and reocclusion were observed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The time of thrombus formation was markedly prolonged in the CGRP group. (NS 41 +/- 9 min, CGRP 72 +/- 11 min P < 0.01). The time of patency was shorted from 80 +/- 7 min(NS), 70 +/- 11 min(NTG) to 50 +/- 9 min(CGRP) (P < 0.01). The time of reocclusion was increased from 20 +/- 10 min(NS), 39 +/- 7 min(NTG) to 65 +/- 12 min(CGRP)(P < 0.01)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "CGRP can delay the intracoronary thrombus formation, assist thrombolysis and decrease the reocclusis after thrombolysis."
        }
      ]},
