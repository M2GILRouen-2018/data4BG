      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the anti-asthmatic effect of sodium ferulate (SF) and its mechanism in guinea pig asthmatic model."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Guinea pigs were sensitized with ovalbumin as animal asthmatic model and treated with 3 different concentration of SF for 8 days. Levels of endothelin (ET) and nitric oxide (NO) in blood and lung tissue, and eosinophil (EOS) in blood and bronchoalveolar lavage fluid (BLAF) was counted at the end of trial."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "SF could significantly lower the ET content and increase the NO concentration in serum and lung tissue, reduce the number of EOS in blood and BLAF (P < 0.05, P < 0.01). Stronger effect was showed in the high dose group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Mechanism of anti-asthmatic action of SF might be to increase NO concentration, lower ET content, alleviate EOS infiltration."
        }
      ]},
