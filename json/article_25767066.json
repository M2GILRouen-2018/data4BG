      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine the predictive value of preoperative clinical factors for postoperative temporomandibular disorders (TMDs) in patients receiving combined surgical-orthodontic treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "TMDs were classified according to Research Diagnostic Criteria for TMD in 219 patients. The severity of the TMD was scored according to the Helkimo anamnestic index (Ai) and clinical dysfunction index (Di)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Anamnestic TMJ clicking was the only significant predictor of TMD (odds ratio [OR] = 3.61, P = .006). The mean difference between clinical dysfunction index points was significant for pain on masticatory muscle palpation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This study demonstrated that in orthognathic patients, the following factors had high predictive value: (1) anamnestic TMJ clicking for TMD, (2) TMJ clicking, TMJ pain on palpation and bimaxillary surgery for Ai worsening, (3) maxillary retrusion and mandibular excess for Ai improvement, and (4) pain on masticatory muscle palpation for Di worsening."
          }
        ]
      },
