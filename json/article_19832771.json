      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To evaluate the efficacy and safety of eslicarbazepine acetate (ESL) as adjunctive therapy in adults with partial-onset seizures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Double-blind, placebo-controlled, parallel-group, multicenter study consisting of an 8-week baseline period, after which patients were randomized to placebo (n = 87) or once-daily ESL 800 mg (n = 85) or 1200 mg (n = 80). Patients received half dose during 2 weeks preceding a 12-week maintenance period."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Seizure frequency over the maintenance period was significantly (P < 0.05) lower than placebo in both ESL groups. Responder rate was 23% (placebo), 35% (800 mg), and 38% (1200 mg). Median relative reduction in seizure frequency was 17% (placebo), 38% (800 mg), and 42% (1200 mg). The most common adverse events (AEs) (>10%) were dizziness, somnolence, headache, and nausea. The majority of AEs were of mild or moderate severity."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Once-daily treatment with ESL 800 and 1200 mg was effective and generally well tolerated."
        }
      ]},
