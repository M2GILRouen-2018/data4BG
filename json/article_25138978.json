      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Depression and anxiety are prevalent in patients with chronic pain and adversely affect pain, quality of life, and treatment response. The purpose of this psychometric study was to determine the reliability and validity of the four-item Patient Reported Outcomes Measurement Information System (PROMIS) depression and anxiety scales in patients with chronic pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Secondary analysis of data from the Stepped Care to Optimize Pain care Effectiveness study, a randomized clinical trial of optimized analgesic therapy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Five primary care clinics at the Roudebush VA Medical Center (RVAMC) in Indianapolis, Indiana."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "Two hundred forty-four primary care patients with chronic musculoskeletal pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "All patients completed the four-item depression and anxiety scales from the PROMIS 29-item profile, as well as several other validated psychological measures. The minimally important difference (MID) using the standard error of measurement (SEM) was calculated for each scale, and convergent validity was assessed by interscale correlations at baseline and 3 months. Operating characteristics of the PROMIS measures for detecting patients who had probable major depression or were anxiety-disorder screen-positive were calculated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The PROMIS scales had good internal reliability, and the MID (as represented by two SEMs) was 2 points for the depression scale and 2.5 points for the anxiety scale. Convergent validity was supported by strong interscale correlations. The optimal screening cutpoint on the 4- to 20-point PROMIS scales appeared to be 8 for both the depression and anxiety scales."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The PROMIS four-item depression and anxiety scales are reasonable options as ultra-brief measures for screening in patients with chronic pain."
          }
        ]
      },
