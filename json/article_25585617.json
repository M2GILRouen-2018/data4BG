      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 by American Society of Clinical Oncology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "Curative chemotherapy for breast cancer is associated with significant toxicities including emergency room (ER) visits and hospital admissions (HAs), events that are underreported in clinical trials. This study examined the reasons for, and factors associated with, ER visits and HA after curative chemotherapy for breast cancer in a tertiary Ontario hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "A retrospective study of all patients who completed at least one cycle of curative chemotherapy for breast cancer in 2011 and 2012 was conducted. We recorded ER visits and HAs within 30 days of any chemotherapy. We collected demographics, comorbidities, surgical data, tumor characteristics, chemotherapy type and cycles, and use of granulocyte colony-stimulating factors (G-CSF)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 149 patients underwent curative chemotherapy. Mean age was 58.6 years. Adjuvant chemotherapy was received by 85% of patients and G-CSF by 88.6%. At least one ER visit occurred in 53% of patients, and 13% required HA. The most common causes of ER visits were fever without neutropenia (23.3%), pain (12.8%), and febrile neutropenia (9%). Stage of breast cancer was the only factor statistically significantly associated with ER visits (P = .045); tumor size (P = .019), adjuvant chemotherapy (P = .045), and lower number of chemotherapy cycles (P = .005) were significantly associated with HA."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Future research should focus on identifying the patient, provider, and health system factors associated with ER visits and HAs after chemotherapy for breast cancer, to minimize them and lessen the burden on the health care system."
          }
        ]
      },
