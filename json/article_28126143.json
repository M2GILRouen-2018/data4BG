      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier España, S.L.U. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVE",
            "content": "Unlike Burkitt lymphoma, molecular abnormalities other than C-MYC rearrangements have scarcely been studied in patients with mature B acute lymphoblastic leukemia (B-ALL). The aim of this study was to analyze the frequency and prognostic significance of copy number alterations (CNA) in genes involved in lymphoid differentiation, cell cycle and tumor suppression in adult patients with B-ALL."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "We have analyzed by multiplex ligation-dependent probe amplification the genetic material from bone marrow at diagnosis from 25 adult B-ALL patients treated with rituximab and specific chemotherapy."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The most frequent CNA were alterations in the 14q32.33 region (11 cases, 44%) followed by alterations in the cell cycle regulator genes CDKN2A/B and RB1 (16%). No correlation between the presence of specific CNA and the clinical-biologic features or the response to therapy was found."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The high frequency of CNA in the 14q32.33 region, CDKN2A/B and RB1 found in our study could contribute to the aggressiveness and invasiveness of mature B-ALL."
          }
        ]
      },
