      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report one case of proximal migration of ureteral stent. To perform a bibliographic review about other cases and management to avoid this complication."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "METHODS/RESULTS",
          "content": "48-year-old woman who presents right obstructive uropathy after gynecologic surgery. After the introduction of the right ureteral stent we observed a proximal stent migration. We put on a right nephrostomy tube and antergrade ureteral stent."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The right stent length and proper location of the distal tip are important factors to avoid this complication."
        }
      ]},
