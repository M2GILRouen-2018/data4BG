      "Abstract": {
        "CopyrightInformation": "© 2016 Royal Australasian College of Surgeons.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Intra-articular pain catheters effectively reduce postoperative pain in total knee arthroplasty (TKA) by delivering analgesia to the surgical site. However, concerns exist regarding the potential for increasing deep infections. This study tested the hypothesis that intra-articular pain catheters in TKA increase the rate of deep surgical site infections."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A retrospective analysis of 1915 patients undergoing primary TKA between January 2008 and December 2013 was undertaken, comparing infection rates between patients with intra-articular catheters inserted and those without."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Deep infection rate was 0.53% with intra-articular pain catheters, compared with 0.77% when the catheters were not inserted. There was no statistically significant difference between the groups (P\u2009=\u20090.56)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Intra-articular pain catheters in TKA did not increase the rate of deep infection."
          }
        ]
      },
