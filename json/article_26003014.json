      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Hanley & Belfus. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "A cohort study."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The causes of the pain can be difficult for clinicians to diagnose due to the complexity of the shoulder anatomy and the wide spectrum of shoulder conditions."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE OF THE STUDY",
            "content": "The aim of this study was to investigate the clinical usefulness of provocative diagnostic tests, in patients with partial-thickness tears of the supraspinatus (SST) tendon."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The partial-thickness tears SST tendon group consisted of 50 patients and 50 subjects with shoulder pain. Sensitivity, specificity, positive and negative predictive values, and likelihood ratios of five physical examination tests were calculated using a 2 × 2 table."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "All the tests exhibited clinical useful positive LR greater than 2 (all, >7.0). The Yocum, Jobe, and Hawkinse-Kennedy exhibited clinically useful negative LR of less than 0.5."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The provocative tests examined were clinically useful in determining the presence or absence of pathology of the supraspinatus tendon."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "2b."
          }
        ]
      },
