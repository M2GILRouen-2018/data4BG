      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Clinical asthma guidelines recommend spirometry for asthma diagnosis, but there is inconsistent evidence about benefits to patients in using it for ongoing management. Our aim was to determine whether training in the use of spirometry for management of asthma provided better health outcomes and improved the quality of care in the primary care setting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Pragmatic, cluster randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "General practices in two states of Australia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Forty practices and 397 adults with asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "The staff of 26 intervention practices received comprehensive spirometry training. Fourteen control practices provided usual care."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Primary outcome measures were quality of life, self-reported asthma symptoms and lung function. Secondary measures related to the process of care (e.g. performance of spirometry, preparation of a written asthma action plan) and patient and general practitioner rating of the acceptability and usefulness of spirometry."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no statistically significant differences between the groups at 12 months for quality of life (mean difference = -0.23; 95% CI: -0.44, -0.01), days off work (rate ratio = 1.52; 95% CI: 0.91, 2.54), exacerbations (rate ratio = 1.09; 95% CI: 0.85, 1.41), asthma on waking (rate ratio = 1.21; 95% CI: 0.79, 1.85), nocturnal asthma (rate ratio = 0.98; 95% CI: 0.63, 1.51) and post-bronchodilator FEV(1)/FVC ratio (mean difference = -0.01, 95% CI: -0.03, 0.02). There was no improvement in the quality of care provided."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Training in spirometry did not result in any measurable improvement in the use of spirometry, quality of management of asthma or patient outcomes in primary care."
        }
      ]},
