      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To establish a model for the detection of specific factors associated with the severity of symptoms and the impact of fibromyalgia (FM)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We evaluated 332 consecutive new patients with FM for factors that may be associated with disease severity, assessed by patient global assessment, and function, evaluated by the Fibromyalgia Impact Questionnaire (FIQ). Fifteen potential explanatory factors were evaluated in a multiple linear regression model on data taken from an extensive group of standardized instruments."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of the 15 factors, pain levels, self-assessed inability to work, psychological distress, pending litigation, helplessness, level of education, and coping ability had a significant association with patients' global assessment and with scores on the total FIQ as well as on the activities of daily living subcomponent of the FIQ."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Disease related factors such as pain and psychological factors such as work status, helplessness, education, and coping ability had an independent and significant relationship to FM symptom severity and function."
        }
      ]},
