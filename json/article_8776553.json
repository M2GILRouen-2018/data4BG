      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To discuss the numerous psychological barriers to optimum pain relief in infants, children, and adolescents."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "The professional and scientific literature on pediatric pain was accessed by means of Psychlit and Medline searches. Our clinical experience with patients was also used."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SYNTHESES",
          "content": "The potential barriers to optimum management were discussed in terms of cognitive and emotional developmental barriers, perceived lack of control, children's knowledge and attitudes, and characteristics of children."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The psychological barriers to optimum pain relief are significant and attention to these barriers could lead to better pain management."
        }
      ]},
