      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the effect on gastrointestinal functions of Polygonum paleaceum Wall."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Defecation reflex, gastric emptying, motility of the gastroinestinal tract of mice and isolated intestinal smooth muscle of rabbits were used."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Polygonum paleaceum Wall could inhibit defecation reflex and depress the motility of the gastrointestinal tract, delay gastric emptying in mice. It also had analgesia action, but didn't affect rabbit intestinal contraction spontaneously or induced by acetylcholine (Ach) in vitro."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "It suggested that Polygonum paleaceum Wall possessed the action on gastrointestinal functions."
        }
      ]},
