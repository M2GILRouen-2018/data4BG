      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND OBJECTIVES",
          "content": "We identified the impact of extracorporeal cardiopulmonary resuscitation (ECPR) followed by therapeutic hypothermia on survival and neurologic outcome in patients with prolonged refractory in-hospital cardiac arrest (IHCA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We enrolled 16 adult patients who underwent ECPR followed by therapeutic hypothermia between July 2011 and December 2015, for IHCA. Survival at discharge and cerebral performance category (CPC) scale were evaluated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All patients received bystander cardiopulmonary resuscitation (CPR); the mean CPR time was 66.5±29.9 minutes, and the minimum value was 39 minutes. Eight patients (50%) were discharged alive with favorable neurologic outcomes (CPC 1-2). The mean follow-up duration was 20.1±24.3 months, and most deaths occurred within 21 days after ECPR; thereafter, no deaths occurred within one year after the procedure."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "ECPR followed by therapeutic hypothermia could be considered in prolonged refractory IHCA if bystander-initiated conventional CPR is performed."
        }
      ]},
