      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Chartered Society of Physiotherapy. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine trunk muscle activity when lifting an object of greater weight than expected, which may contribute to the development of low back pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Electromyographic evaluation of trunk muscle activity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University of Tsukuba, Spine laboratory."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Eleven healthy men with a mean age of 24 (SD 2) years."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Trunk muscle activity was measured when subjects lifted an object with their right arm in immediate response to a light stimulus. Surface and wire electrodes were used to measure the activity of the rectus abdominis, external oblique and erector spinae muscles, and the transversus abdominis and lumbar multifidus muscles, respectively. The lifting tests were performed in three different settings: lifting an expected 1-kg object, lifting an unexpected 4-kg object (erroneously expected to weigh 1 kg), and lifting an expected 4-kg object."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "The muscle activity induced when subjects lifted objects of different weights was compared by calculating the root mean square (RMS) of muscle activity at rest and % maximum voluntary contraction."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "When the subjects were aware of the weight of the object to be lifted, the activity of the external oblique, transversus abdominis, erector spinae and lumbar multifidus muscles increased immediately after lifting. When the subjects were not aware of the weight of the object to be lifted, the increase in muscle activity was delayed (P<0.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Trunk muscles may not be able to function appropriately when individuals lift an object that is much heavier than expected."
          }
        ]
      },
