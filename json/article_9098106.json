      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To study the correlation between the caries status and the salivary antioxidant levels among asthmatic children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTINGS AND DESIGN",
          "content": "One hundred children within the age group of 6 12 years were selected and equally subdivided into children having a history of asthma and their healthy siblings."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Salivary antioxidant levels were assessed using spectrophotometric method, and the caries status was recorded using DMFT (Decayed, missing and Filled Teeth Index) and dft (decayed, filled teeth index) index."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "The salivary antioxidant levels were reduced among the asthmatic children which was statistically highly significant, whereas the caries prevalence was reduced, but not statistically significant."
        }
      ]},
