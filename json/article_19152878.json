      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To document a rare case of endometriosis in the soleus and gastrocnemius muscles."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary care center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 30-year-old fertile woman presented with moderate dysmenorrhea associated with calf pain and bulging that had been gradually worsening over the last years, particularly during menses. A mass in the soleus and gastrocnemius muscles was identified in ultrasonography and magnetic resonance imaging."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Endometriosis was diagnosed by incisional biopsy on the basis of histopathology, and wide excisional biopsy was performed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Unusual clinical presentation of endometriosis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "The patient was disease free for 2 months. Recurrence of the lesion was then diagnosed, and a new surgical approach was planned."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Endometriosis in muscles is a rare event, and existing theories are not totally sufficient in explaining it."
        }
      ]},
