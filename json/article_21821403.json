      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To determine if plant stanols and plant sterols differ with respect to their low-density lipoprotein cholesterol (LDL-CH) lowering efficacies across a continuous dose range."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Dose-response relationships were evaluated separately for plant stanols and plant sterols and reductions in LDL-CH, using a first-order elimination function."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Altogether, 113 publications and 1 unpublished study report (representing 182 strata) complied with the pre-defined inclusion and exclusion criteria and were included in the assessment. The maximal LDL-CH reductions for plant stanols (16.4%) and plant stanol ester (17.1%) were significantly greater than the maximal LDL-CH reductions for plant sterols (8.3%) and plant sterol ester (8.4%). These findings persisted in several additional analyses."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION AND CONCLUSIONS",
            "content": "Intakes of plant stanols in excess of the recommended 2g/day dose are associated with additional and dose-dependent reductions in LDL-CH, possibly resulting in further reductions in the risk of coronary heart disease (CHD)."
          }
        ]
      },
