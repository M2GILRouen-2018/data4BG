      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Palliative home care gains in importance in Germany. In addition to administering pain and symptom control for patients a \"Palliative Care Team\" (PCT) tries to address the patients' psychosocial and spiritual needs."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Retrospective analysis of caregiving relatives' expectations of the support by a PCT."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Most relatives expected a sufficient pain therapy and support of the PCT. Additionally they wished for further outreach afterthe death of the patient."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Palliative homecare is perceived as a helpful supporting factor by the care-giving relatives of palliative patients."
        }
      ]},
