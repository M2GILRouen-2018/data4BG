      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 The Authors. Published by Elsevier Ltd.. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "While isolated traumatic urinary bladder injuries are rare, combined intra- and extraperitoneal traumatic urinary bladder ruptures without an underlying fracture are an absolute rarity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PRESENTATION OF CASE",
            "content": "We report a case of combined intra- and extraperitoneal urinary bladder rupture without an underlying fracture resulting from blunt abdominal trauma during a high velocity car accident. A midline laparotomy was performed, and the intra- and extraperitoneal bladder ruptures were surgically treated."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Based on the presented case the anatomical peculiarities of the urinary bladder and the different trauma mechanisms as well as the resulting lesions, the diagnostic modalities and the treatment options are discussed."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Despite the rarity of traumatic urinary bladder injuries, and especially in the absence of an underlying fracture, physicians should maintain a high level of suspicion for urologic injuries in the presence of nonspecific lower abdominal pain, gross haematuria and the inability to urinate."
          }
        ]
      },
