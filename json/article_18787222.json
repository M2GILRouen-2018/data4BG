      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "In asthma, inhaled corticosteroids are not always able to maintain an optimal therapeutic control despite being used at high doses; other anti-inflammatory therapies are needed. Several such therapies, including daclizumab, are currently under evaluation."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To discuss the results of study on daclizumab in asthma patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Analysis of efficacy and safety data from a randomised placebo-controlled study performed in patients with moderate to severe asthma and suboptimal control under high doses of inhaled corticosteroids."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Daclizumab demonstrated significant efficacy and its further clinical evaluation in asthma is supported by these results."
        }
      ]},
