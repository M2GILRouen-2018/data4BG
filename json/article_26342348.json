      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 North American Society for Pediatric and Adolescent Gynecology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The effect of perforated appendicitis on the adnexa is an issue of concern and controversy. Long-term fertility studies have been conflicting."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE",
            "content": "We present the case of a patient with chronic pelvic infections, salpingitis, and hydrosalpinx after perforated appendicitis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "SUMMARY AND CONCLUSION",
            "content": "Magnetic resonance imaging was helpful in diagnosing a chronically obstructed fallopian tube, likely secondary to the dense adhesions from her previously treated perforated appendicitis. Salpingectomy relieved her symptoms of chronic pain and recurrent infections."
          }
        ]
      },
