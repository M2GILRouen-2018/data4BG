      "Abstract": {"AbstractText": [
        {
          "Label": "INTRODUCTION",
          "content": "Localised bronchial obstruction is a rare differential diagnosis to asthma."
        },
        {
          "Label": "CASE STUDY",
          "content": "We describe two younger patients treated unsuccessfully for asthma and eventually diagnosed with localised bronchoconstriction."
        },
        {
          "Label": "RESULTS",
          "content": "Bronchoscopy revealed bronchoconstriction: Tracheobronchomalacia in case 1 and fixed obstruction in case 2."
        },
        {
          "Label": "CONCLUSION",
          "content": "A systematic approach to the asthma patient with absent response to therapy facilitates rational use of therapeutic and diagnostic resources."
        }
      ]},
