      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Depression is associated with low heart rate variability (HRV) in patients following myocardial infarction, suggesting that alterations in the autonomic nervous system may contribute to the adverse cardiac outcomes associated with depression. Whether depression is associated with low HRV in patients with stable coronary heart disease (CHD) is not known."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine the association between major depression and 24-hour HRV in patients with stable CHD."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN, SETTING, AND PARTICIPANTS",
          "content": "Cross-sectional study of 873 outpatients with stable CHD recruited from outpatient clinics in the San Francisco Bay Area, California."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Major depression was assessed using the Computerized National Institute of Mental Health Diagnostic Interview Schedule. Heart rate variability was measured by 24-hour ambulatory electrocardiography."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 195 participants (22%) had major depression. Overall, we observed no association between depression and HRV as measured by time domain or frequency domain variables. Mean HRV was similar in participants with and without depression (all P values >.10), and participants with depression were no more likely than those without depression to have low HRV (all P values >.10)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "We found no evidence of an association between depression and HRV in 873 outpatients with stable CHD. These findings raise questions about the potential role of HRV in the association between depression and cardiovascular disease."
        }
      ]},
