      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe the safety and efficacy of influenza vaccines in asthmatic children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Literature was identified by a MEDLINE search (2002-March 2003). Key search terms included asthma, exacerbation, children, vaccine, and influenza."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "DATA SYNTHESIS",
          "content": "Concerns that the influenza vaccine may exacerbate asthma attacks have kept many asthmatic children from receiving this immunization. Researchers have conducted studies to determine the burden of influenza on asthmatic children, the safety of influenza vaccines, and their benefit in the presence of glucocorticoid burst therapy in the same population."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Influenza vaccines tested are safe and efficacious in asthmatic children."
        }
      ]},
