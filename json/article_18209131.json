      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the effects of nonsteroidal anti-inflammatory drugs (NSAIDs) on bleeding for pediatric adenotonsillectomy in a retrospective study, based on the common practices at 2 different tertiary care facilities."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A retrospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Two different tertiary care facilities."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Children up to 16 years of age, who underwent elective adenotonsillectomy or tonsillectomy, were included in the study. All indications for adenotonsillectomy, and all surgical techniques were included. Children with a bleeding tendency, and those with contraindications to the use of NSAIDs (eg, because of allergy), were excluded from the study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Nonsteroidal anti-inflammatory drugs."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Postoperative bleeding in patients."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 1160 patients were selected who met the criteria: 673 patients underwent an adenotonsillectomy or tonsillectomy and did not receive any preoperative and postoperative ibuprofen, and 487 patients underwent routine adenotonsillectomy or tonsillectomy and were given postoperative ibuprofen. We noted a 0.7% postoperative bleeding rate in patients who were not allowed to take ibuprofen perioperatively. There was a 1.0% postoperative bleeding rate in patients who were allowed to take ibuprofen perioperatively (P = .75)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ibuprofen is not a contraindication to adenotonsillectomy or tonsillectomy and should be used in the control of postoperative pain if it is indicated in the patient."
        }
      ]},
