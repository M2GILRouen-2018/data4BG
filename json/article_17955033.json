      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case report of spinal arteriovenous malformation presented as chest pain in a child."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To illustrate the atypical clinical presentation as right chest pain in a child with spinal cord arteriovenous malformation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Chang Gung Memorial Hospital and Chang Gung University, Taiwan."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "An 8-year-old boy was diagnosed with spinal cord arteriovenous malformation after paraplegia. However, early diagnosis was delayed for the atypical initial clinical presentation as chest pain. After surgery and rehabilitation for 6 months, the patient could walk without assistance."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Correct diagnosis of spinal cord arteriovenous malformations is sometimes difficult in children with atypical presentations. Early diagnosis relies on detailed examination and high index of suspicion."
        }
      ]},
