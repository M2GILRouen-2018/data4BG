      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The study contained herein was undertaken to describe the minilaparotomy approach to tumors of the right colon."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Clinical data were prospectively registered from 47 patients who were undergoing resection of the right colon via minilaparotomy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Bowel function returned after two days and passage of stools after four days. Pain medication was necessary only during the first three postoperative days. Major complications were few, and no postoperative deaths occurred. Tumors 10 cm or smaller could be handled by minilaparotomy, and the technique allowed a relevant number of lymph nodes to be removed. No local recurrences were detected during the early postoperative period."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The minilaparotomy approach to tumors of the right colon seems to be an attractive alternative to conventional colon surgery."
        }
      ]},
