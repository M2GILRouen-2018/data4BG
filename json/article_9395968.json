      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate effectiveness of water versus tea bag compresses in treatment of sore nipples during breastfeeding."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomized trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Mother-infant care wards in a tertiary care teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Sixty-five primiparae with sore nipples who were breastfeeding after a vaginal delivery at 37 or more weeks gestation, who were 36 hours or less postpartum, and had combined mother-infant care."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Participants were assigned randomly to one of six treatment groups with one of three regimens (tea bag compress, water compress, or no compress) randomly assigned to right or left sides. Participants applied the treatments at least four times a day, from Days 1 to 5 postpartum."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Reduction of nipple pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Tea bag and water compresses were more effective than no treatment, with no statistically significant difference between the two types of compresses."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Warm water or tea bag compresses are an inexpensive, equally effective treatment for sore nipples during the early postpartum period."
        }
      ]},
