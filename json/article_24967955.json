      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study aimed to evaluate the diagnostic value of Waist-to-Height Ratio in early detection of obesity and metabolic syndrome in Chinese children and adolescents."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A cross-sectional study was conducted in six cities in China in 2010 with 16,914 children and adolescents aged 7-17 years. Participants were randomly divided into the training and testing sets. Diagnostic values were estimated using sensitivity, specificity and areas under receiver operating characteristic curves."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The coefficients of variation of Waist-to-Height Ratio among age groups were lower than that of body mass index and waist circumstance. The area under receiver operating characteristic curve of Waist-to-Height Ratio was 0.968 in boys and 0.949 in girls for general obesity evaluation, and 0.983 in boys and 0.984 in girls for central obesity. The optimal cut-offs of Waist-to-Height Ratio were 0.47 in boys and 0.45 in girls in the training set and validated in the testing set. For metabolic syndrome evaluation, the sensitivity and specificity were 0.858 and 0.825 in boys, 0.864 and 0.812 in girls under the suggested cut-offs."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Waist-to-Height Ratio was a simple, effective and practical tool for mass screening childhood obesity and metabolic syndrome in China. It will have potential values in public health practice."
          }
        ]
      },
