      "Abstract": {
        "CopyrightInformation": "© 2012 The Authors Pediatric Obesity © 2012 International Association for the Study of Obesity.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Schools provide a prime environment for interventions that attempt to increase physical activity and prevent obesity."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study examined the effect of a 30-min, structured recess using 22 games of known energy expenditure on moderate-to-vigorous physical activity when compared to free play implemented with third graders from two elementary schools over 9 weeks."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Moderate-to-vigorous physical activity and other cardiovascular risk factors were assessed pre- and post-intervention in 27 children."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Moderate-to-vigorous physical activity during recess increased significantly in intervention school children from 6.9\u2009±\u20090.8 to 14.9\u2009±\u20090.9\u2009min pre- and post-intervention, respectively (adjusted mean change 8.0\u2009±\u20091.1; P\u2009<\u20090.0001), with no differences by gender or body mass index (BMI). In-school, moderate-to-vigorous physical activity also increased significantly more for intervention compared to control children (adjusted mean change 14\u2009±\u20094\u2009min vs. 3\u2009±\u20093\u2009min; P\u2009=\u20090.014, respectively)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "There was no significant difference in BMI and cardiovascular risk factors. A structured recess is feasible to implement and can significantly increase moderate-to-vigorous physical activity."
          }
        ]
      },
