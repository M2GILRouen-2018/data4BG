      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To test and verify the transient therapeutic effect of acupuncture at point \"Qingchuan\" on bronchial asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Two hundred cases of bronchial asthma at acute attack stage were divided into a trial group of 100 cases treated with acupuncture at point \"Qingchuan\" and a control group of 100 cases treated with acupuncture at Dingchuan (EX-B1)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The total effective rate was 92.60% and the effect occurred within 42-860 seconds after acupuncture in the trial group, and 81.0% and within 114-126 seconds in the control group, respectively, with very significant differences between the two groups (P < 0.01, P < 0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Acupuncture at point \"Qingchuan\" can significantly improve asthmatic state in the patient of bronchial asthma with action of rapidly stopping asthma."
        }
      ]},
