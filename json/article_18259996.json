      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We examined asthma risk factors among 274 Puerto Rican children born in New York to atopic mothers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We prospectively followed the cohort to measure aeroallergens in their homes and assess allergic sensitization. Baseline data are presented."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Maternal smoking was significantly higher among women born on the continental United States (25%) vs. those born elsewhere (11%). Cat ownership was more frequent among mainland-born women (15%) compared with those born in Puerto Rico (4%). While some aeroallergens were prevalent, few dust samples contained detectable dust mite allergens."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "By following this cohort, we hope to identify the roles that socio-cultural factors play in the process of allergic sensitization."
        }
      ]},
