      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to test the value of F(2)-isoprostane (F(2)-IsoP) levels in the pericoronal gingiva as a potential predictor of oral disability after mandibular third molar (M3M) surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Thirteen patients (5 male, 8 female) with partially impacted M3M were enrolled. Pericoronal soft tissues histology was obtained, gingival F(2)-IsoPs were measured by gas chromatography/negative-ion chemical ionization tandem mass spectrometry, and health-related quality of life (HRQOL) scores were assessed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A variable degree of pericoronitis was evident before the M3M surgery, with a mean level of pericoronal F(2)-IsoPs of 634.8 ± 193.5 pg/mg of tissue. A significant positive correlation between pericoronal F(2)-IsoPs and HRQOL was observed in male (r(s) = 0.440; P = .0011), but not female (r(s) = -0.062; P = .5124) patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Levels of F(2)-IsoPs in the pericoronal soft tissues are correlated with the degree of oral disability after M3Ms surgery in male, but not female, patients."
          }
        ]
      },
