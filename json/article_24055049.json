      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess whether blood type was associated with diminished ovarian reserve (DOR) (day-3 follicle-stimulating hormone level >10 IU/L), controlling for history of tobacco smoking, body mass index (BMI), history of endometriosis, ovarian surgery, previous pregnancy, and maternal age."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Academic medical center, Division of Reproductive Endocrinology and Infertility."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Women undergoing in vitro fertilization (IVF) from 2006-2011 (n = 305)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "None."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Presence of DOR in relation to a patient's blood type."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Other investigators have reported an increased risk for DOR in patients with blood type O and a protective effect on ovarian reserve for blood type A. We observed no association between a woman's blood type and DOR. We found an increased risk for DOR in patients aged 35 and older. Obesity (BMI ≥ 30 vs. BMI <25) was associated with lower odds of DOR."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "In comparison with blood type A, blood type O is not associated with an increase in DOR. We found no clinical implications for using blood type as a risk factor for DOR."
          }
        ]
      },
