      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the differences in pressure sensitivity in the cervical musculature including the upper trapezius, sternocleidomastoid, suboccipital, levator scapulae, and anterior scalene muscles between women with migraine and healthy controls."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "Thirty women with migraine and 30 healthy women participated."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Pressure pain thresholds (PPT) were bilaterally assessed over upper trapezius, sternocleidomastoid, suboccipital, levator scapulae, and anterior scalene muscles in a blinded design. Mean values of both sides were pooled for statistical analysis. Comparison between groups was performed by unpaired Student t-test and correlation with headache features with Spearman's correlation test."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Migraine patients exhibited lower PPT in all muscles compared with controls: upper trapezius (P\u2009=\u20090.046); suboccipital (P\u2009<\u20090.001); sternocleidomastoid (P\u2009<\u20090.001); anterior scalene (P\u2009<\u20090.001), and levator scapulae (P\u2009<\u20090001). No associations were observed between the frequency and the intensity of migraine or years with the disease and PPT."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This study showed generalized pressure pain hypersensitivity in the cervical musculature in women with migraine. Our findings provide support for the physical therapy treatment and evaluation of musculoskeletal cervical spine disorders in individuals with migraine and reinforce that all cervical muscles should be evaluated."
          }
        ]
      },
