        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To present a clinical update regarding common distressing lung cancer symptoms and provide an update on management interventions."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "Journal articles, systematic reviews."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Goals of treatment of the patient with lung cancer must include management of the high symptom burden that often accompanies the disease."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR NURSING PRACTICE",
            "content": "Early assessment and management of symptoms improves quality of life. Nurses play a key role in implementing and monitoring these interventions."
          }
        ]
