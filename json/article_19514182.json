      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe the therapeutic effects of the qi-regulating massotherapy for treatment of tonic headache."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "According to different clinical types, 150 cases of tonic headache were treated by the qi-regulating massotherapy. Evaluations were done according to the scores for physiology, behavior, intensity of pain, and the therapeutic effects."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After treatment, the total score in the 150 cases significantly decreased as compared with that before treatment (P<0.01). The total effective rate was 93.3%, and the effective rates for all the types were over 90%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The qi-regulating massotherapy is indicated for all types of tonic headache with obvious therapeutic effects."
        }
      ]},
