      "Abstract": {
        "CopyrightInformation": "© The Author 2014. Published by Oxford University Press on behalf of the Infectious Diseases Society of America. All rights reserved. For Permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Persons with human immunodeficiency virus (HIV) infection are at increased risk of pneumococcal disease. We evaluated the safety and immunogenicity of 13-valent pneumococcal conjugate vaccine (PCV13) in this population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "HIV-infected persons ≥ 18 years of age who were previously vaccinated with ≥ 1 dose of 23-valent pneumococcal polysaccharide vaccine (PPSV23) and had CD4 cell counts ≥ 200 cells/mm(3) and HIV viral loads <50 000 copies/mL were enrolled in this 3-dose PCV13 open-label study."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 329 subjects received ≥ 1 dose, and 279 received 3 doses administered at 6-month intervals. Increases in anticapsular polysaccharide immunoglobulin G concentrations and opsonophagocytic antibody titers were demonstrated 1 month after each of the 3 doses of PCV13. Antibody levels were generally similar after each dose. The responses were similar whether subjects had previously received 1 or ≥ 2 doses of PPSV23. Pain at the injection-site was the most common local reaction. Severe injection site or systemic events were uncommon."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Vaccination with PCV13 induces anticapsular immunoglobulin G and opsonophagocytic antibody responses in HIV-infected adults with prior PPSV23 vaccination and CD4 cell counts ≥ 200 cells/mm(3). The observations support the use of PCV13 in this population."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CLINICAL TRIALS REGISTRATION",
            "content": "NCT00963235."
          }
        ]
      },
