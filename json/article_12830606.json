      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "We report six cases of adrenal cyst, a rare pathologic entity which poses diagnostic problems and therapeutic controversies."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We report six cases of adrenal cysts in 4 female and 2 male patients ages 26 to 68 years. All cases underwent surgical treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pathologic studies showed that all were adrenal cysts without malignancy in any case."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Adrenal cysts are a rare disease of which correct diagnosis is difficult so that many times patients undergo surgery without a proper preoperative diagnosis. There are controversies about the right management of adrenal cysts."
        }
      ]},
