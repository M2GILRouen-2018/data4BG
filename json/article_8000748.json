      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To compare short and mid-term results in the treatment of chronic elbow tendinosis with platelet-rich plasma (PRP) or Nirschl surgical technique."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "A retrospective study was conducted on patients with chronic lateral epicondylitis, treated by Nirschl surgical technique (50 elbows) or PRP (60 elbows). Outcome was evaluated with Visual Analog Score (VAS), Mayo Elbow Scores and grip strength measurements."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "VAS and Mayo Elbow Scores of the PRP group had improved as a mean of 83% (p = 0.0001), 74% (p = 0.0001) over baseline and 34.2 pounds gain of grip strength."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The PRP seems to be better for pain relief and functionality in the short and mid-term periods."
        }
      ]},
