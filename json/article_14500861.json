      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Use of complementary and alternative medicines (CAM) by asthmatic patients is increasing. Data on the prevalence of CAM use in asthma are limited, and the motivation for patients to seek CAM therapy is uncertain."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To determine the prevalence and pattern of use of complementary therapies in adults treated for asthma in primary care in Singapore, and the demographic and clinical factors associated with their use."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cross-sectional study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Five primary care clinics in Singapore."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Adult patients with asthma (n = 802) received a structured questionnaire interview and clinical assessment that included demographic and clinical variables (clinical status, patient's knowledge, self-care and healthcare-seeking behaviour, and spirometric measurements) and detailed information on CAM use in the past one year."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "CAM use in the past year was reported by 27.2%, including animal food products (12.3%), herbs (10.3%), herbal-based proprietary medicines (3.2%), and acupuncture or reflexology (1%). The use of CAM was significantly associated with Chinese ethnicity, longer disease duration, moderate and severe persistent asthma, FEV(1)/FVC < 80%, lack of positive response to treatment in the past year, higher patient knowledge score, and multiple sources of care providers."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "The use of CAM is highly prevalent in Asian patients treated for asthma in primary care, and is associated with cultural and clinical factors reflecting a need to improve care."
        }
      ]},
