      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE OF THE STUDY",
          "content": "The translation/back and translation and validation of the North American Spine Society (NASS) Instrument in German was published recently. This contribution aims at describing the scoring of this questionnaire."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "The scoring is oriented on the recommendations of the developing scientists of the US-American original, with whom we cooperated during the German validation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The scoring algorithm is described, a program for computerized scoring in SPSS was written. Program syntax and the questionnaire are reproduced."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The contribution enables interested researchers to apply and score the NASS questionnaire in German-speaking countries."
        }
      ]},
