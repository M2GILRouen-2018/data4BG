      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND OBJECTIVES",
          "content": "An epidural anesthetic was planned for a 75-year-old man scheduled for elective femoral-popliteal bypass grafting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Severe and persistent back pain and posterior thigh muscle spasm abruptly began 10 minutes after epidural injection of mepivacaine."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Signs of impending or evolving neurologic injury completely resolved shortly thereafter."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The worst case scenarios, epidural hematoma and unintentional epidural injection of an irritant, are discussed along with other differential diagnoses. The literature is reviewed to gain insight into this unusual clinical presentation."
        }
      ]},
