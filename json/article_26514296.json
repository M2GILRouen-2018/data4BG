      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether 3 months of neck-specific exercises (NSEs) could benefit individuals with chronic whiplash-associated disorder (WAD) who were on a waiting list (WL) for treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A prospective, randomized controlled study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Primary health care."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Individuals (N=41; 31 women, 10 men; mean age ± SD, 38±11.2y) with chronic (6-36mo) WAD, grades 2 and 3, were analyzed."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients were randomly assigned to NSEs or no treatment for 3 months."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Neck-specific disability (Neck Disability Index [NDI]), neck pain (visual analog scale), general pain-related disability (Pain Disability Index [PDI]), self-perceived performance ability (Self-Efficacy Scale [SES]), and health-related quality of life (EuroQol 5 dimensions [EQ-5D]) were measured."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "NSEs significantly improved the NDI, SES, and EQ-5D compared with WL (P<.01). There was significant improvement (P<.0001) over time in all outcomes for NSEs, and apart from the PDI, significant worsening (P=.002-.0002) over time for the untreated group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "NSEs were more beneficial than no intervention while on a WL for individuals with chronic WAD."
          }
        ]
      },
