      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine if UlcerCare, a specialised self-securing static magnetic device, can promote the healing of chronic leg ulcers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "This double-blind placebo-controlled pilot study involved 26 patients with chronic leg ulcers, receiving care consistent with RCN guidelines, who were randomly allocated to receive either UlcerCare leg wrap (treatment) or an identical sham non-magnetic device (control). Wounds were assessed for 12 weeks at four weekly intervals using digital photography, Verge Videometer analysis and patient questionnaires to determine changes in ulcer size, level of pain and function."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Statistically significant reductions in ulcer measurement were noted in the treatment group when compared with the placebo group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The results demonstrate a significant healing effect in the treatment group. A larger randomised controlled study is recommended to investigate the effects on ulcer-associated pain and quality of life."
        }
      ]},
