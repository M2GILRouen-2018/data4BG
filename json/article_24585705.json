      "Abstract": {
        "CopyrightInformation": "© 2014 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To investigate whether inulin-type fructan (ITF) prebiotics could counteract the thiazolidinedione (TZD, PPARγ activator) induced-fat mass gain, without affecting its beneficial effect on glucose homeostasis, in high-fat (HF) diet fed mice."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Male C57bl6/J mice were fed a HF diet alone or supplemented with ITF prebiotics (0.2 g/day × mouse) or TZD (30 mg pioglitazone (PIO)/kg body weight × day) or both during 4 weeks. An insulin tolerance test was performed after 3 weeks of treatment."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "As expected, PIO improved glucose homeostasis and increased adiponectinaemia. Furthermore, it induced an over-expression of several PPARγ target genes in white adipose tissues. ITF prebiotics modulated the PIO-induced PPARγ activation in a tissue-dependent manner. The co-treatment with ITF prebiotics and PIO maintained the beneficial impact of TZD on glucose homeostasis and adiponectinaemia. Moreover, the combination of both treatments reduced fat mass accumulation, circulating lipids and hepatic triglyceride content, suggesting an overall improvement of metabolism. Finally, the co-treatment favored induction of white-to-brown fat conversion in subcutaneous adipose tissue, thereby leading to the development of brite adipocytes that could increase the oxidative capacity of the tissue."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "ITF prebiotics decrease adiposity and improve the metabolic response in HF fed mice treated with TZD."
          }
        ]
      },
