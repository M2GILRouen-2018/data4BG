      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Describe blood loss with surgical abortion ≥16weeks of gestation in anticoagulated patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Clinicians involved in a professional listserv (2011-2013) reported cases of abortion ≥16weeks of gestation in anticoagulated women."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "All 7 patients were using or had recently discontinued low molecular weight heparin (LMWH). One patient was reported to have greater than anticipated blood loss for gestational age. No patients required transfusion and no complications were reported."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our limited case series suggests D&E may not always be contraindicated in women with recent or current LMWH use."
          }
        ]
      },
