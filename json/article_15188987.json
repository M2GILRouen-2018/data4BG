      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To evaluate quality of life (QOL) in Indian children with bronchial asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A disease-specific, locally appropriate QOL questionnaire was administered in asthmatic children and compared with FEV1, FVC, PEFR and asthma symptom score, on three occasions."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "QOL score had strong negative correlation with symptom score and weaker positive correlation with pulmonary function tests."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Disease-specific QOL score correlates inversely with symptom score in children with bronchial asthma."
        }
      ]},
