      "Abstract": {
        "CopyrightInformation": "© 2017 American Academy of Neurology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate racial and ethnic differences in the utilization of neurologic care across a wide range of neurologic conditions in the United States."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We analyzed nationally representative data from the 2006-2013 Medical Expenditure Panel Survey (MEPS), including information on demographics, patient-reported health conditions, neurology visit rates, and costs. Using diagnostic codes, we identified persons with any self-identified neurologic disorder except back pain, as well as 5 subgroups (Parkinson disease, multiple sclerosis, headache, cerebrovascular disease, and epilepsy). To assess disparities in neurologic care utilization, we performed logistic regression analyses of outpatient department neurologic care visit rates and expenditures for each racial ethnic group controlling for age, sex, health status, socioeconomic characteristics, and geographic region of care."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of the 279,103 MEPS respondents, 16,936 (6%) self-reported a neurologic condition; 5,890 (2%) received a total of 13,685 outpatient neurology visits. Black participants were nearly 30% less likely to see an outpatient neurologist (odds ratio [OR] 0.72, confidence interval [CI] 0.64-0.81) relative to their white counterparts, even after adjustment for demographic, insurance, and health status differences. Hispanic participants were 40% less likely to see an outpatient neurologist (OR 0.61, CI 0.54-0.69). Among participants with known neurologic conditions, blacks were more likely to be cared for in the emergency department, to have more hospital stays, and to have higher per capita inpatient expenditures than their white counterparts."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our findings highlight racial and ethnic inequalities in the utilization of neurologic care in the United States."
          }
        ]
      },
