      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Chronic pain is a complex, multidimensional phenomenon. Medical intervention has often little effect."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "The case histories of 100 patients evaluated by the multidisciplinary pain clinic team at Haukeland University Hospital in Bergen, Norway were examined."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "44% of the patients reported serious trauma long before the development of pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "INTERPRETATION",
          "content": "Chronification of pain appears to be related to childhood trauma."
        }
      ]},
