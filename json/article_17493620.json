      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a rare complication of GnRH agonist therapy for intestinal endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 45-year-old nulliparous Japanese woman with catamenial digestive symptoms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "GnRH agonist therapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Acute abdomenal crisis with free air in the abdominal X-ray."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "An emergency laparotomy showed both an ileal constriction and perforation. An ileocecal enterectomy with an end-to-end anastomosis was performed. A pathological examination of the ileum revealed ileal endometriosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Flare-up of intestinal endometriosis induced by GnRH agonist has the potential to lead to intestinal perforation. Careful diagnosis and treatment are necessary for cyclic and periodic gastrointestinal manifestation."
        }
      ]},
