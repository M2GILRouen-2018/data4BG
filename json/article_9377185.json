      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of this study was to determine whether lavaging of the superior joint space with injection of sodium hyaluronate can be used as an alternative treatment method for nonreducing disk displacement of the temporomandibular joint."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "In 26 patients with nonreducing disk displacement of the temporomandibular joint, the superior joint space was rinsed with 1% xylocaine, and then sodium hyaluronate was injected there (experimental group). As a control group, 50 patients with nonreducing disk displacement of the temporomandibular joint who received no treatment were used (control group). The frequency of the patients with successful clinical resolution was evaluated in each group during 6 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The frequency of the patients with successful clinical resolution in the experimental group (73.1%) was significantly higher than that in the control group (36.0%) at the 6-month follow-up (chi-squared test, p < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This therapy appears to represent an alternative treatment method for nonreducing disk displacement of the temporomandibular joint."
        }
      ]},
