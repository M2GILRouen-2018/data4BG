      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© 2012 The Authors Acta Obstetricia et Gynecologica Scandinavica© 2012 Nordic Federation of Societies of Obstetrics and Gynecology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of this study was to investigate whether a single injection of bupivacaine with adrenaline close to the fascia could decrease opiate consumption and pain in patients undergoing cesarean section in spinal anesthesia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized double-blind controlled study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTINGS",
            "content": "Karolinska University Hospital, Huddinge, Sweden."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "POPULATION",
            "content": "260 women scheduled for elective cesarean section were enrolled in the study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The treatment group (n= 130) received 40 mL bupivacaine (2.5 mg/mL) with adrenaline (5 μg/mL) (Marcain® adrenalin) and the control group (n= 130) received 40 mL saline solution (0.9%), which was, in both groups, injected close to the fascia before closure of the wound."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Morphine consumption and mean resting pain intensity numerical rating scale at 12 and 24 hours were the primary outcome variables. Other assessments for pain as well as mobilization parameters were considered secondary."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Morphine requirements were significantly less in the bupivacaine group, 19.0 mg/woman, compared with 24.0 mg/woman in the placebo group, during the first 12 postoperative hours. During this time period there was also a trend towards a difference between groups in mean pain intensity, but significant only during the first six hours. Over the whole first postoperative 24 hours, there were no differences in either morphine requirement or pain intensity between groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A single injection of bupivacaine with adrenaline in the surgical wound decreases the need for morphine requirements for the first 12 postoperative hours and contributes to safe and effective pain management in women undergoing cesarean section."
          }
        ]
      },
