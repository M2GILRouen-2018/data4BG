      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the effect of an antiviral compound, valacyclovir, on pain and tenderness in patients with the fibromyalgia (FM) syndrome."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Sixty patients were randomized into a double blind, placebo controlled 6 week trial. Primary outcome was pain intensity change (on visual analog scale). Secondary outcome measures were tender points (myalgic score) and Fibromyalgia Impact Questionnaire (FIQ)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Fifty-two patients completed the study. The numbers of dropouts due to adverse events were equal in valacyclovir (2) and placebo (2) groups. The effect of valacyclovir on pain and tenderness and FIQ did not differ from placebo."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Valacyclovir cannot be recommended as a therapy for FM at this point."
        }
      ]},
