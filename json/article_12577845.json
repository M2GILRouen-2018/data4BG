      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To study the cardiorespiratory system, central and intracardiac hemodynamics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "274 patients with bronchial asthma (BA), including 117 patients with this condition concurrent with hypertensive disease (HD) during traditional medical treatment were examined."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The impact of concomitant HD on the pattern of performance of the cardiovascular system and the development of the cardiac structure in these patients was evaluated."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In patient with BA concurrent with HD, external respiratory dysfunction diastolic dysfunction of both ventricle deteriorate, specific peripheral resistance enhances."
        }
      ]},
