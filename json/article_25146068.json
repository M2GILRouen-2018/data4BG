      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This case presents a rare cause of lumbar abscess."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A 51-year-old male patient was admitted to the emergency department with a complaint of lumbar pain. Spinal magnetic resonance imaging revealed a lumbar abscess."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The abscess was treated with drainage of the abscess and antibiotic."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Scarification wet cupping therapy should be taken into consideration as a rare cause of lumbar abscesses in patients who present with skin findings indicative of scarification. Scarification wet cupping therapy practitioners must pay attention to hygienic measures."
          }
        ]
      },
