      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the currently perceived status of thermography in the diagnosis of musculoskeletal disorders."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Medical and legal journals published from 1956 onwards; report of the United States Office of Health Technology Assessment and personal communication with the author of that report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY SELECTION",
          "content": "Confined to application of thermography to musculoskeletal and neurological medicine."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA EXTRACTION AND SYNTHESIS",
          "content": "Weighted towards prospective and controlled studies."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Little evidence exists of any application of thermography in which it is unequivocally superior to conventional diagnostic imaging methods."
        }
      ]},
