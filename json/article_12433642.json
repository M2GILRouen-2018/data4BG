      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the differential diagnosis of early repolarization syndrome (ERS) in patients with ST-segment elevation and its clinical significance."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Five patients with ESR were clinically observed and followed up after discharge from hospital."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All the patients complained of chest distress or chest pain, accompanied by ST-segment elevation in the precordial electrocardiogram leads."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "ESR is often misdiagnosed as acute myocardial infarction, acute coronary syndrome, Brugada syndrome or other diseases that may involve elevated ST-segment, and careful examination of the ECGs, echocardiogram, troponin I and the patients' history of heart diseases may help differentiate ESR from these diseases."
        }
      ]},
