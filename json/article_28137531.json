      "Abstract": {
        "CopyrightInformation": "Copyright © 2016. Published by Elsevier Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Previous studies have shown that exercise training in patients with end-stage renal disease could improve their physical functioning and quality of life. Nevertheless, few studies have evaluated the effects of Tai Chi exercise in patients on hemodialysis."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the effects of a Tai Chi exercise intervention on the quality of life and physical functioning in end-stage renal disease patients on hemodialysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A pre-post experimental design."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Patients, aged 20 years or older, on hemodialysis recruited from the hemodialysis unit at a medical center in central Taiwan were assigned, based on their own preference, to either a control group (n=25) or an intervention group (n=21)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "A weekly one-hour short-form Yang style Tai Chi session for a total of 12 weeks."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Physical functioning and Kidney Disease Quality of Life (KDQOL) at the baseline and at the end of the intervention."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The least square means of repetition of sit-to-stand cycles in one minute (STS-60), 6-min walk test, and gait speed test were significantly improved in the intervention group. In addition, the least square means of the five different dimensions of the KDQOL were all significantly higher in the intervention group, except the SF-12 physical health score."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Improvements in the kidney disease quality of life and physical functioning were observed in Taiwanese patients on hemodialysis with a 12-week Tai Chi exercise intervention."
          }
        ]
      },
