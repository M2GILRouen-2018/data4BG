      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "ETJECTIVE",
          "content": "To understand the care management strategies used by nurses in the governance of nursing practice in a maternity ward."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Qualitative study based on grounded theory conducted with 27 participants, partitioned into four sample groups. The data were collected through semi-structured interviews and analyzed through open, axial, and selective coding."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "The care management strategies used by the nurses were: planning professional practice, leading the nursing team, search for scientific knowledge, and training inthe best practices in obstetric care."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Associating care management with nursing governance can foster better care outcomes and strengthen nursing autonomy when coordinating nursing work in maternity wards."
        }
      ]},
