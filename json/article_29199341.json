      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To investigate the expression of receptor activator of nuclear factor-κB ligand (RANKL) in keratocystic odontogenic tumor (KCOT) before and after decompression."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Twenty two pairs of paraffin-embeded tissue specimens of KCOT were collected and subjected to immunohistochemical analysis of RANKL.The data were analyzed with SPSS17.0 software package for paired t test."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "RANKL positive cells were observed in the preoperative KCOT epithelium. The expression of RANKL was down-regulated after decompression(P<0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Decrease of RANKL expression after decompression may facilitate the lining epithelium of KCOT transforming to normal oral mucosal epithelium."
        }
      ]},
