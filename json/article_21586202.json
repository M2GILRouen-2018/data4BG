      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 The Authors. Published by Elsevier Ltd.. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Aortitis often occurs in patients with systemic vasculitis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PRESENTATION OF CASE",
            "content": "We reported a 73 year old man with giant cell arteritis who was presented with abdominal pain and weight loss."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Aortitis was diagnosed on PET-CT scan performed because initial investigations raised the possibility of pancreatic pathology."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This case highlights the utility of PET-CT in the diagnosis of abdominal aortitis and the need to consider aortitis as a differential in patients with abdominal pain with a history of vasculitis."
          }
        ]
      },
