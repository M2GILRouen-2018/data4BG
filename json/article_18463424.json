      "Abstract": {
        "CopyrightInformation": "(c) 2008 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To determine the efficacy of topical Visthesia drops and viscoelastic in reducing pain during the early postoperative period following laser-assisted subepithelial keratectomy (LASEK)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In a prospective randomized double-blind study, LASEK was performed on both eyes of patients using the Technolas 217Z Laser (Bausch & Lomb). Visthesia was placed in one eye and placebo (Healon) in the fellow eye, following insertion of a bandage contact lens on completion of surgery. Pain experienced on the evening of surgery and the following morning were scored using a visual analogue scale."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "18 patients of mean age 27.3 years were examined. Mean refractive spherical equivalent was not statistically different between both groups (p = 0.6). No statistically significant difference (p = 0.87) in pain was detected between both groups on the evening of surgery or the following morning (p = 0.12)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Visthesia, applied topically on completion of LASEK, did not have a significant effect on pain during the early postoperative period compared with placebo."
          }
        ]
      },
