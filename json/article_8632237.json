      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This article describes the results of modification of the condylotomy procedure for treating painful internal derangements of the temporomandibular joint."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Data on postoperative disc position, joint space, and pain were evaluated in patients who underwent either the original modified condylotomy or the newly modified procedure."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Less anterior and inferior sag of the condyle was produced by the new technique. Pain relief and disc reduction were about the same with both procedures."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The new modifications make the operation quicker and easier, while producing outcomes similar to those obtained with the original modified procedure."
        }
      ]},
