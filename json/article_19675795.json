      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright® by the International Brazilian Journal of Urology.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "This study compared percutaneous tibial nerve stimulation (PTNS) versus electrical stimulation with pelvic floor muscle training (ES + PFMT) in women with overactive bladder syndrome (OAB)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "60 women with OAB were enrolled. Patients were randomized into two groups. In group A, women underwent ES with PFMT, in group B women underwent PTNS."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A statistically significant reduction in the number of daily micturitions, episodes of nocturia and urge incontinence was found in the two groups but the difference was more substantial in women treated with PTNS; voided volume increased in both groups. Quality of life improved in both groups, whereas patient perception of urgency improved only in women treated with PTNS. Global impression of improvement revealed a greater satisfaction in patients treated with PTNS."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This study demonstrates the effectiveness of PTNS and ES with PFMT in women with OAB, but greater improvements were found with PTNS."
          }
        ]
      },
