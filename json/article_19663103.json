      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the analgesic and anti-inflammatory effects of lappaconitine gelata (LA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The writhing response induced by acetic acid, the pain response induced by formaldehyde and hot plate method in the mouse, and the paw edema induced by egg albumen in the rat and the ear edema induced by xylene in the mouse were used for investigation on the analgesic and anti-inflammatory effects of LA."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The writhing response induced by acetic acid, the pain response induced by formaldehyde and hot plate methods was significantly inhibited by LA. In addition, the paw edema induced by egg albumen in the rat and the ear edema induced by xylene in the mouse were all significantly suppressed by LA."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "LA has the analgesic and anti-inflammatory effects."
        }
      ]},
