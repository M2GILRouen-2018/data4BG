      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the predictive value of the 12-item short form (SF-12) for long-term sickness absence (LTSA) because of mental, musculoskeletal, and other somatic disorders."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In this cohort study with 2-year follow-up of 1381 nurses, baseline SF-12 scores were analyzed against registered mental, musculoskeletal, and other somatic LTSA during follow-up by logistic regression models."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The SF-12 dimensions, general health, vitality, emotional role limitations, mental health, and social functioning, predicted mental LTSA. Physical functioning, bodily pain, and vitality predicted musculoskeletal LTSA, and physical role limitations, bodily pain, general health, and social functioning predicted other somatic LTSA. Positive predictive values were low, and negative predictive values were high."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Different SF-12 dimensions predicted mental, musculoskeletal, and other somatic LTSA but did not identify nurses at high risk of mental, musculoskeletal, and other somatic LTSA."
        }
      ]},
