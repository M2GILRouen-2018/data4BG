      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "A number of studies reported on associations of single nucleotide polymorphisms (SNPs) present in chromosome 9p21 with early-onset coronary artery disease (CAD). The present study was then undertaken to perform a meta-analysis of all the results published to date."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "All studies of the 9p21 association with early-onset CAD that were published between 2007 and 2012 were retrieved from the PubMed database. RevMan 5.0 software was used to perform meta-analysis of the data that fulfilled the criteria for our meta-analysis. The effect size of four SNPs in the 9p21 region on early-onset CAD risk was assessed based on the odds ratios (ORs) with calculation of 95% confidence interval (CI)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 7123 subjects from 7 case-control studies were genotyped. Meta-analysis demonstrated disease association for rs2383207 (OR=0.79, 95% CI 0.71-0.88, P<0.0001), rs2383206 (OR=1.17, 95% CI 1.10-1.25, P<0.00001), rs10757278 (OR=1.28, 95% CI 1.15-1.42, P<0.00001), and rs10757274 (OR=1.17, 95% CI 1.08-1.33, P=0.02)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Genetic variation in the chromosome 9p21 region may contribute to the etiology of early-onset CAD although their effect size is rather small."
          }
        ]
      },
