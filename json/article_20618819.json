      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of improved pain control and function in a patient with chronic migraine after treatment with auriculotemporal nerve stimulation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The patient is a 52-year-old woman with refractory pain in the bilateral temporal distribution and marked phonophobia as a result of chronic migraine."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After a successful trial period, the patient underwent implantation of bilateral peripheral nerve stimulators targeting the auriculotemporal nerves. At 16 months of follow up, her average pain intensity declined from 8-9/10 on the numeric rating scale to 5/10. Her function improved as assessed by the Migraine Disability Assessment, from total disability (grade IV) to mild disability (grade II). Her phonophobia became far less debilitating."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Auriculotemporal nerve stimulation may be useful tool in the treatment of refractory pain in the temporal distribution due to chronic migraine."
        }
      ]},
