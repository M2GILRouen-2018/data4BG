      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To introduce and evaluate an alternative technique for accessing the lumbar facet joints. This technique uses an oblique approach to enter the facet joint without the need to rotate the patient towards the beam."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS AND MATERIAL",
          "content": "The proposed technique was employed in 23 consecutive patients (50 joints) with diagnosed or suspected facet joint syndrome. We recorded the success rate, the time spent to complete the procedure, and any complications arisen."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The overall success rate was 84% and the average time spent for the procedure was 4.8 min. No complications were encountered."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Due to its inherent simplicity the proposed technique is easily tolerated by the patient, has a high success rate and can be performed quickly without complications."
        }
      ]},
