      "Abstract": {
        "CopyrightInformation": "© 2013.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Self-administered epinephrine is the primary out-of-hospital treatment of anaphylaxis. Intramuscular injection of epinephrine results in higher peak plasma concentration than subcutaneous injection. With the prevalence of obesity, autoinjectors may not have an adequate needle length for intramuscular injection."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To measure muscle depth and evaluate predictors of autoinjector needle length inadequacy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We performed a prospective cross-sectional study of a convenience sample of low acuity emergency department patients aged 18 to 55 years. We recorded demographic data, measured thigh circumference, and calculated body mass index (BMI). Using ultrasound, we took depth-to-muscle measurements of the vastus lateralus in a standing position, with and without gentle pressure to simulate muscle compression that occurs with correct autoinjector use. We conducted univariate analyses using χ(2) and t tests with P ≤ .05 and 95% confidence intervals. We considered the patient a potential \"failure\" risk if his/her muscle depth exceeded 15.9 mm (longest available epinephrine autoinjectors needle)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We enrolled 120 subjects with a mean BMI of 29.2 kg/m(2). Thirty-one percent (31%) of our sample were found to be failure risks (36/116; confidence interval, 22.6%-39.5%). Women were 6.4 times more likely than men to be a failure risk (54.4% vs 5% for men failure rate; P < .001). Failures were more likely to be shorter, have a higher BMI, and have larger thigh circumference (P < .001). We did not find any statistical difference in muscle depth for race, age, or weight."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The current epinephrine autoinjector needle length is inadequate for intramuscular injection, especially among women."
          }
        ]
      },
