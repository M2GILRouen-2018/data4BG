      "Abstract": {
        "CopyrightInformation": "Copyright © 2017. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To identify the predictive factors of anxiety and depression in patients with acute coronary syndrome."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Cross-sectional and retrospective study conducted with 120 patients hospitalized with acute coronary syndrome. Factors interfering with anxiety and depression were assessed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Anxiety was related to sex, stress, years of education, and depression, while depression was related to sex, diabetes mellitus, obesity, years of education, and trait-anxiety."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Obesity and anxiety were considered predictive factors for depression, while depression and fewer years of education were considered predictive factors for anxiety."
          }
        ]
      },
