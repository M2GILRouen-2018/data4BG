      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case description."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe a treatable cause of scrotal pain associated with lumbar disc herniation"
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Scrotal pain due to intraspinal compression of a sacral nerve root caused by lumbar disc herniation is probably very rare, as the literature contains only sporadic single case descriptions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Two patients with isolated scrotal pain were analyzed. In both patients, a lumbar disc herniation was found. Lumbar discectomy was performed in both patients."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Complete and persisting relief of the scrotal pain was obtained after lumbar discectomy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Despite the absence of other symptoms or signs suggestive of nerve root involvement, lumbar disc herniation with intraspinal compression of a sacral nerve root seemed the most probable cause of the scrotal pain."
        }
      ]},
