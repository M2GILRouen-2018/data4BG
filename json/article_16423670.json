      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "We hypothesized that altered myocardial perfusion distribution patterns could be seen with coronary distal emboli of different particle sizes using myocardial contrast echocardiography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In 16 open-chest anesthetized dogs, microsphere suspensions of 9 or 500 microm in diameter were injected into the left anterior descending coronary artery until the mean left anterior descending coronary artery flow rate was reduced to less than 30% of baseline flow. During baseline conditions and after maximal embolization, real-time myocardial contrast echocardiography was performed by intravenous infusion of an echocontrast agent."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In animals infused with 9-microm microspheres, a transmural perfusion defect was seen at the time of maximal embolization. In contrast, in animals infused with 500-microm microspheres, a subendocardial perfusion defect was observed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The particle size of coronary distal emboli affects myocardial perfusion distribution."
        }
      ]},
