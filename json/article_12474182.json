      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright 2002 by the American Congress of Rehabilitation Medicine and the American Academy of Physical Medicine and Rehabilitation",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate whether athletes with a history of low back pain (LBP) would, on average, perform slower on a timed 20-m shuttle run as compared with a normal athletic population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A timed shuttle run to evaluate residual functional limitations in college athletes with resolved LBP."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "National College Athletic Association (NCAA) division I college."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "NCAA division I athletes (161 men, 50 women)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "A timed 20-m shuttle run."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE",
            "content": "Each athlete was timed in a divided 20 m (66 ft) run in which 2 taped lines were positioned 6.7 m (22 ft) apart."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 211 athletes evaluated, 27 had been treated for LBP during the previous year. Currently asymptomatic athletes with a recent history of LBP were slower (6.3s vs 5.8s) during performance of the timed 20-m shuttle run than athletes without LBP (P=.0002)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Athletes with resolved LBP were slower than a matched group of normal athletes without LBP in the timed 20-m shuttle run. Further research is needed to support these findings and to understand fully the influence of the kinetic chain and the effects of both gender and sport on the observed findings."
          }
        ]
      },
