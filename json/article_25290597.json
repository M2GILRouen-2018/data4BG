      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To examine potential mediators of adolescent girls' dietary behavior change in the Nutrition and Enjoyable Activity for Teen Girls (NEAT Girls) intervention for obesity prevention."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants were 294 adolescent girls attending 12 secondary schools located in low-income communities of New South Wales, Australia. Hypothesized social cognitive mediators of dietary behavior change were assessed using valid and reliable scales."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The intervention effects on dietary outcomes and hypothesized mediators were not statistically significant. However, changes in hypothesized mediators were associated with changes in key dietary behaviors."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Continued research is needed to examine effective strategies for improving dietary outcomes in youth, and to explore alternative theoretical mechanisms of dietary behavior change."
        }
      ]},
