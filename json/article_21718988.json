      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To report a patient with Mayer-Rokitansky-Kuster-Hauser syndrome with functional endometrium treated with preoperative continuous combined low-dose monophasic oral contraceptives."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case report."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "A 12-year-old nulligravid adolescent girl."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Preoperative continuous combined low-dose monophasic oral contraceptives for 7 months, and laparoscopic resection of the rudimentary uterus and uterine horns with unilateral salpingo-oophorectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Relief of pain after hormonal treatment and the operative procedure."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Successful preoperative treatment of endometriosis and pain before definitive diagnosis and removal of müllerian remnants in a patient with Mayer-Rokitansky-Kuster-Hauser syndrome."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Patients with obstructive müllerian malformations with functional endometrium can be preoperatively managed with continuous combined low-dose monophasic oral contraceptives to control pain and treat endometriosis. This may permit a delay in surgical intervention to facilitate other investigations and to allow thorough counselling of the patient and her family about the implications of the diagnosis."
          }
        ]
      },
