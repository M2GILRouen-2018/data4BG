      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Hanley & Belfus. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Clinical measurements."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "Perform the translation and cross-cultural adaptation of the Patient Rated Wrist Evaluation (PRWE) into a Brazilian version (PRWE-BR), and assess its internal consistency, test-retest reliability and construct validity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "PRWE-BR was developed using standardized guidelines. Sixty-one patients with different wrist injuries were recruited. They were submitted to two assessments, 2-7 days apart. Reliability was measured by internal consistency (Cronbach's alpha) and test-retest reliability (Intraclass Correlation Coefficient). Construct validity was determined via hypothesis testing (Spearman's correlation) of correlations with subscales of SF-36 and DASH."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "PRWE-BR and its subscales achieved high internal consistency (Cronbach's alpha ≥ 0.85) and excellent test-retest reliability (ICC ≥ 0.90). Construct validity was established by confirmation of 85.7% of our previously formulated hypotheses."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "PRWE-BR is a valid and reliable tool for the assessment of pain and dysfunction in Brazilian patients with injuries involving the wrist joint."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "N/A."
          }
        ]
      },
