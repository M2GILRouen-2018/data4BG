      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The purpose of this systematic literature review was to summarize information on the efficacy of percutaneous vertebral augmentation (PVA) and the incorporation of physical therapy intervention following PVA for vertebral compression fractures (VCF)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Literature searches were completed using the Cochrane Library: Cochrane Database of Systematic Reviews (Cochrane Reviews); Agency for Healthcare Research and Quality (AHRQ): National Guideline Clearinghouse; Physiotherapy Evidence Database (PEDro); Medline; and Cumulative Index of Nursing and Allied Health Literature (CINAHL) through August 2005."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Seventeen relevant studies were identified. They reported favorable outcomes (eg, earlier mobility, decreased pain, and improved spinal posture) after PVA. No study addressed physical therapy intervention after PVA."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "PVA appears to be an effective treatment option for individuals with VCF. However, research dealing with physical therapy after PVA is needed."
        }
      ]},
