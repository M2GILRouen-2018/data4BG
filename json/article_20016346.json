      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This correlational study examined the relationship between patient trust of nurses, level of postoperative pain, and discharge functional outcome following total knee arthroplasty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "The study included 68 participants."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants completed the Trust subscale of the Patient's Opinion of Nursing Care to assess trust of nursing staff. Numeric Analog Scale pain scores measured level of pain. Functional outcome was obtained from knee flexion gain scores."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Average trust score was 47.5, average Numeric Analog Scale pain score was 5.0, and average gain score was 26.8. Analysis suggested no statistically significant relationships between patient trust of staff nurses, level of postoperative pain, and discharge functional outcome."
        }
      ]},
