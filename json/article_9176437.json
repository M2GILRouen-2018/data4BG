      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the efficacy, safety, and effect on bone mineral density of a 3-month course of retreatment with intranasal nafarelin acetate for recurrent symptoms of endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Multicenter, open-label, nonrandomized clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Eleven hospital-based and private practices."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Thirty-six women with endometriosis symptoms recurring after 3 or 6 months of treatment with nafarelin."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Nasal nafarelin 200 micrograms twice daily for 3 months."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Assessments for dysmenorrhea, dyspareunia, pelvic pain, tenderness, and induration. Measurement of bone mineral density of the lumbar spine."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Improvements from admission to the end of retreatment were significant for dysmenorrhea, pelvic pain, tenderness, induration, and dyspareunia. Three months after retreatment ended, mean symptom scores for dysmenorrhea and pelvic tenderness, although worse than at the end of retreatment, were still significantly better than scores at admission. Mean bone mineral density 3 months after retreatment was 0.56% lower than before retreatment and 1.94% lower than before initial treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Three-month nafarelin retreatment for recurrent endometriosis symptoms was effective and safe."
        }
      ]},
