      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the possible association between the codon 72 polymorphism (Pro72Arg, rs1042522) of the tumor suppressor gene (TP53) and the presence of coronary artery disease (CAD) in Chilean subjects."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS AND METHODS",
            "content": "A total of 209 unrelated patients with a diagnosis of CAD confirmed by angiography (33-74 years old) and 216 healthy controls (30-68 years old) were included in this study. The Pro72Arg polymorphism of the TP53 gene was evaluated by PCR-RFLP."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The genotype distribution for the Pro72Arg variant of the TP53 gene in CAD patients (PP: n = 13, 6.2%; PR: n = 61, 29.4%; RR: n = 135, 64.6%) and controls (PP: n = 18, 8.3%; PR: n = 94, 43.5%; RR: n = 104, 48.1%) was significantly different (p = 0.003). Similarly, the allelic frequency was also different (p = 0.003). The odds ratio for CAD related to the 72Arg allele was 2.0 (95% CI = 1.33-2.90), confirming the presence of an association."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These findings suggest that the Pro72Arg polymorphism of the TP53 gene is associated with CAD in Chilean individuals."
          }
        ]
      },
