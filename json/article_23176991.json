      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Editora Ltda. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVES",
            "content": "Low back pain is a common syndrome that causes disability and absence from work. Although there are several causes, the most common type of back pain is nonspecific. Exercises are often used to treat back pain, but there is controversy regarding its effectiveness. The aim of this paper is to review exercises for nonspecific low back pain treatment."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CONTENT",
            "content": "This paper provides a definition and classification of back pain. Incidence and mechanisms of nonspecific low back pain and exercises used for its treatment are hereby reported."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The most effective types of exercise therapy for chronic or acute low back pain are still controversial; however, exercise therapy is probably the most widely used conservative treatment throughout the world."
          }
        ]
      },
