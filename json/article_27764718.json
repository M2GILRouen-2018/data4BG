      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "Review the MRI appearance of different bursae located throughout the pelvis, including the pertinent osseous and musculotendinous anatomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "Bursae are potential spaces that reduce friction between opposed moving components which can become inflamed, clinically mimicking internal derangement."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "This series illustrates the most common as well as lesser-known pelvic bursae. Common causes of bursitis including overuse, trauma, and infection are presented."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Multiple bursae are located throughout the pelvis. It is important for radiologists to recognize bursitis as a potential etiology of pain and be familiar with their anatomical locations in order to guide appropriate management."
          }
        ]
      },
