      "Abstract": {
        "CopyrightInformation": "© 2014 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate behavioral inhibition in individuals with binge eating disorder (BED) compared with overweight and obese individuals without BED (No-BED)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Participants with BED (n = 31) and the weight-matched No-BED group (n = 29) completed an inhibitory control task (stop-signal task, SST) with food and neutral stimuli."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The BED group needed more time to stop an ongoing response, as indicated by increased stop signal reaction time (SSRT) relative to the No-BED group. Additionally, compared with the No-BED group, the BED group displayed more difficulty inhibiting responses elicited by food stimuli. The deficits in behavioral response inhibition were also found to be related to the severity of reported symptoms."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "There is a general deficit in late stage behavioral inhibition in BED, and this may be particularly pronounced in the context of food stimuli."
          }
        ]
      },
