      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS AND OBJECTIVES",
          "content": "We evaluated the incidence of coronary artery disease (CAD) in Sulfur mustard (SM) exposed veterans. We also evaluated the relationship between exposure to SM and angiography findings and compared angiography findings of SM exposed individuals with unexposed ones after two decades from the time of exposure to SM."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "A case-control study was conducted on 200 consecutive patients (100 SM exposed vs. 100 unexposed) undergoing angiographic assessments due to CAD."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The coronary angiography findings between two groups were significantly different ( P < 0.001). Ninety two (92%) patients in SM exposed group and 82 (82%) in unexposed group had abnormal findings in their coronary arteries ( P = 0.031)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The incidence of CAD and angiographic changes were significantly increased with exposure to SM. Further studies on cardiovascular effects of SM are needed."
        }
      ]},
