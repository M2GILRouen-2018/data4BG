      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "QUESTION",
          "content": "In light of the recent evidence of adverse events in infants whose mothers use codeine medication, we have been struggling with the issue of how to manage codeine analgesia in our postpartum patients. What are some guidelines for the safe use of codeine during breastfeeding?"
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "ANSWER",
          "content": "Motherisk has summarized recent scientific evidence into suggested guidelines for the safe use of codeine during breastfeeding."
        }
      ]},
