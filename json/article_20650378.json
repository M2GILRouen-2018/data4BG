      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright 2010 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To compare the efficacy of 50 mug and 25 mug doses of intrathecal morphine on postoperative pain in patients undergoing transurethral resection of the prostate (TURP) with low-dose bupivacaine."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized, double-blinded study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Konya Hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "70 ASA physical status I, II, and III patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients were randomized to two groups: Group A patients received 5 mg of 0.5% hyperbaric bupivacaine (one mL) and 50 mug of morphine (0.5 mL). Group B patients received 5 mg of 0.5% hyperbaric bupivacaine (one mL) and 25 mug of morphine (0.5 mL)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Postoperative pain scores, patient and surgeon satisfaction, and side effects such as emesis, pruritus, and respiratory depression, were recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Postoperative pain characteristics were similar between the two groups. Frequency of emesis was similar between the groups, while pruritus was significantly higher in Group A. No antipruritic medication was required in any patient. Patient and surgeon satisfaction was evaluated as good or excellent in both groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Intrathecal morphine at a dose of 25 mug provides similar postoperative analgesia and less pruritus than the 50 mug dose in patients undergoing TURP."
          }
        ]
      },
