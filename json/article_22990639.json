      "Language": "por",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To analyze the level of physical activity (kcal/week) needed to prevent excess visceral fat in postmenopausal women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS AND METHODS",
          "content": "The sample included 239 women with a mean age of 57.2 years. Visceral fat area (VFA) was measured by octopolar bioelectrical impedance, and physical activity, by the long version IPAQ. ROC Curves (Receiver Operating Characteristic) were drawn, and a 95% confidence interval was used."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The areas under the ROC curve for moderate physical activity and walk proved to be significant. Weekly expenditure of 1,601 kcal in walking, or 2,283 kcal in moderate physical activity were identified as good cutoff values to prevent excess VFA."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Mild to moderate physical activity, with a caloric expenditure between 1,601 and 2,283 kcal/week, prevents excess central adiposity in postmenopausal women."
        }
      ]},
