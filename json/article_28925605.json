      "Abstract": {
        "CopyrightInformation": "© 2017 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Testing of pharmaceutical products for reproductive toxicity in male laboratory animals is required for registration."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We evaluated whether the results of studies showing male reproductive toxicity in experimental animals was predictive of reproductive effects in men participating in clinical trials. We surveyed companies for information on pharmaceutical candidates that had shown male reproductive toxicity in nonclinical studies for which there was information on male reproductive effects in clinical trials."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Among 12 pharmaceutical candidates submitted by five companies, only one compound that had shown male reproductive toxicity in experimental animals also demonstrated reproductive toxicity in men."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "In this sample of compounds, nonclinical studies appeared to over-predict reproductive toxicity in men. We identified possible reasons for the apparent lack of predictivity of the experimental animal studies. Birth Defects Research, 2017.© 2017 Wiley Periodicals, Inc."
          }
        ]
      },
