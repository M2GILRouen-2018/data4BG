      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "To determine effects on short term growth and collagen turnover of adding formoterol (Eformoterol) to half the glucocorticoid dose in children with asthma, treated with inhaled budesonide (Pulmicort Turbuhaler)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A randomised double blind, placebo controlled crossover study with two six-week periods."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient clinic in secondary referral centre."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "A total of 27 prepubertal children aged 6-13 years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Formoterol 12 microg and dry powder budesonide 100 microg twice daily in one period; placebo and dry powder budesonide 200 microg twice daily in the other."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Primary outcome measures were lower leg growth rate, and serum and urine markers of type I and type III collagen turnover. Secondary outcome measures were inflammation markers in serum, and parameters of asthma control."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "During budesonide 200 microg twice daily treatment, mean lower leg growth rate was 0.14 mm/week (p = 0.02) lower than during the formoterol and budesonide period. Similar statistically significant effects on markers of collagen turnover were found, whereas inflammation markers and asthma control did not vary statistically significantly between the two periods."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In children treated with inhaled glucocorticoids, halving the dose and adding formoterol is associated with faster short term growth and an increase in markers of collagen turnover, with no loss of asthma control."
        }
      ]},
