      "Abstract": {
        "CopyrightInformation": "Copyright © 2017. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "This review aims to highlight the clinical complexity of chronic subdural hematoma (cSDH) while presenting a brief historical discussion of cSDH."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A thorough literature search of published English-language papers was performed in PubMed, Ovid, and Cochrane databases."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "cSDH affects 1-5.3 per 100,000 individuals annually, with the incidence expected to rise as the U.S. population ages. The symptoms of cSDH are often nonspecific, with headaches being the most common complaint. Other symptoms include weakness, balance and gait problems, and memory problems."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A variety of clinical factors must be taken into account in the treatment of cSDH, and the multifaceted treatment paradigms continue to evolve."
          }
        ]
      },
