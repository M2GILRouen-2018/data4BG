      "Abstract": {
        "CopyrightInformation": "Published by the BMJ Publishing Group Limited. For permission to use (where not already granted under a licence) please go to http://www.bmj.com/company/products-services/rights-and-licensing/.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the effect of secukinumab on patient-reported outcomes (PROs) in subjects with active psoriatic arthritis (PsA) in the FUTURE 1 study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Subjects were randomised 1:1:1 to receive intravenous (i.v.) secukinumab 10\u2005mg/kg at weeks 0, 2 and 4 followed by subcutaneous secukinumab 150 or 75\u2005mg every 4\u2005weeks or matching placebo until week 24."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "At week 24, subjects receiving secukinumab i.v.→150\u2005mg or i.v.→75\u2005mg reported greater least squares mean changes from baseline than those receiving placebo in patient global assessment of disease activity (-20.6 and -20.0 vs -7.4, respectively), patient assessment of pain (-20.8 and -20.4 vs -6.7), psoriatic arthritis quality of life (-3.5 and -3.2 vs -0.4), Dermatology Life Quality Index (-8.8 and -7.9 vs 0.7); p<0.0001 vs placebo for both secukinumab groups for above PROs and Functional Assessment of Chronic Illness Therapy-Fatigue (6.74 (p<0.05 vs placebo) and 6.03 vs 4.00); all of which well exceeded minimum clinically important differences."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In subjects with PsA, secukinumab treatment resulted in clinically meaningful improvements in global disease activity, pain, generic and disease-specific measures of health-related quality of life and fatigue."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "TRIAL REGISTRATION NUMBER",
            "content": "NCT01392326; Results."
          }
        ]
      },
