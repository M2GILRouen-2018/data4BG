      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe the therapeutic effect of otopoint-pellet pressure (OPP) combined with patient controlled intravenous analgesia (PCIA) for lower-limb surgery of orthopedics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 120 lower-limb orthopedic operation patients were randomized into OPP + PCIA group (n = 60) and PCIA group (n = 60). The patient's pain degree was evaluated by visual analogue score (VAS)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In comparison with the simple PCIA group, VAS levels were significantly lower in the OPP + PCIA group than in the PCIA group 2, 6, 24 and 48 h after operation. The number of patients with post-operative reactions of nausea, vomiting and urinary retention in the OPP+ PCIA group was remarkably lower than that of OPP group (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "OPP + PCIA is superior to simple PCIA in post-operative analgesia and reducing post-operative adverse reactions in lower-limb orthopedic operation patients."
        }
      ]},
