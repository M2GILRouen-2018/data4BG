      "Abstract": {
        "CopyrightInformation": "Copyright Â© 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare real-time (on-line) monitoring of myocardial ischemia with transesophageal echocardiography (TEE) with off-line reviewing during a dobutamine stress test in patients undergoing coronary artery bypass grafting (CABG)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective observational study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary care university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Seventeen patients undergoing CABG."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "TEE and electrocardiographic monitoring of myocardial ischemia during dobutamine stress testing."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "Sixteen of 17 patients developed myocardial ischemia as diagnosed by TEE or electrocardiographic monitoring. On-line and off-line TEE detected myocardial ischemia in 11/17 and 12/17 patients, respectively. In total, 532 myocardial segments were analyzed at baseline and at peak dobutamine dose. The concordance between on-line and off-line assessments of segmental wall motion was poor at baseline and at peak dobutamine dose (κ = 0.28 and 0.29, respectively). The concordance for detecting myocardial ischemia (worsening in regional wall motion by ≥1 class or a biphasic response in any segment) was better between on-line and off-line analysis (κ = 0.60). There was no agreement between ST-segment monitoring and on-line TEE (κ = -0.27) and between 12-lead electrocardiogram and on-line TEE (-0.11). There was no agreement between ST-segment monitoring and off-line TEE (κ = -0.15) and between 12-lead electrocardiogram and off-line TEE (κ = -0.27)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Only a fair agreement exists between on-line and off-line analysis of myocardial ischemia during dobutamine stress testing in patients undergoing CABG. However, TEE misses up to one third of ischemic episodes and the present observations suggest using continuous electrocardiographic methods to complement TEE monitoring."
          }
        ]
      },
