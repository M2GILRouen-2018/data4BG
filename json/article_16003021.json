      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the sensitivity and specificity for coronary calcium detection of two fluoroscopic systems: 1) conventional system based on image intensifier chains (CONV); and 2) flat panel digital detector (FPDD) system, using intravascular ultrasound (IVUS) as the gold standard."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Coronary calcification represents advanced atherosclerotic disease and has implications during coronary interventions. Angiography has been reported to have low sensitivity for calcium detection compared with IVUS."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Lesion calcification was assessed by two different fluoroscopic systems (FPDD and CONV), and by IVUS."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In two consecutive periods, a total of 200 consecutive patients were included, 100 in each group. Clinical characteristics were similar, without significant differences between groups. In the CONV group, IVUS detected calcium in 77% of cases, and angiography in 32%. Sensitivity was 41.6% and specificity 91.3%. In the FPDD group, IVUS reported calcification in 79% of patients, and angiography in 57%. Sensitivity was 72% (p < 0.0001 for comparison with CONV) and specificity was 90.4%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The new fluoroscopic systems, based on FPDD, considerably increase the sensitivity for calcium detection without detrimental effect on specificity."
        }
      ]},
