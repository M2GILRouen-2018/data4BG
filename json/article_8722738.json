      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the clinical usefulness of the long-term intrathecal administration of midazolam and clonidine in patients with refractory neurogenic and musculoskeletal pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Pain Centre, Academic Hospital Groningen, Groningen, The Netherlands."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Four patients with chronic benign neurogenic and musculoskeletal pain, not responding to conventional analgesic therapy. OUTCOME-MEASURES: Visual Analogue Score, Activities of Daily Living."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The intrathecal administration of midazolam and clonidine produced almost immediate and nearly complete pain relief. Even with continuous use, tolerance seemed to be no problem, and side effects appear to be minimal."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Intrathecal infusion of midazolam and clonidine produced promising results in four patients with refractory chronic benign pain. Further research will be necessary to determine the efficacy and the risk-to-benefit ratio of long-term administration of this combination."
        }
      ]},
