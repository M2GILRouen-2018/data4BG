      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To describe the complexities in end-of-life care of children and adolescents dying cancer-related deaths."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Research studies, review articles, and government reports."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The complexities in providing competent and compassionate care to the dying child and the family is intense, undeniable, and may in some clinical situations be unavoidable."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "It is important for all those involved with the care at the end of life for a child or adolescent dying a cancer-related death create the framework that will support the provikion of competent and compassionate end-of-life care."
        }
      ]},
