      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Predictors of first semester and year weight change by gender were examined."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "The participants were 304 freshmen recruited over three years (September 2010, 2011, & 2012)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Psychosocial and lifestyle variables and weight were assessed at the beginning and end of the Fall semester and end of the Spring semester."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The average weight gain over the year was 6.38 lbs for males versus 4.38 lbs for females. In the first semester, alcohol use was associated with weight gain among males. For females, higher levels of physical activity and lower BMI were associated with weight gain. At the end of the year, happiness was negatively associated with weight gain among males and physical activity positively associated with weight gain in females."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Alcohol consumption in males and physical activity in females produced positive associations with weight gain with most of the weight gained during the first semester. This implies that efforts to prevent weight gain in college freshmen need to be tailored by gender and focus on first semester."
          }
        ]
      },
