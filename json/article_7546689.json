      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "An epidemic of acutely painful eyes having a seasonal restriction and an apparent response to topical indomethacin, is described."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "From patients seen in a rural private practice, the clinical picture of this acute syndrome and the use of indomethacin drops is described."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A favourable response to topical indomethacin in 21 patients is documented."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Topical indomethacin is worthy of further trial and investigation in the management of the Albury-Wodonga syndrome, harvester's eye, Christmas eye or seasonal corneal ulcer."
        }
      ]},
