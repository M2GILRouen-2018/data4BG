      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine and compare levels of catastrophizing, fear-avoidance beliefs, physical ability, and health-related quality of life in women with and without lumbopelvic pain (LP and NLP) in early pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A cross-sectional study of early pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Five midwife clinics, one in the center, two in the outskirts of Stockholm, and two in a medium-sized town."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "POPULATION",
          "content": "Three hundred and twenty-four women in the 19th-21st week of pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Questionnaires."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The Pain Catastrophizing Scale of exaggerated negative thoughts about pain experiences, the Fear-Avoidance Beliefs Questionnaire of beliefs about how physical activity and work affect back pain, the Disability Rating Index of physical ability, and the Nottingham Health Profile to assess health-related quality of life."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Two groups were defined: LP (n=141) and NLP (n=183). The Mann-Whitney U-test was used for comparisons. Pregnant women with LP had significantly (p<0.05) higher levels of exaggerated negative thoughts and fear-avoidance beliefs. They also had lower physical ability and health-related quality of life compared to women in the NLP group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "It is important to consider exaggerated negative thoughts about pain experiences and fear-avoidance beliefs when treating women with LP during pregnancy and to be aware of the great impact lumbopelvic pain has on women's lives during early pregnancy."
        }
      ]},
