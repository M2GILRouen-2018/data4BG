      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the effect of order of sensitivity testing at the vulva and thumb on the sensitivity determined at the second site tested among women with and without vulvodynia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "We evaluated the stability of sensitivity measurements to pressure at the vulva and thumb when the order of testing was randomized to vulva first vs. thumb first; we repeated testing 1 week later in the opposite order."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Stability of results over time and the influence of the order of testing were determined among 13 women with vulvodynia and 20 asymptomatic control women. We found a strong correlation between results compared between the first and second visits as well as no order effect."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The order of testing at vulvar and peripheral sites has little impact on the results of pressure-responsive sensitivity testing among women with and without vulvodynia."
        }
      ]},
