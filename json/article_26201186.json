      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the therapeutic effects of coblation treatment via endoscopy in epiglottic benign tumors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Retrospective analysis was carried out in 128 patients with epiglottic benign tumors who underwent coblation treatment via endoscopy. The complications and therapeutic effect were analyzed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "The effective rate of treatment was 100% in cyst of epiglottis and in papillary epithelioma, and was 96.36% in hypertrophy of lingual tonsils. The pseudomembrane 1 w after operation. Postoperative pain is slight. There were no complications such as dyspnea, bleeding and infection."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Radio frequency coblation via endoscopy will be applicable in the therapy of epiglottic benign tumors."
        }
      ]},
