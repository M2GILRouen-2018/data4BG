      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "The effect of montelukast therapy on bronchial hyperreactivity (BHR) as measured by the methacholine challenge test in preschool children has not yet been reported."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the effect of montelukast (4 mg/d) on BHR as evaluated by a provocative concentration of a substance causing a 20% fall in FEV(1) (PC(20)) values in preschool asthmatic children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "A total of 26 preschool children (8 girls) aged 3.3 to 6.0 years (mean [+/- SD] age, 4.7 +/- 0.8 years) with mild asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Double-blind randomized, placebo controlled, crossover study. Each child received 4 weeks of treatment with 4 mg of either montelukast or placebo separated by a 2-week washout period. Primary outcomes were PC(20) values and the stage number (triple dose) at which FEV(1) values dropped by 20%(.) Post-montelukast therapy PC(20) was compared to those for the post-placebo period."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Following 4 weeks of montelukast treatment, the mean PC(20) was 4.79 +/- 4.69 mg/mL, while after 4 weeks of placebo the mean PC(20) was 2.07 +/- 2.37 mg/mL (p = 0.001). The montelukast/placebo ratio for PC(20) was 2.56 with a 95% confidence interval (CI) of 1.71 to 3.99. The median difference in stage was one triple dose with a 95% CI of 0.5 to 1.5."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Four weeks of treatment with montelukast resulted in a decreased BHR compared with placebo."
        }
      ]},
