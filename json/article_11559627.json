      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To assess pain in young children presenting to an accident and emergency (A&E) department. To evaluate the use of the toddler-preschooler postoperative pain scale (TPPPS) and the use of analgesia in these children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "100 children aged 1-5 years presenting to an A&E department were assessed for pain. Pain assessments were carried out using a modified form of the TPPPS; a visual analogue scale by parents and a numerical scale by nursing staff."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The majority of children were assessed as having pain: 60 by the TPPPS, 58 by the nurses and 63 by parents. Only 30 children, however, received analgesia. Children with the highest pain scores as assessed by nursing staff or using the TPPPS all received analgesia."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The pain scale appears suitable for use in young children in A&E departments. The subsequent management of pain in young children could be improved."
        }
      ]},
