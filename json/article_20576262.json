      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the effect of distension medium on pain during outpatient hysteroscopy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Systematic review and meta-analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Outpatient hysteroscopy clinics."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Women undergoing outpatient hysteroscopic examination."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Use of normal saline versus carbon dioxide as distension medium for outpatient hysteroscopy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Pain scores."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "There was no statistically significant difference in pain scores when carbon dioxide or normal saline were used as the distension medium for outpatient hysteroscopy (standardized mean differences=-0.05; 95% CI, -0.17 to 0.07; I2=92%)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Carbon dioxide and normal saline are both suitable distending media for outpatient hysteroscopy as the procedural pain is comparable and the views obtained are satisfactory. However, normal saline does confer advantages that may make it more suitable for clinical use."
          }
        ]
      },
