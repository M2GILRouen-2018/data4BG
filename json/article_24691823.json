      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The prevalence of idiopathic vulvodynia and proctodynia is high. Pain management with anti-depressants and anti-epileptics may induce undesirable side effects. Therefore, topical baclofen cream and palmitoylethanolamide might be new therapeutic options."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "A 33-year-old woman with intractable chronic vulvar and anal pain had to abstain from sexual intercourse and could neither cycle nor sit for more than 5 min. The patient did not respond to standard treatments. We prescribed a combination of topical baclofen 5 % and palmitoylethanolamide 400 mg, three times daily. After 3 months her symptoms decreased more than 50 % and sexual intercourse was possible again without pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Topical baclofen and palmitoylethanolamide can be a viable treatment option in chronic vulvodynia and proctodynia."
        }
      ]},
