      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Academy of Physical Medicine and Rehabilitation. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The knee abduction moment in a weight-bearing limb is an important risk factor of conditions such as patellofemoral pain and knee osteoarthritis. Excessive pelvic drop in single-leg stance can increase the knee abduction moment. The gluteus medius muscle is crucial to prevent pelvic drop and must be activated in anticipation of the transition from double-leg to single-leg stance."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the relationship of anticipatory activity of the gluteus medius to pelvic drop and knee abduction moment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Observational, cross-sectional correlational study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Research laboratory."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Twenty female adults (mean age 22.6 years, standard deviation 2.5) were recruited and fully participated. Participant selection was limited to healthy women who did not have a history of knee and ankle ligament injuries, any indication of knee, hip, and/or low back pain, and/or knowledge of the proper squat technique."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Participants performed 16 single-leg mini squats on their nondominant leg."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "The onset and magnitude of anticipatory gluteus medius activity were measured in relation to toe-off of the dominant leg during the transition from double-leg to single-leg stance. Preplanned correlations between anticipatory gluteus medius onset and its activation magnitude, pelvic obliquity, and knee abduction moment were examined."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The magnitude of anticipatory gluteus medius activity was significantly correlated with the knee abduction moment (rs (18) = -0.303, P < .001) and pelvic obliquity (rs (18) = 0.361, P < .001), whereas gluteus medius onset was not significantly correlated with either knee abduction moment or pelvic obliquity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The amount of gluteus medius activity is more important for controlling knee and pelvic stability in the frontal plane than the onset of activation."
          }
        ]
      },
