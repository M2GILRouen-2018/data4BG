      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the safety and accuracy of dobutamine stress 99mTc-MIBI perfusion tomography (DST) for detecting coronary artery disease(CAD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Seventy nine patients with suspected CAD without previous myocardial infarction underwent DST. Forty eight of the 79 patients had coronary angiography and CAD was defined as greater than 50% reduction in diameter."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Seventeen of 20 patients with CAD demonstrated perfusion abnormalities by DST (sensitivity 85%), 20 of 24 with normal or non-significant stenosed coronary arteries had normal scan (specificity 83.3%). All 4 patients with coronary ectasia showed abnormalities by DST. Fifty seven percent of the patients experienced some discomfort, but no serious side effects occurred."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "It shows that DST is a safe and accurate alternative to exercise stress perfusion study for detecting CAD in patients unable to perform exercise testing."
        }
      ]},
