      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the association of urinary levels of the environmental phenol pesticides 2,5-dichlorophenol, 2,4-dichlorophenol, and triclosan with body weight outcomes in children and adolescent participants in the National Health and Nutrition Examination Survey 2007-2010."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "We performed multivariate linear and multinomial logistic regressions to analyze the association of body mass index (BMI) z-score, waist circumference (WC), and obesity with urinary pesticide concentration in children and adolescents."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After adjustment for covariates, we found a statistically significant positive association (P < .05) between both 2,5-dichlorophenol and 2,4-dichlorophenol with BMI z-score, WC, and obesity in children and adolescents. After stratification by age, the significant associations remained only in adolescents (ages 12-19). No associations were found between triclosan and any of the body weight outcomes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "We found an association between dichlorophenols and increased body weight measures (BMI z-score, WC, and obesity) in adolescents. However, further studies, such as a longitudinal study, are needed to confirm and elucidate on our findings."
          }
        ]
      },
