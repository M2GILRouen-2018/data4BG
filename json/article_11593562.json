      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine the utilization and contribution of cardiac perfusion scans to patients undergoing percutaneous transluminal coronary angioplasty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "From July 1996 to January 1998, 34 patients underwent percutaneous transluminal coronary angioplasty and cardiac SPECT imaging was studied. Twenty-five patients had pre-procedure SPECT scans. The agreement between angioplasty strategies and SPECT findings of ischemia and hypokinesia was examined."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "When radionuclide imaging was performed before revascularization procedures, 84% of the patients had intervention strategies guided by scan findings. Perfusion scan findings including extent and severity of ischemia, degree of hypokinesia directed the selection of target vessel for angioplasty in the patient subgroup with multi-vessel disease. Post-angioplasty radionuclide cardiac scans were performed only on symptomatic patients, demonstrating ischemia and hypokinesia in most of them, conceivably reflected the selection bias."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "We recommend routine pre- and post-angioplasty radionuclide imaging with multigated scans for wall motion assessment for all patients receiving coronary intervention."
        }
      ]},
