      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of this study was to assess the effectiveness of ischemic pressure on myofascial trigger point (MTrP) sensitivity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized, controlled study with the researcher assessing MTrP sensitivity blinded to the intervention."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Twenty-eight people with two MTrPs in the upper back musculature."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "The sensitivity of two MTrPs in the upper back was assessed with a JTECH algometer. One of the two MTrPs was randomly selected for treatment with a Backnobber II, while the other served as a control."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Pre- and post-test pressure-pain thresholds of the MTrPs"
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was a significant difference between the pre- and post-test sensitivities of the treated and non-treated MTrPs (p=0.04)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The results of this study confirm that the protocol of six repetitions of 30-s ischemic compression with the Backnobber II rendered every other day for a week was effective in reducing MTrP irritability."
          }
        ]
      },
