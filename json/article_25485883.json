      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "We investigated the effects of concomitant administration of sevoflurane and ramosetron on the QT interval, the interval between the peak and end of the T wave (Tpe) and Tpe/QT ratio in children."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To compare the effects of concomitant administration of ramosetron and sevoflurane on heart rate corrected interval with Bazett's formula (QTc), Tpe interval and Tpe/QT ratio."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective observational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Elective orthopaedic surgery with patient-controlled analgesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Forty children aged between 3 and 12 years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "ECG recordings were collected before induction (BASE), before sevoflurane administration (SEVO) and after the administration of ramosetron (SEVO and R)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The heart rate corrected interval with Bazett's formula (QTc), Tpe interval and Tpe/QT ratio were calculated and the changes were analysed using repeated-measures analysis of variance (ANOVA)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The QTc interval at BASE was 388.5\u200a±\u200a29.3\u200ams. It increased with sevoflurane anaesthesia to 414.9\u200a±\u200a21.4\u200ams and did not change with the administration of ramosetron (418.2\u200a±\u200a23.0\u200ams). The Tpe interval and Tpe/QT ratio did not differ between measurements. No ventricular arrhythmias occurred during the study."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ramosetron was not associated with prolongation of the QTc interval when it was given concomitantly with sevoflurane in children. No ventricular arrhythmias or other adverse effects occurred during the study."
        }
      ]},
