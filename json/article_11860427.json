      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Polidocanol sclerotherapy is a well-established therapeutic modality for the treatment of venous malformations. Systemic complications are extremely rare."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of cardiac complication after polidocanol injection of peripheral venous malformation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A case report and a review of the English language literature using a published MEDLINE search strategy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A patient undergoing polidocanol sclerotherapy for a symptomatic venous malformation of the right inferior limb developed cardiac arrest shortly after injection of the sclerosing agent which was promptly reversed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Systemic complications following sclerotherapy may occur even when the sclerosant is injected in peripheral veins or venous malformations. Clinicians should be alerted to the possibility of uncommon but life-threatening adverse effects."
        }
      ]},
