      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe effect of acupuncture on asthma at acute stage."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Ninety cases of asthma at acute stage were randomly divided into an observation group of 60 cases and a control group of 30 cases. Clinical therapeutic effect and the mechanisms were studied from symptoms and signs, pulmonary function and serum interleukin -4 (IL-4), gamma-interferon (INF-gamma)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The pulmonary function was improved, the vital capacity was increased and attack of asthma was reduced in both the observation group and the control group, but the observation group was better than the control group in the pulmonary function improving degree (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Acupuncture can strengthen the relieving action of medicine on asthma and it is one of effective methods for bronchial asthma."
        }
      ]},
