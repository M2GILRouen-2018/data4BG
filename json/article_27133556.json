      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier España, S.L.U. and Sociedad Española de Reumatología y Colegio Mexicano de Reumatología. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Musculoskeletal pain associated to statin use, is the most common adverse event, leading to cessation of treatment. Several studies proposed Vitamin D deficiency to increase the risk of pain associated to statin intake."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate whether vitamin D status is linked to musculoskeletal pain associated to statin use."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We performed a systematic review based on electronic searches through MEDLINE, Cochrane Central and EMBASE to identify studies that 1) included patients on statin therapy 2) with vitamin D serum levels assessment, 3) in relation to musculoskeletal pain."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The electronic search identified 127 potentially eligible studies, of which three were included and analysed in the present study. The heterogeneity of studies did not allow metanalysis. A systematic review and two cohort studies not included in the previous systematic review, revealed a statistically significant association of vitamin D deficit in patients with musculoskeletal pain on statin therapy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The displayed evidence suggests a significant association between 25OHD serum levels<30ng/ml and the presence of musculoskeletal pain in patients on statin therapy."
          }
        ]
      },
