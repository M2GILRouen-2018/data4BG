      "Abstract": {
        "CopyrightInformation": "Published by the BMJ Publishing Group Limited. For permission to use (where not already granted under a licence) please go to http://group.bmj.com/group/rights-licensing/permissions.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "There is increasing evidence that smoking is associated with abdominal obesity and other risk factors for the metabolic syndrome. The aim of this study is to investigate these associations in a sample of healthy Austrian adults."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING AND PARTICIPANTS",
            "content": "Data of 986 employees of an Austrian company (405 men and 581 women; participation rate approximately 80%) obtained during their annual medical check-up at the workplace were analysed."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PRIMARY AND SECONDARY OUTCOME MEASURES",
            "content": "Information on smoking status, education level, physical activity, diet, body weight, height, body mass index (BMI), waist circumference and biochemical parameters was obtained. The influence of smoking on health and anthropometric measures was investigated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No differences in total body fat and/or body fat distribution were found between non-smokers, smokers and former smokers; however, among daily smokers, the number of cigarettes smoked per day was significantly associated with higher body weight (p=0.001) and BMI (p=0.009). Male and female smokers had significantly higher white cell count than non-smokers and former smokers. Heavy smokers also had an unhealthier lipid profile (lower high-density lipoprotein cholesterol) and higher fasting glucose levels even after controlling for physical activity and calorie intake."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Contrary to the beliefs of many smokers, heavy smoking is associated with higher body weight and unfavourable metabolic changes."
          }
        ]
      },
