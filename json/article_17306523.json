      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Most patients with asthma and many patients with COPD show bronchial hyperresponsiveness to adenosine (BHR(AMP)). BHR(AMP) may be caused by release of mast cell histamine, which induces smooth muscle contraction."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM OF THE STUDY",
          "content": "To evaluate whether mast cell numbers in airway smooth muscle are increased in patients with asthma and COPD compared to their age-matched controls, and whether mast cell numbers are correlated with BHR(AMP)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Twenty-two non-smoking subjects with asthma (age 31yr, FEV(1): 89% pred, PC(20)AMP: 2.7mg/ml), 18 ex-smoking subjects with COPD (age 62yr, FEV(1): 58% pred, PC(20)AMP: 52.4mg/ml)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Snap-frozen bronchial biopsies were immunostained with anti-mast cell tryptase and anti-desmin antibodies. Mast cell number was expressed as the number of tryptase positive cells per area of smooth muscle."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no significant differences in mast cell number between patients with asthma, COPD, and their respective age-matched healthy controls. Furthermore, there was no significant correlation between mast cell number and FEV(1) or PC(20)AMP in any of the groups. Surprisingly, the mast cell number was negatively correlated with reversibility to salbutamol in COPD patients (rho -0.47, P<0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Mast cell numbers in central airway smooth muscle apparently do not contribute importantly to bronchial hyperresponsiveness to adenosine."
        }
      ]},
