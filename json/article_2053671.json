      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To identify psychosocial factors associated with sedentary behavior, we tested whether perceived discrimination is associated with sedentary behavior."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Black and white men and women (N = 3270) from the Coronary Artery Risk Development in Young Adults (CARDIA) Study reported experiences of discrimination and time engaged in total and screen time sedentary behaviors in 2010-11."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no associations of discriminatory experiences with total sedentary behavior time. However, discriminatory experiences were positively associated with screen time for black men (OR 1.81, 95% CI: 1.14, 2.86) and white women (OR 1.51, 95% CI: 1.14, 2.00) after adjusting for demographic and traditional cardiovascular disease risk factors."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Among black men and white women, discriminatory experiences were correlated with more screen time sedentary behavior."
        }
      ]},
