      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2016.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Approximately 6% of the U.S. population suffer from a serious mental illness (SMI). People with SMI reportedly die 20 to 25 years earlier than the general population."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To explore both hospice/palliative care nurses' and psychiatric/mental health nurses' attitudes and needs toward people with SMI at the end-of-life."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A qualitative study following a phenomenological approach was used to interview hospice/palliative care nurses and psychiatric nurses about the experience of caring for people with SMI at the end-of-life; a total of 20 nurses were interviewed. Interviews were analyzed and coded, and themes were identified."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Six themes were identified: stigma of mental illness, effect of SMI symptoms on communication and trust, chaotic family systems, advocacy issues around pain and comfort, need for formal support, no right place to die."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Participants discussed the need for better education and collaboration between psychiatric and palliative care nurses as well as the need for ongoing support."
          }
        ]
      },
