      "Language": "por",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To determine the prognostic value of dobutamine-atropine stress echocardiography (DASE)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We studied 452 consecutive patients at high risk for coronary artery disease, using DASE. They were followed during a mean period of 23 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were 9 cardiac deaths and 2 acute myocardial infarctions in the group of patients with positive tests, and there were 2 myocardial infarctions and 1 cardiac death in patients with negative DASE."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "We conclude that DASE reliably identifies patients at high risk for hard cardiac events."
        }
      ]},
