      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To provide a review of the development and impact of palliative care; to discuss quality of lie as a framework for guiding clinical practice and research in palliative care; and to identify future trends that are likely to affect palliative care services."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Research studies, review articles, and book chapters."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Palliative care is in the process of dynamic change. Advocates of palliative care are suggesting that cost-effective holistic care strategies should be available to patients and families throughout the illness trajectory, not just reserved for end of life care."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Incorporation of palliative care principles across the cancer illness trajectory requires an attitude shift by all members of the multidisciplinary team."
        }
      ]},
