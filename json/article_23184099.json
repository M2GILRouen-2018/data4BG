      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Stable angina pectoris is a serious condition with few epidemiological studies in Brazil."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To validate the short-version of the Rose angina questionnaire in Brazilian Portuguese for its implementation in surveys and longitudinal studies."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 116 consecutive patients from an outpatient clinic without prior myocardial infarction and/or coronary revascularization were enrolled for application of three questions of the Rose angina questionnaire addressing chest pain after exertion. We used the treadmill test as the gold standard with the Ellestad protocol."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The short-version of the Rose angina questionnaire of the 116 subjects submitted to the exercise treadmill test disclosed 89.7% of accuracy, 25% of sensitivity, 92.0% of specificity, 10.0% of positive predictive value, 97.2% of negative predictive value, and 3.1 of positive likelihood ratio and 0.82 of negative likelihood ratio."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The Portuguese version with three items of the Rose angina questionnaire is suitable for epidemiological purposes."
        }
      ]},
