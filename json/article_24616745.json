      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "To evaluate contrast enhanced ultrasound (CEUS) as a modality to predict T stage of cancer of urinary bladder (CAUB) and to predict the grade of the tumor preoperatively."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "110 patients with CAUB presenting to the Department of Urology at our institution between July 2014 and December 2015 underwent CEUS prior to endoscopic resection and the CEUS findings were compared with histopathology results."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "CEUS had a sensitivity of 75, 65 and 90% and specificity of 95, 85 and 92% in detecting Ta, T1 and muscle invasion respectively. CEUS had a sensitivity of 78% and specificity of 85% in detecting the grade of the lesion."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "CEUS is a good alternative for T staging and grading of CAUB preoperatively. It is uniquely advantageous in detecting clots or necrosis and in patients with low eGFR where other imaging modalities are contraindicated."
        }
      ]},
