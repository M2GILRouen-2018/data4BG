      "Abstract": {
        "CopyrightInformation": "© 2012 Blackwell Publishing Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Coeliac disease is increasingly diagnosed and weight changes are common after adoption of a gluten-free diet (GFD), however data on body mass index (BMI) changes are limited."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To assess changes in BMI after diagnosis in a large coeliac population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A total of 1018 patients with biopsy confirmed coeliac disease seen at our centre were studied retrospectively. Initial and follow-up BMIs were recorded, as was GFD adherence as assessed by an expert dietitian."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 679 patients with at least two recorded BMIs and GFD adherence data were included in the study. Mean follow-up was 39.5 months. Compared to regional population data, the coeliac cohort was significantly less likely to be overweight or obese (32% vs. 59%, P < 0.0001). Mean BMI increased significantly after GFD initiation (24.0 to 24.6; P < 0.001). 21.8% of patients with normal or high BMI at study entry increased their BMI by more than two points."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Individuals with coeliac disease have lower BMI than the regional population at diagnosis. BMI increases on the GFD, especially in those that adhere closely to the GFD. On the GFD, 15.8% of patients move from a normal or low BMI class into an overweight BMI class, and 22% of patients overweight at diagnosis gain weight. These results indicate that weight maintenance counselling should be an integral part of coeliac dietary education."
          }
        ]
      },
