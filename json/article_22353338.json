      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Left ventricular (LV) end-systolic volume indexed to body surface area (ESVI) is a simple yet powerful echocardiographic marker of LV remodeling that can be measured easily. The prognostic value of ESVI and its merit relative to other markers of LV remodeling in patients with coronary heart disease are unknown."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We examined the association of ESVI with hospitalization for heart failure (HF) and mortality in a prospective study of patients with coronary heart disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of the 989 participants, 110 (11%) were hospitalized for HF during 3.6 +/- 1.1 years of follow-up. Among participants in the highest ESVI quartile (> 25 mL/m(2)), 67 of 248 (27%) developed HF compared with 8 of 248 (3%) among those in the lowest quartile. The association between ESVI and HF hospitalization persisted after adjustment for potential confounders (hazard ratio 5.0, 95% confidence interval, 1.5-16.9; P = .01)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "ESVI > 25 mL/m(2) is an independent predictor of hospitalization for HF in patients with stable coronary heart disease."
        }
      ]},
