      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of this presentation is to review the role of sonography in evaluation of acute abdomen during pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Illustrative cases were collected from gravid patients who presented with signs and symptoms suspicious for acute abdomen and subsequently underwent sonography."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "This presentation shows sonographic findings of various maternal complications that can present with acute abdominal pain in pregnant patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Sonography remains the first line of imaging in pregnant patients presenting with acute abdomen. Patient triage or additional imaging may be obtained on the basis of the sonographic findings."
        }
      ]},
