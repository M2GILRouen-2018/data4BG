      "Abstract": {
        "CopyrightInformation": "© Georg Thieme Verlag KG Stuttgart · New York.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Headache and depression are common problems in patients with hypothalamic-pituitary disorders (HPD)."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To determine the prevalence of headache and depression in patients with HPD and the specific characteristics in affected individuals in comparison to patients with cardiovascular problems (CD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Patients with HPD and CD were asked to complete a questionnaire regarding headache and depression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There were no significant differences between the HPD and the CD group. Prevalence of headache was not associated with the treatment modality of pituitary disease, hormone excess syndromes or any hormonal replacement therapy. However, ACTH, TSH and GH deficiency were associated with less headache when compared to patients with adequate secretion. Interestingly, patients who had prior surgery suffered significantly more often from depression. In addition, headache and depression were significantly more common in patients with microadenomas than in macroadenomas."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "The risk for headache and depression is mainly influenced by a combination of factors, but a specific pituitary hormone deficiency may decrease risk for headache."
          }
        ]
      },
