      "Abstract": {
        "CopyrightInformation": "Copyright Â© 2012 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Pain, along with clicking, sub-luxation, and blocking, is one of the main symptoms for patients presenting with temporomandibular joint disorders. We assessed the effectiveness of botulinum toxin A (BOTOX(®), Allergan) as analgesic treatment for temporomandibular joint disorders."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHOD",
            "content": "Twenty-six patients with chronic pain linked to temporomandibular joint disorders were prospectively assessed. Botulinum toxin A was injected in masseter and temporalis muscles. Follow-up parameters, at one and three months, were: measuring mouth opening and diduction, muscle tenderness and pain using a visual analogue scale."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was a significant (P<0.0001) decrease of pain, an increased mouth opening, and diduction at three months. Seventy percent of the patients felt less muscle tenderness. The patient felt his psychological state had improved and so did his family."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Botulinum toxin A significantly decreases pain and improves movements of patients presenting with temporomandibular joint disorders. The effects are prolonged three months after the injection."
          }
        ]
      },
