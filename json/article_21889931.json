      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 The Canadian Society of Clinical Chemists. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We have measured the pro-oxidant-antioxidant-balance (PAB) levels in patients with defined coronary artery disease (CAD) and compared them with concentrations in healthy subjects."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "Based on angiography results, 400 patients with stable CAD were divided into CAD- and CAD+, this being further subcategorized into groups with single-, double- and triple-vessel disease (VD)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The mean PAB values in the healthy subjects, was significantly lower than for other groups (P<0.001). In CAD- patients, PAB levels were 123.2 ± 43.9, which was not statistically different compared to groups with SVD, 2VD and 3VD (P>0.05). In the CAD+ group, PAB values in 1VD, 2VD and 3VD were not significantly different among patients with SVD, 2VD and 3VD (P>0.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In conclusion, we found higher levels of oxidative stress in CAD+ patients compared to healthy subjects. The oxidation level was not related to measures of the extent of CAD such as number of stenosed vessels."
          }
        ]
      },
