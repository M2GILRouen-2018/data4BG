      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Photodynamic therapy (PDT) combines the use of a topical sensitizer and its excitation with a light of appropriate wavelength. Its use in dermatooncology has been possible in France in 2006 when the methyl ester ALA or Metvixia® got approved."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To provide a panoramic view of validated indications of PDT in oncodermatology."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "This work is based on the review of the literature as well as available guidelines or recommendation on PDT in dermatology."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Standardized protocols and results of the main clinical trials are given for the three major indications in dermatology: actinic keratosis, basal cell carcinoma and Bowen disease."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "PDT has its role to play in the treatment of multiple superficial carcinomas and cutaneous precancerous lesions and its main advantage resides in its optimal healing."
          }
        ]
      },
