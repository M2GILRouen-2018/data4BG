      "Abstract": {
        "CopyrightInformation": "© 2015 ARS-AAOA, LLC.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Asthma is a comorbid condition that may be seen by otolaryngic allergists when treating their patients with allergic rhinitis (AR). Often asthma is overlooked when aggressive treatment could prevent the development or progression of early disease."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This article is a retrospective review of the current literature on asthma as a comorbidity of the unified airway. The unified airway and asthma are clearly defined. The epidemiology, morbidity, mortality, pathophysiologic mechanisms, and the chronicity of asthma are reviewed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The otolaryngic allergist will become familiar the unified airway concept and the close relationships between AR, chronic rhinosinusitis, and asthma."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Otolaryngologists should be aware of the unified airway in order to most effectively treat their patients with AR. Knowledge of the close relationships between asthma and AR will help prevent progression of disease, identify early asthma, and improve the outcomes and quality of life for our patients."
          }
        ]
      },
