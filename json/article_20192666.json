      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To describe the clinical outcomes and complications in a consecutive series of extreme lateral interbody fusion cases."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Retrospective cohort review of 97 consecutive patients from three centers with minimum 6-month follow-up (mean 12 months). Functional status was evaluated by preoperative and last follow-up Oswestry Disability Index score. Leg and back pain were evaluated by visual analog scales. Complications were recorded and permanent complications and neurological impairment was actively investigated at last follow-up."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No permanent neurological impairment, vascular or visceral injuries were observed. Transient neurological symptoms presented in 7% of cases, all resolved within 1 month from surgery. Transient thigh discomfort was observed in 9%. Clinical success was recorded in 92% of cases."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Extreme lateral interbody fusion is a safe and effective technique for anterior interbody fusion."
        }
      ]},
