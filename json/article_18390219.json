      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To analyse the clinical factors that contribute to the rise of the cardiac injury marker troponin after coronary intervention and the impact of the rise of troponin on the clinical outcomes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Troponin I was measured after elective coronary intervention in 129 patients whose baseline levels of troponin were normal. The clinical outcomes of the patients were follow-up."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The rise of troponin I was associated with side branch losses, flow impairments such as no flow or slow flow and diabetes. The incidence of myocardial infarction increased with the rise of troponin I. The angina onsets were more common and the length of stay were longer in the patients with the rise of troponin I than those without."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The rise of troponin after coronary intervention is related to the complex coronary lesions and the complications of intervention procedures. To a certain extent, the level of troponin can predict the patients' outcomes."
        }
      ]},
