      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "It is important to recognize acutely evolving ischemic stroke attributable to reactivation of varicella zoster virus vasculopathy since antiviral agents are effective."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Three cases seen by the author over a 2-year period are highlighted."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "All patients presented with an evolving arterial or venous ischemia in the background of postherpetic neuralgia proceeding for weeks to months."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Chronic neuralgic pain in a dermatomal distribution of an evolving central nervous system vasculopathy is an important clue to its recognition."
          }
        ]
      },
