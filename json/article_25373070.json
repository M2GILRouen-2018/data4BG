      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Reprint & Copyright © 2014 Association of Military Surgeons of the U.S.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the impact of relaxed asthma recruitment standards adopted by the Australian Defence Force in 2007."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A retrospective audit was conducted on clinical and administrative data for recruits, with and without mild asthma, in their first year of service."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was no evidence that mild asthmatics experienced worse outcomes than nonasthmatic recruits. Mild asthmatics had fewer illnesses and restricted duty days and were less costly compared to other recruits. There was no difference in the rate of discharge (attrition) between those with and without mild asthma."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The revised recruitment standards for asthma in the Australian Defence Force have not resulted in unanticipated medical or administrative costs to the organization. Health and administrative outcomes differed little between mild asthmatics and nonasthmatic recruits in their first 12 months of service."
          }
        ]
      },
