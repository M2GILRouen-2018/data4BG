      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the efficacy of two doses (250 microg vs. 500 microg) of r-hCG for oocyte maturation in obese women with a body mass index (BMI) > or = 30 and undergoing assisted reproduction techniques."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "A Prospective, randomized, clinical study of seventy two patients undergoing IVF/ intracytoplasmic sperm injection cycles with BMI > or = 30 kg/m2. Patients with high BMI were randomized to receive either 250 microg or 500 microg rhCG. Blood and follicular fluid (FF) samples were collected on the day of oocyte pick-up (OPU). The outcome measures were serum and FF hCG levels on the day of OPU, number of oocytes retrieved per patient, number of mature oocytes retrieved, clinical pregnancy rates (PR)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Serum hCG levels were significantly lower in patients receiving 250 microg of r-hCG than in patients receiving 500 microg of r-hCG. However FF hCG levels, implantation rates, abortion rates, clinical PRs were not significantly different."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "250 microg of r-hCG is sufficient and safe to trigger ovulation in women with BMI > or = 30."
        }
      ]},
