      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Retrospective clinical magnetic resonance imaging study and prospective magnetic resonance imaging volunteer study of the appearance of the ligamentum flavum."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To demonstrate the effect of chemical shift artifact on the apparent thickness of the ligamentum flavum on axial magnetic resonance images."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "The ligamentum flavum is a symmetric structure clearly seen on magnetic resonance images. Apparent unilateral thickening may be interpreted as indicating a pathologic process, and the influence of chemical shift artifact on the apparent thickness of the ligamentum flavum has not been emphasized."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Ligamenta flava thicknesses were measured from axial T1-weighted gradient echo magnetic resonance scans of 12 consecutive patients and various axial sequences in seven volunteers."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The ligamentum flavum appeared consistently thicker on the lower side of the readout gradient field. This chemical shift effect could be manipulated by swapping phase and frequency or patient orientation in the magnet."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Caution should be applied in attributing apparent asymmetry of the ligamenta flava to disease; the influence of chemical shift artifact should be considered."
        }
      ]},
