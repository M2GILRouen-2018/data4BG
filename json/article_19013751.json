      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "Decrease acute pain after breast cancer surgery by an infiltration of ropivacaine. Analyse effect on chronic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Prospective randomised double blind versus placebo study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "Eighty-one patients randomised between two groups received wound infiltration with 40 ml of ropivacaine 4.75 mg/ml or placebo. Acute pain was assessed during 24h with analogical visual scale and antalgic consumption. One year later, telephonic interviews looked for chronic pain and evaluate it with McGill Pain Questionnaire."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Analogical visual scale pain score, antalgic consumption and chronic pain incidence were similar between groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ropivacaine scar infiltration provided no acute or chronic pain relief after breast cancer surgery."
        }
      ]},
