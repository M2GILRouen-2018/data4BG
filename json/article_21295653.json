      "Abstract": {
        "CopyrightInformation": "Copyright 2010 American Society for Gastrointestinal Endoscopy. Published by Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Esophageal strictures resulting from eosinophilic esophagitis present management challenges, and high rates of rents and perforation have been reported."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the safety of esophageal dilation in eosinophilic esophagitis and to characterize predictors of both clinical response and complications of the procedure."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective study of the University of North Carolina eosinophilic esophagitis database."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary care referral center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Cases of eosinophilic esophagitis were defined as per consensus guidelines."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Dilation with either Savary or through-the-scope balloon techniques."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASUREMENTS",
            "content": "Complications (deep mucosal rents, contained or free perforation, and chest pain requiring medical attention or hospitalization) and the global clinical symptom response."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 130 eosinophilic esophagitis cases identified, 70 dilations (12 Savary, 58 balloon) were performed in 36 patients. Esophageal size improved from 12 to 16 mm (P < .001), with an overall symptom response rate of 83%. The only predictor of clinical response was final dilation diameter. There were 5 complications (7%): 2 deep mucosal rents and 3 episodes of chest pain. There were no perforations. There was one hospitalization for chest pain. All complications occurred in patients being treated with topical steroids, who underwent balloon dilation. Complications were associated with younger age (23 vs 42; P = .02) and more dilations (4 vs 1.7; P = .009)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "Single center, retrospective study."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Esophageal dilation can be performed in eosinophilic esophagitis with low rates of tears, chest pain, and hospitalization. No perforations were found in our database. The effectiveness of dilation was best when a larger esophageal caliber was achieved, but patients undergoing more procedures was associated with complications."
          }
        ]
      },
