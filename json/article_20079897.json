      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare two distension media, carbon dioxide (CO2) and saline, with regards to patient discomfort and the adequacy of the panoramic view in diagnostic hysteroscopy by the vaginoscopic approach."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized prospective study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary referral centers for gynecologic care."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "264 patients randomly allocated to two groups: CO2 (132 women) and normal saline (132 women)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Office hysteroscopy performed with a forward-oblique 30° telescope (total diameter 5.1 mm) and CO2 as the distension medium or with a forward-oblique 30° telescope (final diameter 5.1mm) and saline solution as the distension medium."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Global operative time, pain experienced by patients using a visual analogue scale (VAS), severity of the pain (VAS), incidence of collateral effects (shoulder-tip pain, nausea, or dizziness), degree of difficulty, and view (VAS)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Pelvic discomfort was comparable between groups, without statistically significant differences in intensity or degree of difficulty. However, the visual quality was statistically significantly higher when hysteroscopy was performed with CO2 as the distension medium."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "No relevant difference in pain or technical difficulty was found between the two distension media, but CO2 was associated with better quality visualization."
          }
        ]
      },
