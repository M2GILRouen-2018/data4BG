      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To determine the prevalence and causes of pain in a group of outpatients with breast cancer and to evaluate the effects of pain on the patient's activities of daily living (ADL), mood, and quality of life (QOL)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive and correlational."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Sixteen outpatient facilities that are part of the Oncology Nursing Research Network."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "A convenience sample of 97 outpatients who were actively being treated for breast cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Patients completed a demographic questionnaire, a cancer pain questionnaire, the Profile of Mood States, and the Multidimensional Quality of Life Scale--Cancer. Patients' medical records were reviewed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Pain intensity, pain duration, changes in ADL, changes in mood, and changes in QOL."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Forty-seven percent of the patients with breast cancer reported experiencing cancer-related pain. Patients with cancer-related pain had significantly higher mood disturbance scores and significantly lower QOL scores."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Pain is a significant problem for outpatients with breast cancer that negatively affects mood, QOL, and functional status."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Future research is needed to determine the most effective strategies for treating pain associated with breast cancer. In addition, oncology nurses should perform ongoing assessments of patients' pain and the impact of the pain on various aspects of patients' lives."
        }
      ]},
