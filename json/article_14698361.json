      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To describe sleeping patterns of adults before and after outpatient surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Observational cohort study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient surgical facility."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "127 consenting adults, including 92 surgery patients and 35 community controls."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Participants' sleep was measured for two days before and 2 days after outpatient surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Sleep was measured using actigraphy; additional measurements were made of anxiety (STAI), pain and energy (VAS), recovery (PHRI), and sleep history."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MAIN RESULTS",
          "content": "Approximately 23% of patients experienced clinically significant sleep impairment after surgery, a more difficult recovery, increased pain, and lower energy. In contrast, only 2.9% of the community control group experienced clinically significant sleep impairment during the same time period. Also, patients in the surgery group experienced significantly more True Wake Time postoperatively than did control patients (p = 0.029). The surgery group also experienced more Night Awakenings >5 minutes than the control group (p = 0.006), but not more overall Night Awakenings (p = 0.106). Finally, of the patients in the surgery group, those who had higher state anxiety in the holding area also had more difficulty sleeping over the 4-day monitoring period (True Sleep Time was lower, 352 +/- 187 vs. 229 +/- 225, p = 0.009)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A moderate proportion of adults experience postoperative sleeping problems."
        }
      ]},
