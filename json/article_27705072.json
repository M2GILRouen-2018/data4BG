      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Rounded-shoulder and forward-head posture can be contributing factors to shoulder pain. Corrective techniques such as manual therapy and exercise have been shown to improve these altered postures, but there is little evidence that corrective garments such as posture shirts can alter posture."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine the acute effects of corrective postureshirt use on rounded-shoulder and forward-head posture in asymptomatic college students."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Repeated-measures intervention study with counterbalanced conditions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Research laboratory."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "24 members of the general student body of a university, 18-25 y old, with a forward shoulder angle (FSA) >52° and no history of upper-extremity surgery, scoliosis, active shoulder pain, or shoulder pain in the previous 3 mo that restricted participation for 3 consecutive days."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Photographic posture assessment under a control condition, under a sham or treatment condition (counterbalanced), under another control condition, and treatment or sham."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "FSA and forward head angle (FHA) calculated from a lateral photograph."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "FSA decreased relative to the control condition while participants wore the sham shirt (P = .029) but not the corrective posture shirt (P = 1.00). FHA was unchanged between groups (P = .371)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Application of a corrective posture shirt did not acutely alter FSA or FHA, while application of a sham shirt may decrease FSA at rest."
        }
      ]},
