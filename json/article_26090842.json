      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Chronic musculoskeletal pain is highly prevalent worldwide."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PRIMARY STUDY OBJECTIVE",
          "content": "The aim of this study was to evaluate the efficacy of Helical(®) microcoils, a new, noninvasive treatment for chronic musculoskeletal pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "This was a prospective, observational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The study was conducted at the main author's private clinic, in São Paulo, Brazil."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "We evaluated 20 physicians, from 2 different hospitals, who suffered from chronic musculoskeletal pain and volunteered to participate in the study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "The Helical(®) microcoils were applied to the skin over the affected areas. Before and after the intervention, the physician-patients completed questionnaires and a visual analog scale."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PRIMARY OUTCOME MEASURES",
          "content": "We quantified postintervention improvement or worsening of pain and muscle tension."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Significant improvements in pain and muscle tension were observed in 95% of the physician-patients evaluated. The only side effect reported was mild pruritus at the application site, which occurred in 5 of the 20 cases."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The use of Helical microcoils was found to be safe and efficacious in relieving muscle tension and pain."
        }
      ]},
