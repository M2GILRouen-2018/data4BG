      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report a case of bilateral panuveitis in a patient with hypohidrotic ectodermal dysplasia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Interventional case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A 6-year-old African-American boy with hypohidrotic ectodermal dysplasia presented with pain, photophobia, and decreased vision in both eyes."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Findings included severe bilateral panuveitis with optic disk edema, macular epiretinal membrane, peripheral retinal vasculitis, and retinitis. All other known causes of panuveitis were explored and ruled out."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The abnormal development of tissues of ectodermal origin evident in hypohidrotic ectodermal dysplasia may include a predisposition to panuveitis."
        }
      ]},
