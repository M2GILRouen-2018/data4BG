      "Abstract": {
        "CopyrightInformation": "© 2014 Society of Hospital Medicine.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The 2012 American College of Chest Physicians venous thromboembolism prevention guidelines emphasized the importance of considering patient preferences when ordering venous thromboembolism prophylaxis."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Determine patient preferences regarding pharmacologic venous thromboembolism prophylaxis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Single-center, mixed-methods survey."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Academic medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Consecutive hospitalized patients on surgical and medical units."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Patients were asked about their preferences regarding the route of administration for pharmacologic venous thromboembolism prophylaxis and the rationale for their preference. Qualitative analyses of themes were determined from patient rationale."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of the 227 patients, a majority (60.4%) preferred an oral medication, if equally effective to subcutaneous options. Dislike of needles (30.0%) and pain from injection (27.7%) were identified as rationales for their preference. Patients favoring subcutaneous administration (27.5%) identified a presumed faster onset of action (40.3%) as the primary reason for their preference. Patients with a preference for subcutaneous injections were less likely to refuse prophylaxis than patients who preferred an oral route of administration (37.5% vs 51.3%, P\u2009<\u20090.0001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATION",
            "content": "Only medical and surgical patients participated."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "In a sample of consecutive medical and surgical patients, a majority preferred an oral route of administration for prophylaxis. Patients preferring subcutaneous injections were less likely to refuse doses of ordered pharmacologic prophylaxis. These results indicate use of an oral agent for venous thromboembolism prophylaxis may improve adherence and that integrating patient preferences into care may increase delivery of effective prophylaxis and reduce the incidence of venous thromboembolism."
          }
        ]
      },
