      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "We compared endoscopic retrograde cholangiopancreatography (ERCP) and laparoscopic common bile duct exploration (LCBDE) for managing choledocholithiasis found at time of cholecystectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "One hundred and five LCBDE (2005-2015) were compared to 195 LC/ERCP (2014-2015) from the Southern California Kaiser Permanente database."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "LC/ERCP was more effective at clearing the CBD (98% vs. 88.6%, p = 0.01); but required more procedures per patient (mean ± standard deviation, 1.1 ± 0.4 vs. 2.0 ± 0.12, p < 0.001). Morbidity, hospital length of stay and readmission were not different (P > 0.05). Four patients failed ERCP, while 12 patients failed LCBDE and had subsequent ERCP (10) or CBD exploration (2). All patients with RYGB had successful LCBDE."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "LC/ERCP is better than LCBDE in clearing CBD stones, but has similar morbidity and is an effective alternative for patients with RYGB."
          }
        ]
      },
