      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the efficacy of biochemical tests in diagnosing acute appendicitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Open prospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "District hospital, Norway."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "257 patients with suspected acute appendicitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Initial diagnostic accuracy of a logistic regression model using available clinical data was compared with results of corresponding models that included an increasing number of inflammatory parameters."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The estimated probabilities of appendicitis in different testing groups were analysed using receiver operating characteristic (ROC) curves."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A model including only clinical variables had a mean area under the ROC curve of 0.854. When the total white blood cell count, C-reactive protein concentration, and neutrophil count were added, the model improved significantly to 0.920."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Biochemical tests are of additional value in a computer model, and the tests should, if used rationally, also provide physicians with important information in the investigation of acute appendicitis."
        }
      ]},
