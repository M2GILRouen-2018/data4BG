      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 American College of Allergy, Asthma & Immunology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Rates of asthma morbidity, mortality, and resource use are highest among African American individuals residing in inner-city locations, yet factors associated with adverse outcomes are not well established."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To identify modifiable factors associated with asthma exacerbations."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A total of 104 adult patients who presented to an inner-city hospital or emergency department (ED) with an asthma exacerbation from October 1, 2009, through June 31, 2010, completed surveys of clinical status, acute events, sociodemographic characteristics, current asthma knowledge, self-efficacy, attitudes toward asthma self-management, and perceived barriers to asthma care questionnaires. Associations with asthma hospitalizations and ED visits were assessed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The mean age of the patients was 42 years, 91% were African American, 33% were insured, 57% were taking a controller medication, and 63% had an income level below the federal poverty line. On bivariate analysis, males, years of asthma, history of smoking, self-classification of asthma severity, history of admission to intensive care unit or intubation, use of peak flow meter or asthma action plan, controller medication use, and history of oral corticosteroid bursts were positively associated, whereas self-efficacy was negatively associated with number of ED visits or hospitalizations. No association was found for asthma knowledge, perceived barriers to care, or attitudes toward asthma management. On multivariate analysis, low self-efficacy remained associated with both asthma hospitalizations and ED visits."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Short-term use of health services for asthma is negatively associated with asthma self-efficacy. Self-management programs that enhance self-efficacy, rather than those that focus on knowledge or attitudes, may be effective in reducing adverse asthma outcomes for inner-city, predominantly African American populations."
          }
        ]
      },
