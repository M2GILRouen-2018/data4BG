      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess whether oral administration of 100 mg of nimesulide reduces pain during or after a hysterosalpingography (HSG) performed with disposable balloon catheters."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomized, placebo-controlled study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Reproductive Centre, Department of Obstetrics and Gynaecology, University of Genoa."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Four hundred and forty patients undergoing HSG with a balloon catheter without applying a tenaculum."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Patients were randomized to receive either 100 mg of oral nimesulide or a placebo solution 30 minutes before the HSG was performed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Patients recorded the degree of pain experienced during the examination, 2 hours afterward, and during the following week on a questionnaire using a 10-mm visual analogue scale (VAS)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Of the 331 (75.2 %) patients who returned the questionnaire, 151 had received nimesulide and 180 placebo. There was no difference in pain score between the two groups at any study point. Pain during HSG was correlated with nulliparity and tubal occlusion. Balloon inflation (cervix versus cavity) was not related to pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Nimesulide does not reduce pain during or after HSG when the procedure is accomplished with a balloon catheter."
        }
      ]},
