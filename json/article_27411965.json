      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Peripheral intravenous catheterization (PIVC) is commonly performed on emergency departments and inpatient units. Unsuccessful PIVC first attempts increase pain, and lead to treatment and diagnostic delays."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine strategies associated with PIVC first attempt success in adult emergency department patients and inpatients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We searched MEDLINE, EMBASE, CINAHL, TRIP, Cochrane Central Register of Controlled Trials (OVID), and grey literatures databases such as Proquest Dissertation and Theses Global, and Open Grey databases between November and December, 2014. The search was updated on January 28, 2016. We included full text reports of randomized controlled trials testing PIVC interventions versus standard of care. Risk of bias was assessed using the Cochrane Collaboration's tool."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We included 14 randomized controlled trials involving 3201 participants. Interventions included the AccuVein™, AccuCath™ catheter system, ultrasound, safety catheters, and topical anesthetics. Three studies compared AutoGuard and Insyte catheters and were suitable for meta-analysis. There was no difference in first attempt success with a relative risk of 0.0 (95% CI, -0.04, 0.04). There was limited evidence to support the use of ultrasound to increase first attempt success."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Well-designed and reported randomized controlled trials examining the effectiveness of ultrasound compared to standard of care are warranted."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "REGISTRATION",
            "content": "PROSPERO registration: CRD42014015428."
          }
        ]
      },
