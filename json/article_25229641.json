      "Abstract": {
        "CopyrightInformation": "© 2014 BSPD, IAPD and John Wiley & Sons A/S. Published by John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Longer and more complex dental procedures could negatively affect patient's acceptability of minimal invasive techniques."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS AND METHODS",
            "content": "Therefore, this short communication aims to show the preliminary findings regarding children's discomfort reported after some minimal invasive treatments in treating initial caries lesions on approximal surfaces: flossing instruction, silver diamine fluoride (SDF) application and caries resin infiltration."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Children allocated in the infiltration group showed higher levels of discomfort than those in the SDF and control groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These findings suggest that the simplest interventions for approximal initial caries lesions cause less discomfort for children and should be applied where possible."
          }
        ]
      },
