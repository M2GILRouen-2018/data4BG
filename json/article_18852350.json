      "Abstract": {
        "CopyrightInformation": "© 2017 International Parkinson and Movement Disorder Society.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Lower vitamin D levels have been associated with manifest Parkinson's disease, prompting the hypothesis that vitamin D insufficiency or deficiency may increase risk for PD."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate vitamin D levels in a population at risk for developing PD."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Plasma vitamin D levels were measured in the Parkinson Associated Risk Syndrome Study, a cohort of asymptomatic individuals, some of whom are at high risk for PD. Vitamin D levels were compared between subjects at high risk for PD (hyposmia and dopamine transporter scan deficit) versus all others and examined for correlations with dopaminergic system integrity."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Mean vitamin D levels did not differ between groups, with a level of 27.8 ng/mL (standard deviation = 12.0) in the high-risk group versus 24.7 ng/mL (standard deviation = 9.0) in all others (P = 0.09). Vitamin D levels did not associate with putaminal dopamine transporter uptake."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our data from the asymptomatic Parkinson Associated Risk Syndrome cohort do not support the hypothesis that chronic vitamin D insufficiency threatens dopaminergic system integrity, contributing to PD pathogenesis. © 2017 International Parkinson and Movement Disorder Society."
          }
        ]
      },
