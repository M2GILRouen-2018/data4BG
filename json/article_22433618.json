      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 S. Karger GmbH, Freiburg.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to determine whether obesity influences relationships between habitual alcohol drinking and hemoglobin A(1C) (HbA(1C)) level."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Japanese men (35-70 years old, n = 24858) were divided into non-, light (<22 g ethanol/day), moderate (≥22 and <44 g ethanol/day), and heavy (≥44 g ethanol/day) drinkers. Relationships of alcohol with HbA(1C) were investigated in overall subjects and subjects of quartile groups for degree of obesity."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "HbA(1C) tended to be higher as quartiles of BMI and waist-to-height ratio increased. HbA(1C) was significantly lower in light, moderate and heavy drinkers than in nondrinkers. These associations in overall subjects were also found in all of the quartiles of BMI and waist-to-height ratio, except for light drinkers in the 3rd and 4th quartiles of BMI and the 4th quartile of waist-to-height ratio. Odds ratios versus nondrinkers for high HbA(1C) were significantly lower than a reference level of 1.0 in all drinker groups, and these associations were not altered after adjustment for age, history of smoking, and BMI or waist-to-height ratio."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The results suggest that alcohol consumption is associated with lower HbA(1C) level independent of degree of obesity."
          }
        ]
      },
