      "Abstract": {
        "CopyrightInformation": "Copyright 2010 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine the effects of new conservative surgical management for diffuse uterine adenomyosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective clinical study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Gynecology department in a general hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "A total of 44 women with diffuse adenomyosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Conservative surgical management."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Mean visual analog scale score of dysmenorrhea and menorrhagia after a 3-month follow-up."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "After this surgery, the mean visual analog scale score of dysmenorrhea decreased from 9.4 to 0.8, and anemia due to menorrhagia improved in all women. Two patients became pregnant, with one interstitial pregnancy and one normal pregnancy that is continuing. No major complications or sequelae were observed."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "This procedure should be considered as a therapeutic option in women with symptoms of diffuse uterine adenomyosis who wish to avoid hysterectomy."
          }
        ]
      },
