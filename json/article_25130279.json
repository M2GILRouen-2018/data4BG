      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Sports Medicine Australia. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The present study aimed to measure the energy cost of three common sedentary activities in young children to test whether energy expended was consistent with the recent consensus definition of 'sedentary' as 'any behaviour conducted in a sitting or reclining posture and with an energy cost ≤ 1.5 metabolic equivalents (METs)' (Sedentary Behaviour Research Network, 2012)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Observational study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Whole-room calorimetry measures of television viewing, sitting at a table drawing and reading, and sitting on the floor playing with toys were made in 40 young children (mean age 5.3 years, SD 1.0)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The energy cost of each sedentary activity was consistent with the recent consensus definition of sedentary: 1.17 METs (95% CI 1.07-1.27) for TV viewing; 1.38 METs (95% CI 1.30-1.46) for sitting at a table; and 1.35 METs (95% CI 1.28-1.43) for floor-based play."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Common sedentary activities in young children have energy costs which are consistent with the recent consensus definition of 'sedentary', and the present study is supportive of this definition."
          }
        ]
      },
