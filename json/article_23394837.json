      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Society for Gastrointestinal Endoscopy. Published by Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Colonoscopy is widely used for management of colorectal diseases. A history of abdominal or pelvic surgery is a well-recognized factor associated with difficult colonoscopy. Although water exchange colonoscopy (WEC) was effective in small groups of male U.S. veterans with such a history, its application in other cultural settings is uncertain."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the application of WEC in such patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, randomized, controlled, patient-blinded study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary-care referral center in China."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Outpatients with prior abdominal or pelvic surgery undergoing unsedated diagnostic, screening, or surveillance colonoscopy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Patients were randomized to examination by either WEC or conventional air colonoscopy (AC)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASUREMENTS",
            "content": "Cecal intubation rate."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 110 patients were randomized to the WEC (n = 55) or AC (n = 55) group. WEC significantly increased the cecal intubation rate (92.7% vs 76.4%; P = .033). The maximum pain scores (± standard deviation) were 2.1 ± 1.8 (WEC) and 4.6 ± 1.7 (AC), respectively (P < .001). Multivariate analysis showed that the colonoscopy method was the only independent predictor of failed colonoscopy (odds ratio 11.44, 95% confidence interval, 1.35-97.09). A higher proportion of patients examined by WEC would be willing to have a repeat unsedated colonoscopy (90.9% vs 72.7%, P = .013)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "Single center; unblinded but experienced endoscopists."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This randomized, controlled trial confirms that the water exchange method significantly enhanced cecal intubation in potentially difficult colonoscopy in unsedated patients with prior abdominal or pelvic surgery. The lower pain scores and higher proportion accepting repeat of the unsedated option suggest that WEC is promising. It may enhances compliance with colonoscopy in specific populations. ("
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CLINICAL TRIAL REGISTRATION NUMBER",
            "content": "NCT01485133.)."
          }
        ]
      },
