      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the quality of life (QoL) of patients with HTLV-I-associate myelopathy/tropical spastic paraparesis (HAM/TSP) and to correlate it with specific aspects of the disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Fifty-seven HAM/TSP patients completed the SF-36 QoL questionnaire. They were also asked about common complaints related to the disease, and we looked for associations between QoL and these complaints."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients with HAM/TSP showed a strong negative association to QoL. Pain was the condition which most affected their QoL. The practice of physical activity is associated with better QoL in five out of eight domains of the scale."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "HAM/TSP leads to a poor QoL, mostly influenced by pain. Physical activity may have a positive association to QoL of these patients."
        }
      ]},
