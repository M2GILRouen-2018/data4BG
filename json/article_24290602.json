      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "We assessed the alterations in mitochondrial function in skeletal muscle that were elicited by short-term high-fat feeding in sedentary rats."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Two groups of rats were pair-fed for 1 wk and received a low-fat or high-fat diet. Body composition, energy balance, and glucose homeostasis were measured. Mitochondrial mass, oxidative capacity, and energetic efficiency as well as parameters of oxidative stress and antioxidant defense were evaluated in subsarcolemmal and intermyofibrillar mitochondria from the skeletal muscle."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Body energy, lipid content, and metabolic efficiency were significantly higher and energy expenditure was significantly decreased among rats that were fed a high-fat diet, as compared with controls. Skeletal muscle mitochondrial energetic efficiency, oxidative capacity for lipid substrates, and antioxidant defense were significantly increased in rats that were fed a high-fat diet as compared with controls."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Acute isocaloric high-fat feeding is able to induce increased phosphorylation efficiency in skeletal muscle subsarcolemmal and intermyofibrillar mitochondria. This modification implies a reduced oxidation of energy substrates that may contribute to the early onset of obesity."
          }
        ]
      },
