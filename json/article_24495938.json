      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Inferior vena cava thrombosis is a rare but important cause of acute low back pain and lumbar radiculopathy. Failure to diagnose and treat this condition could result in propagation of the thrombosis, resulting in fatal pulmonary embolism."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "We report the first known case of inferior vena cava thrombosis in a postpartum woman presenting with acute lumbar radiculopathy and weak legs. She was successfully treated with i.v. heparin and oral anticoagulation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Inferior vena cava thrombosis is a rare cause of acute lumbar radiculopathy, but is in the differential diagnosis to consider, especially in those patients at increased risk of thrombosis."
          }
        ]
      },
