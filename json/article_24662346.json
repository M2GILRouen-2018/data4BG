      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the efficacy and safety of artrosilene in the combination with piascledine in patients with low-back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Sixty patients, 42 women and 18 men (mean age 53,6±10,4 years) with chronic nonspecific low-back pain were treated with artrosilene (ketoprofen lysine salt) in the combination with the chondro protector piascledine (a mix of avocado and soybean oil extracts)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There the persistent decrease in the intensity of pain syndrome and severity of vertebral syndrome and improvement of quality of life."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The drugs can be recommended for treatment of nonspecific low-back pain."
        }
      ]},
