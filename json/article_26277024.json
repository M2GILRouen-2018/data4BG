      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier España, S.L.U. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Finding out women's experiences diagnosed with fibromyalgia applying the Theory of Uncertainty proposed by M. Mishel."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A qualitative study was conducted, using a phenomenological approach."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LOCATION",
            "content": "An Association of patients in the province of Alicante during the months of June 2012 to November 2013."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "A total of 14 women diagnosed with fibromyalgia participated in the study as volunteers, aged between 45 and 65 years."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Information generated through structured interviews with recording and transcription, prior confidentiality pledge and informed consent. Analysis content by extracting different categories according to the theory proposed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The study patients perceive a high level of uncertainty related to the difficulty to deal with symptoms, uncertainty about diagnosis and treatment complexity. Moreover, the ability of coping with the disease it is influenced by social support, relationships with health professionals and help and information attending to patient associations."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The health professional must provide clear information on the pathology to the fibromyalgia suffers, the larger lever of knowledge of the patients about their disease and the better the quality of the information provided, it is reported to be the less anxiety and uncertainty in the experience of the disease. Likewise patient associations should have health professionals in order to avoid bias in the information and advice with scientific evidence."
          }
        ]
      },
