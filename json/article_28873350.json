      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The posterior bone block procedure is a well-known treatment option for posterior shoulder instability. The goal of this retrospective multicenter study was to evaluate the clinical and radiological outcomes of this procedure."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "The study cohort consisted of 66 patients (55 men, 11 women) with an average age of 27.8 years who were evaluated clinically and radiologically using a standardized questionnaire after posterior bone block surgery."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The Constant score significantly improved postoperatively (P<0.0001). The postoperative Walch-Duplay score was 81.5. The Rowe score was 86.5 points. The pain level (VAS) was significantly reduced after this procedure (P<0.0001). Eighty-five percent of patients were satisfied or very satisfied with the outcome."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This multicenter study of 66 patients shows that the posterior bone block procedure is an effective technique with good subjective and objective outcomes; however, the possibility of complications cannot be ignored."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "CLINICAL STUDY",
            "content": "Level of evidence IV."
          }
        ]
      },
