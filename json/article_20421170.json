      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "Ultrasound Needling(UN) and Radial Shockwave(RSWT) aim to dissolve deposits in Shoulder Calcific tendinitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "RCT in 25 patients to compare short term effectiveness. Outcome measures were pain and functional outcome at 6 weeks and 1 year and decrease of deposits after 6 weeks."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "UN decreased deposit more than RSWT(P = 0.029). After 6 weeks, Constant, NRS and Oxford improved more in UN. After 1 year, there was no significant difference in NRS(p = 0.45) or Oxford(p = 0.32)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Compared to RSWT, UN resulted in lower pain and faster resorption of calcifications after 6 weeks. No significant differences were found after 1 year."
        }
      ]},
