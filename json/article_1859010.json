      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The objectives of the study were to determine the absolute bioavailability of fentanyl from fentanyl buccal soluble film, estimate the percentage of a fentanyl dose absorbed through the buccal mucosa, and compare the bioavailability of equivalent doses administered either as single or multiple dose units."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Open-label, randomized, four-period, Latin-square crossover pharmacokinetic study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Inpatient phase 1 unit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Twelve healthy volunteers. Interventions. Injectable fentanyl citrate (200 microg) administered by intravenous infusion, injectable fentanyl citrate (800 microg/16 mL) administered orally, and fentanyl buccal soluble film (800 microg) administered as a single film and as four separate 200 microg films simultaneously."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Plasma concentrations after fentanyl dosing; pharmacokinetic parameters."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The two buccal film treatments were bioequivalent and both had an absolute bioavailability of 71%. The percentage of an administered dose absorbed through the buccal mucosa was calculated to be 51%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Fentanyl buccal soluble film effectively delivers a high percentage of the administered fentanyl dose and nearly identical plasma profiles are obtained when equivalent doses are delivered by single or multiple dosage units."
        }
      ]},
