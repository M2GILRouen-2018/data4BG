      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare the metabolic profiles of normo- and hyperandrogenic women with polycystic ovary syndrome (PCOS) with those of control women at different ages during reproductive life."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case-control study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Not applicable."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "In all, 1,550 women with normoandrogenic (n = 686) or hyperandrogenic (n = 842) PCOS and 447 control women were divided into three age groups: <30, 30-39, and >39 years)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS(S)",
            "content": "None."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Body mass index (BMI), waist circumference, blood pressure, glucose, insulin, cholesterol, lipoproteins, triglycerides and high-sensitivity C-reactive protein."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Both normo- and hyperandrogenic women with PCOS were more obese, especially abdominally. They had increased serum levels of insulin (fasting and in oral glucose tolerance tests), triglycerides, low-density lipoprotein, and total cholesterol, higher blood pressure, and lower high-density lipoprotein levels independently from BMI compared with the control population as early as from young adulthood until menopause. The prevalence of metabolic syndrome was two- to fivefold higher in women with PCOS compared with control women, depending on age and phenotype, and the highest prevalence was observed in hyperandrogenic women with PCOS at late reproductive age."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "When evaluating metabolic risks in women with PCOS, androgenic status, especially abdominal obesity and age, should be taken into account, which would allow tailored management of the syndrome from early adulthood on."
          }
        ]
      },
