      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Société Française du Cancer. Published by Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The French Patient Advocacy Group SOS Desmoid conducted a survey to measure the pain burden of desmoid tumor patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "We used a structured questionnaire to measure the occurrence and consequences of pain."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The pain occurrence was approximately 63%. In one-third of the cases, the pain was permanent. This pain led to severe social and economic consequences."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "The occurrence of pain and its consequences are underestimated among these patients. Pain needs to be closely and precisely measured and monitored in future clinical trials to assess the efficacy of proposed treatments better."
          }
        ]
      },
