      "Abstract": {
        "CopyrightInformation": "© The Author 2015. Published by Oxford University Press on behalf of the Society of Pediatric Psychology. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To characterize the health-related quality of life (HRQoL) of children with eosinophilic esophagitis (EoE) as well as generate novel hypotheses for future research in this pediatric population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A literature review was completed using PubMed and the keywords below."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Research has shown that for children with EoE and their parents, symptom experiences and recommended treatments can have a negative impact on HRQoL. However, studies have yet to adequately address mechanisms that may help explain why this is. Areas of interest include sleep quality and disturbances, the experience of pain, and the presence of internalizing symptoms, all of which have the potential to uniquely and synergistically impact HRQoL."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "With greater understanding of the associations among sleep, pain, internalizing symptoms, and HRQoL in children with EoE may come enhanced therapies that substantially improve the quality of their health care."
          }
        ]
      },
