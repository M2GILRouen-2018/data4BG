      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Postoperative pain control after major abdominal surgery is the prime concern of anesthesiologist. Among various methodologies, epidural analgesia is the most preferred technique because of the excellent quality of analgesia with minimum side-effects."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "The present study was designated to compare postoperative analgesic efficacy and safety of epidural tramadol as adjuvant to ropivacaine (0.2%) in adult upper abdominal surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTINGS AND DESIGN",
          "content": "Prospective, randomized-controlled, double-blinded trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Ninety patients planned for upper abdominal surgery under general anesthesia were randomized into three equal groups to receive epidural drug via epidural catheter at start of incisional wound closure: Group R to receive ropivacaine (0.2%); Group RT1 to receive tramadol 1 mg/kg with ropivacaine (0.2%); and RT2 to receive tramadol 2 mg/kg with ropivacaine (0.2%). Duration and quality of analgesia (visual analog scale [VAS] score), hemodynamic parameters, and adverse event were recorded and statistically analyzed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STATISTICAL ANALYSIS",
          "content": "One-way analysis of variance test, Fisher's exact test/Chi-square test, whichever appropriate. A P < 0.05 was considered significant."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Mean duration of analgesia after epidural bolus drug was significantly higher in Group RT2 (584 ± 58 min) when compared with RT1 (394 ± 46 min) or R Group (283 ± 35 min). VAS score was always lower in RT2 Group in comparison to other group during the study. Hemodynamic parameter remained stable in all three groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "We conclude that tramadol 2 mg/kg with ropivacaine (0.2%) provides more effective and longer-duration analgesia than tramadol 1 mg/kg with ropivacaine (0.2%)."
        }
      ]},
