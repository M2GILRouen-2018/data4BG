      "Abstract": {
        "CopyrightInformation": "© 2015 by Association of Pediatric Hematology/Oncology Nurses.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Symptom monitoring and alleviation are important during pediatric cancer treatments."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS",
            "content": "To examine the use of the Therapy-Related Symptom Checklist for Children (TRSC-C; Thai version) for reported occurrence, severity, and management of treatment-related symptoms within a cohort of Thai pediatric oncology patients/parents"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Cross-sectional study; convenience sample: 100 parents of 71 male children/29 females, 63% with leukemia, 37%, other diagnoses; age-groups: <5 years, n = 33; 5 to 11 years, n = 44; 12 to 17 years, n = 25. Parents reported children's symptom occurrence/severity on the TRSC-C; and complementary care methods on the Symptom Alleviation: Self-Care Methods and their symptom alleviation methods. All tools had good psychometric properties."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "18 symptoms on the 30-item TRSC-C occurred in 42% to 95% of children. Mean severity of symptoms was between 1.0 (\"a bit\") and 2.0 (\"quite a bit\"); 5-month to 11-year-old children had higher (worse) TRSC-C total scores. Complementary care was used and reported."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Monitoring of multiple symptoms with the TRSC-C and parental symptom alleviation helped children."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL IMPLICATIONS",
            "content": "Thai parents/patients need and accept assistance in monitoring/managing side effects of pediatric cancer therapy."
          }
        ]
      },
