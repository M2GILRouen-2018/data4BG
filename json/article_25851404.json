      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Sociedad Española de Oftalmología. Published by Elsevier España, S.L.U. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "CLINICAL CASE",
            "content": "A 45 year-old woman with unknown ophthalmology history complained of pain, redness and visual acuity (VA) loss in her left eye for the last three weeks. A serous iris cyst with an overlying peripheral corneal leukoma was located in the iris stroma using ultrasonic biomicroscopy. It was assumed that it was secondary to a penetrating trauma from her childhood. The cyst healed and VA improved after fine-needle aspiration and partial posterior synechiolysis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Iris inclusion cysts may appear many years after penetrating trauma or surgery. Fine-needle aspiration is a good choice for its diagnosis and treatment."
          }
        ]
      },
