      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To determine the contents of chicken nuggets from 2 national food chains."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Chicken nuggets have become a major component of the American diet. We sought to determine the current composition of this highly processed food."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Randomly selected nuggets from 2 different national fast food chains were fixed in formalin, sectioned and stained for microscopic analysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Striated muscle (chicken meat) was not the predominate component in either nugget. Fat was present in equal or greater quantities along with epithelium, bone, nerve, and connective tissue."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Chicken nuggets are mostly fat, and their name is a misnomer."
          }
        ]
      },
