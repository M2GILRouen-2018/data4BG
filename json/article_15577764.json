      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Complete excision is not always easy when a keratoacanthoma is large or located in certain anatomic areas. An effective nonsurgical treatment would be desirable in such cases."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This was a pilot study of the effects of intralesional interferon alfa-2b in the treatment of rapidly growing keratoacanthomas."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 4 large, rapidly growing keratoacanthomas, which were located on the lower lip, neck, and cheeks of the 4 different patients, were treated with intralesional interferon alfa-2b injection weekly. Serial photographs were taken to observe the course of responses."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All lesions resolved completely in 5 to 7 weeks with acceptable cosmetic results."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Intralesional interferon alfa-2b can be a treatment modality of these difficult lesions."
        }
      ]},
