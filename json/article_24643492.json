      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To present the results of the nutritional component of a Health Promoting School (HPS) project, on the nutritional status of children in an elementary school."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "An HPS intervention was designed using children's narrative and participatory action research methodology. Body mass index was utilized to assess nutritional status."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In school children the prevalence of excess weight (overweight plus obesity) decreased significantly (p<0.001) after the intervention."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In order to develop a successful solution to the problem of excess weight, it is essential to involve those affected."
        }
      ]},
