      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of this study was to examine the relationship between caregiver ratings of provider use of a participatory decision-making style and caregiver and child satisfaction with their pediatric asthma visits."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Children ages 8 through 16 with persistent asthma and their caregivers were recruited at five pediatric practices. Children were interviewed and caregivers completed questionnaires after their child's medical visits. Generalized estimating equations were used to analyze the data."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Three hundred and twenty children were recruited. Caregivers were significantly more satisfied with providers who they perceived as using more of a participatory decision-making style (beta=17.80, p<0.001). Children (beta=-0.10, p<0.05) and caregivers (beta=-0.21, p<0.01) were significantly more satisfied with younger providers. Children were significantly more satisfied with providers who knew them better as a person (beta=2.87, p<0.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Caregivers were more satisfied with providers who they perceived as involving them more during treatment decisions made during pediatric asthma visits."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Providers should attempt to use a more participatory decision-making style with families during pediatric asthma visits."
          }
        ]
      },
