      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To evaluate pathologic findings in appendixes of women undergoing laparoscopic surgery for pelvic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective study (Canadian Task Force classification II-2)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Private practice specializing in gynecologic endoscopic surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "One hundred ninety women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Prophylactic appendectomy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "On pathologic evaluation, 154 appendixes were diagnosed as having one or more abnormal findings, such as endometriosis, carcinoid, chronic appendicitis, periappendicitis, fibrous obliteration, and lymphoid hyperplasia."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Women undergoing laparoscopic surgery for pelvic pain should be counseled on the high frequency of abnormal findings in the appendix, including endometriosis. Prophylactic appendectomy appears to be a worthwhile consideration in these patients."
        }
      ]},
