      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Enclose II is a new device for proximal coronary artery bypass anastomoses. We evaluated the safety and effectiveness of Enclose II in patients who underwent off-pump coronary artery bypass grafting (CABG)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Enclose II was used for isolated off-pump CABG in 178 patients at six heart centers between October 2005 and December 2009. The preoperative characteristics of the patients, complications related to Enclose II, and early graft patency rates were examined."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 222 proximal anastomoses were performed in 178 patients using Enclose II. Forty-four of these patients had two proximal anastomoses using this device. New cerebral infarction that arose in two patients (1.1%) was not related to Enclose II. No aortic injury occurred. The graft patency rate was 96.4% at 1 year after surgery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Enclose II is a safe and useful assist device for proximal anastomoses in patients undergoing off-pump CABG."
        }
      ]},
