      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The purpose of this study was to assess whether depressive symptomatology was associated with vascular endothelial dysfunction in patients with coronary heart disease (CHD)."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "In patients with CHD, the presence of depression is associated with a two to four times increased risk of mortality, but the disease pathways involved are uncertain. Endothelial dysfunction is an established risk factor for cardiovascular events in patients with CHD."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Flow-mediated dilation (FMD) of the brachial artery, a measure of endothelial function, was assessed in 143 patients (99 men, 44 women), ages 40 to 84 years (mean age, 63 +/- 10 years), with documented CHD."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients with significant depressive symptomatology, as indicated by a Beck Depression Inventory (BDI) score > or = 10 (n = 47) showed attenuated FMD (p = 0.001) compared with patients that were not depressed (BDI < 10; n = 96). The use of antidepressant medication was associated with improved FMD (p < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The increased risk of cardiovascular events in CHD patients with elevated symptoms of depression may be mediated, in part, by endothelial dysfunction."
        }
      ]},
