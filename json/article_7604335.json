      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A randomized cross-sectional questionnaire was used to determine the prevalence of neck pain in Norwegian adults."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The frequency and duration of neck pain were assessed."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Reliable epidemiologic studies on the prevalence of neck pain in the general population have been sparse."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A questionnaire that inquired about neck pain within the last year was sent to a random sample of 10,000 adult Norwegians."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Overall, 34.4% of the responders had experienced neck pain within the last year. A total of 13.8% reported neck pain that lasted for more than 6 months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Chronic neck pain is a frequent symptom in the general population, particularly in women. Although reservations have to be taken as to the interpretation, the reported prevalence of persisting pain after whiplash injuries is of the same magnitude as the prevalence of chronic neck pain in the general population."
        }
      ]},
