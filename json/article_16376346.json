      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To examine the relationship between number of livebirths and cesarean sections on the development of menstrual abnormalities."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The effect of number of livebirths and cesarean sections on menstrual abnormalities in the late reproductive period was evaluated using data from the Harvard Study of Moods and Cycles."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were 298 women with no livebirths and 606 women with livebirths of which 184 had a history of cesarean section. Among all women, increasing number of livebirths was associated with an increasing trend in reported heavy menses, prolonged flow >6 days, and a decreasing trend in reported dysmenorrhea. This effect was amplified among women with a history of cesarean section."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Increasing number of livebirths is associated with heavy and prolonged menstrual flow during the late reproductive period. This association is particularly stronger in women with a history of cesarean section."
        }
      ]},
