      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To provide a general overview of informatics and its interface with allergy/immunology."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "The PubMed interface to MEDLINE was searched with the keywords asthma, allergy, or immunology together with the keywords informatics, bioinformatics, and information technology to retrieve the articles relevant to this review."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY SELECTION",
          "content": "The authors' knowledge of the field was used to include sources of information other than those obtained through the MEDLINE search."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A survey of informatics, with emphasis on the relevance to allergy, asthma, and immunology, is presented."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Several innovative informatics approaches have significant potential to improve health care on diverse fronts. Newer methods of information representation are poised to facilitate the impact of cutting-edge research on clinical practice."
        }
