      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe pathways by which families may influence the onset and course of a child's asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We critically reviewed published articles and book chapters to identify research findings and integrated conceptualizations that demonstrate how families affect pediatric asthma."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Family emotional characteristics, asthma management behaviors, and physiological factors account for key influences on pediatric asthma onset and outcomes."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Multiple family characteristics are associated with pediatric asthma onset and outcomes. Behavioral and physiological mechanisms may act independently or may interact to affect asthma manifestations. Families with specific emotional characteristics may be at an elevated risk for poorer asthma outcomes."
        }
      ]},
