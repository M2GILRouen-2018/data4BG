      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The embryo transfer is a critical part of in vitro fertilization. When performed under abdominal ultrasound guidance, the embryo transfer procedure requires a full bladder. Patients often state that the discomfort of the distended bladder causes more pain than the actual transfer procedure. Phenazopyridine HCl is a bladder analgesic. The objective of this study was to determine if a single dose of phenazopyridine prior to embryo transfer reduces patient discomfort during that procedure."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective randomized double-blinded clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University-based Reproductive Medicine practice."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Eighty-five reproductive age infertile women undergoing in vitro fertilization."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Phenazopyridine (200 mg) or placebo taken 1 hour prior to embryo transfer utilizing transabdominal sonography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Pain as assessed by visual analogue pain scale and physician and nurse assessment of patient discomfort."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Study groups were similar in their demographic background. Mean pain score as assessed by a visual analogue pain scale during the procedure was 2.95 +/- 2.4 in the placebo group, and 3.03 +/- 2.6 in the active medication group (NS). There were also no significant differences in the observations of pain assessments."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Phenazopyridine used in a single dose prior to embryo transfer does not alleviate patient discomfort."
        }
      ]},
