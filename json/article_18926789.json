      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To search literature published on the administration of intradermal sterile water injections to women in labour who experience severe low back pain, and to critically evaluate the evidence for therapeutic merit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "A systematic review of six randomised controlled trials from countries including Canada, Denmark, Iran, Sweden and Thailand was conducted."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Statistically significant findings (p<0.0001) of relief of low back pain in labour lasting from 10 min to 2 h post-administration."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Intradermal injections of sterile water possess powerful analgesic benefits for women experiencing low back pain in labour and their use in this therapeutic setting is justifiable."
        }
      ]},
