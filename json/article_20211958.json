      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To develop a psychometrically valid Patient Preferences Questionnaire for Angina treatment (PPQA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Seven general practices across England in 2007."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Convenience sample of 383 patients with diagnosed angina."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Postal self-administered questionnaire survey using the full-length PPQA. This comprised 54 items about the three main treatment modalities for angina: medication, angioplasty and coronary artery bypass grafting."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The full PPQA was reduced to 18 items, six for each of the three subscales (treatment modalities), by standard psychometric methods. The reduced PPQA was psychometrically sound and valid, although confirmatory factor analyses with a larger sample are required."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The PPQA is a potentially useful instrument to help clinicians understand patients' angina treatment preferences."
        }
      ]},
