      "Abstract": {
        "CopyrightInformation": "© 2014 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The assumption that multiple sclerosis (MS) is purely a white matter disease has been challenged in recent years by observations of axonal damage and neuronal loss in gray matter of the cortex, subcortex, and spinal cord."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We report the case of a 71-year-old man with primary progressive MS and longstanding right arm weakness who presented with intermittent right arm pain."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Neurological examination showed atrophy, weakness, and hyporeflexia, and electromyography (EMG) showed acute and chronic partial denervation in multiple segments of the right arm. Magnetic resonance imaging (MRI) demonstrated asymmetric volume loss and increased T2 signal in the right anterior spinal cord from C3 to C7, with no evidence of nerve root compression."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Lower motor neuron involvement of his right arm was caused by MS with involvement of either the anterior horn cells or the intraspinal motor nerve roots."
          }
        ]
      },
