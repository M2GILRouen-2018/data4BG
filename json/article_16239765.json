      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a patient with myalgia and cramps possibly induced by the antimigrainous agent zolmitriptan."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "A 27-year-old woman with episodes of common migraine developed cramps and generalized myalgia after the use of intranasal zolmitriptan 5 mg to treat 3 episodes of migraine. This side effect had not occurred with oral zolmitriptan 2.5 mg."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Myalgia and cramps should be considered a possible dose-dependent adverse effect of zolmitriptan."
        }
      ]},
