      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To evaluate the efficacy, systemic exposure, safety and tolerability of a transdermal oxycodone patch containing tocopheryl phosphate mixture (TPM) in patients with postherpetic neuralgia (PHN)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS & METHODS",
          "content": "The study was a Phase IIa, multicenter, randomized, double-blind, vehicle-controlled crossover study."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "While the TPM/oxycodone patch did not significantly improve 'average' Numeric Pain Rating Scale scores versus vehicle patch, patients reporting high levels of paresthesia (n = 9) showed a trend toward improved pain reduction. The TPM/oxycodone patch resulted in a low systemic exposure to oxycodone and was well tolerated."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The TPM/oxycodone patch delivered oxycodone to the site of perceived pain in subjects suffering from PHN, but did not provide analgesia for the broad PHN indication."
        }
      ]},
