      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare local, spinal, and general anaesthesia for inguinal hemiorraphy in otherwise healthy patients with respect to duration of operation, time in operating room, postoperative pain, complications, rehabilitation, and satisfaction."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective randomised controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital, Turkey."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Seventy-five men with unilateral primary inguinal hernias, Nyhus type II and III, and ASA I and II."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Lichtenstein repairs with standard local, spinal, or general anaesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Duration of operation and anaesthesia, postoperative pain scores, analgesic requirements, complications, length of hospital stay, postoperative rehabilitation, and satisfaction."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "With local anaesthesia, we recorded shorter time spent in the operating room, lower incidence of nausea and urinary retention, and more satisfaction. In the local and spinal anaesthetic groups, postoperative analgesic requirements and length of hospital stay were less than in the general anaesthesia group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Local anaesthesia is suitable for day-case hernia repair with fewer postoperative problems and less analgesia requirement. Patients also reported greater satisfaction. Local anaesthesia may be preferred to other methods."
        }
      ]},
