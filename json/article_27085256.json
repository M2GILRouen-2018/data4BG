      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate relationships among food shopping venues, food environment, and body mass index (BMI)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional survey data and directly assessed food environment data were linked at the neighborhood level."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Schenectady, NY."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "A sample of Guyanese, black, and white adults (n = 226, 485, and 908, respectively)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "BMI."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Linear regression models were constructed with 10 food shopping venues and neighborhood food environment as explanatory variables, controlling for sociodemographics, dietary behavior, physical activity, and perception of healthy food access."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "On average, respondents used 3.5 different food shopping venues. Supermarkets and ethnic markets were associated with a lower BMI in Guyanese adults. Among black adults, farmers' markets were associated with a lower BMI, whereas supermarkets, wholesale clubs, and food pantries were associated with a higher BMI. Among white adults, food coops and supermarkets were associated with a lower BMI and wholesale clubs were associated with a higher BMI. Neighborhoods with less a favorable food environment (longer travel distance to a supermarket) were associated with a lower BMI in Guyanese adults."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Both primary (ie, supermarkets) and secondary food shopping venues could be independent determinants of BMI. The observed variations by race and ethnicity provided insights into a culturally tailored approach to address obesity."
          }
        ]
      },
