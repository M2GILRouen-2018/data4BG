      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of our pictorial essay is to highlight the helical CT features of uncommon mimics of appendicitis and to provide clues to differentiate them from appendicitis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Uncommon mimics of appendicitis create a diagnostic challenge in patients with right lower quadrant pain. Recognition of the helical CT features of uncommon mimics of appendicitis is important in clinical management and avoiding unnecessary laparotomy."
        }
      ]},
