      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "This double-blind, controlled, parallel-group study was designed to determine the efficacy of pre-emptive triple analgesia for paediatric post-tonsillectomy pain management."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "One hundred and thirty-five children were randomised into two groups: pre-emptive triple analgesia (n = 55) and control (n = 80). Pain was assessed using a visual analogue scale (in hospital) and the Parent's Postoperative Pain Measure (at home), and scores recorded."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Visual analogue scale scores on awakening and for 6 hours post-surgery were significantly better in the study group than the control group (p < 0.05). The Parent's Postoperative Pain Measure scores of control group children were significantly higher within the first 3 post-operative days (p = 0.000), with a greater percentage of children experiencing significant pain and requiring more analgesia."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The proposed multimodal, pre-emptive analgesia protocol for paediatric post-tonsillectomy pain results in less post-operative pain, both in hospital or at home."
        }
      ]},
