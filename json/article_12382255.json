      "Abstract": {
        "CopyrightInformation": "Copyright 2002 Wiley-Liss, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Although visual display terminal (VDT) work has become a common task among office workers, surveys which would help to determine the allowable duration of daily VDT use are limited."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We investigated more than 25,000 workers three times over a 3-year period using a self-administered questionnaire. Three factors, namely mental, physical and sleep-related symptoms, were extracted by factor analysis. Adjusted means of each factor score were compared with the duration of daily VDT use by general linear model."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Physical symptoms score became higher with increasing duration of daily VDT use without a threshold effect. Mental and sleep-related symptom scores of the workers using VDT for more 5 hr/day were significantly higher than that of the groups using VDT for >1, 1-3, and 3-5 hr/day."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Duration of daily VDT use was linearly related to the physical symptom score, and was non-linearly related to mental and sleep-related symptom score with a threshold effect of 5 hr/day."
          }
        ]
      },
