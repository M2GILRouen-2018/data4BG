      "Abstract": {
        "CopyrightInformation": "(c) 2007 Wiley-Liss, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim of this study was to compare the procedural characteristics and outcomes of patients with acute myocardial infarction treated with drug-eluting stents (DES) vs. bare metal stents (BMS)."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "DES have been shown to reduce the incidence of restenosis and target vessel revascularization (TVR) in clinical randomized studies when compared with BMS in patients undergoing elective percutaneous intervention. Limited data are available with the use of DES in patients with acute ST-segment elevation myocardial infarction."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Two hundred and sixty-one consecutive patients who presented with myocardial infarction between 7/2001 and 8/2005 were studied. The procedural characteristics, 30-day and 12-month outcomes of 131 patients treated with DES were compared with 130 patients treated with BMS."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "At 12-months follow-up DES therapy was associated with a substantial decrease in major adverse cardiovascular events (MACE) (HR 0.33; P =0.002), TVR (HR 0.19; P =0.002), and recurrent myocardial infarction (HR 0.23; P =0.051) vs. BMS therapy. Coronary interventions utilizing DES were characterized by a marked increase in the number of stent per target vessel (DES: 1.9 +/- 0.9 vs. BMS: 1.38 +/- 0.6, P < 0.0001), treatment of bifurcation (DES: 21% vs. BMS: 5%, P =0.0004), and multivessel intervention (DES: 22% vs. BMS: 8%, P =0.003)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The routine use of DES in acute myocardial infarction is associated with reduced rates of MACE at 12 months vs BMS, despite a higher rate of complex procedures in the DES treated patients. In addition to its anti-restenosis effect, the improved outcome of patients treated with DES may be linked to a more complete revascularization in association with prolonged clopidogrel therapy."
          }
        ]
      },
