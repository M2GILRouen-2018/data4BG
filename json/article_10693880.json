      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Studies suggest, even when controlling for disease severity, socioeconomic status, education, and access to care, racial and ethnic minorities receive lower-quality health care and have worse perceived pain and function before and after total joint arthroplasty."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "QUESTION/PURPOSES",
          "content": "We evaluated the influence of race and ethnicity on well-being, pain, and function after total joint arthroplasty and determined whether race, ethnicity, sex, and joint involvement influenced perceived function and pain after total joint arthroplasty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "We retrospectively reviewed the records of 1749 patients receiving total joint arthroplasty (739 hips and 1010 knees). Sixty-eight percent were women, with a mean age of 65 years at followup. We assessed patients preoperatively and at a minimum of 2 years (mean, 5.1 years; range, 2-16 years) on perceived well-being, function, and pain, as well as clinical assessment tools. Also, we assessed the behavior of dependent measures between groups over time."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Preoperatively, in both TKA and THA candidates, African American patients presented with worse scores. Postoperatively, all patients had substantial improvement, yet African Americans who had TKA or THA continued to have worse scores on some measures. In both TKA and THA, women had worse scores."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Racial and ethnic minorities undergoing hip and knee arthroplasty appear to have worse patient-perceived outcomes (well-being, pain, and function) when compared to whites. This discrepancy is most pronounced for African Americans."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "LEVEL OF EVIDENCE",
          "content": "Level III, therapeutic study. See Guidelines for Authors for a complete description of levels of evidence."
        }
      ]},
