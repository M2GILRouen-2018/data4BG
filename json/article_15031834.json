      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To identify the most common medical complications experienced by stroke survivors during inpatient, tertiary-level stroke rehabilitation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, descriptive analysis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A tertiary-level, 23-bed, inpatient stroke rehabilitation unit in Nova Scotia, Canada."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "All stroke survivors (N=133) admitted for tertiary-level stroke rehabilitation during a 1-year period."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Not applicable."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The attending physiatrist determined the presence or absence of specific complications during the interdisciplinary team conference held during the week of discharge for each patient."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The 4 most common medical complications were depression (26%), shoulder pain (24%), falls (20%), and urinary tract infection (UTI) (15%). Other less common complications included back and hip pain (5%), gastrointestinal disturbances (4%), and pneumonia (2%). Seizures, pressure ulcers, and shoulder-hand syndrome each occurred in 1.5% of the population."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Depression, shoulder pain, falls, and UTIs are common complications experienced by stroke survivors during inpatient rehabilitation. Heightened awareness of these potential complications may lead to prevention or to earlier recognition and improved management of these conditions."
        }
      ]},
