      "Abstract": {
        "CopyrightInformation": "Copyright AULA MEDICA EDICIONES 2014. Published by AULA MEDICA. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The main objective is the reduction of early morbidity and mortality associated with metabolic syndrome (MS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "24h intakes count for 3 days and clinical-nutritional history. Follow-up of 19 visits to monitor the evolution."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Following weight loss, the measurement of capillary blood glucose was 59 mg/dl, discontinuing then treatment with metformin; after 7 days without metformin treatment the value was 64 mg/dl."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Intervention in nutritional education and lifestyle contributed to almost a 10% reduction of body weight; the patient moved from the obesity BMI range to overweight. Peripheral insulin resistance was also enhanced and the GP in charge decided to discontinue the dosing of metformin as a result."
          }
        ]
      },
