      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "ROHHAD syndrome is an exceedingly rare cause of central hypoventilation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE CHARACTERISTICS",
          "content": "A 7-year-old girl with ROHHAD syndrome who had central hypoventilation, rapid weight gain, multiple cardiac arrests and hyperprolactinemia."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "OUTCOME",
          "content": "She required prolonged and repeated ventilation, and finally died due to complications of ventilation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "MESSAGE",
          "content": "ROHHAD Syndrome should be suspected in any child who presents with obesity, behavioral changes or autonomic instability following a neural crest tumor."
        }
      ]},
