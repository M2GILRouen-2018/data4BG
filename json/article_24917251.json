      "Abstract": {
        "CopyrightInformation": "© 2014 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To report on the efficacy of dorsal root ganglion stimulation in a patient with complex regional pain syndrome (CRPS) type I of the knee."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "A 48-year-old woman with CRPS type I of the right knee, diagnosed according to the Budapest criteria set, received DRG stimulation for intractable CRPS type I of the knee."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After a successful trial period with three DRG stimulation leads on spinal levels L2, L3, and L4 (covering 90% of the painful area of her knee), a definitive pulse generator was implanted. Three months after implantation, the entire painful area was covered, and the patient reported a numeric rating scale score of 1-2."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Placement of three DRG stimulation leads at levels L2, L3, and L4 in a patient with intractable CRPS type I of the knee resulted in major pain relief. We recommend further investigation of the effect of DRG stimulation on pain due to CRPS of the knee."
          }
        ]
      },
