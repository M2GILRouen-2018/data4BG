      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To compare the effectiveness of streamlined liner of pharyngeal airway (SLIPA) in paralyzed and nonparalyzed, anesthetized patients undergoing gynecological surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective randomized double-blind clinical trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Intraoperative."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "A total of 80 female patients with American Society of Anesthesiologists class I or II and who were undergoing gynecological surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "The patients were randomly allocated to either the nonparalyzed group (group NR, n=40) or the paralyzed group (group R, n=40)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Oropharyngeal leakage pressure was the primary outcome. Insertion time; number of insertion attempts; success rate at first insertion; involuntary movement; peak inspiratory pressure (PIP); leakage fraction; hemodynamic changes; complications, such as blood tinging, regurgitation, and sore throat; and recovery time were also evaluated for secondary outcomes."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Oropharyngeal leakage pressure, which is primary outcome, was no difference among the groups. Insertion time, number of insertion attempts, success rate at first insertion, involuntary movement, leakage fraction, hemodynamic changes, and complications were not statistically different among the groups. The PIP in group NR was significantly increased compared to that of group R (P=.002). Recovery time was significantly longer in group R than in group NR (P<.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "SLIPA had good performance in both paralyzed and nonparalyzed patients. There was no difference in SLIPA performance or complications irrespective of muscle relaxant use, except decrease in PIP and prolong recovery time in paralyzed patients."
          }
        ]
      },
