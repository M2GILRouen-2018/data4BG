      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Association of Oral and Maxillofacial Surgeons. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The aim of this study was to establish a proper sedative protocol of dexmedetomidine for outpatients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "The study compared compare patients' pain, satisfaction, adverse events, and sedation depth during extraction of third molars using a sedative protocol of intravenous (IV; 1.0 μg/kg) versus intranasal (IN; 1.5 μg/kg) administration of dexmedetomidine. In total, 240 patients were randomized, 160 patients received dexmedetomidine, and data, including the amount of agent used, visual analog scale (VAS) pain score, adverse events, VAS score of patient satisfaction, and bispectral index, were recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patients in the dexmedetomidine groups reported lower VAS pain scores and higher VAS satisfaction scores than patients in the local anesthesia group. There were no statistically meaningful differences between dexmedetomidine groups. Sedation with the IV route was slightly deeper than with the IN route. However, there were no statistically meaningful differences."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "IN or IV administration of dexmedetomidine is recommended as an effective, safe, and competent protocol in outpatient sedative surgeries."
          }
        ]
      },
