      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The aim of this study was to evaluate the effect of CLA supplementation on antioxidant metabolism in healthy overweight/obese Korean individuals."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We performed a randomized, double-blind, placebo-controlled trial, where 29 healthy overweight/obese (BMI ≥ 23 kg/m(2)) participants (2 men and 27 women) were randomly selected to receive placebo (n = 15, 2.4 g olive oil/day) or 2.4 g/day CLA mixture (n = 14, 36.9% of cis-9, trans-11 and 37.9% of trans-10, cis-12) for 8 weeks."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no significant differences in plasma total radical-trapping antioxidant potential (TRAP), lipid peroxidation (conjugated dienes), lipid-soluble antioxidant vitamin concentration, erythrocyte antioxidant enzyme (superoxide dismutase, catalase, glutathione peroxidase) activities, and leukocyte DNA damage between the CLA and placebo groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The data suggest that short-term supplementation (8 weeks) with CLA (2.4 g/day) might have no significant effects on lipid peroxidation and antioxidant metabolism."
        }
      ]},
