      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Radioactive seed localization (RSL) is an alternative to wire localization. We compared the rate of positive margins for evidence of a learning curve in implementing RSL."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A retrospective review of RSL by three surgeons at a single institution from 2002 to 2016. Positive margins were defined as ink on tumor."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Surgeon experience with RSL for ranged from 142 to >500 cases. The positive margin rate among the first 100 of each surgeons' experience (n = 300) was 2.3% and the rate during the most recent up to 100 cases after experience with at least 100 RSL procedures (n = 242) was 4.1% (p = 0.32). Individual surgeon's positive margin rates ranged from 2 to 5% in the early experience and 2-7% in the later experience (p = NS)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "RSL for breast conservation surgery has a low rate of positive margins even early in a surgeon's experience. Implementation of RSL can be done with no evidence of a learning curve."
          }
        ]
      },
