      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the built environment and its relationship to BMI for individuals in eastern Idaho."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Geospatial analyses were coupled to demographic data of adult individuals. ArcGIS Community Analyst was used to compare demographics relative to median BMI."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "For every kilometer increase in distance to prepared food sites, BMI went down by 1.3% and every kilometer increase in distance to green space, BMI went down by 0.8% (p < .001). For every kilometer increase in distance to trails, BMI went up by 1.5%. No other built environment variables had a statistically significant association with BMI."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The distance to prepared foods and trails was associated with expected changes in BMI. Conversely, increased distance to green space was associated with a lower BMI."
        }
      ]},
