      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright 2010 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the coexistence of endometriosis in women presenting with symptomatic leiomyomas."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary university medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "We reviewed the medical records of 131 patients who underwent laparoscopic myomectomy or hysterectomy. All patients were consented for possible concomitant diagnosis and treatment of endometriosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "All patients underwent laparoscopic myomectomy or hysterectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "The main outcome measure of the study was the presence or absence of endometriosis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Of the 131 patients, 113 were diagnosed with endometriosis and fibroids, while 18 were diagnosed with fibroids alone. Patients with fibroids were on average 4.0 years older than those with endometriosis and fibroids (41 vs. 45). Patients with both diagnoses were also more likely to present with pelvic pain and nulliparity than those with fibroids alone."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "An overwhelming majority of patients with symptomatic fibroids were also diagnosed with endometriosis. Overlooking the concomitant diagnosis of endometriosis in these women may lead to suboptimal treatment of the patients. Further studies are needed to evaluate the impact of surgical treatments on symptom resolution."
          }
        ]
      },
