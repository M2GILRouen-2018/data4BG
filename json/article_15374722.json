      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the difference of long-term amenorrhea rate in patients with menorrhagia treated by endometrial laser intrauterine thermal therapy (ELITT), a new nonhysteroscopic endometrial ablation procedure, versus transcervical hysteroscopic endometrial resection (TCRE)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized clinical study. Healthy volunteers in an academic research environment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Academic teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Premenopausal women with abnormal uterine bleeding."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Fifty-eight patients were treated with the ELITT procedure and 58 patients with TCRE; both groups were treated with GnRH agonists before the procedure."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Bleeding status and patient satisfaction after treatment were evaluated as well as the intraoperative complication rate."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "At 12 months, the amenorrhea rate was 56% in the ELITT group and 23% in the TCRE group. At 36 months, the figures were 61% for ELITT and 24% for TCRE. No significant complications were recorded for either procedure."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Results of this randomized study demonstrate that both procedures are equally effective in the treatment of menorrhagia. However, the ELITT procedure has proven to be superior in inducing amenorrhea."
        }
      ]},
