      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "HYPOTHESIS",
          "content": "Adjuvant massage therapy improves pain management and postoperative anxiety among many patients who experience unrelieved postoperative pain. Pharmacologic interventions alone may not address all of the factors involved in the experience of pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Department of Veterans Affairs hospitals in Ann Arbor, Michigan, and Indianapolis, Indiana."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Six hundred five veterans (mean age, 64 years) undergoing major surgery from February 1, 2003, through January 31, 2005."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients were assigned to the following 3 groups: (1) control (routine care), (2) individualized attention from a massage therapist (20 minutes), or (3) back massage by a massage therapist each evening for up to 5 postoperative days. Main Outcome Measure Short- and long-term (> 4 days) pain intensity, pain unpleasantness, and anxiety measured by visual analog scales."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Compared with the control group, patients in the massage group experienced short-term (preintervention vs postintervention) decreases in pain intensity (P = .001), pain unpleasantness (P < .001), and anxiety (P = .007). In addition, patients in the massage group experienced a faster rate of decrease in pain intensity (P = .02) and unpleasantness (P = .01) during the first 4 postoperative days compared with the control group. There were no differences in the rates of decrease in long-term anxiety, length of stay, opiate use, or complications across the 3 groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Massage is an effective and safe adjuvant therapy for the relief of acute postoperative pain in patients undergoing major operations."
        }
      ]},
