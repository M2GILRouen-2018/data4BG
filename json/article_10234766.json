      "Language": "rus",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To compare quantitative characteristics of the lack of conditioning function of the respiratory system (CFRS) and to reveal basic etiopathogenetic factors affecting its severity in patients with various pulmonary and cardiac diseases."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Lack of CFRS was assessed pneumocalorimetrically in 423 patients with chronic nonspecific pulmonary diseases (CNPD) and 322 patients with cardiovascular diseases."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Factors determining the severity of CFRS lack are: nosological unity, disease stage, occupational hazards, severity of respiratory and circulatory insufficiency."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Pneumocalorimetry is useful in diagnosis, for objective evaluation of treatment efficacy and rehabilitation."
        }
      ]},
