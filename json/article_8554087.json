      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To determine whether annular keratotomy can relieve pain associated with bullous keratopathy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Three patients with painful bullous keratopathy and poor visual potential underwent partial-thickness (0.30 to 0.42 mm) trephination of the cornea under local anesthesia."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All patients reported an absence of pain and foreign body sensation during an average follow-up interval of six months. The surgical procedure was uncomplicated; however, two eyes developed increased central corneal stromal edema."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Annular keratotomy appears to be a relatively safe and simple surgical procedure that may be useful in managing pain in eyes with painful cornea edema and poor visual potential."
        }
      ]},
