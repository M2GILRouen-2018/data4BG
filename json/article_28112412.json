      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 John Wiley & Sons, Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "There is evidence that Cognitive Stimulation Therapy and maintenance Cognitive Stimulation Therapy are effective in mild to moderate dementia. There is, however, little evidence available for its implementation in practice and the impact of outreach support on the sustainability of the programme."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Two hundred and forty-one staff members were randomised from 63 dementia care settings between outreach support including an online forum, email, and telephone support, compared to usual Cognitive Stimulation Therapy control group. The primary outcome was average number of attendees to the Cognitive Stimulation Therapy and maintenance Cognitive Stimulation Therapy programmes."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was no difference in average number of attendees between the intervention and usual Cognitive Stimulation Therapy control groups for the Cognitive Stimulation Therapy (p\u2009=\u20090.82) or the maintenance Cognitive Stimulation Therapy programme (p\u2009=\u20090.97)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Outreach support does not affect the average number of people with dementia attending the Cognitive Stimulation Therapy or maintenance Cognitive Stimulation Therapy programme. Irrespective of outreach support, the programmes remain widely implemented and yield perceived benefits for people with dementia. Copyright © 2017 John Wiley & Sons, Ltd."
          }
        ]
      },
