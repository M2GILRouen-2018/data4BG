      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Vascular endothelial growth factor (VEGF) plays a role in asthma and pathological pregnancies."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This is the first study assessing plasma and exhaled breath condensate VEGF levels in asthmatic pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Thirty-one asthmatic pregnant, 29 asthmatic nonpregnant, 28 healthy pregnant and 22 healthy nonpregnant women were enrolled. Plasma was collected in all subjects, EBC in 57 volunteers for VEGF measurements."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Plasma VEGF decreased in both pregnant groups (p < 0.01), without any differences between the asthmatic and the respective nonasthmatic groups (p > 0.05). VEGF was undetectable in EBC."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Concomitant asthma does not affect plasma VEGF during pregnancy."
        }
      ]},
