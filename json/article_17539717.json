      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Little information exists on highly anxious patients referred for periodontal therapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "All patients referred for periodontal therapy between November 1, 2002 and April 1, 2004 were included in this study. Patients who perceived themselves as extremely anxious were interviewed further, and their anxiety levels were observed during the various stages of periodontal therapy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Twenty-one (19 females and two males, average age, 49.76 years) of 176 patients (12.1%) reported extreme anticipatory anxiety. The main reasons for their anxiety were fear of pain and previous bad experience(s)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Average anxiety levels decreased with the progress of the periodontal therapy. However, individual responses varied greatly and were unpredictable."
        }
      ]},
