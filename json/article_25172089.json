      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2014.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare a 12-month home-based exercise programme with usual care for disability and health-related quality of life after rotator cuff repair."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Outpatient physical and rehabilitation medicine clinic."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "Consecutive patients (n=67, mean age 54 years) who underwent rotator cuff repairs were randomized into an experimental group (EG) or a usual care group (UCG)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "The UCG received ordinary postoperative instructions, while the EG were given advice and instructions on a shoulder muscle strengthening programme to be undertaken at home."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN MEASURES",
            "content": "Disability was assessed with the American Shoulder and Elbow Surgeons Standardized Shoulder Assessment Form (ASES), and quality of life with the Short-Form 36 Health Survey (SF-36)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "At the follow-up, no between-group differences were observed in any of the outcomes. The mean (SD) ASES score improved by 21 points (95% CI, 16 to 26, p<0.001) in the EG from the baseline 74 (14) and by 25 points (95% CI, 20 to 31, p<0.001) in the UCG from the baseline 70 (18). Both groups exhibited significant improvements (p<0.001) in the SF-36 physical component score. In the UCG, improvements were observed in the Social Functioning (p=0.034) and Role Emotional (p=0.003) dimensions. In the EG, 57% of the patients completed the exercises twice weekly for the first six months, after which training adherence declined."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The home exercise programme and usual care were equally effective in improving disability and quality of life after rotator cuff repair. The extra time involved in teaching the home exercise programme is not warranted."
          }
        ]
      },
