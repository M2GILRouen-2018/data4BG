      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND CONTEXT",
            "content": "Analgesic effect of lidocaine infusion on postoperative pain."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The aim of this study was to evaluate the analgesic effect of lidocaine infusion on postoperative pain after lumbar microdiscectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "This study used a prospective, randomized, double-blinded, and placebo-controlled clinical trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT SAMPLE",
            "content": "Fifty-one patients participated in this randomized, double-blinded study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "The primary outcome was the visual analog scale (VAS) (0-100 mm) pain score at 4 hours after surgery. The secondary outcomes were the VAS pain score at 2, 8, 12, 24, and 48 hours after surgery, the frequency with which patients pushed the button (FPB) of the patient-controlled analgesia system, and the fentanyl consumption at 2, 4, 8, 12, 24, and 48 hours after surgery. Other outcomes were satisfaction scores regarding pain control and the overall recovery process, incidence of postoperative nausea and vomiting (PONV), and length of hospital stay (HS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Preoperatively and throughout the surgery, Group L received intravenous lidocaine infusion (a 1.5-mg/kg bolus followed by a 2-mg/kg/h infusion until the end of the surgical procedure) and Group C received normal saline infusion as a placebo."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The VAS scores and fentanyl consumption were significantly lower in Group L compared with Group C except at 48 h after surgery (p<.05). Total fentanyl consumption, total FPB, length of HS, and satisfaction scores were also significantly lower in Group L compared with Group C (p<.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Intraoperative systemic infusion of lidocaine decreases pain perception during microdiscectomy, thus reducing the consumption of opioid and the severity of postoperative pain. This effect contributes to reduce the length of HS."
          }
        ]
      },
