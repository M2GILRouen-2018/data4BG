      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To relate our experience with thrombolytic therapy in 8 patients with cardiac metal prosthesis complicated with thrombosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Eight patients with clinical and echocardiographic diagnosis of cardiac valvar prosthesis thrombosis were treated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The treatment efficacy was evaluated by clinical and echocardiographic improvement. The authors recognized improvement in all 8 patients. One case of hemorrhage was observed (coxo-femoral articulation). Late death were observed twice: 24 months after, sudden death and 30 months later by hemorrhagic stroke."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The results indicated that thrombolytic therapy is best way to treat patients with cardiac valve thrombosis, instead of surgical treatment."
        }
      ]},
