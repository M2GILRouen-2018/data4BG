      "Abstract": {
        "CopyrightInformation": "© 2015 NANDA International, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To identify and summarize clinical data supporting selection of nursing diagnoses related to the respiratory system for pediatric and neonatal populations."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A literature review conducted in indexed publications was used."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "The final sample consisted of 13 studies conducted in children with cardiac disease, respiratory infection, and asthma with nursing diagnoses such as ineffective breathing pattern, impaired gas exchange, and ineffective airway clearance."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The higher frequency defining characteristics were dyspnea, abnormal breathing pattern, use of accessory muscle to breathe, change in frequency and respiratory rate, decreased SaO2 , and agitation."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "IMPLICATION FOR NURSING KNOWLEDGE",
            "content": "This literature review may provide a basis for consideration of important diagnostic criteria in the pediatric population; however, clinical validation in different stages of development is critical for ensuring diagnostic accuracy."
          }
        ]
      },
