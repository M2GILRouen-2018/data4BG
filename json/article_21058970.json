      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To explore the experiences of low-income minority adults taking part in a yoga dosing trial for chronic low back pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Individual semi-structured interviews were conducted with nineteen participants recruited from a randomized yoga dosing trial for predominantly low-income minority adults with chronic low back pain. Interviews discussed the impact of yoga on low back pain and emotions; other perceived advantages or disadvantages of the intervention; and facilitators and barriers to practicing yoga. Interviews were audio taped and transcribed, coded using ATLAS.ti software, and analyzed with inductive and deductive thematic analysis methods."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Boston Medical Center, Boston, MA, USA."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Participants viewed yoga as a means of pain relief and attributed improved mood, greater ability to manage stress, and enhanced relaxation to yoga. Overall, participants felt empowered to self-manage their pain. Some found yoga to be helpful in being mindful of their emotions and accepting of their pain. Trust in the yoga instructors was a commonly cited facilitator for yoga class attendance. Lack of time, motivation, and fear of injury were reported barriers to yoga practice."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Yoga is a multidimensional treatment for low back pain that has the potential to favorably impact health in a predominantly low-income minority population."
          }
        ]
      },
