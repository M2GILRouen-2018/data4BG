      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "We describe the case of a 53-year-old woman with hip pain secondary to an obturator hernia. Obturator hernia is uncommon, and the most lethal of all abdominal hernias. The high mortality rate of this disease requires an acute clinical awareness to facilitate rapid diagnosis and surgical intervention for improved prognosis."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "This case highlights a vitally important diagnosis that is rarely discussed in the emergency medicine literature."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "Our patient presented without symptoms typical of a bowel obstruction, although a computed tomography scan of her pelvis revealed an incarcerated obturator hernia and a small bowel obstruction."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Early diagnosis and expeditious surgical management resulted in a good outcome."
          }
        ]
      },
