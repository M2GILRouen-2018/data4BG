      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To identify Paediatric patients with biliary stone disease presenting to a tertiary care hospital in order to determine the etiology, presentation and management."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Retrospective study of all cases of ultrasonographically proven biliary stones under the age of 15 years from January 1988 to December 2008. Data included their risk factors, complications, management and outcome."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Total 32 patients were identified with biliary stones, treated in the hospital. Mean age at presentation was 8.25 +/- 3.33 years. Sixteen patients underwent cholecystectomy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Paediatric cholelithiasis is an atypical and under-diagnosed cause of abdominal pain in childhood. True prevalence of the disease may be higher than reported. Appropriate surgical intervention is required in patients with symptomatic and complicated biliary lithiasis."
        }
      ]},
