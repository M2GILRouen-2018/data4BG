      "Abstract": {
        "CopyrightInformation": "© J. A. Barth Verlag in Georg Thieme Verlag KG Stuttgart · New York.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the impact of variants of the FTO gene (rs1421085, rs17817449, rs9939609) in obese children before and after lifestyle intervention."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Longitudinal, clinical intervention study with an increase in physical activity, and nutritional recommendations based on the 'Optimized Mixed Diet for German Children and Adolescents' (Research Institute of Child Nutrition, Germany)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY POPULATION",
            "content": "75 overweight children (40 male, mean BMI 30.4±5.5 kg/m², mean age 12.6±2.6 years)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Genotyping by means of a TaqMan SNP genotyping assay. Lean and fat mass were determined by means of DXA."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "For the whole study population, the 6-month lifestyle intervention resulted in a significant improvement (before intervention minus time point 6 months; mean±SD) in BMI-SDS (0.10±0.17, p<0.001), HOMA (1.41±3.19, p<0.001) and relative fat-mass-SDS (0.09±0.23, p=0.005). Before and after lifestyle intervention, there was no significant difference between heterozygote (n=52) and homozygote (n=21) carriers of the FTO gene in terms of BMI, body composition, and the metabolic profile (Insulin, HOMA, lipids, liver function tests)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Variants in the FTO gene are common in obese children but have no impact on body composition and metabolism before and after lifestyle intervention."
          }
        ]
      },
