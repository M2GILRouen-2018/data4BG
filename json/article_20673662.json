      "Abstract": {
        "CopyrightInformation": "Copyright (c) 2008 Sociedad Española de Calidad Asistencial. Published by Elsevier España, S.L. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "We performed this study to compare the achievement of lipid targets as well as the change on C reactive protein (CRP) values of two different strategies, the combination of ezetimibe plus statins compared to the doubling of the previous statin dose."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Retrospective longitudinal study of 111 dyslipidemic patients, treated with statins, whose cholesterol values were still elevated. In 59 patients the previous statin dose was doubled, in 52 patients ezetimibe was added to the statin. Differences on lipid parameters and CRP were measured."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patients treated with the association of ezetimibe plus statins obtained a higher reduction of LDL-cholesterol levels (38% vs. 18.1%, p<0.001), compared with those doubling the statin dose. A reduction on CRP values was observed only in patients on combined therapy (22.5%; p<0.005), CRP change was not related to lipids variation. More patients with high coronary risk treated with ezetimibe plus statin, reached lipid goals (LDL<100 mg/dl) compared to those whose statin dose was doubled (47% vs 19%; p<0.001) and the same happened on very high coronary risk patients (LDL<70 mg/dl) (43% vs 2%; p<0,001). More patients in the group ezetimibe plus statin achieved the combined target lipid control and CRP<3 mg/l (19% vs. 3%, p=0.002)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Combination treatment of ezetimibe with statins on high coronary risk patients showed a better achievement of LDL-cholesterol goals with a reduction of CRP values."
          }
        ]
      },
