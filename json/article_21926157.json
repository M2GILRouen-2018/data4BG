      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "The aim was to identify most relevant risk factors of high-altitude headache within a broad mountaineering population through a prospective, observational, rater-blinded study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 506 mountaineers were enrolled after their first overnight stay in one of seven alpine huts between 2200-3817\u2009m. Structured interview including information on mountaineering histories, caffeine intake, smoking habits, alcohol consumption, intake of medication, rate of ascent, physical fitness, the level of exertion and the amount of fluids intake at the day of ascent were recorded along with a standardized medical examination."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "High-altitude headache occurred in 31% of study participants. Logistic regression analysis revealed a migraine history, low arterial oxygen saturation, high ratings of perceived exertion and fluid intake below 2\u2009l to be independent risk factors for the development of high-altitude headache."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Given the high prevalence, high-altitude headache is a relevant medical condition and a better understanding of risk factors has important impact and may facilitate patient behaviour and future study design."
        }
      ]},
