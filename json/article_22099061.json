      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To address how health professionals may inadvertently contribute to the stigmatization of patients with chronic pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Formulation and implementation of the Australian National Pain Strategy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Review of current concepts of stereotyping and stigma, consideration of their relationship to empathy, and how they might impinge upon the clinical encounter."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "The extinction of empathy, which we refer to as \"negative empathy,\" can overwhelm health professionals, allowing the entry of negative community stereotypes of chronic pain sufferers and add to their stigmatization. Prevailing dualistic frames of reference encourage this process."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Greater awareness by health professionals of their own potential, often inadvertent, contribution to the stigmatization of their patients with chronic pain may serve as a basis for an expanded model of clinical engagement."
          }
        ]
      },
