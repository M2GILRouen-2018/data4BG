      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To validate the Thai version of the Oswestry low back pain disability questionnaire."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHOD",
          "content": "The questionnaire was translated into Thai version by two translators and some statements were adapted Back translation was performed by a language professional. The content validity was evaluated by five experts in physical medicine and rehabilitation field. The scores were calculated Then the questionnaire was completed by the patients and data calculated for Cronbach's alpha."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Thirty-two patients who complained of acute low back pain (less than 3 months) completed the Thai version of the questionnaire. The content validity of each item ranged from 0.6-1.0 and the Cronbach's alpha of all items was 0.8107."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The Thai version of the Oswestry low back disability questionnaire was qualified with good internal consistency for measuring acute low back pain in Thai patients."
        }
      ]},
