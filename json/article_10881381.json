      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the role of amitriptyline in the effectiveness of an outpatient protocol for weaning medically complicated children from tube to oral feeding."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Twenty-one children seen in multidisciplinary outpatient feeding teams across 4 sites were recruited to a randomized placebo-controlled trial of a 6-month outpatient treatment protocol with behavioral, oral-motor, nutrition, and medication components."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "All of the children who completed the 6-month program (73%) were weaned to receive only oral feeding, regardless of group assignment. The transition from tube to oral feeding resulted in decreases in body mass index percentile and pain, some improvements in quality of life, and no statistically significant changes in cost."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Amitriptyline is not a key component of this otherwise effective outpatient, interdisciplinary protocol for weaning children from tube to oral feeding."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "TRIAL REGISTRATION",
            "content": "ClinicalTrials.gov: NCT01206478."
          }
        ]
      },
