      "Language": "rus",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To elucidate relationship between presence of ischemic heart disease and 24-hour blood pressure (BP) profile."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Twenty four hour BP index characterizing degree of nocturnal blood pressure fall was measured in patients with hypertension without coronary heart disease (n=65, group 1), with hypertension and effort angina (n=35, group 2), with effort angina and normal BP (n=25, group 3)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Values of 24-hour BP systolic and diastolic index were in group 1 12.7+/-1.3 and 16.0+/-1.1%, respectively, in group 2 5.8+/-2.4 and 7.4+/-3.6%, respectively, in group 3, 6.0+/-2.2 and 6.0+/-3.0%, respectively (p<0.05, groups 2 and 3 vs group 1)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Decreased nocturnal BP lowering could be a compensatory reaction aimed at maintenance of adequate blood flow through stenosed coronary vessels."
        }
      ]},
