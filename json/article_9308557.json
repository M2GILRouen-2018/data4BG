      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Prilocaine-lidocaine emulsion (EMLA) has been used successfully as a local anesthetic in patients undergoing superficial procedures."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of this study was to investigate the analgesic effect of the patch as a local anesthetic for children undergoing a skin biopsy procedure. The effect on both the pain at the injection site and the pain of the biopsy was investigated."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The study was randomized, double blinded, and placebo controlled. Of the 63 children randomly recruited into the study, 60 children were evaluated; the remaining three were withdrawn from the study."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The anesthetic patch was significantly more effective than the placebo patch in decreasing pain at the injection site. No significant difference in pain scores of the biopsy procedure was found between the study groups. No serious side effects were observed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The anesthetic patch reduced the pain experienced by children subjected to a skin biopsy procedure."
        }
      ]},
