      "Abstract": {
        "CopyrightInformation": "© 2015 American Academy of Pain Medicine. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate the association between osmophobia and the characteristics of patients and their headaches, among migraine patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This was a cross-sectional study. Patients who consecutively sought medical attendance in a primary care unit were asked about their headaches over the last 12 months. Those who had migraine were included. A semi-structured interview, the Headache Impact Test and the Hospital Anxiety and Depression Scale were used."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "147 patients had migraine; 78 had osmophobia; 60 had significant anxiety symptoms; and 78 had significant depression symptoms. The mean age of these patients was 43.2 years (± 13.7); 91.2% were women. The mean length of time with complaints of headache was 13.8 years (± 12). Among the migraine patients, those with anxiety, more years of headache history, and phonophobia presented significantly more osmophobia (multivariate logistic regression)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Osmophobia in migraine patients is associated with significant anxiety symptoms, length of headache history, and phonophobia."
          }
        ]
      },
