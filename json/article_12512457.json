      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the anti-oral ulcer action, anti-inflammatory and analgesic effect of Fengsuidan Granules(FSDG)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "FSDG(0.5, 5.0, 10.0 g.kg-1) were administered to experimental animals. The oral ulcer in experimental animals was effected by means of white staphylococcus (sc) and carbolic acid (buming)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Such as acetic acid body turning, hot-plate, auricle inflammation by dimethylbenzene and foot swelling by egg white were used."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Following certain regularities of dose-effect relationship, FSDG has anti-oral ulcer effect, helps reduce and heal the ulcer and works efficaciously in analgesic and anti-inflammatory cases."
        }
      ]},
