      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To investigate the intramuscular changes on sonographic elastography (SE) after low-level static contraction of the masseter muscle, and to clarify the relationship with the total hardness and edematous change."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Ten healthy volunteers performed sustained bilateral biting at 20% of maximal voluntary contraction for 10 min. The SE and magnetic resonance (MR) scans of the masseter muscles were performed before, immediately after, and 10 min after exercise. The masseter muscle elasticity index (MEI) ratio, muscle thickness, and intramuscular soft and hard areas distribution were evaluated on SE images. The signal to noise ratio (SNR), indicating the water content, was measured on MR images."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The soft area ratio showed significant correlations with the water content expressed as SNR. The hard area ratio showed significant correlations with the total muscle hardness expressed as the MEI ratio."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Intramuscular soft and hard areas could be used both clinically and experimentally."
          }
        ]
      },
