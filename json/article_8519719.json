      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND OBJECTIVES",
          "content": "The effectiveness of a continuous infusion of extrapleural bupivacaine for relief of postoperative pain was assessed in patients undergoing posterolateral thoracotomy under general anesthesia by comparing morphine requirements."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Bupivacaine 0.25% was infused at a rate of 5 mL/h through an unkinkable extrapleural catheter that was sited under direct vision at operation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Mean (+/- SD) 24-hour requirements for morphine from a patient-controlled analgesia device were 39 +/- 15 mg for the treated group and 69 +/- 26 mg in the control group (P < .006). Patients in the treated group recorded significantly smaller visual analog scores for pain both at rest (P < .005) and on movement (P < .03) compared to the control group. There were no adverse effects associated with the use of extrapleural bupivacaine in this study."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Continuous extrapleural infusion of bupivacaine through unkinkable catheters sited during thoracotomy resulted in decreased intravenous patient-controlled analgesia use and decreased verbal categoric pain scores at rest and during movement."
        }
      ]},
