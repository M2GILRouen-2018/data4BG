      "Abstract": {
        "CopyrightInformation": "© 2012 Kris. C. P. Vissers. Pain Practice © 2012 World Institute of Pain.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The PainDETECT-Questionnaire (PDQ) helps to identify neuropathic components in patients suffering from pain. It can be used by clinicians in daily practice and in clinical trials."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "The aim of this study is to perform a translation and cross-cultural adaptation of the PDQ for use in the Netherlands and Belgium."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The first phase was to translate and cross-culturally adapt the PDQ to Dutch. The second phase was to assess the face validity in the Netherlands and Belgium using qualitative and quantitative data collection."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The length, the readability, and the clarity of the questionnaire were good for all patients. The questionnaire was judged to have a good layout and to be clearly organized."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The PDQ Dutch language Version is a well translated and cross-culturally adapted questionnaire, which might be useful for screening for neuropathic components of pain in the Netherlands and Belgium."
          }
        ]
      },
