        "CopyrightInformation": "© 2017 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Cerebellar infarction is exceedingly rare in neonates, usually occurring after traumatic birth. Lifelong sequelae can result from cerebellar damage with disorders of motor function, ataxia, and also cognitive dysfunction."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES/METHODS",
            "content": "We report the clinical presentation of a preterm triplet infant delivered by elective cesarean who showed peripheral facial palsy immediately after birth."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Tonic seizures with high-voltage discharges over the contralateral cerebral hemisphere and secondary generalization were successfully treated with phenobarbital. Transnuchal ultrasound through the foramen magnum and subsequent MRI examinations revealed infarction of the left cerebellar hemisphere."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In newborn infants, acute cerebellar stroke may have direct epileptogenic potential."
          }
        ]
      },
