      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To describe the level of co-morbidity in patients with sight-threatening diabetic retinopathy in the United Kingdom."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Questionnaires were completed by patients undergoing first photocoagulation treatment for diabetic maculopathy or proliferative retinopathy during a 2 month period throughout the UK."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Overall 15% of patients described angina, 9% had suffered a myocardial infarction and 6% a stroke. Self-reported renal disease was present in 8.5%. Foot ulceration was described by 10% of patients, and 4% had undergone an amputation. 35.5% of patients were on treatment for hypertension. 17.5% of patients had been hospitalised in the previous 6 months, and 3% of patients had died within 9 months of the laser treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "There was significant co-morbidity in these patients, which may affect the management of their retinopathy."
        }
      ]},
