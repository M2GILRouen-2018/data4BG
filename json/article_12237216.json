      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate whether pain-related fears are mediators for reducing disability and pain in patients with Complex Regional Pain Syndrome type 1 when treating with Pain Exposure Physical Therapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "An explorative secondary analysis of a randomised controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Fifty-six patients with Complex Regional Pain Syndrome type 1."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "The experimental group received Pain Exposure Physical Therapy in a maximum of five treatment sessions; the control group received conventional treatment following the Dutch multidisciplinary guideline."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Levels of disability, pain, and pain-related fears (fear-avoidance beliefs, pain catastrophizing, and kinesiophobia) were measured at baseline and after 3, 6, and 9 months follow-up."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The experimental group had a significantly larger decrease in disability of 7.77 points (95% CI 1.09 to 14.45) and in pain of 1.83 points (95% CI 0.44 to 3.23) over nine months than the control group. The potential mediators pain-related fears decreased significantly in both groups, but there were no significant differences between groups, which indicated that there was no mediation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The reduction of pain-related fears was comparable in both groups. We found no indication that pain-related fears mediate the larger reduction of disability and pain in patients with Complex Regional Pain Syndrome type 1 treated with Pain Exposure Physical Therapy compared to conventional treatment."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "TRIAL REGISTRATION",
          "content": "International Clinical Trials Registry NCT00817128."
        }
      ]},
