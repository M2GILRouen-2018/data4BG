      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine changes in health-related quality of life (HQOL) following coronary artery bypass surgery (CABS) in elderly patients and to compare patient ratings with proxy ratings."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive, nonrandomized, prospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Patients from a single primary care facility in a major urban centre within a one-year period."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "All eligible patients undergoing CABS at the site within a one-year period were approached for study participation. The study sample consisted of 18 patients 65 years of age or older and 18 proxies at baseline. Fourteen patients and 13 proxies completed follow-up assessments."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "All patients underwent CABS. HQOL was studied using the Sickness Impact Profile (SIP) and the Psychological Well-Being Schedule (PGWB)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MAIN RESULTS",
          "content": "Significant improvements were noted in physical, social and psychological functioning (P < 0.05). Proxies' reports provided good indications of patient functioning for these dimensions with significant differences found only for certain preoperative measures including the total SIP score and the Anxiety and Depression subscales of the PGWB (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Patients 65 years of age and older accrue improvements in HQOL following CABS. Such findings may influence the allocation and justification of various medical procedures. Proxy ratings closely reflected the patients' own ratings and may therefore be considered a reliable, alternate source of information."
        }
      ]},
