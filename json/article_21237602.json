      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To investigate the relationship between cardiac output, end diastolic volume and the contrast enhancement in coronary CT angiography using 320-detector CT."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "A total of 38 patients underwent coronary CT angiography by using a 320-detector CT scanner (detector configuration, 320 × 0.5mm). The attenuation value of the ascending aorta at the level of the orifice of the left main trunk was measured. The cardiac output (CO), end diastolic volume (EDV) and stroke volume (SV) were measured by echocardiography. The EDV was normalized to the body surface area (BSA). The total blood volume injected from the left ventricle from the beginning of the contrast agent injection to the time of image acquisition was determined to be the total injected blood volume (TIV), which is a product of SV and the number of heart beats from the initiation of contrast agent injection to the scan."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was a negative correlation between the attenuation of the ascending aorta and CO (r = -0.44, P = 0.0053). However, the negative correlation between the attenuation of the ascending aorta and TIV was stronger (r = -0.52, P = 0.0007). There was a negative correlation between the attenuation of the ascending aorta and EDV/BSA (r = -0.45, P = 0.0039)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "In 320-detector CT, contrast enhancement in CCTA with a lesser amount of contrast medium decreases when cardiac output is high. Patients with larger EDV/BSA may also show decreased attenuation."
          }
        ]
      },
