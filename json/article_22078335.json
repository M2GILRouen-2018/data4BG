      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 European Association of Urology. Published by Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Obese patients have a greater risk of adverse pathologic features and biochemical recurrence after radical prostatectomy (RP). The impact of body mass index (BMI) on the risk of reclassification and deferred treatment in active surveillance (AS) programs has not been thoroughly assessed."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the impact of BMI on the risk of reclassification for AS eligibility."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN, SETTING, AND PARTICIPANTS",
            "content": "We assessed 230 men who underwent an immediate RP and were eligible for AS according to the following criteria: prostate-specific antigen (PSA) ≤ 10 ng/ml, clinical stage T1c, Gleason score ≤ 6, fewer than three positive cores, extent of cancer in any core <50%, and life expectancy >10 yr."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "All patients underwent a standardised 21-core biopsy and RP at our department between January 2001 and December 2010."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Reclassification was defined as upstaged disease (pathologic stage >pT2) and/or upgraded disease (Gleason score ≥ 7; primary Gleason pattern 4) in RP specimens. PSA outcomes were also recorded."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "RESULTS AND LIMITATIONS",
            "content": "Mean BMI was 26.4 kg/m(2), and 13% of patients were obese (BMI >30). Mean BMI was the only preoperative factor significantly associated with the risk of upstaged disease. In multivariate analysis, BMI >30 remained an independent predictive factor for upstaged disease (p=0.003; odds ratio: 4.2). The risk of upgraded disease (primary Gleason pattern 4) was significantly decreased 4.5-fold in large prostate glands (>50 ml; p=0.008). The biochemical recurrence-free survival curves were not significantly different between men who were or were not overweight (p=0.950)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Obese men are at higher risk of upstaged disease, with a proportion of 30% of pT3 disease in RP specimens. BMI should be taken into account for inclusion of low-risk prostate cancer patients in AS programs, and our results may help urologists better inform their obese patients eligible for AS about this risk of reclassification and improve treatment decision making."
          }
        ]
      },
