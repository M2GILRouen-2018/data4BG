      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 The Canadian Society of Clinical Chemists. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "We hypothesized that patients with coronary atherosclerosis have increased plasma levels of cathepsin S (CATS) and cathepsin B (CATB) mRNA, the genes that are involved in atherosclerotic plaque development and destabilization."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "mRNAs were isolated from plasma of 67 patients with coronary atherosclerosis (29 with stable angina, 38 with acute coronary syndrome) and 33 healthy subjects as controls, transcribed to cDNA and quantified by real-time PCR."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Plasma levels were successfully measured in all samples. Patients with coronary atherosclerosis had 2.75 times higher plasma levels of CATS mRNA than controls (median 6.10 vs. 2.22; p<0.001). No difference was observed in CATB mRNA levels (median 5.62 vs. 6.19; p=0.866). Patients on therapy with statins and aspirin tended to have higher plasma levels of CATS mRNA than patients without statins and aspirin (median 6.41 vs. 4.27; p=0.028)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Further evaluation of plasma CATS mRNA levels in patients with coronary atherosclerosis is reasonable."
          }
        ]
      },
