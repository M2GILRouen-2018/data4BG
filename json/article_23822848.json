      "Abstract": {
        "CopyrightInformation": "© 2013, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose of this study was to examine the influencing factors of postoperative pain among children undergoing elective surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "A survey was conducted in 2011 with a convenience sample of 66 children, 6 to 14 years old, in a tertiary hospital in Singapore."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Children experienced moderate preoperative anxiety and postoperative pain. Gender, preoperative anxiety, and negative emotional behaviors were significant influencing factors for postoperative pain. Boys reported less postoperative pain than girls."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Effective strategies for assessing and managing children's preoperative anxiety are needed to achieve an optimal postoperative pain management outcome."
          }
        ]
      },
