      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Information is limited regarding the preferred method of delivery when the placenta is underlying the site of the uterine incision."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "Three patients with placenta previa illustrate the successful use of a technique that avoids incising the underlying placenta. An iatrogenic partial separation of the placenta is created to rupture the membranes and deliver the infant."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This reproducible technique is offered as an alternative to transecting the underlying placenta at cesarean delivery."
        }
      ]},
