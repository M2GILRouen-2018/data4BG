      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "to explore the experiences of women suffering low back and/or pelvic pain during pregnancy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "a qualitative design using focus groups. Each group was recorded with a digital audio recorder and analysed using the Newell and Burnard framework for thematic analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "an urban maternity hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "a self-selecting sample of 14 women who had taken part in a pilot randomised controlled trial investigating reflexology for pregnancyrelated low back and / or pelvic pain."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND FINDINGS",
            "content": "the group discussions were guided by a pre-determined schedule of questions designed to investigate women's experiences of pregnancyrelated low back and / or pelvic pain. Three main themes emerged:"
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "KEY CONCLUSIONS",
            "content": "low back and/ or pelvic pain affected women physically and emotionally during pregnancy. Their attitudes towards, and knowledge about the conditions differed. Women used a range of self-help strategies for their symptoms and there was a general sense of dissatisfaction with routine advice and treatment, a finding supported by a growing body of research."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR PRACTICE",
            "content": "given that pregnancy-related low back and/ pelvic pain occur across the world, and affects the majority of pregnant women, heath care providers need to ensure that standard care provided is meeting women's needs. Health care professionals may require specific training in order to effectively provide individualised and evidence-based advice and support to pregnant women experiencing this pain."
          }
        ]
      },
