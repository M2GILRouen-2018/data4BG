      "Abstract": {
        "CopyrightInformation": "© The Author 2016. Published by Oxford University Press. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Rheumatoid arthritis (RA) commonly reduces hand function. We systematically reviewed trials to investigate effects of home hand exercise programmes on hand symptoms and function in RA."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SOURCES OF DATA",
            "content": "We searched: Medline (1946-), AMED, CINAHL, Physiotherapy Evidence Database, OT Seeker, the Cochrane Library, ISI Web of Science from inception to January 2016."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "AREAS OF AGREEMENT",
            "content": "Nineteen trials were evaluated. Only three were randomized controlled trials with a low risk of bias (n = 665). Significant short-term improvements occurred in hand function, pain and grip strength, with long-term improvements in hand and upper limb function and pinch strength."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "AREAS OF CONTROVERSY",
            "content": "Heterogeneity of outcome measures meant meta-analysis was not possible."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "GROWING POINTS",
            "content": "Evaluation of low and moderate risk of bias trials indicated high-intensity home hand exercise programmes led to better short-term outcomes than low-intensity programmes. Such programmes are cost-effective."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "AREAS TIMELY FOR DEVELOPING RESEARCH",
            "content": "Further research is required to evaluate methods of helping people with RA maintain long-term home hand exercise."
          }
        ]
      },
