      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case is reported."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of intraosseous lipoma involving the lamina of the first thoracic vertebra."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Intraosseous lipomas involving the spine rarely have been reported."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "An incidental intraosseous lesion of the lamina of the first thoracic vertebra documented on magnetic resonance imaging was surgically excised and pathologically evaluated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The histologic findings were consistent with those for intraosseous lipomas previously reported in other bones."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The authors present a rare case of an intraosseous lipoma involving the lamina of the first thoracic vertebra."
        }
      ]},
