      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Arab Journal of Gastroenterology. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND STUDY AIMS",
            "content": "Ligation-excision haemorrhoidectomy is considered to be the gold-standard treatment for prolapsed haemorrhoids. The procedure is commonly done under general or regional anaesthesia. This study aimed to assess the feasibility and tolerability of open haemorrhoidectomy under local anaesthesia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "This is a prospective study carried out in Obafemi Awolowo University Teaching Hospital Complex, Ile-Ife, Nigeria, over a 5-year period. All consenting adult patients with prolapsing haemorrhoids were offered Milligan-Morgan haemorrhoidectomy under local anaesthesia. They were assessed for tolerance and complications."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "More than 95% of the patients tolerated the procedure with manageable complications."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Open excisional haemorrhoidectomy under local anaesthesia is feasible, safe and well tolerated in our environment, and may encourage early presentation of patients with piles to hospital."
          }
        ]
      },
