      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "To highlight a case of recurrent atraumatic anterior hip dislocation management using a dual mobility prothesis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The stability of the patient's hip was assessed using X-ray and MRI scans. Upon the third spontaneous anterior dislocation it was decided with the patient's consent to undergo a total hip replacement. A piriformis sparing anterior approach was use with the insertion of a dual mobility bearing. This consisted of an uncemented porous titanium cup articulating with a 28 mm head in a 42 mm mobile polyethylene liner."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Mobilising pain free at 6 weeks post operation with no further dislocations at 6 months follow up."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Dual mobility hip replacements was used successfully in our patient with recurrent atraumatic anterior hip dislocation."
        }
      ]},
