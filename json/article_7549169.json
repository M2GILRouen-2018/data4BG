      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This trial aimed to study moclobemide, a reversible, Type-A selective monoamine oxidase inhibitor, in patients with chronic neuropathic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Pain clinic patients suitable for antidepressant therapy were treated for 2 months in an open label, uncontrolled trial with moclobemide 150-600 mg/day."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Visual analog scores of pain and affective symptoms, a side-effect checklist, and clinical global impressions of efficacy and tolerability."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The trial was terminated after assessment of seven patients; partial analgesic activity was discernible only in one, and beneficial mood effects notable in two others. Significant adverse effects, particularly insomnia and GI disturbance, were reported by the majority of patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Moclobemide appears to have limited efficacy in the treatment of neuropathic pain."
        }
      ]},
