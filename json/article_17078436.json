      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the therapeutic effects of point application of medicated cakes for prevention and treatment of recurrent asthma in children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Point application of medicated cakes was performed in 60 asthmatic children at the remission stage, with its effect compared with that of ketotifen used in the control group of 30 cases."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "With a total effective rate of 85%, the point application of medicated cakes was found to be superior to that of the control group (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Point application of medicated cakes is a simple, effective and safe therapy for asthmatic children."
        }
      ]},
