      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the relationship between the diameter of the common bile duct and the incidence of bile duct stones in non-jaundiced patients with recurrent attacks of right epigastric pain after cholecystectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital, Finland."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "57 consecutive, non-jaundiced patients admitted for elective endoscopic retrograde cholangiopancreatography (ERCP) because of attacks of right epigastric pain after cholecystectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Measurement of maximum diameter of the common bile duct and presence or absence of bile duct stones."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Diameter of bile duct (10 mm or less was regarded as normal) and presence or absence of stones."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "33 patients had normal-sized bile ducts and in 24 they were widened. Only 2/33 patients with normal-sized ducts (6%) had stones, compared with 11/24 (46%) with wide ducts (p = 0.0008). However, the degree of ductal dilatation did not seem to have any influence on the presence or absence of stones."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Bile duct stones are unlikely after cholecystectomy in patients who are not jaundiced and have a normal-sized common bile duct. However, nearly half of the patients with a wide common bile duct had stones, but the degree of dilatation was not important."
        }
      ]},
