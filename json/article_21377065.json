      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Formosan Medical Association & Elsevier. Published by Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND/PURPOSE",
            "content": "Drug-eluting stents (DESs) have been shown to reduce in-stent restenosis and target vessel revascularization (TVR) in large clinical trials. We conducted this study to elucidate the differences in the cost and clinical outcome of DESs and bare metal stents (BMSs)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We retrospectively analyzed the clinical data and costs of patients with stable angina treated with coronary stents from September 2003 to January 2005 at the National Taiwan University Hospital, Taipei, Taiwan."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We enrolled 186 patients treated with DESs and 194 patients treated with BMSs. The use of DESs is associated with a lower rate of TVR compared with that with BMSs (12%vs. 22%, p = 0.011). Compared with the BMS group, the overall costs were significantly higher in the DES group (NT$352,495 ± 140,408 vs. NT$298,947 ± 131,289, p<0.001). The incremental cost to avoid one TVR at 2 years was NT$546,444 (95% confidence interval: NT$151,071-2,565,793)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The use of DESs reduces the rate of TVR at 2 years after intervention, but is probably not cost-effective compared with BMSs in patients with stable coronary artery disease."
          }
        ]
      },
