      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To compare the analgesic efficacy of ultrasound-assisted transversus abdominis plane (TAP) block and wound infiltration during the first postoperative 24hours."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A prospective, observer-blinded, randomized, and controlled study"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Operating room of a university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Forty patients received a TAP block (TAP group) and 40 patients received wound infiltration (INF group) at the end of the surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients were randomized to receive a TAP block or wound infiltration. Postoperative analgesics were administered on request and selected based on pain severity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Pain scores, analgesic drug requirement, and side effects were observed for 24hours."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Postoperative pain scores were lower in TAP group compared to INF group (P<.001). Analgesic consumption was significantly higher at the 5th minute and 1st, 6th, and 12th hours in the INF group (P<.001). The frequency of additional analgesic use in home and the total analgesic used during the postoperative 24hours were significantly higher in INF group (P<.001). Side effects were lower in the TAP group. Parent's satisfaction scores were higher in TAP group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Transversus abdominis plane block is effective method with convenient technique, drug dosage, and volume in pediatric patients undergoing inguinal hernia surgery."
          }
        ]
      },
