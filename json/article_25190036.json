      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 National Association of Pediatric Nurse Practitioners. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "There are many barriers to treating children with asthma. Barriers limit access with subsequent disturbances in quality outcomes. This study explored the difference in quality outcomes, utilization outcomes, parental knowledge, and barriers to care between children who had controlled versus uncontrolled asthma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Data were analyzed between two intact groups of caregivers of children with asthma. Caregivers in both groups completed the Asthma Knowledge Test and the Asthma Barrier Questionnaire."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Caregivers (n = 62) were primarily mothers (85.5%). Children with uncontrolled asthma missed 33.3% more days of school. The caregivers of the children with controlled asthma answered more questions on the Asthma Knowledge Test correctly and had a lower score on the Asthma Barrier Questionnaire."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Asthma control is essential. By identifying barriers to care, health care providers can build an action care plan to individualize each patient's needs."
          }
        ]
      },
