      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Extracranial metastases of pineal germinomas are rare."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "The case of a metastasis of a primary intracranial germ cell tumor via a temporary-ventriculo-peritoneal shunt as a cause of acute abdominal pain is reported. The germ cell tumor markers were useful in establishing the diagnosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "With an appropriate clinical history, intra-abdominal metastases via a temporary ventriculo-peritoneal shunt should be considered in the differential diagnosis of acute abdominal pain."
        }
      ]},
