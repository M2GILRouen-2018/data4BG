      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We describe continuous maxillary nerve block at the pterygopalatine fossa and investigate the efficacy of this technique for perioperative pain control in oral surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Sixteen patients undergoing radical maxillary sinusotomy were enrolled; group I (n = 8) received general anesthesia without maxillary nerve block, and group II (n = 8) received maxillary nerve block before general anesthesia. The intraoperative concentration of sevoflurane, the extent of blockade, and total analgesics (diclofenac sodium) needed after surgery were recorded."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The mean sevoflurane concentration was significantly lower in group II. Diclofenac sodium consumption was significantly reduced in group II."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Indwelling maxillary nerve catheter methods decrease anesthetic consumption and provide good postoperative analgesia."
        }
      ]},
