      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case of multiple psoas abscesses after Dove lumbar spine fixation is reported."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To review the diagnosis and treatment of deep infection after internal spinal fixation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The possibility of septic complications after spinal surgery that may present with a degenerative pattern is examined. The clinical and computed tomographic findings of a psoas abscess are recalled."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Surgical drainage of the purulent collection was performed along with prolonged parenteral antibiotic treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Infection should be considered as a cause of recurrence of pain after internal fixation of the lumbar spine."
        }
      ]},
