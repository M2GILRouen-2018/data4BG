      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the manifestations of Behcet's disease (BD) in the digestive tract and its differential diagnosis from common inflammatory bowel diseases."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The symptoms and endoscopic, X-ray's or surgical characteristics of 24 cases of Behcet's disease with digestive tract manifestations were analysed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The lesions mainly occurred in tileocecum, and frequently led to hemorrhage that required surgery. The recurrent rate was as high as 77.7%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Importance should be attached to early diagnosis of BD of the digestive tract to prevent serious complications."
        }
      ]},
