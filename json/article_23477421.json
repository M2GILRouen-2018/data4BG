      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "Stem cell transplant can induce vasculogenesis and improve the blood supply to an ischemic region, offering hope for chronic lower extremity ischemic diseases. Bone marrow mononuclear cells are one of the sources for stem cell transplants. We sought to observe the safety and efficacy of autologous bone marrow mononuclear cells transplant for treating critical limb ischemia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Eligible patients were randomized 1:1 to receive placebo (0.9% NaCl) or 1 × 107 piece/mL bone marrow mononuclear cell transplant. For 6 months, patients' skin ulcers, ankle-brachial index, and rest pain were examined and recorded before and after treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Six months after the bone marrow mononuclear cells transplant, clinical symptoms like rest pain and skin ulcers gradually abated (P < .05). Ankle-brachial index also increased after the transplant (P < .01)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Autologous bone marrow mononuclear cells transplant for treatment of patients with chronic limb ischemia is safe, effective, and feasible."
        }
      ]},
