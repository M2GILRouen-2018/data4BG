      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 American Society for Gastrointestinal Endoscopy. Published by Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Most outcomes data on pancreatic extracorporeal shock wave lithotripsy (P-ESWL) for chronic calcific pancreatitis (CCP) are based on studies with <4 years' follow-up, and U.S. long-term studies are lacking."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To report long-term P-ESWL outcomes for CCP and to assess whether smoking or alcohol use influences P-ESWL outcomes."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional study, retrospective chart review."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Virginia Mason Medical Center, Seattle, Washington."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "This study involved 120 patients who underwent P-ESWL and ERCP for CCP and completed an outcomes questionnaire."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "P-ESWL and ERCP, outcomes survey."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASUREMENTS",
            "content": "Pain, quality of life, narcotics use, diabetes status, pancreatic enzyme requirement, repeat P-ESWL, repeat ERCP, surgery."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 120 patients underwent P-ESWL followed by ERCP (mean ± standard deviation [SD] follow-up 4.3 [± 3.7] years) and completed a survey. The mean (± SD) before-P-ESWL pain score was 7.9 (± 2.6) compared with 2.9 (± 2.6) after P-ESWL (P < .001). Improved pain was reported by 102 patients (85%); 60 (50%) reported complete pain relief and no narcotic use. The mean (± SD) before-P-ESWL quality-of-life score was 3.7 (± 2.4) compared with 7.3 (± 2.7) after P-ESWL (P < .001). In patients with ≥ 4 years' follow-up, repeat procedures included P-ESWL (29%), ERCP (84%), and surgery (16%). Smokers who quit smoking after P-ESWL had improved narcotic requirements compared with those who continued smoking (95% vs 67%; P = .014), and a trend suggested a decreased need for repeat ERCPs (68% vs 84%; P = .071)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "Single center, retrospective, recall bias, nonvalidated pain and quality-of-life scales."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "P-ESWL as the initial therapy for CCP may lead to more lifetime procedures; however, partial pain relief in 85%, complete pain relief with no narcotic use in 50%, and avoidance of surgery in 84% of patients may be achieved. Quitting smoking after P-ESWL may improve outcomes."
          }
        ]
      },
