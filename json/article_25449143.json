      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Primary Care Diabetes Europe. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS",
            "content": "The aim of this study is to find factors associated with metabolic syndrome in obese individuals and thus offer guidance to stay metabolically healthy if obese."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A cardiovascular screening programme performed in Finland during the years 2005-2007, identified 901 obese white individuals. Of them, 269 (30%) were metabolically healthy according to the Harmonization criteria of metabolic syndrome."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In multivariate logistic regression analysis, male sex [odds ratio (OR) 1.44 (95% CI 1.01-2.07)], living alone [OR 1.77 (95% CI 1.18-2.65)], physical inactivity [OR 3.73 (95% CI 1.24-11.24)], and use of betablockers [OR 2.63 (95% CI 1.75-3.95)] were associated with metabolic syndrome."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Even mild or occasional physical exercise is beneficial to health in obese individuals. Betablockers may not be the antihypertensive agents of choice when treating obese hypertensive individuals."
          }
        ]
      },
