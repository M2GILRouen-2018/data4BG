      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the frequency of symptomatic and asymptomatic herniated discs and root compression in patients with lumbosacral radicular syndrome (LRS) and to correlate clinical localization with MRI findings."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Fifty-seven patients with unilateral LRS were included in the study. Using the visual analogue scale, two physicians independently localized the most likely lumbar level of complaints. These clinical predictions of localizations were correlated with the MRI findings."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "MRI showed abnormalities on the symptomatic side in 42 of 57 patients (74%). In 30% of the patients, MRI confirmed an abnormality at the exact same level as determined after clinical examination. On the asymptomatic side, MRI showed abnormalities in 19 of 57 patients (33%), 13 (23%) of these patients had asymptomatic root compression."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In more than two-thirds of the patients with unilateral LRS there was no exact match between the level predicted by clinical examination and MRI findings. These discrepancies complicate the decision whether or not to operate."
        }
      ]},
