      "Abstract": {
        "CopyrightInformation": "© 2016, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To describe the effects of physical exercise/activity on the vascular architecture of children and adolescents, as well as to identify the effects of inflammation and sedentary behaviors on this relationship."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Potentially relevant articles were identified in the databases MEDLINE and PubMed covering the period from 2000 to 2015. No language restrictions were applied."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Thirteen articles were found that included obese boys and girls in their samples (aged 9-19). Six interventional studies assessed inflammation and in five of these, physical exercise decreased inflammation. In 10 studies, vascular architecture was affected by physical exercise/activity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The impact of physical exercise on vascular architecture and inflammation seems relevant, but has been mainly investigated in obese groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICAL IMPLICATIONS",
            "content": "Health professionals should act together in organized interventions in schools, targeting the promotion of higher physical activity levels in children and adolescents."
          }
        ]
      },
