      "Abstract": {
        "CopyrightInformation": "© 2015 World Institute of Pain.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim of this study was to adapt the \"Neuropathic Pain Impact on Quality-of-Life Questionnaire\" (NePIQoL) into Turkish and to test its validity and reliability in neuropathic pain patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We enrolled 200 chronic pain patients who admitted to the Neurology Department of Kirikkale University, Faculty of Medicine, in our study. Patients were diagnosed with neuropathic or nociceptive pain based on medical history, physical examination, electromyography and nerve conduction studies, laboratory examinations, and imaging techniques. Discriminant analysis was used to diagnose the neuropathic pain regarding sensitivity and specificity. The original version of the NePIQoL was translated into Turkish by standard procedures."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Total NePIQoL scores were statistically different between neuropathic and nociceptive pain patients in both the first and second NePIQoL applications (P < 0.001). Cronbach's alpha coefficient of total 12 items of the first and second applications was 0.95. These results suggest a high validity level for the Turkish version of the NePIQoL."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The Turkish version of NePIQoL appears to be reliable and valid for neuropathic pain impact on quality of life in patients with neuropathic pain."
          }
        ]
      },
