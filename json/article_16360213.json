      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To determine the incidence of significant postoperative intraocular pressure (IOP) elevation and other adverse medical events during the first postoperative day in patients undergoing inpatient vitreoretinal surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Noncomparative interventional case series."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Two hundred two consecutive patients were admitted prospectively as inpatients after vitreoretinal surgery (vitrectomy and/or scleral buckling)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Intraocular pressure was measured preoperatively, 5 to 12 hours postoperatively, and on postoperative day 1. Additionally, pain, nausea, and serious systemic adverse events were monitored."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Seventeen patients (8.4%) had a 5- to 12-hour IOP measurement above 29 mmHg. Thirty patients (14.8%) had a postoperative day 1 IOP measurement above 29 mmHg. Three patients (1.5%) required a parenteral narcotic to achieve adequate analgesia. Nine patients (4.5%) utilized a parenteral antiemetic for nausea control. Six patients (3.0%) had a hyperglycemic event. No serious systemic adverse events occurred in the early postoperative period."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The incidence of a significant IOP spike or systemic adverse events in the early postoperative period in patients undergoing vitreoretinal surgery is low."
        }
      ]},
