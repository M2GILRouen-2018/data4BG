      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "RATIONALE",
          "content": "Ascariasis is an endemic parasitic disease caused by Ascaris lumbricoides, which severely burdens the healthcare system as well as harms the personal life quality, especially among less developed regions. Biliary ascariasis is a critical complication of intestinal ascariasis with painful and life-threatening manifestations. The exploration of proper strategies as its medical interventions remains largely controversial."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "PATIENT CONCERNS",
          "content": "A 16 year-old patient complained of abdominal pain and yellow sclera."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "DIAGNOSES",
          "content": "Biliary ascariasis INTERVENTIONS:: Laparoscopic cholecystectomy and bile duct exploration."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "OUTCOMES",
          "content": "More than one hundred ascarids were extracted and the patient had been discharged from hospital without any complications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "LESSONS",
          "content": "The combination of laparoscope and choledochoscope is an efficient method to treat biliary ascariasis, despite of large worm burden in the common bile duct."
        }
      ]},
