      "Abstract": {
        "CopyrightInformation": "© 2017 EAN.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND PURPOSE",
            "content": "The aim was to identify potential genetic risk factors associated with sporadic inclusion body myositis (sIBM)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "An association based case-control approach was utilized on whole exome sequencing data of 30 Finnish sIBM patients and a control cohort (n = 193). A separate Italian cohort of sIBM patients (n = 12) was used for evaluation of the results."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Seven single nucleotide polymorphisms were identified in five genes that have a considerably higher observed frequency in Finnish sIBM patients compared to the control population, and the previous association of the genetic human leukocyte antigen region was confirmed."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "All seven identified variants could individually or in combination increase the susceptibility for sIBM."
          }
        ]
      },
