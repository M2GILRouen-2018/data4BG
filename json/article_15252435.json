      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To demonstrate the effects of a program, directed at homecare nurses, of structured educational interventions on the management of pain and opioid-related side effects in homecare patients with cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A longitudinal multilevel, randomized, controlled clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Midwestern region in the United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "202 nurses caring for patients with cancer recruited from homecare agencies."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The two-tiered educational program focused on basic and advanced pain management strategies, particularly in the area of pharmacologic options and assertive communication skills. Instruments used were the Nurses' Knowledge and Attitudes Survey Regarding Pain, the barriers questionnaire, perception of control over pain, and a demographic questionnaire."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Knowledge and attitudes about pain management, barriers to pain management, and perception of control over pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Nurses in the intervention group had a significant increase in their knowledge, a more positive attitude about pain management, fewer perceived barriers to pain management, and an increase in perceived control over pain compared to the nurses who did not receive the intervention."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The educational program Power Over Pain has beneficial effects for homecare nurses caring for patients with cancer pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "A need exists for homecare nurses to gain more insight into pain management strategies and enhance their advocacy skills to improve pain management for patients with cancer treated in the home."
        }
      ]},
