      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To describe the development of a peer support intervention and test an enhanced version compared to a standard protocol."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants (N = 36 females) were assigned to an Enhanced Peer Support (PS) vs Standard weight loss group for 4 months. The PS component consisted of skills training and practice between sessions using social networking."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The PS group perceived significantly more peer support and experienced higher levels of social interaction. When meeting frequency decreased, the PS group showed an increase in overall types of support from group members."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Findings suggest that an intervention targeting peer support skills results in greater feelings of peer support."
        }
      ]},
