      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "The development of outpatient surgery was one of the major goals of public health policy in 2010. The purpose of this observational prospective study was to evaluate the feasibility of laparoscopic sleeve gastrectomy (SG) in an ambulatory setting."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Study design was a prospective prospective observational, nonrandomized study, registered (ClinicalTrials.gov identifier: NCT01513005), with institutional review board approval and written informed consent."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Amiens University Medical Center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Patients undergoing SG who were preselected by inclusion ambulatory criteria."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "All patients operated on for obesity by laparoscopic SG, from May 2011 through July 2013."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "We collected outcomes data on 100 patients including incidence of postoperative nausea and vomiting, maximum and average pain scores, and the overall satisfaction rate."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Of the 100 obese patients, 93% were women. The mean age was 36 years (22-55 years). The mean preoperative body mass index was 42.4 kg/m(2). The mean operating time was 60 minutes (range, 30-95 minutes). The overall satisfaction rate was 93% (n = 93). When leaving the postoperative care unit, 94% of patients felt no or mild pain. Eighty-two percent had no postoperative postoperative nausea and vomiting, and 7 patients needed treatment using ondasetron."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Laparoscopic SG in an ambulatory setting is feasible with a dedicated anesthesiological approach and an expert surgical team. Appropriate patient selection is important for ensuring safety and quality of care within the outpatient program."
          }
        ]
      },
