      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Société française de pharmacologie et de thérapeutique. Published by Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "Acetaminophen is widely used in hospital settings and often considered as nontoxic. We conducted a multicentric study in order to evaluate its proper use."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Prescriptions from five general hospitals were analyzed, according to dose adjustments required in renal or liver failure, weight or chronic alcoholism, determined using a literature review. Other criteria have been assessed: indication for parenteral access, accuracy of administration time and pain assessment."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Among the 1256 analyzed prescriptions, 21% are non-compliants. The main causes of non-compliance (NC) are adjustments to weight and renal failure. Higher NC rates concern chronic alcoholism and liver failure."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Misuse of acetaminophen seems related to a lack of official recommendations concerning dose adjustments. Hospital pharmacists have an important role to play in the promotion of proper use of acetaminophen. Therefore we established a prescribing aid."
          }
        ]
      },
