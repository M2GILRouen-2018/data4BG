      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The optimal imaging strategy for patients with stable chest pain is uncertain."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the cost-effectiveness of different imaging strategies for patients with stable chest pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Microsimulation state-transition model."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Published literature."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "TARGET POPULATION",
          "content": "60-year-old patients with a low to intermediate probability of coronary artery disease (CAD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "TIME HORIZON",
          "content": "Lifetime."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "PERSPECTIVE",
          "content": "The United States, the United Kingdom, and the Netherlands."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Coronary computed tomography (CT) angiography, cardiac stress magnetic resonance imaging, stress single-photon emission CT, and stress echocardiography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Lifetime costs, quality-adjusted life-years (QALYs), and incremental cost-effectiveness ratios."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS OF BASE-CASE ANALYSIS",
          "content": "The strategy that maximized QALYs and was cost-effective in the United States and the Netherlands began with coronary CT angiography, continued with cardiac stress imaging if angiography found at least 50% stenosis in at least 1 coronary artery, and ended with catheter-based coronary angiography if stress imaging induced ischemia of any severity. For U.K. men, the preferred strategy was optimal medical therapy without catheter-based coronary angiography if coronary CT angiography found only moderate CAD or stress imaging induced only mild ischemia. In these strategies, stress echocardiography was consistently more effective and less expensive than other stress imaging tests. For U.K. women, the optimal strategy was stress echocardiography followed by catheter-based coronary angiography if echocardiography induced mild or moderate ischemia."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS OF SENSITIVITY ANALYSIS",
          "content": "Results were sensitive to changes in the probability of CAD and assumptions about false-positive results."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "LIMITATIONS",
          "content": "All cardiac stress imaging tests were assumed to be available. Exercise electrocardiography was included only in a sensitivity analysis. Differences in QALYs among strategies were small."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Coronary CT angiography is a cost-effective triage test for 60-year-old patients who have nonacute chest pain and a low to intermediate probability of CAD."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "PRIMARY FUNDING SOURCE",
          "content": "Erasmus University Medical Center."
        }
      ]},
