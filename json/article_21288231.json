      "Abstract": {
        "CopyrightInformation": "© 2011, Copyright the Authors. Journal compilation © 2011, The American Geriatrics Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To design, implement, and assess an educational intervention for providers focused on osteoporosis screening and management in older patients with chronic obstructive pulmonary disease or asthma who have been prescribed prolonged courses of oral or high-dose inhaled corticosteroids or both and are therefore at high risk for bone loss and fractures."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "One-group pretest-posttest."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Academic outpatient pulmonary practice."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Nineteen pulmonary specialists at an academic medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Educational theory and a needs assessment and attitude survey guided the development of a multicomponent educational intervention."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Change in provider behavior was assessed by auditing the electronic medical records for adherence to osteoporosis management guidelines in high-risk patients seen by participants at baseline and for 6 months after the educational intervention. Knowledge transfer and changes in attitude were assessed using pre- and posttests and surveys."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A 19% increase in overall rate of adherence to osteoporosis management guidelines in high-risk patients was observed: 45% before intervention to 64% after intervention (n=249 patients, P=.003). Postintervention surveys and test scores also showed statistically significant gains from baseline."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "An educational intervention improved adherence to osteoporosis management guidelines of academic pulmonary specialists. The results of this study provide evidence for the positive effect of a multimodal educational program in altering practice behaviors."
          }
        ]
      },
