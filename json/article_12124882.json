      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the application and efficacy of TNF-α inhibitors in the treatment of SAPHO syndrome."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Two cases of refractory SAPHO syndrome were successfully treated with etanercept. And pain scores, laboratory parameters and functional index were used to judge the efficacies. Literature was also systemically reviewed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Both patients achieved marked clinical remission. There was no obvious toxic or adverse response."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Etanercept has rapid and definite efficacies in the treatment of patients with refractory SAPHO syndrome."
        }
      ]},
