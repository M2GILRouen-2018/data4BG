      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "When cognitive impairment precludes patients' report of symptoms, it becomes necessary to use other means. The purpose of our study was to evaluate the validity of the method currently in use on our service."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Two members of the team simultaneously assessed the patient and independently recorded whether the patient showed signs of discomfort, and a third questioned patients with cognitive failure who maintained some ability to respond if something was bothering them."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Some 200 assessments were made of 116 patients. The kappa coefficient of agreement was 0.615. The sensitivity was 17% and specificity 99%. The positive predictive value was 88%, and the negative predictive value was 73%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SIGNIFICANCE OF RESULTS",
          "content": "Due to the low sensitivity of this method, it cannot be recommended as a screening tool."
        }
      ]},
