      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "This study aims to explore the prevalence and impact of psychiatric disorders on the likelihood of an organic, neurological explanation for symptoms among neurology referrals."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Consecutive new adult neurology referrals were screened for psychiatric disorders (PRIME-MD) prior to evaluation by neurologists, blinded to these results. Diagnoses were stratified into three categories: no neurological diagnosis, neurological-headache, and neurological-nonheadache."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of 235 patients enrolled, 79 (34%) received no neurological diagnosis, 54 (23%) headache and 102 (43%) a neurological diagnosis. Overall, 39% had an underlying psychiatric disorder. Patients with psychiatric disorders were less likely to have a neurological diagnosis (RR: 0.66, 95% CI: 0.48-0.90): 25% of patients with a neurological diagnosis had an underlying psychiatric disorder, compared to 43% among those with no diagnosis and 57% among those with headaches."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Psychiatric disorders are common among neurology referrals, particularly those with headaches and are associated with a decreased likelihood of an underlying neurological process."
        }
      ]},
