      "Abstract": {"AbstractText": [
        {
          "Label": "UNLABELLED",
          "content": "The aim of the study was to measure pre- and postoperative quality of life of the old patient to find out his profit of open heart surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "71 patients ranging from 75 to 86 years (mean 77.6 years) were examined by using a standard interview about their quality of life on the day of hospital admittance and one year after returning home (range 11-14 months)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was an improvement of postoperative quality of life. These results were similar to data reported in the literature after investigating younger patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "No one should be excluded from open heart surgery because of old age."
        }
      ]},
