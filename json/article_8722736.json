      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This is a report of a trial of the new antiepileptic agent gabapentin in patients with intractable neuropathic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A case series of patients with a diagnosis of neuropathic pain whose previous management was inadequate were given oral gabapentin in increasing doses and were followed for a minimum of 2 months, monitored for efficacy and side effects."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "An outpatient pain management center located within a major university medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Convenience sample of patients referred for management of intractable neuropathic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Simplification of existing pharmacologic management, addition of gabapentin, and attempted reduction of opiate analgesic doses."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Patient self-reports and pain scores in successive office visits."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Gabapentin provides analgesic activity for patients with neuropathic pain and has the advantage of a low side effect profile and drug toxicity."
        }
      ]},
