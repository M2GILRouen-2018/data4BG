      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether a transtheoretical model-based exercise stage-matched intervention (ESMI) has positive effects on the exercise behavior of sedentary patients with coronary heart disease (CHD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The study was a randomized controlled trial with a repeated measures design. Participants (N=196) were randomly allocated to either a conventional (C) group, a patient education (PE) group, or an ESMI group. Exercise behavior was measured by exercise stages of change, exercise self-efficacy, exercise decisional balance, and duration of moderate exercise at baseline, immediate post-intervention, and at 3- and 6-month follow-up."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Our results showed that the ESMI group demonstrated a more positive shift in exercise stages of change (p<0.01), higher exercise self-efficacy (p<0.01), greater exercise benefits (p<0.01), fewer exercise barriers (p<0.01), and longer moderate exercise duration (minutes/week) (p<0.01) after completion of the 8-week intervention compared with the C and PE groups. These significantly positive effects were maintained at 3- and 6-month follow-up."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The transtheoretical model-based ESMI had significantly positive effects on the exercise behavior of sedentary CHD patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "It is important to provide a structured education program for CHD patients, preferably guided by the transtheoretical model."
          }
        ]
      },
