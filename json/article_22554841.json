      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We assessed the effect PRP injection on pain and function in patients with lateral epicondylitis where conservative management had failed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We prospectively reviewed 34 patients. The mean follow-up was 26 weeks (range 6-114 weeks). We used the Oxford Elbow Score (OES) and progression to surgery to assess outcomes."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "88.2% improved their OES. 8.8% reported symptom progression. One patient had no change. No patients suffered adverse reactions. Two patients underwent an open release procedure. One had the injection repeated."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "An injection of PRP improves pain and function in patients suffering from LE where conservative management has failed."
        }
      ]},
