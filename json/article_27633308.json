        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the profile of TB/multidrug-resistant TB (MDR-TB) among household contacts of MDR-TB patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Close contacts of MDR-TB patients were traced in the cross-sectional study. Different clinical, radiological and bacteriological were performed to rule out the evidence of TB/MDR-TB."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Between January 2012 and December 2012, a total of 200 index MDR-TB patients were initiated on MDR-TB treatment, out of which home visit and contacts screening were conducted for 154 index cases. Of 610 contacts who could be studied, 41 (17.4%) were diagnosed with MDR-TB and 10 (4.2%) had TB. The most common symptoms observed were cough, chest pain and fever."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The high incidence of MDR-TB among close contacts emphasize the need for effective contact screening programme of index MDR-TB cases in order to cut the chain of transmission of this disease."
          }
        ]
      },
