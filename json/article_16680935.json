      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Amprenavir, a human immunodeficiency virus type 1 (HIV-1) protease inhibitor, is approved for the treatment of HIV infection in combination with other antiretroviral agents in treatment-naive and experienced patients. Amprenavir is generally well tolerated. However, cutaneous hypersensitivity reactions to amprenavir occur in up to 28% of patients, with treatment discontinuation required in 3% of cases."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report successful desensitization to amprenavir after the occurrence of a maculopapular exanthem in an HIV-infected patient with late-stage disease and limited antiretroviral treatment options."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Incremental doses of 0.025, 0.1, 0.25, 1, 2.5, 7.5, 25, 50, 100, 300, 600, and 1,200 mg of amprenavir oral solution were administered via percutaneous endoscopic gastrostomy tube at 20- to 30-minute intervals."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The patient successfully tolerated amprenavir desensitization and has continued therapy without recurrence of rash at 19 months of follow-up."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Desensitization may permit the continued use of amprenavir in HIV-positive patients with a history of amprenavir-induced maculopapular eruptions who have limited alternate treatment options."
        }
      ]},
