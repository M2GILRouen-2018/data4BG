      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate fetal aortic Doppler for the prenatal diagnosis of hemoglobinopathies in the first trimester of pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Between January and November 2014, a total of 108 patients were enrolled in the study. The couples were carriers of either alpha/beta thalassemia, sickle cell disease or combined carriers of these and were admitted to Çukurova University Faculty of Medicine, Department of Obstetrics and Gynecology Prenatal Diagnosis Center. One hour before the chorionic villus sampling (CVS), patients were evaluated using fetal aortic Doppler. Pulsatility index, peak systolic velocity, and heart rate were noted."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no statistically significant differences in Doppler indices between different groups of CVS results when compared with the healthy controls."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Fetal aortic Doppler investigation was found to be ineffective for the prenatal diagnosis of hemoglobinopathies."
        }
      ]},
