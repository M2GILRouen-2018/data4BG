      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Different clival lesions have been reported in the literature previously. The lymphangioma reported in the present case seems to be the first lesion localized in the clivus."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CLINICAL PRESENTATION",
          "content": "The patient presented with a history of diplopia and headache. Imaging studies showed a lytic lesion at the cranial base."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Transsphenoidal excision of the lesion resulted in total resolution of the patient's complaints."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Lymphangioma must be kept in mind for the differential diagnosis of lytic lesions of the cranial base. Surgical removal leads to immediate improvement of the symptoms."
        }
      ]},
