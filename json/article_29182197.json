      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Knowing nurses' workload in hemodialysis units allows a better organization of human resources."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To determine nurses' workload according to dependence and risk profiles of patients undergoing chronic hemodialysis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "One hundred fifty one patients from five hemodialysis units were selected and categorized in terms of dependence and risk using the instrument \"Care according to dependence and risk in hemodialysis (CUDYR-DIAL). Nurses' activities for direct and indirect care and the time taken to complete those activities were measured."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Per patient, nurses used 36.5 ±10.7 min for direct and 23.6 min for indirect care. The time required for direct care of patients at high risk with partial dependence and at high risk and partial self-sufficiency was 41.2 and 40.3 minutes respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "During a dialysis session, nurses occupy 60% of their time providing direct care, mainly directed to patients categorized as being of high risk-partial dependence and high risk-partial self-sufficiency."
        }
      ]},
