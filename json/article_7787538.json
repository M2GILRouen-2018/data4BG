      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the early results of combined coronary artery bypass graft surgery and carotid endarterectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective and ongoing analysis of patients who underwent combined coronary artery bypass graft surgery and carotid endarterectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Cardiothoracic unit in a London teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "From June 1987 to March 1995, 64 patients were identified. They were patients who were scheduled to have coronary artery bypass graft surgery or required urgent coronary revascularisation and who were found to have significant coexistent carotid disease. (Unilateral carotid stenosis > 70%, bilateral carotid stenosis > 50%, or unilateral carotid stenosis > 50% with contralateral occlusion.)"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Both procedures were performed during one anaesthesia: the carotid endarterectomy was performed first without cardiopulmonary bypass. After completion of carotid endarterectomy, coronary artery bypass graft surgery was performed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The incidence of stroke, transient ischaemic attack, and myocardial infarction in the early postoperative period was analysed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Myocardial revascularisation was successful in all 64 patients. There were no perioperative infarcts. In three patients (4.7%) a new neurological deficit developed postoperatively: two recovered fully before hospital discharge."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Combined coronary artery bypass graft surgery and carotid endarterectomy were performed safely and with good results."
        }
      ]},
