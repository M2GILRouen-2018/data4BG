      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine correlates of compensatory weight control behaviors among women in transition between adolescence and adulthood."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "The authors recruited a sample of undergraduate women (N = 759) at a large northwestern university during the 2009-2010 academic year."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Logistic regression was used to assess relations among childhood abuse, psychosocial functioning, adult dating relationship factors, and women's endorsement of compensatory weight control behaviors."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The final model reliably distinguished between participants who endorsed versus denied use of compensatory behaviors (χ(2)[5, N = 747] = 36.37, p < .001), with global psychosocial functioning and relationship avoidance accounting for the most variance."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These findings illustrate the importance of considering childhood abuse histories and adult relationships while assessing young women's compensatory weight control behaviors."
        }
      ]},
