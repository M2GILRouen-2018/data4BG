      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "ISSUES AND PURPOSE",
          "content": "Early adolescents diagnosed with asthma have difficulty accepting their condition. This study is part of an ongoing program of research designed to increase understanding of the adolescent process of coming to acceptance. The purpose was to explore relationships among variables in the Acceptance of Asthma Model."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND METHODS",
          "content": "A cross-sectional, theory-testing design with a sample of 94 students ages 9 to 14 years."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Acceptance was dependent on psychosocial influences and disease characteristics rather than knowledge of asthma."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "PRACTICE IMPLICATIONS",
          "content": "Psychosocial interventions are needed to facilitate acceptance."
        }
      ]},
