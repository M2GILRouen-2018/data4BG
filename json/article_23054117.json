      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Optimal pain control after major surgery contributes to a patient's recovery and satisfaction. The use of liposomal bupivacaine in subcostal transversus abdominis plane (TAP) blocks for postoperative pain control after robot assisted abdominal surgery has yet to be studied."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We conducted a prospective randomized controlled observer-blinded study comparing bilateral subcostal TAP blocks with bupivacaine to bilateral subcostal TAP blocks with liposomal bupivacaine. These were performed prior to the patient undergoing robot assisted hysterectomy. The patients' pain scores, opioid use, side effects, and satisfaction were followed for 72h after injection."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Total opioid use in the first 72h after injection was significantly decreased in the group that received liposomal bupivacaine compared to bupivacaine. Patients in the liposomal bupivacaine group had significantly lower maximal pain scores at all time periods studied as well as decreased incidence of nausea/vomiting. There was a trend toward decreased length of stay in the liposomal bupivacaine group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Subcostal TAP blocks with liposomal bupivacaine decreased the total opioid requirement for the first 72h after robot assisted hysterectomy when compared to subcostal TAP blocks with bupivacaine."
          }
        ]
      },
