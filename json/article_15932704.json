      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To analyse the impact of sirolimus-eluting stents (SES) on long-term outcomes in patients with coronary artery disease (CAD) and diabetes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Among 1004 patients with CAD undergone percutaneous coronary intervention (PCI), 84 diabetic and 250 non-diabetic patients received SES, 168 diabetic and 502 non-diabetic patients had bare metal stent (BMS) implantation. Baseline clinical characteristics, interventional procedures (coronary angiography and PCI), occurrence of major adverse cardiac events (MACE), and MACE-free survival rates at one year during follow-up were compared."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "During follow-up (average 16.2 months), patients (with and without diabetes mellitus) who received SES had similar occurrence of MACE (4.8% vs. 3.6%, P = 0.744) and MACE-free survival rates at one year (95.0% vs. 96.7%, P = 0.602). However those received BMS had a higher occurrence of MACE in diabetes mellitus than that in non-diabetic patients (31.0% vs. 21.7%, P = 0.015). MACE-free survival rate at one year was lower in diabetic patients with BMS than that in non-diabetic patients with BMS (74.2% vs. 86.8%, P = 0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Implantation of sirolimus-eluting stents may reduce the major adverse cardiac events and the frequency of repeat intervention in patients with diabetes mellitus."
        }
      ]},
