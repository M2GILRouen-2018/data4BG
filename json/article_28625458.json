      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "This study aimed to compare the impact of stylet application for tracheal intubation for postoperative pharyngeal pain or hoarseness in patients undergoing elective surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized clinical trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Operating room."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Forty adult patients scheduled for elective surgery under tracheal intubation with an ASA physical status of 1-3."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Tracheal intubation was performed by anesthesiologists with stylet group (Stylet group; 20 patients) or without stylet group (Control group; 20 patients)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Incidence of postoperative pharyngeal pain or hoarseness was assessed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "The incidence of postoperative pharyngeal pain was significantly higher in the Stylet group (10/20 patients) than in the Control group (2/20 patients) (P=0.013). The incidence of hoarseness did not significantly differ between the Stylet group (6/20 patients) and the Control group (3/20 patients) (P=0.45)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Stylet use increases the incidence of postoperative pharyngeal pain."
          }
        ]
      },
