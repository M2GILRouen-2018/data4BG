      "Abstract": {
        "CopyrightInformation": "© 2010 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "We present a case of surgical correction of an aberrant left coronary artery arising from the right sinus of Valsalva."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "In order to prevent stenosis and kinking of the neo-ostium, modified unroofing technique was combined with patch angioplasty."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The clinical outcome was excellent with complete preservation of ventricular function, resolution of angina, and absence of aortic regurgitation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Addition of patch angioplasty to the unroofing technique improves outcome."
          }
        ]
      },
