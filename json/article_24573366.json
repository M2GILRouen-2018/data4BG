      "Abstract": {
        "CopyrightInformation": "© The Author 2014. Published by Oxford University Press on behalf of Faculty of Public Health. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "This study aimed to investigate recent trends in the prevalence and parameters of dyslipidemia and rates of lipid-lowering medication use in Korean adults. Trends in lipid profiles in subjects with hypertension, diabetes or obesity were also studied."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Data from the Korea National Health and Nutrition Examination Survey in 2005, 2008 and 2010 were used in this study. A total of 17 009 subjects participated in this study."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was a declining trend in the prevalence of dyslipidemia and an increasing trend in the rates of use of lipid-lowering medication among Korean adults. In both men and women, the age-adjusted mean high-density lipoprotein cholesterol level linearly increased. There was a significantly decreasing trend in the age-adjusted mean triglycerides in women and age-adjusted mean lipid-related ratios in both sexes. The age-adjusted mean total cholesterol level showed a slightly increasing trend and the age-adjusted mean low-density lipoprotein cholesterol level was not changed in both sexes. These patterns persisted among subjects not taking lipid-lowering medication. The favorable trends were also observed in subjects with hypertension, diabetes and obesity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our study showed favorable trends in the prevalence of dyslipidemia and in several lipid profiles among Korean adults."
          }
        ]
      },
