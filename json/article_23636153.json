      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effect of a social cognitive theory (SCT)-based intervention on the constructs of situational perception, behavioral capabilities, outcome expectations, outcome expectancies, and self-efficacy concerning over-the-counter (OTC) pain medications among an adolescent population."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Pre-posttest control group design."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Rural high school in the southeastern United States, between February and March 2011."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "203 high school students recruited from 10 classrooms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Classrooms were randomly assigned to an SCT-based education intervention group or the control group. Pre- and posttest data were collected from each group 2 weeks before and 2 weeks after the intervention was delivered."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Change in the five selected constructs of SCT."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Compared with the control group, significant improvements at posttest were observed in the intervention group for outcome expectations of OTC pain medications ( P ≤ 0.05) and behavioral capabilities ( P ≤ 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The results suggest that lessons based on SCT to improve the outcome expectations that an adolescent population places on the consumption of OTC pain medications may assist in developing the knowledge and skills needed to consume these products properly."
        }
      ]},
