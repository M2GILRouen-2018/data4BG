      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of this case report is to describe the chiropractic management of an 8-year-old girl with nonorganic, primary nocturnal enuresis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CLINICAL FEATURES",
          "content": "An 8-year-old female patient presented to a chiropractic clinic with persistent nighttime bedwetting. The patient experienced enuresis, on average, 7 nights per week. The patient presented with no other comorbidities or complaints, such as low back or pelvic pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "INTERVENTION AND OUTCOMES",
          "content": "Chiropractic treatment included high-velocity, low-amplitude manipulation of the left sacroiliac joint over 3 visits. Follow-up at 3 months revealed only 3 subsequent episodes of nocturnal enuresis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This patient reported the resolution of nonorganic, primary nocturnal enuresis after receiving a series of side-posture chiropractic manipulations of the left sacroiliac joint."
        }
      ]},
