      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To evaluate the effect of multidisciplinary treatment on obesity and health-related quality of life (HRQOL)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Obese children were randomized to a multidisciplinary lifestyle treatment, including medical, nutritional, physical, and psychological counseling during 3 months, (n = 40, BMI-SDS; 4.2 ± 0.7, age; 13.3 ± 2.0) or standard care, including an initial advice on nutrition and physical activity by the pediatrician (n = 39, BMI-SDS; 4.3 ± 0.7, age; 13.1 ± 1.9). At baseline, after 3 months of treatment and at 12 months follow-up, data were collected for BMI-SDS and a European validated questionnaire for assessing HRQOL (DISABKIDS)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A significantly reduced BMI-SDS was found for the intervention group after 3 months treatment (4.0 ± 0.9 vs. 4.2 ± 0.7, P = 0.02) and at 12 months follow-up (3.8 ± 1.1 vs. 4.2 ± 0.7, P = 0.03). HRQOL in the intervention group was significantly improved at 12 months follow-up and unchanged in the obese control group. Agreement between child and parent report was moderate (67-85%), with parents reporting a lower HRQOL for their obese children than children themselves in both groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Multidisciplinary treatment is effective in reducing BMI-SDS and improving HRQOL after 12 months follow-up."
        }
      ]},
