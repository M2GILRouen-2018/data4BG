      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Patients with chronic pelvic and perineal pain often report diffuse, poorly systematized symptoms and the aetiological work-up can often be difficult. The purpose of this article is to propose a series of diagnostic algorithms to facilitate the aetiological work-up of chronic pelvic and perineal pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "A review of the literature was performed by searching PubMed for articles on chronic pelvic and perineal pain. Diagnostic algorithms were established by starting with symptoms to define syndromes."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Algorithms were established for the various types of chronic pain: perineal pain, bladder pain, epididymotesticular pain, urethral pain, vulvar pain, inguinal pain, male dyspareunia, female dyspareunia and diffuse pelvic and perineal pain. A clinical assessment and complementary investigations were proposed for each algorithm to establish an aetiological diagnosis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The proposed algorithms are designed to be a clinical aid and do not constitute a comprehensive diagnostic approach to chronic pelvic and perineal pain."
          }
        ]
      },
