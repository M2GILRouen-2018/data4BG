      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the analgesic efficacy of oral tramadol hydrochloride and oral diclofenac sodium for posttonsillectomy pain management."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Single-blind (surgeon and research team members), prospective, randomized, controlled clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "Sixty-four patients 11 years and older undergoing bipolar electrocautery tonsillectomy were randomized to either the oral tramadol or the oral diclofenac postoperative pain group. Patients recorded pain levels twice daily for 14 days using a visual analogue scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pain scores for the 14 days were not significantly different between the oral tramadol and oral diclofenac groups. There were no significant differences in the incidence of postoperative hemorrhage and hospital readmission for uncontrolled pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Oral tramadol can deliver the same analgesic efficacy as oral diclofenac for posttonsillectomy pain relief, which might be beneficial for avoiding the adverse effects of nonsteroidal anti-inflammatory drug therapy."
        }
      ]},
