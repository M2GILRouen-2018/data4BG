      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Postpartum headache after peridural anesthesia is usually attributed to accidental perforation of the dura causing postlumbar puncture headache."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "In a patient with persistent headache after peridural anesthesia for labor, a chronic subdural hematoma was diagnosed 5 weeks postpartum."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Caution is warranted in patients with peridural anesthesia for labor who present with unusually persistent headache."
        }
      ]},
