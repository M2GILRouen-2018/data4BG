      "Abstract": {
        "CopyrightInformation": "Copyright © 2011. Published by Elsevier Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The association between smoking and asthma remains unclear and has mostly been assessed in cross-sectional studies, with potential selection bias (\"healthy smoker effect\")."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS",
            "content": "Using a longitudinal approach, the aims were to assess whether 1) childhood asthma modifies smoking initiation, 2) active smoking influences asthma incidence in adults and 3) active smoking among subjects with asthma influences the persistence of the disease or the 12-year evolution in lung function in children and adults."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Subjects (513 children and 1190 adults) were recruited and followed-up for 12 years in the context of the EGEA study (Epidemiological study on the Genetics and Environment of Asthma)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Childhood asthma was not associated with a decreased probability of starting active smoking (Hazard Ratio, HR = 0.96; 95% confidence interval (CI): 0.72, 1.27). Smoking at baseline was associated with a higher risk for asthma incidence in adulthood (HR = 1.95, 95% CI: 1.00, 3.77). Among subjects with asthma, smoking was unrelated to lung function evolution; however, among children with moderate to severe asthma at inclusion, smoking tended to slow down the lung function growth (P = 0.04)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These findings support the hypothesis that childhood asthma does not prevent smoking initiation and confirm that active smoking has a deleterious role on asthma. Altogether this study emphasizes the importance of active smoking as a serious public health problem particularly for children and women."
          }
        ]
      },
