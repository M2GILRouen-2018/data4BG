      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aims of the project are to increase knowledge related to opioids and improve adherence to evidence-based interventions for sedation monitoring and assessment in adult inpatients receiving opioids for pain through delivery of an interprofessional online program."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Preventable opioid-induced respiratory depression is a patient safety risk in hospitals. Sedation and respiratory assessment and monitoring guidelines and tools are available to improve practice."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "An interprofessional team identified organization-specific drivers of opioid-induced sedation and respiratory depression using process improvement methodology, developed interventions, and evaluated clinician opioid knowledge and documentation practice."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Opioid knowledge survey responses improved after the interventions. Audits showing improved appropriate documentation by RNs of the correct sedation scale were performed over 2 separate 3-month periods."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Clinicians demonstrated increased knowledge about newly adopted sedation and monitoring practices targeted to prevent opioid-induced respiratory depression."
        }
      ]},
