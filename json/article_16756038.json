      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the effectiveness of intracutaneous injections of sterile water in relieving low back pain during labor in Thai women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Department of Obstetrics and Gynecology, Taksin Hospital, Bangkok."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHOD",
          "content": "Fifty pregnant women at term, requiring pain relief for severe low back pain during the first stage of labor. The women were randomized to receive either 4 intracutaneous injections of 0.1 mL sterile water (n = 25) or isotonic saline as placebo (n = 25)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Pain scores measured by visual analogue scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Mean pain scores were significantly lower among the treatment group compared to the placebo group at 30 minutes, 1 and 2 hours after injections (p = 0.018, 0.046, and 0.027 respectively). Mean pain reduction were significantly greater in the treatment group compared to the placebo group at 30 minutes, 1 and 2 hours after injections (p < 0.001). There was no difference between the two groups with regard to time to delivery and rate of instrumental and cesarean delivery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The intracutaneous injections of sterile water was found to be an effective treatment against lower back pain during the first stage of labor."
        }
      ]},
