      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Computational design of and systematic search for a new type of molecular scaffolds termed analog series-based scaffolds."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS & METHODS",
          "content": "From currently available bioactive compounds, analog series were systematically extracted, key compounds identified and new scaffolds isolated from them."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Using our computational approach, more than 12,000 scaffolds were extracted from bioactive compounds."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A new scaffold definition is introduced and a computational methodology developed to systematically identify such scaffolds, yielding a large freely available scaffold knowledge base."
        }
      ]},
