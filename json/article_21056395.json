      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The treatment of patients with chronic pelvic and perineal pain is often complex and involves a number of different parameters. The purpose of this article is to propose a series of treatment algorithms to facilitate the therapeutic management of patients with chronic pelvic and perineal pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "A review of the literature was performed by searching Pubmed for articles on treatment of chronic pelvic and perineal pain. Treatment algorithms were established for each type of pain syndrome."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Treatment algorithms were defined for the various types of chronic pain syndrome: pudendal nerve entrapment syndrome, chronic pelvic pain syndrome, painful bladder syndrome, vulvar pain syndrome, epididymotesticular pain syndrome, complex pelvic pain syndrome. Therapeutic management is proposed for each algorithm."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The proposed algorithms are designed to be a clinical aid and do not constitute a comprehensive approach to the management of patients with chronic pelvic and perineal pain."
          }
        ]
      },
