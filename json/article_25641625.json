      "Abstract": {
        "CopyrightInformation": "© 2015 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The influence of gender and hand dominance on the size of the lower trapezius muscle has not been studied. We aimed to identify the effects of gender and hand dominance on thickness of this muscle."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Thirty healthy subjects (15 men and 15 women) were recruited for the study. The thickness of the lower trapezius muscles was measured bilaterally at the level of T8 at rest and with contraction at 130° of shoulder abduction using ultrasound imaging."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Men had significantly greater thickness of the lower trapezius muscle than women, both at rest and with contraction (P < 0.01). Greater lower trapezius muscle thickness was found on the dominant side compared with the non-dominant side (P < 0.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Gender and side dominance differences should be controlled for when investigating lower trapezius muscle thickness."
          }
        ]
      },
