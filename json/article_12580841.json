      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the use of preoperative transcervical analgesia for reducing postoperative pain from laparoscopic sterilization with Filshie clips."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A double blind, randomized, placebo-controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Gynecologic day-care clinic of Vejle Hospital, Vejle, Denmark."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "Seventy-eight healthy women were attending the public hospital requesting sterilization."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants received bupivacaine 0.25% 20 mL or placebo normal saline 20 mL injected into the uterus, though the fallopian tubes and into the pelvis before tubal occlusion with Filshie clips."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Post-operative visual analog pain score and request for analgesia were recorded."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At 30 min after clip application there was a non-significant reduction in pain-score on VAS. However, at 1, 2, 3 and 4 h median pain score on VAS was similar in both groups. Patients request for postoperative analgesia was similar in the two groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Preoperative transcervical perfusion of the uterus, fallopian tubes and into the pelvis did not reduce postoperative pain or request for analgesics after laparoscopic sterilization with Filshie clips."
        }
      ]},
