      "Abstract": {
        "CopyrightInformation": "Copyright Â© 2011 IMSS. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND AIMS",
            "content": "We undertook this study to assess the prevalence of obesity and overweight in children enrolled in government primary schools in the city of Rabat, Morocco."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twenty three schools were randomly selected. A cross-sectional study was conducted between April 2010 and June 2010. The survey was conducted on the basis of two questionnaires for both parents and children. The references used are those of the WHO (2007)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Our study involved a sample of 1570 children with an average age of 9.7 ± 0.95 years. The prevalence of overweight and obesity was 8.7%. Overweight affected 5.1% and obesity affected 3.6%. The majority of our population consisted of children of low socioeconomic status where 59% of fathers are laborers and 85% of mothers are unemployed."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Overweight and obesity do not spare the most underprivileged social strata of our country. Therefore, prevention strategies and programs to raise awareness of risks and threats involved must be a public health priority."
          }
        ]
      },
