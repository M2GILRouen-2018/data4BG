      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine if heel warming prior to heelstick increases the volume of blood collected compared to no warming."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Randomized controlled trial involving 100 preterm and term infants requiring capillary blood sampling (CBS), randomized to receive warming (Control) (n=50) or nonwarming (Experimental) (n=50)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "This sample of infants showed no benefit of warming the heel prior to CBS. Volume of blood, collection time, crying time, and repeat procedures were not different between groups. More infants in the Control group received squeezing during the procedure compared to the Experimental group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Heel warming prior to CBS may be an unnecessary technique in preterm and term infants that expends nursing time and hospital financial cost."
        }
      ]},
