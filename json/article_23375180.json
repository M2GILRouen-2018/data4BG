      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Arthroscopy Association of North America. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose of this study was to determine the accuracy, sensitivity, specificity, and predictive values of a single event of painful popping in the presence of a posterior root tear of the medial meniscus in middle-aged to older Asian patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We conducted a retrospective review of medical records of 936 patients who underwent arthroscopic surgeries for an isolated medial meniscus tear between January 2000 and December 2010. There were 332 men and 604 women with a mean age of 41 years (range, 25 to 66 years). The accuracy, sensitivity, specificity, positive predictive value, and negative predictive value of a painful popping sensation for a posterior root tear of the medial meniscus were calculated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Arthroscopy confirmed the presence of posterior root tears of the medial menisci in 237 of 936 patients (25.3%). A single event of a painful popping sensation was present in 86 of these 936 patients (9.1%). Of these 86 patients with a painful popping sensation, 83 (96.5%) were categorized as having an isolated posterior root tear of the medial meniscus. The positive predictive value of a painful popping sensation in identifying a posterior root tear of the medial meniscus was 96.5%, the negative predictive value was 81.8%, the sensitivity was 35.0%, the specificity was 99.5%, and the diagnostic accuracy was 77.9%."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A single event of painful popping can be a highly predictive clinical sign of a posterior root tear of the medial meniscus in the middle-aged to older Asian population. However, it has low sensitivity for the detection of a posterior root tear of the medial meniscus."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "Level IV, therapeutic case series."
          }
        ]
      },
