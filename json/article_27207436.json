      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To estimate the intrarater agreement of the Compass application of a smartphone in the assessment of elbow extension range of motion (EE-ROM) at pain onset and maximum tolerable point during the Upper Limb Neurodynamic Test 1 (ULNT1)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Within-day intrarater agreement study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Private and university clinical settings."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Volunteers (N=41; 21 men; age, 31.34±13.27y; height, 1.67±0.07m; body mass, 70.53±12.37kg) recruited from the community, with no symptoms or musculoskeletal abnormalities in their upper body quadrant and no regional or systemic nerve dysfunction."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Not applicable."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Ninety-five percent limits of agreement (LOA), standard error of the measurement, and minimal detectable change at the 95% confidence level (MDC95) of EE-ROM at pain onset and maximum tolerable point during the ULNT1."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Standard error of the measurement and MDC95 were relatively high on both sides when considering the onset of pain (standard error of the measurement, 6.6°-6.8°; MDC95, 18.4°-18.8°). Better results were found for the maximum tolerable point (standard error of the measurement, 4.2°-4.8°; MDC95, 11.7°-13.2°). The 95% LOA showed a similar trend."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Smartphone measurements showed relatively wide agreement parameters of elbow extension during the ULNT1. These results are, nevertheless, comparable with previous studies using goniometric assessment when considering maximal pain tolerance. Further research is needed before the possible widespread use of the smartphone in neurodynamic assessment."
          }
        ]
      },
