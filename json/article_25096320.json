      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Patellofemoral osteoarthritis (PFOA) is associated with pain and decreased self-reported function. The impact of PFOA on actual physical performance is currently unknown."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the impact of PFOA on physical performance and pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Eight participants aged 40-65 years with bilateral, symptomatic, radiographic PFOA and 7 age- and gender-matched pain-free control participants without radiographic PFOA were studied. Physical performance was measured with the Timed-Up-and-Go (TUG) and 50-foot Fast-Paced-Walk (FPW) tests. Dependent variables included time to complete the TUG and FPW; pretest-posttest change in pain intensity (TUG and FPW); and self-reports of perceived knee pain, stiffness, and physical function. Data were analyzed with nonparametric statistics."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The PFOA group TUG time was longer than the control group (p=0.01). No difference between groups was found for FPW time. Pretest-posttest pain increased for the TUG and FPW in PFOA participants (p< 0.05). The PFOA group reported greater knee pain, stiffness, and less physical function than controls (previous 48 hours) (p < 0.01)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Symptomatic, radiographic PFOA is associated with increased pain during the TUG and FPW tests and longer time required to complete the TUG. The TUG may be a more sensitive test of physical performance in PFOA."
        }
      ]},
