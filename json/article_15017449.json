      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To describe experiences during radiotherapy of patients suffering from lung cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Inductive, qualitative."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A radiotherapy department in the south of Sweden."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "15 patients with lung cancer undergoing their second week of radiotherapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODOLOGIC APPROACH",
          "content": "Interviews were conducted in a hospital setting, transcribed, and content analyzed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Experiences during radiotherapy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "The patients' experiences fall into four categories: fatigue, physical distress, managing disease- and treatment-related issues, and obstacles to managing. Fatigue was a major experience expressed in terms of low energy levels and low fitness, sometimes leading to social isolation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Nurses need to implement interventions to minimize side effects of radiotherapy and maximize patients' abilities to manage the disease and the treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "INTERPRETATION",
          "content": "Informing and educating patients about pretreatment and assessing fatigue as well as implementing interventions (e.g., nurse-patient interaction, support, information, encouragement, focus on the patients' own resources) may lead to improved comprehensive care during radiation therapy."
        }
      ]},
