      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© 2013 Nordic Federation of Societies of Obstetrics and Gynecology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the effect of systematic local infiltration analgesia on postoperative pain in vaginal hysterectomy, and describe the technique in detail."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A randomized, double-blind, placebo-controlled study following the CONSORT criteria."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Thirty-seven patients undergoing vaginal hysterectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Patients received high-volume (50 mL) ropivacaine 0.50% (n = 20) or saline (n = 17) infiltration using a systematic technique ensuring uniform delivery to all tissues incised, handled or instrumented during the procedure."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Pain, nausea, vomiting and opioid requirements were assessed for 32 h as well as time spent in the post-anesthesia care unit and time to first mobilization."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pain at rest was significantly reduced after one, four and eight hours in the ropivacaine group (p ≤ 0.001-0.01). Pain during coughing was significantly reduced after one and four hours (p ≤ 0.001 and p ≤ 0.003), and pain during movement was significantly reduced after four hours (p ≤ 0.02). Opioid requirements and time spent in the post-anesthesia care unit were significantly reduced in the ropivacaine group (p < 0.001 and p < 0.001, respectively), as well as the time to first mobilization (p < 0.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Intra-operative systematic local infiltration analgesia reduces postoperative pain in patients undergoing vaginal hysterectomy, facilities mobilization and improves early recovery."
          }
        ]
      },
