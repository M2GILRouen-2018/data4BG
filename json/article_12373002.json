      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright 2002 S. Karger AG, Basel",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Angiotensin II is a putative mediator in asthma, but the effect of topical administration of type 1 angiotensin II (AT1) receptor antagonists on allergic airway reactions is not known."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the effect of intranasal administration of CV-11974, an AT1 receptor antagonist, and of PD123319, a type 2 angiotensin II (AT2) receptor antagonist, on antigen-induced airway reactions in guinea pigs."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Thirty minutes after intranasal topical administration of CV-11974 (0.1 or 1.0 mg/ml) or PD123319 (10 mg/ml) into the airways, the animals were given an antigen challenge. Airway hyperresponsiveness and bronchoalveolar lavage fluid were analyzed 24 h after the antigen challenge."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Although these compounds did not inhibit antigen-induced early-phase bronchoconstriction or late-phase airway eosinophilia, intranasal administration of CV-11974 (but not PD123319) inhibited antigen-induced airway hyperresponsiveness in a dose-dependent manner 24 h after the antigen challenge."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Intranasal administration of an AT1 receptor antagonist reduces antigen-induced airway hyperresponsiveness."
          }
        ]
      },
