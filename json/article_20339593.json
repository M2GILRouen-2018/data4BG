      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To perform a review of the epidemiological aspects of investigating and treating wheezing in infants."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SOURCES",
          "content": "A search was run on MEDLINE using the keywords \"wheezing,\" \"infants,\" \"diagnosis,\" \"treatment,\" and \"children,\" and Google was also used to search for \"Estudio Internacional de Sibilancias en Lactantes.\""
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "SUMMARY OF THE FINDINGS",
          "content": "The prevalence of wheezing in infants varies greatly around the world. The factors associated with wheezing in infants are different at different research centers. Treatment of wheezing infants is still controversial and is dependent on a precise diagnosis. Clinical history and physical examination are fundamental to diagnosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A standardized method could reveal data of relevance to the epidemiology and treatment of wheezing in Brazil and allow comparisons between different participating centers."
        }
      ]},
