      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Evaluate the long-term safety, tolerability, and efficacy of Remoxy® (extended-release oxycodone) in patients with chronic pain related to osteoarthritis of the hip and/or knee or chronic low back pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Open-label, 12-month, phase 3 trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Fifty-nine US sites."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Men and women with moderate to severe hip and/or knee pain caused by osteoarthritis or persistent moderate to severe low back pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Remoxy 5 mg twice daily, which could be increased in fixed increments up to 80 mg twice daily."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Safety and tolerability assessments included adverse events (AEs), laboratory tests, vital signs, physical examinations, and electrocardiograms. Efficacy was assessed through ratings of pain intensity, quality of analgesia, and global assessment of study drug."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of the 828 patients enrolled, 823 received ≥1 dose of Remoxy, with 469 exposed for ≥180 days and 381 for ≥358 days. At least one AE was experienced by 678 patients (82%), the most common of which were opioid related, including constipation, nausea, and somnolence; 173 patients (21%) discontinued treatment because of AEs. No clinically relevant changes were seen in other safety assessments. Mean pain intensity scores decreased significantly from baseline at all time points (P < 0.001). At month 12, quality of analgesia and global assessment of study drug were rated positively (good, very good, or excellent) by 64% and 61% of patients (last observation carried forward), respectively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Long-term treatment with Remoxy was safe, well tolerated, and efficacious in patients with chronic pain related to osteoarthritis of the hip and/or knee or chronic low back pain."
          }
        ]
      },
