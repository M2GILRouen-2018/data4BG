      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "This is a case report."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The objective of this study was to report on a brain-computer interface (BCI) paradigm that is successfully used with an inpatient spinal cord injury patient."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "This study was conducted in an inpatient rehabilitation hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A 25-year-old man with a C5 burst fracture and subsequent tetraplegia (The American Spinal Injury Association) participated in this case study. He completed a brief battery of psychological, pain, cognitive and other screening measures at points before and after the BCI paradigm during his rehabilitation hospitalization."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The paradigm was easily learned and well tolerated with no adverse effects."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This case is reflective of the trends in our ongoing feasibility study evaluating BCI technology in the inpatient rehabilitation setting. Clinical implications and challenges of using this technology in a busy hospital unit are reviewed."
        }
      ]},
