      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Adherence to inhaled corticosteroids (ICS) remains poor among asthmatics, yet little is known about the efficacy of interventions to improve adherence. Implementing the Chronic Care Model (CCM) components among patients with respiratory disorders has been associated with an improvement in outcomes, yet little is known about its effects on ICS adherence in asthmatics."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We conducted a systematic review to assess the efficacy of interventions to improve ICS adherence among adult-asthmatics, and whether the use of CCM components (i.e., teaching self-management skills, providing decision support, delivery system design, and clinical information systems) resulted in greater ICS adherence."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "All English language articles testing the efficacy of an intervention including ICS medication on outcome from MEDLINE and PsychINFO databases through Aug-2010 were reviewed. Interventions were categorized based on the inclusion of CCM components. We standardized treatment effects to obtain effect-size's (ES's) and we combined the ES's of studies according to the number of CCM components included in their interventions."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Eighteen studies met inclusion criteria. Inclusion of a greater number of CCM components within interventions was associated with stronger effects on ICS adherence outcomes, with interventions featuring one, two, and four CCM components having medium (ES = 0.29; 95%CI, 0.16-0.42), large (0.53; 0.40-0.66), and very-large (0.83; 0.69-0.98) effects respectively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Findings provide support for using the CCM as a framework for the design and implementation of interventions to improve adherence among adult-asthmatics."
          }
        ]
      },
