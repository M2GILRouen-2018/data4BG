      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To determine clinically important differences (CIDs) in health-related quality of life (HRQoL) after total hip replacement (THR) or total knee replacement (TKR) surgery, using the Short Form 36 (SF-36)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN AND SETTING",
            "content": "SF-36 scores were collected 2 weeks before and at 1.5-6 years after joint replacement in 586 THR and 400 TKR patients in a multicenter cohort study. We calculated distribution-based CIDs (0.8 standard deviations of the preoperative score) for each SF-36 subscale. Responders (patients with an improvement in HRQoL ≥ CID of a particular subscale) were compared with nonresponders using an external validation question: willingness to undergo surgery again."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "CIDs for THR/TKR were physical functioning (PF), 17.9/16.7; role-physical (RP), 31.1/33.4; bodily pain (BP), 16.8/16.2; general health, 15.5/15.7; vitality, 17.3/16.7; social functioning (SF), 22.0/19.9; role-emotional, 33.7/33.6; and mental health, 14.8/14.1. CIDs of PF, RP, BP, and SF were validated by the validation question."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Valid and precise CIDs are estimated of PF, RP, BP, and SF, which are relevant in HRQoL subscales for THR and TKR patients. CIDs of all other subscales should be used cautiously."
          }
        ]
      },
