      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the association of iodine nutrition status and knowledge, attitude, and behavior in Tehranian women after 2 decades without updating public education."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Eight health care centers from 4 district areas of Tehran."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "A total of 383 women aged ≥ 19 years, randomly selected."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Iodine concentration of 24-hour urine samples, iodine content of household salts, and knowledge, attitude, and practice scores regarding iodine nutrition and iodized salt."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Multiple logistic regression was used to identify the association of knowledge, attitude, and practice scores with urinary iodine concentration (UIC) < 100 μg/L."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The percentages of Tehranian women with high knowledge, attitude, and practice scores were 26%, 26%, and 14%, respectively. Practice score was significantly different between females with UIC < 100 and > 100 μg/L (P = .001). Risk of UIC < 100 μg/L in women of childbearing age (19-45 years) after adjustment of education level, region of residence, and iodine content of salt was significantly associated with intermediate practice score (odds ratio = 2.6; 95% confidence interval, 1.3-13.2)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Marginally suboptimal iodine status in women of childbearing age can be attributed to inappropriate practices, but not to knowledge and attitude."
          }
        ]
      },
