      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American College of Emergency Physicians. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "The J-Tip (National Medical Products Inc, Irvine, CA) uses air instead of a needle to push lidocaine into the skin. To our knowledge, no studies have investigated its use for venipuncture in young children. We determine whether the J-Tip decreased venipuncture pain in young children compared with vapocoolant spray."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Children aged 1 to 6 years were randomized into 3 groups: intervention (J-Tip), control (vapocoolant spray), and sham (vapocoolant spray and pop of an empty J-Tip). The procedure was videotaped and scored with the Face, Legs, Activity, Cry and Consolability (FLACC) tool at 3 points; baseline, before approach; device, at J-Tip deployment; and at venipuncture. The FLACC tool was scored 0 (none) to 10 (severe). Comparisons of pain scores over time were made with the generalized estimating equation. Venipuncture success and adverse effects were assessed and compared with χ(2)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Two hundred five children enrolled: intervention 96, control 53, and sham 56. There were no between-group differences in baseline characteristics. There was no mean change in pain scores from device to venipuncture in the intervention group (0.26; 95% confidence interval [CI] -0.31 to 0.82), but there was an increase in pain in the control (2.82; 95% CI 1.91 to 3.74) and sham (1.68; 95% CI 0.83 to 2.52) groups. This change was greater for the control and sham compared to the intervention group. There was no difference in venipuncture success between groups. No severe adverse events occurred. Minor adverse events were the same between groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Use of the J-Tip for children aged 1 to 6 years reduced venipuncture pain compared with vapocoolant spray or sham treatment."
          }
        ]
      },
