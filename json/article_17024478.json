      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 The Authors. Published by Elsevier Ltd.. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Fracture of the tibial baseplate following total knee arthroplasty is very rare given the developments in modern prosthesis design. Tibial baseplate fracture secondary to polyethylene wear, osteolysis and component malalignment in an elderly obese patient is reported in the present article."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PRESENTATION OF CASE",
            "content": "A 69-year-old woman had undergone total knee arthroplasty eleven years prior to presentation and reported nine months of chronic pain, which was caused by a neglected fracture of the baseplate."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "We discuss the prevention of implant fracture after total knee arthroplasty and address the risk factors associated with this complication."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The present case emphasizes the importance of properly informing patients and encouraging them to report such complaints immediately to allow for early revision and prevention of component fracture, especially in patients with risk factors such as obesity and component, malalignment."
          }
        ]
      },
