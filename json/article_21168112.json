      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The current study was conducted to evaluate the effect of acupressure on primary dysmenorrhea in Iranian medical sciences students."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A randomized controlled pre and post-test design was employed to verify the effects of SP6 acupressure on dysmenorrhea."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A total of 30 young college female students with primary dysmenorrhea were randomly allocated to intervention (n = 15) and control (n = 15) groups."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "The intervention group received SP6 acupressure during menstruation cycle and the control group received light touch on the SP6 acupoint. Using a Visual Analog Scale, the severity of dysmenorrhea was assessed prior to and immediately, 30 min, 1, 2, and 3 h following treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Data were analyzed using X(2), t-test and ANOVA statistical tests."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Significant differences were observed in the scores of dysmenorrhea between the two groups immediately after (3.50 ± 1.42 vs. 5.06 ± 1.43, p = 0.004) and also 3 h after treatment (1.66 ± 1.98 vs. 4.80 ± 1.37, p = 0.000)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Acupressure on the SP6 meridian can be an effective non-invasive nursing intervention for alleviating primary dysmenorrhea and its effects last for 3 h post-treatment."
          }
        ]
      },
