      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of this study was to evaluate the pain/pressure threshold of selected myofascial points in subjects with chronic mechanical back pain after a single manipulation or mobilization."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "The study design was a randomized control trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Chiropractic College outpatient clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Thirty subjects aged 18-50 yr (mean age 31 yr, SD = 7 yr) with chronic mechanical low back pain (mean duration of pain 74 months, SD = 83 months) were randomized into two groups. One group received a manipulation and the other received a mobilization."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURE",
          "content": "Pain/pressure threshold of selected myofascial points were measured before, immediately after, and 15 and 30 min postintervention."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Sixteen patients were allocated to the manipulation group and 14 to the mobilization group. Repeated measured analysis of variance for all locations failed to show clinical or statistical significance (p > .287). The overall effect between treatments and the interaction between treatment and time was not significant (p > .268)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The absence of significant changes may be attributed to the selection of myofascial points, the instrument sensitivity to small changes, the differences in baseline measures and the absence of effect from one intervention."
        }
      ]},
