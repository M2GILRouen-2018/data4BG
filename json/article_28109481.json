      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the association between changes in the outer hair cells and exposure to amplified music in a group of high-school students."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "In this retrospective, case-control study, 86 subjects underwent audiometry, immittance audiometry, and distortion-product otoacoustic emission tests. The subjects were questioned about their listening habits and divided into 2 groups: exposed and unexposed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Most of the subjects had reduced function in their outer hair cells, mainly beginning at 8 kHz. Among 60 subjects-30 cases and 30 controls-75% were considered exposed and 25% unexposed. The exposed subjects were 9.33 times more likely to have altered outer hair cells than the unexposed subjects were."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Exposure to amplified music is associated with reduced function in the hair cells."
          }
        ]
      },
