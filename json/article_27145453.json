      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Mueller-Weiss syndrome is a complex condition of the adult tarsal navicular characterized by progressive fragmentation leading to mid- and hindfoot pain and deformity. Since its first descriptions in the early 20th century, controversy has persisted regarding its pathogenesis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This article reviews the literature and discusses the anatomy, epidemiology, causes, clinical and radiologic findings, and treatment of Mueller-Weiss syndrome, and thus permits a better understanding of this disease and its management."
        }
      ]},
