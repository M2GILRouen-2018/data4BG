      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine the effects of a goal setting intervention on self-efficacy, treatment efficacy, adherence and treatment outcome in patients undergoing low back pain rehabilitation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A mixed-model 2 (time) × 3 (group) randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A residential rehabilitation centre for military personnel."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "UK military personnel volunteers (N = 48); mean age was 32.9 (SD 7.9) with a diagnosis of non-specific low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Subjects were randomly assigned to either a goal setting experimental group (Exp, n = 16), therapist-led exercise therapy group (C1, n = 16) or non-therapist-led exercise therapy group (C2, n = 16). Treatment duration for all groups was three weeks."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN MEASURES",
          "content": "Self-efficacy, treatment efficacy and treatment outcome were recorded before and after the treatment period. Adherence was rated during regularly scheduled treatment sessions using the Sports Injury Rehabilitation Adherence Scale (SIRAS). The Biering-Sørensen test was used as the primary measure of treatment outcome."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "ANCOVA results showed that adherence scores were significantly higher in the experimental group (13.70 ± 1.58) compared with C2 (11.74 ± 1.35), (P < 0.025). There was no significant difference for adherence between the experimental group and C1 (P = 0.13). Self-efficacy was significantly higher in the experimental group compared to both C1 and C2 (P < 0.05), whereas no significant difference was found for treatment efficacy. Treatment outcome did not differ significantly between the experimental and two control groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The findings provide partial support for the use of goal setting to enhance adherence in clinical rehabilitation."
        }
      ]},
