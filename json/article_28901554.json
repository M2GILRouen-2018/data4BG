      "Abstract": {
        "CopyrightInformation": "© 2017 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose of the present study was to describe the acceptability of the lifestyle program PHYS/CAT and to get information about the tools used for assessment of functional exercise capacity, cognitive performance, and self-health-related quality of life."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "The findings are based on focus groups and the researchers' experiences of conducting the program as well as using the assessment tools."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "The acceptability of the program and the assessment tools was mainly satisfactory."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "The program with relational, educational, and supportive dimensions may be a promising tool to be integrated into daily nursing care."
          }
        ]
      },
