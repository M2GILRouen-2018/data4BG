    "Article": {
      "PublicationTypeList": {"PublicationType": {
        "UI": "D016428",
        "content": "Journal Article"
      }},
      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 by the American Academy of Pediatrics.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVE",
            "content": "There is a well-documented association between maternal smoking during pregnancy and offspring attention-deficit/hyperactivity disorder (ADHD). The degree to which this reflects causal intrauterine effects or is due to unmeasured confounding is not clear. We sought to compare the association between maternal smoking during pregnancy and offspring ADHD with the associations with paternal smoking, grandmother's smoking when pregnant with mother, and maternal smoking in previous pregnancies. Each of these exposures is expected to be influenced by much of the same confounding factors as maternal smoking during pregnancy, but cannot have direct intrauterine effects. A sibling control design was also used."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The current study used data from the Norwegian Mother and Child Cohort Study (n > 100\u2009000 children). Mothers and fathers reported on smoking during pregnancy, and mothers reported on smoking in previous pregnancies and their mother's smoking when pregnant with them. Mothers reported on child ADHD symptoms at 5 years of age. Information about child ADHD diagnosis was obtained from the Norwegian Patient Registry."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Maternal smoking during pregnancy was not more strongly associated with offspring ADHD diagnosis than was paternal smoking, grandmother's smoking when pregnant with mother, or maternal smoking in previous pregnancies. Sibling control analyses showed no association between maternal smoking in pregnancy and child ADHD symptoms among siblings discordant for maternal smoking."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These results suggest that the association between maternal smoking during pregnancy and offspring ADHD is not due to causal intrauterine effects, but reflects unmeasured confounding."
          }
        ]
      },
