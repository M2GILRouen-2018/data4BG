      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine the efficacy of polydeoxyribonucleotide (PDRN) injection for rotator cuff disease (RCD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case-controlled, retrospective, comparative study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Outpatient clinic at a university-affiliated tertiary care hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Patients (N=106) with chronic nontraumatic refractory RCD who were unresponsive to at least 1 month of conservative treatment: 55 patients received PDRN injection (PDRN group) and 51 continued conservative treatment (control group)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Not applicable."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Shoulder Pain and Disability Index, score on a visual analog scale of the average shoulder pain level, number of analgesic ingestions per day, isometric strength of shoulder abductor, active range of motion (flexion, abduction, internal rotation, external rotation), and maximal tear size of tendon on ultrasonography at pretreatment and 3 and 6 months postinjection."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was no significant difference between the 2 groups in terms of age, sex, shoulder affected, duration of symptoms, and ultrasonographic findings at pretreatment. Compared with the control group, the treatment group showed a significant improvement in Shoulder Pain and Disability Index, visual analog scale score, and number of analgesic ingestions per day. However, there was no difference in isometric strength, active range of motion, and maximal tear size of tendon. No adverse events were reported."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "To our knowledge, this is the first study to assess the efficacy of PDRN injection for patients with RCD. The PDRN injection group showed improvement in pain and subjective disability in patients with RCD and continued to show improvement for 3 months thereafter; the PDRN injection can be an optional treatment for patients with chronic RCD who show no response to other treatments."
          }
        ]
      },
