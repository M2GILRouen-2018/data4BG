      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The Behavioral Pain Scale (BPS) and Critical-Care Pain Observation Tool (CPOT) are behavioral pain assessment tools for uncommunicative and sedated intensive care unit (ICU) patients. This study compares the discriminant validation and reliability of the CPOT and the BPS, simultaneously, in mechanically ventilated patients on a mixed-adult ICU."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "This is a prospective observational cohort study in 68 mechanically ventilated medical ICU patients who were unable to report pain."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The BPS and CPOT scores showed a significant increase of 2 points between rest and the painful procedure (turning). The median BPS scores between rest and the nonpainful procedure (oral care) showed a significant increase of 1 point, whereas the median CPOT score remained unchanged. The interrater reliability of the BPS and CPOT scores showed a fair to good agreement (0.74 and 0.75, respectively)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This study showed that the BPS and the CPOT are reliable and valid for use in a daily clinical setting. Although both scores increased with a presumed painful stimulus, the discriminant validation of the BPS use was less supported because it increased during a nonpainful stimulus. The CPOT appears preferable in this particular group of patients, especially with regard to its discriminant validation."
          }
        ]
      },
