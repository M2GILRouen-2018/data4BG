      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Bronchiectasis is characterised by chronic sputum production,bronchial wall dilation,recurrent infection and airflow limitation. Methylxanthines are used in the management of airflow limitation associated with asthma and COPD, where they are also purported to have anti-inflammatory properties. In theory they may be of use in bronchiectasis."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine the efficacy of methylxanthines in the treatment of bronchiectasis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SEARCH STRATEGY",
          "content": "The Cochrane Airways Group clinical trials register derived from MEDLINE,EMBASE and hand searches using the terms bronchiectasis, aminophylline, theophylline and methyl- xanthine"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SELECTION CRITERIA",
          "content": "Only randomised controlled trials were to be considered."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA COLLECTION AND ANALYSIS",
          "content": "The results of the searches were reviewed by two authors. Searches yielded seven trials none of which met the inclusion criteria."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MAIN RESULTS",
          "content": "No randomised controlled trials were identified."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "REVIEWER'S CONCLUSIONS",
          "content": "Further research is required to establish if the methylxanthines have a role in the treatment of bronchiectasis."
        }
      ]},
