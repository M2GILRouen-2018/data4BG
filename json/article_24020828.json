      "Abstract": {
        "CopyrightInformation": "© 2013 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "This paper describes the design and rationale of a controlled trial that aims to determine the effectiveness of an intervention programme in which the internet is used."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Adolescent obesity is a major health problem, there being urgency to find effective interventions that induce behavioural change. The inclusion of the internet in the intervention may improve adolescents' adherence to the weight management programme and lead to adoption of healthier lifestyles."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A clinical trial with a control group (non-randomized)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Participants are adolescents with appointments at a paediatric obesity clinic (Portugal). Sample size was calculated according to the power analysis. The experimental group will follow the standard treatment protocol and receive free access to the e-therapeutic platform. The control group will follow the standard treatment protocol and join a waiting list. Intervention length will be 36 weeks (24 weeks of direct intervention with a follow-up for 12 weeks). This study was approved by the Ethical Committee for Health (Lisbon, Portugal) in January 2012 and funded by the Foundation for Science and Technology (Portugal) in December 2012."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "The results of this research will promote reflection on new approaches directed to treat adolescent obesity and on the promotion of healthy behaviours. We expect to gather empirical evidence of the intervention programme effectiveness. The expectations lie on the population health gains, empowerment in decision-making and adoption of healthier lifestyles."
          }
        ]
      },
