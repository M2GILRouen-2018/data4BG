      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "IMPORTANCE",
          "content": "Lichen planus pigmentosus (LPP) is an exclusive form of lichen planus (LP) characterized by pigmentary incontinence in histopathologic slides."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OBSERVATIONS",
          "content": "We report a known case of LPP with ocular manifestations including pigmented eyelid margins and conjunctival and corneal pigmented lesions. Histopathologic and confocal scanning findings of these lesions were compatible with the diagnosis of underlying systemic disease."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS AND RELEVANCE",
          "content": "To our knowledge, we report the first case of cornea directly involved by LP and ophthalmic presentations of LPP."
        }
      ]},
