      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "In patients with spinal cord diseases, it is difficult to obtain stress electrocardiogram and to evaluate preoperative cardiac risk. We evaluate these patients by chest CT and if the patients have calcified coronary artery, we recommend further testing by coronary arteriogram."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We evaluated the patients who had undergone coronary arteriogram from January 2008 through December 2009."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In 27 out of 158 cases (17.1%) operations were postponed or cancelled. In 12 out of 112 patients with no subjective symptom but with coronary calcification operations were also postponed or cancelled."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Preoperative chest CT and coronary arteriogram are useful for evaluation of preoperative cardiac function."
        }
      ]},
