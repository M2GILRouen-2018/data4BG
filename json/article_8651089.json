      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate transthoracic Doppler echocardiography in the identification of coronary artery bypass graft (CABG) flow for assessing graft patency."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "The initial study group comprised 45 consecutive patients with previous CABG undergoing elective cardiac catheterisation for recurrent ischaemia. The Doppler variables best correlated with angiographic graft patency were then tested prospectively in a further 84 patients (test group)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Three tertiary referral centres."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Flow velocities in grafts were recorded at rest and during hyperaemia induced by dipyridamole (0.56 mg/kg/4 min), under the guidance of transthoracic colour Doppler flow mapping. Findings on transthoracic Doppler were compared with angiography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Feasibility of identifying open grafts by Doppler and diagnostic accuracy for Doppler detection of significant (>/= 70%) graft stenosis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In the test group the identification rate for mammary artery grafts was 100%, for saphenous vein grafts to left anterior descending coronary artery 91%, for vein grafts to right coronary artery 96%, and for vein grafts to circumflex artery 90%. Coronary flow reserve (the ratio between peak diastolic velocity under hyperaemia and at baseline) of < 1.9 (95% confidence interval 1.83 to 2.08) had 100% sensitivity, 98% specificity, 87.5% positive predictive value, and 100% negative predictive value for mammary artery graft stenosis. Coronary flow reserve of < 1.6 (95% CI 1.51 to 1.73) had 91% sensitivity, 87% specificity, 85.4% positive predictive value, and 92.3% negative predictive value for significant vein graft stenosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Transthoracic Doppler can provide non-invasive assessment of CABG patency."
        }
      ]},
