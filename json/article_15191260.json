      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© The European Society of Cardiology 2013.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "A low-sodium diet is a core component of heart failure self-care but patients have difficulty following the diet."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "The aim of this study was to identify predictors of higher than recommended sodium excretion among patients with heart failure."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The World Health Organization Five Dimensions of Adherence model was used to guide analysis of existing data collected from a prospective, longitudinal study of 280 community-dwelling adults with previously or currently symptomatic heart failure. Sodium excretion was measured objectively using 24-hour urine sodium measured at three time points over six months. A mixed effect logistic model identified predictors of higher than recommended sodium excretion."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The adjusted odds of higher sodium excretion were 2.90, (95% confidence interval (CI): 1.15-4.25, p<0.001) for patients who were obese; 2.80 (95% CI: 1.33-5.89, p=0.007) for patients with diabetes; and 2.22 (95% CI: 1.09-4.53, p=0.028) for patients who were cognitively intact."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Three factors were associated with excess sodium excretion and two factors, obesity and diabetes, are modifiable by changing dietary food patterns."
          }
        ]
      },
