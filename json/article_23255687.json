      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the role of serum cholesterol and triglyceride in the assessment of cardiovascular disease risk factors in children and adolescents."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case-control study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Childrens Hospital of Zhejiang University School of Medicine, Hangzhou, China."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Children from 6 years to 17 year old. 188 with simple obesity, and 431 with obesity and metabolic abnormalities. 274 age and gender-matched healthy children as controls."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Receiver operating characteristic curves were used to analyze the detection of cardiovascular disease risk factors by cholesterol and triglyceride in children and adolescents."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The ranges of areas under receiver operating characteristic curves (AUC) for triglyceride and non-high-density lipoprotein cholesterol were 0.798-0.860 and 0.667-0.749, respectively to detect cardiovascular disease risk factors. The ranges of AUC for low-density lipoprotein cholesterol, total cholesterol, and high-density lipoprotein cholesterol were 0.631-0.718, 0.596-0.683, and 0.292-0.376, respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Triglyceride and non-high-density lipoprotein cholesterol are better than low-density lipoprotein cholesterol as predictors of cardiovascular disease risk factors in Chinese Han children and adolescents."
        }
      ]},
