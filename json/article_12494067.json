      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To elucidate relationship between heart rate variability and severity of coronary atherosclerosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL",
          "content": "Seventy five patients with class I-IV angina subjected to coronary angiography and 23 apparently healthy subjects of the same age without overt coronary heart disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Analysis of parameters of variational pulsometry and heart rate entropy at rest and during test with controlled breathing (6 breaths/min)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RESULTS AND CONCLUSION",
          "content": "Heart rate variability decreased with increase of functional class of angina and severity of coronary artery atherosclerosis. Within same functional class heart rate variability was lower in patients with more severe coronary atherosclerosis."
        }
      ]},
