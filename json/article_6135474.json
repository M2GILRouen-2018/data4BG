      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the anti-inflammatory and analgesic activities of leaf extract of Melanthera scandens (M. scandens)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The crude leaf extract (39-111 mg/kg) of M. scandens was investigated for anti-inflammatory and analgesic activities using various experimental models. The anti-inflammatory activity was investigated using carragenin, egg-albumin induced oedema models, while acetic acid, formalin-induced paw licking and thermal-induced pain models were used to evaluate the antinociceptive property."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The extract caused a significant (P<0.05 - 0.001) dose-dependent reduction of inflammation and pains induced by different agents used."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The leaf extract possesses anti-inflammatory and analgesic effects which may be mediated through the phytochemical constituents of the plant."
        }
      ]},
