      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "To examine the prevalence of high-risk subjects of obstructive sleep apnea (OSA) and its predictive factors in patients undergoing elective surgery by using the Berlin Questionnaire."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "300 surgical ASA physical status I, II, III, and IV patients were surveyed. Patients were screened with the Berlin questionnaire for obstructive sleep apnea. Data of sex, age, BMI and HTN also evaluated. Data were analyzed by Chi-square test and P < 0.05 was meaningful."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The Berlin questionnaire identified 25.3% (76/300) of patients as being at high risk of sleep apnea (95% confidence interval, 20%-28%). This group consisted of 195 (65%) males and 105 (35%) females. The prevalence of high-risk subjects in men were more significantly than women (P = 0.001). High-risk subjects also were increasing with age (P = 0.000) and increasing with obesity (P = 0.000) and arterial hypertension (P = 0.000)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Predictors of high risk for OSA-related symptoms were female sex, age more than 50 years, and body mass index."
        }
      ]},
