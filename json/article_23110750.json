      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the relationship between family meals and nutrition behaviors of adolescents."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Secondary analysis of Youth'07, a nationally representative survey."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Secondary schools in New Zealand."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Randomly selected adolescents (aged 13-17 years, n = 9,107) completed a multimedia and anonymous survey about their health."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "VARIABLES MEASURED",
            "content": "Body mass index and eating behaviors."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Multiple logistic regression equations were used to determine the associations between family meals and body size and dietary behaviors, controlling for demographic variables."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Nearly 60% of young people shared a meal with their families 5 or more times in the previous week. Frequent family meals were associated with greater consumption of fruits and vegetables (P < .001), and breakfast (P < .001). Adolescents who frequently shared family meals were also more likely to report that what they ate in the past week was healthy than adolescents who did not (P < .001). There was no relationship between frequency of family meals and body mass index (P = .60)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Data from the current study suggest that family meals cannot be used as a single strategy for obesity prevention, but they may provide an important opportunity for young people to consume healthy food."
          }
        ]
      },
