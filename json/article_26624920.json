      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "(1) To determine the frequency of subarachnoid blood spread following epidural blood patch (EBP) in a cohort of subjects with spontaneous intracranial hypotension (SIH). (2) To describe the outcome of these patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "In a cohort of 106 patients exhibiting SIH, spiral spinal CT scans were obtained post-lumbar EBP and neuroradiological data was reviewed for evidence of subarachnoideal bleeding."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Subarachnoideal blood spread was detected on spinal CT scans following EBP in 9 of 106 patients with SIH. All patients exhibited a complete recovery and no neurological complications were observed."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A low incidence of subarachnoideal blood spread was observed following EBP given to treat SIH. Instances of subarachnoideal blood spread were not associated with neurological complications or altered efficacy of the EBP procedure."
          }
        ]
      },
