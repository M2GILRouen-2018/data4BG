      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Sports Medicine Australia. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "We evaluated the benefits and relationship of the number of steps per day to the cardiometabolic risk factors: adiposity indicators; insulin resistance; and metabolic syndrome (MetS) in apparently healthy Brazilian middle-aged men."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Apparently healthy men (age: 50 ± 5 years; n=299) were studied. The number of steps per day was measured by pedometer. The adiposity indicators (waist circumference, total body fat, android and gynoid body fat), serum insulin, glucose and triglycerides, triglycerides/high-density lipoprotein cholesterol (HDL-c) ratio, homeostasis model assessment of insulin resistance (HOMA-IR) and MetS were assessed. Subjects were placed in groups to reflect different levels of steps per day (average of 7 consecutive days): Group 1<10,000 and Group 2 ≥ 10,000. Relationships among variables were measured by multiple linear regressions and the Spearman correlation coefficient as appropriate (p<0.05)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The cardiometabolic risk factors were lower (p<0.05) in Group 2 than in Group 1. The number of steps per day was a negative predictive factor for total body fat, android and gynoid body fat and HOMA-IR independent of age, working position, android fat, overweight/obesity prevalence, and triglycerides/HDL-c ratio. Moreover, there was a negative correlation between the number of steps and total body fat, android and gynoid body fat, HOMA-IR and MetS."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Brazilian middle-aged men performing more than 10,000 steps per day have better cardiometabolic conditions than those walking fewer than 10,000 steps. The number of steps per day is inversely related to the indicators of total and regional adiposity, insulin resistance and MetS."
          }
        ]
      },
