      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Topical photodynamic therapy (PDT) is an excellent treatment option for actinic keratosis (AK). Pain is one of the major adverse effects."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare the pain intensity during the extensive treatment of cosmetic units using 5-aminolaevulinic acid methylester (MAL) or 5-aminolaevulinic acid nanoemulsion (BF-200-ALA)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "173 patients with 965 treated areas were enrolled in this retrospective monocentric study. All patients had multiple AKs and received an extensive treatment of the photodamaged area. 424 areas were treated with MAL and 541 with BF-200-ALA. Pain was rated using a standardized visual analogue scale (VAS). The number of PDT treatment interruptions was documented."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "PDT with MAL led to a lower mean VAS score (5.0 vs. 5.8), a lower number of treatment interruptions (13.2 vs. 19.9%) and a lower amount of patients experiencing severe pain (25.0 vs. 36.0%) compared to PDT with BF-200-ALA."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Our data shows that PDT using MAL is less painful than PDT using BF-200-ALA resulting in a significantly lower mean VAS score (p < 0.001), significantly fewer patients experiencing severe pain (p < 0.001) and a significantly (p < 0.05) lower number of treatment interruptions. Differences in selectivity for tumour cells and transport of ALA in peripheral neurons may play a role."
          }
        ]
      },
