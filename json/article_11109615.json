      "Language": "rus",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To compare clinical effectiveness and tolerance of methylprednisolone (methypred) and dexamethasone (dexaven) in patients with rheumatoid arthritis (RA), to estimate side effects and complications rate."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "The trial included 31 patients with seropositive RA (27 females, 4 males) stage II and III. Dexaven pulse-therapy was given to 16 patients in a dose 2 mg/kg for 3 days, 15 patients received methypred in a classic dose 1000 mg for 3 days. Clinical response was assessed on day 1, 7 and 30 after the treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Both drugs significantly reduced severity of arthralgia, morning joint stiffness, number of inflamed joints, the disease activity diminished 2-3-fold. Side effects were minimal."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Dexaven (dexamethasone) is a drug of choice in pulse-therapy of RA. It is not inferior to routine treatment with methylprednisolone (methypred)."
        }
      ]},
