      "Abstract": {
        "CopyrightInformation": "© 2017 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Relationships between clinical/demographic factors and health-related quality of life (HRQoL) in childhood immune thrombocytopenia (ITP) remain poorly understood. Recent studies reveal conflicting information about factors that contribute to HRQoL."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This was a prospective, single-institution, cohort study of newly diagnosed children with ITP. Serial evaluations of HRQoL were performed using the Kid's ITP Tools (KIT), scored from 0 (worst) to 100 (best), at enrollment and 1 week, 6 months, and 12 months following diagnosis. All visits included bleeding severity grading. Relationships between HRQoL and platelet count, treatment, bleeding severity, and course of disease were examined."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 99 children with newly diagnosed ITP were evaluable for analysis. KIT scores were low at diagnosis for parents (median 26, range 15-43) and children (median 65, range 55-81) and were not influenced by age or platelet count. At diagnosis, children who received treatment had lower platelet counts (P = 0.005), more severe hemorrhage (P < 0.0125), and lower HRQoL by parent, child, and proxy reporting (P < 0.05). Oral bleeding negatively impacted proxy-reported disease burden at diagnosis (P = 0.01). Persistence of disease and lower platelet counts at 6 and 12 month visits were the only factors noted to consistently impact quality of life beyond diagnosis for both parents and children."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "HRQoL is low at diagnosis but significantly improves over time. Patients with ongoing disease and lower platelet counts continue to have significant disease burden."
          }
        ]
      },
