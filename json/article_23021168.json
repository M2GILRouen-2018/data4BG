      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 American Society for Gastrointestinal Endoscopy. Published by Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Water infusion versus air insufflation during colonoscope insertion has been suggested to reduce patient discomfort and decrease sedation medication requirements. Warm water is thought to further facilitate colonoscopy perhaps by decreasing colon spasm."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare the utility of warm (35°-38°C) versus cool (20°-23°C) water infused during colonoscopic insertion by measuring patient sedation medication use and discomfort scores between the warm and cool water groups."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized, controlled, double-blinded study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Outpatient endoscopy unit at an academic medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "A total of 175 adults."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Elective outpatient sedated screening colonoscopies."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASUREMENTS",
            "content": "Sedation medication used, pain scores, cecal intubation rate, endoscopy times, satisfaction scores, and patient willingness to repeat procedures."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was no significant difference in sedation medication requirement during colonoscopy with the use of warm or cool water (fentanyl 83.6 ± 29.0 μg vs 87.6 ± 39.6 μg; P = .45; midazolam 3.3 ± 1.2 mg vs 3.3 ± 1.3 mg; P = .91). There was no significant difference in patient pain scores or satisfaction scores. Cecal intubation rates (100%) were similar. There was no significant difference in cecal intubation times (6 minutes 40 seconds ± 4 minutes 9 seconds vs 7 minutes 49 seconds ± 4 minutes 0 seconds; P = .06) between the warm and cool water groups. All patients were willing to repeat the colonoscopy by using the same method in both groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "Limited generalizability to patients undergoing screening sedated colonoscopies with good to excellent bowel preparation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Water does not need to be warmed before infusion in patients undergoing sedated colonoscopies."
          }
        ]
      },
