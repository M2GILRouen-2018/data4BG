      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to verify the clinical applicability of the Nursing Outcomes Classification (NOC) to the evaluation of cancer patients with a nursing diagnosis of acute or chronic pain in a palliative care unit."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A prospective longitudinal study performed on a sample of 13 adult cancer patients in a palliative care unit. Patients were followed for at least 4 days. Data were collected with an instrument containing eight nursing outcomes and nineteen NOC indicators. Statistical analysis was performed using generalized estimating equation models."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The following outcome and indicator scores changed significantly over the course of the study: reported pain and length of pain episodes in the pain level outcome; social relationships in the personal well-being outcome; respirator rate in the vital signs outcome; and describes causal factors in the pain control outcome."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The NOC outcomes and indicators included in this study were able to successfully evaluate the clinical evolution of cancer patients in palliative care. These scores proved to be applicable for use in palliative nursing care."
          }
        ]
      },
