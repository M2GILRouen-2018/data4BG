      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To ascertain clinical features of complex regional pain syndrome (CRPS) in children with a focus on movement disorders."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "all publications with original data on children with CRPS were assessed. Data were tabulated and descriptive statistics were applied."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "One population-based study and nine clinic-based studies provided data on demographic and clinical characteristics of childhood CRPS. Mean age of onset was 12.5 years and 85% of patients were females (risk ratio: 1.70; 95% CI: 1.54-1.88). History of trauma in 71% and the lower limbs were affected in 75% of patients. A secondary site involvement was present in 15%. Movement disorders and dystonia were reported in 30% of children."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Majority of cases of CRPS in children are females with mean age of 12.5 years. Movement disorders (mainly dystonia) affect at least one in three children with CRPS."
        }
      ]},
