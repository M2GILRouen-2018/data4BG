      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe the postpartum health of predominantly Hispanic participants in the Special Supplemental Nutrition Program for Women, Infants, and Children (WIC) and identify how health characteristics differ between mothers who delivered preterm or low birth weight infants and those who did not."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional survey among postpartum WIC mothers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Los Angeles and Orange Counties, CA."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "WIC participants within 1 year of delivery (n = 1,420)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Postpartum health behaviors, health characteristics, and birth spacing intentions and behaviors."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Frequencies of health characteristics were estimated using analyses with sample weights. Differences were assessed with chi-square and Fisher exact tests with Bonferroni correction for pairs of tests."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Many women exhibited postpartum risk factors for future adverse health events, including overweight or obesity (62.3%), depressive symptoms (27.5%), and no folic acid supplementation (65.5%). Most characteristics did not differ significantly (P > .025) between mothers of preterm infants and full-term infants or between mothers of low birth weight and normal birth weight infants."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Despite few differences between postpartum characteristics of mothers who delivered preterm or low birth weight infants and those who did not, a high percentage of mothers had risk factors that need to be addressed. Current postpartum educational activities of WIC programs should be evaluated and shared."
          }
        ]
      },
