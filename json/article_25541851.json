      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "There is no specific laboratory method for the diagnosis of acute mesenteric ischemia (AMI). In this study, we aimed to determine the efficacy of the D-dimer test in selected cases prior to multi-detector angio-CT, which is expensive and has side effects."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Patients, over 65, with abdominal pain were included in this study. The D-dimer test was applied to 230 (34%) of 676 abdominal pain patients admitted to our emergency service. The D-dimer levels of the patients diagnosed with AMI by angio-CT were compared."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In AMI patients sensitivity of the D-dimer test was 84.6% and the specificity was 47.9%. Elevated D-dimer levels and AF were observed in 90.9% of the patients diagnosed with AMI by CT."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "D-dimer levels were elevated in the AMI patients. Patients suspected of having AMI with unclear clinical results and patients with D-dimer levels above 1000 ng/ml and AF should undergo further evaluation."
        }
      ]},
