      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare contact diode laser (CDL) tonsillectomy to monopolar cautery (MPC) with regard to pain and other morbidity during recovery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN AND SETTING",
          "content": "Single-blind, randomized trial in a tertiary-care pediatric hospital. Tonsillectomy was performed by CDL in 30 children and by MPC in 28. Parents completed a daily questionnaire for 10 days after surgery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was significantly less pain in the CDL group than in the MPC group. The CDL group also required much less medication, and was much less likely to experience multiple awakenings (P < 0.001 for all comparisons)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Recovery after CDL tonsillectomy was associated with much less pain and discomfort than after MPC surgery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SIGNIFICANCE",
          "content": "Postoperative pain is a major concern for surgeons, patients, and their parents. The long recovery period also has costs in school days missed for the child and work missed for the parents. CDL tonsillectomy may greatly mitigate these burdens."
        }
      ]},
