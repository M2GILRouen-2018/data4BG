      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To evaluate the role of coronary artery calcium scoring (CACS) and/or coronary CT angiography (CCTA) in asymptomatic elderly patients with high pretest probability for coronary artery disease (CAD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Forty-eight consecutive asymptomatic elderly (>65 years) subjects who had a high pretest probability and underwent CACS/CCTA were included. Each CCTA was evaluated for adequacy for assessment of coronary stenosis. Significant stenosis (>50% diameter narrowing) was assessed on evaluable CT images and by invasive catheter angiography (ICA)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All subjects were men with mean CACS of 880 ± 1779. Among those with low (0-99), intermediate (100-399), and high (400-999) CACS, ICA-verified significant stenosis was present in 8% (1/13), 23% (2/13), and 67% (8/12), respectively. Among those with very high CACS (≥ 1000) (n = 10), 90% of CCTAs were not evaluable for stenosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In asymptomatic elderly subjects with high pretest probability, CACS followed by CCTA may be considered for those with intermediate to high CACS."
        }
      ]},
