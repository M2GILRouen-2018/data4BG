      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The objective was to describe chiropractic and acupuncture care of a patient with acute mild traumatic brain injury (mTBI) symptoms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CLINICAL FEATURES",
          "content": "A 31-year-old woman had acute neck pain, headache, dizziness, nausea, tinnitus, difficulty concentrating, and fatigue following a fall. She was diagnosed at an urgent care facility with mTBI immediately following the fall. Pharmaceutical intervention had been ineffective for her symptoms."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "INTERVENTION AND OUTCOME",
          "content": "The patient was treated with chiropractic adjustments characterized as high velocity, low amplitude thrusts directed to the cervical spine and local acupuncture points in the cervical and cranial regions. The patient received care for a total of 8 visits over 2.5 weeks with resolution of concussive symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This patient with mTBI responded favorably to a conservative treatment protocol with the combination of chiropractic and acupuncture care."
        }
      ]},
