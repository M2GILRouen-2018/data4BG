      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the sperm yield and patient acceptability of Trucut needle testicular biopsy followed by seminiferous tubule milking."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective case analysis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The Regional Fertility Center, Royal Maternity Hospital, Belfast, Northern Ireland, United Kingdom."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Forty-one males with obstructive azoospermia (normal testicular volume and FSH and LH levels)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Trucut needle testicular biopsies under local anesthetic with milking of the seminiferous tubules."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Quantitation of sperm retrieved per biopsy core and patient follow-up by questionnaire."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "A mean of 105,634 sperm (range, 5,000-427,800) were retrieved, and the mean biopsy weight was 9.17 mg. Twenty-six subjects found the biopsy painless and 15 were pain-free after biopsy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "The Trucut needle can be used in combination with seminiferous tubule milking to obtain large numbers of sperm in men with obstructive azoospermia."
        }
      ]},
