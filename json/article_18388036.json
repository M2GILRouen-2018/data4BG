      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "We investigated the time course and prognostic value of fibrinogen (Fib), C-reactive protein (CRP), interleukin-6 (IL-6), and ceruloplasmin (CP) in patients with severe unstable angina."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "All 4 substances were measured on admission and after 6, 12, 24, 48, and 72 hours, and after 7 days and 6 months in 40 patients with Braunwald's classification class IIIB unstable angina."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All recorded substances increased significantly; 15 patients had cardiovascular events during hospitalization and 11 patients during follow-up. The time course and the mean values of Fib, CRP, and IL-6 were similar in patients with and without complications both during hospitalization and follow-up. However, CP levels from 6 hours until 6 months were significantly higher in patients with complications during follow-up (P < .05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Fib, CRP, IL-6, and CP levels alter in patients with severe unstable angina. However, only CP levels were related to 12-month follow-up prognosis."
        }
      ]},
