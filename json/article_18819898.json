      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To optimize the extraction process of Tuirezhitongsan and extract the pharmacodynamically active fractions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Orthogonal test methods and supercritical-CO(2) fluid extraction (SFE-CO(2)) were used for the extraction, and the the pharmacodynamically active fractions were screened with analgesic experiments."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The optimal extraction of the active fractions was achieved with the extraction pressure at 25 MPa, extraction temperature at 45 degrees celsius, resolution pressure at 6.7 MPa, and resolution temperature at 50 degrees celsius."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "SFE- CO(2) is rapid, efficient, and energy-saving in the extraction of the active fractions in Tuirezhotongsan, and provides a mew method for extraction of traditional Chinese medicine."
        }
      ]},
