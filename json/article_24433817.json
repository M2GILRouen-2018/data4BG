      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether a single exposure to a Manga comic (Japanese comic art) with multiple messages promoting fruit intake influenced snack selection in minority urban youth."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Fifty-seven youth (mean age 10.8 y; 54% female; 74% black/African American) attending after-school programs in Brooklyn, NY participated in a pilot study in which they were randomly assigned to receive the comic or a non-health-related newsletter. After reading their media, participants were offered a snack and could choose from among healthy/unhealthy options. Secondary outcomes included knowledge, self-efficacy, and outcome expectations related to fruit intake and media transportation. Data were analyzed using regression and paired t test."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Comic group participants were significantly more likely to choose a healthy snack, compared to the Attention-control group (odds ratio = 3.6, 95% confidence interval: 1.1-12.1, P = .04). The Comic group reported increases in self-efficacy (P = .04) and greater transportation (immersion into media) (P = .006)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Results suggest Manga comics may be a useful format to promote healthy snack selection in urban minority youth."
          }
        ]
      },
