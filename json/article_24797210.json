      "Abstract": {
        "CopyrightInformation": "© 2014 International Society for Sexual Medicine.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Subpubic cartilaginous cysts (SCCs) are rare."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "This is the first reported case of a male patient presenting with neurological and sexual symptoms due to an SCC."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "We describe the clinical history of a patient who reported neuralgic pain, numbness in the groin and base of his penis, and loss of sexual function."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A magnetic resonance imaging revealed the presence of an SCC with associated mass effect. A conservative approach was adopted and within 12 months, the cyst had decreased in size and his symptoms had improved."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Men who present with erectile dysfunction and neurological symptoms merit a thorough assessment including appropriate investigation to exclude organic pathology."
          }
        ]
      },
