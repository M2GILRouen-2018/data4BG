      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "To determine if post-trabeculectomy patching reduces the prevalence of shallow/flat anterior chambers and pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "435 eyes were prospectively randomised to either a double patch with tape or no patch with tape group."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was no statistically significant difference in flat or shallow anterior chamber rates or pain symptoms between the patch and no patch groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "There is no benefit to patching the post-trabeculectomy eye."
        }
      ]},
