      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To report the exceptional condition of retroperitoneal ectopic pregnancy after intrauterine insemination."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case report."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "A 37-year-old woman, gravida 2, para 1, presented to the emergency department 1 month after intrauterine insemination complaining of lower abdominal pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "A transvaginal ultrasound assessment revealed a complex mass containing a gestational sac with vitelline vesicle behind the left ovary. At laparoscopy, a nodular lesion was seen next to the left uterosacral ligament, suggesting the presence of an ectopic pregnancy in the retroperitoneal space."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "The unusual location of an ectopic pregnancy such as in the retroperitoneum should be examined in patients with clinical findings that suggest ectopic pregnancy if both the uterus and adnexa are normal during laparoscopic exploration."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "The patient's retroperitoneal pregnancy was treated with a wide laparoscopic excision. To allow the removal of all trophoblastic tissue, a 3×2×2 cm hemorrhagic mass containing the ectopic pregnancy was removed from the retroperitoneal space. Retroperitoneal ectopic pregnancy was confirmed by the pathology diagnosis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Retroperitoneal pregnancy after assisted reproductive techniques is an exceptional condition that must be considered in patients with clinical findings that suggest ectopic pregnancy if both the uterus and adnexa are normal during laparoscopic exploration."
          }
        ]
      },
