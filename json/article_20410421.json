      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purposes of this review are to summarize the causes of recurrent pain after percutaneous vertebroplasty and to discuss the incidence, clinical symptoms, risk factors, image findings, treatment and prognosis, and prevention of such pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Percutaneous vertebroplasty is widely used to treat patients with symptomatic osteoporotic compression fractures. Although the procedure relieves the pain of the compression fracture, recurrent back pain after percutaneous vertebroplasty is common."
        }
      ]},
