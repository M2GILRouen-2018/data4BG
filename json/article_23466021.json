      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Pneumomediastinum is a relatively rare, yet typically benign, clinical condition that usually presents in young men."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This report will describe a relatively rare event of pneumomediastinum with epidural extension in a young woman and will discuss the etiology, clinical manifestations, and treatment options for this condition."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "The patient presented to the Emergency Department (ED) with typical symptoms of shortness of breath and chest pain, but was found on computed tomography to have epidural pneumatosis. No precipitating event was found."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This case of spontaneous pneumomediastinum with associated epidural pneumatosis in a young woman presenting to the ED is a relatively benign condition that typically does not require any significant work-up or treatment."
          }
        ]
      },
