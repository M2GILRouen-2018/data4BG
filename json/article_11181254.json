      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "To assess anthropometric variables and body composition in children with moderate asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS AND METHOD",
          "content": "Cross-sectional study of two homogeneous cohorts. Group 1 (study group): 84 children with moderate asthma treated with inhaled budesonide for al least 12 months; group 2 (control group): 89 healthy children. Body measurements were studied by bioelectrical impedance."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Males with moderate asthma showed lower values for fat-free mass and total body water. Data corrected for weight rendered no statistically significant differences."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Male children with moderate asthma show a lower fast-free mass."
        }
      ]},
