      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The transgluteal approach to abscess drainage through the greater sciatic foramen has been described in adults, but this route has not been as extensively studied in children. We performed CT-guided transgluteal percutaneous abscess drainage in seven children and assessed the results of drainage and catheter tolerance."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Transgluteal catheters are well tolerated by children, and the transgluteal route is an effective approach to selected pelvic abscesses in children."
        }
      ]},
