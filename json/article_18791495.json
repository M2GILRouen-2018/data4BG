      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "Disruption of the intestinal barrier and bacterial translocation commonly occur when intestinal blood flow is compromised. The aim of this study was to determine whether liver resection induces intestinal damage."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We investigated intestinal fatty-acid binding protein and insulin-like growth factor binding protein levels in the plasma of patients who underwent liver resection."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "We show that liver resection is associated with significant intestinal barrier injury, even if the Pringle maneuver is not performed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "We propose the use of insulin-like growth factor binding protein-1 as a novel biomarker of intestinal damage in such situations."
        }
      ]},
