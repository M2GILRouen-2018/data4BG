      "Abstract": {
        "CopyrightInformation": "Copyright 2010 Elsevier Editora Ltda. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVES",
            "content": "Chronic pain is very prevalent and the cost of its treatment can cause a relevant impact on people and society. The objective of this study was to evaluate the monthly cost of drugs used in the outpatient treatment of chronic pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In the present study the cost of the drugs used by 233 patients with chronic pain (117 with nociceptive pain, 59 with neuropathic pain, and 57 with mixed pain) followed at the Alpha Center of UNIFESP between January 2004 and January 2008 was evaluated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The mean general cost was R$ 127.74 (from R$ 5.00 to R$ 780.00)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This study showed that the cost of the drugs does not differ significantly taking into consideration the type of pain."
          }
        ]
      },
