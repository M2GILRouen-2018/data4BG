      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Family caregiver involvement may improve patient and family outcomes in the intensive care unit. This study describes critical care nurses' approaches to involving family caregivers in direct patient care."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "RESEARCH METHODOLOGY & DESIGN",
            "content": "This is a qualitative content analysis of text captured through an electronic survey."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A convenience sample of 374 critical care nurses in the United States who were subscribers to one of the American Association of Critical Care Nurses social media sites or electronic newsletters."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE",
            "content": "Critical care nurses' responses to five open-ended questions about their approaches to family involvement in direct patient care."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "Nurse, patient and family caregiver factors intersected in the context of the professional practice environment and the available resources for family care. Two main themes were identified: \"Involving family caregivers in patient care in the intensive care unit requires careful ssessment\" and \"There are barriers and facilitators to caregiver involvement in patient care in the intensive care unit.\""
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Patient care demands, the professional practice environment and a lack of resources for families hindered nursing family caregiver involvement. Greater attention to these barriers as they relate to family caregiver involvement and clinical outcomes should be a priority in future research."
          }
        ]
      },
