      "Abstract": {
        "CopyrightInformation": "© 2012, The Authors International Journal of Nursing Knowledge © 2012, NANDA International.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "Acute pain occurs in over 50% of hospitalized children. The accuracy of this diagnosis has been underexplored in the literature, as has the role of training to implement pain assessment. This study analyzed the accuracy of acute pain diagnoses after the implementation of a systematic evaluation of pain (study intervention)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "The sample was divided into: pre- and postintervention. The Nursing Diagnosis Accuracy Scale, which scores accuracy as null, low, moderate, or high, was used."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In the postimplementation, acute pain was diagnosed more often. However, accuracy only improved in the moderate category."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Diagnosis of acute pain increased in the postimplementation period, but accuracy did not."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS",
            "content": "The development of strategies for improvement of diagnostic accuracy is warranted."
          }
        ]
      },
