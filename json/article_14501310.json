      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the results of surgical treatment on athletes presenting with chronic symphysis syndrome (lower abdominal, groin, and adductor pain)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective nonrandomized study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Swiss Olympic Medical Center associated with Institute of Sports Sciences."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Twenty-four athletes who were treated for chronic symphysis syndrome, a combination of abdominal, groin, and adductor pain, were evaluated for an average of 6.6 years after surgery. All athletes were males, with a mean age of 25.8 years. The average duration of chronic symptoms was 17 months."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Of patients, 20 underwent spreading of the lateral border of the sheath of the rectus abdominis muscle together with an epimysial adductor release, and 4 had only the reconstruction of the rectus abdominis muscle."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Subjective (questionnaire) and objective (clinical examination) follow-up data using point scores were obtained at a mean of 6.6 years posttreatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The mean point score in the subjective overall rating was 10.2 (maximum 12) and in the objective rating was 12.0 (maximum 13). Of athletes, 21 were very content, 2 were content, and 1 was not content. Full sports activity was noted in 23 of 24 athletes."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Surgical treatment of chronic symphysis syndrome is successful and can salvage the career of athletes."
        }
      ]},
