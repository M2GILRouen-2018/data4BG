      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Wünderlich's Syndrome is a spontaneous retroperitoneal haemorrhage characterised by sudden lumbar pain, tangible mass in the lumbar region and signs of hypovolaemic shock."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "A 65 year-old female presented the classic triad indicating Wünderlich's syndrome. Imaging techniques with three-dimensional reconstruction enabled us to determine the diagnosis and aetiology, and aided in determining the treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "We emphasise the importance of imaging methods in diagnosing and choosing treatment for Wünderlich s Syndrome."
        }
      ]},
