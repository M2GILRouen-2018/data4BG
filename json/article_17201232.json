      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To provide a comprehensive practical overview of the use of acoustic rhinometry in the practice of allergy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "An all-inclusive PubMed search was conducted for articles on acoustic rhinometry that were published in peer-reviewed journals, between 1989 and 2006, using the keywords acoustic rhinometry, allergic rhinitis, and nasal provocation testing."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY SELECTION",
          "content": "The expert opinion of the authors was used to select studies for inclusion in this review."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Acoustic rhinometry is a sound-based technique used to measure nasal cavity area and volume. It has been validated by comparison to measurements with computed tomography and magnetic resonance imaging. Acoustic rhinometry requires minimal patient cooperation and may be used in adults, children, and infants. It is used by medical practitioners to diagnose and evaluate therapeutic responses in conditions such as rhinitis and to measure nasal dimensions during allergen provocation testing. Acoustic rhinometry also provides a visual reflection of the nasal response to therapy, which may be useful in increasing compliance to prescribed medications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Acoustic rhinometry is a safe, noninvasive, objective, and validated measure of nasal obstruction that appears to be of practical use in the diagnosis and management of inflammatory diseases of the upper airways."
        }
      ]},
