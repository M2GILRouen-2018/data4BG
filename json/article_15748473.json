      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the levels of nitric oxide synthase (NOS) and nitric oxide (NO) in patients with coronary heart disease (CHD), and the factors affecting them."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Concentrations of NO and the activities of NOS in plasma in 136 patients and 206 controls using the corresponding Kits were measured. The data were analyzed using covariance and multiple linear regression analysis with SAS 8.1."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The levels of NO [(217.05 +/- 153.31) micromol/L] and NOS [(14.09 +/- 7.14) U/ml] in patients were significantly higher than that in the healthy controls [(140.69 +/- 90.96) micromol/L, (7.75 +/- 3.79) U/ml, respectively, P < 0.01]. Smoking and drinking were the independent risk factors for NOS, while sex was the independent risk factor for NO (P < 0.01)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The levels of plasma NO and NOS are closely related with coronary heart disease."
        }
      ]},
