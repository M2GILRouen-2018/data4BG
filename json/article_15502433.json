      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This study was to examine the effects of Taping therapy on the deformed angle of the foot and pain in hallux valgus patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "The subjects were 24 feet from 15 patients who were diagnosed withhallus valgus at the orthopedic department of K University Hospital in Seoul. Taping therapy was conducted 15 times overall during a four-week period. Data was analyzed using descriptive statistics and t-test."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "The deformed angle of the foot of the hallus valgus patients significantly improved from 21.95 (4.38) to 18.75 (4.80) after Taping therapy. Pain significantly decreased from 4.73 (1.56) to 3.45 (2.21) after Taping therapy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The result shows that Taping therapy is effective in improving the deformed angle of the foot and in decreasing pain in the hallux valgus patients."
        }
      ]},
