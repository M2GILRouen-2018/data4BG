      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND PURPOSE",
          "content": "This study was conducted to determine the risk factors for ischemic stroke in a defined Russian population."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Our data are based on a population-based case-control study of 237 patients with first-ever ischemic stroke and 237 age- and sex-matched controls. Logistic regression methods for matched pairs were used to estimate the relative risk for the variables studied."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In a multivariate analysis, hypertension, left ventricular hypertrophy on electrocardiography, ischemic heart disease, mitral valve disease, current cigarette smoking, and high body mass index were significant and independent risk factors for ischemic stroke in this Russian community."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The significant risk factors for ischemic stroke in Novosibirsk are similar to those from other populations and cohorts. This study, the first of stroke risk factors in Russia, has implications for clinical practice and the planning of stroke prevention in the population."
        }
      ]},
