      "Abstract": {
        "CopyrightInformation": "© 2010 The Authors Acta Obstetricia et Gynecologica Scandinavica© 2010 Nordic Federation of Societies of Obstetrics and Gynecology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare the impact of 5 IU (international units) of oxytocin administered during surgical termination of first-trimester pregnancy compared to no oxytocin, on postoperative bleeding, pain and nausea."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A randomized controlled single-blinded study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A Norwegian community hospital with 1,064 consecutive legal abortions in the 20 months of study period."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SAMPLE",
            "content": "A total of 378 women undergoing surgical termination of first-trimester pregnancy and willing to participate in the study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Women were randomized into two groups: Group 1, receiving a standard procedure of 5 IU of oxytocin during the surgical procedure, or Group 2, receiving no oxytocic agent. All women had preoperative misoprostol."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Vaginal bleeding, pain and nausea recorded by weighing pads immediately after the surgical procedure and counting pads during the three following days."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No significant differences between the two groups could be demonstrated with regard to the recorded postoperative blood loss, pain and nausea."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The standard routine of administering oxytocin during surgical termination of first-trimester pregnancy should be revised."
          }
        ]
      },
