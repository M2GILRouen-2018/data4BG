      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Children with severe asthma have persistent symptoms despite treatment with inhaled corticosteroids (ICSs). The differentiating features of severe asthma in children are poorly defined."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To identify features of severe versus mild-to-moderate asthma in school-age children using noninvasive assessments of lung function, atopy, and airway inflammation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 75 children (median age, 10 years) with asthma underwent baseline characterization including spirometry and lung volume testing, methacholine bronchoprovocation, allergy evaluation, and offline measurement of exhaled nitric oxide (F(ENO)). Twenty-eight were followed longitudinally over 6 months. Participants were assigned to the severe asthma subgroup if they required high-dose ICS plus 2 or more minor criteria."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Children with severe versus mild-to-moderate asthma had more symptoms, greater airway obstruction, more gas trapping, and increased bronchial responsiveness to methacholine. Subjects with severe asthma also had higher concentrations of F(ENO) and significantly greater sensitization to aeroallergens. With long-term study, both the reduction in FEV(1) and increase in F(ENO) persisted in the severe versus mild-to-moderate group. Furthermore, despite adjustments in ICS doses, the frequency of exacerbations was significantly higher in subjects with severe (83%) versus mild-to-moderate asthma (43%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Severe asthma in childhood is characterized by poor symptom control despite high-dose ICS treatment and can be differentiated from mild-to-moderate asthma by measurement of lung function and F(ENO)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CLINICAL IMPLICATIONS",
          "content": "Clinicians should suspect severe asthma in children with poor response to ICS, airway obstruction, and high F(ENO)."
        }
      ]},
