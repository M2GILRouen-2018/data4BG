      "Abstract": {
        "CopyrightInformation": "Copyright © 2015. Published by Elsevier Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Eventration of diaphragm associated with gastric volvulus is an uncommon condition."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE PRESENTATION",
            "content": "We reporting a case of a 16-year-old male having left sided diaphragmatic eventration associated with acute mesenteroaxial gastric volvulus. The patient presented with acute pain abdomen and upper abdomen fullness. Plication of left hemidiaphragm with anterior gastropexy was performed through an abdominal approach. Postoperatively the patient's recover uneventfully."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Symptomatic gastric volvulus associated with diaphragmatic eventration is a surgical emergency and always requires surgical repair."
          }
        ]
      },
