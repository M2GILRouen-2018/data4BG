      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "to explore and examine the relationship between maternal anxiety levels and feelings of control during labour among Hong Kong Chinese first-time pregnant women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "an exploratory descriptive correlation design. Data were collected on three occasions: during latent phase of labour, during active phase of labour and within 24-48 hrs after delivery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "an obstetric unit of a public teaching hospital in Hong Kong."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "a convenience sample of 90 Hong Kong Chinese first-time mothers."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND FINDINGS",
          "content": "the Labour Agentry Scale (LAS) is a self-report scale designed to measure feelings of control during childbirth. A Visual Analogue Scale for anxiety (VAS-A) was used to measure women's self-reported level of anxiety during labour. Pearson Product Moment Correlation coefficient test indicated a significant negative relationship between the feelings of control and maternal anxiety during labour. No statistical relationships were detected between women's attendance at antenatal classes and feelings of control during labour."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "KEY CONCLUSIONS",
          "content": "the study showed a significant negative relationship between maternal anxiety and feelings of control during labour."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR PRACTICE",
          "content": "midwives should work with women to enhance their personal control during labour and satisfaction with their birth. The insignificant relationship between attendance at antenatal classes and feelings of control suggests the need to evaluate the content of childbirth education in order to empower women's control during labour."
        }
      ]},
