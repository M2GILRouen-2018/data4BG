      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To measure bone marrow transplant (BMT) nurses' knowledge, beliefs, and attitudes regarding pain management."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive, exploratory."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A 32-bed BMT unit in a 567-bed tertiary-care institution located in the midwestern United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "39 BMT nurses (20 pediatric, 19 adult). The mean length of BMT experience was 7.05 years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "BMT nurses completed a 49-item, investigator-developed questionnaire."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Nurses' knowledge, beliefs, and attitudes related to pain management."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Many BMT nurses had high knowledge levels and positive beliefs and attitudes related to pain management. The mean of correct responses to knowledge items was 79%. Nurses had a high knowledge level of pain assessment, but only 74% indicated that patient self-report of pain is the most reliable indicator of pain. The majority of the nurses' responses were congruent with literature sources regarding the onset of mucositis pain, self-report of pain, and opioid tapering. Most nurses agreed that pain management is rewarding and satisfying; fewer agreed that it is not stressful. Nurses' requests for information focused on opioid therapy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The investigators identified specific knowledge gaps. The variability of scores indicated that some nurses are more expert than others regarding pain management and therefore could be resources for other nurses."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Educational offerings can increase knowledge and promote positive beliefs and attitudes among BMT nurses, thereby enhancing pain management."
        }
      ]},
