      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To assess the efficacy of laser laparoscopic photocoagulation of endometriomas (2-18 cm) in patients with pain, infertility, or a combination of the two."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective review of all patients with endometriomas from June 1, 1983, to December 31, 1993."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Department of gynecology and obstetrics at a district general hospital and national training center in minimal access surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "One hundred sixty-five women with large endometriomas present at the time of laser laparoscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Carbon dioxide laser or potassium-titanyl-phosphate laser laparoscopic surgery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Ninety (74%) of 122 patients reported improvement or resolution of pain; and 30 of 66 achieved a pregnancy, for a cumulative conception rate of 45%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Laser laparoscopy is a practical, safe, and effective technique for the management of large ovarian endometriomas."
        }
      ]},
