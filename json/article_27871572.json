      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVES",
            "content": "Sleeve gastrectomy has been one of the most commonly performed bariatric surgery methods. The study aimed to compare the effects of 2 most commonly used inhalation anesthetics, sevoflurane and desflurane, on the peroperative hemodynamic alterations and postoperative respiratory functions in morbidly obese patients undergoing sleeve gastrectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Nonrandomized cohort."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTINGS",
            "content": "Operating room, postoperative period."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Eighty-four morbidly obese patients with a body mass index greater than 40 kg/m(2) who had scheduled to undergo sleeve gastrectomy operation were prospectively included in the study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients were divided into 2 groups. The maintenance of inhalation anesthesia was performed by sevoflurane in 1 group (sevoflurane group) and desflurane (desflurane group) in the other group."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Demographic features, peroperative hemodynamic alterations, and the results of preoperative and postoperative 24th hour respiratory function tests were recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was not any statistically significant difference between groups regarding age, sex, body mass index, anesthesia time, peroperative mean arterial pressure, arterial oxygen saturation, end-tidal carbon dioxide, and preoperative or postoperative forced expiratory volume 1/forced vital capacity ratios."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "We determined that both desflurane and sevoflurane provide similar intraoperative hemodynamic and early postoperative respiratory functions in morbidly obese patients in laparoscopic sleeve gastrectomy. Both agents can be regarded as alternatives for inhalation anesthetics in maintenance of anesthesia."
          }
        ]
      },
