      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the incidence of persistent pain after cesarean delivery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 340 pregnant women with no history of abdominal surgery were randomized to undergo or not undergo parietal peritoneal closure following elective cesarean delivery. Pain scores were recorded on the 1st and 15th postoperative day and the women were followed up every 2 weeks up to 8 months after surgery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Overall and epigastric abdominal pain were more frequent in the closure than in the nonclosure group. Pain scores on the 1st and 15th days and after 8 months were higher in the closure group, in which the incidence of persistent postcesarean pain was 17.8% after 8 months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Parietal peritoneal closure after cesarean delivery is associated with a higher incidence of early and persistent postoperative pain. A high pain score on the 1st day is a predictor of persistent pain."
        }
      ]},
