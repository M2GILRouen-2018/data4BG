      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the effects of low-intensity exercise on chronic muscle pain and potential activation of the endogenous opioid system."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized placebo-controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Animal laboratory."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANIMALS",
          "content": "Sixty-three male Sprague-Dawley rats."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Rats performed a low-intensity exercise protocol for 5 consecutive days after the induction of chronic muscle pain. In a separate experiment, naloxone or saline was administered systemically before 5 low-intensity exercise sessions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Mechanical hyperalgesia was measured using von Frey filaments to determine the mechanical withdrawal threshold."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Low-intensity exercise increased mechanical withdrawal threshold in the chronic muscle pain model. Naloxone attenuated the antihyperalgesic effects of low-intensity exercise."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Low-intensity exercise reversed mechanical hyperalgesia in the chronic muscle pain model through activation of the endogenous opioid system."
        }
      ]},
