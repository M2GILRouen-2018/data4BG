      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To test the hypotheses that the effects of a music intervention are greater than those of simple distraction and that either intervention is better at controlling procedural pain and anxiety than treatment as usual."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, controlled experiment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A midwestern comprehensive cancer center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "60 people with cancer having noxious medical procedures such as tissue biopsy or port placement or removal; 58 provided usable data."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants completed measures of pain and anxiety before and after their medical procedures and provided a rating of perceived control over pain and anxiety after the procedure."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Procedural pain, state anxiety, and perceived control over pain and anxiety."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Contrary to hypotheses, outcomes achieved with music did not differ from those achieved with simple distraction. Moreover, outcomes achieved under treatment as usual were not significantly different from those obtained with music or distraction interventions. Some patients found that the interventions were bothersome and reported that they wanted to attend to the activities of the surgeon and the medical procedure itself."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The effects of music, distraction, and treatment as usual are equivocal. In addition, patients have individual preferences for use of distraction during painful or anxiety-provoking procedures."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "Patients having noxious medical procedures should be asked about their desire to be distracted before and during the procedure and offered a strategy that is consistent with their preferences."
        }
      ]},
