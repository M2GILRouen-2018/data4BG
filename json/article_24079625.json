      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "The World Health Organization has solicited rapid and minimally invasive techniques to facilitate scale-up of voluntary medical male circumcision (VMMC)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Non-blinded randomized controlled field trial with 2:1 allocation ratio."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "75 adult male volunteers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient primary care clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Open surgical circumcision under local anesthetic with suturing vs. Unicirc disposable instrument under topical anesthetic and wound sealing with cyanoacrylate tissue adhesive."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PRIMARY OUTCOME",
          "content": "Intraoperative duration."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "SECONDARY OUTCOMES",
          "content": "Intraoperative and postoperative pain; adverse events; time to healing; patient satisfaction; cosmetic result."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The intraoperative time was less with the Unicirc technique (median 12 vs. 25 min, p < 0.001). Wound healing and cosmetic results were superior in the Unicirc group. Adverse events were similar in both groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "VMMC with Unicirc under topical anesthetic and wound sealing with cyanoacrylate tissue adhesive is rapid, heals by primary intention with superior cosmetic results, and is potentially safer and more cost-effective than open surgical VMMC."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "TRIAL REGISTRATION",
          "content": "Clinicaltrials.gov NCT02443792."
        }
      ]},
