      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "The adverse effects of lumbar myelography in 400 patients were analyzed."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine whether adverse effects of lumbar myelography occur less frequently when using the fine needle technique."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Lumbar myelography can be performed safely on an outpatient basis. The side effects may be reduced by using the fine needle technique."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Four hundred patients were studied; 200 with a 25 gauge needle and 200 with a 22 gauge needle. Each was given a questionnaire and instructed to report details of post-myelogram adverse effects."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Transient worsening of back or leg symptoms, headache, and nausea and vomiting, the most frequent complaints, were reduced in the 200 patients studied with a 25 gauge needle rather than a 22 gauge needle. Regardless of the needle, patients with normal myelograms reported more adverse effects."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A lower frequency of adverse effects can be achieved when fine needle is used for lumbar myelography. More adverse effects are reported by patients with normal myelograms."
        }
      ]},
