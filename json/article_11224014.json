      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A survey on pain satisfaction was mailed to 300 individuals with spinal cord injury. Eighty-eight completed surveys were returned, and the results were analyzed."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The survey queried the respondents on characteristics of their pain, treatments received, the impact of pain on multiple, life activities and functions and the satisfaction with treatment received to reduce pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Subjects for the study were selected from the Spinal Cord Injury Registry from the Commonwealth of Virginia in the US."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Information was obtained from a survey sent to the subjects who were chosen randomly with respect to age and gender. At least 1 year had elapsed from the time of injury for each individual."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Respondents were typically dissatisfied with the results of the treatments received to manage their pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Pain in individuals with spinal cord injury needs to be addressed in a thorough fashion to reduce the adverse impact on life activities."
        }
      ]},
