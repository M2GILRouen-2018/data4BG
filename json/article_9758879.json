      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study inquired into the relationship between methylenetetrahydrofolate reductase (MTHFR) gene polymorphism and coronary heart disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "By polymerase chain reaction and restriction fragment length polymorphism (PCR-RFLP), MTHFR 677C-->T mutation was detected in 79 healthy controls and 69 patients with coronary heart disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The frequency of MTHFR variant V677 of patients was significantly higher than that of healthy controls (P<0.01)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This study demonstrated that MTHFR gene V677 mutation was probably one of the genetic risk factors of coronary heart disease and this provided a new basis for exploring the relevant pathogenesis."
        }
      ]},
