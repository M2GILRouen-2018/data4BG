      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Physical inactivity is a risk factor for chronic pain. Several mechanisms play a role in pain chronification including impairment of pain inhibition."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study compared the efficiency of pain inhibitory systems between physical active and inactive healthy subjects. It was hypothesized that active subjects had more efficient pain inhibition compared with inactive subjects."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A randomized, crossover study with 2 days of data collection."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Fifty-six (28 females) subjects participated in this study. Subjects were subgrouped into active (n\u2009=\u200930) and inactive (n\u2009=\u200926). Conditioned pain modulation (CPM) was assessed by cold pressor testing. Exercise-induced hypoalgesia (EIH) was assessed after 15 minutes bicycling at a heart rate corresponding to 75% VO2max. A control session of 15 minutes quiet rest was also included. Pressure pain thresholds (PPTs) were recorded at the dominant arm and leg before, immediately after, and 15 minutes after conditioning and exercise as well as before and after rest. PPTs were also recorded during conditioning."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "At baseline, PPTs in inactive men were increased compared with inactive women (P\u2009<\u20090.003). During cold pressor test and after exercise, PPTs increased to the same degree in active and inactive subjects, and the CPM and EIH responses were correlated (P\u2009<\u20090.05). The CPM response immediately after cold pressor test was maintained in women but not in men."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Cold pressor stimulation and aerobic exercise caused comparable multisegmental increases in PPT in active and inactive men and women. The CPM and EIH responses were correlated, but they have different temporal manifestation of hypoalgesia."
          }
        ]
      },
