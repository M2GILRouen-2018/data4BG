      "Language": "por",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "to compare the relative value of Atrial Pacing and Exercise Electrocardiography in the diagnosis of Myocardial Ischaemia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "prospective study in patients referred for coronary cineangiography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Cineangiography and Ergonometry Departments of Cardiology Service. Santa Maria Hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "16 patients (mean age 52.4 +/- 6.3), 13 males and 3 females. All were submitted to Atrial Pacing, Exercise Test and Coronariography."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "both tests were concordant in all cases but one, with negative Atrial Pacing, positive Exercise Test and negative Coronariography."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Atrial Pacing compares favourably with Exercise Test in the diagnosis of Coronary Ischaemic Disease. It may constitute a valid alternative in patients unable to perform a conclusive Exercise Test."
        }
      ]},
