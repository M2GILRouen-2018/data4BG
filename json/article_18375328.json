      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The pharmacokinetics of ropivacaine 0.2% were evaluated during a 48-hour continuous extrapleural infusion with 2 different infusion rates in patients undergoing cardiovascular surgery. The hypotheses that no toxic plasma concentrations of ropivacaine would be reached and that proportionality exists among plasma concentrations and dosage used were tested."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective, randomized, nonblinded study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The investigation was performed as a single-center study in the Division of Cardiovascular Anesthesia, University Hospital of Zurich, in Switzerland."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Seventeen consenting adults scheduled for elective cardiovascular surgery, with or without extracorporeal bypass, via the lateral thoracotomy approach were enrolled."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "For postoperative pain relief, patients were randomly assigned to receive continuous extrapleural infusion of ropivacaine 0.2% at a rate of either 6 or 9 mL/h over 48 hours."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Plasma concentrations of ropivacaine reached toxic levels (>2.2 mg/L) in 25% of cases. No proportionality of plasma concentrations of ropivacaine existed when the 2 dosing regimens were compared."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Plasma concentrations of ropivacaine, administered at the given dose and rates during continuous extrapleural infusion, are unpredictable and may reach toxic levels in patients undergoing major cardiothoracic surgery."
        }
      ]},
