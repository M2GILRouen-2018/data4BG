      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright 2001 Wiley-Liss, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVE",
            "content": "A high restenosis rate remains a limiting factor for percutaneous transluminal coronary angioplasty and stenting. The objective of this study was to evaluate the effect of intravascular red laser therapy (IRLT) on restenosis after stenting procedures in de novo lesions."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN/MATERIALS AND METHODS",
            "content": "A total of 68 consecutive patients were treated with IRLT in conjunction with coronary stenting procedures. Mean lesion length was 16.5 +/- 2.4 mm. Reference vessel diameter (RVD) and pre-minimal lumen diameter (MLD) were 2.90 +/- 0.15 mm and 1.12 +/- 0.26 mm, respectively."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After treatment, MLD was 2.76 +/- 0.32 mm with no procedural complications or in-hospital adverse events. Angiographic follow-up (n = 61) revealed restenosis in nine patients (14.7%) with rate by artery size of > 3 mm (n = 21) 0%; 2.5--3.0 mm (n = 28) 14.2%; and < 2.5 mm (n = 12) 41.6%."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Intravascular red light therapy is safe, feasible, and reduces expected restenosis rate after coronary stenting."
          }
        ]
      },
