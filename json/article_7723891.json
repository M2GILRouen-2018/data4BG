      "Language": "dut",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the benefits of preoperative physical therapy and instruction of patients with primary coxarthrosis to be subjected to a total hip arthroplasty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University Hospital Maastricht."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHOD",
          "content": "During 14 months the effects were measured of preoperative physical therapy and instruction of 64 patients divided into two populations; one group (n = 31) received preoperative instruction and physical therapy, the other did not (n = 33). Effects were measured with the Visual Analog Scale, the Harris Hip Score and the days patients could stand, walk, climb a stair and be discharged."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The Harris Hip Score showed a significant difference (p < 0.05) favouring the instructed group on day 14 after the operation and at the moment the patients were discharged. The other parameters showed no significant differences between the groups. Differentiation by age, gender and type of arthroplasty showed the same results."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Preoperative exercise and instruction is not useful for patients who in the near future will be treated with a total hip arthroplasty for primary coxarthrosis."
        }
      ]},
