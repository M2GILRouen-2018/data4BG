      "Abstract": {
        "CopyrightInformation": "© 2014, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To evaluate the effects of web-based information on parental self-efficacy in managing obesity risk in preschoolers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "The project included a literature review and the development and field testing of an information website that presented information on how to manage nine obesity risk factors for childhood obesity."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Parents stated that they had no problems using the website, and 69% reported improved self-efficacy on at least two risk factors."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Many parents access the Internet to obtain health information. A website that offers practical information on managing childhood obesity risk factors is a valuable resource for obesity prevention efforts."
          }
        ]
      },
