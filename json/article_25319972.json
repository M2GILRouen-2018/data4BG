      "Abstract": {
        "CopyrightInformation": "Copyright© by the American Society for Clinical Pathology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Compliance testing in pain management requires a distinct approach compared with classic clinical toxicology testing. Differences in the patient populations and clinical expectations require modifications to established reporting cutoffs, assay performance expectations, and critical review of how best to apply the available testing methods. Although other approaches to testing are emerging, immunoassay screening followed by mass spectrometry confirmation remains the most common testing workflow for pain management compliance and drug abuse testing."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A case-based approach was used to illustrate the complexities inherent to and uniqueness of pain management compliance testing for both clinicians and laboratories."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A basic understanding of the inherent strengths and weaknesses of immunoassays and mass spectrometry provides the clinician a better understanding of how best to approach pain management compliance testing."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Pain management compliance testing is a textbook example of an emerging field requiring open communication between physician and performing laboratory to fully optimize patient care."
          }
        ]
      },
