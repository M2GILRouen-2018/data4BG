      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2015.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To investigate health anxiety and depressive symptoms in patients with fibromyalgia syndrome (FMS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Patients with FMS and healthy control subjects were recruited. All participants completed the Health Anxiety Inventory Short Form (HAI-SF) and Beck Depression Inventory (BDI). Pain was assessed in patients with FMS using the Fibromyalgia Impact Questionnaire (FIQ) and Visual Analogue Scale (VAS)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "This study involved 95 patients with FMS (15 male) and 95 healthy controls (17 male). Mean\u2009±\u2009SD HAI-SF and BDI scores were significantly higher in patients with FMS\u2009=\u2009than in controls=. HAI-SF scores were 23.50\u2009±\u200910.78 and 9.38\u2009±\u20094.24 respectively; BDI scores were 18.64\u2009±\u200910.11 and 6.21\u2009±\u20094.05 respectively. There were highly significant correlations between FIQ and HAI-SF, FIQ and BDI, and HAI-SF and BDI."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Patients with FMS had significantly higher HAI-SF and BDI scores than healthy controls. Psychiatric support is essential for patients with FMS. Treatment should include biological, psychological and social approaches."
          }
        ]
      },
