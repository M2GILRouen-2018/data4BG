      "Abstract": {
        "CopyrightInformation": "2010 Arthroscopy Association of North America. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To retrospectively report on a series of patients who had interscalene block regional anesthesia performed for outpatient open and arthroscopic shoulder surgical procedures in a community-based ambulatory surgery center setting."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We reviewed the cases of 1,945 patients who had interscalene block regional anesthesia performed during an 8-year period."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The complication rate was 0.63%, with all complications occurring in the immediate postoperative period, none of which were permanent."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "With an expert, experienced anesthesia team, the interscalene block can be a safe method (temporary complication rate, 0.63%) of intraoperative anesthesia and perioperative analgesia for outpatient open and arthroscopic shoulder surgery in physician-owned ambulatory surgery centers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "Level IV, therapeutic case series."
          }
        ]
      },
