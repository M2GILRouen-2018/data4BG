      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The shoulder is the most common location for calcific tendonitis. Presentation of calcific tendonitis at other sites is unusual and may lead to diagnostic difficulty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND PATIENTS",
          "content": "We report a case of calcific tendonitis of the pectoralis major insertion and describe the CT and MRI findings."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RESULTS AND CONCLUSION",
          "content": "The presence of an associated cortical defect at the site of tendon insertion may lead to the incorrect diagnosis of neoplastic process."
        }
      ]},
