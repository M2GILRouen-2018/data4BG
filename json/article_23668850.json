      "Abstract": {
        "CopyrightInformation": "PsycINFO Database Record (c) 2014 APA, all rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of this research was to examine the impact of nonstigmatizing visual portrayals of obesity on support for a discriminatory weight-based medical policy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Participants read an online news story about a policy to deny fertility treatment to obese women that was accompanied by a nonstigmatizing, stigmatizing, or no image of an obese couple. A balanced discussion of the policy was presented, with information both questioning the policy as discriminatory and supporting the policy because of weight-related medical complications."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Results revealed that participants who viewed the nonstigmatizing image were less supportive of the policy to deny obese women fertility treatment and recommended the policy less strongly than participants who viewed the stigmatizing image. Furthermore, weaker perceptions of medical risk mediated the effect of the nonstigmatizing image on policy ratings."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The findings indicate that simply eliminating stigmatizing media portrayals of obesity may help reduce bias."
          }
        ]
      },
