      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To identify the effects of unicornuate uterus with rudimentary horn on reproductive function and analyze the diagnosis and treatment of the condition."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The study was based in the gynecological unit of a city based Medical Center in Mainland China. Twenty-two cases of this anomaly were selected from a group of 130 cases of uterine abnormalities and were retrospectively analyzed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "This kind of anomaly can cause hematometra and endometriosis leading to acute abdominal pain, infertility, rupture of pregnant rudimentary horn and obstetrical complications with pregnant semi-uterus."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Rudimentary horn should be removed if detected."
        }
      ]},
