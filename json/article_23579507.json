      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the feasibility and safety of hand-assisted laparoscopic surgery for gastric cancer in obese patients, we compared the operative outcomes between obese and nonobese patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 114 patients suffering from gastric cancer operated in our department from October 2009 to February 2012 were divided into 2 groups: the obese patients group and the nonobese patients group."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Wound length, times of analgesic injection, time to the first flatus, postoperative hospital stay, tumor size, retrieved lymph nodes, AJCC/UICC staging, and resection margins were equivalent between the 2 groups. The estimated blood loss and operative time were significantly less or shorter in the nonobese patients group than in the obese patients group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Obesity should not be seen as a contraindication for hand-assisted laparoscopic distal gastrectomy, which is a safe and feasible procedure for obese patients."
        }
      ]},
