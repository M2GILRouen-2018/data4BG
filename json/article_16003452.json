      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To review the literature on anxiety, post-traumatic stress disorder (PTSD) and depression in patients with coronary artery disease (CAD), and to present an approach to diagnosis and treatment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "MEDLINE and PsychInfo searches of English-language articles were performed. Search terms included 'anxiety', 'post-traumatic stress disorder' and 'depression', with various cardiac-related subject headings."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Research indicates that anxiety, PTSD and depression occur frequently in patients with CAD, but these psychological problems are rarely identified or treated in the cardiology or primary care setting."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The present review offers practical recommendations on how to detect and assess anxiety, PTSD and depression in the cardiology or primary care setting. Treatment recommendations are provided, with a focus on pharmacotherapy for anxiety and depressive disorders in patients with CAD."
        }
      ]},
