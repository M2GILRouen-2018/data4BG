      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To examine associations between occupation and respiratory health in a large, population-based cohort of adults in the United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Data from 15,273 participants, aged 45 to 64 years, in the Atherosclerosis Risk in Communities study were used to examine associations of current or most recent job held with the prevalence of self-reported chronic cough, chronic bronchitis, wheezing, asthma, and measures of lung function collected by spirometry."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Eleven percent of participants reported wheezing and 9% were classified as having airway obstruction. Compared with individuals in managerial and administrative jobs, increased prevalences of respiratory outcomes were observed among participants in selected occupations, including construction and extractive trades (wheezing, prevalence ratio = 1.92, 95% confidence interval = 1.35, 2.73; airway obstruction, prevalence ratio = 1.31, 95% confidence interval = 1.05, 1.65)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Specific occupations are associated with adverse respiratory health."
        }
      ]},
