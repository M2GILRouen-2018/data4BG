      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Asthma is a common global health problem. Environmental exposures such as bacteria may protect against asthma development."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This review aims to examine the possible protective role of pneumococcal infection and vaccination in asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A review of known experimental biology and human epidemiology relating to asthma and pneumococcal infection was performed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pneumococcal infection can modulate components of allergic airways disease such as airways hyperresponsiveness and airway eosinophilia. Exposure to killed pneumococcus can reproduce these effects and the mechanism may involve control by T regulatory cells."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Pneumococcal immunoregulatory therapy is a potentially important approach to asthma management that requires further evaluation in well-designed research studies."
        }
      ]},
