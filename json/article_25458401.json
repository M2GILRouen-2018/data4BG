      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 SEEN. Published by Elsevier Espana. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To measure macrophage migration inhibitory factor (MIF) concentrations in obese and non-obese women diagnosed with polycystic ovary syndrome (PCOS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Women diagnosed with PCOS and age-matched healthy controls with regular menses and normal ovaries on ultrasound examination were selected and divided into 4 groups (group A, PCOS and obese; group B, PCOS and non-obese; group C, obese controls; and group D, non-obese controls) based on body mass index (obese >30 kg/m2 and non-obese <25 kg/m2). Luteinizing hormone, follicle-stimulating hormone, androstenedione, testosterone, sex hormone-binding globulin, serum glucose, insulin and MIF levels were measured."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Obese and non-obese women with PCOS had higher luteinizing hormone, follicle-stimulating hormone, androstenedione, testosterone, and insulin levels as compared to the obese and non-obese control groups, respectively (P < .0001). Women with PCOS had significantly higher MIF levels (group A, 48.6 ± 9.9 mg/ml; group B, 35.2 ± 6.0 ng/ml) as compared to controls (group C, 13.5 ± 6.0 ng/ml; group D, 12.0 ± 4.3 ng/dl; P < .0001). A weak, positive and significant correlation was seen between fasting blood glucose and insulin levels in women with PCOS (P < .05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Significant differences exist in plasma MIF levels between obese and non-obese women with and without PCOS."
          }
        ]
      },
