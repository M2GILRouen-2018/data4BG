      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The authors evaluated the effectiveness of percutaneous epidural adhesiolysis (PEA) in patients with low back pain due to contained disc herniation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "Twenty patients with low back pain due to contained disc herniation underwent PEA treatment with the Racz technique. The patients were evaluated for pain score, medication intake, significant pain relief, and complications."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At three days, one month, three months, and six months after PEA compared to pre-PEA evaluations, the pain scores and medication intake were significantly decreased. Significant pain relief declined from 95% at three days to 75% at six months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "PEA for low back pain due to contained disc herniation is a safe and effective procedure. Therefore, it may be considered as an option for treatment before invasive operations are performed."
        }
      ]},
