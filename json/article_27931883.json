      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Counselling for day surgery patients is one of the core components for a knee or shoulder arthroscopy patient to succeed in self-care."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "This cross-sectional study examined the quality of counselling given to patients (n\u2009=\u200986) during their day surgery, using the Counselling Quality Instrument (CQI)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The data were analysed using basic and multivariate statistical methods."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Most respondents were male and aged over 50 years. Almost all knee and shoulder arthroscopy patients were satisfied with the counselling given on follow-up and rehabilitation as well as the counselling given relating to wound and pain treatment. There was a lack of patient-centred and goal-oriented counselling, although interaction during counselling was good. Counselling was perceived as providing benefit in regard to a patient's self-care, emotions and knowledge. Respondents aged below 40 years were more dissatisfied with counselling for day surgery than those aged 40 years and over."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This study identified a need to train healthcare staff in patient-centred and goal-oriented counselling. Counselling with people who are aged below 40 years should take account of patients' specific concerns."
          }
        ]
      },
