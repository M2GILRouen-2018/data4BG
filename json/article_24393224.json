      "Abstract": {
        "CopyrightInformation": "© 2013, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "This integrative review aims to increase our understanding of current pain management care practices for children undergoing tonsillectomy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Synthesis of the literature resulted in four main opportunities for care providers to manage pain: preoperative education and preparation, intraoperative surgical interventions, and postoperative pharmacologic and nonpharmacologic interventions in the post anesthesia care unit and home settings."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Nurses have many opportunities to understand pain management practices and intervene to minimize pain experienced in pediatric outpatients undergoing tonsillectomy."
          }
        ]
      },
