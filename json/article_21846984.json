      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Recently, it has been shown that PTPN22 genetic polymorphism is associated with phenotypes related to the risk of atherosclerosis. In the present note, we have searched for a possible association of PTPN22 polymorphism with coronary artery disease (CAD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "One hundred and thirty-four non-diabetic subjects admitted to hospital for CAD and 174 healthy subjects (blood donors) were studied. PTPN22 genotypes were determined by DNA analysis. Statistical analyses were performed by SPSS programs."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In CAD patients, the proportion of carriers of the *T allele of PTPN22 is significantly higher compared to healthy controls (OR 2.66; 95% CI 1.07-6.72)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The present observation confirms the association of PTPN22 phenotype with atherosclerosis and suggests a role of immune mechanism in the pathogenesis of CAD."
          }
        ]
      },
