      "Abstract": {
        "CopyrightInformation": "Georg Thieme Verlag Stuttgart.New York.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The operative management of the coeliac trunk compression syndrome involves the surgical division of the median arcuate ligament which is usually done by laparotomy. However, minimally invasive surgery is of some value for the patient regarding less pain and blood loss as well as shorter hospital stay."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT AND METHODS",
            "content": "We report in detail on the laparoscopic treatment of the coeliac trunk compression syndrome (Dunbar's syndrome) in a 20-year-old female."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Operation time was 101 min, there were no complications and 3 months postoperatively the patient is still free of symptoms as demons-trated by regular duplex ultrasound scans."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "For the experienced surgeon, laparoscopic division of the median arcuate ligament is the therapy of choice in Dunbar's syndrome."
          }
        ]
      },
