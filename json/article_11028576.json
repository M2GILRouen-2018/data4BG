      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate whether, during injections of sterile water, there is any difference in perceived pain between intracutaneous and subcutaneous injections."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Blind controlled trial with cross-over design."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Göteborg and Skövde, Sweden."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "One hundred healthy female volunteers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The women were randomised into two groups and subjected to two trials, within one week of each other. During the first trial one group (n = 50) received the intracutaneous injection first, followed by the subcutaneous injection. The second group (n = 50) was given the subcutaneous injection first, followed by intracutaneous injection. In both groups all the injections were given in reverse order during the second trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Experienced pain during the administration of sterile water injections, measured by visual analogue scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The analysis showed intracutaneous injections to be significantly more painful than subcutaneous injections, even after adjusting for injection day and for left/right site of injection (mean 60.8 vs 41.3, P < 0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The findings suggest that the less painful subcutaneous injection technique should be used."
        }
      ]},
