      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the analgesic effect of ethanolic extract of Nigella sativa seeds on experimentally-induced pain in albino mice."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Randomized controlled trial (RCT)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PLACE AND DURATION OF STUDY",
          "content": "Physiology Department, Services Institute of Medical Sciences (SIMS), Lahore, from May to September, 2009."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODOLOGY",
          "content": "The study was carried out in 90 male albino mice using acetic acid induced writhing test as a chemical model of nociception. The mice were divided in three groups of 30 each. Group A was given normal saline (control); group B was given Nigella sativa seed extract in a dose of 50 mg/kg; and group C received diclofenac sodium, as a reference drug. Number of writhings in treated and control groups were compared."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The ethanolic extract of Nigella sativa seeds given intraperitoneally caused significant (p < 0.05) analgesic effect on nociceptive response initiated by 0.6% acetic acid; although this analgesic effect was less than that produced by diclofenac sodium."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ethanolic extract of Nigella sativa possessed significant analgesic effect in mice."
        }
      ]},
