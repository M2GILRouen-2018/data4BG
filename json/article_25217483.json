      "Abstract": {
        "CopyrightInformation": "© International Headache Society 2014 Reprints and permissions: sagepub.co.uk/journalsPermissions.nav.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Treatment of neuropathic or neuralgic head and facial pain due to dental, traumatic or surgical nerve lesions or post-herpetic neuropathy is often challenging."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASES",
            "content": "We are reporting on four patients with neuropathic pain syndromes successfully treated with a capsaicin 8% patch in the affected area of the head or face."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Treatment with the capsaicin 8% patch seems to be effective and safe for application to the facial and head region. The capsaicin 8% patch might be an additional treatment option if first-line treatment with anticonvulsants or antidepressants was ineffective or limited by side effects."
          }
        ]
      },
