      "Abstract": {
        "CopyrightInformation": "© 2016 World Institute of Pain.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To develop consensus on a position paper on the use of intramuscular stimulation (IMS) for the treatment of myofascial pain syndrome (MPS) by physicians in Israel."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The Israeli Society of Musculoskeletal Medicine ran a modified Delphi process to gather opinions from a multidisciplinary expert panel. Eight experts in the treatment of MPS were chosen and asked to participate, and six participated. The position paper was iterated three times."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After three iterations, general consensus was reached by all six experts. The general statement that was agreed on was: \"IMS is one of the preferred treatments for myofascial pain syndrome. The treatment is evidence-based, effective, safe, and inexpensive. The position of the Israeli Society of Musculoskeletal Medicine is that the treatment should be taught and used by all primary care physicians and those physicians in other areas of medicine who deal with pain in their work.\""
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The position paper is a basis for clinical work and education programs for physicians interested in a better understanding and ability to treat patients with a musculoskeletal complaint or manifestation of disease."
          }
        ]
      },
