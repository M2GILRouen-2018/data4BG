      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Patient age is one important factor used to evaluate the risk in women with ASC-H (atypical squamous cells, cannot exclude high-grade squamous intraepithelial lesion). This finding may be associated with atrophic changes reflecting a hypoestrogenic status and suggests that body mass index (BMI) can affect the outcome of ASC-H smears in postmenopausal women."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "We investigated the outcome of 154 postmenopausal women with an ASC-H smear and assessed relationships with BMI categories and serum estradiol levels."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In patients with higher BMI, an underlying squamous intraepithelial lesion (SIL) was more frequent than in patients with lower BMI, and a higher BMI was also associated with increased serum estradiol levels. When samples were classified by preparation method, these findings were more pronounced in liquid-based smears than in conventional smears. Principal component analysis using three factors (BMI, age and human papilloma virus status) revealed two distinct groups: those with a negative cervical smear and those with a smear result indicating SIL+."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Hormonal alterations can affect the outcome of ASC-H smears, and BMI is one factor that should be considered when evaluating the risk associated with ASC-H smears in postmenopausal women."
          }
        ]
      },
