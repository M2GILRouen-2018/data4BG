      "Abstract": {
        "CopyrightInformation": "Copyright (R) 2000 S. Karger AG, Basel",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "9-cis-Retinoic acid (9-cis-RA) has a particular pattern of binding and activating retinoid receptors. Treatment of chronic hand eczema is often refractory to conventional treatment."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Evaluation of oral 9-cis-RA therapy in chronic hand eczema in a pilot study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Thirty-eight patients with refractory chronic hand eczema were treated in an exploratory open-label study with oral 9-cis-RA."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Twenty-one (55%) showed a very good response, 13 (34%) a good response, 2 (5.5%) a moderate response and 2 (5.5%) no response. Side effects were mild."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "9-cis-RA is a valuable drug when given at low doses to patients with chronic hand eczema."
          }
        ]
      },
