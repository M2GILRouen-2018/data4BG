      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 AAGL. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe 3 cases of peritoneal mesothelioma associated with endometriosis that were managed laparoscopically."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case series."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University and community hospitals."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Three women with well-differentiated papillary mesothelioma of the peritoneum associated with endometriosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Laparoscopic excision and treatment of mesothelioma and endometriosis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Three patients underwent laparoscopy for treatment of endometriosis and were found to have peritoneal mesothelioma. All 3 patients underwent total laparoscopic excision of the lesions and were followed up regularly for surveillance of possible recurrence."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In selected cases of well-differentiated papillary mesothelioma associated with pelvic endometriosis, operative laparoscopy can be used effectively to diagnose and treat this condition."
          }
        ]
      },
