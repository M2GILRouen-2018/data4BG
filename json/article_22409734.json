      "Abstract": {
        "CopyrightInformation": "© 2012 The Authors. International Journal of Paediatric Dentistry © 2012 BSPD, IAPD and Blackwell Publishing Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To estimate the prevalence, intensity and associated factors of dental pain in 7- and 8-year-old schoolchildren in a Southern Brazilian city."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A cross-sectional study was carried out involving a representative sample (n=401) of schoolchildren of Tubarão, Brazil. The data were obtained through oral examinations, following WHO criteria. Dental pain was analysed using a specific questionnaire developed to measure it. Prevalence and intensity of spontaneous pain and pain caused by cold and hot food and liquids were analysed. Association studies were carried out using chi-square test followed by nonconditional multiple logistic regression analysis to test for independence of association between outcomes and explanatory variables."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The prevalence of spontaneous dental pain and dental pain caused by cold and hot food and liquids was 31.7 and 28.1%, respectively. Females and schoolchildren who had visited the dentist at least once showed statistically higher prevalence of spontaneous pain and pain caused by cold and hot food and liquids. Eight-year-old schoolchildren and those presenting cavities in the primary dentition also showed higher prevalence of spontaneous dental pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The prevalence and intensity of dental pain were considered high. The prevalence showed to be associated with female gender, higher age, the presence of cavities in the primary dentition and dental visit."
          }
        ]
      },
