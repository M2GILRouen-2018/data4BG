        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Asthma is the most prevalent chronic illness in children and has been related to psychological aspects involved in its evolution."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To understand the types of relational patterns observed in families of children with this illness."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Qualitative analysis through intentional sample of children between the ages of 4 to 15 years with asthma and other mixed populations."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "RESULTS AND CONCLUSIONS",
            "content": "The analysis shows families with diffuse limits between its members, tendency towards amalgamation, high levels of anxiety, and the presence of parental and parental-offspring conflicts."
          }
        ]
      },
