      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "This study aimed to clarify the association between ovarian infertility and cardiovascular disease risk factors in later life in Japanese women."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "The Japan Nurses' Health Study (JNHS) is a cohort study of Japanese women's health. Data from the JNHS baseline survey (n = 49,927) between 2001 and 2007 were used in a cross-sectional, retrospective analysis. A total of 44,601 women were classified into three categories: ovarian infertility group (n=1167), other infertility group (n = 4619), and no infertility group (n = 38,815). Logistic regression analysis compared with the no infertility group was performed."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Age-adjusted odds ratios (ORs) and multivariable-adjusted ORs for hypertension, hypercholesterolemia, and diabetes mellitus (DM)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The prevalence of obese women (BMI ≥ 25) who were < 45 years old in the ovarian infertility group was significantly higher compared with that in the other groups. Women in the ovarian infertility group were at risk for hypertension at ≥ 45 years old (age-adjusted OR: 1.65%, confidence interval [CI]: 1.23-2.21); for hypercholesterolemia at < 45 and ≥ 45 years old (age-adjusted OR: 1.42, 95% CI: 1.06-1.88 at < 45 years; age-adjusted OR: 1.39, 95% CI: 1.06-1.81 at ≥ 45 years); and for DM at < 45 years old (age-adjusted OR: 2.92, 95% CI: 1.57-5.46)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Japanese women with ovarian infertility (most women have polycystic ovary syndrome) are at high risk of hypertension from 45 years of age, hypercholesterolemia at all ages, and diabetes mellitus (DM) before 45 years old."
          }
        ]
      },
