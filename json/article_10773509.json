      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To assess the anesthetic effects of clonidine during sevoflurane anesthesia guided by the bispectral index (BIS), which is a processed EEG variable correlated with anesthetic-hypnotic depth."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Placebo-controlled, double-blind clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTINGS",
          "content": "Elective laparoscopic surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "60 ASA physical status I patients scheduled for laparoscopic surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients received either clonidine (3 micrograms/kg, 15 min before induction) or placebo premedication for a sevoflurane-induced and sevoflurane-maintained anesthesia. Sevoflurane was titrated against a BIS held between 40 and 50. Analgesia was provided by local infiltration with bupivacaine. Need for postoperative analgesia was recorded."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RESULTS AND CONCLUSION",
          "content": "Mean sevoflurane requirements were not lower with clonidine pretreatment. There was statistically better perioperative hemodynamic stability (i.e., fewer episodes of hypertension and tachycardia) without clinical relevance. A decreased need for postoperative analgesia was observed."
        }
      ]},
