      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the relationship between peritoneal fluid concentrations of interleukin-6 (IL-6) and chronic pelvic pain symptomatology in women with adhesions, endometriosis, or no obvious intraperitoneal pathology."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Clinical research study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Healthy volunteers in an academic research environment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Reproductive-aged women undergoing laparoscopy for the diagnosis of pelvic pain, infertility, or sterilization were selected."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Peritoneal fluid was collected at the time of the laparoscopy and later assayed for IL-6. Subjects completed a pelvic pain questionnaire, and operative reports were used to obtain the underlying diagnosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Interleukin-6 concentrations."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "No correlation between the presence or absence of pelvic pain, findings of adhesions or endometriosis, and the concentration of peritoneal fluid IL-6 was observed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "The cytokine IL-6 does not seem to play a role in the genesis of chronic pelvic pain in women with adhesions or endometriosis."
        }
      ]},
