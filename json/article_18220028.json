      "Language": "rus",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To study an emotional status and quality of life (QL) in patients with coronary heart disease (CHD) and anxiety, to evaluate efficacy of anxiolytic drug lorazepam (lorafen) in such patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Anxiety in 277 CHD patients was assessed by hospital scale of anxiety and depression, depression--by Beck's questionnaire, QL--by Seattle questionnaire."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "CHD patients with clinically significant anxiety had more serious vegetative disorders, worse QL and prognosis. Lorazepam treatment improved both emotional state of the patients and QL."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "High prevalence of anxious disorders in CHD patients deteriorating QL and prognosis dictates the necessity of detecting and treating anxiety in CHD patients."
        }
      ]},
