      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the population characteristics, historical, clinical, and diagnostic findings; and treatment outcome of dogs with thoracolumbar intervertebral disk disease (IVDD) whose only clinical signs were those of back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective case series."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANIMALS",
          "content": "Dogs with IVDD and clinical signs of back pain only, without neurologic deficits, in which survey radiography of the vertebral column and diagnostic myelographic studies were performed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PROCEDURE",
          "content": "Review of the medical record, evaluation of survey radiographs of the vertebral column, evaluation of myelograms and estimation of apparent extent of spinal cord compression, and follow-up information provided by telephone contact with owners."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Spinal cord compression was detected on myelography in 20 of 25 (80%) dogs. Treatment included decompressive surgery in 18 of 25 (72%) dogs and all dogs underwent intervertebral disk fenestration. The condition was improved in 24 of 25 (96%) dogs after surgery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CLINICAL IMPLICATIONS",
          "content": "Dogs with thoracolumbar IVDD that have clinical signs of back pain alone, without neurologic deficits, may have substantial compression of the spinal cord."
        }
      ]},
