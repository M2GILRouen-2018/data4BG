      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Postoperative pain after total hip arthroplasty (THA) is not well tolerated. We assessed postoperative pain relief and the need for opioid use after using a cocktail of local and intraarticular analgesic injection (LIA) after THA."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Eighty patients undergoing THA under spinal anesthesia were randomly assigned to receive either LIA or placebo. The LIA was composed of 5 mg morphine, 30 mg bupivacaine (15 mg/1.5 mL), 1 mL betamethasone, and 0.5 mL epinephrine (1:1,000) intraoperatively. We compared three outcomes total morphine consumption, visual analog scale (VAS) at rest and during activity, and hip flexion angle while standing."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "When compared with placebo, opioid consumption was significantly reduced in the trial group, as well as VAS at rest and during mobilization. Earlier rehabilitation and better range of motion (ROM) were achieved in the trial group. There were no significant differences in side effects or postoperative wound healing between groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "In patients undergoing THA, LIA may reduce postoperative systemic opioid use and offer better pain control and earlier rehabilitation, without observable risks."
          }
        ]
      },
