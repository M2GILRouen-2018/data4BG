      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the magnitude of lipid, and lipoproteins, especially the lipoprotein(a) [Lp(a)], in controls and patients with coronary heart disease (CHD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Serum total cholesterol, triglyceride, HDL-C, LDL-C, VLDL-C, apo A1, apo B, and Lp(a) levels were determined in 37 patients with CHD and 25 age matched control subjects."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A significant difference (P < 0.001) in lipid and apolipoprotein ratios were found. Lp(a) and other lipid parameters were found significantly high (P < 0.001) with the exception of HDL-C and apo B which were significantly low (P < 0.001) in CHD patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Elevated levels of Lp(a) suggest not only its role in atherogenesis, leading to CHD, but also that Lp(a) should be given due consideration while assessing CHD risk."
        }
      ]},
