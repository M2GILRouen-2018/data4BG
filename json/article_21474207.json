      "Abstract": {
        "CopyrightInformation": "Copyright Â© 2010 Elsevier España, S.L. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the effectiveness of NT in reducing pain and minimising use of analgesics in patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Before and after intervention study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Llefià Primary Health Care centre in Badalona (Barcelona)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Eighty-two patients between the ages of 25 and 85 years old, who suffered pain that did not disappear after a month."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN MEASUREMENTS",
            "content": "Data was collected to evaluate any change in pain and the use of analgesics in patients before intervention and then afterwards, at 2 weeks, 3 months and 6 months. This was conducted by means of interviews and use of the Visual Analogue Pain Scale (VAS)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Mean VAS pre-treatment: 7.94 (SD: 1.68), mean VAS after two weeks 4.63 (SD: 2.79), after 3 months 3.73 (SD: 3.17), and after 6 months 3.48 (SD: 3,27) (P<.001 in the 3 comparisons, using the Wilcoxon-test for matched data). As regards analgesic use after treatment, 74.4% of patients reduced it after 2 weeks, 76.8% after 3 months and 80% after 6 months."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Neural therapy can be effective in reducing pain, as well as the use of analgesics. Further clinical trials would be needed to confirm this assertion."
          }
        ]
      },
