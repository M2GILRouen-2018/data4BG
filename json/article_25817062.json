      "Abstract": {
        "CopyrightInformation": "© 2015, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose was to determine the effects of the balloon inflation and cough trick methods on easing pain in children during the drawing of venous blood samples."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "In this prospective randomized controlled study, 9- to 12-year-old children in the intervention groups were asked to cough or inflate balloons during the venipuncture procedure. The Faces Pain Scale-Revised was used to assess pain intensity."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pain intensity significantly differed between the control (n = 44) and intervention groups (balloon inflation [n = 44] and cough trick [n = 44], p < .001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Coughing and inflating balloons during venipuncture do not require preparation and are time saving, easy, accessible, and effective in reducing pain."
          }
        ]
      },
