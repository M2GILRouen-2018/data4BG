      "Abstract": {
        "CopyrightInformation": "Copyright 2010 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether interleukin-8 (IL-8) serum levels are correlated with pelvic pain in patients with ovarian endometriomas."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary-care university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Interleukin-8 serum levels were prospectively analyzed in 51 patients (group A, asymptomatic patients or patients with mild dysmenorrhea; group B, severe dysmenorrhea and/or chronic pelvic pain and/or dyspareunia) who underwent surgery for cystic ovarian endometriosis to asses whether a correlation exists between IL-8 serum levels and pelvic pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Interleukin-8 serum levels determination."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Interleukin-8 serum levels and pelvic pain."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "From 56 patients, five cases were ultimately excluded because the histologic diagnosis was not cystic ovarian endometriosis (2 teratomas and 3 haemorragic cysts). The mean (+/-SD) IL-8 serum levels in group A were 6.41 +/- 12.17 pg/mL and in group B were 6.52 +/- 8.73 pg/mL."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Pain symptoms in ovarian endometriosis is not correlated with IL-8 serum levels."
          }
        ]
      },
