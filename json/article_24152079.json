      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Assess the safety and efficacy of intradiscal fibrin sealant in adults with chronic discogenic low back pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, nonrandomized Food and Drug Administration approved pilot study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Three centers in the United States."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "Fifteen adults with chronic, single, or contiguous two-level lumbar discogenic pain confirmed through meticulous provocation discography."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Volume- and pressure-controlled intradiscal delivery of BIOSTAT BIOLOGX(®) Fibrin Sealant with the Biostat(®) Delivery Device into symptomatic lumbar disc(s)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Assessments were performed at baseline, 72 hours, and 1, 4, 13, 26, 52, and 104 weeks following intervention. Potential adverse events were evaluated with serial assessment of neurological status, radiographic, and magnetic resonance imaging (MRI). Efficacy measures included serial assessments of low back pain visual analog scale (VAS) measurements and the Roland-Morris Disability Questionnaire (RMDQ)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Safety neurological assessments, X-ray, and MRI showed no significant changes. Adverse events were reported in nine subjects. Two instances of low back muscle spasm and one case of discitis were the only events considered related to the procedure or product."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "EFFICACY",
            "content": "Mean low back pain VAS scores (mm) decreased from 72.4 (95% confidence interval 64.6-80.3) at baseline to 31.7 (17.4-46.1), 35.4 (17.7-53.1), and 33.0 (16.3-49.6); mean RMDQ score improved from 15.2 (12.7-17.7) at baseline to 8.9 (5.3-12.5), 6.2 (3.4-9.1), and 5.6 (2.9-8.4) at 26, 52, and 104 weeks, respectively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Intradiscal injection of BIOSTAT BIOLOGX Fibrin Sealant with the Biostat Delivery Device appears safe and may improve pain and function in selected patients with discogenic pain."
          }
        ]
      },
