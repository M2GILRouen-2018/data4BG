      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Prader-Willi syndrome (PWS) is a genetic disorder causing multisystem abnormalities with obesity. Obesity is a well established cause of Blount disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A 7-year-old girl with PWS presented with genu varum of the left knee with deformity of the proximal medial tibial condyle, which was consistent with Blount disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A lateral physeal stapling and subsequent osteotomy for the left proximal tibia and fibula were performed with improved anatomical alignment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Blount disease has not been reported in the literature in association with PWS despite excessive obesity."
        }
      ]},
