      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To report our experience in early surgery of penile fractures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We review retrospectively all the cases that underwent surgery at our center from 1989 to 2009, with a total of 24."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The cause of the fracture was sexual intercourse in most cases, and in all of them, surgical management was performed according to clinical presentation and physical exploration. In only 7 cases an ultrasound was performed as a complementary test."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Early surgery allows prompt resolution of the problem with excellent functional outcomes and little side effects."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The prognosis after emergency surgery was excellent in this review."
        }
      ]},
