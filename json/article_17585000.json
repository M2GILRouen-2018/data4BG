      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The purpose of this study is to report a case of choroidal neovascular membrane (CNVM) in a patient of juvenile idiopathic arthritis (JIA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "The design of this study is an interventional case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A 6-year-old boy, a known patient of JIA, presented with a complaint of redness and ocular pain with mild diminution of vision in his left eye. Fundus examination revealed a CNVM with retinal thickening and subretinal fluid which was confirmed on OCT. Treatment with intravitreal injection of anti-VEGF (ranibizumab) and oral immunosuppressive showed resolution of the CNVM."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The result of this study is a successful treatment of CNVM with a single anti-VEGF injection and systemic immunosuppression."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Although a rare complication, CNVM can occur in patients with JIA."
        }
      ]},
