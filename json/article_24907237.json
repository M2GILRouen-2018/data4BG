      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2014 Reprints and permissions: sagepub.co.uk/journalsPermissions.nav.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study measured factors that could be associated with self-management practices of people with type 2 diabetes from two different health systems in the Philippines in terms of diabetes knowledge, attitudes, perceptions of support and self-efficacy, and obesity/adiposity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Knowledge, attitudes, perceptions, obesity/adiposity measures, adherence to medications, diabetes diet, and exercise and the number of diabetes consultations of people with type 2 diabetes utilizing services of two different health systems were collected. Analysis of variance was used to determine differences in knowledge, attitudes, perceptions, obesity/adiposity, and demographic characteristics according to: proper/under-utilization of services; adherence/non-adherence to medications, diet and exercise; high/low perceived self-efficacy; and the health systems. Logistic regression was done to identify any associations with obesity/adiposity, self-management practices, and perceived self-efficacy."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There were 549 respondents. Differences in knowledge, attitudes, perceptions, and some demographic characteristics between the two health systems and between those with high/low self-efficacy perceptions were significant. Perceived self-efficacy was significantly associated with all four self-management practices."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS/INTERPRETATIONS",
            "content": "People consulting at the health service with a more supportive system had better perceived self-efficacy and self-care behavior. Higher knowledge, attitude, and perception scores were noted among those with better self-efficacy perceptions, which was associated with better self-care behavior."
          }
        ]
      },
