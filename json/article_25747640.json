      "Abstract": {
        "CopyrightInformation": "Reprint & Copyright © 2015 Association of Military Surgeons of the U.S.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This article addresses the design of a robust autopilot for the delivery of intravenous anesthesia drugs."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A mathematical framework that expresses the pharmacological variability of a patient population into uncertainty bounds is proposed. These bounds can be effectively used to tune the parameters of a controller to ensure its stability, a key design aspect related to the safety of the overall system."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The proposed method is applied to the control of propofol, a powerful hypnotic agent used for sedation and anesthesia. Simulations show that the controller remains stable for all patients considered and that performance are clinically acceptable."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This methodology can be an important step forward in the design and regulatory approval of such systems."
          }
        ]
      },
