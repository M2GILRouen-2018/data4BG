      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To compare the efficacy and safety of BiClamp forceps tonsillectomy (BT) with standard electrocautery tonsillectomy (ET) in terms of postoperative pain and complication rates."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Prospective randomized study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS AND METHODS",
          "content": "The following variables were examined: postoperative complications, intraoperative blood loss, operating time, postoperative pain and diet scores using visual analog scales, and time until return to normal activity."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The mean operating time and the grade of intraoperative blood loss were significantly lower in the BT group than in the ET group for both pediatric and adult patients. For adult patients, the overall complication rates were significantly lower in the BT group. In addition, a significant early decrease in the pain score and significant improvement in dietary intake until postoperative day 14 were observed in the BT group for both pediatric and adult patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The use of BiClamp forceps in tonsillectomy reduces the intraoperative blood loss and postoperative pain score, and facilitates an early return to normal diet and activity."
        }
      ]},
