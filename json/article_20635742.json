      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "We report an unusual case of previously healthy post partum woman who had presented with congestive cardiac failure. She had no significant past history."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "She underwent cardiac evaluation. Echo showed severe left ventricular dysfunction and multiple mobile masses in the left ventricle. Cardiac MRI was done to assess the intracardiac mass."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "Cardiac MRI helped in differentiating clot from intra cardiac tumor. She was effectively treated with anticoagulants."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Cardiac MRI is a useful investigative modality to differentiate intracardiac tumor and clot and helps in guiding the management."
        }
      ]},
