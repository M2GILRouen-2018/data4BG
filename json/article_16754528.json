      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine parents' awareness of and compliance with air pollution advisories, and to compare the awareness and compliance of parents' of asthmatics to that of other parents."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Responses of 240 parents surveyed at pediatric clinic visits were compared."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 88% of parents were aware of air pollution advisories; 71% reduced pollution and 55% restricted children's play \"sometimes\" because of advisories. However, only 7% complied with more than one third of the advisories issued. More parents of asthmatics reported awareness of alerts (p = 0.002), reducing pollution (p = 0.005), or restricting play \"sometimes\" in response to advisories (p = 0.007)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Most parents report awareness of and some compliance with air pollution advisories. Parents of asthmatics are more aware and somewhat more compliant than other parents."
        }
      ]},
