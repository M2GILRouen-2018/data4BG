      "Abstract": {
        "CopyrightInformation": "© 2011 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To assess the effect of peripheral nerve stimulation on neuropathic testicular pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "A 30-year-old man with a four-year history of chronic testicular pain following scrotal hydrocele surgery had two percutaneous leads implanted in his groin and low-frequency stimulation of the cutaneous branch of the ilioinguinal and genital branch of the genitofemoral nerves."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT",
            "content": "At seven-month follow-up, the pain intensity had declined from 9/10 to 2/10 on the numeric rating scale."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "We report the successful implantation of an ilioinguinal and genitofemoral nerve stimulator for sustained suppression of intractable neuropathic testicular pain."
          }
        ]
      },
