      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "In approximately 80-85% of patients with chronic nonspecific low back pain (NSLBP), a precise pathoanatomical diagnosis cannot be identified. Mechanisms of bone nociception may contribute to NSLBP."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether findings on bone scans, which provide a pathophysiological picture of functional activity, are associated with self-reports of NSLBP intensity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A cross-sectional study of the relationship of self-reported chronic NSLBP intensity to the uptake of radiolabeled technetium-99m-methylene diphosphonate in the lumbosacral area."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY PARTICIPANTS",
          "content": "Patients referred for bone scans who were at least 18 years old."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Subject reports of pain intensity and intensity of uptake of radiolabeled technetium-99m-methylene diphosphonate in the lumbosacral area."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Among subjects who were 65 years or younger, the age-adjusted worst pain intensity accounted for 45% of the variability in the amount of tracer uptake (r = 0.67, P = 0.0006). The association was not significant for those older than 65 years."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Further studies should be conducted on possible mechanisms relating bone nociception to chronic NSLBP in individuals who are 65 years or younger."
        }
      ]},
