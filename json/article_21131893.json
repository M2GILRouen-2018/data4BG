      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Intracardiac thrombosis is a life-threatening complication of extreme prematurity. We describe the use of tissue plasminogen activator to treat intracardiac thrombosis in extremely low-birth-weight preterm infants."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case series, literature review, and practice guideline for recombinant tissue plasminogen activator treatment of intracardiac thrombosis in extremely low-birth-weight preterm infants."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Neonatal intensive care."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Four extremely low-birth-weight preterm infants coincidentally diagnosed with intracardiac thrombosis during neonatal intensive care."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Recombinant tissue plasminogen activator in a starting dose of 20 μg/kg/hr, increasing to 200-400 μg/kg/hr, infused for 2-6 days."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Thrombolytic therapy with recombinant tissue plasminogen activator helped achieve rapid clot resolution in all infants and none had any major hemorrhagic complication associated with treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Tissue plasminogen activator may safely be used to treat intracardiac thrombosis in extremely low-birth-weight preterm infants. Close monitoring of therapy is imperative. Further data are required to confirm the safety of tissue plasminogen activator in preterm infants."
        }
      ]},
