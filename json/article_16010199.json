      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We sought to study respiratory symptoms among automobile assembly workers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In a cross-sectional study, we compared rates of respiratory symptoms and of physician-diagnosed asthma and COPD in painters and welders to those in assembly workers."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Respiratory symptom reporting was significantly increased among welders (odds ratio [OR] = 1.79-2.61) compared with painters or assembly workers, after age, race, and smoking adjustment in multiple logistic regression analyses. Welders also reported significantly more improvement in symptoms on weekends or vacation. However, no significant elevations in adjusted ORs were observed for physician-diagnosed asthma or chronic obstructive pulmonary disease for welders. In contrast, significantly more painters had physician-diagnosed chronic obstructive pulmonary disease (OR = 3.73, 95% confidence interval = 1.27, 11.0)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Welders and painters in this plant appeared to have increased risk of respiratory health effects compared with assembly workers."
        }
      ]},
