            "NlmCategory": "UNASSIGNED",
            "Label": "CLINICAL HISTORY PATIENT",
            "content": "37-year-old man of half African and half Italian ethnicity."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "CHIEF COMPLAINT",
            "content": "Sickle cell crisis (SCC)."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "HISTORY OF PRESENT ILLNESS",
            "content": "The patient had severe pain in his lower back that radiated to both thighs. He had been admitted twice in the previous 2 weeks at another hospital due to SCC. Each time, he had been discharged with a prescription for oxycodone. His condition did not respond to the pain medicine; his pain remained uncontrollable."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEDICAL HISTORY",
            "content": "The patient has had multiple sickle cell crises since childhood and is a former smoker. He denied alcohol consumption or illegal drug use."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "PHYSICAL EXAMINATION FINDINGS",
            "content": "The patient had normal vital signs. No splenomegaly was present."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "FAMILY HISTORY",
            "content": "Both parents carry sickle cell thalassemia."
          },
          {
            "NlmCategory": "UNASSIGNED",
