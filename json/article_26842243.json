      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 by the Research Society on Alcoholism.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Alcoholic hepatitis (AH) is an inflammatory disorder of the liver characterized clinically by jaundice, hepatomegaly, and abdominal pain, and histologically by macrovesicular steatosis and necroinflammation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This clinical review will cover what is known about the pathogenesis, clinical presentation, current treatments, and novel therapies for AH."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The pathogenesis and treatment of AH remain areas of active research. Although abstinence is the cornerstone of therapy for all stages of alcoholic liver disease, corticosteroids have shown modest short-term benefits in treatment of severe AH."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Improved understanding of the pathogenesis of AH has expanded the range of potential treatments for this devastating disease. Several novel therapies are also currently in various stages of testing through clinical trials."
          }
        ]
      },
