      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American College of Allergy, Asthma & Immunology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Allergic rhinitis (AR) is an inflammatory condition of the nasal mucosa characterized by symptoms of nasal discharge, itching, sneezing, and congestion. Ocular symptoms are commonly associated with AR and include itching or burning, tearing or watering, and redness. Intranasal corticosteroids are a mainstay of treatment, and their effect on nasal symptoms is well described."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To demonstrate that a 14-day course of 200 μg/d of nasal fluticasone propionate is superior to placebo in relieving ocular symptoms associated with AR."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This was a randomized, double-blind, parallel group, multicenter study comparing 200 μg/d of fluticasone propionate with placebo in patients with seasonal allergic rhinitis. The primary end point was mean change from baseline in patient-rated reflective total ocular symptom score (rTOSS). Key secondary end points included mean change from baseline in the morning and evening rTOSS, end-of-treatment assessment of response, and effect on activities of daily living. The primary analysis was performed using analysis of covariance with a linear fixed-effects model."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Fluticasone was statistically significantly more efficacious in reducing the ocular symptoms of AR than placebo. The least squares mean difference in the change from baseline of rTOSS was -0.36 (P = .002). A statistically significant difference in mean change from baseline was observed in favor of fluticasone for morning and evening rTOSS. Significantly more patients taking fluticasone achieved an overall response compared with placebo. Fluticasone had a significantly greater effect on daily living activities and was well tolerated."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This study supports the efficacy of fluticasone in treating ocular symptoms associated with AR."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "TRIAL REGISTRATION",
            "content": "clinicaltrials.gov Identifier: NCT01817790."
          }
        ]
      },
