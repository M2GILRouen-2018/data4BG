      "Abstract": {
        "CopyrightInformation": "Copyright © 2016. Published by Elsevier Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Blunt abdominal trauma is the most common cause of splenic rupture. Malaria is the most frequent tropical infectious cause of spontaneous splenic rupture. The exact mechanism is not well-defined."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "We report a case of thirty-year-old male patient known to have malaria who presented with spontaneous splenic rupture. A trial of conservative treatment failed and splenecomy was done to control bleeding."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Spontaneous splenic rupture should be kept in mind in malaria patients presenting with left upper quadrant pain and signs of hypovolemia. Early diagnosis and treatment is essential."
          }
        ]
      },
