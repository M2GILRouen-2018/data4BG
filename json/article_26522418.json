      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "In recent years there have been few reports on the effects of immunotherapy on bronchial asthma (BA) and allergic rhinitis (AR) in Japanese children."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the safety and efficacy of house dust extract immunotherapy for one year."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Thirty-five children with AR and BA were subjected to rush immunotherapy with house dust extract. Systemic reactions were counted to evaluate safety. BA medication score and AR symptom-medication score were recorded."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Three patients (8.3% of all patients) experienced 6 systemic reactions (0.15% of doses). BA medication score decreased from 567 to 325 (a reduction rate of 43%). AR symptom-medication score improved from 5.1 to 2.9 (a reduction rate of 43%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Rush immunotherapy with house dust extract is safe and effective for Japanese children."
        }
      ]},
