      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate whether asymptomatic endometriosis diagnosed in connection with tubal sterilization is likely to cause symptoms later in the woman's life."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Controlled, clinical follow-up study of women who were examined for endometriosis in connection with tubal sterilization performed between 1986 and 1989."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Thirty-nine women with mostly minimal endometriosis discovered at sterilization and 157 control women with no endometriosis discovered at sterilization."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Interview in 2001 by a posted questionnaire."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Report on pain, pelvic operations, menopausal status, and use of hormone replacement therapy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Pelvic pain was more frequently reported by controls than by women with endometriosis (28% vs. 6%). There was no significant difference between the groups concerning dysmenorrhea, premenstrual pain, or dyspareunia, nor was there any significant difference in the hysterectomy rate."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "There is little risk that asymptomatic, minimal endometriosis found incidentally will become symptomatic."
        }
      ]},
