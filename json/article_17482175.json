      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To present a case of a patient with a duplicated left ureter presenting preoperatively as unilateral hydrosalpinx, chronic pelvic pain, and recurrent urinary tract infections (UTIs)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A large university-affiliated infertility center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 37-year-old woman, para 1, with an 18-year history of recurrent UTIs associated with coitus, and chronic pelvic pain with a unilateral hydrosalpinx."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Resolution of recurrent UTIs and left flank pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "The patient has remained symptom free after laparoscopic resection of the duplicated ureter and portion of the bladder at its point of insertion."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "We show a rare case of a duplicated left ureter presenting as chronic pelvic pain and recurrent UTIs, demonstrating the importance of a thorough chronic pelvic pain workup."
        }
      ]},
