        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To discuss interprofessional collaboration between the primary oncology clinicians and specialists in the management of immune-related ocular toxicities."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "Peer-reviewed articles, case reports and systematic reviews."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Accurate ophthalmologic assessment is critical for the prevention and treatment of ocular toxicities associated with immunotherapy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR NURSING PRACTICE",
            "content": "Oncology nurses play a key role in early identification and management of ocular symptoms from immunotherapy; early referral to ophthalmic specialists can enhance recovery and preserve sight."
          }
        ]
      },
