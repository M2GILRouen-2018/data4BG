        {
          "NlmCategory": "OBJECTIVE",
          "Label": "CLINICAL QUESTION",
          "content": "Is oxycodone associated with greater efficacy and fewer adverse events compared with alternative analgesics for cancer pain?"
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "BOTTOM LINE",
          "content": "Oxycodone was not associated with superior cancer pain relief or fewer adverse effects compared with other strong opioids, such as morphine or oxymorphone. However, the quality of the evidence was low."
        }
      ]},
