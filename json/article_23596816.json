      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To ascertain if it is effective to use extradural injections and manual repositioning of the spine to treat megalgia caused by cervical spondylotic radiculopathy (CSR)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Patients with megalgia caused by CSR were divided into a treatment group (n = 46) treated by extradural injection and manual repositioning of the spine and a control group (n = 46) treated by a conventional method."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The prevalence of cure was 58.69% and the total prevalence of effective cure in the treatment group was 97.83% and was 23.91% and 78.26%, respectively, in the control group: this difference between the two groups was significant (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Treatment of megalgia caused by CSR by extradural injections and manual repositioning of the spine has a good curative effect with rapid analgesia and short therapeutic course."
        }
      ]},
