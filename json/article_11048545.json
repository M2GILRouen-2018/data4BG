      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To evaluate the efficacy of foraminal steroid injections performed under CT guidance for the management of radicular pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Periganglionic infiltrations were performed in 160 patients with radicular pain refractory to medical treatment. Imaging showed either degenerative foraminal stenosis, herniated disk or postsurgical fibrosis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "102 patients (63.8%) had significant pain reduction. Pain relief was lasting in 68 (66.6%). CT showed the position of the needle tip, as well as the diffusion of the therapeutic compounds."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "We consider that CT-guided periganglionic steroid injections should be an integral part of the management strategy for radicular pain resistant to medical treatment."
        }
      ]},
