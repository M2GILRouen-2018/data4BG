      "Language": "rus",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Investigation of serum levels and clinical role of soluble intercellular molecules of adhesion (pICAM-1, PICAM-3 and pP-selectin) in rheumatoid arthritis (RA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Enzyme immunoassay with Bender MedSystem kits (Austria) was employed to measure serum concentration of soluble intercellular molecules of adhesion in 36 RA patients."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Elevated levels of serum pICAM-1, pICAM-3 and pP-selectin were registered in 74.2, 28.6 and 25.7% of RA patients, respectively. Content of pP-selectin more strongly correlated with activity and severity indices than that of pICAM-3 (p < 0.001). Content of pICAM-1 and clinical picture of RA were unrelated."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Levels of pP-selectine can characterize RA activity."
        }
      ]},
