      "Abstract": {
        "CopyrightInformation": "Copyright 2009 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Helper T (Th) cells are deeply involved in the pathophysiology of bronchial asthma, such as eosinophilic inflammation, bronchial hyperresponsiveness and remodeling. However, it is still unclear how Th cells contribute to airflow limitation, another cardinal feature of bronchial asthma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Unprimed BALB/c mice were transferred with ovalbumin (OVA)-reactive Th clones. Pulmonary function was monitored using a Buxco BioSystem Plethysmograph before and after OVA challenge."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "When Th-transferred mice were challenged with OVA, enhanced pause (P(enh)), an indicator of airflow limitation was significantly increased 6 and 24 h after challenge, while no response was observed 30 min after challenge. Neither bovine serum albumin, an irrelevant antigen, challenge on Th-transferred mice nor OVA challenge on Th-non-transferred mice caused airway responses."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Th cells conferred antigen-induced airflow limitation to unprimed mice."
          }
        ]
      },
