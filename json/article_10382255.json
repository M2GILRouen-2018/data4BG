      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "Successful excision of the mass and identification of the causative agent by histologic and microbiologic studies."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Spinal pain, caused by an infective mass, developed in a 39-year-old man 3 months after an epidural injection for low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Exploratory surgery was performed to remove the mass, and histologic and microbiologic studies were conducted."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The inflammatory mass was excised successfully, and several specimens were examined for bacteriologic presence. Histologic examination of the excised specimen showed chronic granulomatous inflammation, and subsequent microbiologic studies cultured an acid- and alcohol-fast bacillus that was later identified as Mycobacterium fortuitum."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A review of the literature shows that this is a particularly uncommon micro-organism."
        }
      ]},
