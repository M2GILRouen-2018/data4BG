      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Little information exists on the acute effects of elective surgery on renal function. Our aim was to determine if obesity was an independent risk factor for postoperative renal complications (RCs)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A total of 119,142 patients aged 18 to 35 years with body mass index (BMI) ≥18 kg/m(2) obtained from American College of Surgeons National Surgical Quality Improvement Project (2005 to 2010) were classified into standard BMI categories. Association between BMI and preoperative estimated glomerular filtration rate (eGFR; calculated using modification of diet in renal disease formula) was analyzed. Postoperative changes in eGFR and RCs were measured. Multivariate regression analysis was performed adjusting for all variables."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Postoperatively, there was a reduction in eGFR among the overweight (-3.4 mL/min/1.73 m(2), P < .001), obese class I (-3.9 mL/min/1.73 m(2), P = .001), and obese class II (-5.3 mL/min/1.73 m(2), P < .001). The odds of any postoperative RC was significantly higher in obese class III patients (odds ratio = 2.01 95% confidence interval 1.07 to 3.76, P = .029)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Results seen in patients with BMI greater than 40 indicate that BMI can serve as an independent predictor of RCs."
          }
        ]
      },
