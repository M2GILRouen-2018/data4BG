        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A 60-year-old man with relapsing unstable angina a year aftger an anterior acute myocardial infarction treated with PCI to proximal left anterior descending (LAD) and proximal intermediate branch (IB), resulting in a severely impaired LV function."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INVESTIGATION",
          "content": "Physical examination, laboratorytest, transthoracic echocardiogram, rest ECG, coronary angiography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DIAGNOSIS",
          "content": "Severe in-stent restenosis to IB, with a bulky plaque involving distal left main, obtuse marginal and proximal circumflex."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MANAGEMENT",
          "content": "Percutaneous coronary intervention/coronary artery bypass grafting."
        }
      ]},
