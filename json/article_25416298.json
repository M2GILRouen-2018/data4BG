        "AbstractText": [
          {
            "Label": "UNLABELLED",
            "content": "Synovial chondromatosis is a rare pathology in the foot and ankle region. We present a case of concomitant tenosynovial chondromatosis of the extensor digitorum longus tendon and synovial chondromatosis of the ankle, which was successfully treated by extensor digitorum tendon tendoscopy and ankle arthroscopy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVELS OF EVIDENCE",
            "content": "Therapeutic, Level IV: Case study."
          }
        ]
