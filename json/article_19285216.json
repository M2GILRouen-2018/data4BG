      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To measure the concordance of directly and indirectly measured neighborhood attributes and to determine the correlates of the concordance between directly and indirectly measured built environment attributes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Environmental cross-sectional design."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Urban and suburban neighborhoods within Harris County, Houston, and Travis County, Austin, Texas."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Community-dwelling African-American and Hispanic or Latina women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASURES",
          "content": "Physical activity resource accessibility, path maintenance, and pedestrian and bicycle facilities were measured directly and indirectly. Directly or objectively measured neighborhood attributes were measured by the Physical Activity Resource Assessment and Pedestrian Environmental Data Scan instruments. Indirectly measured or self-reported neighborhood attributes were measured by the International Physical Activity Prevalence Study environmental survey module."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANALYSIS",
          "content": "Logistic regression was used to measure the concordance between directly and indirectly measured neighborhood attributes with ethnicity as a covariate. Residual values were calculated to determine the strength and direction of concordance."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Participants' (N \u200a=\u200a 409) average body mass index (BMI) was classified as obese (MBMI \u200a=\u200a 34.5 kg/m(2), SD \u200a=\u200a 7.9), and the mean body fat percentage was 42.8% (SD \u200a=\u200a 7.1). The correlates BMI, body fat percentage, physical activity, and ethnicity were not significantly associated with any built environment attribute or concordance value, and none of our models significantly predicted indirectly measured built environment attributes."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Being less familiar with certain built environment attributes may not be associated with weight status or physical activity levels among African-American and Hispanic or Latina women."
        }
      ]},
