      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the efficacy of a nonsteroidal anti-inflammatory drug vs. paracetamol in pain relief during medical abortion and to evaluate whether nonsteroidal anti-inflammatory drugs interfere with the action of misoprostol."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective double-blind controlled study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University-affiliated tertiary hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "One hundred twenty women who underwent first-trimester termination of pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Patients received 600 mg mifepristone orally, followed by 400 microg of oral misoprostol 2 days later. They were randomized to receive ibuprofen or paracetamol when pain relief was necessary. Patients completed a questionnaire about side effects and pain score and returned for an ultrasound follow-up examination 10-14 days after medical abortion."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Success rates, as defined by no surgical intervention, and pain scores were assessed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Ibuprofen was found to be statistically significantly more effective for pain relief after medical abortion compared with paracetamol. There was no difference in the failure rate of medical abortion, and the frequency of surgical intervention was slightly higher in the group that received paracetamol (16.3% vs. 8.5%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Ibuprofen was found to be more effective than paracetamol for pain reduction during medical abortion. A history of surgical or medical abortion was predictive for high pain scores. Despite its anti-prostaglandin effects, ibuprofen use did not interfere with the action of misoprostol."
        }
      ]},
