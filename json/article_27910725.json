      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Back pain, the most prevalent musculoskeletal chronic pain condition, is usually treated with analgesic medications of questionable efficacy and frequent occurrence of adverse side effects."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The objective was to determine the effectiveness of the ActiPatch medical devices in reducing chronic back pain, document medication related adverse side effects and establish their impact on quality of life."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Upon completing a 7-day trial, subjects were contacted via email with an assessment form using the Constant Contact email program. A total of 1394 responses were collected from subjects who used the device for back pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Medication adverse effects are common and impact quality of life in the lay population. ActiPatch is an effective intervention for the majority of subjects for treating chronic back pain, although this requires further investigation in randomized clinical trials."
        }
      ]},
