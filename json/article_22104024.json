      "Abstract": {
        "CopyrightInformation": "© 2011 John Wiley & Sons A/S.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Asthma is associated with food allergies in a significant number of children, with evidence linking allergies to asthma severity and morbidity. In this study, we tested our hypothesis that the eosinophilic lower airway inflammation is higher in asthmatic children with food allergies."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS",
            "content": "The aims of the study were to compare the eosinophilic inflammatory markers in asthmatic children with and without food allergies."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "Children with asthma, with (n = 22) and (n = 53) without food allergies were included. All subjects were classified according to the GINA guidelines (2009) and had received at least 3 months of anti-inflammatory therapy prior to testing. Fractional exhaled nitric oxide and sputum differential counts were performed using standard techniques."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Children with asthma and food allergies had significantly higher fractional exhaled nitric oxide median (range) [(22.4 (6.1-86.9) vs. 10.3 (2.7-38.7) (p = 0.01)] and sputum eosinophil percentage [15.5 (5.0-53.0) vs. 2.0 (0-20) (p < 0.001)] compared with asthmatic children without allergies."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These results suggest that the children with asthma and food allergies have increased eosinophilic inflammation of the airways."
          }
        ]
      },
