      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© 2015, Copyright the Authors Journal compilation © 2015, The American Geriatrics Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To study the interaction between and timing effects of depression and vascular disorders on dementia risk."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective cohort study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Primary care practices in the south of the Netherlands."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Individuals in primary care aged 50 to 100 followed for 13 years (N = 35,791)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Medical diagnoses of incident depression, hypertension, obesity, type 2 diabetes mellitus, stroke, and dementia were extracted from a research database. Cox proportional hazards regression was used to test whether incident depression predicted dementia and its putative interactions with vascular factors."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In total, 1,680 participants developed dementia. Individuals with depression (n = 978) had a higher risk of dementia (adjusted hazard ratio (HR) = 2.03, 95% confidence interval (CI) = 1.56-2.64). Depression exerted most effect in participants with incident stroke (HR = 5.29, 95% CI = 2.52-11.14) or newly diagnosed hypertension (HR = 3.09, 95% CI = 1.54-6.20)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Depression in later life increases the risk of dementia. The effect is particularly high in individuals with depression and vascular disorders. Targeting late-onset depression in individuals with vascular disorders might lower dementia risk by preventing cerebrovascular changes."
          }
        ]
      },
