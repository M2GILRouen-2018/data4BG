      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Posttraumatic stress disorder (PTSD) may appear after hospitalisation for surgery with general anaesthesia in elderly patients. Prevalence and risk factors in this setting are unknown. Postoperative delirium could be a risk factor."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of this study was to identify the prevalence of, and risk factors for, PTSD 3 months after surgery with general anaesthesia in elderly patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective, clinical observational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "This study was carried out between March 2009 and May 2010 in a German university hospital in Berlin and was part of a larger study focusing on depth of anaesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INCLUSION CRITERIA",
          "content": "at least 60 years of age; noncardiac surgery with general anaesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "EXCLUSION CRITERIA",
          "content": "impaired preoperative cognitive function [mini-mental state examination (MMSE) score <24]; expected surgery time less than 1\u200ah; nonproficiency in the German language."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "None."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Screening for PTSD 3 months after surgery using the screening instrument Post-Traumatic Stress Syndrome 14-Questions Inventory Score (PTSS-14). The following risk factors for PTSD 3 months after surgery were tested: age; American Society of Anesthesiologists physical status; sex; duration of anaesthesia; postoperative delirium; PTSS-14 score 7 days after surgery; postoperative vomiting and nausea; postoperative pain; and preoperative depression."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STATISTICS",
          "content": "Univariate statistical analysis was performed with Fisher's exact test and Spearman correlation. A backward logistic regression was performed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 559 out of 1277 patients were included. Sixty-six patients (12%) were identified with PTSD 3 months after surgery. Seventy-seven patients (14%) were identified with postoperative delirium. Independent associated factors in the backward logistic regression were postoperative delirium (risk factor) and preoperative depression (protective factor)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The prevalence of PTSD 3 months after surgery in elderly patients was high using the screening instrument PTSS-14. Postoperative delirium is a risk factor for PTSD 3 months after surgery."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "TRIAL REGISTRATION",
          "content": "ISRCTN Register: 36437985. http://www.controlled-trials.com/ISRCTN36437985/"
        }
      ]},
