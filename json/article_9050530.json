      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To examine the efficacy and safety of laparoscopic presacral neurectomy (LPSN) as the initial surgical treatment of midline pelvic pain and dysmenorrhea; and to evaluate its effectiveness in conjunction with procedures to relieve lateral pelvic pain, such as excision of endometriosis and lysis of adhesions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A preoperative and postoperative self-rating with which patients classified pain on an ordinal scale of 0 to 5. A x<SUP>2<SUP> analysis of the data was performed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A private hospital in Savannah, Georgia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Twenty-seven women, age 15 to 41 years, who experienced severe midline dysmenorrhea and/or pain; 12 also had significant lateral pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Laparoscopic presacral neurectomy was the primary intervention. Other procedures, including lysis of adhesions, excision and vaporization of endometriosis, and appendectomy were completed as adjuncts to LPSN."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Ratings were completed by patients 5 to 35 months after surgery. Twenty-two women reported no midline pain, three had significant reduction of pain, and two had persistence of severe pain. Two of the 12 women with lateral pain reported that pain persisted."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The LPSN is safe and effective as an initial surgical intervention for treating midline dysmenorrhea and pelvic pain, and when it is performed by experienced laparoscopic surgeons with adequate training."
        }
      ]},
