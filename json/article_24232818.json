      "Language": "por",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effect of 12 weeks of physical exercise (PE) on cardiovascular risk factors and BChE activity in obese adolescents."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS AND METHODS",
          "content": "The sample consisted of 24 obese adolescents and 51 normal weight controls. The following variables were measured in the initial stage and after 12 weeks: weight, height, BMI, waist circumference (WC), fat percentage (% F), maximal oxygen uptake (VO2max), systolic (SBP) and diastolic (DBP) blood pressure, glucose (GLY) and insulin (INS) at baseline and after 120 min, triacylglycerol (TG), total cholesterol (TC), LDL cholesterol, HDL cholesterol, and BChE activity (kU/l)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After the intervention, there was significant reduction in BMI, WC, %F, TG, GLI 120, INS 120 min, and BChE activity."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The reduction in BChE activity, observed after physical exercise, was accompanied by the reduction of the variables associated with cardiovascular risk and obesity, indicating that BChE can be used as a secondary marker for the risk associated with early onset obesity."
        }
      ]},
