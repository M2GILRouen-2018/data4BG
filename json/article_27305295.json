      "Abstract": {
        "CopyrightInformation": "© Georg Thieme Verlag KG Stuttgart · New York.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "HISTORY",
            "content": "A 36-year-old man with a history of PR3-ANCA positive granulomatosis with polyangiitis presented with chest pain at the emergency department. Due to his underlying disease, he was treated with Rituximab in regular intervals. The last Rituximab infusion was admitted one day before presentation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INVESTIGATION",
            "content": "The ECG showed marked ST elevation in V1-V4."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DIAGNOSIS, TREATMENT AND COURSE",
            "content": "After the diagnosis of an acute anterior myocardial infarction, the patient was prepared for acute percutaneous coronary intervention. During transport to the cardiac catheterization laboratory, he suffered a cardiac arrest due to ventricular fibrillation. After successful resuscitation, the cardiac catheterization showed no evidence of relevant coronary stenosis. Because of suspected coronary spasm of left anterior descending artery the therapy was extended with a calcium channel blocker. A single chamber cardiac defibrillator was implanted for secondary prevention."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Acute coronary syndrome is a possible side effect of rituximab therapy. The reported case emphasizes a correlation between Rituximab therapy and cardiac event."
          }
        ]
      },
