      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To review postoperative symptoms experienced by patients following surgery for cancer and discuss focused, evidenced-based methods to teach the patient acute pain and symptom management to include both pharmacological and non-pharmacological strategies."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "Peer reviewed articles and national guidelines."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Although significant advances have been made in providing effective acute pain control, pain remains a serious consequence after cancer surgery. Most patients go home after surgery (often the day of their surgery) not taking their pain medications or with inadequate pain medication. Postoperative symptoms such as nausea, constipation, and fatigue, and complications such as blood clots and infection, may present barriers to post-surgical recovery that can affect initiation of adjuvant therapy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR NURSING PRACTICE",
            "content": "Nurses who are equipped with successful strategies to support self-management of postoperative symptoms will ensure that patients have a positive surgical experience."
          }
        ]
      },
