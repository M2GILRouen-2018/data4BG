      "Abstract": {
        "CopyrightInformation": "© The Author 2015. Published by Oxford University Press on behalf of the Society of Pediatric Psychology. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare rates of alcohol and tobacco use in youth with and without chronic pain and to identify risk factors for use."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Participants included 186 youth (95 mixed chronic pain; 91 without chronic pain; 12-18 years old) who reported current alcohol and tobacco use, pain intensity, activity limitations, loneliness, and depressive symptoms."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Adolescents with chronic pain were less likely to use alcohol compared with adolescents without chronic pain (7.4% vs. 22%), and as likely to use tobacco (9% vs. 8%). Across groups, youth with higher depressive symptoms, less loneliness, and fewer activity limitations were more likely to endorse alcohol and tobacco use. Exploratory analyses revealed that risk factors for substance use differed among youth with and without chronic pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Chronic pain may not increase risk for tobacco and alcohol use in adolescents. Research is needed to understand use of other substances in this medically vulnerable population."
          }
        ]
      },
