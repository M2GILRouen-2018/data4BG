      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate whether randomized diet and/or physical exercise influence serum levels of antimüllerian hormone (AMH) in obese women with polycystic ovary syndrome (PCOS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized, 4-month trial with three interventions."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Women's health clinical research unit at a university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Fifty-seven overweight/obese women with PCOS."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Diet, physical exercise, or both, using programs individually adapted and supervised by a dietician and/or a physiotherapist."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Serum AMH levels before and after the interventions and correlations to reproductive function, body composition, and endocrine and metabolic variables."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "After intervention, serum levels of AMH were significantly decreased only in the diet group, and the levels were significantly lower than in the exercise group. The strongest predictor of decreased AMH was a decrease in free T, whereas weight loss had no significant influence. Normalized levels of AMH were associated with improvements in menstrual cyclicity and hyperandrogenism but not in metabolic variables."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "This randomized study supports that diet reduces serum AMH in association with decreased androgen levels in obese women with PCOS. Increased serum AMH may be used as a marker of ovulatory dysfunction and hyperandrogenism but not as a marker of insulin resistance."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CLINICAL TRIAL REGISTRY NUMBER",
            "content": "ISRCTN48342048."
          }
        ]
      },
