      "Abstract": {
        "CopyrightInformation": "© 2014 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND AIMS",
            "content": "Abdominal rectus sheath hematoma (ARSH) is a rare clinical condition that can be confused with other causes of acute abdomen."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We report an 83-year-old woman receiving antiplatelet medication who presented with ARSH following a cough episode."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The patient was hospitalized with a diagnosis of acute chronic obstructive pulmonary disease exacerbations. During hospital stay, sudden onset abdominal pain was developed following a severe cough episode. Computed tomography of the abdomen revealed ARSH."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Rectus sheath hematoma is a rare and often misdiagnosed clinical condition. It is important to be considered for the diagnosis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "ARSH should be considered in case of development of acute abdominal pain following cough in receiving anticoagulant or antiplatelet therapy."
          }
        ]
      },
