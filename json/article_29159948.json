      "Abstract": {
        "CopyrightInformation": "© 2017 Royal Pharmaceutical Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To identify prescribing patterns of antiulcer agents in patients on low-dose aspirin (LDA) and to evaluate the number of gastrointestinal (GI) risk factors of the patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A retrospective chart review of patients taking LDA was conducted at the National Cerebral and Cardiovascular Center in Japan. The rate of concomitant use of antiulcer agents and the risk of each patient to develop GI complications were evaluated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of the 314 patients, 64 were not on antiulcer agents and 55 of them had >1 risk factor. More patients not on antiulcer agents had started LDA before hospitalization."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The rate of coprescribing antiulcer agents with LDA was high. However, the timing of initiating LDA therapy affected the prescribing pattern of antiulcer agents."
          }
        ]
      },
