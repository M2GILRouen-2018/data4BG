      "Language": "rus",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To study peculiar clinical features of osteoporosis in patients with metabolic syndrome (MS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We examined 160 patients with osteoarthrosis divided into 2 groups each containing 80 patients with MS and without it (control). Osteoarthrosis was diagnosed using the R. Althmann (1995) criteria. The parameters measured were localization of articular lesions, frequency of inflammatory processes (synovitis), and pain intensity based on a VAS at rest and in motion, WOMAC index, characteristics of acute inflammation (ESR, C-reactive protein and TNF levels)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Frequency of joint lesions of different localization, occurrence of synovitis, inflammation and pain intensity in patients with MS was higher than in controls."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Results of the study confirm negative effect of MS on the clinical picture of osteoarthrosis."
        }
      ]},
