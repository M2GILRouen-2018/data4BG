      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To present our experience with the diagnosis and treatment of lateral sinus thrombosis (LST) secondary to otogenic disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "We have retrospectively reviewed all the cases of LST caused by chronic otitis media in ten years."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In our series of five patients, four patients were successfully treated by surgery without opening the sigmoid sinus. On the other hand, one of our patients developed hydrocephalus and ataxia during preoperative antibiotic treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Most patients with thrombotic/nonabscessed sinuses will have successful outcomes with this approach, but careful observation is needed, given the possibility of advancing disease."
        }
      ]},
