      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate a correlation between serum alkaline phosphatase level and body mass index in human subjects."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The comparative cross-sectional study was carried out at the National Institute for Biotechnology and Genetic Engineering, Faisalabad, Pakistan, from April 2012 to June 2013. Blood serum alkaline phosphatase levels were estimated and the subjects were divided into three sub-groups on the basis of their body mass."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "INDEX",
          "content": "normal weight (<25kg/m2), overweight (25-27kg/m2) and obese (>27kg/m2) subjects. The serum samples were used for the estimation of clinically important biochemical parameters, using commercial kits on clinical chemistry analyser."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of the 197 subjects, 97(49%) were obese and 100(51%) were non-obese. The serum alkaline phosphatase level increased in obese (214±6.4 IU/L) compared to the non-obese subjects (184.5±5 IU/L). Furthermore, a significant linear relationship (r=0.3;p-0.0001) was found between serum alkaline phosphatase and body mass index. Other biochemical variables were not correlated to the body mass index."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Over activity and higher amounts of alkaline phosphatase were linked to the development of obesity."
        }
      ]},
