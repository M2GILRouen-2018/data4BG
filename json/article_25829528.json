      "Abstract": {
        "CopyrightInformation": "© The Author 2015. Published by Oxford University Press on behalf of the Society of Pediatric Psychology. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To provide a review of the literature comparing anxious and depressive symptoms in caregivers of children with asthma with caregivers of healthy children."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A systematic search identified 25 studies from 17 articles, reporting outcomes on 4,300 caregivers of children with asthma and 25,064 caregivers of healthy children."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Overall, anxious (d\u2009=\u20090.50) and depressive symptoms (d\u2009=\u20090.44) were higher in caregivers of children with asthma compared with caregivers of healthy children. Age, site of recruitment, and whether the asthma diagnosis was medically confirmed were included as potential moderators. The relationship between parental psychopathology and asthma was stronger in those with medically confirmed asthma and participants recruited from clinical settings. Other moderators were not significant."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Caregivers of children with asthma appear to have greater anxious and depressive symptoms than caregivers of healthy children, but the reasons are unclear. More research that investigates modifiable factors that may moderate this association is urgently needed."
          }
        ]
      },
