      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To describe a simple and novel technique of obtaining an extraocular muscle (EOM) biopsy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Our sutureless method involves obtaining a full-thickness 3-mm EOM specimen using a disposable punch biopsy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The procedure was performed successfully, with no worsening of eye movement, muscle weakness, or cosmetic defects postoperatively. The acquired full-thickness specimen was sufficient for analysis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This technique to obtain an EOM biopsy allows a straightforward sutureless method, providing an adequate sample for tissue scrutiny."
        }
      ]},
