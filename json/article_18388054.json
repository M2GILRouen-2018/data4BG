      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To find the optimal time (early: < or =3 days; late: >3 days) for revascularization in ST elevation myocardial infarction (STEMI) patients in the subacute phase."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Ninety-nine STEMI patients who were admitted to Gazi University Faculty of Medicine between 2000 and 2004 were enrolled into this study. Patients were divided into 2 groups according to time from the beginning of symptoms to the percutaneous coronary intervention. Coronary angiograms before and after the revascularization were evaluated using the quantitative coronary angiogram technique."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "45 early (group I) and 54 late (group II) revascularized patients were evaluated. There were no significant differences between the 2 groups regarding demographic properties, thrombus score, success of the procedure, quantitative angiographic parameters, and clinical results of the procedure."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Waiting for the development of stable phase in STEMI to apply PCI has no obvious benefit for angiographic and clinical results."
        }
      ]},
