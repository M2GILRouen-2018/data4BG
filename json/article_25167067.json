      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study explored the association of stress and depression with a multidimensional sleep problems construct in a sample of 2-year college students."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "The sample consisted of 440 students enrolled in 2-year study from Fall 2011 to Fall 2013."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants in an obesity prevention study completed surveys assessing sleep, stress, and depression at baseline, 4, 12, and 24 months. Multilevel models predicting sleep problems were conducted to distinguish episodic from chronic reports of stress and depression."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Participants were primarily women (68%), white (73%), young adults (M age = 22.8), with an average of 8.4 hours of sleep per night. Neither stress nor depression was predictive of sleep quantity; however, they were predictive of sleep quality."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Results show that sleep quality rather than sleep quantity may be the greater health concern for young adults, suggesting that intervention programs targeting depression, stress management, and healthy sleep patterns are warranted."
        }
      ]},
