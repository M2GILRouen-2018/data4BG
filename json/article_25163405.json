      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American College of Allergy, Asthma & Immunology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Epinastine hydrochloride is a selective histamine H1 receptor antagonist that also inhibits IgE receptor-mediated histamine release from mast cells."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To show the superiority of epinastine 0.05% ophthalmic solution (epinastine) to placebo ophthalmic solution (placebo) and noninferiority to olopatadine 0.1% ophthalmic solution (olopatadine) for cedar pollen antigen-induced ocular itching and conjunctival hyperemia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The study was conducted in ophthalmologically asymptomatic adult volunteers with seasonal allergic conjunctivitis using a conjunctival allergen challenge test. Subjects were randomized into 3 groups (n = 87) to evaluate superiority to placebo (visits 4 to 6) and 2 groups (n = 86) to evaluate noninferiority to olopatadine (visit 7). At each visit, a single administration of the study medication was instilled at 15 minutes (visit 4), 4 hours (visit 5), 8 hours (visit 6), and 4 hours (visit 7) before the conjunctival allergen challenge test. Ocular itching and conjunctival hyperemia of allergic conjunctivitis were assessed after the conjunctival allergen challenge test."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "For the primary end point, epinastine showed superiority to placebo for the inhibition of ocular itching and conjunctival hyperemia induced at 4 hours after the dose (equivalent to 4-times-daily dosing). For the secondary end points, epinastine significantly inhibited itching and conjunctival hyperemia induced at 15 minutes and 8 hours after the dose (equivalent to 2-times-daily dosing) compared with placebo. In addition, epinastine demonstrated noninferiority to olopatadine for ocular itching and conjunctival hyperemia. No adverse drug reactions or serious adverse events were reported throughout the study, indicating that epinastine has a good safety profile."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Epinastine is effective and safe for the treatment of allergic conjunctivitis."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "TRIAL REGISTRATION",
            "content": "Clinicaltrials.gov identifier NCT01363700."
          }
        ]
      },
