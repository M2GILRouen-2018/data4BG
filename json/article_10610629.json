      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Manifestations of cardiac amyloidosis may include congestive heart failure and sudden cardiac death. Although vascular involvement in patients with amyloidosis is common, systemic amyloidosis presenting with angina is rare."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To report on patients with systemic amyloidosis presenting with angina pectoris."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case series."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Academic medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Five patients who presented with angina pectoris and normal coronary angiogram as the initial manifestation of systemic amyloidosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Endothelial-dependent and endothelial-independent coronary flow reserve."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All patients had coronary flow reserve abnormalities and subsequently developed congestive heart failure and systemic manifestations of amyloidosis. Histologic evaluation revealed amyloid deposition in the intramyocardial coronary vessels."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Cardiac amyloidosis can present as angina pectoris associated with coronary flow reserve abnormalities despite normal coronary angiograms. This finding may have major therapeutic and prognostic implications in this patient population."
        }
      ]},
