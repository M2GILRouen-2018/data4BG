      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To assess the performance of selective opportunistic screening in a primary care group practice."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cross-sectional survey of coronary heart disease risk factors and retrospective chart audit of cholesterol testing."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Capitation-funded primary care group practice in Ontario, Canada."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "7785 enrolled patients between the ages of 20 and 69 years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Protocol-based selective opportunistic screening program for hypercholesterolemia of 45 months duration."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Targeting (proportion of screening tests that were appropriate), coverage (proportion of those meeting screening criteria who had a screening test performed), over-screening (proportion of those not meeting screening criteria who had a screening test performed), and screening ratio (likelihood that a screening test was performed on an individual who met screening criteria rather than one who failed to meet screening criteria)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "64.7% of patients tested met the practice criteria for screening. 37.7% of patients who met the practice screening criteria were tested and 24.9% of those not meeting practice screening criteria had a cholesterol test performed. The screening ratio was 1.52."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Our findings bring into question the effectiveness of opportunistic approaches to preventive care."
        }
      ]},
