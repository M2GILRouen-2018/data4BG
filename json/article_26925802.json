      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the association between feeding practices and both fruit and vegetable intakes of preschoolers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional; data collected from 2009 to 2010."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Child care centers enrolled in the cohort of the Synergistic Theory and Research on Obesity and Nutrition Group Kids program."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Three hundred and sixteen mother-child dyads were recruited in the baseline survey as primary caregivers of children aged 2-5 years."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Ten aspects of maternal feeding practices were measured using a Comprehensive Feeding Practices Questionnaire. The frequency of children's fruit and vegetable consumption was estimated by mothers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Spearman's rank order correlation and linear regression analysis between parental feeding practices and both fruit and vegetable consumption were adjusted for potential confounders. Pearson's correlation coefficients among 10 parental feeding practices were calculated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Children in the study consumed fruit 1.7 ± 0.9 times per day and vegetables 1.4 ± 0.8 times per day. Feeding practices of building a healthy home food environment and involvement were positively related and those of restriction for health were negatively related to children's vegetable consumption (P < .001); moreover, encouraging balance and variety and monitoring were positively related to children's fruit consumption (P < .001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "The results of this study suggest that both fruit and vegetable intakes of preschool children are more likely to increase if parents employ feeding practices that encourage child autonomy, competence, and relatedness."
          }
        ]
      },
