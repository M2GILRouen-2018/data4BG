      "Abstract": {
        "CopyrightInformation": "© 2017 Nordic College of Caring Science.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The aim of the study was to gain understanding of existential longing in health and suffering as experienced by persons who have been affected by a cancer disease. The theoretical perspective of the study is K. Eriksson's theory of Caring Science."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Qualitative interviews with nine women with cancer were transcribed and interpreted using Gadamer's ontological hermeneutics."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Four perspectives of longing when suffering from cancer are presented: Longing as a source to call upon for survival, Longing for the life prior to the illness, Longing directed towards deeper relations in everyday life, and Transcending longing moves towards the ultimate fulfilment."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "INTERPRETATION",
            "content": "The overall interpretation led to the following thesis about the dimension of longing in the human being: Longing is becoming in a movement towards reconciliation of life, and, Longing is becoming in a movement towards transcending life."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The results show that there seems to be a dynamic power in longing that can transform suffering and create health."
          }
        ]
      },
