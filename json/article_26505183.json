      "Abstract": {
        "CopyrightInformation": "© Georg Thieme Verlag KG Stuttgart · New York.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The \"ParZivar II\" project had 2 aims: optimization of the \"ParZivar I\" intervention by individual coaching of physicians, and evaluation of the optimized intervention."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The intervention was evaluated in a sequential control group design in 4 rehabilitation facilities with 3 measurement points. A total of n=279 patients with chronic low back pain participated in the study."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The optimized intervention shows the potential to statistically significantly improve proximal outcomes (e. g. goal-centric processes or patient-physician interaction). Regarding distal outcomes, no statistically significant differences were found."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The \"ParZivar\" intervention is a suitable approach to increase participative goal setting. Due to the complexity of the intervention, problems of dissemination and the potential for improvement in study design, there is a need for further research."
          }
        ]
      },
