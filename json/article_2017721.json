      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the relationship between patient initiation and weight-related behavioral counseling during pregnancy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We examined audio recordings of prenatal visits between 22 obstetricians and 120 patients for behavioral counseling using the Roter Interaction Analysis System and the 5A's behavioral counseling framework. We used multivariate regression models to examine the relationship between patient initiation and communication outcomes."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Overall, 55% of prenatal visits included any behavioral counseling. Patients initiated counseling episodes 45.5% of these visits. Patients were less verbally dominated by their clinicians in prenatal visits with patient-initiated behavioral counseling episodes (difference in clinician verbal dominance ratio=0.73, 95% CI=0.16-1.30). Patient-initiated counseling episodes included more socioemotional communication relative to those initiated by clinicians (p=0.02). The total duration of counseling was 28s longer (95% CI 0.27-56.0s) and clinicians were more likely to use two or more 5A's strategies (OR=3.61, 95% CI=1.01-12.88) when patients initiated discussions."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Patient initiation may lead to behavioral counseling that is longer in duration and includes more 5A's strategies, possibly mediated by socioemotional communication."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Participatory prenatal care communication may lead to more effective counseling that is responsive to women's concerns."
          }
        ]
      },
