      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2017. Published by Elsevier B.V.",
        "AbstractText": [
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "RELEVANCE",
            "content": "Rudgea viburnoides, popularly known as \"congonha-de-bugre\" or \"erva de bugre\", is used in folk medicine as hypotensive, blood depurative, anti-rheumatic, diuretic and in the treatment of kidney and bladder pain."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "Based on the popularly acclaimed nephron-protective effect of R. viburnoides, we investigated, using rats, the protective effect of this plant extract on gentamicin-induced kidney injury."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "Urinary volume, water and food intakes were assessed in adult male Wistar rats (naive or gentamicin-induced model of nephrotoxicity) treated with R. viburnoides extract. Also blood and kidney samples were collected for further laboratory and histological analyses."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "R. viburnoides leaves extract improved renal function. It also improved the renal function impairments caused by gentamicin-induced nephrotoxicity, as revealed by glomerular filtration rate, urine output and proteinuria."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "R. viburnoides exert renoprotective effect, which may support its popular use for renal diseases treatment."
          }
        ]
      },
