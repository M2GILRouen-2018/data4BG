      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine racial and ethnic differences among middle school children in the home food environment (HFE) and the extent to which associations of healthy and unhealthy eating with the HFE differ by race and ethnicity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional secondary analyses of baseline data from Coordinated Approach to Child Health Middle School, a school-based intervention targeting obesity and obesogenic behaviors among middle school children in Austin, TX."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "A total of 2,502 children (mean age, 13.9 years; 58% Hispanic, 28% white, and 14% black)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "VARIABLES MEASURED",
            "content": "Availability and accessibility of healthy foods, and parental support of healthy eating, and family meals. Consumption of both healthy and unhealthy foods was examined."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Differences across racial and ethnic groups in aspects of HFE were estimated using linear regression. Models also examined racial and ethnic differences in consumption of healthy and unhealthy foods. If adjusting for HFE, such differences were accounted for."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "White children had significantly better HFEs than Hispanic and black children with greater availability and accessibility of healthy foods (P < .001). Adjusting for a healthy HFE reduced disparities in consumption of healthy foods but not in consumption of unhealthy foods."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Improved HFE may increase healthy eating among ethnic minorities but is unlikely to reduce unhealthy eating."
          }
        ]
      },
