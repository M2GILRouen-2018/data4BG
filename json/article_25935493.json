      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether the global metabolomic profile of the spent culture media (SCM) of day-3 embryos is different in obese and normoweight women undergoing in vitro fertilization (IVF)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective cohort analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "IVF clinic."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Twenty-eight young, nonsmoking women with normoweight, nonsmoking male partners with mild/normal sperm factors undergoing a first IVF attempt for idiopathic infertility, tubal factor infertility, or failed ovulation induction: obese ovulatory women (n = 12); obese women with polycystic ovary syndrome (PCOS; n = 4); normoweight ovulatory women (n = 12)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Fifty μl of SCM collected from two day-3 embryos of each cohort."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Metabolomic profiling via ultrahigh performance liquid chromatography coupled to mass spectrometry of SCM from a total of 56 embryos."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "The untargeted metabolomic profile was different in obese and normoweight women. Partial least squares discriminant analysis resulted in a clear separation of samples when a total of 551 differential metabolites were considered. A prediction model was generated using the most consistent metabolites. Most of the metabolites identified were saturated fatty acids, which were detected in lower concentrations in the SCM of embryos from obese women. The metabolomic profile was similar in obese women with or without PCOS."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "The metabolomic profile in the SCM of day-3 embryos is different in normoweight and obese women. Saturated fatty acids seem to be reduced when embryos from obese patients are present."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CLINICAL TRIAL REGISTRATION NUMBER",
            "content": "NCT01448863."
          }
        ]
      },
