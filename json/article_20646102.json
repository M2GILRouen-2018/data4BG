      "Abstract": {
        "CopyrightInformation": "© 2010, Copyright the Authors. Journal compilation © 2010, The American Geriatrics Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To investigate the association between cardiopulmonary fitness and cognitive performance in subjects with coronary artery disease (CAD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional observational study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Outpatient cardiac rehabilitation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Eighty-one subjects with CAD."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Cardiopulmonary fitness was assessed by measuring peak oxygen uptake (VO(2Peak) ) in a standardized exercise stress test. The fraction of the predicted age and sex norm for VO(2Peak) was computed for each patient. A battery of neuropsychological tests including the Stroop, Trail-Making Test Part B, Digit Symbol Coding, Revised Brief Visuospatial Memory Test, California Verbal Learning Test 2nd Edition, and Mini Mental State Examination (MMSE) was administered, from which composite Z-scores were computed for tasks involving executive function and memory."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Executive function, memory, and MMSE scores were correlated with VO(2Peak) , but only performance in the executive domain was independently associated with VO(2Peak) in multiple linear regression. In a multiple linear regression model controlling for potential clinical confounders, VO(2Peak) (β=.666, P<.001) and covariates accounted for 36% of the variance in executive function scores."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Poorer VO(2Peak) is associated with poorer cognition, particularly executive function, in subjects with CAD independent of other cardiac risk factors. Cardiopulmonary fitness may be a protective factor for cognition in patients with CAD."
          }
        ]
      },
