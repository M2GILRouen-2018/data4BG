      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective, randomized, double-blinded, placebo-controlled protocol."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "An academic, tertiary care referral center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Forty randomly selected children, ages 3 to 13 years, scheduled for adenotonsillectomy without other simultaneous procedures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "A single, oral dose of dextromethorphan pediatric cough syrup (1 mg/kg) or placebo given 30 minutes before surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Total dose requirement of intravenous morphine within a 6-hour postoperative observation period."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "During routine postoperative observation, significantly fewer patients in the dextromethorphan group required no intravenous morphine compared with the placebo group (P =.03). Of those children requiring morphine, the mean dose requirement was significantly lower in the dextromethorphan group (P =.02). There was no known drug-related morbidity."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Dextromethorphan syrup is a safe, non-narcotic medication that significantly reduced the requirement of intravenous morphine after pediatric adenotonsillectomy. Its routine use in this manner is recommended."
        }
      ]},
