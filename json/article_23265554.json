      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Neurocysticercosis is endemic in most countries of Central and South America but has rarely been described in the French West Indies. We aimed to better understand the clinical and radiological presentation of our cases."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE PRESENTATION",
          "content": "We report three cases of neurocysticercosis in patients living in Guadeloupe, with different clinical and radiological presentations."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Given the eventuality of autochtonous transmission, the diagnosis should be considered in all patients living in Guadeloupe presenting with seizures."
        }
      ]},
