      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To assess the repeatability of low-dose Synacthen test (LDST) in asthmatic children receiving high-dose fluticasone propionate (FP)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Low-dose Synacthen test was performed on 18 children with stable chronic asthma treated with FP at a constant daily dose of > or =500 microg and repeated 1 month later. Repeatability was assessed using the Kappa statistic for categorical variables."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Fifteen patients had consistent results (either two normal or two abnormal responses) and three patients had inconsistent results (one normal and one abnormal response). The Kappa statistic was 0.56 indicating fair to good agreement between the tests."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The results of adrenal function testing in patients on inhaled steroids can have major implications for patient management, making it important to use a test with excellent repeatability. The LDST conducted using our protocol does not fulfil this criterion."
        }
      ]},
