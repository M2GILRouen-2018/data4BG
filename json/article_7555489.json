      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To increase awareness concerning abdominal pain associated with the use of captopril, which is a molecule frequently used in diabetic patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "One case of acute pancreatitis associated with captopril, confirmed by a reintroduction, is described in a type II diabetes patient."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Captopril and other angiotensin-converting enzyme inhibitors are very frequently prescribed in diabetic patients. Therefore, it is important to be aware of the possibility of pancreatitis linked to these molecules and to withdraw the treatment in case of severe unexplained abdominal pain."
        }
      ]},
