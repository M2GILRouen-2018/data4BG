      "Abstract": {
        "CopyrightInformation": "© 2015 Association of Rehabilitation Nurses.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "High sodium intake increases the risk of cardiovascular diseases. Cardiac patients are recommended a daily sodium restriction of ≤1,500 mg. The purpose of this article is to describe daily sodium intake and sodium restriction adherence and its correlates in cardiac rehabilitation (CR) program participants following cardiac revascularizations."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "This is a descriptive correlational study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A subanalysis was performed using the data collected from a randomized controlled trial to determine the effect of a 12-week weight management intervention."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "The average daily sodium intake was 3,020 mg ± 1,134 at baseline, 4,047 mg ±1,517 at 4 months, and 4,399 mg ± 1,722 at 6 months. The adherence rates were 4.8% at baseline and zero at 4 and 6 months. The factors influencing daily sodium intake were identified."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The CR program participants failed to adhere to the sodium restriction guidelines."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL RELEVANCE",
            "content": "Rehabilitation nurses need to identify effective strategies to educate CR participants and their family members regarding dietary sodium adherence in CR participants."
          }
        ]
      },
