      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A functional defect of T regulatory cells (Treg) has been proposed as pathogenic mechanism of allergic reaction. Polysensitization is a common feature of allergic patients."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM OF THE STUDY",
          "content": "It was to investigate the possible role of Treg-Th1 cytokines, in the development of new sensitizations in childhood."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Forty monosensitized (MS) children with allergic rhinitis were evaluated and followed-up for 2 years. New sensitizations were investigated. IL-10 and IFN-gamma were evaluated in in vitro experiments."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Children remaining MS showed significant higher production of both IL-10 and IFN-gamma."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This preliminary study provided evidence that IL-10 and IFN-gamma production could be defective in allergic children prone to develop polysensitization."
        }
      ]},
