      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To determine how hypertension affects the left ventricular diastolic function of patients with effort angina."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We performed radionuclide ventriculography in 14 patients with isolated stenosis of the left anterior descending coronary artery and in seven healthy volunteers."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Neither global nor regional peak filling rate differed significantly between the patients with (n = 6) and without (n = 8) hypertension, although the left ventricular asynchronous index was significantly increased (P < 0.05) in the hypertensive patients (87 +/- 20 ms), compared with the normotensive patients (59 +/- 22 ms). This index was significantly (P < 0.05) correlated with left ventricular mass index in all participants."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Hypertension increased the diastolic non-uniformity of the left ventricle in patients with effort angina."
        }
      ]},
