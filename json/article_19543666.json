      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the associations between smoking and alcohol consumption, and long-term sick leave due to unspecific back or neck pain among employees in the public sector."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A 3-year prospective cohort study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Approximately 9000 persons in the public sector in Sweden were invited to participate. Of these, 7533 answered a questionnaire and 6532 were included in the study, classified as having \"good health for working\"."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "New periods of sick leave >or= 28 days were consecutively reported from the employers or the occupational health service during a period of 3 years. Rate ratios were estimated by means of Cox proportional hazard regression model."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Smoking was associated with an increased risk of long-term sick leave due to unspecific back or neck pain. Compared with people who have never smoked, \"ever smokers\" had a higher risk (rate ratio = 1.8, 95% confidence interval: 1.3-2.4). Alcohol consumption tended to be associated with a decreased risk, but the results were not statistically significant."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Our results suggest that smoking is a risk factor for long-term sick leave due to unspecific back or neck pain. Moderate alcohol consumption tends to have a protective effect, at least among women in the public sector."
        }
      ]},
