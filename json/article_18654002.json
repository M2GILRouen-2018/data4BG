      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Recent large-scale genome-wide association studies have identified a novel susceptibility locus on chromosome 9p21.3 that contributes a significant attributable risk for myocardial infarction. The phenotypic significance of this locus in patients with established coronary artery disease is unknown. We sought to compare cardiovascular structure and function in carriers and non-carriers of the risk haplotype in a cross-sectional study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We genotyped the rs1333049 single-nucleotide polymorphism in 593 Caucasian individuals with stable coronary artery disease recruited in the Heart and Soul Study. All study subjects underwent resting and stress echocardiography. Linear and logistic regression models were used to examine the association between the rs1333049 polymorphism and echocardiographic parameters of cardiovascular structure and function."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was no association between rs1333049 genotype and echocardiographic phenotype (left ventricular hypertrophy, systolic dysfunction, diastolic dysfunction, inducible ischemia, exercise capacity, mitral annular calcification, and aortic plaque)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In a cross-sectional study of individuals with stable coronary artery disease, there was no association of chromosome 9p21.3 genotype with cardiovascular structure and function."
        }
      ]},
