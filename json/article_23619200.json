      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe the prevalence of depression in children with chronic fatigue syndrome (CFS)/myalgic encephalomyelitis (ME) and investigate the relationship between depression in CFS/ME and clinical symptoms such as fatigue, disability, pain and school attendance."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cross-sectional survey data using the Hospital Anxiety and Depression Scale (HADS) collected at assessment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Specialist paediatric CFS/ME service in the South West."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Children aged 12-18 years with CFS/ME."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Depression was defined as scoring >9 on the HADS depression scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "542 subjects had complete data for the HADS and 29% (156/542) (95% CI 25% to 33%) had depression. In a univariable analysis, female sex, poorer school attendance, and higher levels of fatigue, disability, pain, and anxiety were associated with higher odds of depression. Age of child and duration of illness were not associated with depression. In a multivariable analysis, the factors most strongly associated with depression were disability, with higher scores on the physical function subscale of the 36 item Short Form (SF-36)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Depression is commonly comorbid with CFS/ME, much more common than in the general population, and is associated with markers of disease severity. It is important to screen for, identify and treat depression in this population."
        }
      ]},
