      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To increase physicians' and dentists' awareness that nicorandil is a potential inducer of severe mouth ulceration."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Nine new cases of ulceration from 3 European countries were included in this study."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Oral ulceration developed within 9 months of beginning nicorandil therapy, and ulcers resolved within 1 month of withdrawal of the drug. No lesions developed on other epithelia."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A number of drugs used in the care of patients with cardiovascular disease can cause oral adverse effects. Nicorandil, a new potassium-channel activator used in some countries to treat angina pectoris, precipitates persistent ulcerative stomatitis in some patients."
        }
      ]},
