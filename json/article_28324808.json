      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "partner presence in the labour room can influence childbirth pain outcomes and maternal well-being. We examined midwives' perception of the use of partner presence in the management of childbirth pain in Nigerian hospitals."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "a descriptive cross-sectional quantitative study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "maternity units of four hospitals in Abuja, Nigeria, Jun.-Dec., 2014."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "100 midwives selected through convenience sampling."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "data collected using the Abuja Instrument for Midwives (AIM) questionnaire underwent frequency, correlation, and content analysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "most midwives felt partner presence contributed to pain relief and were willing to allow partner presence as an intervention for childbirth pain. However, only every fourth midwife reported using partner presence as a pain management intervention."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "KEY CONCLUSION",
            "content": "partner presence is perceived as contributing to pain relief and is a non-pharmacological technique reported to be utilised by midwives for pain management during childbirth. However, Nigeria suffers from poor utilisation of partner presence as a pain management intervention during childbirth."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATION FOR PRACTICE",
            "content": "information from this study can improve midwifery practice and aid further research regarding midwives' attitudes, knowledge and usage of partner presence in pain management during childbirth."
          }
        ]
      },
