      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Bannayan Riley Ruvalcaba syndrome (BRRS) is exceedingly rare, with only about 50 reported cases to date."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE PRESENTATION",
          "content": "We report a patient with hypoglycemia, precocious puberty and diffuse testicular microlithiasis accompanying BRRS, and think that this case is important in the light of a newly identified mutation in the PTEN gene."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Close attention must be paid in terms of PTEN mutations in cases of macrocephaly and accompanying neurological and dermatological findings."
        }
      ]},
