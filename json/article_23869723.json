      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of this study is to examine the relationship between body mass index (BMI) and functional independence level in children with spina bifida (SB)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The study included 116 children between 5 and 18 years. Subjects' socio-demographic characteristics, BMI values and functional independence levels were recorded."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was negative correlation between BMI and communication and social cognition in girls (p\u2009<\u20090.05). No correlation was found between BMI and WeeFIM in boys (p\u2009>\u20090.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The results indicated that body weight in children with SB affected functional independency and that precautions to control weight important in these children."
        }
      ]},
