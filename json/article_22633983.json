      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "ETHNOPHARMACOLOGICAL RELEVANCE",
            "content": "The use of medicinal plants for the treatment of diseases usually comes from the belief that they present low toxicity due their natural origin. However, it is necessary a toxicological and pharmacological evaluation for these plants. Tropaeolum majus is a medicinal plant used in popular medicine to treat several diseases, including cardiovascular disorders, urinary tract infections and asthma. Even though several studies proved its therapeutic effects, there are few toxicological studies with this species."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM OF THE STUDY",
            "content": "The present study was carried out to evaluate the subchronic toxicity of the hydroethanolic extract obtained from leaves of T. majus (HETM) in Wistar rats."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "Male and female Wistar rats received three doses of HETM (75, 375 and 750 mg/kg) for 28 days. After the treatments biochemical, hematological and histopathological parameters were analyzed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No significant alterations in the animal's body weight gain, relative organs weight, serum biochemical analysis, hematological or histopathological analyses of liver, kidneys and spleen were observed."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These results demonstrate the absence of subchronic toxicity due to oral treatment with HETM for 28 days in Wistar rats. However, other toxicological studies are necessary to evaluate the total safety of this plant."
          }
        ]
      },
