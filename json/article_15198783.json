      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate outcomes in caesarean sections repeated several times."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "POPULATION",
          "content": "Sixty-four women had had four or more (up to 10) caesarean sections."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The outcomes of these operations N= 149, study group) were compared with other caesarean sections."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A quarter of the women in the study group complained of low abdominal pains during the late pregnancy. A thin or fenestrated isthmic myometrial layer was observed in 55% of their operations. Abnormal placentation with an increased risk of major operative complications occurred more often in the study group. No differences in post-operative complications or perinatal outcome emerged between the groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Thus, no definitive upper limit for the number of caesarean sections per individual woman can be given."
        }
      ]},
