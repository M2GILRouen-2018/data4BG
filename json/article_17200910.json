      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "RATIONALE",
          "content": "Postprandial hyperinsulinemic hypoglycemia, known as late dumping syndrome, is a rare but often misdiagnosed complication after gastric surgery. The pathophysiological mechanisms are poorly understood and the treatment of this syndrome is challenging."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "PATIENT CONCERNS",
          "content": "New-onset postsurgical late dumping syndrome after Toupet fundoplication."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "DIAGNOSES",
          "content": "Sigstad Score, OGTT, CGM."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Daily subcutaneous injection of liraglutide (0.6 mg and 1.2 mg)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "OUTCOMES",
          "content": "Reduction in fasting and postprandial peak insulin level with improvement in symptomatic hypoglycemic events."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "LESSONS",
          "content": "Liraglutide may be a novel treatment option for postprandial hyperinsulinemic hypoglycemia after gastric surgery."
        }
      ]},
