      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The management of patients with simultaneous coronary artery and carotid artery disease is still controversial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A retrospective review of the records and follow-up data of 139 consecutive patients undergoing simultaneous coronary artery bypass graft and carotid endarterectomy from 1981 to 1999 was carried out."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Early mortality was 2.1%, perioperative myocardial infarction and stroke rates were 2.8 and 1.4%, respectively. Survival at 7 years was 74.7+/-5.1% and event-free survival at 7 years was 67.9+/-5.6%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The combined surgical approach has proved to be effective and safe allowing the treatment of both diseases in a single operative procedure."
        }
      ]},
