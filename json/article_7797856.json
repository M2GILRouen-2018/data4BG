      "Abstract": {
        "CopyrightInformation": "© 2015 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The association between musculoskeletal injuries and carpal tunnel syndrome (CTS) has not been investigated in a large, population-based study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Latino manual laborers were recruited as part of a study of work-related health conditions. Each had a clinical examination, completed a hand diagram, and had nerve conduction studies."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 512 individuals completed all testing. An association was found between rotator cuff syndrome and CTS, with an adjusted odds ratio of 2.25 (P\u2009=\u20090.01) for the right arm, 2.08 (P\u2009=\u20090.03) for the left arm, and 1.84 (P\u2009=\u20090.03) for all individuals. Associations between epicondylitis and CTS did not reach statistical significance."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Individuals with rotator cuff syndrome have a higher prevalence of CTS. Further investigations will be needed to examine for causation and to determine if 1 condition typically occurs first and leads to the other. Muscle Nerve 54: 31-35, 2016."
          }
        ]
      },
