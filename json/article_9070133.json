      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To review the effectiveness and safety of transcutaneous electrical nerve stimulation (TENS) for labour pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A systematic review of randomised controlled trials of TENS in pain during labour."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "Eight reports involving 712 women were included; 352 women received active TENS and 360 acted as controls."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Reports were sought by searching MEDLINE and the Oxford Pain Relief Database."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Analgesic and adverse effect outcomes."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Evidence for reduced pain using TENS in labour was weak. Additional analgesic interventions may be less likely with TENS (odds ratio 0.57; 95% CI 0.34-0.96), number-needed-to-treat 14 (95% CI 7.3-119)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Randomised controlled trials provide no compelling evidence for TENS having any analgesic effect during labour. Weak positive effects in secondary (analgesic sparing) and tertiary (choosing TENS for future labours) outcomes may be due to inadequate blinding causing overestimation of treatment effects."
        }
      ]},
