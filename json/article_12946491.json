      "Language": "fre",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We assessed the efficacy of topical methylprednisolone or lidocaine for prevention of postoperative sore throat."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Randomised, prospective in single blind study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "Sixty patients ASA 1 or 2 undergoing tracheal intubation for dental surgery received before intubation either topical lidocaine 5% (15 puffs) or aerosolized methylprednisolone (80 mg). Postoperative pain was assessed by the patients using a VAS and a specific scoring system for sore throat, cough and hoarseness. Evaluations were performed immediately after emergence from anaesthesia, 1 h later, at time of the first postoperative drink, at time of the first postoperative meal and 24 h after surgery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients receiving methylprednisolone showed slightly better scores for sore throat and cough 1 h after surgery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Topical methylprednisolone may therefore be a useful adjuvant in the prevention of sore throat after intubation."
        }
      ]},
