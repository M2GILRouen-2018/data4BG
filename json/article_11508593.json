      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the complication rate of knee arthroscopy as performed by rheumatologists."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A prospective study of complication rate in sequential patients having knee arthroscopies performed by rheumatologists at University of California Los Angeles (UCLA) over an 8 year period."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 342 knee arthroscopies were performed. There were 6 complications (1.8%), including one each of seizure, gout, portal cellulitis, ankle pain, inadequate knee drainage, and vasovagal symptoms. There was no longterm morbidity or mortality secondary to the procedures."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Knee arthroscopy performed by experienced rheumatologists trained in arthroscopy has a low rate of complications, which are mostly minor."
        }
      ]},
