      "Abstract": {
        "CopyrightInformation": "Published 2013. This article is a U.S. Government work and is in the public domain in the USA.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To examine the effectiveness of videoconferencing technology for delivering comprehensive weight management treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This retrospective cohort study was conducted by extraction of data from medical records for the years 2008-2010. The treatment included a series of 12 weekly MOVE!® classes delivered using videoconferencing. Data were extracted from the time of baseline weight to 1 year after baseline weight for the MOVE! participants (n = 60) and from a concurrent control group (n = 60) that did not participate in MOVE! treatment."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "Results indicated that the MOVE! group lost weight while the control group gained weight, resulting in a mean difference between the groups of -5.5 ± 2.7 kg (95% CI = -8.0 to -3.0; P < .0001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These results indicate that videoconferencing is an effective method to provide the MOVE! Weight Management Program to veterans. Weight loss was maintained for one year after baseline in the MOVE! group. This is very promising as weight re-gain is a common issue and these results support using videoconferencing for a long-term weight management treatment option."
          }
        ]
      },
