      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the impact of spinal cord stimulation (SCS) on the need for acute admissions for chest pain in patients with refractory angina pectoris."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective analysis of case records."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "19 consecutive patients implanted for SCS between 1987 and 1997. All had three vessel coronary disease, and all were in New York Heart Association functional group III/IV."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Admission rates were calculated for three separate periods: (1) from initial presentation up until last revascularisation; (2) from last revascularisation until SCS implantation; (3) from SCS implantation until the study date. Post-revascularisation rates were then compared with post-SCS rates, without including admissions before revascularisation, as this would bias against revascularisation procedures."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Annual admission rate after revascularisation was 0.97/patient/year, compared with 0.27 after SCS (p = 0.02). Mean time in hospital/patient/year after revascularisation was 8.3 days v 2.5 days after SCS (p = 0.04). No unexplained new ECG changes were observed during follow up and patients presented with unstable angina and acute myocardial infarction in the usual way."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "SCS is effective in preventing hospital admissions in patients with refractory angina, without masking serious ischaemic symptoms or leading to silent infarction."
        }
      ]},
