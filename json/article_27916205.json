      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To systematically review and summarize the existing evidence related to the efficacy and safety of transdermal T in postmenopausal women for the treatment of hypoactive sexual desire disorder (HSDD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Systematic reviews and meta-analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Not applicable."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Seven randomized controlled trials enrolled 3,035 participants; 1,350 women were randomized to treatment with T patch, and 1,379 women were randomized to placebo."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "None."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Primary outcome: satisfying sexual episodes."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "SECONDARY OUTCOMES",
            "content": "sexual activity, orgasm, Profile of Female Sexual Function domains (desire), personal distress score, adverse events, acne, increased hair growth, facial hair, alopecia, voice deepening, urinary symptoms, breast pain, headache, site reaction, total adverse events, serious adverse events, withdrawal from study, and follow-up rate."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "The T group had significantly more satisfying sexual episodes, sexual activity, orgasms, desire, significant change in Personal Distress Scale score, androgenic adverse events, acne, and hair growth compared with the placebo group. There was no significant difference between the two groups in increase in facial hair, alopecia, voice deepening, urinary symptoms, breast pain, headache, site reaction to the patch, total adverse events, serious adverse events, reasons for withdrawal from the study, and the number of women who completed the study."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "The short-term efficacy in terms of improvement of sexual function and safety of transdermal T in naturally and surgically menopausal women affected by HSDD either on or not on estrogen progestin hormone therapy is evident from this systematic review. The use of transdermal T is associated with increase in androgenic adverse events such as acne but is not associated with any serious adverse events."
          }
        ]
      },
