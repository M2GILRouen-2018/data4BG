      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Society for Gastrointestinal Endoscopy. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Barrett's esophagus with high-grade dysplasia (HGD) or intramucosal adenocarcinoma (IMC) can be effectively treated by single-session EMR, resulting in complete Barrett's excision (CBE). CBE provides accurate histology for staging and clinical confirmation of neoplasia eradication but is limited by a high risk of esophageal stricture formation."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the effectiveness of prophylactic temporary esophageal stenting to prevent post-CBE stricture formation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND SETTING",
            "content": "Single-center, investigator-initiated feasibility study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Circumferential, short-segment Barrett's esophagus (≤C3≤M5) with HGD or IMC."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Single-stage CBE and insertion of a fully covered metal esophageal stent at 10 days that was removed at 8 weeks. Patients were followed for a minimum of 2 surveillance endoscopies."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASUREMENT",
            "content": "Symptomatic esophageal stricture formation."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "At the end of the follow-up period, 8 patients (57.1%) required esophageal dilation for symptomatic CBE-related (n = 7) or stent-related (n = 4) strictures. A median of 3 surveillance endoscopies were performed over a median endoscopic follow-up of 17 months (range 4-25 months). Single-stage CBE successfully eliminated Barrett's intestinal metaplasia and neoplasia in 71.4% and 92.9% of patients, respectively. Four patients were admitted to the hospital, and 4 patients had early stent removal because of pain or dysphagia."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "Single-center feasibility study."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In a prospective study evaluating prophylactic esophageal stent insertion after single-stage CBE, esophageal strictures formed in more than of half the study cohort, and stents were associated with significant morbidity. An alternative method to reduce stricture formation is required. ("
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CLINICAL TRIAL REGISTRATION NUMBER",
            "content": "NCT01554280.)."
          }
        ]
      },
