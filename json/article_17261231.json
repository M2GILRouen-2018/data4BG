      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Cooking programs are growing in popularity; however, an extensive review has not examined their overall impact. Therefore, this study reviewed previous research on cooking/home food preparation interventions and diet and health-related outcomes among adults and identified implications for practice and research."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Literature review and descriptive summative method."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Dietary intake, knowledge/skills, cooking attitudes and self-efficacy/confidence, health outcomes."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Articles evaluating the effectiveness of interventions that included cooking/home food preparation as the primary aim (January, 1980 through December, 2011) were identified via Ovid MEDLINE, Agricola, and Web of Science databases. Studies grouped according to design and outcomes were reviewed for validity using an established coding system. Results were summarized for several outcome categories."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 28 studies identified, 12 included a control group with 6 as nonrandomized and 6 as randomized controlled trials. Evaluation was done postintervention for 5 studies, pre- and postintervention for 23, and beyond postintervention for 15. Qualitative and quantitative measures suggested a positive influence on main outcomes. However, nonrigorous study designs, varying study populations, and the use of nonvalidated assessment tools limited stronger conclusions."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Well-designed studies are needed that rigorously evaluate long-term impact on cooking behavior, dietary intake, obesity and other health outcomes."
          }
        ]
      },
