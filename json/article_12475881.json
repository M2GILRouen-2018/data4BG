      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVES",
          "content": "To evaluate the cost-effectiveness of inhaled fluticasone propionate (FP) in children aged 12 to 47 months with asthma symptoms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A retrospective economic analysis conducted from the perspective of the Danish health-care system, based on clinical data from a 12-week study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Thirty-three outpatient centers in nine countries."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Two hundred thirty-seven children aged 12 to 47 months with documented history of recurrent wheeze or asthma symptoms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Two dosages of FP, 100 microg/d and 200 microg/d, and placebo administered in two divided doses via a metered-dose inhaler and a Babyhaler (Glaxo Wellcome; Middlesex, UK) spacer device."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Effectiveness in terms of asthma exacerbations, control of cough and wheeze symptoms, symptom-free days, overall direct costs of asthma management in Danish kroner at 1999 prices, and mean and incremental cost-effectiveness ratios."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "FP, 200 microg/d, was significantly more effective than placebo treatment in terms of the proportion of exacerbation-free patients (73.7% vs 59.8%; p = 0.025) and patients experiencing a > or = 25% improvement in cough symptoms (57.9% vs 39.0%; p = 0.018). The costs per exacerbation-free patient, per patient with a > or = 25% improvement in cough and wheeze symptoms from baseline, and per symptom-free day were lower in the FP groups than in the placebo group. The incremental cost-effectiveness ratios for these end points indicated that the additional benefits of FP, 200 microg/d, were achieved at a lower overall cost compared with placebo treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "From the perspective of the Danish health-care system, FP, 100 microg bid, administered via the Babyhaler inhalation device was cost-effective relative to standard therapy with bronchodilators alone."
        }
      ]},
