      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To propose clonazepam for use in the empiric treatment of shooting/shocking phantom limb pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient pain clinic associated with a university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Two patients with phantom limb pain after total hip disarticulation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Treatment with clonazepam."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RESULTS AND CONCLUSIONS",
          "content": "Clonazepam provided effective relief for > 6 months in two patients with shooting/shocking phantom limb pain. Although clonazepam therapy is not new, it appears to have been omitted from current pain texts and journals as a treatment option for phantom limb pain."
        }
      ]},
