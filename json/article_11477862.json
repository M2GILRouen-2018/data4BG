      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the influence of Sini Decoction (SND) on living quality of patients after percutaneous transluminal coronary angioplasty (PTCA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Randomized case-control clinical trail was conducted to evaluate the living quality of 40 post-PTCA patients before and after SND treatment by scoring."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The scores in physical symptoms, sense of well-being, depression, satisfaction of life and work capacity of patients after PTCA were improved significantly as compared with before PTCA, P < 0.05-0.01. Scores of patients received SND treatment were higher than those untreated with SND in the first three criteria, P < 0.05, particularly on relieving palpitation and dyspnea."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "SND is helpful to improve the living quality of patients after PTCA."
        }
      ]},
