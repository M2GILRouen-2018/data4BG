      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 SPLF. Published by Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The increased prevalence of asthma and COPD, the expected decline in the number of respiratory physicians and the availability of spirometers in primary care suggest that GPs should perform spirometry."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate French final year medical (GP) students' theoretical and practical knowledge of spirometry."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The students completed a questionnaire and were then separated into 4 groups: satisfactory theoretical and practical knowledge (group 1), theoretical knowledge (group 2), practical knowledge (group 3), insufficient theoretical and practical knowledge (group 4)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "One thousand two hundred and sixty one students (29 universities) were included between February and April 2012. Of the students, 4.3 % (54) fell into group 1, 35.2% (444) into group 2, 5.4% (68) into group 3 and 63.7% (803) into group 4. The students in group 1 had done significantly more internships in departments of respiratory medicine during their training (P<0.0001, OR: 3.93, IC95%: 2.2-7.07)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "As a result of their theoretical and practical training, only 5% of the students considered themselves able to perform and interpret spirometry. A specific training program is necessary."
          }
        ]
      },
