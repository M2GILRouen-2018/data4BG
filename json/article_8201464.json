      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare two methods of administering analgesia by the epidural route after cesarean sections."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Quasi-experimental."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The postpartum area of a large community hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Fifty women undergoing planned cesarean sections with epidural anesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "The control group received continuous epidural analgesia with nurse-administered boluses and the experimental group with self-administered boluses."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Pain control, side effects from medication, amount of medication required, postoperative activity levels, and patient satisfaction."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Subjects receiving continuous epidural analgesia with self-administered boluses of analgesic used significantly less fentanyl and fewer supplemental intravenous pain medications than subjects receiving continuous epidural analgesia with nurse-administered boluses of analgesic."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Subjects in self-administered group required less pain medication than subjects in nurse-administered group."
        }
      ]},
