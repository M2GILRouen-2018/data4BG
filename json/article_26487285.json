      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the two-year clinical outcomes of a prospective, randomized controlled trial of an FDA-approved interspinous spacer with the compilation of published findings from 19 studies of decompressive laminectomy for the treatment of lumbar spinal stenosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Back and leg pain, Oswestry disability index (ODI), and Zurich Claudication Questionnaire (ZCQ) values were compared between spacer- and laminectomy-treated patients preoperatively and at 12 and 24 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Percentage improvements between baseline and 24 months uniformly favored patients treated with the spacer for back pain (65% vs. 52%), leg pain (70% vs. 62%), ODI (51% vs. 47%) and ZCQ symptom severity (37% vs. 29%) and physical function (36% vs. 32%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Both treatments provide effective and durable symptom relief of claudicant symptoms. This stand-alone interspinous spacer offers the patient a minimally invasive option with less surgical risk."
        }
      ]},
