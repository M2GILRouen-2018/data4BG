      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study determined the hormonal and subjective appetite responses to exercise (1-h continuous versus intermittent exercise throughout the day) in obese individuals."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "Eleven obese subjects (>30 kg/m(2) ) underwent three 12-h study days: control condition [sedentary behavior (SED)], continuous exercise condition [(EX) 1-h exercise], and intermittent exercise condition [(INT) 12 hourly, 5-min bouts]. Blood samples (every 10 min) were measured for serum insulin and total peptide YY (PYY) concentrations, with ratings of appetite (visual analog scale [VAS): every 20 min]. Both total area under the curve (AUC), and subjective appetite ratings were calculated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No differences were observed in total PYY AUC between conditions, but hunger was reduced with INT (INT < EX; P < 0.05), and satiety was increased with both SED and INT conditions (INT > EX and SED > EX; P < 0.05). A correlation existed between the change in total PYY and insulin levels (r = -0.81; P < 0.05), and total PYY and satiety (r = 0.80; P < 0.05) with the EX condition, not the SED and INT conditions."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The total PYY response to meals is not altered over the course of a 12-h day with either intermittent or continuous exercise; however, intermittent exercise increased satiety and reduced hunger to a greater extent than continuous exercise in obese individuals."
          }
        ]
      },
