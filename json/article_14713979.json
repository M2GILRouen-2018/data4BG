      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Intraabdominal focal fat infarction is an acute abdominal condition unfamiliar to many doctors. Until recently it has only been diagnosed perioperatively, but since 1985 several authors report the use of imaging modalities and a spontaneous regression of this disorder."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Report of two cases and a review of the literature."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Intraabdominal focal fat infarction presents characteristic imaging findings with ultrasonography and computer tomography. A well-defined lesion of fat with oedema is found in the location of maximum tenderness."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "INTERPRETATION",
          "content": "Doctors dealing with the acute abdomen, particularly radiologists and surgeons, should be aware of this condition. With a confident diagnosis, unnecessary surgery may be avoided."
        }
      ]},
