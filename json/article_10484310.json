      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A preoperative preparatory program may help morbidly obese patients cope with postoperative pain and vomiting, and reduce length of nursing care."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A preoperative preparatory program was given to randomly selected morbidly obese women about to undergo a Lap-Band stomach reduction operation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Statistical testing of the results of the program against a control group of patients who did not receive the program revealed beneficial differences between the two groups in terms of postoperative pain, analgesic use, postoperative vomiting, and duration of nursing care."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The differences were not statistically significant, although the reaction of patients who received the program was positive."
        }
      ]},
