      "Language": "rus",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To assess effectiveness of alphacalcidol in the treatment of osteopenic syndrome in patients with bronchial asthma (BA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "65 BA patients with low densitometric parameters of bone tissue density were examined for bone density, basic parameters of Ca-P metabolism and some markers of bone metabolism during 6-month therapy with alphacalcidol (alpha-D3-TEVA) in a dose 0.5-0.75 mcg/day."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All the patients after 6 months of therapy experienced pain relief, normalization of calcium-phosphorus metabolism, lower risk of broken bones. Their bone tissue increased its density."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Alphacalcidol has analgetic and antiresorptive properties. It effectively prevents and treats osteopenic syndrome in patients with bronchial asthma."
        }
      ]},
