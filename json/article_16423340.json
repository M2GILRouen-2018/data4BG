      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To investigate the possible association between functional variant Ala-9Val in the MnSOD gene and asthma in the case-control study comprising 626 Caucasian subjects."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "MnSOD genotypes were determined by PCR with subsequent restriction analysis by the BsaWI enzyme."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Significant differences in allele frequencies between groups were not ascertained."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Pursuant to these results, Ala-9Val polymorphism does not seem to be a significant predisposing factor for bronchial asthma in the Czech population."
        }
      ]},
