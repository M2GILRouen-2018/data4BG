      "Abstract": {
        "CopyrightInformation": "Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND CONTEXT",
            "content": "Elective lumbar discectomy among injured workers is a prevalent spine surgery that often requires a lengthy rehabilitation. It is important to determine presurgical biopsychosocial predictors of compensation and medical costs in such patients."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To determine if presurgical biopsychosocial variables are predictive of compensation and medical costs in a cohort of Utah patients who have undergone open or microlumbar discectomy that are receiving workers' compensation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN/SETTING",
            "content": "A retrospective cohort study consisting of a review of presurgical medical records and accrued medical and compensation costs."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT SAMPLE",
            "content": "A consecutive sample of 266 compensated workers from Utah who had undergone either open discectomy or microlumbar discectomy from 1994 to 2000. All patients were at least 2 years postsurgery at the time of follow-up."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Total accrued medical, compensation, and aggregate costs."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A retrospective review of presurgical biopsychosocial variables and total accrued medical, compensation, and aggregate costs."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Presurgical variables were statistically significantly correlated with medical and compensation costs. Multiple linear regression models accounted for 31% of variation in compensation costs, 32% in medical costs, and 43% in total aggregate costs."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Presurgical biopsychosocial variables are important predictors of compensated lumbar discectomy costs. Medical cost control programs might benefit from identifying biopsychosocial variables related to increased costs."
          }
        ]
      },
