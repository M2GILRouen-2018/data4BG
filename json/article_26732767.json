      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 AWHONN, the Association of Women's Health, Obstetric and Neonatal Nurses. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To identify problems at different treatment points (early treatment, mid-treatment, early posttreatment, and late posttreatment) among women with ovarian cancer."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Longitudinal and cross-sectional study design."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "An academic and community clinical cancer center in the Southeastern United States."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Sixty-eight women with Stage I to IV ovarian cancer."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Variables assessed included reported problems (physical, psychosocial, pain, marital, medical interaction), social support, optimism, and responses to open-ended questions. Analysis involved mixed models for longitudinal repeated measures and unpaired t tests and content analysis to describe responses to open-ended questions."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Physical and psychosocial problems were greatest during early treatment and decreased throughout the treatment trajectory. Women with greater levels of social support and optimism at baseline had fewer problems over time. Women who did not have trouble paying for basics had fewer problems related to pain and psychological problems."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Problems across all domains must be addressed throughout the treatment trajectory, even after chemotherapy has ended. Nurses are well positioned to refer women appropriately to social workers and clinical navigators across all domains of care and should consider systematic assessment of patient-reported problems as a routine form of practice."
          }
        ]
      },
