      "Abstract": {
        "CopyrightInformation": "© The International Society for Prosthetics and Orthotics 2013.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Vertebral fractures are the most common clinical manifestations of osteoporosis. Vertebral fractures and reduced back extensor strength can result in hyperkyphosis. Hyperkyphosis is associated with diminished daily functioning and an increased risk of falling. Improvements in back extensor strength can result in decreased kyphosis and thus a decreased risk of falls and fractures."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim was to examine the effects of an active spinal orthosis - Spinomed III - on back extensor strength, back pain and physical functioning in women with osteoporotic vertebral fractures."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Experimental follow-up."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The women used the active spinal orthosis for 3 months. Outcomes were changes in isometric back extensor strength, changes in back pain and changes in physical functioning."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 13 women were included in the trial. Wearing the orthosis during a 3-month period was associated with an increase in back extensor strength of 50% (p = 0.01). The study demonstrated a 33% reduction in back pain and a 6.5-point improvement in physical functioning. The differences in pain and physical functioning were borderline significant."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The women demonstrated a clinically relevant improvement in the back extensor strength. The differences in pain and physical functioning were clinically relevant and borderline significant."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL RELEVANCE",
            "content": "The results imply that Spinomed III could be recommended for women with vertebral fractures as a supplement to traditional back strengthening exercises. It is essential that the orthosis is adjusted correctly and that there is an individual programme concerning the amount of time the orthosis has to be worn every day."
          }
        ]
      },
