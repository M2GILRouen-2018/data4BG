      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of bilateral ovarian pregnancy in a young patient who had previously undergone intrauterine insemination (IUI) and controlled ovarian stimulation (COS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 34-year-old woman who had previously undergone IUI and COS."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Emergency exploratory laparotomy for circulatory collapse. About 350 mL of bloody fluid was collected in the pelvic cavity. The left ovary was about 6 cm in diameter and was completely involved by a darkish hemorrhagic ovarian mass; the right ovary was involved by a 4-cm mass. A left ovariectomy and a partial resection of the right ovary with preservation of two-thirds of ovarian tissue was performed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "IUI and COS outcome."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "The pathologic diagnosis was considered, and bilateral ovarian pregnancy was confirmed according to the diagnostic criteria described by Spiegelberg."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Diagnosis of primary ovarian pregnancy is very difficult because of its rarity and asymptomatic state before rupture. However, early diagnosis is fundamental to avoid more serious complications and an emergency invasive procedure."
        }
      ]},
