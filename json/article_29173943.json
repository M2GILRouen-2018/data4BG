      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study explored the feasibility of using a 23-week subsidized community-supported agriculture program to increase access to and intake of vegetables among Federally Qualified Health Center patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Outcomes were measured using pre-post intervention surveys (n\u2009=\u20099). Process data were collected in post-intervention surveys and focus groups (n\u2009=\u200915)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Most participants (77%) indicated that the program improved their health and all (100%) reported that they were eating a greater variety of vegetables because of their participation in the program. Three themes emerged from the focus groups: increased access to fresh and/or organic vegetables, improved diet quality, and the importance of social support during the program."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Linking subsided community-supported agriculture programs with Federally Qualified Health Centers has the potential to increase access to and intake of vegetables among low-income patients. However, further research is needed with a larger sample size and a more robust study design."
          }
        ]
      },
