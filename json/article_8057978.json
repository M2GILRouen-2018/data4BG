      "Abstract": {
        "CopyrightInformation": "© 2016 American Academy of Neurology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To explore the previously undescribed phenomenon of phantom limb generation in patients with severe acute inflammatory demyelinating polyradiculoneuropathy (AIDP)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Between April 2011 and January 2014, we encountered 3 patients with AIDP in our intensive care unit who experienced features of self-limited supernumerary phantom limbs (SPLs) during their course."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The following case series describes the phenomenon of SPLs in AIDP."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This report aims to raise awareness of the possibility of SPLs in the course of AIDP. The pathophysiology and management strategies for this clinical phenomenon are unknown."
          }
        ]
      },
