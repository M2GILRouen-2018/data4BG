      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Report a case of a difficult myomectomy after a failed uterine artery embolization (UAE)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A university medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 30-year-old woman with pelvic pain and menorrhagia secondary to an enlarging 18- to 20-week-size fibroid uterus."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Abdominal myomectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Complicated myomectomy after UAE."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "A patient underwent a difficult myomectomy after failed UAE. The myomectomy was only partially completed due to the difficult dissection of the myomas."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Myomectomy after UAE may be unusually difficult due to the degenerative changes that occur within the leiomyomas."
        }
      ]},
