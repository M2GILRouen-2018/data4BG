      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the impact of an extended-release, once-daily morphine sulfate formulation on depressive symptoms and neurocognition in patients with chronic nonmalignant pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, open-label, one-group trial with a pretest-posttest design."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient pain management clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND INTERVENTION",
          "content": "Chronic nonmalignant pain patients inadequately controlled with short-acting opioid analgesics and eligible for treatment with once-daily morphine sulfate were initiated on a dose at or near the morphine-equivalent dose of the short-acting regimen."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "OUTCOMES",
          "content": "The following assessments were made at baseline and 4 weeks after initiating intervention: pain intensity, pain unpleasantness, pain suffering, pain behaviors, Beck Depression Inventory, and cognitive function."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Eighty-four patients provided usable data. Pain intensity, unpleasantness, and suffering scores were significantly reduced at follow-up (P = 0.001). The mean Beck Depression Inventory scores were significantly lower at follow-up (P = 0.001). Significant improvements were seen in scores at follow-up on the three validated neurocognitive tests: the digit span test, the digit symbol substitution test, and the paced auditory serial addition test (P = 0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Achieving adequate pain control with once-daily morphine was associated with a reduction in pain and improvements in depressive symptoms and cognitive functioning in the short term."
        }
      ]},
