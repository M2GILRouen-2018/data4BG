      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the reliability of the Kids' Activity and Nutrition Questionnaire (KAN-Q) as part of a tiered process for developing Supplemental Nutrition Assistance Program-Education tools."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The KAN-Q was administered at 2 time points to assess internal consistency using standardized values of Cronbach α and test-retest reliability using the intraclass correlation coefficient for continuous variables, Cohen's kappa (κ) statistic for categorical variables, and the weighted κ statistic for ordinal data."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Data were collected from 119 fourth graders. Cronbach α was adequate for behavior (.71) and knowledge (.72) scales and nutrition behavior (.78) and nutrition knowledge (.75) subscales. Test-retest reliability was generally acceptable, with intraclass correlation coefficients from 0.40 to 0.75 and κ coefficients showing fair to substantial agreement (0.30 to 0.72)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "The KAN-Q is a practical and reliable questionnaire for school-based administration that aligns directly with Supplemental Nutrition Assistance Program-Education evaluation priorities."
          }
        ]
      },
