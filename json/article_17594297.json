      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This pilot study describes pain and anxiety associated with allergy testing; tests distraction, specifically self-selected distraction; and examines the relationship between pain, anxiety, and engagement with distraction."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND METHODS",
          "content": "An experimental design was used with a convenience sample of 32 adolescents from an allergist's office randomly assigned to three groups. Pain was measured by the adolescent pediatric pain tool (APPT) and FACES scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No differences in pain ratings were found among the groups. Less pain was associated with lower anxiety and greater engagement with distraction. Greater engagement with distraction occurred with less anxiety."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "PRACTICE IMPLICATIONS",
          "content": "Knowledge about allergy testing pain, anxiety, and engagement with distraction can assist nurses in preparing adolescents for this procedure."
        }
      ]},
