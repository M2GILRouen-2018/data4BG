      "Abstract": {
        "CopyrightInformation": "Copyright © 2017. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To describe MRI features of multiple Focal Nodular Hyperplasia (FNHs)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "40 consecutive subjects (37 females, mean age, 38.8years) were included. All studies were independently reviewed. This was an observational study to define the radiological features of multifocal FNH."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "130 lesions were evaluated. The majority (88.5%), were peripheral in location. 92.3% lesions were lobulated. Marked enhancement was present in 94.6% lesions. In the portal venous and delayed phase, 46.2% and 47.7% lesions were mildly hyperintense. Central scar was present in 77% lesions."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Distinctive features included predominant subcapsular location and mild hyperintensity in the delayed phase, seen in nearly 50% of FNHs."
          }
        ]
      },
