      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "The first-in-man ABSORB Cohort A trial demonstrated the bioresorption of the ABSORB BVS (Abbott Vascular, Santa Clara, CA, USA) at two years. This report describes the 4-year clinical outcomes."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "METHODS AND RESULTS",
          "content": "The ABSORB Cohort A trial enrolled 30 patients with a single de novo native coronary artery lesion. Clinical follow-up was available in 29 patients since one patient withdrew consent after the six month follow-up. At four years, the hierarchical ID-MACE of 3.4% remained unchanged. Clopidogrel therapy had been discontinued in all patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Four-year clinical results demonstrate a sustained low MACE rate (3.4%) without any late complications such as stent thrombosis."
        }
      ]},
