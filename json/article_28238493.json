      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To demonstrate a step-by-step approach to microsurgical partial orchiectomy (PO) in a man with a small intratesticular mass."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Video presentation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "A 22-year-old man with right testicular pain and swelling found to have a small, nonpalpable 8-mm hypoechoic testicular mass on ultrasound. Tumor markers were negative."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Partial orchiectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Intraoperative technique with commentary highlighting tips for a successful resection."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "This video provides a brief introduction to and indications for PO as an alternative to radical orchiectomy. We describe the microsurgical approach to PO through an inguinal incision for the resection of a small intratesticular mass."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Microsurgical PO should be considered for select patients as an alternative to radical orchiectomy. The microscopic approach provides a more precise resection with limited collateral damage to surrounding parenchyma."
          }
        ]
      },
