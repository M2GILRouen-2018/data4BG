      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Childhood obesity is one of the most prevalent public health concerns."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A pre and post study design was used to explore the efficacy of an obesity prevention program. Children had weight, height, blood pressure, and waist circumference measured, and completed self-reported questionnaires on food intake, knowledge, self-efficacy, and health-related quality of life. Parents completed demographic and acculturation surveys."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Seventy children participated in the study. Results demonstrated significant reduction of BMI, systolic blood pressure, and fast food consumption and improvement of self-efficacy, knowledge, and quality of life."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Childhood obesity intervention is feasible and has short-term efficacy."
          }
        ]
      },
