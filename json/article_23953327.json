      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the efficacy of continuous oral contraceptive (OC) use versus the usual cyclic fashion in the recurrence of endometriosis-related symptoms after surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective cohort trial involving patients in two tertiary care units."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Academic institution in collaboration with a private hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "356 patients underwent surgical treatment by laparoscopy for symptomatic endometriosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "After surgical treatment for endometriosis, patients offered 6-month course of cyclic OC (including a 7-day pill-free period) or continuous OC."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Recurrence rate of endometriosis-related symptoms and endometriomas after fertility-sparing surgery."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Out of 356 patients, 167 were placed on the usual cyclic OC course and 85 on continuous OC for a minimum of 6 months. The continuous OC group experienced a statistically significant reduction in recurrence rates for endometrioma, dysmenorrhea, and non-menstrual pelvic pain as compared with the cyclic OC group. There was no reduction in the recurrence of dyspareunia between the two groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "After surgical treatment of endometriosis, the use of both cyclic and continuous OC improves pain symptoms when compared with preoperative scores. Continuous OC appears to be associated with a reduced recurrence rate for dysmenorrhea, non-menstrual pelvic pain, and endometrioma but not for dyspareunia as compared with cyclic OC."
          }
        ]
      },
