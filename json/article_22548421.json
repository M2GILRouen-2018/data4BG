      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To examine the effect of parental support on sedentary behaviors among Hispanic children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND SETTING",
          "content": "A longitudinal quasi-experimental design with five waves of data collection was used to examine the effect of parental support on children's sedentary behaviors in a school-based intervention program in west Texas."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Hispanic low-income parents and their children of 5 to 9 years (N = 416 child-parent dyads) over a 22-month period (1217 observations)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Transformacion Para Salud was a multicomponent intervention program aimed at prevention and control of childhood overweight and obesity. It used a community-based participatory research approach, including nutrition education, physical exercise, gardening, and family involvement."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASURES",
          "content": "Sedentary behaviors were measured by parents' report of their children's daily screen time per week, including TV/DVD, computer, Internet, and video games. Parental support was measured with parents' reported support for active living."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANALYSIS",
          "content": "Growth curve analysis was used to examine trajectories of sedentary behaviors of children."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Response rate was over 70%. Parental support reduced children's sedentary behaviors. Girls were less sedentary than boys, but girls were less affected by parental support. The intervention was effective in reducing children's sedentary behaviors over time."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "It is important for school intervention programs to mobilize parents to provide more support to reduce sedentary behaviors."
        }
      ]},
