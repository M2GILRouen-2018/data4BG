      "Abstract": {
        "CopyrightInformation": "© 2013 Society of Hospital Medicine.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "There is uncertainty about optimal strategies for venous thromboembolism (VTE) prophylaxis among select populations such as patients with renal insufficiency, obesity, or patients taking antiplatelet drugs including aspirin. Their physiologies make prophylaxis particularly challenging."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "We performed a comparative effectiveness review of the literature on efficacy and safety of VTE prophylaxis in these populations."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "We searched MEDLINE, EMBASE, SCOPUS, CINAHL, International Pharmaceutical Abstracts, clinicaltrial.gov, and the Cochrane Library through August 2012. Eligible studies included controlled trials and observational studies."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA EXTRACTION",
            "content": "Two reviewers evaluated studies for eligibility, serially abstracted data, and independently evaluated the risk of bias and strength of evidence supporting interventions to prevent VTE in these populations."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After a review of 30,902 citations, we identified 9 controlled studies, 5 of which were trials, and the other 4 were observational studies. Five articles addressed prophylaxis of patients with renal insufficiency, 2 addressed obese patients, and 2 addressed patients on antiplatelet agents. No study tested prophylaxis in underweight patients or those with liver disease. The majority of observational studies had a high risk of bias. The strength of evidence ranged from low to insufficient regarding the comparative effectiveness and safety of VTE prophylaxis among these patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The current evidence is insufficient regarding optimal VTE prophylaxis for patients with renal insufficiency, obesity, or those who are on antiplatelet drugs including aspirin. High-quality studies are needed to inform clinicians about the best VTE prophylaxis for these patients."
          }
        ]
      },
