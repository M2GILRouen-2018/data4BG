      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Current evidence suggests that asthma patients with the ADRB2 Arg16 genotype have a poorer response to long-acting β2-agonists (LABA), but the results remain inconsistent."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "This study assessed the association between Arg16 variants and treatment outcome in children treated with inhaled corticosteroids (ICS) and LABA."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS & METHODS",
          "content": "ADRB2 Arg16 was genotyped in 597 children (4-12 years of age) participating in the PACMAN cohort study. A questionnaire was used to assess asthma control, frequency of asthma-related emergency department visits and use of oral corticosteroids in the past year."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Arg/Arg carriers with a reported use of ICS and LABA had an increased risk of oral corticosteroid use (odds ratio: 14.9; 95% CI: 1.59-140.1) and emergency department visits in the past year (odds ratio: 11.9; 95% CI: 1.22-115.8) compared to Gly/Gly carriers. This effect was not observed in Arg/Arg genotype carriers reporting ICS use only."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Children who are homozygous for ADRB2 Arg16 have an increased risk of exacerbations when treated with combined LABA and ICS."
        }
      ]},
