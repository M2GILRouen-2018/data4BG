      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE AND DESIGN",
          "content": "To study the antinociceptive effects of metamizol in a rat model of ureteric calculosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Adult female Wistar rats (n = 40)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "TREATMENT",
          "content": "Metamizol was given i.p. 50-100 mg/kg, 3 times daily for 4 days for behavioural testing, and 25-100 mg/kg i.v. whilst recording peristalsis or dorsal horn neurons."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "An artificial stone was induced in one ureter. In 3 separate groups of stone-implanted rats, behaviour was recorded continuously on video tape, ureteric peristalsis or the electrical activity of single nociceptive dorsal horn neurons with ureteric input was recorded under anaesthesia. Data were compared with analysis of variance."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Metamizol inhibited the behavioural visceral crises, the abnormal ureteric peristalsis and the activity of nociceptive dorsal horn neurons."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Metamizol has central antinociceptive effects on the pain produced by a ureteric stone, and an additional spasmolytic effect on the hyperperistalsis produced by the stone."
        }
      ]},
