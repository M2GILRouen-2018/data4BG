      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Cold Water Immersion (CWI) is commonly used to manage delayed onset muscle soreness (DOMS) resulting from exercise. Scientific evidence for an optimal dose of CWI is lacking and athletes continue to use a range of a treatment protocols and water temperatures."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To compare the effectiveness of four different water immersion protocols and a passive control intervention in the management of DOMS."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomised controlled trial with blinded outcome assessment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University Research Laboratory."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "50 healthy participants with laboratory induced DOMS randomised to one of five groups: Short contrast immersion (1 min 38 °C/1 min 10 °C × 3), Short intermittent CWI (1 min × 3 at 10 °C); 10 min CWI in 10 °C; 10 min CWI in 6 °C; or control (seated rest)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "muscle soreness, active range of motion, pain on stretch, muscle strength and serum creatine kinase."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "10 min of CWI in 6 °C was associated with the lowest levels of muscle soreness and pain on stretch however values were not statistically different to any of the other groups. There were no statistically significant differences between groups for any other outcomes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Altering the treatment duration, water temperature or dosage of post exercise water immersion had minimal effect on outcomes relating to DOMS."
          }
        ]
      },
