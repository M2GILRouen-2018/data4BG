      "Abstract": {
        "CopyrightInformation": "© The Author 2016. Published by Oxford University Press. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Arthroscopy procedures are the gold standard for the management of tibial spine avulsion. This review evaluates and compares different arthroscopic treatment options for tibial spine fractures."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SOURCE OF DATA",
            "content": "PubMed, Medline, Ovid, Google Scholar and Embase databases were systematically searched with no limit regarding the year of publication."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "AREAS OF AGREEMENT",
            "content": "An arthroscopic approach compared with arthrotomy reduces complications such as soft-tissue lesions, post-operative pain and length of hospitalization."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "AREAS OF CONTROVERSY",
            "content": "The use of suture techniques, compared to cannulated screw technique, avoids a second surgery for removal of the screws, but requires longer immobilization and partial weight bearing."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "GROWING POINTS",
            "content": "Clinical outcomes and radiographic results do not seem to differ in relation to the chosen method of fixation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "AREAS TIMELY FOR DEVELOPING RESEARCH",
            "content": "Further studies are needed to produce clear guidelines to deﬁne the best choice in terms of clinical outcomes, function and complications."
          }
        ]
      },
