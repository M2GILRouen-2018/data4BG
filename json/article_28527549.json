      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Society of PeriAnesthesia Nurses. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "Although intravenous acetaminophen has been administered to reduce postoperative pain, it has not been used during cardiac implantable electronic devices (CIEDs) implantation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "This was a randomized double-blinded interventional study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Thirty-two patients who were referred for new CIED implantation during July 2012 until April 2013 randomly received placebo or 1 g of intravenous acetaminophen. All patients were treated with local anesthesia. Pain score during incision, pocket creation, and in the recovery room, and the patients' need for analgesics during the 6 hours after the procedure were recorded in both groups."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "Seventeen and 15 patients received acetaminophen and placebo, respectively. Pain scores in patients treated with acetaminophen were significantly lower (4.4 vs 2.9, P = .004), and they received less analgesics (17% vs 60%, P = .014)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Intravenous administration of acetaminophen is effective for pain relief in patients undergoing CIED implantation and decreases the need for postoperative analgesics."
          }
        ]
      },
