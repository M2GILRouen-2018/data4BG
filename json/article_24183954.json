      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Éditions françaises de radiologie. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To assess the efficacy of venous embolization treatment for the pelvic congestion syndrome (PCS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Retrospective study of 33 female patients undergoing pelvic venous embolization between January 2008 and May 2012 in Bordeaux. The inclusion criteria were clinical symptoms of PCS documented by transabdominal Doppler ultrasound and/or pelvic magnetic resonance imaging. Patients with pelvic varicose veins feeding saphenous varicose veins were excluded. The efficacy of treatment was assessed on a Visual Analog Scale (VAS)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Thirty-three patients were included and the mean follow up period was 26months (3-59months). The VAS was 7.37 (standard deviation: 0.99) before embolization and 1.36 (standard deviation: 1.73) after embolization (P<0.0001). Twenty patients reported that their symptoms had completely disappeared, 11 had partially disappeared and two had gained no improvement. A significant fall was found in the number of patients with dyspareunia (P<0.0001). A single technical embolization failure was reported."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Our series demonstrates the efficacy of embolization treatment with a significant fall in the VAS in patients with PCS."
          }
        ]
      },
