      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the acceptability of early transvaginal sonography by pregnant patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A questionnaire was completed by 246 patients and the resulting data were analysed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The incidence of discomfort was higher for the transabdominal than for the transvaginal route. Moreover, the transvaginal approach in early pregnancy, when compared with other transvaginal sonographic examinations was described as more satisfactory in 95% of cases."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Transvaginal sonography in early pregnancy is better tolerated than transabdominal sonography."
        }
      ]},
