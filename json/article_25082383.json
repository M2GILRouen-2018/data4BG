      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case series."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To evaluate relationships between spinal cord stimulation (SCS) parameters and levels of glial cell-derived neurotrophic factor (GDNF)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Ambulatory pain clinic of St James's Hospital, Dublin, Ireland."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Nine patients with an implanted SCS and Failed Back Surgery Syndrome (FBSS) were administered the Brief Pain Inventory and Short Form (36) Health Survey. Following a lumbar puncture, levels of GDNF in cerebrospinal fluid (CSF) were assayed and correlated with stimulation parameters. Controls were patients with arthritic back pain who were matched for age, gender and SF-36 score."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Concentrations of GDNF in CSF are higher in patients with FBSS than controls (P=0.002) and correlate with SCS frequency (P=0.029)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Concentrations of GDNF in CSF are higher in neuropathic pain and appear to be related to stimulation frequency. Further work is needed to evaluate this potential relationship, both in neuropathic pain and in other contexts such as locomotor dysfunction."
        }
      ]},
