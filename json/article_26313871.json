      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate the success rate and outcome of coronary artery perforation treatment using a dual guiding catheter technique."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Coronary artery perforation is a rare but severe complication during percutaneous coronary intervention (PCI) with high mortality. The use of a second guiding catheter is a helpful technique to minimize hemorrhage through the perforation during interventional repair."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We screened all patients between March 2004 and December 2014 who underwent PCI in our department for the occurrence of peri-interventional coronary perforation that was treated using a dual catheter technique. Patient and lesion characteristics as well as outcome were determined."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We identified 8 patients who experienced coronary artery perforations (Ellis grade III) during coronary intervention and were treated using a dual guiding catheter approach. The procedure was technically successful (placement of covered stent and sealing of perforation) in 6 patients. Pericardiocentesis was required in 3 patients (38%). Total mortality was 12% (n=1). No coronary or peripheral vascular access complication occurred due to the use of a second guiding catheter."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "We suggest that the dual guiding catheter technique is a useful and alternative approach to treat severe Ellis grade III coronary artery perforations that occur in the context of percutaneous coronary interventions."
          }
        ]
      },
