      "Abstract": {
        "CopyrightInformation": "© 2011 The Authors. Journal of the European Academy of Dermatology and Venereology © 2011 European Academy of Dermatology and Venereology.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Several studies stated that patient with psoriasis carried an increased risk of psoriasis but some studies did not demonstrate this association."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim of this study was to evaluate the prevalence of hypertension in psoriasis based on a sample of Spanish population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This was a hospital-based case-control study involving 661 psoriatic patients (cases) and 661 control matched by gender and age. Meta-analysis of the previous studies was made."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The prevalence of hypertension was significantly higher in psoriasis patients than controls (30.3%, 21.3%, respectively, P\u2003<\u20030.001). In a multivariate analysis, hypertension was associated with psoriasis after controlling for age, gender, diabetes, obesity and smoking (OR\u2003=\u20031.44, 95% confidence interval: 1.07-1.94)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The results of this study support the association between psoriasis and hypertension."
          }
        ]
      },
