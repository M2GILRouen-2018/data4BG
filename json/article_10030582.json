      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To describe an unusual ophthalmic manifestation of a pituitary adenoma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Case report."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A 32-year-old man had left supraorbital and frontal headaches and new-onset vertical diplopia. Examination showed a left fourth nerve palsy and increased vertical fusional amplitudes. Magnetic resonance imaging disclosed a sellar mass consistent with a pituitary macroadenoma."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A pituitary adenoma may rarely manifest with an isolated fourth nerve palsy."
        }
      ]},
