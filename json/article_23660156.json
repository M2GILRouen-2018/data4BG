      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To evaluate the benefit of fluoroscopy-guided lumbar spine interventional procedures in treatment of low back pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This prospective descriptive study was performed on 60 patients with back/radicular pain after showing no improvement with conservative treatment."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "One hundred and two injection sessions were done (average 1.7 injection per patient). Caudal and lumbar transforaminal injections were effective in 55.9% and 78.5%, respectively. Facet and sacroiliac interventions were effective in 28.3% and 10%, respectively. Complications occurred in 20% of the procedures."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Lumbar injections improved pain/disability related to discogenic lumbar spinal diseases. Efficacy of facet and sacroiliac injections is limited."
          }
        ]
      },
