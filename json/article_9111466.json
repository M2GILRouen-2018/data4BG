      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effectiveness of topical application of aspirin in chloroform as an adjuvant in the management of chronic neurogenic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Intervention study, nonrandomized before-and-after trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A department of physical medicine and rehabilitation in a tertiary-care university teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Fifteen adults who presented with severe, chronic neurogenic pain in whom, conventional methods of treatment were unsuccessful in alleviating the pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "A solution of aspirin (acetyl salicylic acid) in chloroform was applied over the painful areas."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "A numerical scale from 0 to 100 was used to measure the severity of pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Seventy-four percent of patients showed a good response, 13% had fair response, and in 13% there was no response."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Aspirin in chloroform solution is a simple and effective adjuvant in the management of chronic neurogenic pain."
        }
      ]},
