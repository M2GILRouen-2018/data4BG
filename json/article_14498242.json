      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To describe the excellent outcome of surgery for bilateral giant retinal tears (GRTs) with better options of endotamponade."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This is a case report of a 62-year-old man who presented with bilateral GRTs and associated retinal detachment. The tear in the right eye was supero-temporal and silicone oil was used as an endotamponade. The tear in the left eye was infero-temporal and perfluorocarbon liquid was used as an endotamponade."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The outcome at 6 months after surgery was excellent with visual acuities of 6/6 in both eyes."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Improved availability of endotamponade agents allows repair of bilateral GRTs to be done at the same time, with good surgical outcomes."
        }
      ]},
