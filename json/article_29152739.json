      "Abstract": {
        "CopyrightInformation": "© 2017 The American Laryngological, Rhinological and Otological Society, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the incidence of first bite syndrome (FBS) in transoral robotic surgical (TORS) patients undergoing transcervical arterial ligation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Retrospective case series of all patients diagnosed with FBS following prophylactic transcervical arterial ligation of branches of the external carotid system between March 2010 and December 2016 at a single academic center."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Six patients with FBS after TORS with transcervical arterial ligation were evaluated, representing 7% of all patients who underwent neck dissection with concomitant transcervical arterial ligation (6 of 83). Median presentation of FBS was 63 days, with an average duration of 66 days. Treatment ranged from observation to botulinum toxin injection."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Patients who undergo transcervical arterial ligation to minimize bleeding complications following TORS are at risk of developing first bite syndrome."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "4. Laryngoscope, 2017."
          }
        ]
      },
