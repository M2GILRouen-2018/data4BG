      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the efficacy and safety of Insuflow (Georgia BioMedical, Inc.) filter heater hydrator device in reducing the incidence, severity and extent of hypothermia, length of recovery room stay and postoperative pain at the time of laparoscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomized, blinded, controlled multi-center study. Patients underwent gynecologic procedures via laparoscopy; surgeons, anesthesiologists and recovery room personnel assessed the results."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Seven North American institutions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Seventy-two women for safety evaluation and efficacy studies."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Intraoperative pre-conditioning of laparoscopic gas with the Insuflow device (treatment) or standard raw gas (control) during laparoscopic surgery and postoperatively."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Incidence, severity and extent of hypothermia, postoperative pain perception and length of recovery room stay."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The Insuflow group had significantly less intraoperative hypothermia, reduced length of recovery room stay and reduced postoperative pain. Pre-conditioning of laparoscopic gas by filtering heating and hydrating was well tolerated with no adverse effects. The safety profile of the Insuflow pre-conditioned gas showed significant benefits compared to currently used raw gas."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Pre-conditioning laparoscopic gas by filtering heating and hydrating with the Insuflow device was significantly more effective than the currently used standard raw gas and was safe in reducing or eliminating laparoscopic-induced hypothermia, shortening recovery room length of stay and reducing postoperative pain."
        }
      ]},
