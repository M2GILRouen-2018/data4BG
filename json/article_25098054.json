      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Wheat allergy has been suggested to represent an important allergic disease. This study collates clinical and laboratory aspects in patients with wheat allergy in Al-Kharj city, Saudi Arabia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Total and specific IgE were measured in 15 suspected cases of wheat allergy. Protein allergenicity was assessed with Western blotting."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Significant elevation of total and specific IgE was found in 4 cases. Basophlia was also demonstrated on blood film. Western blotting results showed 2 bands (83 and 40 kDa)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Wheat allergy must also be considered when planning treatment of asthma and eczema of adult patients."
        }
      ]},
