      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of this study was to estimate the association of pregravid body mass index (BMI), independent of 3-hour oral glucose tolerance test (OGTT) results, with pregnancy outcome."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "In this secondary analysis of a cohort of women with untreated mild gestational glucose intolerance, which was defined as a 50-g glucose loading test between 135 and 199 mg/dL and fasting glucose level of <95 mg/dL, we modeled the association between pregravid BMI, OGTT results, and both pregnancy complications and neonatal adiposity."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Among 1250 participants, both pregravid BMI and glucose at hour 3 of the OGTT were associated with increased risk of gestational hypertension. Maternal pregravid BMI also was associated positively with large-for-gestational-age infants; both maternal BMI and fasting glucose were associated with birthweight z-score and neonatal fat mass."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Among women with untreated mild gestational glucose intolerance, pregravid BMI is associated with increased gestational hypertension, birthweight, and neonatal fat mass, independent of OGTT values."
          }
        ]
      },
