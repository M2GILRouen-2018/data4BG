      "Abstract": {
        "CopyrightInformation": "© 2013, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "This study examined the effect of pressing a soft ball during intravenous catheter insertion (IVCI) on the intensity of pain in children ages 4-6 years."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "In this quasi-experimental study, children in the intervention group were asked to press a soft ball with the opposite hand during IVCI and to immediately mark the Wong-Baker FACES Pain Rating Scale."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was a significant difference in the intensity of pain between the control group (n = 30) and the intervention group (n = 30; p =.012)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Pressing a soft ball during IVCI may be an easily accessed, inexpensive, and effective technique to control or reduce pain in young children."
          }
        ]
      },
