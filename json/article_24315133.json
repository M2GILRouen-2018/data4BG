      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier España, S.L.U. and SEMICYUC. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "A study was made to explore the possible association between the perioperative transfusion of 1 - 2 red blood cell units and in-hospital morbidity, 30-day mortality, and long-term survival in patients undergoing heart surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A prospective observational study was carried out."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "The ICU of a university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "All patients over 17 years of age that underwent heart surgery and were admitted to the ICU between November 2002 and December 2009 were included. Those patients who did not (n=703) and those who did (n=959) receive the perioperative transfusion of 1 - 2 red blood cell units were assessed."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "STUDY ENDPOINTS",
            "content": "The endpoints were the effect of transfusion on both hospital morbidity and on 30-day mortality. In addition, all patients discharged alive from hospital until 31 December 2011 were subjected to follow-up. The association between transfusion and survival was assessed by means of the Kaplan-Meier method. Cox proportional hazards models were used to assess factors associated with long-term survival."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The frequency of both cardiac and non-cardiac perioperative complications was higher in patients receiving transfusion. The 30-day mortality rate was higher in those who received transfusion (1% vs 0.1%, P=.02). Preoperative anemia was associated with a more intensive use of transfusion. Red blood cell transfusion was not found to be a risk factor for long-term mortality (hazar ratio=1.4, 95%CI 0.9-2.1)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The perioperative transfusion of 1 - 2 red blood cell units in patients undergoing heart surgery increases both hospital morbidity and the 30-day mortality rate, but does not increase long-term mortality."
          }
        ]
      },
