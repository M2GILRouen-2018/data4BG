      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 SIR. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To evaluate retrospectively the long-term outcomes of percutaneous transhepatic balloon angioplasty performed for portal vein stenosis (PVS) after pediatric living donor liver transplantation (LDLT)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "Between October 1997 and December 2013, of 527 pediatric patients (age < 18 y) who underwent LDLT in a single institution, 43 patients (19 boys, 24 girls; mean age, 4.1 y ± 4.1) were confirmed to have PVS at direct portography with or without manometry and underwent percutaneous interventions, including balloon angioplasty with or without stent placement. Technical success, clinical success, laboratory findings, manometry findings, patency rates, and major complications were evaluated. Follow-up periods after initial balloon angioplasty ranged from 5-169 months (mean, 119 mo)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Technical success was achieved in 65 of 66 sessions (98.5%) and in 42 of 43 patients (97.7%), and clinical success was achieved in 37 of 43 patients (86.0%). Platelet counts improved significantly. Of 32 patients undergoing manometry, 19 showed significant improvement of pressure gradient across the stenosis after percutaneous transhepatic balloon angioplasty. At 1, 3, 5, and 10 years after balloon angioplasty, the rates of primary patency were 83%, 78%, 76%, and 70%, and the rates of primary-assisted patency were 100%, 100%, 100%, and 96%. Two major complications subsequent to balloon angioplasty were noted: severe asthma attack and portal vein thrombosis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Percutaneous transhepatic balloon angioplasty is a safe and effective treatment with long-term patency for PVS after pediatric LDLT."
          }
        ]
      },
