      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "to explore the health-seeking behaviours of primiparous women with pelvic girdle pain persisting for more than three months post partum."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "a descriptive qualitative design involving face-to-face semi-structured interviews following institutional ethical approval. Transcripts were analysed using thematic analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "an urban hospital in Ireland."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "a purposive sample of 23 consenting first-time mothers with pelvic girdle pain persisting for at least three months post partum."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "'they didn't ask, I didn't tell' was a key theme, which included emerging categories of a perceived lack of follow-up post partum, and feeling ignored by healthcare professionals. The theme 'Seeking advice and support' describes women's role of talking to others, and triggers and barriers to getting help. 'Coping strategies' was the third theme emerging from the interviews, whereby participants described different strategies they used to deal with their symptoms, although many expressed uncertainty about what to do or who to see."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION AND IMPLICATIONS FOR PRACTICE",
            "content": "our findings show the importance of appropriate information and follow-up care for women with pelvic girdle pain and highlight barriers they encounter in seeking help. They also question the duration of postnatal care as participants felt that postnatal care was stopped too early. The findings may assist maternity care providers in addressing mothers' expectations and needs related to persistent pelvic girdle pain."
          }
        ]
      },
