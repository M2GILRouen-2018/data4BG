      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To examine the effects of low-amplitude, low frequency electromagnetic field therapy (EMF) therapy in patients with persistent chronic lower back pain associated with degenerative disc disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Double-blind, randomized and placebo controlled."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "EMF using a medical device resonator; control group underwent same procedures, except the device was turned off."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Pain reduction and mobility."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Improvements in overall physical health, social functioning and reduction in bodily pain were observed in the EMF group. The pain relief rating scale showed a higher level of pain relief at the target area in the EMF group. An increase in left lateral mobility was seen only in the EMF group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "EMF treatment may be of benefit to patients with chronic nonresponsive lower back pain associated with degenerative disc disease."
        }
      ]},
