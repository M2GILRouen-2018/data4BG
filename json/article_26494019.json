      "Abstract": {
        "CopyrightInformation": "© 2015, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "This review examines the impact of mobile app technology on obesity-related anthropometric, psychosocial, and behavioral outcomes in children and adolescents."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Nine research articles retrieved from a systematic review of the literature met criteria. Evidence is limited and mixed, but argues for an impact of mobile app use on motivation and goal-setting behavior, and supports further study of the impact on childhood obesity-related outcomes such as attitudes, perceptions, physical activity, and dietary habits."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Nurses can use this evidence to discuss potential benefits of health promotion mobile apps with parents, children, and adolescents to combat childhood obesity."
          }
        ]
      },
