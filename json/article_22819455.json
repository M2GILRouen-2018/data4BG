      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to evaluate 2 flap designs (envelope and modified triangular flap) for postoperative pain and swelling after mandibular impacted third molar surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Thirty patients who had symmetric bilateral fully impacted mandibular third molars were selected. Left teeth were approached with an envelope flap, and right teeth were removed using a modified triangular flap. Postoperative pain and swelling were evaluated until the seventh day by using 2 verbal rating scales."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Statistical analyses showed that there were no significant differences between the 2 incision techniques regarding postoperative pain and swelling (P > .05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "There is no significant difference between the envelope and modified triangular flap regarding postoperative pain and swelling after impacted third molar surgery."
          }
        ]
      },
