      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This investigation aimed to identify associated factors with dysphagia severity in amyotrophic lateral sclerosis (ALS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "We performed a cross-sectional study of 49 patients with ALS. All patients underwent fiberoptic endoscopy evaluation of swallowing and answered a verbal questionnaire about swallowing complaints. The patients were divided into groups according to dysphagia severity."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Among the factors analyzed, only odynophagia was associated with moderate or severe dysphagia."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Odynophagia was associated with moderate and severe dysphagia in ALS and suggests a high risk of pulmonary and nutritional complications."
        }
      ]},
