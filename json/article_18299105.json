      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND CONTEXT",
          "content": "Primary epitheliod hemangioendotheliomas of the lumbar spine are extremely rare tumors with an unpredictable clinical course."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To present a case of primary lumbar epithelioid hemangioendothelioma and its treatment protocol."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN/SETTING",
          "content": "A tertiary Spinal Unit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT SAMPLE",
          "content": "A previously healthy adult with persisting low back pain and neurologic deficit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The diagnosis was confirmed by core needle biopsy. The patient was treated with preoperative embolization followed by staged surgery which included wide tumor resection and spinal fixation, using a cage system and a titanium plate anteriorly and a transpedicular fixation system posteriorly."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Three years postoperatively the patient remains free of symptoms with no evidence of recurrence."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The treatment of these unpredictable tumors should be dictated by adherence to general oncologic principles."
        }
      ]},
