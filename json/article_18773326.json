      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Though racial disparities in asthma prevalence are well documented, little is known about the burden of asthma in American Indians compared to whites in the United States."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To compare the prevalence of asthma among American Indian and white adults 18 years of age and older in Montana."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We used Behavioral Risk Factor Surveillance System (BRFSS) data representative of the Montana population from 2001 to 2006."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Using multiple logistic regression analysis, American Indian race was not independently associated with increased asthma prevalence (OR 1.05, 95% CI 0.83-1.33). Obesity, lower household income and lower educational attainment, factors disproportionately affecting American Indians in Montana, were independently associated with increased asthma prevalence."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Regional and national surveillance is needed to comprehensively document asthma prevalence in American Indians and other underrepresented minorities in the United States."
        }
      ]},
