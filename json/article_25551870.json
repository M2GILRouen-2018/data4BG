      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Screening spirometry might help identify patients with chronic obstructive pulmonary disease (COPD) at an earlier stage. In this study, we evaluated the prevalence of airway obstruction in a cohort of asymptomatic smokers who underwent spirometry as part of a routine health maintenance examination."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The study cohort consisted of a consecutive sample of 386 asymptomatic smokers (≥5 pack-years) without a history of COPD or asthma, who completed spirometry testing as part of a routine health maintenance examination."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Overall, 9 study subjects (2.3%, 95% confidence interval: 1.1-4.4%) had evidence of airway obstruction on spirometry. Univariate and multiple regression analyses showed that the risk of airway obstruction was not significantly associated with age, sex, race, smoking history or past history of respiratory symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Spirometry screening of asymptomatic smokers may help detect a small number of patients with airway obstruction who are at high risk for COPD."
        }
      ]},
