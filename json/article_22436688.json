      "Abstract": {
        "CopyrightInformation": "© 2016 The Author(s).",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CONTEXT",
            "content": "Low back pain is reported by more than half of cyclists. The pathomechanics and association of risk factors of lumbar spine overuse injuries in cycling are not clearly understood."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether relationships exist between body positioning, spinal kinematics, and muscle activity in active cyclists with nontraumatic low back pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "In August of 2015 and April of 2016, a comprehensive search of the PubMed, CINAHL, Ovid MEDLINE, and Scopus databases was performed independently by 5 reviewers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY SELECTION",
            "content": "Included articles consisted of biomechanical studies examining factors relating to low back pain in cyclists as agreed upon by group consensus."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Systematic review."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "Level 4."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA EXTRACTION",
            "content": "Five reviewers appraised by consensus each article using the Downs and Black checklist."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Eight studies met criteria for this review. There is evidence that cyclists with lower handlebar heights displayed increased lumbosacral flexion angles during cycling. Core muscle activation imbalances, back extensor endurance deficits, and increased lumbar flexion while cycling were found to be present in cyclists with low back pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Spinal and core muscle activation imbalances in a prolonged flexed posture associated with cycling may lead to maladaptive spinal kinematics and increased spinal stresses contributing to overuse low back pain."
          }
        ]
      },
