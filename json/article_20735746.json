      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study examined depression, pain catastrophizing, psychosocial functioning, and physical and emotional health attributes for geriatric patients admitted to an interdisciplinary pain rehabilitation center compared with middle and younger age groups."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Quasi-experimental time series."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Interdisciplinary pain rehabilitation center at a tertiary referral medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "In total, 411 patients with chronic non-cancer pain completed the pain rehabilitation program from October 2004 to April 2006. Patients were divided into three groups based on age: older (ages 60+; n = 78); middle-age (ages 40-59; n = 230) and younger (ages 18-39; n = 141)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "A 3-week outpatient interdisciplinary pain rehabilitation program based on a cognitive-behavioral model that incorporates opioid withdrawal."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "The Multidimensional Pain Inventory (MPI), Short Form-36 Health Status Questionnaire (SF-36), Pain Catastrophizing Scale (PCS), and Center for Epidemiological Studies-Depression Scale (CES-D) were administered at admission, discharge, and 6 months following treatment. The frequency of patients using opioids, nonsteroidal anti-inflammatory drugs (NSAIDs), and benzodiazepines at each assessment point were compared."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Older patients reported reduced depression, catastrophizing, pain severity, and pain interference (P < 0.001) at discharge and 6 months follow-up. Older patients also reported increased perceived control, and physical and social functioning at discharge and follow-up (P < 0.001). Improvement in older patients was comparable in magnitude to that of middle-age patients on all variables, whereas younger patients exhibited greater improvement on four variables. Significant reductions in analgesic use were observed in all groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Interdisciplinary pain rehabilitation incorporating opioid withdrawal can improve long-term psychological, social and physical functioning for geriatric chronic pain patients."
          }
        ]
      },
