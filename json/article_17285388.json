      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Surgical Associates Ltd. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Disorders of the oesophagus have been linked to surgical bariatric procedures and obesity. However the relationship between achalasia and gastric bypass is not clearly understood and has only recently been reported following gastric bypass."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PRESENTATION OF CASE",
            "content": "We present the case of a 53-year-old woman who re-presented following a gastric bypass with a new diagnosis of achalasia. This was treated successfully with laparoscopic Heller's Myotomy with discharge from hospital 10 days post operatively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "It is not clear whether achalasia is a complication of gastric bypass procedures. This is only the second reported case of the condition developing after this operation. The mechanism by which it may develop is yet to be clearly established."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This case highlights the need to investigate further a possible link between achalasia and gastric bypass and to manage susceptible patients accordingly in the pre-operative stage."
          }
        ]
      },
