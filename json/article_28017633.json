      "Abstract": {
        "CopyrightInformation": "Copyright © 2016. Published by Elsevier Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Obesity is frequently characterized by chronic inflammation and insulin resistance (IR). Obesity-associated inflammation is responsible for the complement system activation of which the third component (C3) plays the central role."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "to discuss several aspects of the central component of the complement system in relation to obesity and obesity-associated IR."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A critical review of the relevant published English articles from 2003- 2014 was carried out using several search engines including PubMed, Google Scholar, and ScienceDirect. Keywords were used, including complement system, C3, obesity-induced inflammation, IR, ASP, and adipose tissue."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The defect in the adipose tissue secretory function during obesity may result in different metabolic disorders including IR. The C3 role during obesity-associated inflammation in IR is emerging. More longitudinal studies are warranted to evaluate the role of C3 among other pro-inflammatory biomarkers for IR."
          }
        ]
      },
