      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To measure the effect of behaviourally oriented counselling in general practice on healthy behaviour and biological risk factors in patients at increased risk of coronary heart disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cluster randomised controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "883 men and women selected for the presence of one or more modifiable risk factors: regular cigarette smoking, high serum cholesterol concentration (6.5-9.0 mmol/l), and high body mass index (25-35) combined with low physical activity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Brief behavioural counselling, on the basis of the stage of change model, carried out by practice nurses to reduce smoking and dietary fat intake and to increase regular physical activity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Questionnaire measures of diet, exercise, and smoking habits, and blood pressure, serum total cholesterol concentration, weight, body mass index, and smoking cessation (with biochemical validation) at 4 and 12 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Favourable differences were recorded in the intervention group for dietary fat intake, regular exercise, and cigarettes smoked per day at 4 and 12 months. Systolic blood pressure was reduced to a greater extent in the intervention group at 4 but not at 12 months. No differences were found between groups in changes in total serum cholesterol concentration, weight, body mass index, diastolic pressure, or smoking cessation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Brief behavioural counselling by practice nurses led to improvements in healthy behaviour. More extended counselling to help patients sustain and build on behaviour changes may be required before differences in biological risk factors emerge."
        }
      ]},
