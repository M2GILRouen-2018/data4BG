      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Pancreatic enzyme therapy is widely used in the treatment of pain in chronic pancreatitis. The aim of our study was to perform a meta-analysis to determine whether pancreatic enzyme supplementation significantly decreases abdominal pain in patients with chronic pancreatitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "From a MEDLINE search, we identified, evaluated, and subjected to a meta-analysis, six randomized, double-blind, placebo-controlled trials. Important features of data extraction included the method of subject inclusion, definition of disease, enzyme preparation, response to pancreatic enzyme therapy versus placebo, and modality for measuring response."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In the meta-analysis, the pooled estimate of the percentage of patients per study who preferred enzymes relative to placebo was 52% (95% confidence interval, 45-60%). A test of homogeneity indicated that there was no statistically significant heterogeneity across studies in the percentage of patients preferring enzymes."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Statistical analysis demonstrates no significant benefit of supplemental pancreatic enzyme therapy to relieve pain associated with chronic pancreatitis."
        }
      ]},
