      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Atherosclerosis affects large and medium caliber arteries by forming calcific atheromas, precursors of cerebral vascular disease. Diabetes mellitus, obesity, and hypertension are considered as risk factors of atherosclerosis. Panoramic radiographs can display images suggestive of carotid artery calcifications (CACs)."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "To investigate the prevalence of images suggestive of CAC in panoramic radiographs of the jaws (PRJs) and confirm them by Doppler ultrasonography. To evaluate their anatomic locations and relationships between systemic conditions (diabetes, hypertension, and obesity) and the presence of unilateral or bilateral CAC detected on PRJ or by Doppler ultrasonography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Of the 723 routinely performed PRJ in patients over 40 years at the Radiology Center in São Luís, Maranhão, Brazil, 21 PRJ containing images suggestive of CAC were selected in this cross-sectional study. The findings from the PRJ were confirmed by Doppler sonography."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Images suggestive of CAC was detected in 21 (2.9%) of the PRJ evaluated, consisting of 11 (52.4%) hypertensive, 7 (33.3%) diabetics, and 9 (42.9%) obese. There was a higher prevalence of hypertensive patients in the unilateral CAC group (100%) and bilateral CAC (60%) compared to patients without CAC (25%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "CACs can be detected in PRJs, and are more frequent in common carotid arteries. No significant associations were detected between the presence of unilateral or bilateral CAC in PRJ and hypertension, diabetes, or obesity."
        }
      ]},
