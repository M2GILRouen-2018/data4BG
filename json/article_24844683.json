      "Abstract": {
        "CopyrightInformation": "©2014 Foundation Acta Paediatrica. Published by John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "Label": "UNLABELLED",
            "content": "A literature review was carried out following concerns about the use of heated, humidified, high-flow nasal cannulae (HHFNC) in premature infants. Randomised trials following extubation showed that HHFNC was associated with similar or greater reintubation rates than nasal continuous positive airway pressure, but significantly better nasal trauma scores. Infections with Ralstonia bacteria were an issue."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "There is insufficient evidence to support the routine use of HHFNC for premature infants and further research is required."
          }
        ]
      },
