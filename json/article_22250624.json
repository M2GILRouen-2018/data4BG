      "Abstract": {
        "CopyrightInformation": "© 2012 The International Society of Dermatology.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Mesotherapy or intradermotherapy is used as a cosmetic procedure for many purposes, among them for cellulite."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We report a case of oleoma on the thighs and buttocks that appeared two years after the injection of an unknown substance for improvement of cellulite."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Lesions and associated pruritus resolved with colchicine, leaving depressed scars."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Serious and peer-reviewed investigations must be performed to certify the efficacy and safety of this procedure."
          }
        ]
      },
