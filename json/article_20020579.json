      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Homocysteine, fibrinogen and antibodies to oxidised LDL were shown to be important markers of atherosclerosis in adults."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To investigate the levels of these three risk factors in prepubertal obese children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Fasting homocysteine, fibrinogen and antibodies to oxidised LDL, plasma lipids, insulin, HbA1c and blood glucose levels were investigated in 30 prepubertal obese and 28 control children 6-9 years old. Investigations in the obese group were repeated after an oral glucose tolerance test."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Fasting fibrinogen levels of the obese children were found to be significantly higher than those in the controls. Anti-ox-LDL antibody levels increased significantly after an oral glucose tolerance test."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Fasting fibrinogen and postload ox-LDL levels which could act as important markers of coronary heart disease in later life could also be important risk factors in prepubertal obese children."
        }
      ]},
