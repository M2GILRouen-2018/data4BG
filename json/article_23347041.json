      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© Health Research and Educational Trust.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To outline a methodology for allocating graduate medical education (GME) training positions based on data from a workforce projection model."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "Demand for visits is derived from the Medical Expenditure Panel Survey and Census data. Physician supply, retirements, and geographic mobility are estimated using concatenated AMA Masterfiles and ABMS certification data. The number and specialization behaviors of residents are derived from the AAMC's GMETrack survey."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "We show how the methodology could be used to allocate 3,000 new GME slots over 5 years-15,000 total positions-by state and specialty to address workforce shortages in 2026."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "EXTRACTION METHODS",
            "content": "We use the model to identify shortages for 19 types of health care services provided by 35 specialties in 50 states."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "PRINCIPAL FINDINGS",
            "content": "The new GME slots are allocated to nearly all specialties, but nine states and the District of Columbia do not receive any new positions."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This analysis illustrates an objective, evidence-based methodology for allocating GME positions that could be used as the starting point for discussions about GME expansion or redistribution."
          }
        ]
      },
