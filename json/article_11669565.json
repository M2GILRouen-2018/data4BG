      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To identify important factors that can influence patient compliance with prescribed medication and to elucidate aspects of asthma care from the patient's point of view."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Field investigation; the interviewer used a semi-structured questionnaire."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Patients with asthma in primary health care settings in Sweden."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY PARTICIPANTS",
          "content": "A sample of 77 patients was randomly selected from 11 primary health care centres in southern Sweden; 63 of these patients participated in the study."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The factors of importance for self-reported compliance with prescribed medication were age, gender, duration of the disease, the attitude of the staff and information/education about asthma. The patients expressed important aspects of care, and these are in accordance with how an asthma nurse practice functions in Sweden."
        }
      ]},
