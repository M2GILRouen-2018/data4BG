      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We report a rare case of extensive spinal epidural abscess in a patient with diabetes."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Spinal epidural abscess is a very uncommon infection that requires prompt recognition and proper management to avoid potentially disastrous complications. This lesion can expand to compress the spinal cord causing severe symptoms and complications."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Combination of the patient clinical history, physical examination, laboratory results, radiologic and intraoperative findings along with brief related literature review."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "We present a rare case of spinal epidural abscess extending to the entire length of the spinal cord in a previously undiagnosed patient with diabetes."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Diabetes is an important condition that can predispose an individual to the development of localized or extensive spinal epidural abscess."
        }
      ]},
