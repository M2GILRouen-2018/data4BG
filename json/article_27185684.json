      "Abstract": {
        "CopyrightInformation": "Copyright © 2016. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To investigate whether these properties of reinforced tubes cause difference in insertion depth compared to standard polyvinyl chloride tracheal tubes."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A randomized controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Operation room."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS",
            "content": "Standard polyvinyl chloride tracheal tubes, reinforced tubes."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Seventy-six adult patients undergoing surgery under general anesthesia were randomly allocated with standard tube (n=38) or reinforced tube (n=38) intubation. The endotracheal tube was fixed at the right canine with a predetermined insertion depth using the formula: endotracheal tube insertion length (cm)=0.1977 × [body height (cm)] - 12.7423."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "The distances between the tracheal tube tip and the carina using fiberoptic bronchoscope."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "The mean tip-to-carina distance of reinforced tube was about 1.2cm longer than that of standard tube (P<.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The insertion depth of straight reinforced tracheal tubes can be shorter than that of standard polyvinyl chloride tracheal tubes due to different tube pathways in the upper airway."
          }
        ]
      },
