      "Abstract": {
        "CopyrightInformation": "© 2017 British Small Animal Veterinary Association.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To reveal the relationship between canine corticosteroid-induced alkaline phosphatase isoenzyme activity and hepatobiliary diseases."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "Retrospective analysis of the relationship between serum corticosteroid-induced alkaline phosphatase activity and diagnosis, serum cortisol concentration and alanine transferase activity in dogs with hepatobiliary diseases. Dogs with a history of glucocorticoid administration were excluded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Seventy-two dogs with hepatobiliary diseases were analysed. The serum corticosteroid-induced alkaline phosphatase concentration was increased in dogs with hepatobiliary diseases. There was no correlation between serum cortisol concentration and serum corticosteroid-induced alkaline phosphatase percentage or activity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL SIGNIFICANCE",
            "content": "Dogs with hepatobiliary disease can exhibit high serum alkaline phosphatase activity even if the dogs have not been administrated glucocorticoids and the serum cortisol concentration is normal."
          }
        ]
      },
