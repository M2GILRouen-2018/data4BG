      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Omalizumab, a monoclonal antibody to IgE, is a possible treatment for severe, uncontrolled allergic asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "A severe asthmatic patient with renal insufficiency and on dialysis was awaiting transplantation. The asthma was uncontrolled with poor respiratory function. He received anti IgE treatment with omazilumab with immediate clinical improvement and his renal transplant was performed satisfactorily."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Anti-IgE treatment can improve severe, uncontrolled allergic asthmatic patients allowing, in this case, transplantation without further respiratory problems."
        }
      ]},
