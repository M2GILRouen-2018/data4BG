      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The objective of the International Guide on Diagnosis and Treatment of Asthma is to reduce prevalence, mortality and morbidity of asthma."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To demonstrate that implementation of educational workshop increases the knowledge of first contact physicians on the International Guide for Diagnosis and Treatment of Asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Fifty-nine first contact physicians participated. A validated questionnaire was applied before and after the workshop on the International Guide on Diagnosis and Treatment of Asthma. The Student's t test of the program SPSS was used for a statistical analysis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The grades obtained were 36% of correct answers before the workshop and 59% of correct answers after the workshop with a significant p < 0.05 specially in the general area of knowledge."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "As an educational technique this workshop improves the level of knowledge on the International Guide on Diagnosis and Treatment of Asthma of first contact physicians."
        }
      ]},
