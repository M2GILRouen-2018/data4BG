      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 AAGL. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To investigate the feasibility and acceptability of office hysteroscopic polypectomy using a novel continuous-flow operative 16F mini-resectoscope."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Multicenter prospective case series (Canadian Task Force classification III)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "\"SS Antonio e Biagio\" Hospital, Alessandria, and University \"Federico II\" of Naples."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "One hundred eighty-two patients with endometrial polyps."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Hysteroscopic polypectomy performed with 16F mini-resectoscope in an office setting, without analgesia and/or anesthesia."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "Polypectomy was successfully performed in 175 patients in a single surgical step (96.15%), with only 1 patient (.54%) requiring a second office surgical step to complete the surgery. Seven patients (3.84%) were excluded from the analysis of operative parameters because of severe pelvic pain during the office procedure, which required a second inpatient surgical step. No major complications were recorded."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Our findings demonstrate that removal of endometrial polyps using the 16F mini-resectoscope in an office setting is a feasible and safe surgical option. Outpatient see-and-treat polypectomy is an acceptable and effective alternative to inpatient resectoscopic polypectomy."
          }
        ]
      },
