      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To develop and content validate the Neonatal Eating Assessment Tool (NeoEAT), a parent-report measure of infant feeding."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "The NeoEAT was developed in three phases. Phase 1: Items were generated from a literature review, available assessment tools, and parents' descriptions of problematic feeding in infants.Phase 2: Professionals rated items for relevance and clarity. Content validity indices were calculated. Phase 3: Parent understanding was explored through cognitive interviews."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "Phase 1: Descriptions of infant feeding were obtained from 12 parents of children with diagnosed feeding problems and 29 parents of infants younger than seven months. Phase 2: Nine professionals rated items. Phase 3: Sixteen parents of infants younger than seven months completed the cognitive interview."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME VARIABLE",
          "content": "Content validity of the NeoEAT."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Three versions were developed: NeoEAT Breastfeeding (72 items), NeoEAT Bottle Feeding (74 items), and NeoEAT Breastfeeding and Bottle Feeding (89 items)."
        }
      ]},
