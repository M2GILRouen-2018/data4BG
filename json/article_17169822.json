      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To assess misclassification in adults reporting childhood asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The Tasmanian Asthma Survey commenced in 1968 when 8,583 7-year-old children attending school in Tasmania (participants) were studied. In 1991-1993, a stratified sample of 1,494 participants was studied. Their recall of childhood asthma was compared to their parents' prospectively gathered report."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Where participants had childhood asthma, those with current asthma, severe eczema, or hay fever were less likely to misclassify while females were more likely to misclassify. Where participants had no childhood asthma, misclassification was associated with current asthma, hay fever, or allergies."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Retrospective self-assessment of childhood asthma is unreliable."
        }
      ]},
