      "Abstract": {
        "CopyrightInformation": "Copyright 2002 Elsevier Science B.V.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Patients who undergo successful percutaneous transluminal coronary angioplasty (PTCA) may subsequently require operative myocardial revascularization. This review examines whether prior successful PTCA alters outcomes following subsequent coronary artery bypass grafting (CABG). The costs of interventional cardiology procedures and definitive surgery were also examined."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "From January 1981 through December 1997, 361 patients underwent CABG following initially successful PTCA (interval group). This group was compared with 11,909 patients who underwent CABG as the primary intervention for coronary artery disease (control group)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The average time interval to CABG following initial PTCA was 13.7 months. The post-CABG myocardial infarction rate was 4% for patients in the interval group and 3% for patients in the control group. The 30-day mortality was similar for both patient groups (2%). For the interval group, the average cost of total interventional management was 24,220 dollars per patient. This included average costs of 13,873 dollars for CABG and 10,347 dollars for all preoperative interventional cardiology procedures."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "There is little doubt that PTCA procedures may provide successful myocardial revascularization. However, these procedures often need to be repeated over time and may serve only to delay coronary surgery, at substantial financial and personal cost."
          }
        ]
      },
