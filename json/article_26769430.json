      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Leptin is produced in white adipose tissue, but also in human coronary atherosclerotic lesions."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of this study is to assess the prognostic value of leptin in patients with proven coronary artery disease (CAD) (N\u2009=\u20091907)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "AtheroGene is a contemporary CAD cohort study (N\u2009=\u20093229). Median follow-up time was 3.8 (Quartile 1/3 with 2.8/4.9) years."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Leptin concentration was associated with a hazard ratio (HR) for the fully adjusted model of HR\u2009=\u20091.32 in women but was not significant in men. The endpoint cardiovascular death and non-fatal myocardial infarction was observed in 167 patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In women with known CAD, increased leptin concentration is useful for predicting cardiovascular death and non-fatal myocardial infarction."
        }
      ]},
