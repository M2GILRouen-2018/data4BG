      "Abstract": {
        "CopyrightInformation": "Copyright 2009 The Canadian Society of Clinical Chemists. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine if a cytokine panel could be informative regarding subsequent heart failure(HF)/death."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "In 216 subjects presenting with chest pain to an emergency department in 1996, EDTA plasma (-70 degrees C) was thawed for IL-6, MCP-1, IL-10, VEGF, EGF measurement."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Subjects with any three cytokines elevated were at higher risk for HF/death compared to those with < or = two cytokines elevated."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "A cytokine panel might be useful for risk stratification for HF/death."
          }
        ]
      },
