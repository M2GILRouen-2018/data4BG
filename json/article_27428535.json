      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Dry needling (DN) is reported to decrease pain and improve functional movements yet the mechanisms remain unclear. Changes in muscle tone and other mechanical properties after DN could contribute to these findings but have not been investigated."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Examine EMG and passive mechanical properties of the quadriceps muscle before and after DN."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "EMG, MyotonPro and clinical measurements were taken pre and post DN."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Rehabilitation department at Aspetar Sports Medicine Hospital, Qatar."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "20 subjects reporting pain and quadriceps muscle tension."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Pain (VAS, measured during a single leg step down), knee flexion range, and passive mechanical properties of the superficial quadriceps were measured using the MyotonPro device."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pain decreased (p < 0.01) and ROM increased in flexion (p < 0.001). EMG activity (RMS) was decreased at rest in the Vastus Lateralis (VL (p < 0.05, ES = 0.22). All other sEMG parameters were not significantly different (all p > 0.11, ES = 0.13). Passive mechanical properties were not significantly different in rectus femoris (RF) and VL. Decrement and Resistance of the Vastus Medialis (VM) were significantly decreased (p<0.05, ES>0.19)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "DN resulted in small reductions in: pain, resting activation (EMG of VL), decrement and resistance (of VM)."
          }
        ]
      },
