        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Patients' underlying medical conditions might affect the presentation and progression of an eating disorder."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE",
            "content": "We describe a patient with an undiagnosed, rare, genetic skeletal dysplasia with effects on body mass index that likely led to body image distortion and delayed the diagnosis of an eating disorder."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "SUMMARY AND CONCLUSION",
            "content": "It is critical to fully assess disordered eating in the context of each patient's clinical status."
          }
        ]
      },
