      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS AND OBJECTIVES",
            "content": "To investigate the effect of preoperative bowel preparation for patients undergoing spinal fusion surgery."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Bowel preparation before major surgery is performed routinely to reduce the risk of postoperative complications related to gastrointestinal function."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A randomised clinical trial was performed that included forty-five elective spinal fusion patients allocated to one control group and two treatment groups. The patients received preoperative bowel preparation with enema, suppository or no bowel preparation. The outcome measures were defecation within 72 hours postoperatively, defecation on the fifth postoperative day, postoperative constipation, nausea, pain, well-being and ambulation."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There were significant differences in favour of no bowel preparation compared with suppository group for the primary outcome; days to first defecation. There was a tendency for the patients who received no bowel preparation to recover from constipation more quickly than patients in the bowel preparation groups. The majority of patients did not defecate until the fourth postoperative day."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This randomised study found no benefit from bowel preparation before major spine surgery on gastrointestinal function. The use of bowel preparation is not evidence-based and not performing it should be considered before major spine surgery until the effect is known."
          }
        ]
      },
