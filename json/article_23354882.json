      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report the results of computed tomography (CT)-guided percutaneous resection of the nidus in 18 cases of osteoid osteoma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "The medical records of 18 cases of osteoid osteoma in children, adolescents and young adults, who underwent CT-guided removal of the nidus between November, 2004 and March, 2009 were reviewed retrospectively for demographic data, lesion site, clinical outcome and complications after procedure."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Clinical follow-up was available for all cases at a median of 29 months (range 6-60 months). No persistence of pre-procedural pain was noted on 17 patients. Only one patient experienced recurrence of symptoms 12 months after percutaneous resection, and was successfully retreated by the same technique, resulting in a secondary success rate of 18/18 (100%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "CT-guided removal or destruction of the nidus is a safe and effective alternative to surgical resection of the osteoid osteoma nidus."
        }
      ]},
