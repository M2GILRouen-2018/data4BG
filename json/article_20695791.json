      "Abstract": {
        "CopyrightInformation": "© 2013 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To analyze the concept of prenatal obesity within a psychoneuroimmunology framework."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "By considering the psychosocial, neurological, endocrine, and immunological contributions, a psychoneuroimmunology framework maintains a holistic focus. Identifying the multidirectional mechanisms linking these systems will provide valuable insight into the mechanisms by which prenatal obesity increases the rate of adverse pregnancy outcomes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Utilization of the concept of prenatal obesity within a psychoneuroimmunology framework will facilitate multidisciplinary research to identify underlying mechanisms by which prenatal obesity leads to adverse pregnancy outcomes, as well as the development of interventions to treat obesity before, during, and after pregnancy."
          }
        ]
      },
