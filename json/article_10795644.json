      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Many allergy patients complain of slowed thinking, memory problems, and difficulty sustaining attention during their allergy seasons."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study evaluated the effect of symptomatic allergic rhinitis on speed of cognitive processing, ability to divide and sustain attention, working memory, and recent verbal memory."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Symptomatic ragweed-allergic rhinitis patients and nonatopic control subjects did cognitive testing in, out of, and in ragweed seasons."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Test results indicate that, during ragweed seasons, allergic patients experience subtle slowed speed of cognitive processing but not deficits in attention and recent memory. Some patients also have difficulties in working memory."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These findings suggest that having allergic reactions to ragweed pollen causes significant cognitive difficulties in a subgroup of patients."
        }
      ]},
