      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2015.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The primary aim of this study was to determine the prevalence of neuropathic pain (NP) in patients with cancer receiving palliative care."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In this prospective observational study, terminally ill patients with cancer having NP were identified by a pain management clinician using the diagnostic algorithm of NP from the International Association for the Study of Pain on the day of admission."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 220 patients who were hospitalized in the palliative care unit were enrolled in this study. The median survival times were 21.5 days (range, 0-173 days), and 57.7% of patients were male. Among the 220 patients, 41 (18.6%; 95% confidence interval, 13.5%-23.8%) developed NP."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The prevalence of NP in terminally ill patients with cancer in Japanese palliative care units was 18.6%."
          }
        ]
      },
