      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effectiveness of tramadol hydrochloride for the treatment of chronic pain refractory to previous treatment in two pediatric patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Tramadol hydrochloride was administered (50 mg/day to 150 mg/day) to two siblings with Ehlers-Danlos syndrome - Hypermobility type refractory to previous pharmacological treatments, and changes in pain intensity and physical activity were assessed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pain intensity decreased and physical activity improved within days of starting therapy. Positive results have been maintained for 30 months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Tramadol hydrochloride was a safe and effective treatment for relieving chronic pain in two pediatric patients suffering from the hypermobility type of Ehlers-Danlos syndrome. No morbidity or side effects were noted during the 30-month follow-up."
        }
      ]},
