      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We report an extremely rare case of maxillary haemangioma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Case report and review of the literature concerning haemangioma arising from the nasal cavity and paranasal sinuses."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Maxillary haemangioma is rare and sometimes requires wider resection than nasal haemangioma if a large tumour is found. We present a case of maxillary haemangioma in a 37-year-old Japanese woman, which was completely resected by pre-operative embolisation and endoscopic sinus surgery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Our findings suggest that if a large maxillary haemangioma is diagnosed pre-operatively, the treatment of choice is pre-operative embolisation followed by endoscopic sinus surgery, in order to avoid the surgical complications associated with wide resection."
        }
      ]},
