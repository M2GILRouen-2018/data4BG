      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Several bacterial and viral infections are listed as triggering factors for Kawasaki disease; association with dengue fever is rare."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "CASE CHARACTERISTICS",
          "content": "A 5-year-old girl who presented with fever that was confirmed to be dengue fever, and subsequently improved, except that the fever persisted. She fulfilled diagnostic criteria for Kawasaki disease on day 7 of fever."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "OUTCOME",
          "content": "Child responded satisfactorily to intravenous immunoglobulin administration."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "MESSAGE",
          "content": "Kawasaki disease should be kept as one of the probabilities in a case of dengue if fever persists beyond the expected duration."
        }
      ]},
