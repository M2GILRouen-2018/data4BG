      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Published by Elsevier Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Past studies have shown that U.S. Veterans are consumers of CAM. However, more than 75% of Veteran non-users report they would utilize these treatment options if made available. Thus, Veterans may not be fully aware of the CAM options currently available to them in the current U.S. VA health care system."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The current study tested the hypothesis that Veterans would report an increase in CAM utilization after completing a formal pain education program in a VA medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "The study used a quasi-experimental, one-group, pre/post-test design."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Midwestern, U.S. VA Medical Center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "The responses from 103 Veterans who elected to participate in the program and the assessment measures were included in the outcome analyses."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "\"Pain Education School\" is a 12-week, educational program that is open to all Veterans and their families. It is a comprehensive program that introduces patients to 23 different disciplines at the VA Medical Center that deal with chronic, non-cancer pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "An adaptation of the Complementary and Alternative Medicine Questionnaire(©), SECTION A: Use of Alternative Health Care Providers."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was a significant difference found in overall utilization of CAM after completing the pain education program. The most utilized CAM modality was the chiropractor; the least utilized were hypnosis and aromatherapy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Not all health care systems or providers may have access to an education-focused, professionally driven program as an amenity. However, lessons can be learned from this study in terms of what pain providers may be able to accomplish in their practice."
          }
        ]
      },
