      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study aimed to clarify whether painful annular fissures stimulated during provocation diskography are the likely source of diskogenic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A retrospective analysis was conducted of prospectively collected data."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Multidisciplinary, academic spine center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "The study was completed in a cohort of 28 consecutive patients were enrolled presenting with 6 months duration of axial low-back pain recalcitrant to physical therapy, oral analgesics, and epidural steroid injections and who have diskogenic pain based on history, exam, magnetic resonance imaging, and diskography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Subjects underwent provocation diskography and analgesic diskography utilizing a balloon-tipped intradiskal catheter allowing intradiskal injection of anesthetic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Visual analog scale, finger-to-floor distance were utilized as outcome measures."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "80% of painful intervertebral disks as detected by provocation diskography were sufficiently anesthetized resulting in >50% reduction in low-back pain during analgesic diskography."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Diskogenic pain is in varying degrees caused by the sensitized nociocepters within annular tears."
        }
      ]},
