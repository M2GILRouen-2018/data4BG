      "Abstract": {
        "CopyrightInformation": "© 2013, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study aimed to compare the safety and efficacy of everolimus-eluting stents (EES) to first-generation drug-eluting stents (DES) in multivessel disease (MVD)."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Second-generation EES have demonstrated superiority over first-generation DES for single-vessel disease, although the merits of EES in MVD are less established."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A cohort of 1,285 patients (3,124 lesions) with ≥ 2 diseased vessels were treated with either first-generation DES (n\u2009=\u20091,002) or EES (n\u2009=\u2009283). The rates of death, myocardial infarction, target lesion revascularization, target vessel revascularization, definite stent thrombosis, and major adverse cardiac events (MACE), defined as the combined incidence of target vessel revascularization, death, and non-fatal myocardial infarction, were compared at 1 year."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Baseline characteristics were similar except for a lower left ventricular ejection fraction and a lower incidence of stable angina pectoris in the first-generation DES group (P\u2009=\u20090.001 and 0.013, respectively). At 1 year, the MACE rate was lower in the EES group (9.5P% vs. 15.7%; P\u2009=\u20090.01). Multivariable analysis demonstrated that EES use predicted a higher chance of freedom from MACE at 1 year (hazard ratio 0.58 [0.38-0.87]; P\u2009=\u20090.009; 95% confidence interval)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The use of EES in patients with MVD is safe with signals for improved effectiveness compared to first-generation DES. Randomized trials comparing new-generation DES to coronary artery bypass grafting surgery are warranted."
          }
        ]
      },
