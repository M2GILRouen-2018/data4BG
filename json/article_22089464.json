      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We evaluated the influence of demographic and clinical factors on pain thresholds in patients with rheumatoid arthritis (RA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A cross-sectional observational study (105 patients with RA) assessed pain thresholds using an algometer. Regression analysis examined the influence of demographic and clinical assessments."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pain thresholds (median 289, interquartile range 89-434) correlated with assessments of disease activity (tender joint counts), disability (Health Assessment Questionnaire), fatigue, depression, and anxiety. Ordinal logistic regression showed tender point counts and disease duration were the dominant contributors."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "These findings suggest that low pain thresholds reflect \"fibromyalgic\" RA (many tender points) and central pain sensitization with prolonged disease duration."
        }
      ]},
