      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Agenesis of the dorsal pancreas is a rare entity and might present with various symptoms. We report a case which presented with chronic pancreatitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "The patient presented with epigastric pain and we found dorsal pancreatic agenesis causing chronic pancreatitis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Dorsal pancreatic agenesis can be easily diagnosed with new techniques and its association with clinical syndromes can be better understood."
        }
      ]},
