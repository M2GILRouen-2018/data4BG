      "Abstract": {
        "CopyrightInformation": "© Georg Thieme Verlag KG Stuttgart · New York.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "HISTORY AND ADMISSION FINDINGS",
            "content": "In a 66-year-old obese woman (WHO stage III, BMI 51\u2005kg/m2) pronounced osteoarthritis of the right knee was diagnosed. Because of progressive chronic pain of the right knee joint her walking distance was limited to a few meters. Conservative therapy was exhausted."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INVESTIGATIONS",
            "content": "Clinical examination showed a restricted and painful range of motion of the right knee and distinctive obeseness on the trunk and the extremities including a lipedema/lymphedema."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "TREATMENT AND COURSE",
            "content": "After a complicated course of treatment lasting for 220 days the total knee replacement ended in an arthrodesis combined with a gastrocnemius muscle flap."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "With respect to this case the high complication-rates in obese patients should be taken into account: Total knee replacement can even lead to loss of the limb in the worst case. In addition to extended preoperative examination this indication should be critically scrutinized."
          }
        ]
      },
