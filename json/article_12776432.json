      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study Cordyceps (artificial fermented Cordyceps sinensis(Berk.) Sacc) powderin the treatment of asthma in the animal models."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Pulmonary function and airway inflammation in vivo were investigated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "Cordyceps, 5g.kg-1(ig), significantly inhibited bronchial challenge of ovalbumin-induced change of RL and Cdyn (P < 0.05) and inhibited antigen-induced increase of eosinophils in the BALF of rats (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The results suggested cordyceps could be applied for the prevention and cure of asthma."
        }
      ]},
