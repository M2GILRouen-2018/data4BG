      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To evaluate the quality-of-life outcomes in osteoradionecrosis patients undergoing primary mandible reconstruction with free fibula flap, and to analyze the association between quality of life and demographic and medical characteristics of osteoradionecrosis patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Quality-of-life outcomes of 15 patients after primary mandible reconstruction with free fibula flap for osteoradionecrosis were assessed using a modified University of Washington Quality of Life Questionnaire, version 4."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The best-scoring domain was pain, whereas the lowest scores occurred in chewing, swallowing, speech, and saliva. More than 70% of patients perceived improved health-related quality of life after reconstruction. Men scored significantly higher than women in speech domain, recreation domain, activity domain, and \"social function.\" The time elapsed from radiotherapy was significantly and negatively correlated with the score of speech, recreation, and global question."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Mandible reconstruction with fibula flap effectively eliminates pain and controls local infection even though radiotherapy-induced complications still influence the quality of life of osteoradionecrosis patients."
        }
      ]},
