      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To determine whether prilocaine is a more comfortable local infiltration anaesthetic agent than the more widely used lignocaine for minor eyelid procedures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A prospective randomised study was undertaken to compare the discomfort between local infiltration of plain 2% prilocaine versus its equivalent, plain 2% lignocaine. One hundred and twenty-five patients were recruited. Pain was assessed subjectively using a visual analogue pain score, graded from 0 to 10."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The mean pain score for the prilocaine group was 1.82 compared with 3.19 for the lignocaine group. Using the Mann-Whitney U-test for significance, U = 1236.5; p < 0.001."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Prilocaine is a more comfortable local infiltration anaesthetic agent than lignocaine when used for minor eyelid procedures."
        }
      ]},
