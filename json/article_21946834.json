      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of the study was to determine the long-term efficacy of the tricyclic antidepressant (TCA) drugs amitriptyline or imipramine in treating functional gastrointestinal disorders (FGIDs) in pediatric patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "A retrospective chart review of children with a diagnosis of irritable bowel syndrome, functional dyspepsia, and functional abdominal pain diagnosed on the basis of the Rome III criteria was performed. Charts were analyzed for response to the medication and the duration of the response."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 98 patients took a TCA for an FGID. Of the 98 patients, 77 patients (78.6%) responded to the treatment for an average of 10.73 (range 1-45) months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "TCAs are effective in treating FGIDs in pediatric patients for a long duration."
        }
      ]},
