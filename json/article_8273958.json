      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To determine the effects of standard spinal immobilization on a group of healthy volunteers with respect to induced pain and discomfort."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "TYPE OF PARTICIPANTS",
          "content": "Twenty-one healthy volunteers with no history of back disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Subjects were placed in standard backboard immobilization for a 30-minute period. Number and severity of immediate and delayed symptoms were determined."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "One hundred percent of subjects developed pain within the immediate observation period. Occipital headache and sacral, lumbar, and mandibular pain were the most frequent symptoms. Fifty-five percent of subjects graded their symptoms as moderate to severe. Twenty-nine percent of subjects developed additional symptoms over the next 48 hours."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Standard spinal immobilization may be a cause of pain in an otherwise healthy subject."
        }
      ]},
