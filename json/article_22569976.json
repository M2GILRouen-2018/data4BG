      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Minimally invasive techniques were associated with bariatric surgery, leading to a decrease in aggression to the organs and systems. Robotic surgery is a new possibility within the concept of minimal invasion."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To evaluate the initial experience of robotic surgery for obesity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Twenty seven patients were operated in the same hospital, by the same team with the same surgical system, Da Vinci S."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Were performed six gastric band placement , five sleeve gastrectomies and 16 gastric bypasses. There was one major complication and no death in this series."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The robotic surgery for obesity surgery was safe during the initial experience."
        }
      ]},
