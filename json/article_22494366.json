      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The objective of this study was to gain a basic understanding of the influential factors for nonspecific low-back pain (LBP) among adolescents of southern China."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "The study was designed as a school-based case control study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Nonspecific LBP is a common health problem in adolescence. Although some behaviors and socio-demographic factors are believed to contribute to the disorder, influential factors of LBP remain undefined. Moreover, until now there is no available information of influential factors for LBP in Chinese adolescents."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "A total of 1,214 adolescents were involved in the study, including 607 cases with nonspecific LBP and 607 controls without history of nonspecific LBP."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "A self-administered questionnaire was designed for epidemiological survey to investigate the risk factors for nonspecific LBP. All cases and controls were investigated for their family histories of nonspecific LBP, physical activities, sedentary activities, schoolbag weights, school performances, living conditions, and etc."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A 1:1 matched case-control study was conducted on 1,214 adolescents from an elementary school and a secondary school in Guangzhou City, southern China."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Family history (odds ratio [OR] 2.57, 95% confidence interval [CI] 1.85-3.58), long duration of carrying schoolbag (OR 1.38, 95% CI 1.11-1.72) and rest position between classes (OR 1.18, 95% CI 1.01-1.39) were positively correlated with self-reported nonspecific LBP. Students regularly playing basketball (OR 1.58, 95% CI 1.09-2.30) was found to be significantly more likely to have LBP. Also, students who feel schoolbag uncomfortable (OR 1.38, 95% CI 1.11-1.72) was found to experience more LBP."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Family history, feeling schoolbag uncomfortable, duration of schoolbag carrying, basketball playing and rest position between classes are the major risk factors for nonspecific LBP in adolescents."
          }
        ]
      },
