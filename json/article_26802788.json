      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "BACKGROUND-AIMS",
            "content": "Pre-pregnancy obesity may cause significant health implications for both mother and neonate. Our study aims to investigate the association between pre-pregnancy Body Mass Index and the risk for cesarean section, admission to Neonatal Intensive Care Unit, macrosomia and preterm delivery, in a Mediterranean country."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "A matched retrospective case control analysis was conducted."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "The study population included all pregnant women (with known Body Mass Index data) who gave birth in the University Hospital of Patras between 1st of January 2003 and 31st of December 2008."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Cases were defined as obese (338) or overweight (826) women."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Overweight and obese women were at higher risk for cesarean section, NICU admission and preterm delivery (χ(2)(2)=36.877, p<0.001, χ(2) Imes and Burke (2014) =6.586, p=0.037 and χ(2) Imes and Burke (2014) =7.227, p=0.027 respectively). Neonatal mean birthweight was higher among obese and overweight women (p<0.0001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Both obese and overweight pregnancies should be considered as high risk pregnancies, due to more frequent adverse pregnancy outcomes (cesarean delivery, preterm delivery and NICU admission)."
          }
        ]
      },
