      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Pain is a major problem in the treatment of patients with cancer. This article reviews studies concerning evaluation of patients with cancer pain treated according to The World Health Organization (WHO) analgesic ladder."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Systematic search of PUBMED, MEDLINE, EMBASE, LILACS, BDENF, and OVID and a hand search of reference lists and textbooks from 1982 to 2004 were performed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "Analgesia was considered adequate in 45 to 100% of patients analyzed in the studies."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "However, the evidence that they provide is insufficient to grant the effectiveness of the WHO guidelines because a controlled clinical trial of this intervention has never been published."
        }
      ]},
