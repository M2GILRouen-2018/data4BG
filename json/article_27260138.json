      "Abstract": {
        "CopyrightInformation": "© 2016 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Opioid analgesia has been implicated as a cause of secondary adrenal insufficiency, but little is known of the prevalence of this potentially serious adverse effect in patients with chronic pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional study of chronic pain patients on long-term opioid analgesia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Patients attending tertiary chronic pain clinics at the Western General Hospital, Edinburgh, treated with long-term opioid analgesia (n = 48) with no recent exposure to exogenous glucocorticoids."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Four patients (8·3%) had basal morning plasma cortisol concentrations below 100 nmol/l, of whom three failed to achieve a satisfactory cortisol response to exogenous ACTH1-24 stimulation (peak cortisol >430 nmol/l). Basal cortisol was positively associated with age (R = 0·398, P = 0·005) and negatively associated with BMI (R = -0·435, P = 0·002)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Suppression of the hypothalamic-pituitary-adrenal axis is present in a clinically significant proportion of chronic pain patients treated with opioid analgesia. Studies of larger populations should be conducted to better define the prevalence and potential clinical consequences of adrenal insufficiency in this context."
          }
        ]
      },
