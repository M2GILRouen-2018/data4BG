      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the efficacy and safety of dienogest (DNG) with intranasal buserelin acetate (BA) in patients with endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Phase III, randomized, double-blind, multicenter, controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Twenty-four study centers in Japan."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Two hundred seventy-one patients with endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Dienogest (2 mg/day, orally) or BA (900 microg/day, intranasally) for 24 weeks."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "The pre- to posttreatment changes in the scores of five subjective symptoms during nonmenstruation (lower abdominal pain, lumbago, defecation pain, dyspareunia, and pain on internal examination) and two objective findings (induration in the pouch of Douglas and limited uterine mobility)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Dienogest reduced the scores of all symptoms and findings at the end of treatment, and the mean changes in the scores of all symptoms and findings except induration in the pouch of Douglas were comparable to those obtained with BA. Compared with BA, DNG was associated with irregular genital bleeding more frequently and with fewer hot flushes. The reduction in bone mineral density (BMD) during DNG treatment was significantly lower than that during BA treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "DNG is as effective as intranasal BA in alleviating endometriosis, and causes less BMD loss."
        }
      ]},
