      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "We analysed knowledge and expectations of the process and pain of labour in primigravidas attending a local midwifery obstetric unit (MOU). It was anticipated that the results of this study could inform the development of interventions aimed at improving the analgesic care of women delivering at primary health care obstetric units."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Qualitative analysis of data obtained from in-depth semi-structured interviews."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A Cape Town MOU."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "30 black African, Xhosa-speaking primigravidas."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "An open-ended interview guide was developed. The themes explored included previous painful experiences, knowledge of labour, expectations of and attitudes towards labour pain, and knowledge of biomedical analgesia."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients were poorly informed about the process and pain of labour. Most women appeared highly motivated concerning their ability to cope with labour. Most expected pain, but had no concept of the severity or duration of the pain, and knew very little concerning methods available for pain relief in labour."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Women at this MOU were poorly prepared for the experience of delivery. Antenatal programmes should incorporate sensitive education concerning the process and pain of labour and the methods available to alleviate pain."
        }
      ]},
