      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 European Association for Cranio-Maxillo-Facial Surgery. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the role of dermis-fat grafts in preventing gustatory sweating and in the reconstruction of facial contour defects after parotidectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Twenty-three patients with tumours of the parotid gland were enrolled in this prospective clinical study from January 2006 to February 2014. All of them were evaluated for wound complications, Frey's syndrome, satisfaction, and tumour relapse. Follow-up periods ranged from 6 to 72 months."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Nineteen patients completed the study. Nine complications observed in six patients were assessed (two haematomas [10%], one seroma [5%], one sialocele [5%], and recurrent pain in five patients [26%]). None revealed Frey's syndrome. Satisfactory results were found in relation to scar, facial contour, and overall outcomes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Dermis-fat grafts appear to be an effective method of preventing Frey's syndrome after parotidectomy. The stable long-term results and high patient satisfaction lead to the application of this operation technique in daily routine."
          }
        ]
      },
