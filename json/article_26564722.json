      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 European Foot and Ankle Society. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Osteoid osteomas are responsible for 10% of benign bone tumours. Treatment typically involves surgical excision or radio frequency ablation. The aim of this systematic review is to evaluate reported cases of foot and ankle osteoid osteomas."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We conducted a systematic review of the literature using the online databases Medline and EMBASE. We included studies reporting osteoid osteoma diagnosed either radiologically or histologically."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "94 studies were included reporting 223 cases; 70.5% were male, mean age was 23 years, 69% reported night pain and 72% responded to NSAIDs. The commonest affected bone was the talus. CT scan was the most useful radiological investigation and MRI missed the diagnosis in 34% of cases. The majority of patients underwent surgical excision but an increasing trend of ablation therapy was demonstrated."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A high index of suspicion based on salient history and appropriate imaging are essential for timely identification and treatment."
          }
        ]
      },
