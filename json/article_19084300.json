      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright 2008 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "to investigate the association between country of origin of women and their use of complementary pain reduction methods (i.e. non-pharmacological) during childbirth in Sweden."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "cross-sectional design."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "a national register-based study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "215,497 singleton deliveries (including the first birth of each woman during the period) of women aged 18-47 years in Sweden between 1996 and 1998, divided into 12 subgroups of countries or regions."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "the use of complementary pain reduction methods during childbirth was analysed by logistic regression, adjusting for parity, level of education, number of antenatal care visits, complications in pregnancy, complications during childbirth, use of any pharmacological methods and use of epidural/spinal analgesia during childbirth."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "all subgroups of foreign-born women, except those from Finland, had lower odds of complementary pain reduction methods during childbirth than Swedish-born women. Women from Bosnia, Arab countries, Sub-Saharan Africa, Turkey, Iran and Asia had about 40% lower odds for use of complementary pain reduction methods during childbirth than Swedish-born women. Women who used epidural analgesia had higher odds for use of complementary pain reduction methods during childbirth than women who did not use any pharmacological methods."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "KEY CONCLUSION",
            "content": "most subgroups of foreign-born women showed lower odds for and a different pattern in the use of complementary pain reduction methods during childbirth than Swedish-born women. These findings raise questions of whether the Swedish health-care system and care providers have sufficient awareness of and insight into the socio-cultural context of giving birth."
          }
        ]
      },
