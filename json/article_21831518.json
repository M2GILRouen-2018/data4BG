      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "In the literary novel Kurgast (1925), translated in English as A guest at the spa, the Nobel laureate Hermann Hesse describes the treatment of his own sciatica."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We compare Hesse's description of 85 years ago with a transcript of an interview with a contemporary patient with sciatica. The narratives of both texts were analyzed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Both narratives start with hope on full recovery. Later this changes into the realization that one needs to accept that some symptoms are irreversible and will be permanent."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Although there currently is better understanding, diagnostic imaging and treatment of sciatica, a strong similarity in narrative type between the two stories was observed. Literary narratives can reflect every day practice, and probably can also be used to give better insight in dealing with diseases."
          }
        ]
      },
