      "Abstract": {
        "CopyrightInformation": "©2013 Foundation Acta Paediatrica. Published by John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "Infant feeding affects growth, obesity and life-long health. This study examined the impact of dietary patterns on body mass index (BMI) at 12 and 18 months."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We followed a cohort of 2666 children recruited in 2007-2008. Feeding practices were obtained from parental questionnaires and anthropometric data collected by child health nurses."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "At 6 months, 58.3% of the infant were breastfed, but only 1.6% exclusively. Many had begun eating solids (91.8%), porridge (87.7%) or milk cereal drink (46.6%). Bottle-feeding at 4 months was not a risk factor for a high BMI (>1 SD) at 12 or 18 months. Milk cereal drink at six months increased the risk of a high BMI at 12 and 18 months, respectively (OR 1.58, 95% CI 1.12-2.22, and 1.52, 1.07-2.17). Milk cereal drink use was increased by low parental education and maternal obesity and reduced by troubled sleep and parental group participation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Formula at 4 months did not predict a high BMI at 12 or 18 months. Milk cereal drink use at 6 months was a risk factor for a high BMI at 12 and 18 months. The choice of milk cereal drink was influenced by parental factors, especially educational levels."
          }
        ]
      },
