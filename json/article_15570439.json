      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Spontaneous ventriculostomy related to progressive obstructive hydrocephalus is rare. Radiologic demonstration of such a phenomenon can be delineated with magnetic resonance imaging (MRI) and cine MRI."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE PRESENTATION",
          "content": "A 59-year-old woman with a known tectal glioma and symptoms of chronic hydrocephalus developed progressively worsening headaches. During follow-up, she noted spontaneous relief of her headaches. Follow-up cine MRI demonstrated a spontaneous ventriculostomy via the floor of the third ventricle."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "INTERPRETATION",
          "content": "Clinicians should be aware of spontaneous ventriculostomy demonstrable on cine MRI because it may obviate the need for a CSF diversion procedure."
        }
      ]},
