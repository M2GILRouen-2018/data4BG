      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The objective was to determine feasibility of a study comparing mean pain scores between women randomized to nitrous oxide/oxygen (NO) versus oxygen+oral analgesics for trimester surgical abortion."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Pilot randomized controlled trial comparing NO (n=10) versus oxygen+oral analgesics (n=10). Feasibility of subject recruitment, and pain and satisfaction scores on a visual analog scale were evaluated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Fifty-seven percent of eligible women participated. Mean pain scores were similar between groups, and mean satisfaction scores were higher for the NO group (77.5 vs. 46.7, P=.048)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The majority of eligible women agreed to participate in this study evaluating an uncommon pain control intervention."
          }
        ]
      },
