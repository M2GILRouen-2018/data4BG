      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American College of Allergy, Asthma & Immunology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The effects of atopic and nonatopic asthma phenotypes on asthma morbidity are unclear. Moreover, asthma morbidity in patients without atopy might be mediated by immunoglobulin E (IgE)."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine differences in morbidity in patients with asthma with and without atopy in a population of inner-city adolescents with asthma and to assess the impact of total IgE (tIgE) in this population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Data were obtained from 546 inner-city adolescents in the Asthma Control Evaluation study. A positive skin prick test reaction to 14 aeroallergens and specific IgE to 5 aeroallergens determined atopic status. High (≥75th percentile) and low (≤25th percentile) tIgE levels were categorized. Asthma control (Asthma Control Test) and asthma severity (Composite Asthma Severity Index [CASI]) were measured at multiple time points over 1 year. Fractional exhaled nitric oxide (FeNO) and measurements of morbidity also were collected. Multivariable and repeated measures analyses modeled the relation between atopic status and morbidity."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Baseline CASI scores increased 0.90 point (P < .05) and FeNO increased 0.85 natural logarithmic unit (P < .001) in participants with vs without atopy. Repeated measures analyses showed consistent results. Participants without atopy and increased tIgE had FeNO 0.73 natural log unit higher (P < .01) than low tIgE and a nonsignificant increase in CASI. The CASI score and FeNO levels were higher for high than for low tIgE in participants with atopy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "In this population, participants with atopic asthma had worse asthma severity and higher FeNO compared with those with nonatopic asthma, but no difference in control. In all participants, higher tIgE indicated worse severity and higher FeNO. In this population, asthma severity and FeNO might be mediated by IgE in the 2 asthma phenotypes."
          }
        ]
      },
