      "Abstract": {
        "CopyrightInformation": "© 2015 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the therapeutic effects of Botulinum toxin type A (BTA) for anterior knee pain caused by patellofemoral pain syndrome (PFPS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective case control study for intervention."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A tertiary hospital rehabilitation center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Twelve bilateral PFPS patients with anterior knee pain were recruited. The worse pain knee was selected for injection, and the counterpart was left untreated."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Injection of BTA to vastus lateralis (VL) muscle."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Western Ontario and McMaster Universities Osteoarthritis Index (WOMAC) was used to assess pain, stiffness, and functional status of the knee, and CYBEX isokinetic dynamometer to assess isokinetic muscle force before and after BTA application to VL."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Remarkable improvement after receiving BTA injection was obtained not only in the questionnaire of WOMAC (p<0.05), but also in knee flexion torque (p<0.05). No significant change of knee extension torque was noted (p=0.682)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "BTA injection is a good alternative treatment to improve anterior knee pain, knee function and isokinetic flexion torque."
          }
        ]
      },
