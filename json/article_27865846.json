      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the efficacy of an educational physiotherapy home exercise intervention for physical improvement, pain perception, quality of life, and illness behavior in patients with hemophilic arthropathy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Single-blind randomized controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Home."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Patients with hemophilia (N=20) were randomly allocated to an educational intervention group or to a control group."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "The educational intervention was performed every 2 weeks over a 15-week period, and home exercises were carried out once a day, 6 days a week, over the same period."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Joint status was evaluated using the Gilbert scale; pain was assessed using the visual analog scale; illness behavior was evaluated using the Illness Behavior Questionnaire; and the perception of the quality of life was evaluated using the A36 Hemophilia-QoL questionnaire."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We observed significant differences in the intervention group and the control group for both quality of life and illness behavior. There was no significant improvement in joint status; however, an improvement was noted in terms of perception of pain in the ankle."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A physiotherapy program based on educational sessions and home exercises can improve the perception of pain in patients with hemophilic arthropathy of the ankle. It improves some variables in the perception of the quality of life and illness behavior."
          }
        ]
      },
