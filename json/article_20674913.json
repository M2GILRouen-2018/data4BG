      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 American Society for Reproductive Medicine. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To raise awareness of forgotten intrauterine contraceptive devices (IUDs)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case report."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "District general hospital in London."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Two women, one with secondary infertility and one with heavy, painful periods, both unaware they had an IUD."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Removal of the forgotten IUD."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Return of fertility and improvement in gynecologic symptoms."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "After the removal of the IUD, the first patient who had had secondary infertility conceived within 1 month. In the second patient, the symptoms of menorrhagia and dysmenorrhea improved after removal of the IUD."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Although it is rare, a forgotten IUD is a potential cause of unexplained infertility and a differential diagnosis for gynecologic symptoms."
          }
        ]
      },
