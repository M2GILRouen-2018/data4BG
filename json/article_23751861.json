      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Previous studies include too few patients over 70 years to be able to assess treatment effects on Health Related Quality Of Life (HRQOL) in the older age group. We aimed to follow HRQOL in postmenopausal women (55-80 years) with breast cancer receiving adjuvant treatment, until five years post-treatment, and compare with a general population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "The patient sample included 150 women (adjuvant CT n = 75 and RT n = 75) and two reference samples from the Swedish SF-36 norm database."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Data from baseline showed significantly higher levels of physical functioning and general health among the patients compared to the reference sample, and significantly lower levels of bodily pain, emotional role functioning and mental health. Longitudinal analyses showed significant changes in all scales, and three different patterns (a decrease-stable, a decrease-increase, and a stable- increase pattern) were identified."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Postmenopausal women seem to successfully manage the effects of adjuvant treatment on HRQOL."
          }
        ]
      },
