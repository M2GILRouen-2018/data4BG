      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To explore the mediating role of measures of persuasion in the relationship between risk perceptions and intentions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The first study included 413 obese subjects (mean age = 45.3 years); the second study, 781 overweight subjects (mean age = 46.6 years). All measures were assessed by self-report."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Feelings and intervention judgments were mediators in the relationship between risk perceptions and intention to eat healthier, do more physical activity (study 1) and intention to reduce saturated fat (study 2). Feelings was the only mediator in the relationship between risk perceptions and intention to stop smoking (study 1)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Future interventions targeting risk perceptions to increase intentions are likely to be more effective if subjects find the information emotionally impactful, credible, and engaging."
        }
      ]},
