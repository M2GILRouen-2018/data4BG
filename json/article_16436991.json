      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report the first case of spontaneous intratumoral and brainstem hemorrhage in a patient with a vestibular schwannoma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report and review of the literature."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University-based, tertiary referral center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT",
          "content": "A 73-year-old woman with a vestibular schwannoma, anti-vitamin K overdose, and arterial hypertension experienced a rapid onset of headache, facial palsy, diplopia, and hoarseness."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "The patient was admitted to the intensive care unit and treated with vitamin K and corticoids."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Clinical and radiologic findings."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At admission, the magnetic resonance imaging and computed tomographic scans showed an intratumoral hemorrhage. The patient entered a coma 24 hours after the onset of the symptoms. At that time, the computed tomographic scan demonstrated a massive intratumoral and brainstem hemorrhage. The patient died 3 days later."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Intratumoral, subarachnoid, and brainstem hemorrhages can occur in patients with vestibular schwannoma. Oral anticoagulant therapy is a risk factor for tumor-related hemorrhage."
        }
      ]},
