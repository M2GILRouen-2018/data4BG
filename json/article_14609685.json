      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND CONTEXT",
          "content": "Elective lumbar fusion surgery is a prevalent and costly procedure that requires a lengthy rehabilitation. It is important to identify presurgical biopsychosocial predictors of medical and compensation costs in such patients."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To determine if presurgical biopsychosocial variables are predictive of compensation and medical costs in a cohort of Utah lumbar fusion patients receiving workers' compensation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN/SETTING",
          "content": "A retrospective-cohort study consisting of a review of presurgical medical records and accrued medical and compensations costs."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT SAMPLE",
          "content": "A consecutive sample of 203 compensated workers from Utah who underwent lumbar fusion from 1990 to 1995. Patients were at least 2 years postsurgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Total accrued medical and compensations costs."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A retrospective review of presurgical biopsychosocial variables and total accrued medical and compensation costs was conducted."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Presurgical variables from each of the biopsychosocial domains were statistically significantly correlated with medical and compensation costs. Social and biological variables were the best predictors of total compensation costs, whereas psychological variables were better predictors of total medical costs."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Compensation and medical costs associated with posterolateral lumbar fusion can be predicted by preintervention biopsychosocial variables. Cost reduction programs might benefit from identifying biopsychosocial factors related to increased costs."
        }
      ]},
