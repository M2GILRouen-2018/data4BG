      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To explore coronary heart disease risk in a sample of women with multiple sclerosis (MS) by identifying the presence of established risk factors for coronary heart disease and to determine the relationship between disease severity and level of participation in health-related behaviors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Survey study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Five general community settings in Oregon."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Women with physician-diagnosed MS (N=123) recruited from MS chapters, physician referrals, and newspaper announcements."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Not applicable."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Modified Yale Physical Activity Survey, Block Food Frequency Questionnaire, blood analysis, skinfolds, and waist and hip circumferences."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The majority of women met current physical activity guidelines. The frequencies of unfavorable levels of metabolic variables and obesity were similar to those reported in the general population. Significant associations were observed between mobility and physical activity, total and abdominal fat, and several dietary habits."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Coronary heart disease risk in this sample was comparable to that of the general population of women without MS. Physical inactivity, body composition, and perhaps nutritional habits decline with decreasing mobility, emphasizing the need for families and health care providers to work together to find solutions that increase health-promoting behaviors in women with more advanced MS."
        }
      ]},
