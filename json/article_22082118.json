      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To report immediate and follow-up pain intensity outcomes of fluoroscopically guided contrast- enhanced pubic symphysis corticosteroid injections for patients with pubic symphysis pain (PSP)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective medical record review."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Outpatient rehabilitation clinic."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "Patients with PSP who underwent pubic symphysis corticosteroid injection (PSI)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Pubic symphysis corticosteroid injection."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Pain intensity as measured by numeric rating scale (NRS)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Fourteen patients (4 men and 10 women) underwent PSI. Five patients had PSP for less than 6 months, nine had chronic pain (>than 6 months). In 7 of the 10 women the pain was pregnancy related. All patients received other treatments prior to injection. Pubic symphysis tenderness was the most common physical examination finding (13/14 patients). Follow-up pain intensity (PI)-NRS improvement of greater than 2 points was considered clinically significant. At follow-up, improvement was not statistically significant (Wilcoxon signed-rank test, z=1.62 P=0.10). Patients with pain <6 months did not have a greater likelihood of benefit at follow-up compared with those with pain for >6 months (Fisher's exact test, P=0.775)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "PSIs do not provide clinically or statistically significant relief at follow-up in patients with PSP."
          }
        ]
      },
