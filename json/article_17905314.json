      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND CONTEXT",
          "content": "In the assessment and treatment of chronic low back pain (CLBP) patients, the biopsychosocial model is used worldwide. Psychological distress has been reported to have a strong relationship with disability as measured with several instruments. The relationship between psychosocial distress measured with the Symptom Checklist-90-Revised (SCL-90-R) and self-reported disability measured with the Roland Morris Disability Questionnaire (RMDQ) has not been investigated."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To analyze the relationship between psychosocial distress measured with the SCL-90-R and self-reported disability measured with the RMDQ in patients with CLBP."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN/SETTING",
          "content": "This cross sectional study was performed in an outpatient pain rehabilitation setting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT SAMPLE",
          "content": "The study sample consisted of 152 patients with CLBP."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "SCL-90-R and RMDQ."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "All patients admitted for multidisciplinary treatment completed the SCL-90-R and RMDQ before treatment. Pearson's correlation coefficients between SCL-90-R (Global Severity Index and subscales) and RMDQ were calculated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Correlation coefficients between SCL-90-R (Global Severity Index and subscales) and RMDQ ranged from 0.18 to 0.31 (p<.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The relationship between psychosocial distress measured with the SCL-90-R and self-reported disability measured with the RMDQ in CLBP patients is weak."
        }
      ]},
