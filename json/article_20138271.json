      "Abstract": {
        "CopyrightInformation": "Copyright 2010 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To report the case of a Nigerian patient who suffered from sterility and underwent abdominal laparotomy to remove an adnexal tumor. Histologic analysis revealed Schistosoma haematobium ova."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case report."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Multidisciplinary group practice and teaching hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "One patient who underwent an abdominal laparotomy to remove an adnexal tumor."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "In vitro fertilization and adnexal tumor resection via laparotomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Treatment of the adnexal tumor affecting the reproductive health."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Histologic analysis performed on the tissue removed at surgery revealed fibrous patches around aggregates of calcified Schistosoma haematobium eggs in the fallopian tube wall."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Schistosomiasis needs to be considered as a differential diagnosis of female infertility and sterility."
          }
        ]
      },
