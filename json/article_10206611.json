      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the interrater and intrarater reliability of two methods of measurement of postural radiographs for determining the amount of pelvic obliquity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Four blinded raters evaluated the amount of pelvic obliquity using two measurement methods."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Physical medicine and rehabilitation outpatient clinic in a VA hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Fifty-two randomly chosen radiographs from 36 patients referred to a clinic to evaluate and treat pelvic obliquity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASURES",
          "content": "Amount of pelvic obliquity was determined by line of eburnation and by the intersulcate line. Pearson's correlation coefficients and percent agreements were calculated for each set of measurements."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pearson's correlation coefficients and percent agreements were higher for both interrater and intrarater measurements for the intersulcate line."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Intersulcate line is the more reliable method for determining the amount of pelvic obliquity and will be used in future studies to assess the effectiveness of correcting pelvic obliquity to improve chronic back pain."
        }
      ]},
