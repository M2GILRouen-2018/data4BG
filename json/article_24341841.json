      "Abstract": {
        "CopyrightInformation": "© 2013, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The objective of this study was to determine the relation between the severity of the coronary artery disease (CAD) and left ventricular (LV) diastolic function in patient with stable CAD and normal LV ejection fraction."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Sixty patients with stable CAD were included in the study. All angiographic variables pertinent to SYNTAX Score (SS) and Gensini score (GS) calculation were computed by two experienced interventional cardiologists. All patients underwent echocardiographic examination."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We divided the patients into 4 groups according to median of SS and GS. It was observed that LV diastolic function was impaired in 26 patients (86.7%) in under group of SS, 23 patients (76.7%) in upper group of SS, and 27 patients (87.1%) in under group of GS, and 22 patients (75.9%) in upper group of GS. There was no significant difference between the SS, GS, clinical, and echocardiographic findings."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The diastolic function did not demonstrate any impairment according to the severity of the CAD in patients which coronary angiography performed with the diagnosis of stable CAD."
          }
        ]
      },
