      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "ETHNOPHARMACOLOGICAL RELEVANCE",
            "content": "Ageratum conyzoides L. is a plant widely used in traditional medicine in tropical and subtropical regions of the world due to its anti-inflammatory, antinociceptive and antibacterial properties."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM OF THE STUDY",
            "content": "To characterize the standardized extract of polymethoxyflavones (SEPAc) from the plant and evaluate its antinociceptive and anti-inflammatory effects."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "The SEPAc purified from the ethanol extract of the plant leaves was characterized by high resolution mass spectrometry and the methoxyflavones were quantified by a validated UPLC-PDA method. The antinociceptive and anti-inflammatory activities of the SEPAc were evaluated after oral administration on the acute nocifensive behavior of mice induced by formalin, prostaglandin E2 (PGE2) and proinflammatory cytokines (interleukin-1beta (IL-1β)) and tumor necrosis factor-alpha (TNF-α) in mice."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Qualitative analyses revealed the presence of seven methoxyflavones in the SEPAc, also a simple UPLC-PDA method was developed and validated for the quantification of 5,6,7,3',4',5'-hexametoxyflavone; nobiletin; 5'-methoxynobiletin and eupalestin, major compounds in the extract. The SEPAc exhibited antinociceptive and anti-inflammatory activities in both formalin phases, with significant inhibition of the paw edema formation and significant reduction of the nocifensive response induced by an intraplantar injection of PGE2 and intrathecal injection of interleukin-1β."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The SEPAc exhibited significant antinociceptive and anti-inflammatory effects. These results provided scientific suggestion of its potential as a source of new medicines to treat inflammatory diseases, such rheumatoid arthritis."
          }
        ]
      },
