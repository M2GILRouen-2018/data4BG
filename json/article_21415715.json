      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Persistent pain after breast cancer surgery is an underrecognized problem. Self-reporting is uncommon in the Chinese community."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "In this study, 200 women completed questionnaires assessing prevalence and associated factors of persistent pain after breast cancer surgery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "28.5% women reported persistent pain after surgery, 50.5% women reported sensory disturbance, and 4.2% reported phantom breast pain. The report of higher pain score was associated with a higher pain disability index score."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "The findings suggest that persistent pain after breast cancer surgery is a significant problem among Chinese women in Hong Kong and affects their quality of life."
        }
      ]},
