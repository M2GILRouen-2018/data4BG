      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The internet is increasingly a source of healthcare information utilized by parents, especially in rarer pathologies such as vascular malformations. The quality, validity and thoroughness of these websites is variable and unregulated. The goal of this study was to evaluate the quality and understandability of websites related to vascular malformations."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The terms \"hemangioma\", \"vascular malformation\", and \"vascular anomalies\" were searched in Google. The first 30 websites meeting inclusion and exclusion criteria were evaluated. Quality and readability were assessed using the DISCERN criteria and the Flesh-Kincaid Reading Grade Level (FKGL), respectively. Date of last update, HONcode accreditation, and the website category were recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Most websites were owned by academic institutions (n = 19, 63.3%). The mean DISCERN score for all websites was 2.97, or a partially valid source of information on a 1-5 scale. The average reading level estimated by FKGL was grade 12; only one website was scored at less than a grade 9 level. Two websites were HONcode accredited. Of the 18 sites giving an explicit date of last update, 12 (67.7%) had been updated in the previous 12 months."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Websites relating information about vascular anomalies may not be understandable to the general public, including parents. Health care providers should be cognizant of the quality and availability of such information as it may impact parent perspectives and bias toward treatment options."
          }
        ]
      },
