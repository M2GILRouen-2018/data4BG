      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 John Wiley & Sons, Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Tardive dyskinesia (TD) is a motor side effect that may develop after long-term antipsychotic treatment. Schizophrenia has recently been associated with the Neurexin-1 (NRXN1) gene that codes for a cell adhesion molecule in synaptic communication."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This study examined five NRXN1 single-nucleotide polymorphisms (SNPs) for possible association with the occurrence and severity of TD in 178 schizophrenia patients of European ancestry."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We did not find these SNPs to be significantly associated with TD."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "More research is needed with additional SNPs and in bigger samples before we can completely rule out the role of NRXN1 in TD."
          }
        ]
      },
