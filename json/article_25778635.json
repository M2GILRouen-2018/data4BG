      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Massive localized lymphedema (MLL) is a benign soft-tissue lesion that usually presents as a large and isolated mass in morbidly obese adults."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "We report the case of a 39-year-old woman presenting obesity and multiple MLL. There was a large tumor in the left groin and two smaller lesions on the backs of the thighs."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "MLL is a benign tumor that must be removed wherever possible because such tumors may degenerate into angiosarcomas in 13% of cases. MLL is probably secondary to a prolonged obstruction of lymphatic vessels due to marked excess of adipose tissue."
          }
        ]
      },
