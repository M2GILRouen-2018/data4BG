      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The neck circumference (NC) has been shown to be an accurate index for screening overweight and obesity in children and adolescents."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To perform a meta-analysis to assess the performance of NC for the assessment of overweight and obesity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS AND METHODS",
          "content": "Data sources were PubMed and EMBASE up to March 2016. Studies providing measures of diagnostic performance of NC and using body mass index as reference standard were included."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Six eligible studies that evaluated 11 214 children and adolescents aged 6-18 years were included in the meta-analysis. NC showed pooled sensitivity to detect high body mass index of 0.780 (95% confidence interval [CI]\u2009=\u20090.765-0.794), specificity of 0.746 (95% CI\u2009=\u2009 0.736-0.756) and a diagnostic odds ratio of 17.343 (95% CI\u2009=\u2009 8.743-34.405)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The NC had moderate diagnostic accuracy for identifying overweight and obesity in children and adolescents."
        }
      ]},
