      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE OF REVIEW",
          "content": "The review is based on a Medline literature search using key words relating to male urogenital/pelvic pain for the years 2009-2011."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RECENT FINDINGS",
          "content": "The review covers those studies relating to cause, ongoing mechanisms and treatments."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "The review highlights that the patients are often polysymptomatic with multimodal/system issues that require a team approach that involves multiple specialties and multiple disciplines."
        }
      ]},
