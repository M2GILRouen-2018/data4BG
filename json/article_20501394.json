      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate neointimal proliferation following placement of a new drug-eluting stent (BUMA) by optical coherence tomography (OCT)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Twenty-two patients with coronary artery disease were randomized into BUMA group (n=15) and Endeavor group (n=7) and underwent OCT imaging after 9 months of stent implantation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The neointima hyperplasia (NIH) thickness in BUMA group were significantly smaller than that in endeavor group (0.220-/+0.140 mm vs 0.269-/+0.207 mm, P<0.001), and the uncovered Struts were significantly lower in BUMA group than in Endeavor group (5.65% vs 6.56%, P<0.0001). The luminal late loss in BUMA group was also significantly lower (34.87-/+11.50 vs 40.82-/+18.53, P=0.025)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "BUMA stent is safe and effective for treatment of coronary artery disease."
        }
      ]},
