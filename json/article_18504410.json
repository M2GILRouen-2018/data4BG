      "Abstract": {
        "CopyrightInformation": "Copyright 2008 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Oxidants including reactive oxygen species have been indicated to play an important role in the pathogenesis of asthma."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We investigated oxidative status in patients with acute exacerbations of asthma and evaluated the therapeutic response using the D-ROM test which is simple to use and quick."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We measured reactive oxygen metabolite (ROM) levels in the serum of 42 outpatients with acute exacerbations of asthma, 11 outpatients with stable asthma and 40 healthy subjects using the D-ROM test. Seven inpatients admitted due to acute exacerbations of asthma were also enrolled to evaluate the effects of treatment. Serum eosinophil cationic protein and plasma polymorphonuclear elastase were also measured by EIA or ELISA to evaluate the correlation between inflammation and oxidative status."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Serum ROM levels were significantly higher in patients with acute exacerbation of asthma than in patients with stable asthma or healthy subjects. Levels of serum eosinophil cationic protein and plasma polymorphonuclear elastase were increased in acute exacerbation and moderately correlated to ROM levels. Levels of ROM were significantly decreased after treatment with systemic steroids and bronchodilators."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These findings suggest that acute exacerbation of asthma is associated with increased oxidative stress. Serum ROM levels would partly reflect the inflammation with eosinophils and neutrophils and may be useful as biomarkers of asthma."
          }
        ]
      },
