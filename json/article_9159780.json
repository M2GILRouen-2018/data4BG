      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To determine what problems patients undergoing breast cancer surgery experienced following discharge after participating in a 23-hour short-stay observation program and to explore their perceptions of the short-stay experience."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive and exploratory."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A comprehensive cancer center in an urban setting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "52 women undergoing modified radical mastectomy, segmental mastectomy (lumpectomy) with axillary node dissection, simple mastectomy, or other breast procedures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Telephone interviews 24-72 hours and 7-10 days after discharge using questionnaires developed by the investigators."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Postoperative difficulties, satisfaction with pain relief, positive and negative aspects of the short-stay process, and discharge to home."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Most patients had no difficulty with drain and incision care (84%), reported satisfactory analgesic relief with their prescribed medications (> 95%), and were prepared to leave the hospital on first postoperative day (85%). Patient education and care provided by physicians and nurses were highly rated. Although most responses were highly favorable, some women desired longer hospitalization (21%) and greater privacy while on the observation unit (13%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "By coordinating inpatient and outpatient services, short-stay observation following breast cancer surgery can be accomplished in a safe environment that patients perceive to be satisfactory and of high quality."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Short-stay observation is feasible for appropriately prepared postoperative patients who normally are managed on traditional impatient units."
        }
      ]},
