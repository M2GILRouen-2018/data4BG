      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "QUESTION",
          "content": "Does warm-up or cool-down (also called warm-down) reduce delayed-onset muscle soreness?"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomised controlled trial of factorial design with concealed allocation and intention-to-treat analysis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Fifty-two healthy adults (23 men and 29 women aged 17 to 40 years)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Four equally-sized groups received either warm-up and cool-down, warm-up only, cool-down only, or neither warm-up nor cool-down. All participants performed exercise to induce delayed-onset muscle soreness, which involved walking backwards downhill on an inclined treadmill for 30 minutes. The warm-up and cool-down exercise involved walking forwards uphill on an inclined treadmill for 10 minutes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURE",
          "content": "Muscle soreness, measured on a 100-mm visual analogue scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Warm-up reduced perceived muscle soreness 48 hours after exercise on the visual analogue scale (mean effect of 13 mm, 95% CI 2 to 24 mm). However cool-down had no apparent effect (mean effect of 0 mm, 95% CI -11 to 11 mm)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Warm-up performed immediately prior to unaccustomed eccentric exercise produces small reductions in delayed-onset muscle soreness but cool-down performed after exercise does not."
        }
      ]},
