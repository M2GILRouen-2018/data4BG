      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "Soda consumption is on the rise among children and adolescents. The purpose of this study was to test the hypothesis that increased soda consumption predicts risk-taking behavior among high school students."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "To test this hypothesis, we used data from the 2011 Youth Risk Behavior Surveillance System to compare the odds of engaging in a series of risk-taking behaviors among students who reported no soda consumption, occasional soda consumption (1 - 6 times per week), and daily soda consumption (≥ 7 times per week)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Daily soda consumption was associated with increased odds of engaging in 90% of the risk behaviors analyzed. In addition, there were sex differences in the magnitude of the relationships for many of these behaviors."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These data suggest that in addition to increased risk of obesity, dental caries, and reduced sleep quality, soda consumption is associated with increased risk-taking behavior."
        }
      ]},
