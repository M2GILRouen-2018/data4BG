      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To assess correlations between stone size/location and severity of secondary signs for ureteral obstruction."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Unenhanced multi-detector computed tomography examinations of 150 patients with acute renal colic were reviewed. Stone size, location in the ureter, kidney size and Hounsfield unit values, perinephric edema, and degree of hydronephrosis were assessed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pale kidney sign was detected in 36%. Hydronephrosis was mild in 63% and severe in 21%; severe hydronephrosis was associated with larger stones. Mid-ureter and ureteropelvic junction stones were more likely to cause hydronephrosis. Perinephric edema (56%) was not correlated with stone size/location."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Only severe hydronephrosis was significantly associated with larger stone size."
          }
        ]
      },
