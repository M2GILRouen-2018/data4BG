      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether a higher number of parenting practices, such as those concerning meals, bedtime, and limited screen time, is associated with children's health behaviors. In addition, to determine whether perceived parental warmth and responsiveness toward the child strengthens (moderates) the associations between parenting practices and health behaviors."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "School-based survey in which children completed questionnaires at school, and parents at home."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "A total of 805 child-parent dyads were used in analyses."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Intake of nutrient-dense and energy-rich foods, meal frequency per day, sleep duration, and screen time."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Linear and logistic regression analyses. Moderation was tested by adding the interaction term of parenting practices and parental warmth/responsiveness to the models. When moderation occurred, stratified analyses were conducted."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A higher number of parenting practices was associated with more favorable health behaviors. Stronger associations between parenting practices and nutrient-dense food intake and meal frequency were found when children perceived high parental warmth/responsiveness. Stronger associations between parenting practices and energy-rich food intake and screen time were found when children perceived low parental warmth/responsiveness."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Parental warmth/responsiveness seems to strengthen the associations between parenting practices and favorable health behaviors. This knowledge could be used in family-focused obesity interventions."
          }
        ]
      },
