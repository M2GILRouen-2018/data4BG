      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Report of an uncommon complication of acupuncture and wet cupping."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A 54-year-old man presented with neck pain and fever. Magnetic resonance imaging of the cervical spine revealed an epidural abscess at C4 to T2."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The symptoms related to epidural abscess resolved partially after treatment with antibiotics."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Acupuncture and wet-cupping therapy should be taken into consideration as a cause of spinal epidural abscesses in patients who present with neck pain and fever. Furthermore, acupuncture and wet-cupping practitioners should pay attention to hygienic measures."
          }
        ]
      },
