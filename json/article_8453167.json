      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case in which intravenous ketorolac was used successfully on a chronic basis to treat cancer pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Clinical and compatibility studies obtained through a computer literature search."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY SELECTION",
          "content": "We identified five reports that specifically addressed intravenous dosing of ketorolac."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "DATA SYNTHESIS",
          "content": "A 41-year-old man received pain relief from intravenous injections of ketorolac for 11 months. As far as we know, there are no other reports in the literature in which intravenous ketorolac has been used on a chronic basis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Experience at our institution indicates that intravenous ketorolac is a useful, well-tolerated nonsteroidal antiinflammatory drug that should be investigated further for use in selected pain models."
        }
      ]},
