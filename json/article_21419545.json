      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 American Association of Oral and Maxillofacial Surgeons. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To estimate in patients with temporomandibular joint (TMJ) arthralgia whether magnetic resonance (MR) imaging findings of bilateral TMJ disc displacement without reduction (DDwoR) and/or osteoarthrosis (OA) are determinants of horizontal mandibular and vertical ramus deficiencies."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Bilateral MR imaging of the TMJ was performed in 68 consecutive patients with TMJ arthralgia to identify those with bilateral TMJ DDwoR and/or OA. Linear and angular cephalometric measurements were performed to apply selected criteria of horizontal mandibular (gonion-menton [Go-Me] <73 mm and articulare-pogonion [Ar-Pog] <105 mm) and vertical ramus (articulare-gonion [Ar-Go] <45 mm) deficiencies. Logistic regression analysis was used to estimate the association between selected MR imaging and cephalometric parameters."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In the age- and gender-adjusted analysis, significant increases in the risk of horizontal mandibular (odds ratio, 7.5:1; P = .031) and vertical ramus (odds ratio, 9.5:1; P = .003) deficiencies occurred with bilateral DDwoR and OA."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "In patients with TMJ arthralgia, the MR imaging parameters of DDwoR and OA seem important determinants of horizontal mandibular and vertical ramus deficiencies."
          }
        ]
      },
