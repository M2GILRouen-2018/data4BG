      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Obesity results from a chronic positive energy balance."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "THERAPY",
          "content": "A reduction of energy intake is the first and most effective option for weight reduction. In recent years a variety of new nutritional concepts for weight loss have been developed and evaluated. Apart from the classical low-fat energy-restricted diet, low carbohydrate and high protein diets have also been established."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Comparative studies showed that weight loss depends on the extent of energy restriction rather than on macronutrient composition. Due to the high variability in dietary habits the management of obesity should be problem-oriented and patient-centered."
        }
      ]},
