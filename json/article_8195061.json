      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A patient's adherence to an appropriate treatment regimen is necessary to minimize morbidity and mortality associated with childhood asthma. Many factors influence the success of treatment adherence."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The goal of this article was to examine the effect of the mode of medication delivery on the success of treatment adherence in children with asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Relevant clinical studies were identified through a MEDLINE search of articles published from 1966 to 2002, using the search terms adherence, aerosol, asthma, children, compliance, dry powder inhaler, metered-dose inhaler, nebulizer, and pediatric."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A relationship seems to exist between treatment adherence and the type of medication delivery system used in childhood asthma. The highest rates of adherence appear to be associated with oral medications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Clinicians should consider the mode of medication delivery as 1 factor that can influence the success of treatment adherence."
        }
      ]},
