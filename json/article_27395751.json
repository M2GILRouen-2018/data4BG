      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To develop and validate a new 6 factor questionnaire (6-FQ) that identifies unhealthful behavioral, cognitive and affective lifestyle pattern factors among a large sample of adults who are overweight or obese."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Based on a previously developed 53-item lifestyle patterns questionnaire completed by 10,000 subjects, a new 6-FQ was developed and validated by using two prospective subject groups (n=640) with combined mean age of 43±11.4years and BMI 33.8±9.1kg/m(2)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "An exploratory factor analysis and multidimensional scaling were conducted that identified 6 distinct factors with excellent psychometric properties. Cronbach's internal consistency reliability estimates ranged from 0.76 to 0.85. The prevalence rates and odds ratios of the factors are generally and directly related with increasing BMI categories. The 6-FQ is highly correlated with multiple subscales from the co-administered IWQOL-Lite questionnaire."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The 6-FQ is a 27-item self-administered instrument with excellent psychometric properties that measures patients' lifestyle pattern factors."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "The 6-FQ is a convenient, short, self-administered instrument that has potential to target patients' self-identified lifestyle patterns related to body weight, and should allow clinicians to efficiently and effectively counsel patients on targeted treatment recommendations."
          }
        ]
      },
