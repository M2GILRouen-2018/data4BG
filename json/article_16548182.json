      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the coronary artery bypass graft (CABG) imaging between 16-slice spiral CT and 64-slice spiral CT."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Totally 27 patients with CABG received multi-slice spiral CT imaging and the results were retrospectively analyzed. Among them, 8 patients received 16-slice spiral CT scanning, 19 patients received 64-slice spiral CT scanning."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The evaluability rates of 64-slice spiral CT in evaluating the proximal anastomosis, bypass graft, distal anastomosis, and distal blood vessel were 100%, 100%, 90.2%, and 93.9%, respectively, while those of 16-slice spiral CT were 92.3%, 95.2%, 90.0%, and 90.0%, respectively. The patency rates of the above four aspects of 64-slice spiral CT were 66.7%, 70.0%, 71.7%, and 70.0%, respectively, while those of 16-slice spiral CT were 83.3%, 85.0%, 83.3%, and 88.9% ."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "64-slice spiral CT is superior to 16-slice spiral CT in CABG imaging. It can be used as a non-invasive tool for the post-operative follow-up of CABG."
        }
      ]},
