      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the use of infiltration with local anaesthetics levobupivacaine and bupivacaine, during inguinal hernia repair."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Double-blind, randomised study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Postgraduate medical school, United Kingdom."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "69 male patients aged 18 years or older."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Wound infiltration with 0.25% levobupivacaine and 0.25% racemic bupivacaine."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Area under the curve (AUC) of visual analogue scale (VAS) scores for postoperative pain at rest in the supine position, rising from the supine to the sitting position, and walking, against time for both treatment groups."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no significant differences between treatment groups for the AUC of VAS scores for postoperative pain, global verbal pain rating or time to first dose of analgesic medication."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Levobupivacaine exerts a similar anaesthetic and analgesic effect to racemic bupivacaine when infiltrated both intraoperatively and during the early postoperative period for elective inguinal hernia repair."
        }
      ]},
