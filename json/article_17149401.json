      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To assess the effect of an educational homecare program on pain relief in patients with advanced cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Quasi-experimental (pretest post-test, nonequivalent group)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Four community-based primary care centers providing social and healthcare services in the Quebec City region of Canada."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "80 homecare patients with advanced cancer who were free of cognitive impairment, who presented with pain or were taking analgesics to relieve pain, and who had a life expectancy of six weeks or longer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The educational intervention included information regarding pain assessment and monitoring using a daily pain diary and the provision of specific recommendations in case of loss of pain control. Pain intensity data were collected prior to the intervention, and reassessments were made two and four weeks later. Data on beliefs were collected at baseline and two weeks. All data were collected by personal interviews."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Patients beliefs about the use of opioids; average and maximum pain intensities."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Patients beliefs regarding the use of opioids were modified successfully following the educational intervention. Average pain was unaffected in the control group and was reduced significantly in patients who received the educational program. The reduction remained after controlling for patients initial beliefs. Maximum pain decreased significantly over time in both the experimental and control groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "An educational intervention can be effective in improving the monitoring and relief of pain in patients with cancer living at home."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "Homecare nurses can be trained to effectively administer the educational program during their regular homecare visits."
        }
      ]},
