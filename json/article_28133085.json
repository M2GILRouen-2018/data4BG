      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The aim of this study was to evaluate the safety of laparoscopic-assisted colorectomy(LAC)for elderly patients more than 70 years old."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The outcomes of 131 patients more than 70 years old who underwent LAC between April 2013 and March 2014 were retrospectively analyzed.Morbidity and mortality were evaluated using the Clavien-Dindo classification."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Postoperative complications exceeding Grade II in the Clavien-Dindo classification were found in 20 patients(15.3%).No mortalities were observed in this study."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "LAC can be performed safely for elderly patients older than 70 years."
        }
      ]},
