      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess whether IV tramadol before outpatient hysteroscopy could reduce procedure-related pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A randomized double-blind placebo controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient Hysteroscopy Centre in the Department of Obstetrics and Gynaecology of Cagliari University."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Fifty healthy, parous, women who underwent outpatient diagnostic hysteroscopy and endometrial biopsy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Random IV infusion of tramadol or placebo before hysteroscopy and endometrial biopsy were performed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Visual analogue scale of pain was measured both immediately after and 15 minutes after the procedure. Stress hormones (ACTH, cortisol), blood pressure, and heart frequency were evaluated before, during, and 15 minutes after the procedure."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "In the tramadol group, the visual analogue scale of pain was significantly lower than in the placebo group both immediately after the procedure and 15 minutes later. Basal levels of ACTH and cortisol did not differ between the groups. In both groups, the ACTH levels remained unchanged during the study, and the cortisol levels were higher 15 minutes after the procedure than before the procedure. Procedure time, heart frequency, blood pressure, and adverse effects did not differ between the groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "In parous women without uterine malformations, a treatment with tramadol before hysteroscopy and endometrial biopsy appears to be capable of reducing the pain and discomfort that are associated with this procedure."
        }
      ]},
