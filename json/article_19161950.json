      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The present study tests whether a combined treatment of acupuncture and transcutaneous electrical nerve stimulation (TENS) is more effective than acupuncture or TENS alone for treating chronic low back pain (LBP)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Thirty-two patients with chronic LBP were randomly allocated to four groups. The acupuncture group (ACP) received only acupuncture treatment at selected acupoints for low back pain; the TENS group (TENS) received only TENS treatment at pain areas; the acupuncture and TENS group (A&T) received both acupuncture and TENS treatments; the control group (CT) received topical poultice (only when necessary). Each group received specific weekly treatment five times during the study. Outcome measures were pain intensity in terms of visual analogue scale (VAS) and QOL of low back in terms of Roland-Morris Disability Questionnaire (RDQ)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The ACP, TENS and A&T groups all reported lower VAS and RDQ scores. Significant reduction in pain intensity (P<0.008) and significant improvement in QOL (P<0.008) were shown in the A&T group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Combined acupuncture and TENS treatment is effective in pain relief and QOL of low back improvement for the sampled patients suffering from chronic LBP."
        }
      ]},
