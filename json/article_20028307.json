      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether slow or fast bandaid removal is less painful."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN, SETTING AND PARTICIPANTS",
          "content": "A prospective, randomised, crossover trial was carried out at James Cook University, Townsville. Participants were healthy volunteers from Years 2 and 3 of the James Cook University medical school program."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Medium-sized bandaids were applied bilaterally in three standard body locations and removed using slow and fast techniques."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Pain scores were assessed using an 11-point verbal numeric pain scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "65 participants were included in the study. The overall mean pain score for fast bandaid removal was 0.92 and for slow bandaid removal was 1.58. This represents a highly significant difference of 0.66 (P < 0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In young healthy volunteers, fast bandaid removal caused less pain than slow bandaid removal."
        }
      ]},
