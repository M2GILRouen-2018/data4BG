      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 AAGL. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To investigate the incidence of and preoperative risk factors for developing pelvic pain after hysteroscopic sterilization using the Essure microinserts."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective cohort study (Canadian Task Force classification II-2)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "A total of 458 patients who underwent hysteroscopic sterilization using Essure between January 1, 2005, and June 30, 2012."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Hysteroscopic sterilization using Essure."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "The incidence of acute pelvic pain after hysteroscopic sterilization was 8.1%, and of persistent pain at 3 months after the procedure was 4.2%. The range of presence of pain was 1 to 469 days (mean, 56 days). Of patients who developed chronic pelvic pain after the procedure, 75% reported it within 130 days of the procedure. Patients with previous diagnoses of any chronic pain (chronic pelvic pain, chronic low back pain, chronic headache, and fibromyalgia) were more likely to report both acute pain (odds ratio, 6.81; 95% confidence interval, 2.95-15.73) and chronic pain (odds ratio, 6.15; 95% confidence interval, 2.10-18.10) after hysteroscopic sterilization."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Pelvic pain may develop after hysteroscopic sterilization. Patients with a diagnosis of preexisting chronic pain may be at increased risk of developing pelvic pain after the procedure. Fifty percent of new pelvic pain after Essure placement will resolve within 3 months."
          }
        ]
      },
