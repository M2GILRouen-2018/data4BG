      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "This is a report of a case."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To document the clinical, radiographic, and histologic characteristics of a lumbar extraforaminal juxtafacet cyst."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Spinal juxtafacet cysts develop most frequently at the dorsal aspect of the zygapophysial joint, sometimes in the posterolateral area of the canal. In one case, they have been described in the foraminal and extraforaminal region."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Description of the case report."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "The authors report one case of a strictly extraforaminal juxtafacet cyst responsible for L5 sciatica."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Juxtafacet cysts of the spine represent an infrequent cause of sciatica, usually when they grow in the canal, or more exceptionally when they occupy the foraminal or extraforaminal areas."
        }
      ]},
