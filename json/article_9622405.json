      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of the study was to determine the occurrence of long-term chest wall discomfort in women after coronary artery bypass grafting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective repeated-measures design."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Posthospitalization."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "Fifty-one women who had undergone coronary artery bypass grafting. Data were collected at 12 and 18 months by self-report and data collection instruments."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INSTRUMENTS",
          "content": "Life Orientation Test, Satisfaction with Life Scale, Profile of Mood States, Sickness Impact Profile, interview schedule, and discomfort scale 0 to 10."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Women who had an internal mammary artery graft had significantly (p = 0.003) more discomfort. Most discomforts were intermittent and did not interfere with daily activities. However, the feelings of numbness and itchiness tended to be continuous."
        }
      ]},
