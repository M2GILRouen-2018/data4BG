      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the expression of GIRK4 gene in the kidney tissues of obese rats."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Obese rat models were established using diet-induced method. The GIRK4 protein expression in kidney tissues was determined in 20 obese rats and 10 normal rats using Western blot analysis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The relative expression level of GIRK4 protein in the kidney tissues of obese rat (1.75±0.42) was significantly lower than that in normal rats (3.37±0.68, P<0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "GIRK4 has a low protein expression in the kidney tissues of obese rat."
        }
      ]},
