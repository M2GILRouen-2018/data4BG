      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To establish the prevalence of chronic widespread pain and associated symptoms in a general population sample."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Cross sectional postal survey of 2,034 adults in the north of England."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The point prevalence of chronic widespread pain was 11.2%. The symptom was strongly associated with other somatic complaints and with measures of depression and anxiety."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In the general population, this cardinal symptom of fibromyalgia is common and identifies a group who are more likely also to report symptoms of fatigue and depression."
        }
      ]},
