      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "Roux-en-Y gastric bypass (RYGB) and sleeve gastrectomy (SG) are 2 of the most widely used bariatric procedures today, in this meta-analysis, both techniques were compared for evaluating the efficacy and safety of the treatment of morbid obesity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Systematic literature search of Cochrane Controlled Trials Register Databases, Medline, Embase, ISI databases, and Chinese Biomedical Literature Database was performed. Statistical analyses were carried out using RevMan software."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Thirty-two recent studies including 6526 patients in total were included in this meta-analysis. Compared with SG, RYGB had significantly better effect in resolving type 2 diabetes mellitus, hypertension, hypercholesterolemia, gastroesophageal reflux disease, and arthritis. However, RYGB had higher incidence of complications and reoperation, and longer operation time than SG."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "RYGB was more effective than SG in the resolution of obesity-related comorbidities, SG was a safer procedure with a reduced rate of complications and reoperation."
        }
      ]},
