      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The aim of the study was to assess the effect of the cognitive behavior model (CBM)-based psychoeducation and exercise intervention on quality of life (QoL) in alcohol use disorder (AUD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "This study was a non-randomized controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "CBM-based psychoeducation and exercise intervention was applied to the experimental group four times a week for 6weeks; no intervention was applied to the control group."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "No difference was seen between the points of pretest QoL of the experimental and control groups (p>0.05). However, according to the posttest, the experimental group's mean score of QoL was higher than the control groups (p<0.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "It was found that CBM-based psychoeducation and exercise intervention applied to individuals with AUD affected the QoL positively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL RELEVANCE",
            "content": "CBM-based psychoeducation and exercise intervention can be used by nurses to improve AUD individuals' quality of life."
          }
        ]
      },
