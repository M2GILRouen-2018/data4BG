      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Review of oral and poster presentations and of workshop summaries from the Ninth International Forum for Primary Care Research on Low Back Pain held in Majorca, Spain, October 4-6, 2007."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Summarize highlights of the conference."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "The International Forum for Primary Care Research on Low Back Pain has become the primary conference for presenting research on the advances in primary care for back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Distillation of the key themes and findings of the research presented at the Forum."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Presentations at the forum included intervention studies, psychosocial aspects of low back pain, and epidemiological, clinical, and pathologic studies."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The research presented at the forum has contributed to the advancement of understanding of how to improve primary care for low back pain. The Tenth International Forum will occur on June 14-17, 2009, in Boston."
        }
      ]},
