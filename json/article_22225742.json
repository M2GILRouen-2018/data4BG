      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Acute pancreatitis and haemophagocytic syndrome (HS) are rarely seen in systemic lupus erythematosus (SLE)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "We report the case of a young female patient without any noteworthy prior history, who was hospitalised for abdominal pain associated with acute pancreatitis possibly related to SLE with associated haemophagocytic syndrome."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Screening for cutaneous symptoms of lupus in patients with pancreatitis can help avoid diagnostic errors."
          }
        ]
      },
