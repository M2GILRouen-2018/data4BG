      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "The transversus abdominis plane (TAP) block is a new regional anaesthesia technique applicable to infants and children."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE(S)",
          "content": "The present study was designed to evaluate the analgesic efficacy of ultrasound-guided TAP block with high volume local anaesthetic (0.5 \u200aml\u200akg) during the first 24\u200ah after surgery in children undergoing inguinal hernia repair."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomised comparative study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Gaziantep University Hospital between December 2010 and May 2011."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS OR OTHER PARTICIPANTS",
          "content": "Fifty-seven children between 2 and 8 years of age undergoing unilateral inguinal hernia repair were randomised to TAP block (group T, n\u200a=\u200a29) or to wound infiltration (group\u200aC, n\u200a=\u200a28)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "A TAP block using ultrasound guidance with 0.25% levobupivacaine 0.5 \u200aml\u200akg(-1) or wound infiltration with 0.2\u200a ml\u200akg(-1) 0.25% levobupivacaine, was performed on the same side as the hernia under general anaesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Time to first analgesic, cumulative number of doses of analgesic, pain scores and adverse effects were assessed over the course of 24\u200a h."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The time to first analgesic (mean\u200a±\u200aSD) was significantly longer in group T than in group C (17\u200a±\u200a6.8 vs. 4.7\u200a±\u200a1.6\u200ah, respectively; P\u200a<\u200a0.001). Thirteen (45%) patients in group T did not require any analgesic within the first 24\u200ah. The cumulative number of doses of analgesic was significantly lower in group T than in group C (1.3\u200a±\u200a1.2 vs. 3.6\u200a±\u200a0.7, respectively, P\u200a<\u200a0.001). Pain scores were significantly different between the groups at all time points except at 1, 20 and 24 \u200ah (P\u200a<\u200a0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ultrasound-guided TAP block with high volume (0.5\u200aml\u200akg) 0.25% levobupivacaine provides prolonged postoperative analgesia and reduced analgesic use without any clinical side-effects after unilateral hernia repair in children."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "TRIAL REGISTRATION",
          "content": "ACTRN12611000585921\u200a(7/06/2011) from Australian New Zealand Clinical Trials Registry."
        }
      ]},
