      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Academy of Dermatology, Inc. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Mucosal lichen planus (MLP) is a therapeutic challenge in need of a new treatment approach because of its debilitating effect on patient's quality of life."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We sought to evaluate a standardized treatment plan for patients with MLP. A second objective was to describe the effect of mycophenolate mofetil in this patient population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The study retrospectively analyzed 53 patients with MLP treated using a standardized algorithm. The number of MLP lesions, disease activity, and pain at the last visit were compared with baseline scores determined at the initial visit. Results were analyzed using the paired samples t test and confirmed with the Wilcoxon matched pairs signed rank test."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The average number of lesions was reduced from 3.77 to 1.67 (P < .001). The average disease activity was reduced from 2.73 to 0.90 (P < .001). Average pain reported decreased from 2.03 to 1.03 (P < .001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "This study was a retrospective analysis of a small patient population. There was no universal symptom severity scale used at the time of treatment for some patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The standardized treatment plan reduced symptoms for patients with MLP. Mycophenolate mofetil appears to be a reasonable treatment option for these patients."
          }
        ]
      },
