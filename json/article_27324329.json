      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Primary obesity surgery, endoluminal (POSE) is a promising procedure for weight loss surgery because it is outpatient, is incisionless and has short recovery time. We demonstrate the POSE procedure as a potential option for the bariatric patient."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Using an endoluminal camera, we videotaped one of our surgeons performing the POSE procedure. With rows of sutures in the fundus and antrum, the stomach's volume is reduced."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "We demonstrate a successful POSE procedure in its entirety."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The POSE procedure is a promising option for the bariatric patient. Long-term studies are needed to show its efficacy."
        }
      ]},
