      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to describe pain intensity before and after watching funny and unfunny videos on post-surgical pain levels."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Ninety patients were divided into three groups. Group A watched funny videos, Group B watched unfunny videos, Group C did not watch any videos. Pain assessment of the patients was carried out before (first), immediately after (second), and 30 min after (third) watching videos."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The first pain scoremean in Group A was 40.83 ± 22.62, in Group B was 37.46 ± 24.31, in Group C was 48.86 ± 24.06. The second pain scoremean in Group A was 32.93 ± 20.28, in Group B was 29.76 ± 20.26, in Group C was 48.96 ± 24.11. The third pain scoremean in Group A was 37.43 ± 23.07, in Group B was 36.80 ± 22.67, in Group C was 52.30 ± 23.97."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Watching funny or unfunny videos reduces the post-surgical pain level."
          }
        ]
      },
