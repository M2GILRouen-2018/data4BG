      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Validation of the Spanish version of the Asthma Control Test (ACT)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 607 asthmatic patients were assessed. The psychometric properties of ACT were evaluated. The ACT capacity to predict the physician's assessment of asthma control was assessed using the area under the receiving operating characteristics (ROC) curve (AUC), sensitivity, specificity, and positive-negative predictive values."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "ACT's Cronbach alpha was 0.84. The intraclass correlation coefficient was 0.85. The AUC was 0.86, with a sensitivity of 71% and a specificity of 85% for a score of < or =19."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The Spanish version of ACT is shown to be a reliable and valid tool for evaluating and discriminating asthma control."
        }
      ]},
