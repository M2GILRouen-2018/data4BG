      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To elucidate the fetal origins of hypertension."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A systematic search was made for records of early growth, comprising measurements taken either at birth and/or during infancy, for groups of men and women now in middle-late life. Over 25,000 men and women born before 1931 were successfully traced."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Retarded growth in fetal life was strongly related to high blood pressure in adult life."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Hypertension is programmed by an adverse environment in utero. It is linked to impaired development in both early and late gestation."
        }
      ]},
