      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE OF REVIEW",
          "content": "To present the recent literature on chronic postsurgical pain in children."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RECENT FINDINGS",
          "content": "Chronic postsurgical pain is an important problem in children, however, with a lower prevalence than in adults."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "The literature on the topic is sparse. Prospective studies, including clinical examination, quantitative sensory testing, and long-term follow-up, are needed to increase our knowledge about the prevalence, risk factors, and underlying mechanisms."
        }
      ]},
