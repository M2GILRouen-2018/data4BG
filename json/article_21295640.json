      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 American Society for Gastrointestinal Endoscopy. Published by Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "EUS-guided celiac plexus neurolysis (EUS-CPN) improves pain control in patients with pancreatic cancer. EUS allows visualization of the celiac ganglion."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine predictors of response to EUS-CPN in a cohort of 64 patients with pancreatic malignancy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective analysis of prospective database."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Academic medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Sixty-four patients with pancreatic cancer referred for EUS between March 2008 and January 2010."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "EUS-CPN injected directly into celiac ganglia when visible by linear EUS or bilateral injection at the celiac vascular trunk."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASUREMENTS",
            "content": "Predictors of pain improvement at week 1 by univariate and multivariate analysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "At week 1, 32 patients (50%) had a symptomatic response. In a multivariate model with 8 potential predictors, visualization of the ganglia was the best predictor of response; patients with visible ganglia were >15 times more likely to respond (odds ratio 15.7; P<.001). Tumors located outside the head of the pancreas and patients with a higher baseline pain level were weakly associated with a good response."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "Retrospective design and lack of blinding."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Visualization of celiac ganglia with direct injection is the best predictor of response to EUS-CPN in patients with pancreatic malignancy."
          }
        ]
      },
