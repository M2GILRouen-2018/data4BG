      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the efficacy of intravenous lorazepam as premedication for bone marrow aspiration and biopsy (BMAB)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, double-blind, placebo-controlled."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "One hundred and thirty-eight consenting patients planned to receive BMAB."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Patients were randomly assigned to receive either intravenous lorazepam 1 mg or placebo just prior to BMAB."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary referral center, inpatient setting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "A questionnaire was used to determine the patient perception about the procedure and pain at baseline, which was completed just after the procedure, and the next day after the BMAB. Pain was rated using a 10-cm linear visual analog scale (VAS)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The mean VAS scores measured during the BMAB examination were 6.0 for lorazepam vs 6.2 for placebo. Few adverse events were noted during intravenous lorazepam administration. The patients in the lorazepam group were more likely to accept the next BMAB (P = 0.044)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Intravenous lorazepam was safe in patients undergoing BMAB and was more effective than placebo in enhancing cooperation during BMAB and willingness to undergo another procedure. However, use of lorazepam 1 mg provided no reduction in the pain associated with BMAB. Further studies should focus on providing appropriate analgesia for this potentially painful procedure."
        }
      ]},
