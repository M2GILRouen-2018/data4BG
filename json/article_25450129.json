      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine the feasibility and safety of implementing a 12-week rehabilitation program after mesenchymal stromal cell (MSC) transplantation augmented by vascularized bone grafting for idiopathic osteonecrosis (ION) of the femoral head."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A prospective case series."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University clinical research laboratory."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Participants (N=10) with ION who received MSC transplantation augmented by vascularized bone grafting."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "A 12-week exercise program, which included range-of-motion (ROM) exercises, muscle-strengthening exercises, and aerobic training."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Measures of ROM, muscle strength, Timed Up and Go test, and Medical Outcomes Study 36-Item Short-Form Health Survey (SF-36) were collected before surgery and again at 6 and 12 months after surgery."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "All participants completed the 12-week program. External rotation ROM as well as extensor and abductor muscle strength significantly improved 6 months after treatment compared with that before treatment (P<.05). Significant improvements were also seen in physical function, role physical, and bodily pain subgroup scores of the SF-36 (P<.05). No serious adverse events occurred."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This study demonstrates the feasibility and safety of a multiplex rehabilitation program after MSC transplantation and provides support for further study on the benefits of rehabilitation programs in regenerative medicine."
          }
        ]
      },
