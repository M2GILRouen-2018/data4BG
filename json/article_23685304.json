      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A 63-year-old man was referred for cardiac catheterisation for typical angina. At angiography, high-grade stenosis of the first diagonal branch, of the proximal circumflex and of an intermediate branch was found. After treatment of the diagonal branch, fractional flow reserve of the circumflex and intermediate branch was negative, but symptoms persisted."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INVESTIGATION",
          "content": "Physical examination, laboratory test, stress echocardiography, fractional flow reserve, coronary flow reserve."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DIAGNOSIS",
          "content": "Complex interaction between epicardial stenosis and microvascular hyporeactivity."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MANAGEMENT",
          "content": "Stenting."
        }
      ]},
