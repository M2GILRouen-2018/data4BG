      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "This study examines the prevalence of cardiovascular risk factors and chronic disease burden among African Americans compared to Caucasians in a population of higher socioeconomic status."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "The current study is a cross-sectional, secondary data analysis of the Cooper Center Longitudinal Study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Patients with a medical examination from 1970-2010 at the Cooper Clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "762 African Americans and 40,051 Caucasians who met the criteria."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Racial differences in cardiovascular risk factors/burden of disease between African Americans and Caucasians."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "African Americans had higher prevalence of evaluated cardiovascular risk factors than did Caucasians after controlling for obesity, tobacco use, and physical fitness. Caucasians had greater likelihood of no risk factors while African Americans were more likely to have all three risk factors. Race was typically predictive of cardiovascular risk factors in African Americans compared to Caucasians."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Findings suggest that health differences persist despite greater socioeconomic status, and further investigations of biopsychosocial causes are warranted."
        }
      ]},
