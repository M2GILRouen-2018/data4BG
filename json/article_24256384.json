      "Abstract": {
        "CopyrightInformation": "© 2015 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim of this study was to investigate the 25-hydroxyvitamin D [25(OH)D] status of children with growing pains and to evaluate the efficacy of vitamin D treatment on the resolution of pain symptoms."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS AND METHODS",
            "content": "One hundred and twenty children with growing pains were included in a prospective cohort study. Serum 25(OH)D and bone mineral levels were measured in all subjects at the time of enrollment. The pain intensity of those with vitamin D deficiency was measured using a pain visual analog scale (VAS). After a single oral dose of vitamin D, the pain intensity was remeasured by means of the VAS at 3 months. The 25(OH)D levels and VAS scores before and after oral vitamin D administration were compared by means of a paired Student's t test."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In the 120 children with growing pains, vitamin D insufficiency was noted in 104 (86.6%). Following vitamin D supplementation, the mean 25(OH)D levels increased from 13.4 ± 7.2 to 44.5 ± 16.4 ng/ml, the mean pain VAS score decreased from 6.8 ± 1.9 to 2.9 ± 2.5 cm (a mean reduction of -3.8 ± 2.1, p < 0.001) and the difference was statistically significant."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Supplementation with oral vitamin D resulted in a significant reduction in pain intensity among these children with growing pains who had hypovitaminosis D."
          }
        ]
      },
