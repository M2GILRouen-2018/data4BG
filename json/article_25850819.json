      "Abstract": {
        "CopyrightInformation": "© 2015 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CONTEXT",
            "content": "Although research indicates that nonsuicidal self-injury (NSSI) may be used as a form of emotion regulation, studies have largely relied on the use of retrospective self-report data, which limits inferences about directionality of effects. Recently, researchers have started to employ lab-based experimental (e.g., guided imagery, acute pain) and moment sampling approaches to the study of NSSI."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In the present study, we conducted a review of this recent literature, using several electronic databases (e.g., PsychINFO, ERIC, CINAHL)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We identified 18 studies that met our inclusion criteria. Findings indicated that the administration of pain was associated with decreases in negative affect among both self-injurers and noninjurers, although these declines were more pronounced for self-injurers in some studies."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "We discuss findings within the context of two central theories (i.e., opponent-process theory and distraction theory) and offer several recommendations for future research in this area."
          }
        ]
      },
