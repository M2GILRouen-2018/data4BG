      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM OF THE STUDY",
          "content": "Spinocerebellar ataxia type 3 is the most common cause of autosomal dominant inherited ataxia worldwide."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Clinically, it exhibits wide phenotypic variability. Presentation as isolated dystonia is exceptional."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Here, the case of a woman with writers cramp without ataxia is presented as a paucisymptomatic manifestation of this disease."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This association has not been described to date and extends the clinical variability of the disease."
        }
      ]},
