      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether vitamin E is effective in the treatment of primary dysmenorrhoea."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A randomised placebo-controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "One hundred girls, aged 16-18 years old who suffered from primary dysmenorrhoea, among 1,000 students attending a public high school in Region 5 in the Greater Tehran Municipality."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Fifty girls were given 500 units of vitamin E (five tablets) per day, and 50 were given five placebo tablets per day. The treatment began two days before the beginning of menstruation and continued through the first three days of bleeding. The severity of pain before and after the treatment was studied. Treatment in both groups was carried out in two consecutive menstrual periods."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The severity of pain in the two groups was reduced after treatment, but the reduction was greater in the group treated with vitamin E. These differences were maintained in the second month of therapy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Both placebo and vitamin E are effective in relieving symptoms due to primary dysmenorrhoea, but the effects of vitamin E are more marked."
        }
      ]},
