      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 John Wiley & Sons, Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study aimed to investigate prospective associations between benzodiazepine use and later life satisfaction, sleep difficulties, perceived general health, anxiety symptoms and somatic pain among the elderly."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A 13-year prospective cohort study was conducted in a Norwegian population-based sample of 15\u2009830 elderly individuals. Baseline control measures of the investigated psychological constructs and a wide range of demographic and health-relevant covariates were obtained from the Nord-Trøndelag Health Study (HUNT 2, 1995-1997). Follow-up data were obtained from the third wave (HUNT 3, 2006-2008) of the same epidemiological study. The Norwegian Prescription Database (2004-2008) was used to link pharmacy prescription records of benzodiazepines for each case to the HUNT 2 and HUNT 3 materials."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Use of benzodiazepines was associated with less life satisfaction and more sleep difficulties at follow-up. These tendencies increased by more frequent patterns of use. Benzodiazepine use had relatively weak relations to perceived general health, but intermittent and chronic use was related to higher anxiety symptoms at follow-up. Such patterns were also modestly related to somatic pain at follow-up."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION AND CONCLUSION",
            "content": "Benzodiazepines should be dispensed at a high-threshold policy among the elderly. By developing clear-cut discontinuation plans, clinicians could avoid chronic use and focus on psychosocial treatment for psychological disorders."
          }
        ]
      },
