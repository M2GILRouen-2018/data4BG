      "Abstract": {
        "CopyrightInformation": "© 2012 The Authors. Pediatric Obesity © 2012 International Association for the Study of Obesity.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate the effect of a school-based obesity prevention programme on physical self-perception and key physical-activity related cognitions in adolescent boys from disadvantaged secondary schools. A secondary objective was to determine if any psychological changes were associated with improved weight status."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Participants (n\u2009=\u2009100, age\u2009=\u200914.3[0.6]) were randomized to the PALS (Physical Activity Leaders) intervention (n\u2009=\u200950) or a control group (n\u2009=\u200950) and assessed at baseline, 3- and 6-month follow up. Measures included BMI, BMI z-score and % body fat (bioelectrical impedance analysis). Students also completed the Children's Physical Self-Perception Profile and a physical activity-related cognitions questionnaire. The findings include secondary data analyses."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Relative to the controls, the PALS group significantly increased their physical self worth (p\u2009=\u2009.01), perceived physical condition (p\u2009=\u2009.02), resistance training self efficacy (p\u2009<\u2009.001) and their use of physical activity behavioural strategies (p\u2009=\u2009.02)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A school-based obesity prevention programme that targeted leadership skills improved psychological health in the physical domain in adolescent boys from disadvantaged schools."
          }
        ]
      },
