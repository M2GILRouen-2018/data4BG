      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The current study examined the impact of television and Internet food advertising on Australian parents and children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Parents and their children aged 8 to 14 years were exposed to a television advertisement, an Internet advertisement or a control picture for four commonly advertised energy-dense, nutrient-poor foods."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Online web panel survey, Australia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Parents (n 1302) and their children aged 8 to 14 years (n 1302)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After a single exposure to each advertisement, parent respondents in the two exposure conditions evaluated the products more favourably, had a greater desire to consume the products and thought the product could be consumed more frequently than those in the control condition. Similar trends were observed among children, although the differences were statistically significant only for the frequency of food consumption in the Internet advertisement condition and the evaluation of one product."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The results have implications for assumptions of adults\u2019 immunity to advertising. This is of particular importance in efforts to address child obesity and the reliance on parents to mediate the effects of food advertising."
        }
      ]},
