      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare the use of warm medium and cold medium for alleviating pain and side effects during hysterosalpingography (HSG)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective randomized study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Two hundred infertile women who needed HSG were recruited from January 2010 to June 2011. The exclusion criteria were acute low reproductive duct infection, known hypersensitivity to iodine, genital bleeding, or malignancy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Subjects were randomized to undergo HSG using a medium prewarmed to 37°C or a medium at room temperature."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Incidence of vasovagal episodes and visual analog scale (VAS) pain scores during HSG."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Patients' VAS pain scores during HSG were significantly lower in the warm media group initially but showed no statistical difference at 30 minutes after injection. Medium temperature showed a linear association with VAS score. The total number of vasovagal episodes was higher in the cold medium group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Warm contrast medium alleviates the pain associated with HSG and decreases the incidence of vasovagal episodes during HSG."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CLINICAL TRIALS REGISTRATION NUMBER",
            "content": "NCT01339338."
          }
        ]
      },
