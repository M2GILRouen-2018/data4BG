      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A prospective, single-arm, pre-postintervention study."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of this study was to test the preliminary effectiveness of a patient-led goal-setting intervention on improving disability and pain in chronic low back pain."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "An effective intervention for the treatment of chronic low back pain remains elusive despite extensive research into the area.An intervention using patient-centered goal setting to drive intervention strategies and encourage self-management for patients suffering chronic low back was developed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A single group longitudinal cohort pilot study was conducted. Twenty participants (male\u200a=\u200anine) experiencing chronic low back pain were involved in a patient-led goal-setting intervention, facilitated by a physiotherapist over a 2-month period with two monthly follow-up sessions after treatment conclusion. Participants, guided by the therapist, identified problem areas of personal importance, defined goals, and developed evidence-based strategies to achieve the goals. Participants implemented the strategies independently between sessions. Primary outcome measures of disability and pain intensity were measured at baseline, 2, and 4 months. Secondary measures of quality of life, stress and anxiety, self-efficacy, and fear of movement were also taken."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Significant improvements (repeated analysis of variance P\u200a<\u200a0.05) were seen in measures of disability, pain, fear avoidance, quality of life, and self-efficacy over the period of intervention and were maintained for a further 2 months after treatment conclusion."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This intervention is novel because the goals set are based on patients' personal preferences, and not on treatment guidelines. Our findings confirm that a patient-centered goal-setting intervention is a potentially effective intervention for the management of chronic low back pain showing significant improvements in both quality of life and pain intensity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "LEVEL OF EVIDENCE",
          "content": 4
        }
      ]},
