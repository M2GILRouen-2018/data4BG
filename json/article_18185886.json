      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Suprascapular nerve neuropathy secondary to ganglion cyst impingement has increasingly been found to be a cause of shoulder pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CLINICAL PICTURE",
          "content": "We present 2 patients who complained of dull, poorly localised shoulder pain, which worsened with overhead activities. Magnetic resonance imaging showed ganglion cysts in the spinoglenoid notch."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "TREATMENT",
          "content": "Both patients failed conservative management with physiotherapy and underwent shoulder arthroscopy. One patient underwent arthroscopic decompression of the cyst and the other had open excision of the cyst."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "OUTCOME",
          "content": "Both patients experienced resolution of symptoms within 6 months of surgery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "With appropriate treatment, suprascapular nerve neuropathy secondary to ganglion cyst impingement is a treatable condition with potentially good results."
        }
      ]},
