      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 The Author(s). Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "De novo gastric cancer is a rare complication of liver transplantation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Surgical treatments of 16 cases with different outcomes were reported in the English literature."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "De novo gastric cancer (stage II) was diagnosed as the result of epi-gastric discomfort in a recipient 10 years after liver transplantation. The patient received chemotherapy alone and remained well for 26 months."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "De novo gastric cancer of liver transplantation recipients is a severe complication; early detection and relevant intervention will benefit these recipients."
          }
        ]
      },
