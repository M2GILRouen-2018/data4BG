      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The aim of this study was to explore the issue of perceived barriers for returning to work, based on the experiences and beliefs in a group of disability pensioners with back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Focus groups were used to interview 12 women and five men, aged 38 - 56, who participated in a larger project aiming to help disability pensioners back to work."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The barriers appearing were related to earlier negative experiences, poor self-judgement of work ability and low self-esteem, lack of support from social security authorities and unsuitable economic arrangements. The pensioners also suggested alternative solutions for making a possible return to work."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Our study provides insight into the perceived barriers of returning to work and might be useful in future efforts aiming to help disability pensioners back to work."
        }
      ]},
