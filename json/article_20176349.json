        "CopyrightInformation": "Copyright (c) 2010 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether ectopic pregnancy should be suspected in young women with abdominal pain even after hysterectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case report."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "The patient presenting with abdominal pain in the emergency department was referred to a tertiary care center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "A young woman who had had a subtotal hysterectomy 3 years prior for atonic postpartum hemorrhage during her last caesarean section presented with acute abdominal pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Urgent ultrasound showed a gestational sac of 9 weeks + 3 days. Emergency laparotomy was done for suspected ectopic pregnancy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Ultrasound, operative findings, and histopathology."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Tubal ectopic pregnancy was confirmed on laparotomy and histopathology."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Early suspicion can avoid missing early and treatable ectopic gestation before life-threatening complications develop."
          }
        ]
      },
