      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Synovial hemangioma is a rare intra-articular benign tumor that is difficult to diagnose because of its nonspecific symptoms. Patients are generally children or young adults with a nontraumatic recurrent swollen painful knee."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE PRESENTATION",
          "content": "A 24-year-old woman presented with a 20-year history of recurrent pain and swelling in the right knee. Physical examination revealed a small painful point adjacent to the medial side of the patella. Magnetic resonance imaging revealed an intra-articular tumor. After arthroscopic examination, surgical excision was performed. The histology was characteristic of synovial hemangioma."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Open complete synovectomy of the circumscribed capillary hemangioma was successful, and the patient remains asymptomatic 2 years after surgery."
        }
      ]},
