      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the quality of life in patients undergoing vertical sleeve gastroplasty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We conducted a historical cohort study including patients with morbid obesity the in the Unified Health System (SUS), registered in the database of the General University Hospital, University of Cuiabá. All patients underwent vertical sleeve gastroplasty and were followed for at least one year after the operation. The study variables were: quality of life, weight loss, improvement of hypertension and diabetes, and mortality."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The sample comprised 41 patients, 13 (31.7%) men and 28 (61.3%) women, mean age was 37 years, the average weight was 136.4 kg and mean BMI 50.3 kg/m²; mean follow-up was 19.1 months (12-32). There was a significant reduction in weight (96.7 kg, p < 0.001) and BMI (35.835 kg/m², p < 0.001). The rate of blood pressure decreased from 56% to 31.7%, and diabetes from 14.6% to 4.8% (p < 0.001). Quality of life improved in 92.5% of patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "There was an improvement in the quality of life in the majority of patients, achieved by means of weight loss and clinical improvement of diabetes and hypertension."
        }
      ]},
