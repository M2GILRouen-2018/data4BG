      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2015.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to evaluate ethnic differences in burden of prevalent geriatric conditions and diabetic complications among older, insured adults with diabetes."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "An observational study was conducted among 115,538 diabetes patients, aged ≥60, in an integrated health care system with uniform access to care."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Compared with Whites, Asians and Filipinos were more likely to be underweight but had substantively lower prevalence of falls, urinary incontinence, polypharmacy, depression, and chronic pain, and were least likely of all groups to have at least one geriatric condition. African Americans had significantly lower prevalence of incontinence and falls, but higher prevalence of dementia; Latinos had a lower prevalence of falls. Except for end-stage renal disease (ESRD), Whites tended to have the highest rates of prevalent diabetic complications."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Among these insured older adults, ethnic health patterns varied substantially; differences were frequently small and rates were often better among select minority groups, suggesting progress toward the Healthy People 2020 objective to reduce health disparities."
          }
        ]
      },
