      "Language": "jpn",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To identify the factors influencing parental medication control behaviors (inhaling corticosteroids and medication-taking) in pediatric asthma management."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A specially-designed questionnaire survey was conducted on 942 parents with asthmatic children in hospitals and elementary schools."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Factor analysis on inhalation behaviors resulted in five factors: understanding of benefit, mastering on inhalation skills and medication management, family support, anxiety of side effects, and explanation from a doctor (cumulative contribution ratio=51.3%). Factor analysis on medication-taking behavior resulted in five factors: understanding of medication effectiveness and benefit, family support, anxiety of side effects, skills on giving medicines, and family routine (cumulative contribution ratio=50.6%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The results indicate the importance of recognizing factors influencing parental medication control behaviors in developing education strategies to maintain and reinforce their asthma management behaviors."
        }
      ]},
