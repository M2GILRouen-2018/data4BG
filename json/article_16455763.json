      "Abstract": {
        "CopyrightInformation": "© 2014 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Compensatory metabolic changes that accompany weight loss, for example, increased ghrelin, contribute to weight regain and difficulty in long-term weight loss maintenance; however, the separate effects of long-term caloric restriction and exercise on total circulating ghrelin in humans are unknown."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A 12-month randomized controlled trial comparing: i) dietary weight loss with a 10% weight loss goal ('diet'; n = 118); ii) moderate-to-vigorous intensity aerobic exercise for 45 min/day, 5 days/week ('exercise'; n = 117); iii) dietary weight loss and exercise ('diet + exercise'; n = 117); or iv) no-lifestyle-change control (n = 87)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "439 overweight or obese postmenopausal women (50-75 y)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Fasting total serum ghrelin was measured by radioimmunoassay at baseline and 12 months. Fasting serum leptin, adiponectin and insulin were also measured."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Fasting total ghrelin significantly increased in the diet + exercise arm (+7·4%, P = 0·008) but not in either the diet (+6·5%, P = 0·07) or exercise (+1·0%, P = 0·53) arms compared with control. Greater weight loss was associated with increased ghrelin concentrations, regardless of intervention. Neither baseline ghrelin nor body composition modified the intervention effects on changes in total ghrelin. The 12-month change in total ghrelin was inversely associated with changes in leptin, insulin and insulin resistance, and positively associated with change in adiponectin."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Greater weight loss, achieved through a reduced calorie diet or exercise, is associated with increased total ghrelin concentrations in overweight or obese postmenopausal women."
          }
        ]
      },
