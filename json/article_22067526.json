      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the relationship between the intake of sugar-containing beverages (SCB) at the age of 13 years and adult weight status 24\u201330 years later."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A longitudinal study with 30 years of follow-up from adolescence (age 13 years in 1976) to adulthood (up to 2000 and 2006). Dietary intake was assessed through cross-check dietary history face-to-face interviews by a dietitian. Beverages were divided into two categories: (i) total SCB and (ii) SCB excluding 100% fruit juices. Percentage of total fat (%total fat) and percentage of trunk fat (%trunk fat) were obtained through dual-energy X-ray absorptiometry measurements; body weight and height were measured by trained staff."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Amsterdam Growth and Health Longitudinal Study, the Netherlands."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "One hundred and fourteen males and 124 females."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In males, but not in females, each additional daily serving of SCB excluding 100% fruit juices at 13 years was associated with 1?14% higher %total fat (95% CI 0?04, 2?23 %; P50?04) and 1?62% higher %trunk fat (95% CI 0?14, 3?10 %; P50?03) in adulthood after correction for confounders. No statistically significant relationship was found between the intake of SCB excluding 100% fruit juices at the age of 13 and BMI in both sexes. In addition, no statistically significant relationships were found between the intake of total SCB and all measures of adult weight status in both sexes."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Intake of SCB excluding 100% fruit juices at the age of 13 years was positively associated with adult %total fat and %trunk fat in males, but not in females."
        }
      ]},
