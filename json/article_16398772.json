      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effectiveness of intrauterine lignocaine as an anaesthetic during endometrial sampling."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomised, double-blind, placebo-controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient gynaecological minor operation unit in a public hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "POPULATION",
          "content": "Two hundred premenopausal women scheduled for endometrial sampling because of abnormal uterine bleeding."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Transcervical intrauterine instillation of 5 mL of 2% lignocaine or 5 mL of normal saline before performing endometrial sampling with vacuum aspirator."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Evaluation of pain associated with the procedure using a visual analogue scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The use of intrauterine lignocaine reduced pain during suction curettage in endometrial sampling."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Transcervical instillation of lignocaine reduced pain during endometrial sampling."
        }
      ]},
