      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine various comfort measures and evaluate their effects in alleviating nipple soreness."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospectively randomized, experimental study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Postpartum unit of a community teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Seventy-three primiparous, postpartum, breastfeeding women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Subjects were randomly assigned to four groups, with all women receiving instruction about breastfeeding and using one of the following treatments: warm moist tea bag compress, warm water compress, expressed milk massaged into the nipple and areola and air dried, instruction only (control group). The subjects completed a questionnaire each morning for 7 days regarding nipple soreness."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Effect of treatments on postpartum nipple pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Subjects in the warm water compress group demonstrated significantly less pain on Day 3 than did the tea or breast milk group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Anticipatory guidance by obstetric nurses may assist breastfeeding women in treating their pain nonpharmacologically."
        }
      ]},
