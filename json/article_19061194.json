      "Abstract": {
        "CopyrightInformation": "(c) 2008 John Wiley & Sons, Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine how spirituality is associated with health-related quality of life (HRQOL) in an ethnically diverse cohort of low-income men with metastatic prostate cancer."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Eighty-six participants in a state-funded program that provides free prostate cancer treatment to uninsured, low-income men completed written surveys and telephone interviews containing validated measures of spirituality, and general and disease-specific HRQOL. Assessments were made following diagnosis of metastatic disease. We used multivariate analyses to assess the effect of spirituality and its two subscales, faith and meaning/peace, on HRQOL."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "African American and Latino men, and men with less than a high-school education had the highest spirituality scores. Spirituality was significantly associated with general and disease-specific HRQOL. We also found a significant interaction between faith and meaning/peace in the physical and pain domains."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Greater spirituality was associated with better HRQOL and psychosocial function. Meaning/peace closely tracks with HRQOL. Higher faith scores, in the absence of high meaning/peace scores, are negatively associated with HRQOL."
          }
        ]
      },
