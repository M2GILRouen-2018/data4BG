      "Abstract": {
        "CopyrightInformation": "Copyright Â© 2016 American Society for Bariatric Surgery. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Weight loss after laparoscopic sleeve gastrectomy (LSG) is multifactorial. Postoperative compliance with appropriate dietary guidance may be affected by psychosocial factors and may influence the success of surgery."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the effect of LSG in siblings compared to case-matched controls."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Siblings who had undergone LSG were compared with controls case-matched by age, sex, and body mass index. The percentage excess weight loss (%EWL) was calculated at 3, 6, and 12 months postoperatively."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We had 32 siblings, of which 4 were lost to follow-up. Thus, 28 (87.5%) siblings completed 1 year of follow-up and were included in the study. In the family group, the %EWL was 72.7±15.0% at 1 year while in the control group the mean %EWL was 62.1±21.4%. Patients in the family group had significantly greater weight loss. Within the family group, the outcomes of family order had no statistically significant difference in weight loss between the first family member who had undergone LSG and subsequent family members. In addition, family members who had resided together in the same home had no advantage over those who resided separately."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Genetic and environmental factors may have great influence on outcomes after bariatric surgery."
          }
        ]
      },
