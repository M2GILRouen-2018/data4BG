      "Abstract": {
        "CopyrightInformation": "© 2011 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Spinal cord stimulation (SCS) has been described in a variety of neuropathic and vasospastic pain conditions including Raynaud's syndrome."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We report here the outcome of single lead SCS in the case of a 49-year-old woman with severe Raynaud's syndrome, which had failed to respond to medical therapy."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "With a single quadripolar cervical lead in midline position at the C2/C3 level sustained pain relief of the bilateral pain was accomplished. Pain scores sank from 7/10 to 2-3/10 on the nominal analog scale and remained stable more than nearly four years by now."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Treatment of bilateral pain in Raynaud's syndrome with SCS in a single technique is feasible. Advantages and disadvantages as compared with stimulation with bilateral leads are discussed."
          }
        ]
      },
