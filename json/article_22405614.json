      "Abstract": {
        "CopyrightInformation": "Copyright Â© 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND CONTEXT",
            "content": "Sacral insufficiency fractures and metastases are a source of severe intractable pain, with limited therapeutic options. Sacroplasty has demonstrable efficacy and safety; sacral kyphoplasty, however, is rarely reported."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To evaluate the safety and efficacy of sacral kyphoplasty for sacral insufficiency fractures and metastases."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Retrospective, with long-term follow-up; rural community-based practice."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT SAMPLE",
            "content": "Patients with sacral insufficiency fractures and metastases."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Numerical pain rating scale, opioid equivalent usage. SELF-REPORT MEASURE: Numerical pain rating scale. FUNCTIONAL MEASURE: Opioid equivalent consumption."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Retrospective analysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Statistically significant improvement in pain; overall, an improvement in opioid consumption."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Sacral kyphoplasty appears to be a safe and efficacious procedure, comparable to sacroplasty, in the treatment of SIFs and sacral metastases."
          }
        ]
      },
