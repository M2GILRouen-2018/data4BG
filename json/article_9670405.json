      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case report of pseudomeningocele with nerve root entrapment after lumbar discectomy."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To report a rare cause of recurrent sciatica."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A unique case of delayed nerve root entrapment within the neck of an iatrogenic pseudomeningocele is described. The relevant literature is reviewed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This case illustrates the possible consequences of not repairing a dural tear and reinforces the importance of a careful surgical approach to the lumbar spine."
        }
      ]},
