      "Abstract": {
        "CopyrightInformation": "© The Author 2016. Published by Oxford University Press. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Non-alcoholic fatty liver disease is the commonest cause of liver disease worldwide, and is rapidly becoming the leading indication for liver transplantation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SOURCES OF DATA",
            "content": "Original articles, reviews and meta-analyses, guidelines."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "AREAS OF AGREEMENT",
            "content": "NAFLD strongly correlates with obesity and insulin resistance; currently, the best management strategy is weight loss and treatment of the metabolic syndrome."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "AREAS OF CONTROVERSY",
            "content": "Recent data suggest that the presence of fibrosis and not non-alcoholic steatohepatitis (NASH) is the predictor of clinical outcome."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "GROWING POINTS",
            "content": "Many phase 2 and 3 trials are underway. Drugs hoped to be effective are obeticholic acid, elafibranor, glucagon-like peptide-1 analogues and CCR2/5 inhibitors."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "AREAS TIMELY FOR DEVELOPING RESEARCH",
            "content": "Improved understanding of the pathophysiology of NAFLD should help us identify which patients progress to significant liver disease and to develop therapies to target this population."
          }
        ]
      },
