      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier España, S.L.U. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "INTRODUCTION AND OBJECTIVE",
            "content": "Fatigue and balance impairment leads to a loss of independence and are important to adequately manage. The objective of this study was to examine the effects of a resistance training program on dynamic balance and fatigue in patients with Parkinson's disease (PD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Randomized controlled trial. Forty-six patients with PD were randomly allocated to an intervention group receiving a 8-week resistance training program focused on lower limbs or to a control group. Balance was assessed using the Mini-BESTest and fatigue was assessed by the Piper Fatigue Scale."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patients in the intervention group improved significantly (p<0.05) on dynamic balance (reactive postural control and total values) and perceived fatigue."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "An 8-week resistance training program was found to be effective at improving dynamic balance and fatigue in patients with PD."
          }
        ]
      },
