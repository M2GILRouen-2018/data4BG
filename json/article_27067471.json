      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Poor patients experience more serious complications and worse outcomes after surgery than higher-income patients. Our objective was to study detailed patient sociodemographic characteristics and preoperative/postoperative patient-oriented outcomes in economically disadvantaged and non-economically disadvantaged primary total joint arthroplasty patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "From a consecutive series, 213 economically disadvantaged patients and 1940 non-economically-disadvantaged patients were statistically analyzed. Baseline sociodemographic characteristics and pain visual analog scale, Quality of Well-Being Index 7, Short Form 36, and Western Ontario and McMaster Universities Arthritis Index scores recorded before and after surgery were compared between both groups controlling for baseline differences. Minimum follow-up was 1 year."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Economically disadvantaged patients were significantly younger, more likely to be disabled, and had worse preoperative and postoperative scores."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "When compared with non-economically disadvantaged patients, economically disadvantaged patients consistently had lower function and worse quality of life before and after total joint arthroplasty."
          }
        ]
      },
