      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the efficacy and safety of implantation of multiple drug-eluting stents."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A retrospective study of 151 cases was conducted, including 34 with implantation of at least 3 drug-eluting stents in the coronary artery (MS group), 53 with implantation of two stents (TS group), and 64 with a single stent (OS group). The incidence of major adverse cardiovascular event (MACE) and restenosis was evaluated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No significant difference was found between the 3 groups in the incidence of MACE or in the stent thrombosis rate 30 days after the implantation. Follow-up of the patients for 6 months still showed comparable restenosis rate and MACE incidence between the 3 groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Implantation of multiple drug-eluting stents does not increase the risk of restenosis or MACE, and has comparable safety and efficacy with implantation of single and two stents."
        }
      ]},
