      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Society of PeriAnesthesia Nurses. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "Patients who have surgery may experience distress in the following days. Although postoperative distress is a common experience, few studies have analyzed these patient complaints in-depth. The purpose of the present study was to analyze the potential causes of patients' discomfort after abdominal surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "This was a prospective and observational study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Patients (N = 131) were asked to rate their discomfort twice using a list of nine items in the first 6 to 8 hours after surgery and at 24 hours after its completion. Participants were asked to score intensity from 0 (absent) to 10 (unbearable)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "The main causes of discomfort at 24 hours were pain (82%), movement restriction (79%), and dry mouth (70%). These items also had the highest scores (by gender, women scored higher than did men in insomnia, dry mouth, and abdominal distension). No significant differences were observed between patients who had undergone open or laparoscopic surgery."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "It was concluded that pain, movement restriction, and dry mouth were the most disturbing causes of discomfort. Therefore, symptoms other than pain should be considered to improve the well-being of patients after abdominal surgery."
          }
        ]
      },
