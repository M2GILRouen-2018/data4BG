      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this critical review is to provide insight into the main outcomes of research on communication about nutrition and/or physical activity between GPs and patients for prevention or treatment of overweight and obesity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Relevant studies were identified by a computerized search of multiple electronic databases (MEDLINE, PsycINFO) for all available papers between 1 January 1995 and 1 January 2012. In addition, two independent reviewers judged all studies on ten quality criteria."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In total, 41 studies were retrieved. More studies were found about the guidance of obese patients than of overweight patients. The most common weight guidance practice was discussion of weight. The range of communication strategies for nutrition showed to be more diverse than for physical activity. Twelve studies were considered as high-quality studies, 18 were having medium quality, and 11 were seen as low quality."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "We reflected on the fact that the content of advice about nutrition and physical activity was quite general. GPs' provision of combined lifestyle advice to overweight and obese patients seems to be rather low."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Observational research is needed to unravel the quality of the advice given by GPs to overweight and obese patients."
          }
        ]
      },
