      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "There is limited evidence for effective obesity treatment programs that engage men."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This study evaluated the efficacy of two gender-tailored weight loss interventions for men, which required no face-to-face contact."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This was a three-arm, randomized controlled trial: (1) Resources (n = 54), gender-tailored weight loss materials (DVD, handbooks, pedometer, tape measure); (2) Online (n = 53), Resources materials plus study website and e-feedback; and (3) Wait-list control (n = 52). The interventions lasted 3 months and were grounded in Social Cognitive Theory."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At 6 months, significantly greater weight loss was observed for the Online (-4.7 kg; 95 % CI -6.1, -3.2) and Resources (-3.7 kg; 95 % CI -4.9, -2.5) groups compared to the control (-0.5 kg; 95 % CI -1.4, 0.4). Additionally, both intervention groups significantly improved body mass index, percent body fat, waist circumference, blood pressure, physical activity, quality of life, alcohol risk, and portion size, compared to controls."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Men achieved significant weight loss after receiving novel, minimal-contact, gender-tailored programs, which were designed for widespread dissemination."
        }
      ]},
