      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A 60-year-old man with a history of atherosclerotic disease of the carotid and coronary vasculature presented with lower back pain and acute renal failure. Imaging studies revealed bilateral ureteral obstruction by a large retroperitoneal mass."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INVESTIGATIONS",
          "content": "Physical examination, urine and blood analysis, catheterization, radiography of the chest, abdominal and pelvic CT, magnetic resonance angiography, renal ultrasound and biopsy of mass."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DIAGNOSIS",
          "content": "Retroperitoneal fibrosis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MANAGEMENT",
          "content": "Ureteral stenting, laparoscopic ureterolysis, and immunosuppressive therapy with prednisone and mycophenolate mofetil."
        }
      ]},
