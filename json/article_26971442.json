      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "to describe the frequency, severity and persistence of dyspareunia in the first 18 months after the birth of a first child."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "prospective pregnancy cohort study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Melbourne, Victoria, Australia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "POPULATION",
            "content": "1507 nulliparous women."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "women ≤24 weeks gestation were recruited from six public hospitals. Self-administered written questionnaires were completed at recruitment and at three, six, 12 and 18 months post partum."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "study-designed self-report measure of dyspareunia on first vaginal sex, and on second and subsequent sex at all time-points, utilising the rating scale from the McGill Pain Intensity Scale."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "overall, 961/1122 (85.7%) of women experienced pain on first vaginal sex postnatally. The proportion of women experiencing dyspareunia reduced over time, from 431/964 (44.7%) at three months post partum to 261/1155 (22.6%) at 18 months post partum. Of the women who reported dyspareunia at each time-point, around 10% of women described the pain as׳distressing׳,׳horrible׳ or׳excruciating׳. Women who had a caesarean section were more likely to report more intense dyspareunia at six months post partum (aOR=2.35, 95% CI=1.2-4.6)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "postnatal dyspareunia decreases over time, but persists beyond 12 months for one in five women. Caesarean section appears to be associated with more intense dyspareunia."
          }
        ]
      },
