      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effectiveness of a six-week outpatient program in pain management for patients with chronic back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective review."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Rehabilitation Clinical Business Unit, Essendon campus of the Royal Melbourne Hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "138 consecutive patients who participated in the unit's Chronic Back Pain Programme between 1991 and 1993."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Multidisciplinary program that promoted pain management rather than \"cure\", with two six-hour group sessions per week for six weeks."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Patient assessments before the program and at program completion and at three months' follow-up, with the West Haven-Yale Multidimensional Pain Inventory (WHYMPI) and a four-minute walk test."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At program completion, the WHYMPI showed significant decreases in the amount pain interfered with life and significant increases in patient sense of control and activity level. However, severity of pain remained the same. All these effects were maintained three months later."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A brief outpatient program was effective in improving pain management in a group of chronic back pain sufferers. This seems a useful and relatively inexpensive option in managing this problematic group of patients."
        }
      ]},
