      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate and compare the effects of neuromuscular electrical stimulation combined with conventional physical therapy on muscle thickness in critically ill patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Double-blind, randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Twenty-five patients participated in the study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Patients on mechanical ventilation for 24-48 h were randomized to an intervention group (neuromuscular electrical stimulation\u2009+\u2009conventional physical therapy) or a conventional group (sham neuromuscular electrical stimulation\u2009+\u2009conventional physical therapy). Primary outcome was thickness of the rectus abdominis and chest muscles, determined on cross-sectional ultrasound images before and after the intervention."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Eleven patients were included in the intervention group and 14 in the conventional group. After neuromuscular electrical stimulation, rectus abdominis muscle thickness and chest muscle thickness were preserved in the intervention group, whereas there was a significant reduction in thickness in the conventional group, with a significant difference between groups. There was a significant difference between groups in length of stay in the intensive care unit, with shorter length of stay in the intervention group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "There was no change in rectus abdominis and chest muscle thickness in the intervention group. A significant decrease was found in these measures in the conventional group."
        }
      ]},
