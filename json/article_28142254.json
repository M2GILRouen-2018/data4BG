      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "We investigated the diffusion of transcatheter aortic valve implantation (TAVI) since its introduction into the Italian market aimed at identifying the potential drivers of uptake and diffusion at hospital and regional levels."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS & METHODS",
          "content": "We estimated the determinants of TAVI diffusion in Italy from 2007 to 2015 with a regression analysis based on registry data."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Since 2007, TAVI has shown significant diffusion rates in Italy. The diffusion is positively correlated with implanting centers' experience and with the presence of key opinion leaders. Regional recommendations on the use of TAVI negatively influence the diffusion. Reimbursement policies do not exert a relevant impact."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Learning effect seems to be the major driver of TAVI diffusion in Italy."
        }
      ]},
