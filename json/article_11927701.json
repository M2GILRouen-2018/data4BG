      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "This study identifies a behavioral and nonpharmacologic means of preventing newborn pain."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether breastfeeding is analgesic in newborn infants undergoing heel lance-a routine, painful, hospital procedure."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective, randomized, controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Hospital maternity services at Boston Medical Center, Boston, Massachusetts, and Beverly Hospital, Beverly, Massachusetts."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "A random sample of 30 full-term, breastfed infants."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Infants in the intervention group were held and breastfed by their mothers during heel lance and blood collection procedures for the Newborn Screening Program Blood Test. Infants in the control group experienced the same blood test while receiving the standard hospital care of being swaddled in their bassinets."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOMES MEASURES",
          "content": "Crying, grimacing, and heart rate differences were analyzed between the breastfeeding and the control infants before, during, and after blood collection."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Crying and grimacing were reduced by 91% and 84%, respectively, from control infant levels during the blood collection. Heart rate was also substantially reduced by breastfeeding."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Breastfeeding is a potent analgesic intervention in newborns during a standard blood collection."
        }
      ]},
