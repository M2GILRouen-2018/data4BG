      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 SEPAR. Published by Elsevier Espana. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The association between some factors of the familial and social environment with smoking in non-student adolescents with asthma has not been explored. The aim of the study was to determine the association between family structure, educational level, parental approval of smoking, parents who smoke, and smoking friends with smoking in non-student adolescents with asthma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS AND METHODS",
            "content": "In a cross-sectional study, data were obtained by means of a structured questionnaire applied to 4,778 non-student adolescents aged 13-18 years. Diagnosis of asthma was performed using a questionnaire based on the International Study of Asthma and Allergy in Childhood questionnaire. The smoking habit was determined by application of a self-administered questionnaire. Odds ratios (OR) were determined for smoking using logistic regression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "From the total sample, asthma prevalence was 6.6% and of active smoking, 34.2%. Age at initiation of asthma symptoms was 5.15±3.52 years, and that of active smoking was 13.65±2.07 years. Percentage of non-intact family (40.1 vs. 32.7%) was greater in the group of adolescents with asthma. Logistic regression models show that parental approval of smoking (adjusted OR=5.57; 95% confidence interval=2.48-12.51) and smoking friends (adjusted OR=2.92; 95% confidence interval=1.04-8.19) are associated with smoking in non-student adolescents with asthma."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "In this study, parental approval of smoking and having friends who smoke appear to be associated with smoking among non-student adolescents with asthma."
          }
        ]
      },
