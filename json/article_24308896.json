      "Abstract": {
        "CopyrightInformation": "© 2013 Published by Elsevier B.V.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Atopy, a common disorder characterized by a sensitivity to allergic reactions, affects a large proportion of the adult population and, as with depression, is associated with immune-inflammatory pathway changes. We sought to determine the role of atopic disorders in depression using data from a randomly-selected, population-based study of men and women."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Cross-sectional data derived from the Geelong Osteoporosis Study for 942 males and 1085 females were analyzed. Depression [major depressive disorder (MDD), minor depression and dysthymia] was assessed using the Structured Clinical Interview for DSM-IV-TR Research Version, Non-patient edition. Data on medical conditions, including atopic disorders (asthma, hay fever and eczema), smoking status, alcohol consumption, socioeconomic status, and physical activity were documented by self-report. Logistic regression modeling was used to explore the associations between atopic disorders and depression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Atopic disorders were associated with a 59% increased likelihood of depression [gender and smoking-adjusted odds ratio (OR) 1:50, 95% CI 1.20-1.97]. Sub-group analyses revealed a similar pattern for those with MDD [gender and smoking-adjusted OR 1:54, 95% CI 1.22-1.94]. These associations were independent of socio-demographic characteristics, clinical and lifestyle factors."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "Reliance on self-report for allergic symptoms and cross-sectional nature of study."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This population-based study provides evidence of the potential contribution of allergic disorders to depression. Further research is required to elucidate the direction of this association and to further explicate its underlying physiology, including immune-inflammation markers."
          }
        ]
      },
