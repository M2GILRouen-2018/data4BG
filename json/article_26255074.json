      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Sociedad Española de Oftalmología. Published by Elsevier España, S.L.U. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "78 year-old female patient being investigated for a left orbital pseudotumour of 17 days onset. She had proptosis, pain, with no limitation of eye movements, periorbital oedema, and upper eyelid ptosis, compatible with an orbital pseudotumour. The MRI showed an upper outer left orbital mass adjacent to the side of eyeball and an increase in soft tissue at the level of lacrimal gland. The histopathology study of an eyelid lesion demonstrated the presence of non-caseating granulomas."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "A definitive diagnosis of orbital sarcoidosis was made. Oral treatment with corticosteroids and methotrexate achieved gradual control of the disease."
          }
        ]
      },
