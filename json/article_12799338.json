      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Solid pseudopapillary neoplasm is a rare cystic tumor of the exocrine pancreas. Abdominal pain or discomfort is the most common symptom, usually in young females."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE PRESENTATION",
          "content": "Herein we report the case of an 8 - year old child presenting with symptoms of gastric outlet obstruction."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A solid pseudopapillary neoplasm of the pancreatic caput was diagnosed and surgically removed."
        }
      ]},
