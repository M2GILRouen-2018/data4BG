      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "This study aims to assess the predictive role of the preprocedural circulating monocyte to high-density lipoprotein (HDL) cholesterol ratio (MHR) on the occurrence of stent restenosis (SR) in patients with stable and unstable angina pectoris undergoing successful bare-metal stenting (BMS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS & METHODS",
          "content": "Between February 2008 and June 2014, a total of 831 patients with stable and unstable angina pectoris who underwent successful BMS were retrospectively analyzed. Demographic and clinical characteristics of the patients were recorded. Left ventricular ejection fraction and laboratory data were also noted."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In the receiver operating characteristics curve analysis, MHR >14 had 71% sensitivity and 69% specificity in predicting SR."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Our study results show that preprocedural MHR is an independent predictor of SR in this patient population."
        }
      ]},
