      "Abstract": {
        "CopyrightInformation": "© 2016 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Charcot-Marie-Tooth neuropathy (CMT) 2E/1F is caused by mutations in the neurofilament light-chain polypeptide (NEFL) gene. Giant axons are a histological hallmark frequently seen in nerves of patients with CMT2E."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We describe the case of a 43-year-old patient with a painful, predominantly sensory neuropathy."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The patient's sural nerve biopsy showed multiple giant axons. Genetic sequencing of the NEFL gene revealed that the patient was heterozygous for an altered sequence of the gene, c.816C>G, p.Asn272Lys, which has not yet been described in CMT2E/1F."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "In contrast to other cases of CMT2E/1F, where motor symptoms are predominant, pain was the most disabling symptom in this patient. Muscle Nerve 55: 752-755, 2017."
          }
        ]
      },
