      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Two cases of intraspinal metallosis causing delayed neurologic symptoms secondary to spinal instrumentation surgery are reported."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To present an unusual delayed neurologic complication after spinal instrumentation surgery."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Metal-related complications caused by orthopedic implants have long been a concern in the field of arthroplasty or internal fixation of fractures, but no such complications have been reported for spinal instrumentation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Retrospective case report of two patients with degenerative scoliosis who presented with delayed neurologic symptoms months to years after uneventful, but without secondary degenerative changes or dislodgement of the implants."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In both reported cases, a granulation-tissue mass characterized by marked metallosis had been formed in the spinal canal adjacent to a loosened laminar hook."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Intraspinal metallosis should be kept in mind as a rare cause of delayed neurologic symptoms after spinal instrumentation surgery. With the metal implants in place, myelography was the sole informative examination for diagnosis."
        }
      ]},
