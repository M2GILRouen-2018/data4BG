      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe the effect and mechanism of Tianyuan Ketong recipe (TKR) on the pain reaction in formalin induced pain model rats."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The analgesic effect of TKR was evaluated using pain behavior graded scoring, the c-fos gene expression and P substance contents in superficial lamella of spinal cord dorsal horn in model rats were analyzed by means of immunohistochemical analysis and computer image analysis technique."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "TKR could markedly inhibit the pain reaction in model rats (P < 0.05), and the pain induced elevation of c-fos expression and P substance contents could also be suppressed (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "TKR shows definite analgesic effect on formalin induced pain model rats, the reduction of neuron's reaction in spinal cord dorsal horn to afferent noxious stimulation is possibly one of the pathways for its analgesic effect."
        }
      ]},
