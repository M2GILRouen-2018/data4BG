      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To evaluate the effectiveness of chiropractic and massage therapy for the reduction of any type of pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Systematic reviews of chiropractic and massage as a means of pain control were located and evaluated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Six systematic reviews were found, 4 of chiropractic and 2 of massage therapy. Promising evidence emerged from some of these reviews but neither for chiropractic nor for massage was there fully convincing evidence for effectiveness in controlling musculoskeletal or other pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "The notion that chiropractic or massage are effective interventions for pain control has not been demonstrated convincingly through rigorous clinical trials."
        }
      ]},
