      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright 2010 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the efficacy of multimodal intraoperative analgesia in reducing postoperative pain and/or opioid requirements in women undergoing laparoscopic excision of endometriosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, randomized, double-blind, placebo-controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Endogynecologic department of a university teaching hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Women booked for laparoscopic excision of endometriosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Intraoperative multimodal analgesia versus placebo. Analgesia consisted of Diclofenac sodium 100 mg suppository per rectum and 0.75% Ropivacaine to portal sites, subperitoneally under excision sites and topically to each subdiaphragmatic area."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Postoperative total hospital opioid analgesic requirements and postoperative pain intensity."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "The study was terminated prematurely, after a planned interim analysis (which included 66 randomized patients or 43% of the planned number of patients) found significantly less total hospital opioid requirements in the analgesic group compared with the placebo group (19.0 mg vs. 34.5 mg; difference -14.0 mg [95% confidence interval -26.0 to -2.0 mg]). There was no difference in postoperative pain intensity between the two groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "The use of multimodal intraoperative analgesia at laparoscopic excision of endometriosis reduces postoperative opioid requirements."
          }
        ]
      },
