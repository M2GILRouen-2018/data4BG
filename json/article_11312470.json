      "Abstract": {
        "CopyrightInformation": "Copyright 2001 by W.B. Saunders Company",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the effects of gender on time to extubation after coronary artery bypass graft (CABG) surgery and intensive care unit and hospital length of stay."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective study comparing outcomes as related to gender."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary care university teaching hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Consecutive patients (n = 561; 376 men, 185 women) undergoing CABG surgery between January 1995 and December 1997."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "None."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "Early extubation was possible in 74% of men versus 64% of women (p = 0.03); length of stay was < or =5 days in 60% of men versus 48% of women (p = 0.008); overall postoperative length of stay was 5.7 days for men versus 6.5 days for women (p = 0.003); morbidity and mortality were not significantly different between groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Women undergoing CABG surgery with a standardized fast-track protocol have longer intubation times, intensive care unit length of stay, and hospital length of stay than their male counterparts."
          }
        ]
      },
