      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To carry out chromosomal microarray analysis (CMA) on four fetuses with abnormal karyotypes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Amniotic fluid samples were obtained and subjected to routine G-banded karyotyping analysis. CMA was applied for cultured amniocytes to determine alterations of gene dosage and chromosomal breakpoints."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Abnormal karyotypes were found in the parents of 3 fetuses. Parental karyotypes of the remaining fetus were normal. Imbalance chromosome rearrangements were revealed by CMA in all 4 cases."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "CMA is an effective tool for the evaluation of clinical significance and delineation of the breakpoints involved in complex chromosomal rearrangements."
        }
      ]},
