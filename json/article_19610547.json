      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine if a structured exercise program promotes improved performance on activities of daily living (ADL) and pain perception in patients with chronic low back pain (CLBP)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective pilot study of patients referred to the San Juan VA Medical Center rehabilitation clinics with CLBP from January 1 to March 31, 2001, without neurological deficit or back surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "The therapeutic program consisted of warm up/cool down calisthenics, stretching, back isometric and stabilization exercises and aerobic walking."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INSTRUMENTS",
          "content": "Visual Analog Scale (VAS) and the Quebec Back Pain Disability Scale (QBPDS) were used to measure pain intensity and disability before and after the training period."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Six patients completed the study. Back pain intensity and functional disability decreased immediately upon completing the program, and such changes persisted (statistically significant) upon follow up evaluation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A well guided exercise program can decrease pain intensity perception and disability in patients with CLBP."
        }
      ]},
