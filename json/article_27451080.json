      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Opioid therapy is an increasingly used modality for treatment of musculoskeletal pain despite multiple associated risks. The purpose of this study was to evaluate how preoperative opioid use affects early outcomes after total joint arthroplasty."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A total of 174 patients undergoing total joint arthroplasty were matched by age, gender, and procedure into 3 groups stratified by preoperative opioid use (nonuser, short acting [eg, Vicodin], long acting [eg, Oxycontin])."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Compared to nonusers, preoperative long-acting use was associated with increased postoperative mean opioid consumption (46 mg vs 366 mg mean morphine equivalents, P < .001) and independently predicted complications within 90 days (odds ratio: 6.15, confidence interval: [1.46, 25.95], P = .013)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Preoperative opioid use should be disclosed as a risk factor for complication to patients and taken into consideration by physicians before initiating opioid management."
          }
        ]
      },
