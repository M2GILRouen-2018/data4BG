      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The objective of the study was to collect data on the direct and indirect economic cost of chronic pain among patients attending a pain management clinic in Ireland."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A tertiary pain management clinic serving a mixed urban and rural area in the West of Ireland."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Data were collected from 100 patients using the Client Services Receipt Inventory and focused on direct and indirect costs of chronic pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Patients were questioned about health service utilization, payment methods, and relevant sociodemographics. Unit costs were multiplied by resource use data to obtain full costs. Cost drivers were then estimated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Our study showed a cost per patient of US$24,043 over a 12-month period. Over half of this was attributable to wage replacement costs and lost productivity in those unable to work because of pain. Hospital stays and outpatient hospital services were the main drivers for health care utilization costs, together accounting for 63% of the direct medical costs per study participant attending the pain clinic."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The cost of chronic pain among intensive service users is significant, and when extrapolated to a population level, these costs represent a very substantial economic burden."
          }
        ]
      },
