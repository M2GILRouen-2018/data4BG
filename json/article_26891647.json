      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Traumatic spondylolisthesis at L4-L5 is a rare complication in the spine, which impairs variables related to the functionality of the person affected."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To verify the effects of the Pilates method on strength and muscular resistance, flexibility, postural balance and level of pain in a patient with traumatic spondylolisthesis at L4-L5."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The following evaluations were performed pre and post-intervention: resistance of the flexor and extensor muscles of the trunk; isokinetic peak torque of the extensor and flexor muscles of the knee; hip and torso flexibility; static postural balance; and the visual analog scale of pain. The treatment consisted of three weekly sessions of Pilates, performed over 12 weeks."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was improvement in all the tests, except for one variable related to postural balance."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The Pilates method was effective for improving muscle resistance and strength, flexibility, postural balance and pain, in a patient with traumatic spondylolisthesis at L4-L5."
          }
        ]
      },
