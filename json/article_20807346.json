      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The objectives for presenting these medico-legal forensic case reports are the following: 1) detail three cases where chronic opioid analgesic therapy (COAT) was alleged to cause iatrogenic addiction and/or re-addiction; 2) detail the plaintiff's and defendant's medical experts' opinions on these allegations; and 3) through analyzing these cases, develop some recommendations for future prevention of such allegations during COAT."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Case Reports."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Medico-legal issues surrounding the allegation of iatrogenic addiction were identified in each case."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Before starting COAT, physicians should obtain and document patient informed consent for the risk of addiction/re-addiction with COAT treatment. Patients with a history of addictions pre-COAT should be placed on adherence monitoring immediately on beginning COAT."
          }
        ]
      },
