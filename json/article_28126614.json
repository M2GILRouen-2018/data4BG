      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the main prediction of the Interpersonal Theory of Suicide (IPTS): 3-way-interaction of perceived burdensomeness (PB), thwarted belongingness (TB), and acquired capability (AC) for the prediction of suicidal behavior in a representative population sample."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A total of 2513 participants completed measures of suicidal behavior, TB, PB, acquired capability (AC-FAD), and symptoms of depression and anxiety."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The two-way-interaction of TB and PB, and the three-way interaction of TB, PB and AC-FAD predict suicidality."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "Given the cross-sectional nature of the data, conclusions on causality should be handled carefully."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The main prediction of the IPTS has been proven in a general population sample."
          }
        ]
      },
