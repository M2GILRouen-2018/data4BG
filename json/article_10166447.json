      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the feasibility of home monitoring of patients with cardiac disease or hypertension."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "An improved home electrocardiographic and blood pressure telemonitoring system linked to a central workstation was tested in 10 patients in Macau for 3 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The total number of connections was 1377. Of the automatic alarm connections, 32.5% were false positive, with the percentage of false positives ranging from 7.6 to 54.6 for different patients. Both patients and physicians found the system easy to use."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Further investigation is required to match the number of patients with the system capacity. A more robust dysrhythmia detection algorithm is needed to reduce the number of false alarms. Nevertheless, the results were sufficiently good that the trial is being expanded."
        }
      ]},
