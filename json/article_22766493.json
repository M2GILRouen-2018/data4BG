      "Language": "fre",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "The bronchoconstriction induced by exercise (BIE) in urban black Africans is poorly known. The warm moist air would be a mitigating factor for its occurrence. The objective of this study was to measure the prevalence and determine the associated factors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS AND METHODS",
          "content": "A prospective descriptive and analytical involving 40 student-athletes was conducted from September 12 to 24, 2010. The test was considered positive when the percentage fall in FEV from baseline in pre-test and the smallest value in post-test exceeded 10%."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The prevalence of bronchoconstriction induced by exercise was 40% CI (26.3-55.4). The presence of symptoms of atopy was higher in athletes with an BIE than in those without (66% vs. 33.33% p NS)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The proportion of the BIE in the middle of the black African athlete is as important as that observed in other countries, highlighting the weak influence of climate on its occurrence."
        }
      ]},
