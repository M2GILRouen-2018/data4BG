      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine the incremental ability of different needle electromyography diagnostic criteria to detect lumbar radiculopathy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Blinded cross-sectional study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Subjects aged 55 to 80 years with radiating low back pain (n=48; mean age ± SD, 67.9±7.3y) and who were asymptomatic (n=30; mean age ± SD, 65.4±8y)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Electrodiagnostic evaluation by a blinded electromyographer. A monopolar needle was used to evaluate 5 leg muscles and the lumbar paraspinal muscles."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Presence or absence of radiculopathy using different electrodiagnostic criteria."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "When only positive sharp waves or fibrillations were considered, and at least 2 muscles innervated by the same root level and different peripheral nerves were counted as abnormal, 27.1% (13/48) of participants had positive results for radiculopathy. When at least 30% motor unit action potential changes in the limb muscles were also considered, participants with positive results increased to 45.8% (22/48), which was significant when compared with the first criterion (P=.002). When the mini-paraspinal mapping (MiniPM) test as well as at least a 30% motor unit cutoff was used, participants with positive results increased to 50% (24/48), which was significant when compared with the first criterion (P=.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In addition to the presence of positive sharp waves or fibrillations, considering greater than or equal to 30% motor unit action unit potential changes as well as the MiniPM score maintains good specificity and improves the ability of the needle electromyography study to detect lumbar radiculopathy in subjects with radiating low back pain."
          }
        ]
      },
