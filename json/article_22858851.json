      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "This study reports the anatomopathological classification of Tarlov cysts and the various treatment techniques described in the literature."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The authors present their patient series (19 cases) with a long follow-up (range 9 months to 25 years) treated by cyst remodeling around the root using titanium clips."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The technique is effective in both avoiding cerebrospinal fluid leakage and resolving bladder dysfunction when urinary symptoms are incomplete and discontinuous."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The clipping technique for Tarlov cysts is easy, valid, safe, rapid, and effective."
          }
        ]
      },
