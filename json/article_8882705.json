      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "This was a cross-sectional analytic study of patients with chronic low back pain."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate whether the criteria for internal disc disruption, as adopted by the International Association for the Study of Pain, could be satisfied in patients with chronic low back pain and to test whether there were any conventional clinical features that could identify this condition."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Internal disc disruption has been postulated as an important cause of low back pain. To diagnose this condition, the International Association for the Study of Pain taxonomy requires that pain be reproduced on provocation discography and that computed tomography discography reveal internal disc disruption, provided that as a control, stimulation of at least one other disc fails to reproduce pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Ninety-two consecutive patients with chronic low back pain and no history of previous lumbar surgery were studied. Each patient underwent a standard physical examination. Computed tomography discography was performed at a minimum of two levels."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The diagnostic criteria for internal disc disruption were fully satisfied in 39% of patients, most commonly at L5-S1 and L4-L5. None of the clinical tests used could differentiate between those patients with internal disc disruption and other patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A diagnosis of internal disc disruption can be made in a significant proportion of patients with chronic low back pain, but no conventional clinical test can discriminate patients with internal disc disruption from patients with other conditions."
        }
      ]},
