      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the clinical presentation of patients with benign adnexal tumors who had surgical management and the histopathological types of the tumors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Retrospective data were collected on 110 patients who underwent surgery for benign adnexal tumor from January 1999 through to April 2002, in Sultan Qaboos University Hospital, Sultanate of Oman. The histopathological types of the tumors were also studied."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Abdominal pain was the commonest presenting symptom in 65% of the patients followed by abnormalities of vaginal bleeding. Most of the patients were managed by laparotomy and ovarian cystectomy. The commonest histopathological type was benign mature teratoma in 28% of the patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Benign mature teratoma was the commonest histopathological type. Most of the patients had laparotomy; ovarian cystectomy and recurrences were few."
        }
      ]},
