      "Abstract": {
        "CopyrightInformation": "Copyright © 2009 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "There is a paucity of data concerning the clinical outcome of patients presenting with acute myocardial infarction (AMI) and near-normal coronary angiograms. The purpose of this study was to evaluate the clinical outcome and the prognosis of the patients with near-normal coronary angiograms who were registered in the Korean Acute Myocardial Infarction Registry (KAMIR)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The subjects were divided into three groups according to findings from coronary angiograms performed between September 2005 and November 2006. Among 8510 consecutive AMI patients, 372 patients (Group I) had near-normal coronary arteries, 6136 patients (Group II) had one- or two-vessel disease, and 2002 patients (Group III) had three-vessel or left main disease."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Clinical characteristics, in-hospital mortality, and major cardiac adverse events (MACE) were analyzed. Group I was younger, had the lower prevalence of DM, and showed the higher percentage of previous angina history compared to the other two groups. Group III showed a higher incidence of in-hospital mortality, but there was no significant difference between Group I and Group II (2.6% in Group II and 2.2% in Group I, p=0.952). Furthermore, MACE at 1 month, 6 months and 12 months revealed no significant difference between Groups I and II (12 month MACE: 7.8% in Group I and 12.2% in Group II, p=0.359)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Patients with near-normal coronary angiograms had similar clinical outcomes and prognosis compared with one- or two-vessel diseased patients presenting with an acute myocardial infarction."
          }
        ]
      },
