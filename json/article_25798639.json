      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A 68-year-old male smoker presented with progressive symptoms of vertebrobasilar insufficiency and angina. His past medical history included arterial hypertension, diabetes mellitus, dyslipidaemia as well as diffuse coronary artery disease including left main disease. Of note, he had undergone coronary bypass surgery 12 years earlier utilising the left internal mammary artery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INVESTIGATION",
          "content": "Physical examination, laboratory tests, duplex ultrasound imaging, contrast-enhanced magnetic resonance imaging and coronary angiography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DIAGNOSIS",
          "content": "Severe bifurcation stenosis of the left subclavian and vertebral artery with consecutive subclavian steal syndrome and myocardial ischaemia."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MANAGEMENT",
          "content": "Bifurcation T-stenting using a self-expandable bare metal and a coronary drug-eluting stent."
        }
      ]},
