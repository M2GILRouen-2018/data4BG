      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The pain evoking and pain modulating properties of adenosine were studied at venous and paravascular nociceptors in humans."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In six volunteers, adenosine (3 to 15.10(-3) M) was perfused continuously through vascularly isolated segments of dorsal hand veins or injected into occluded finger veins. The effects of adenosine on pain evoked by intravenous electrostimulation of hand veins were also studied. The subjects rated the pain intensities on a visual analogue scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Adenosine neither evoked pain nor altered the intensities of electrically evoked pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Adenosine does not mediate or modulate pain via venous or paravascular nociceptors. Therefore these nociceptors are unlikely to be involved in adenosine related ischaemia pain."
        }
      ]},
