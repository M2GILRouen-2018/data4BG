      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To present a case of successful laparoscopic resection of adrenal endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University Hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Forty-eight-year-old woman with left-sided abdominal and flank pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Laparoscopic radical adrenalectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Diagnosis and surgical approach to adrenal endometriosis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "There have been two case reports of adrenal endometriosis. Based on a search of Medline and Google for \"adrenal endometriosis,\" this is the first known successful laparoscopic resection of adrenal endometriosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "We report the first case of successful laparoscopic adrenalectomy for the treatment of endometriosis."
        }
      ]},
