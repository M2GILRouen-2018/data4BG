      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Endothelial dysfunction is one of the most important early indicators of atherosclerosis in hypertension (HT) patients. Endocan has been reported to play a role in the pathophysiology of endothelial dysfunction."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We sought to assess whether serum endocan levels are correlated with the presence and severity of coronary artery disease (CAD) in patients with HT."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We measured endocan levels in 164 patients with HT and in 55 controls. The severity of CAD was assessed by the coronary atherosclerosis index scores."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Serum endocan levels were independently correlated with the presence and severity of CAD in HT patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Endocan might function as a useful biomarker for monitoring the development and progression of CAD in HT patients."
        }
      ]},
