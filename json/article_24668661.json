      "Abstract": {
        "CopyrightInformation": "© 2014 Association of Rehabilitation Nurses.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The case study was to determine the effectiveness of tensegrity massage in a patient after mastectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Tensegrity massage was performed in a 50-year-old woman after mastectomy. The purpose of the massage was to normalize the tension of musculo-ligamento-fascial system in the chest, shoulder girdle, and back."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The patient was subjected to a series of six massage sessions, 45 minutes each, twice a week."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "The applied massage therapy contributed to the reduction of the postoperative scar tenderness and painfulness, to the relaxation of the muscular tone within the shoulder girdle, and to the improvement of the patient's general feeling."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Tensegrity massage is an effective therapy in the elimination of pain and abnormal tissue tension induced by extensive scarring after mastectomy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL RELEVANCE",
            "content": "The presented massage procedure had a positive effect immediately after the therapy and after 1-month follow-up."
          }
        ]
      },
