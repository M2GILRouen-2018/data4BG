      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "Children undergoing spinal fusion surgery require sophisticated pain management. This study describes an integrated system of pain management primarily directed by an advanced practice nurse (APN), encompassing both the inpatient and outpatient settings."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND METHODS",
          "content": "A retrospective chart review was conducted. Pain management and patient education began in the hospital. The APN provided telephone-based follow-up and management after discharge."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "An average of four phone calls over 9 days was required per patient. No complications were reported."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "PRACTICE IMPLICATIONS",
          "content": "Results of this study support the APN telephone management of postoperative pain once children are discharged following extensive surgery."
        }
      ]},
