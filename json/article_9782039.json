      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "This study investigated the efficacy of local anaesthetic wound perfusion following day-case inguinal hernia repair."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Seventy-two patients entered a randomized controlled trial with three patient groups: group 1, pump containing bupivacaine; group 2, pump containing normal saline; and group 3, control group without a pump. All patients had a Lichtenstein hernia repair together with ilioinguinal and iliohypogastric nerve blocks and were prescribed oral analgesia. Postoperative pain was assessed over 5 days using a visual analogue scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients who had a local anaesthetic infusion had significantly less pain than either the placebo or control groups. This was greatest during the first 48 h (day 1, P = 0.028 and 0.011 respectively; day 2, P = 0.012 and 0.037 respectively)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A portable infusion pump for the delivery of local anaesthetic reduced pain after day-case inguinal hernia repair."
        }
      ]},
