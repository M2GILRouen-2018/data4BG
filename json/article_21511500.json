      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 AUR. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "RATIONALE AND OBJECTIVES",
            "content": "Percutaneous liver biopsy for tumors performed under local anesthesia is still a painful procedure. The aim of this study was to evaluate the patient's reaction and the analgesic efficacy and safety of an equimolar mixture of oxygen and nitrous oxide (EMONO) inhalation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "A monocenter, prospective, randomized and double-blind controlled study was performed including 99 adult patients undergoing ultrasound controlled liver biopsy for tumors. 50 patients received an EMONO and 49 patients received a placebo. Pain was evaluated by patients before and after the procedure using a Visual Analog Scale."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Analgesic control, defined by the difference between the final and initial VAS scores (Δ), was significantly better in the EMONO group than in the placebo group (Δ = 17.8 ± 25.5 mm vs 30.1 ± 32.6 mm; P = .045. The number of patients who would agree to undergo another liver biopsy under the same conditions was significantly higher in the EMONO group than the placebo group (92.0% vs 75.5%, P = .026). There were no side-effects from the administration of an EMONO."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This study shows that patients receiving an EMONO had a higher analgesic control after percutaneous biopsy of focal liver lesions than patients in the placebo group. Moreover, acceptance of additional biopsies was higher in the EMONO group."
          }
        ]
      },
