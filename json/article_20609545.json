      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The evaluation of patients with pelvic pain is a common task for emergency physicians. Accurate diagnosis of the underlying cause of pelvic pain in women is often difficult given the diversity of pathology that can generate pelvic pain."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To report a rare but clinically significant cause of acute pelvic pain in women."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "We describe a rare case of a periurethral abscess secondary to an infected urethral diverticulum in a 41-year-old woman. She presented to our Emergency Department with pelvic pain, dysuria, and fever of 4 days duration."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Physical examination, imaging studies, and surgery aided in confirming the diagnosis of a periurethral abscess."
          }
        ]
      },
