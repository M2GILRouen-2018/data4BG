      "Language": "ger",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "As patients with severe obstructive sleep apnoea (OSA) have increased cardiovascular morbidity and mortality rates, the prevalence of coronary heart disease (CHD) was investigated in patients with OSA proven by polysomnography (apnoea/hypopnea index > or = 10/h)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "In 440 patients (400 men, 40 women; mean age 55.3 [16-80] years) with OSA proven by polysomnography, the possible diagnosis of CHD was assessed by history, physical examination, ECG at rest and on exercise, one- and two-dimensional echocardiography and, where indicated, myocardial scintigraphy and coronary angiography."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "CHD was demonstrated by angiography in 24.6% (men: 26.4%; women: 7.5%). Adding patients with CHD diagnosed noninvasively, but unconfirmed by angiography, positive correlation was found in 33.2% (men: 34.8%; women: 17.5%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "There was a high prevalence of CHD in patients with OSA. This underlines the importance of careful cardiac diagnosis in patients with OSA."
        }
      ]},
