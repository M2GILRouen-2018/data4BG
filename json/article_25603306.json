      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 The Authors. Published by Elsevier Ltd.. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Pneumoperitoneum frequently results in emergent surgery because it typically indicates an abdominal viscus perforation. However, this may not always be the case. There have been few recent reports in the pediatric population that document cases of pneumoperitoneum which could be considered for non-surgical management."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PRESENTATION OF CASE",
            "content": "This case series presents three different instances of pediatric patients with radiographic evidence of pneumoperitoneum who were subsequently found to have no perforated viscus following surgical intervention."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "We recommend that in the absence of peritoneal signs, fever, leukocytosis, significant abdominal pain, distension, or clinical deterioration, non-operative management be considered in pediatric patients with radiographic signs of pneumoperitoneum."
          }
        ]
      },
