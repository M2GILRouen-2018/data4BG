      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "In patients with type 2 diabetes, the presence of retinopathy is associated with increased cardiovascular disease, regardless of known risk factors for vascular disease."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the association of diabetic retinopathy (DR) and its grades with the presence of subclinical coronary atherosclerosis in patients with type 1 diabetes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A cross-sectional study was conducted with 150 type 1 diabetes individuals asymptomatic for coronary artery disease. They underwent clinical evaluation for microvascular complications and for the presence of coronary artery calcification (CAC)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Severe forms of DR (severe non-proliferative DR and proliferative DR) were associated with CAC (OR: 3.98 95% CI 1.13-13.9, p = 0.03), regardless of known risk factors for cardiovascular disease (age, A1C, hypertension, dyslipidemia and male gender)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Patients with severe forms of DR are at risk for the presence of coronary artery disease regardless of traditional cardiovascular risk factors."
        }
      ]},
