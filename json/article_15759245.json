      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether application of a commercially available static magnetic field would alter the signs and/or symptoms of delayed onset muscle soreness (DOMS) produced by exhaustive eccentric exercise."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A double-blinded, randomized, and placebo-controlled study, with subjects serving as their own controls."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "An outpatient physical therapy and performance center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Twenty-three healthy volunteers (18 women; mean age, 30 y; range, 18-40 y; 5 men; mean age, 29 y; range, 19-39 y)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "After exhaustive eccentric exercise of both the right and left elbow flexor muscle groups, subjects received daily treatment with either a 350G magnet or a placebo device for 5 consecutive days."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Outcome variables, including anthropometric measurements, perceived discomfort, and muscle force production, were compared using linear mixed models."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Arm circumference, relaxed elbow flexion angle, and pain increased, whereas active elbow flexion angle and maximal isometric torque decreased transiently before returning to near baseline. No significant difference in outcome variables existed between the treated and control arms. Participants reported less pain in both treated and control arms after each session, suggesting a placebo effect."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Static magnetic fields were no more effective than placebo in preventing DOMS."
        }
      ]},
