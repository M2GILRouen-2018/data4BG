      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To describe a cause and treatment for chronic unremitting lower abdominal pain of long duration with unknown origin."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "A 50-year-old woman with 30 years of unexplained right lower quadrant pain was treated with dextroamphetamine sulfate."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Dramatic complete abrogation of the pain occurred within two weeks. The complete relief persisted for two years while she remains on therapy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Symphathetic neural hyperalgesia edema syndrome should be considered whenever there is refractory pelvic or abdominal pain."
        }
      ]},
