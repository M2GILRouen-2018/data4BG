      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To probe into the value of electron beam computed tomography (EBCT) for evaluating coronary artery bypass graft (CABG) patency follow-up."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "EBCT enhanced single slice mode (SSM) and flow study were performed in 150 patients. The results of 3-D reconstruction of CABG were correlated with bypass operation records and coronary arteriograms in 7 patients."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "318 of 399 coronary bypass grafts including IMA in 87/100(87%) and SVG in 228/296(77%) were patent. The overall patent rate was 79.7%. In 7 patients with 12 coronary bypass grafts, EBCT studies showed graft patency in 7 and occlusion in 5, as were confirmed by conventional graft angiography."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "EBCT angiography is a noninvasive method that could replace conventional coronary arteriography for CABG follow-up."
        }
      ]},
