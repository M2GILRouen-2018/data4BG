      "Abstract": {
        "CopyrightInformation": "Copyright Â© 2012 American College of Cardiology Foundation. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The purpose of this document is to make the output of the International Working Group for Intravascular Optical Coherence Tomography (IWG-IVOCT) Standardization and Validation available to medical and scientific communities, through a peer-reviewed publication, in the interest of improving the diagnosis and treatment of patients with atherosclerosis, including coronary artery disease."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Intravascular optical coherence tomography (IVOCT) is a catheter-based modality that acquires images at a resolution of ~10 μm, enabling visualization of blood vessel wall microstructure in vivo at an unprecedented level of detail. IVOCT devices are now commercially available worldwide, there is an active user base, and the interest in using this technology is growing. Incorporation of IVOCT in research and daily clinical practice can be facilitated by the development of uniform terminology and consensus-based standards on use of the technology, interpretation of the images, and reporting of IVOCT results."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The IWG-IVOCT, comprising more than 260 academic and industry members from Asia, Europe, and the United States, formed in 2008 and convened on the topic of IVOCT standardization through a series of 9 national and international meetings."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Knowledge and recommendations from this group on key areas within the IVOCT field were assembled to generate this consensus document, authored by the Writing Committee, composed of academicians who have participated in meetings and/or writing of the text."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This document may be broadly used as a standard reference regarding the current state of the IVOCT imaging modality, intended for researchers and clinicians who use IVOCT and analyze IVOCT data."
          }
        ]
      },
