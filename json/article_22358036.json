      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This article reviews, through clinical case presentation and correlative imaging, a variety of conditions that cause right lower quadrant (RLQ) pain in children."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This case-based review allows the reader to improve his or her understanding of the differential diagnosis and radiographic appearances of the entities that cause RLQ pain in children."
        }
      ]},
