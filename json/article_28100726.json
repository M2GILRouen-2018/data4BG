      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© 2017 American Academy of Neurology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate systemic levels of acetylcholinesterase in early Parkinson disease (PD) with 11C-donepezil PET, a potential marker of parasympathetic innervation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This was a cross-sectional study with 19 patients with early-stage PD (disease duration 1.5 ± 0.6 years) and 16 age-matched controls who had clinical assessments, olfaction tests, and 11C-donepezil PET to measure acetylcholinesterase density in peripheral organs."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The patients with PD showed significantly reduced 11C-donepezil uptake in the small intestine (-14%, p = 0.018), colon (-22%, p < 0.001), and kidneys (-14%, p = 0.028). No difference in myocardial or pancreatic acetylcholinesterase levels was seen."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "We found significantly decreased 11C-donepezil signal in the intestine and kidneys of patients with early PD, suggesting that parasympathetic denervation is present early in the disease course."
          }
        ]
      },
