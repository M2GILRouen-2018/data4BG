      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine possible systemic factors that may induce or be associated with the pathogenesis and pathologic course of spinal dural arteriovenous fistulas (SDAVFs), the most common type of arteriovenous disorder of the spinal cord and its meninges."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We assessed the role of possible systemic (vascular) risk factors (arterial hypertension, diabetes mellitus, fat metabolism disorders, and nicotine dependence) by comparing the prevalence of these risk factors in an SDAVF cohort of 59 patients with the prevalence in the general population."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Age-corrected prevalence of arterial hypertension in the SDAVF cohort was significantly higher than in the general population (P < 0.001). Prevalence of diabetes mellitus (P = 0.150.), nicotine dependence (P = 0.561), adiposity (P = 0.217), and fat metabolism disorders (P = 0.125) did not differ from prevalence of comparable cohorts in the general population."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our results and data from the literature suggest that arterial hypertension may play an important role in the development of SDAVF-related symptoms or the development of SDAVFs in the presence of other predisposing factors."
          }
        ]
      },
