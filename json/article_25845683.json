      "Abstract": {
        "CopyrightInformation": "© 2015 Associated Professional Sleep Societies, LLC.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVES",
            "content": "The aim of the study was to determine the association of objectively measured sleep disordered breathing (SDB) with incident coronary heart disease (CHD) or heart failure (HF) in a nonclinical population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Longitudinal analysis of a community-dwelling cohort followed up to 24 y."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Sleep laboratory at the Clinical Research Unit of the University of Wisconsin Hospital and Clinics."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "There were 1,131 adults who completed one or more overnight polysomnography studies, were free of CHD or HF at baseline, were not treated by continuous positive airway pressure (CPAP), and followed over 24 y."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "None."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND RESULTS",
            "content": "In-laboratory overnight polysomnography was used to assess SDB, defined by the apnea-hypopnea index (AHI) using apnea and hypopnea events per hour of sleep. Incident CHD or HF was defined by new reports of myocardial infarction, coronary revascularization procedures, congestive heart failure, and cardiovascular deaths. We used baseline AHI as the predictor variable in survival analysis models predicting CHD or HF incidence adjusted for traditional confounders. The incidence of CHD or HF was 10.9/1,000 person-years. The mean time to event was 11.2 ± 5.8 y. After adjusting for age, sex, body mass index, and smoking, estimated hazard ratios (95% confidence interval) of incident CHD or HF were 1.5 (0.9-2.6) for AHI > 0-5, 1.9 (1.05-3.5) for AHI 5 ≤ 15, 1.8 (0.85-4.0) for AHI 15 ≤ 30, and 2.6 (1.1-6.1) for AHI > 30 compared to AHI = 0 (P trend = 0.02)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Participants with untreated severe sleep disordered breathing (AHI > 30) were 2.6 times more likely to have an incident coronary heart disease or heart failure compared to those without sleep disordered breathing. Our findings support the postulated adverse effects of sleep disordered breathing on coronary heart disease and heart failure."
          }
        ]
      },
