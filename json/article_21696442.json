      "Abstract": {
        "CopyrightInformation": "© 2011 The Gerodontology Society and John Wiley & Sons A/S.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Knowledge of benefits caused by a treatment on quality of life is very relevant. Despite the wide use and acceptance of soft denture liners, it is necessary to evaluate the patient's response about the use of these materials with regard to improvement in oral health related quality of life (OHRQoL)."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim of this study was to evaluate the influence of denture relining in the OHRQoL of edentulous patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "Thirty-two complete denture wearers had their lower dentures relined with a silicone-based material (Mucopren soft, Kettenbach, Germany) according to chairside procedures. OHRQoL was assessed before and after 3 months of relining by means of OHIP-EDENT, and the median scores were compared by Wilcoxon test (p ≤ 0.05)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After 3 months of relining, participants reported significant improvement of their OHRQoL (p ≤ 0.01)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Denture relining with a soft liner may have a positive impact on the perceived oral health of edentulous patients."
          }
        ]
      },
