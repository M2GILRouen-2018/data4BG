      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of our study was to review the wide spectrum of pertinent CT findings in patients with acute nontraumatic abdominal pain in the setting of atrial fibrillation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Underlying embolic or hemorrhagic complications are common in patients with acute nontraumatic abdominal pain in the setting of atrial fibrillation and can be accurately seen on CT."
        }
      ]},
