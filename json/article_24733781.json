      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2014.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "Older adults living in long-term care experience high rates of chronic pain. Concerns with pharmacologic management have spurred alternative approaches. The purpose of this study was to examine a nursing intervention for older adults with chronic pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "This prospective, randomized control trial compared the effect of aromatherapy M technique hand massage, M technique without aromatherapy, and nurse presence on chronic pain. Chronic pain was measured with the Geriatric Multidimensional Pain and Illness Inventory factors, pain and suffering, life interference, and emotional distress and the Iowa Pain Thermometer, a pain intensity scale."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Three groups of 39 to 40 participants recruited from seven long-term care facilities participated twice weekly for 4 weeks. Analysis included multivariate analysis of variance and analysis of variance."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "Participants experienced decreased levels of chronic pain intensity. Group membership had a significant effect on the Geriatric Multidimensional Pain Inventory Pain and Suffering scores; Iowa Pain Thermometer scores differed significantly within groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "M technique hand massage with or without aromatherapy significantly decreased chronic pain intensity compared to nurse presence visits. M technique hand massage is a safe, simple, but effective intervention. Caregivers using it could improve chronic pain management in this population."
          }
        ]
      },
