        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate if there is a relation between age groups, menarche, menstrual cycles and previous pregnancies with the success of weight loss in obese patients at a nutrition clinic."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A clinical intervention study was conducted among overweight and obese patients who consulted a nutrition clinic in Barranquilla (Colombia) for the purpose of nutritional assessment. They were subject to a personalized weekly follow-up consultation over the course of 16 weeks in which food consumption patterns, anthropometric measures, body image and self-perception were registered."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 135 patients were evaluated. 41 (30,4%) of whom did not complete the study. 69,6% patients did lose weight and 83,7% did lose waist. These losses are lower in older ages (95,5% at."
          }
