      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To describe a unique pharmacologic treatment for backache that seemed to be related to herniated discs."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Dextroamphetamine sulfate was prescribed to a woman who developed acute lower backache which was attributed to herniated lumbar discs."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Within hours the pain diminished and she was pain free within a week. The 100% relief has persisted for months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Acute backache can be added to the long list of pain syndromes related to impairment of the sympathetic nervous system that is effectively treated with sympathomimetic amines."
        }
      ]},
