      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the effect of warming bupivacaine 0.5% on ultrasound-guided axillary brachial plexus block."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Prospective, randomized, double-blind."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Eighty patients undergoing elective or emergency surgery beyond the distal third of the upper limb were divided into two groups of 40 patients: the warm group received 15mL bupivacaine 0.5% heated to 37°C; the cold group received 15mL 0.5% bupivacaine stored for at least 24hours in the lower compartment of a refrigerator at 13-15°C. Onset and duration of sensory and motor blocks were evaluated every 5minutes for 40minutes. Postoperative pain was evaluated at 1, 3, 6, 12 and 24hours. Effective analgesia time was recorded as the interval between anesthetic injection and the first analgesia requirement (VAS>30mm)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Time to onset of sensory and motor block was significantly shorter in the warm group, and mean duration of sensory and motor block and of postoperative analgesia significantly longer."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Warming bupivacaine 0.5% to 37°C accelerated onset of sensory and motor block and extended action duration."
          }
        ]
      },
