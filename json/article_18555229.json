      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a very rare case of a primary twin omental pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The emergency department of a university teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 36-year-old woman."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Partial omentectomy by laparotomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Laparotomy successfully performed in the case of a twin omental pregnancy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "A 36-year-old woman presented with intense abdominal pain of 3 days' duration, hypotensive, with distended abdomen and signs of peritoneal irritation, and no transvaginal bleeding or evidence of topic pregnancy. Laparotomy showed normal internal genital organs and the presence of a large hemoperitoneum with a twin omental pregnancy. Partial omentectomy was performed. The patient progressed well postoperatively, and subsequent beta-hCG titer was negative."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Primary omental twin pregnancy is extremely rare, and when associated with acute abdomen and large hemoperitoneum, laparotomy is required for treatment."
        }
      ]},
