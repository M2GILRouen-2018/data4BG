      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 2011\">The Canadian Society of Clinical Chemists. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the diagnostic performance of glycogen-phosphorylase-isoenzyme-BB (GPBB) combined with cardiac troponin I (cTnI) in acute coronary syndrome (ACS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "Sixty patients with chest pain were investigated; GPBB and cTnI were measured."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "ACS was confirmed in 31 patients; cTnI was >0.07 μg/L in 15 patients and GPBB was >10 μg/L in 6 patients. Areas under ROC curves were similar: 0.854 (cTnI+GPBB) vs. 0.843 (cTnI), p=0.728."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Combination of GPBB with cTnI does not improve the detection of ACS."
          }
        ]
      },
