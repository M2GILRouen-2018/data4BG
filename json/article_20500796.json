      "Abstract": {
        "CopyrightInformation": "© 2010 The Authors. Journal Compilation © 2010 British Association of Dermatologists.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Filaggrin null mutations associate with atopic eczema and also with asthma when present with eczema. However, while epidermal dysfunction is an important factor in disease pathogenesis, it is unclear how such dysfunction interacts with immune responses to contribute to cutaneous and other inflammatory atopic disease."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To gain a better understanding of the mechanisms underlying such predisposition in order to understand different disease phenotypes and possibly identify potential treatment targets."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We studied 33 individuals with atopic eczema and used interleukin-4 immunospot and human leucocyte antigen class II tetrameric complexes to investigate the peripheral blood allergen-specific CD4+ T-cell responses."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Filaggrin null mutations associated with significantly (P<0·05) higher frequencies of allergen-specific CD4+ T-helper 2 cell responses."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These data would support a model where barrier dysfunction possibly promotes greater allergen penetration and delivery to drive allergen-specific CD4+ T cells. This could further contribute to respiratory and cutaneous inflammatory disease."
          }
        ]
      },
