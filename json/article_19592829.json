      "Abstract": {"AbstractText": [
        {
          "Label": "UNLABELLED",
          "content": "The electronic patient record is becoming more common in Finland. Structured and classified documentation methods make it possible to utilize different reports from EPR in the nursing management."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To describe how the knowledge of pain management in the EPR can be utilized in nursing management."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The descriptive data were collected from electronic patient records of patients with joint replacement in May 2008."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were 30 notes in the intensity measurement/assessments of pain versus 1788 in the pain control."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "The patient records show shortage in nursing documentation. This paper does not show the reason and therefore further research is needed. However this makes the nursing manager act."
        }
      ]},
