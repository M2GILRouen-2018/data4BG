      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The objective of this study is to evaluate the relevance of Lp-PLA2 to risk prediction among coronary heart disease (CHD) patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Lp-PLA2 activity was measured in 2538 CHD patients included in the Bezafibrate Infarction Prevention (BIP) study."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Adjusting for patient characteristics and traditional risk factors, 1 standard deviation of Lp-PLA2 was associated with a hazard ratio (HR) of 1.12 (95% confidence interval (CI): 1.00-1.25) for mortality and 1.03 (0.93-1.14) for cardiovascular events. Lp-PLA2 did not significantly improve model discrimination, or calibration nor result in noteworthy reclassification."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Our results do not support added value of Lp-PLA2 for predicting cardiovascular events or mortality among CHD patients beyond traditional risk factor."
        }
      ]},
