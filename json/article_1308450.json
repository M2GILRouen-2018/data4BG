      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Description of a clinical case of enteropathic arthritis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive study. SITE. Health Centre."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND OTHER PARTICIPANTS",
          "content": "A clinical case is described, starting with back pain where X-rays perceive no irregularity. Later a diagnosis of Crohn's disease is made. Finally lesions characteristic of anchylo-poyethic spondylitis appear."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Corticosteroid treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN FINDINGS",
          "content": "Clinical investigations and complementary diagnoses."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Way in which spondylitis presents, with no clear X-ray indications. Importance of closely following the development of this type of patient."
        }
      ]},
