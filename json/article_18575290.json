      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the image quality and visibility of coronary arteries that were performed by 16 slices and 64 slices multidetector row CT (MDCT)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Descriptive analysis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHOD",
          "content": "Twenty-eight patients suspected of hearing coronary artery disease had noninvasive coronary CT angiography performed by 16 slices MDCT and 64 slices MDCT Data were retrospectively analyzed and reviewed by two radiologists. Image quality was assessed by using a grading scale from excellent (4) to non-assessable (0) and the rate of displayed coronary branches was calculated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Four hundred twenty coronary CT angiography segments in 28 patients were evaluated."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Coronary CT angiography using 64 slices multi-detector row CT provides a significantly higher image quality of coronary arteries and their branches compared with 16 slices multi-detector row CT."
        }
      ]},
