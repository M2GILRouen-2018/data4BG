      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe a case of ruptured ectopic pregnancy and contralateral adnexal torsion after spontaneous conception."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary university medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 23-year-old multiparous female with severe bilateral pelvic pain and a positive pregnancy test."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Operative laparoscopy with detorsion of left adnexa, drainage of left ovarian hemorrhagic corpus luteum cyst, right salpingectomy, and dilation and curettage."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Laparoscopy revealed a 5 cm hemorrhagic corpus luteum cyst of the left ovary, torsion of the left ovary and fallopian tube, and a ruptured right ampullary ectopic pregnancy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Normal perfusion of left ovary and fallopian tube after detorsion, resolution of left ovarian hemorrhagic corpus luteum cyst, patent left fallopian tube with chromopertubation, and successful removal of ectopic pregnancy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "This is a unique case of adnexal torsion and contralateral ectopic pregnancy occurring after spontaneous conception."
        }
      ]},
