      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study investigated effectiveness of an equipment-based Pilates protocol for reducing pain and disability in individuals with work-related chronic low back pain (CLBP)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twelve workers with non-specific CLBP participated in a quasi-experimental, one-group, pretest-posttest pilot study of supervised 6-week equipment-based Pilates exercise. Pain severity was assessed using a 100-mm visual analog scale (VAS). Physical function was assessed using the Oswestry disability index (ODI)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The Pilates intervention significantly reduced pain (mean decrease in VAS 30.75 ± 20.27, p < 0.0001) and disability (mean decrease in ODI 11.25 ± 13.20, p < 0.02) with large and borderline large effect sizes, respectively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Rehabilitative Pilates exercise reduced pain and disability in workers with CLBP. Further research is needed to investigate Pilates exercise for rehabilitation of work-related injuries in large populations."
          }
        ]
      },
