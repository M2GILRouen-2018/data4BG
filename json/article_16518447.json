      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To compare symptoms, symptom beliefs, and quality of life (QOL) of older breast cancer survivors to those of older women without breast cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive, correlational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Urban and rural communities in the Midwest United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "18 breast cancer survivors and 24 women without breast cancer, older than age 64 (X age = 76 years)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In-home interviews using structured instruments."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Symptom distress (number of and distress from symptoms), symptom beliefs, chronic health problems, and QOL."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "No group differences existed in demographic characteristics, symptom number, symptom bother, chronic health conditions, or QOL. Women in both groups most often attributed the cause of their symptoms to aging, chronic illness, or unknown, but rarely to breast cancer. Attributing symptoms to chronic illness or breast cancer was significantly related to more pain, depression, role impairment, and poorer mental health. Not knowing the cause of symptoms was significantly related to poorer social functioning, mental health, and purpose in life; less energy; and higher levels of depression and anxiety."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The symptom experience and QOL of older breast cancer survivors are similar to those of older women with other chronic health problems. Beliefs about symptoms influence QOL in older women."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "A broader assessment of symptoms is needed to assist older breast cancer survivors with symptom management. Symptom interventions in older women should address patients' beliefs about symptoms if QOL is to be enhanced."
        }
      ]},
