      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "It is believed that treatment with low temperature can reduce pain perception in chronic pain patients, including chronic low back pain patients."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To evaluate the effects of a two-week repeated intervention of -67 °C cryo-chamber in patients with chronic low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective randomized double blind study design."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Hospital-based outpatients department"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "POPULATION",
          "content": "Outpatients with chronic low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Comparing intervention group (-67 °C) with higher temperature (-5 °C) which was supposed as a control group in a cryo-chamber."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Similar effectiveness in pain reduction in both intervention and control groups"
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Cryochamber therapy with -67 °C is not superior to (sham cryo chamber) with -5 °C."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CLINICAL REHABILITATION IMPACT",
          "content": "Cryo chambers therapy show positive effect by improving pain. For the treatment, -5 °C seems to be sufficient for these patients."
        }
      ]},
