      "Abstract": {
        "CopyrightInformation": "Copyright 2009 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To assess the role of massage therapy in the cardiac surgery postoperative period. Specific aims included determining the difference in pain, anxiety, tension, and satisfaction scores of patients before and after massage compared with patients who received standard care."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A randomized controlled trial comparing outcomes before and after intervention in and across groups."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Saint Marys Hospital, Mayo Clinic, Rochester, Minnesota."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "Patients undergoing cardiovascular surgical procedures (coronary artery bypass grafting and/or valvular repair or replacement) (N=58)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients in the intervention group received a 20-minute session of massage therapy intervention between postoperative days 2 and 5. Patients in the control group received standard care and a 20-minute quiet time between postoperative days 2 and 5."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Linear Analogue Self-assessment scores for pain, anxiety, tension, and satisfaction."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Statistically and clinically significant decreases in pain, anxiety, and tension scores were observed for patients who received a 20-minute massage compared with those who received standard care. Patient feedback was markedly positive."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This pilot study showed that massage can be successfully incorporated into a busy cardiac surgical practice. These results suggest that massage may be an important therapy to consider for inclusion in the management of postoperative recovery of cardiovascular surgical patients."
          }
        ]
      },
