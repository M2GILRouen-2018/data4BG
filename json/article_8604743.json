      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "We studied a case of solitary fibrous tumor of the orbit in a 75-year-old man."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The patient had painless, slowly progressive proptosis of eight months' duration. He underwent magnetic resonance imaging, which showed a well-circumscribed retrobulbar mass. The tumor was excised."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Examination of the tumor disclosed haphazardly arranged spindle cells alternating with collagenous, hypocellular areas in a richly vascular background without necrosis. Immunoperoxidase stains showed characteristic expression of CD34 and vimentin."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Solitary fibrous tumor can infrequently involve the orbit and may recur locally and metastasize, necessitating long-term follow-up."
        }
      ]},
