      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Approximately one-third of ventilated infants fail extubation. The objective of this study was to determine whether assessment of the load relative to the capacity of respiratory muscles by measurement of the tension time index (TTI) successfully predicted extubation outcome in infants."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary neonatal intensive care unit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Twenty ventilated infants, with a median gestational age of 31 (range 24-39) weeks, were studied at a median postnatal age of 2.5 (range 1-37) days."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "The diaphragm tension time index (TTdi) was derived from measurements of transdiaphragmatic pressure using a dual-pressure transducer tipped catheter. The respiratory muscle tension time index (TTmus) was derived from non-invasive airway pressure measurements. Measurements were made within the 6 h prior to extubation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Extubation failure was defined as the need for reintubation within 48 h of extubation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Five infants failed extubation; their median TTdi (p=0.001) and TTmus (p=0.001) were significantly higher than those of the successfully extubated infants. A TTdi of >0.15 and a TTmus of >0.18 were 100% sensitive and 100% specific in predicting extubation failure"
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In ventilated infants, invasive and non-invasive measurements of the TTI could provide an accurate prediction of extubation outcome."
        }
      ]},
