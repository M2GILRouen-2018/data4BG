      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report our experience in managing a case of viable cervical twin pregnancy with systemic methotrexate and 2 weeks later with endocervical curettage after placing prophylactic high cervical cerclage."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 36-year-old woman, gravida 2, para 0, complaining of vaginal bleeding and pelvic pain, in whom cervical twin pregnancy was diagnosed at the sixth week of gestation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Systemic methotrexate was given as first-line treatment. Two weeks later because of persisting bleeding, endocervical curettage was performed after closing cervical arteries and placing but not tightening high cervical cerclage."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Pregnancy termination, bleeding control, and preservation of fertility."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Notwithstanding the ligature of cervical arteries at curettage, heavy bleeding occurred, which was controlled rapidly by tightening the cerclage. Curettage then was completed successfully. Postoperative period was uneventful. Two years later the woman delivered vaginally."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "In case of cervical twin pregnancy methotrexate pretreatment and prophylactic placement of high cervical cerclage, but not ligature of cervical arteries, before curettage showed to be effective in terminating pregnancy ensuring effective bleeding control and preservation of fertility."
        }
      ]},
