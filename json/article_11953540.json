      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the effect of a proprioceptive dynamic posture training program on balance in osteoporotic women with kyphotic posture."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Subjects were randomly assigned to either a proprioceptive dynamic posture training program or exercise only group. Anthropometric measurements, muscle strength, level of physical activity, computerized dynamic posturography, and spine radiography were performed at baseline and 1 mo."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At the 1-mo follow-up, three groups were formed on the basis of the baseline computerized dynamic posturography results. In general, groups 1 and 2 had no significant change at 1 mo, whereas group 3 improved balance significantly at 1 mo."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The subjects who had abnormal balance and used the proprioceptive dynamic posture training program had the most significant improvement in balance. Improved balance could reduce the risk of falls."
        }
      ]},
