      "Abstract": {"AbstractText": [
        {
          "Label": "Clinical Question",
          "content": "Are intra-articular corticosteroids associated with improvement in pain and physical function compared with sham injection or no intervention in patients with knee osteoarthritis?"
        },
        {
          "Label": "Bottom Line",
          "content": "Intra-articular corticosteroids may be associated with moderate improvement in pain and a small improvement in physical function up to 6 weeks after injection. However, the quality of the evidence is low."
        }
      ]},
