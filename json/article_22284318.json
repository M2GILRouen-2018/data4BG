      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To determine whether ultrasound guidance improves the quality of continuous popliteal block when compared with a nerve stimulator after major foot and ankle surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, randomized, double-blinded clinical trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Operating room, Postanesthesia Care Unit (PACU), and hospital wards of a university-affiliated hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "45 ASA physical status 1, 2, and 3 patients undergoing elective major foot and ankle surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Placement of a popliteal sciactic nerve catheter using either nerve stimulator or ultrasound guidance. In the PACU, a continuous infusion of ropivacaine 0.2% was started at a basal rate of 4 mL/hr and adjusted in a standardized fashion to maintain visual analog scale (VAS) pain scores < 4. All patients also received intravenous (IV) patient-controlled analgesia with hydromorphone and oral opioids."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "VAS pain scores at rest and with physical therapy, ropivacaine use, opioid use, and opioid-related side effects were recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Cummulative ropivacaine use was lower in patients whose catheter was placed by ultrasound than by nerve stimulator guidance (mean 50 vs 197 mL, P < 0.001). Pain scores at rest and during activity were similar between groups. Cumulative opioid consumption (mean 858 vs 809 mg oral morphine equivalents) and daily frequencies of nausea (5% to 33% vs 0 to 24%) and pruritus (0 to 21% vs 0 to 24%) were similar between groups. Length of hospital stay was similar between groups (3.5 vs 3.7 days)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Ultrasound guidance was associated with less local anesthetic consumption than with the nerve stimulator; however, there was little clinical benefit, as all other outcomes were similar between groups."
          }
        ]
      },
