      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This meta-analysis was conducted to analyze and compare the efficacy outcomes associated with the fentanyl iontophoretic transdermal system (ITS) and morphine intravenous (IV) patient-controlled analgesia (PCA) in the management of postoperative pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "RESEARCH DESIGN AND METHODS",
          "content": "This meta-analysis assessed the efficacy of the fentanyl ITS versus morphine IV PCA using data from four randomized, active-controlled trials (n = 1271 fentanyl ITS and 1298 morphine IV PCA patients). Main outcome measures were patient global assessment (PGA) of the method of pain control at 24 h."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Fentanyl ITS and morphine IV PCA did not significantly differ regarding 'good' and 'excellent' ratings on the PGA of the method of pain control at 24 h (odds ratio = 0.95, p = 0.66), however, fentanyl ITS was superior in terms of 'excellent' PGA ratings at that time point (odds ratio = 1.53, p < 0.0001). No significant differences were found in weighted mean pain intensity scores at 24, 48 and 72 h."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In this meta-analysis, fentanyl ITS was as efficacious as morphine IV PCA and may offer additional benefits as demonstrated by its 'excellent' PGA ratings."
        }
      ]},
