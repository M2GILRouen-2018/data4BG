      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe the lifetime prevalence of dental pain among Maryland's school age children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Data come from the Survey of Oral Health Status of Maryland School Children conducted in 2000-01. History of dental pain, as reported by an adult respondent, was analyzed for 2,411 kindergarten and third grade students. Percentages with their 95% confidence interval were calculated to obtain state representation of the distribution of dental pain by sociodemographic characteristics and caries status."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Overall, 11.8 percent of Maryland school age children in kindergarten and third grade have had some dental pain. Among children who have had caries, the report of dental pain increases to 28.2 percent. Children from families with low educational attainment or eligible for free or reduced meals or covered by Medicaid were more likely to have experienced dental pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Almost a third of Maryland kindergartens and third graders who have caries have experienced dental pain."
        }
      ]},
