      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "This study assessed the influence of pain behaviors on pain estimation by nurses and psychiatrists."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Pain ratings performed by nurses and psychiatrists who observed the case scenarios using role plays were assessed. The data were computed and frequencies were derived. t-test was used to compare the ratings between the groups."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was significant difference in the ratings of the pain severity by nurses and psychiatrists."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Pain assessment is essential for the comprehensive management of pain. Training health professionals in pain assessments is very essential."
        }
      ]},
