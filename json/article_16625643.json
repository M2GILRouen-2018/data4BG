      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Non-specific cough is defined as non-productive cough in the absence of identifiable respiratory disease or known aetiology. It is commonly seen in paediatric practice. These children are treated with a variety of therapies including a variety of asthma medications. The leukotriene pathway is reported to be involved in the sensory (neurogenic) pathway, which is a mechanism thought to be involved in the pathogenesis of chronic cough."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To evaluate the effectiveness of leukotriene receptor antagonist (LTRA) in treating children with prolonged non-specific cough."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SEARCH STRATEGY",
          "content": "The Cochrane Register of Controlled Trials (CENTRAL), the Cochrane Airways Group Specialised Register, MEDLINE and EMBASE databases were searched by the Cochrane Airways Group. The latest searches were carried out in September 2005."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SELECTION CRITERIA",
          "content": "All randomised controlled trials comparing LTRA with a placebo medication in children with non-specific cough."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA COLLECTION AND ANALYSIS",
          "content": "Results of searches were reviewed against pre-determined criteria for inclusion. One eligible trial was identified but no data was available for analysis. It was not possible to separate results from children with non-specific cough from those without."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MAIN RESULTS",
          "content": "There was no significant difference in all study endpoints between the montelukast and placebo groups (total N=256)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "AUTHORS' CONCLUSIONS",
          "content": "With the lack of evidence, the routine use of LRTA in treating children with non-specific cough cannot be recommended."
        }
      ]},
