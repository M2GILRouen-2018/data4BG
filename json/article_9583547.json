      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine dependent chest tube losses of bupivacaine with paravertebral versus interpleural administration, thereby helping to explain the significant differences in pulmonary function that exist between these two techniques."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective, randomized study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A single hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Twelve adult patients undergoing posterolateral thoracotomies."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Paravertebral or interpleural administration of bupivacaine."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Analgesia, as assessed by visual analog pain scores and patient-controlled morphine requirements, was similar in both groups. Postoperative spirometric values were significantly better at most times with the paravertebral route of administration. Dependent chest tube bupivacaine losses were approximately four times higher in the interpleural group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Local anesthetic on the diaphragm might actively impair respiratory function through diaphragmatic and abdominal muscle weakness, while failing to contribute to pain relief."
        }
      ]},
