      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE OF REVIEW",
          "content": "This review will address the recent literature regarding adolescent endometriosis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RECENT FINDINGS",
          "content": "An increasing body of literature suggests that there are symptoms of endometriosis present in adolescents. In addition, those teens with a history of dysmenorrhea severe enough to disrupt quality of life are more likely to be diagnosed with endometriosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "The issues of endometriosis progression and early diagnosis remain key issues for the adolescent."
        }
      ]},
