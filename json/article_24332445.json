      "Language": "spa",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier España, S.L. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To analyze the prevalence and severity of the opioid-induced bowel dysfunction (OBD) symptoms."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Epidemiological, observational and cross-sectional study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LOCATION",
            "content": "Six Spanish centers participated."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "A total of 317 outpatients with a diagnosis of cancer pain or non-cancer pain treated with a unique opioid were recruited."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN MEASUREMENTS",
            "content": "The prevalence of OBD symptoms was measured using a visual analog scale (VAS: 0-100), and constipation was also assessed by the Bowel Function Index (BFI). The treatment for gastrointestinal symptoms was recorded, and the frequency of symptoms between different opioid treatments was compared. Finally, quality of life was evaluated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The prevalence of OBD with at least one gastrointestinal disorder was 94.6%, with constipation being the most frequent symptom (BFI: 91.6%; VAS: 90.2%) and nearly half of the patients showed three or more symptoms with a VAS ≥ 4. No significant differences were detected in the prevalence of symptoms between the opioid groups. A decrease in the wellbeing of patients was detected related to moderate to severe gastrointestinal symptoms."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A high rate of gastrointestinal disorders probably related to OBD have been confirmed in patients on opioid therapy, highlighting the need for new drug strategies."
          }
        ]
      },
