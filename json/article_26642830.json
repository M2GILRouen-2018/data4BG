      "Abstract": {
        "CopyrightInformation": "© 2015, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "This study aims to examine adolescent level of knowledge concerning obesity risk."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "Qualitative and quantitative data were collected using a staged process. Data collected with (a) Obesity Risk Knowledge Scale (ORK-10), (b) focus groups, (c) scientific advisory group input, and (d) the Adolescent Obesity Risk Knowledge Scale (AORK)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The AORK is tailored from the ORK-10 (α = .53) to capture adolescents' knowledge of obesity complications and/or risks (α = .68)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "The AORK integrates questions for assisting practitioners to initiate discussions about obesity and lifestyle choices with adolescents and their families."
          }
        ]
      },
