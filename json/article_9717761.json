      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Hyperaesthesia involving the infra-orbital nerve is rarely associated with orbital floor fracture."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "An 11-year-old boy and a 34-year-old man had persistent and severe hyperaesthesia in the distribution of the infra-orbital nerve 12 and 26 months, respectively, after blunt orbital trauma."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Surgical decompression of the infra-orbital nerve resulted in rapid and complete resolution of the hyperaesthesia in both cases."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Persistent hyperaesthesia of the infra-orbital nerve is another indication for exploration of the orbital floor following blunt orbital trauma."
        }
      ]},
