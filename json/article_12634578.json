      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A single case study was conducted."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To detail the occurrence of multiple intracranial, intraparenchymal hemorrhages following an iatrogenic acute reduction in cerebral spinal fluid pressure following excision of an intradural extramedullary spinal tumor."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Multiple supratentorial, intraparenchymal, intracranial hemorrhages following an acute reduction in cerebral spinal fluid pressure have not been previously reported in the literature."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A case report and literature review are presented."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The patient made an uneventful full recovery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Intracranial hemorrhage must be considered in the differential diagnosis of patients presenting with persistent headache following spinal surgery when the dura has been breached and is associated with significant cerebrospinal fluid loss."
        }
      ]},
