      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the effects of a single dose of dexamethasone sodium phosphate on postoperative morbidity in children undergoing tonsillectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, double-blind, placebo-control clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Academic, tertiary care children's hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Sixty-nine children (35 boys, 34 girls), aged 3 to 18 years, undergoing tonsillectomy with or without adenoidectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Patients were randomized to receive a single dose of intravenous dexamethasone or saline."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Pain scores, determined by a Faces Scale, were obtained at 4-hour intervals during the first postoperative day and daily for 7 days thereafter. Total use of an analgesic; type of diet; level of activity; presence of halitosis, nausea, emesis, or fever; and incidence of postoperative bleeding were also compared between the two groups."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The two groups of children were similar in age, gender, diagnosis, and surgical time. Pain scores in the postoperative period were identical while the patients were in the hospital and for the first 7 days after discharge. No statistically significant differences were noted in pain scores, nausea, emesis, halitosis, analgesic medications required, diet, or activity levels between the two groups of patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A single intraoperative dose of dexamethasone did not appreciably affect postoperative morbidity in children undergoing tonsillectomy."
        }
      ]},
