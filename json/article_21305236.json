      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the correlation between limited shoulder range of motion in persons with spinal cord injury at discharge and the performance of activities, wheeling performance, transfers and participation one year later."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Multicentre prospective cohort study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "A total of 146 newly injured subjects with spinal cord injury."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Shoulder range of motion was measured at discharge. One year later, Functional Independence Measure (FIM), transfer ability, wheelchair circuit and Physical Activity Scale for Individuals with Physical Disabilities (PASIPD) were assessed. Corrections were made for possible confounding factors (age, gender, level and completeness of injury, time since injury and shoulder pain)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All subjects with limited shoulder range of motion at discharge had a lower FIM motor score and were less likely (total group 5 times, and subjects with tetraplegia 10 times less likely) to be able to perform an independent transfer one year later. Subjects with limited shoulder range of motion in the total group needed more time to complete the wheelchair circuit. No significant associations with the PASIPD were found in either group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Persons with spinal cord injury and limited shoulder range of motion at discharge are more limited in their activities one year later than those without limited shoulder range of motion."
        }
      ]},
