        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This is a retrospective case review."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Our patient's rapid infection eventually led to enucleation, despite broad-spectrum antibiotic therapy."
        },
