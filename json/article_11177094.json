      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine, if possible, whether magnesium deficiency exists in children with asthma during acute attacks and between exacerbations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Emergency Department Clinic and Outpatient Pediatric Clinic of Jordan University of Science and Technology, Irbid."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 174 known asthmatic children who presented to the emergency department in acute attack (group 1) and 94 asthmatic children who presented to outpatient clinics for follow-up of asthma (group 2) had their serum magnesium levels assayed and compared with 232 patients without asthma (controls; group 3). Exclusion criteria were history of renal disease, cardiac disease, malabsorption, diuretic use, alcoholism, and pregnancy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no differences between study groups, although male patients had a slightly lower level of magnesium than female patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "After removing the confounder of sex, serum magnesium levels in asthmatic children during acute attacks and between exacerbations are not significantly different from those of controls."
        }
      ]},
