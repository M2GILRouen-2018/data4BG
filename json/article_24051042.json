      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 IMSS. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND AIMS",
            "content": "We undertook this study to evaluate the virological response to and presence of adverse events to natural interferon α (nIFNα; Multiferon®) treatment in previously nonresponsive Mexican patients chronically infected with genotype 1 hepatitis C."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Thirty-nine patients received a 4-week induction of 5 days/week of 6 MU nIFNα plus weight-based ribavirin followed by 3 MU of nIFNα three times a week for 44 weeks. The relationship between viral response and incidence of adverse events was analyzed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Early viral response (EVR) was age- and sex-dependent, with older male patients being less responsive. Sustained viral response (SVR) was evaluated according to: a) intention to treat analysis, b) 48-week treatment and 24-week follow-up (16 patients), and c) patients with EVR (11 patients). None of the factors was significantly different in groups a) and b); however, in group c) there was a better response with a marked viral load decline in younger patients and in patients aged 50 years and older. Five of 39 (13%) patients who completed treatment presented with an SVR. The most common adverse effect was asthenia in 27% of patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "nIFNα could be a useful strategy for re-treatment in chronic hepatitis C, genotype 1, in previously nonresponsive patients. Confirmation of these data in a larger population is required."
          }
        ]
      },
