      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To compare the analgesic efficacy of ketorolac, ibuprofen-paracetamol (acetaminophen), and dextropropoxyphene-paracetamol in postoperative pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, double-blind, parallel, single-dose study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Multicenter, with five centers participating."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "One hundred sixty patients with moderate to severe postoperative pain requiring oral analgesics were enrolled. Seventeen patients were excluded from final analysis due to deviation from protocol."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Ketorolac tromethamine 10 mg, a combination of ibuprofen 400 mg plus paracetamol 325 mg, or a combination of dextropropoxyphene 65 mg plus paracetamol 400 mg was given orally to patients with moderate to severe baseline pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Pain intensity and pain relief scores were rated at baseline, at 30 minutes, and hourly to 6 hours. Until the end of first hour, analgesia was similar for all three regimens. Ketorolac had a significantly higher analgesic effect than the two combinations between hours 2 and 6. Analgesia was similar for the two combinations. For all three test drugs the frequency of adverse effects was similar."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Ketorolac 10 mg is a superior analgesic to ibuprofen-paracetamol or dextropropoxyphene-paracetamol in the treatment of postoperative pain."
        }
      ]},
