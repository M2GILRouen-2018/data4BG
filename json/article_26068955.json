      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "CLINICAL QUESTION",
          "content": "Are topical nonsteroidal anti-inflammatory drugs (NSAIDs) associated with reduced pain intensity in acute musculoskeletal conditions, but without increased adverse events?"
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "BOTTOM LINE",
          "content": "When treating musculoskeletal conditions such as sprains, strains, and contusions, topical NSAIDs are associated with greater pain relief, but are not associated with an increase in adverse events compared with placebo."
        }
      ]},
