      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "We compared the effects of postoperative pain control strategies on recovery after radical retropubic prostatectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "The results in 22 consecutive patients who underwent radical retropubic prostatectomy between 1993 and 1994 were evaluated. Pain control was achieved using morphine patient-controlled analgesia in 11 patients or nonsteroidal anti-inflammatory ketorolac in 11. Outcome measures were compared between the 2 groups."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The interval to return of bowel function, length of hospitalization and total hospital costs were significantly decreased in the ketorolac treated patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Pain control with ketorolac affords excellent analgesia while allowing for earlier recovery of bowel function, shorter hospitalization and lower overall costs in patients undergoing radical retropubic prostatectomy."
        }
      ]},
