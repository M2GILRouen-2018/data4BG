      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Hypothalamic obesity caused by damage of medial hypothalamic nuclei presents a therapeutic challenge. Glucagon-like peptide-1 agonist exenatide (synthetic version of exendin-4 (Ex4)), used for treatment of diabetes, causes weight loss via hindbrain signaling."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We tested Ex4 in an established rat model of medial hypothalamic lesions. Lesion and control animals were administered either daily intraperitoneal injections of 1 µg·kg(-1) Ex4 or saline for 9 days."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In our rat model, a significant difference in percent baseline food intake (lesion -20.8%, control -13.6%; p < 0.001) and percent change in body weight (lesion -4.9%/9 days, control -3.2%/9 days; p < 0.05) was observed during Ex4 treatment compared with saline."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Ex4 resulted in reduction of food intake and body weight. Follow-up studies are required to further elucidate its effects on energy homeostasis and to establish Ex4 as a potential drug for treatment of hypothalamic obesity."
          }
        ]
      },
