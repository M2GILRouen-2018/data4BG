      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright 2003 S. Karger GmbH, Freiburg",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "We report on the study design and protocols of two randomized controlled trials (Acupuncture Randomized Trials = ART) that investigate the efficacy of acupuncture in the treatment of chronic low back pain and osteoarthritis of the knee, respectively."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate whether acupuncture is more efficacious than (a) no treatment or (b) minimal acupuncture in the treatment of low back pain and osteoarthritis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Two randomized, controlled, multicenter trials with three treatment arms and a total follow-up time of 52 weeks."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "30 practitioners and outpatient units in Germany specialized in acupuncture treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "300 patients will be included in each study. In the low back pain trial, patients will be included according to clinical diagnosis. In the osteoarthritis pain trial, patients will be included according to the American College of Rheumatology criteria."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients are randomly assigned to receive either (1) semi-standardized acupuncture (150 patients), (2) minimal acupuncture at non-acupuncture points (75 patients), or (3) no treatment for two months followed by semi-standardized acupuncture (75 patients, waiting list control). Acupuncture treatment consists of 12 sessions per patient over a period of 8 weeks."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE",
            "content": "The main outcome measure is the difference between baseline and the end of the 8-week treatment period in the following parameters: pain intensity as measured by a visual analogue scale (VAS; 0-100 mm) in the low back pain trial and by the Western Ontario and McMaster Universities Osteoarthritis Score (WOMAC) in the osteoarthritis trial."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "OUTLOOK",
            "content": "The results of these two studies (available in 2004) will provide health care providers and policy makers with the information needed to make scientifically sound assessments of acupuncture therapy."
          }
        ]
      },
