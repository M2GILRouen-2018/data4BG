      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "We developed a technique for ultrasound-guided paravertebral block, which was subsequently applied in the clinical setting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "An initial cadaver study was used to develop a technique that was used in the clinical setting on patients undergoing breast cancer surgery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Paravertebral catheters were correctly placed in the cadaveric trial in 8 of 10 attempts. In the clinical study, all blocked patients (n = 9) had evidence of thoracic wall sensory block and analgesia postoperatively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Determined by anatomical dissection, we have described the ultrasound features of the thoracic paravertebral space and performed clinically successful ultrasound-guided paravertebral block."
        }
      ]},
