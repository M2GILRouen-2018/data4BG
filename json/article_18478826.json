      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To review the epidemiologic literature concerning psychosocial mediators of outcome in chronic pain. These factors deserve attention in the assessment and treatment of chronic pain by mental health professionals."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "We reviewed literature dealing with epidemiologic perspectives on abuse, depression, addiction, employment, coping skills, and psychosocial problems. Treatments considered include analgesics, psychological rehabilitation, and prevention of disability."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Psychosocial factors such as abuse, mood disorder, employment handicap, poor coping skills, and other psychosocial problems are commonly found in chronic pain patients referred to clinics."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Many psychosocial factors that can be identified in chronic pain sufferers are relevant to the professional skills of mental health professionals. These factors are determinants of prognosis, course, and outcome of chronic pain."
        }
      ]},
