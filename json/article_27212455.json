      "Abstract": {
        "CopyrightInformation": "© 2016 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We compared electron microscopic histologic changes of the radial artery grafts in non-diabetic and diabetic patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Thirty-six patients were divided into three groups according to their diabetic status (Group I had no diabetes mellitus [DM], Group II had type two DM and HbA1c levels were <7.5%, and Group III had type 2 DM but HbA1c levels were >7.5%). Distal parts of radial artery grafts were evaluated with scanning electron microscopy in a blind fashion by two histologists. Electron microscopic scores were compared among the groups."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Radial artery electron microscopic scores were significantly different between group 1, 2 and 1, 3 and 2, 3 (p\u2009=\u20090.028, p\u2009<\u20090.001, and p\u2009<\u20090.001). In linear regression analysis, duration of DM (p\u2009=\u20090.027) and fasting plasma glucose (p\u2009=\u20090.001) were found as independent risk factors for histologic changes of radial artery grafts."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Duration of DM and poor glycemic control were found to be associated with radial artery electron microscopic changes. doi: 10.1111/jocs.12761 (J Card Surg 2016;31:410-415)."
          }
        ]
      },
