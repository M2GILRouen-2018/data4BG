      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND OBJECTIVES",
          "content": "To evaluate the etiologies of cauda equina syndrome (CES) and transient radicular irritation (TRI) or transient neurologic symptoms (TNSs) following hyperbaric spinal anesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A review of recent (since 1991) and prior (since 1941) investigations regarding CES and TRI (TNSs) was conducted."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Recent publications fail to recognize significant prior information regarding CES and TRI (TNSs)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Cauda equina syndrome is, in all probability, explainable. Further investigation to pinpoint the etiology of TRI (TNSs) is needed."
        }
      ]},
