      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the efficacy and safety of lidocaine nasal spray before nasogastric tube insertion in an emergency department."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Double-blind, randomised controlled study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Emergency department of a major regional hospital in Hong Kong."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "A total of 206 adult patients, for whom nasogastric tube insertion was indicated."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Primary outcome was discomfort gauged on a visual analogue scale, and Likert scale addressing difficulty of nasogastric tube insertion."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Compared with placebo spray use, lidocaine spray use was associated with less patient discomfort, and less difficulty in nasogastric tube insertion, both difference being statistically significant."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Intranasal lidocaine spray before nasogastric tube insertion was safe and effective in reducing patient discomfort related to the procedure."
        }
      ]},
