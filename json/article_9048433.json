      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To examine pain-related constructs, illness related constructs, and the particular importance of the physical examination as integrative steps in a comprehensive pain assessment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Review articles and book chapters related to the physical examination and evaluation of cancer pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The physical examination is a fundamental aspect of cancer pain assessment. It provides unique information that can be combined with the history, data from the medical record, and the results of additional studies to yield a comprehensive understanding of the patient."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "The nurse's understanding of pain-related constructs, illness-related constructs, and the importance of the physical examination will help provide strategies for pain management that are most likely to offer both pain relief and improved quality of life."
        }
      ]},
