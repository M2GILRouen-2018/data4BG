      "Abstract": {
        "CopyrightInformation": "© 2012 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "We report a retrospective case study of combined treatment of cancer-related pain and chronic low back and lower extremity pain related to postlaminectomy syndrome (PLS) with one spinal cord stimulation (SCS) system."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The patient underwent an uneventful SCS trial with percutaneous placement of two temporary eight-electrode leads (Medtronic Inc., Minneapolis, MN) placed at the level of T8-T9-T10 and T5-T6-T7."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After successful trial, he was implanted with permanent leads and generator, reporting sustained pain relief at 12-month follow-up visit."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "SCS is a trialable, reversible, and interactive therapy permitting patients to control the level of stimulation they feel based on their degree of pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "SCS provides an effective, alternative treatment for select patients with cancer-related chest wall pain and pain related to PLS who have failed conservative treatment."
          }
        ]
      },
