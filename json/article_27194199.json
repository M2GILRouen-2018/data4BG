      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate long-term safety, maintenance of analgesia, and aberrant drug-related behaviors of hydrocodone extended release (ER) formulated with CIMA® Abuse-Deterrence Technology."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Phase 3, multicenter, open-label extension."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Fifty-six US centers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Adults with chronic low back pain completing a 12-week placebocontrolled study of abuse-deterrent hydrocodone ER were eligible. One hundred eighty-two patients enrolled and received ≥1 dose of study drug, 170 entered openlabel treatment, and 136 completed the study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients receiving hydrocodone ER in the 12-week, placebo-controlled study continued their previous dose unless adjustment was needed; those previously receiving placebo (n=78) underwent dose titration/adjustment to an analgesic dose (15-90 mg every 12 hours). Patients received 22 weeks of open-label treatment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES"
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "SAFETY",
          "content": "adverse events (AEs). Maintenance of analgesia: worst pain intensity (WPI) and average pain intensity (API) at each study visit. Aberrant drug behavior: study drug loss and diversion."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "AEs were reported for 65/182 (36 percent) patients during dose titration/ adjustment and 88/170 (52 percent) during open-label treatment. No treatmentrelated serious AEs were reported. There were no clinically meaningful trends in other safety assessments, including physical examinations and pure tone audiometry. One patient receiving hydrocodone ER 30 mg twice daily experienced a severe AE of neurosensory deafness that was considered treatment related. Mean WPI and API remained steady throughout open-label treatment. Six (3 percent) patients reported medication loss, and 5 (3 percent) reported diversion."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Abuse-deterrent hydrocodone ER was generally well tolerated in patients with chronic low back pain, maintained efficacy, and was associated with low rates of loss and diversion."
        }
      ]},
