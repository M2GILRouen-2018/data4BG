      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To evaluate integrated PET/MRI/1H MR spectroscopy in patients with prostate cancer."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS AND METHODS",
            "content": "Data analysis comprised calculations of correlations of standardized uptake values (SUVs) and ratios of (choline+creatine)/citrate as well as of single metabolite values and a logistic regression analysis of PET data and MR spectroscopy data in 22 patients."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "SUVmean and integral values of choline correlated significantly in tumors. Logistic regression analysis demonstrated diagnostic superiority of PET over spectroscopy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Simultaneous acquisition of PET and MR spectroscopy with integrated PET/MRI is feasible. Choline compounds and choline metabolism show a positive significant correlation."
          }
        ]
      },
