      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the clinic efficacy and safety in the treatment of chronic abacterial prostatitis/chronic pelvic pain syndrome (CABP/CPPS) after intraprostatic injection of Chuanshentong."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Five milliliter of solution blending Chuanshentong and lidocaine was transperineally injected into one lobe of prostate, once a day for 6 days, for a total of 98 cases of patients who had been diagnosed as chronic abacterial prostatitis/chronic pelvic pain syndrome. The efficacy was evaluated by the NIH Chronic Prostatitis Symptom Index (CPSI) after a 12 week follow-up."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All cases had completed the follow-up. Fifty-three cases (54.08%) were completely cured, accompanied by remarkable effective in 17 cases (17.35%) and improved in 23 cases (23.47%). The total remarkable efficacy was 71.43% and improved 94. 90%. Scores of CPSI decreased significantly compared with pre-treatment (95% confidence interval 12.85 approximately 17.91)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "It is suggested that transperineally intraprostatic injection of Chuanshentong may be a useful method for the treatment of CABP/CPPS."
        }
      ]},
