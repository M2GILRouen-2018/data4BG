      "Abstract": {
        "CopyrightInformation": "© 2017 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To report the long-term results after definitive chemoradiotherapy (CRT) for anal carcinoma, using consistent time-to-event endpoints."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS AND MATERIALS",
            "content": "Anal carcinoma patient charts were reviewed. All patients received definitive CRT. Overall survival (OS), local failure-free survival (LFFS), locoregional failure-free survival (LRFFS), distant metastasis-free survival (DMFS), and anal dysfunction-free survival (ADFS) were estimated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In total, 65 patients were included. CRT was well tolerated, with only 24.6% grade ≥3 acute toxicity. Overall, the 5-year OS, LFFS, LRFFS, and DMFS were 75.3, 60.2, 74.2, and 66.2%, respectively. Early complete clinical response and tumor stage at diagnosis were the strongest predictors of OS (p = 0.04) and local failure (p = 0.03), respectively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In the treatment of anal cancers, excellent ADFS and OS, and valid LFFS, LRFFS, and DMFS can be achieved with definitive CRT. Adequacy of time-to-event endpoints is paramount."
          }
        ]
      },
