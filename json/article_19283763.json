      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "(c) 2009 Wiley-Liss, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Prematurely born infants are at increased risk of sudden infant death syndrome (SIDS) if slept prone."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "WORKING HYPOTHESIS",
            "content": "Prematurely born infants would have an impaired response to an added dead space and lower respiratory muscle strength in the prone compared to the supine position."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Prospective study. PATIENT-SUBJECT SELECTION: Twenty-five infants, median gestational age of 30 (range 26-32) weeks."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODOLOGY",
            "content": "The infants were studied supine and prone at a median of 36 weeks postmenstrual age. Breath by breath minute volume was measured at baseline and after a dead space was incorporated into the breathing circuit; the time constant of the response was calculated. The maximum inspiratory occlusion pressure generated (MIOP) and the pressure generated over the first 100 msec (P(0.1)) during airway occlusion were assessed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The median time constant was longer (26 (range 8-106) sec vs. 22 (range 6-92) sec (P = 0.045)) and the median MIOP (P = 0.001) and P(0.1) (P = 0.003) were lower in the prone compared to the supine position."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Prematurely born infants have a dampened response to tube breathing and reduced respiratory muscle strength in the prone compared to the supine position, which may contribute to their increased vulnerability to SIDS in the prone position."
          }
        ]
      },
