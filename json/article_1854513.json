      "Language": "por",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "to investigate clinical and ECG stress test differences in middle aged males either asymptomatic or with non-anginal symptoms and no previous myocardial infarction."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "retrospective stress data file analysis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatients at the stress test laboratory."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "296 consecutive patients referred to diagnostic treadmill testing from January-1988 to June-1989."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "no differences were found between symptomatic or asymptomatic individuals in the 17 variables analysed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "despite the fact that patients with chest symptoms even if obviously non-anginal have an increased coronary disease prevalence when compared with age-matched asymptomatics, this difference seems to insufficient to be demonstrated by the ECG stress test results, making questionable the practical relevance of this symptomatic classification."
        }
      ]},
