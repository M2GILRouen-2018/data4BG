      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine the time to immediate and sustained clinical improvement in pain and sleep quality with pregabalin in patients with fibromyalgia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A post hoc analysis of four 8- to 14-week phase 2-3, placebo-controlled trials of fixed-dose pregabalin (150-600\u2009mg/day) for fibromyalgia, comprising 12 pregabalin and four placebo treatment arms."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "A total of 2,747 patients with fibromyalgia, aged 18-82 years."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Pain and sleep quality scores, recorded daily on 11-point numeric rating scales (NRSs), were analyzed to determine time to immediate improvement with pregabalin, defined as the first of ≥2 consecutive days when the mean NRS score was significantly lower for pregabalin vs placebo in those treatment arms with a significant improvement at endpoint, and time to sustained clinical improvement with pregabalin, defined as a ≥1-point reduction of the baseline NRS score of patient responders who had a ≥30% improvement on the pain NRS, sleep NRS, or Fibromyalgia Impact Questionnaire (FIQ) from baseline to endpoint, or who reported \"much improved\" or \"very much improved\" on the Patient Global Impression of Change (PGIC) at endpoint."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Significant improvements in pain and sleep quality scores at endpoint vs placebo were seen in 8/12 and 11/12 pregabalin treatment arms, respectively (P\u2009<\u20090.05). In these arms, time to immediate improvements in pain or sleep occurred by day 1 or 2. Time to sustained clinical improvement occurred significantly earlier in pain, sleep, PGIC, and FIQ responders (P\u2009<\u20090.02) with pregabalin vs placebo."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Both immediate and sustained clinical improvements in pain and sleep quality occurred faster with pregabalin vs placebo."
          }
        ]
      },
