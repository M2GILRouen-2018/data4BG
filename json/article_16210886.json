      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright (c) 2005 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Inhaled steroids are currently the most important drugs for asthma patients, but compliance tends to be low. Compliance could be improved by reducing the number of daily administrations."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "In the present study, we compared once- and twice-daily administration of fluticasone propionate (FP) to determine the differences in efficacy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Subjects were 40 patients diagnosed with bronchial asthma with stable symptoms and pulmonary functions who were on twice-daily FP administration of 100 microg. There were 14 men and 26 women ranging from 29 to 72 years of age. After a 4-week observation period, subjects were randomized into two administration groups by the envelope method and followed for 8 weeks: group A, once-daily administration (200 microg of FP at night), and group B, twice-daily administration (100 microg of FP in the morning and at night). Clinical symptoms, pulmonary functions and airway responsiveness were compared between these two groups."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No significant deterioration in clinical symptoms, pulmonary functions and airway responsiveness were observed in group A compared with group B."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These results demonstrate that once-daily FP administration is as effective as twice-daily administration, and that it may improve the compliance for inhaled steroids."
          }
        ]
      },
