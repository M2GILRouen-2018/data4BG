      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The incidence of infantile Blount disease is rising in parallel to the increasing obesity in children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Seven children (3 female) between the ages of 17 and 30 months (21.8 ± 4.3 months) were included in the study."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All patients had complaints of inward bowing of the legs and excess weight gain. The biochemical and hormonal assessments of all patients yielded normal results. Patients were diagnosed with infantile Blount disease based on clinical, laboratory, and radiological findings."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This disease should be differentiated from physiological genu varum, and the potential psychosocial and physical complications are prevented with early diagnosis and treatment."
        }
      ]},
