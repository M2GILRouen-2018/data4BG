      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the degree of knowledge of family physicians related to the International Guidelines for the Diagnosis and Treatment (GINA) of Asthmatic Patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHOD",
          "content": "We invited the family physicians from some clinics of Mexico City. A questionnaire was applied to 50 doctors who accepted to participate in the study; they had a 46 year-old age average and a proportion 1:1 between genders. The analysis was carried out with the test r of Pearson."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The correlation between general knowledge of asthma and knowledge of GINA was r = 0.022; between the general knowledge of asthma and the specialty of family medicine was r = -0.117; and that among the knowledge on International Guides of Asthma and the specialty of family medicine was r = 0.33."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A scarce knowledge exists on the guides proposed by GINA."
        }
      ]},
