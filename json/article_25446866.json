      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 SEPAR. Published by Elsevier Espana. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVE",
            "content": "To determine the prevalence of occupational asthma (OA) and work-exacerbated asthma (WEA) among asthmatic patients diagnosed in Primary Health Care (PHC). To analyze the impact at PHC level caused by under-diagnosis and inappropriate referral of OA."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "A descriptive, cross-sectional multicenter study in patients aged between 16 and 64years diagnosed with asthma, according to their medical record; all were working or had worked, and were assigned to one of 16 PHC centers in a healthcare district. Based on the responses to the questionnaire completed at the study visit, which included a thorough review of the subject's entire working history, patients were classified into three categories by an expert in occupational asthma: OA, WEA or common asthma (CA)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Three hundred and sixty-eight patients completed the questionnaire. The prevalence of OA was 18.2% (25% in men and 14.6% in women, P=.046), and 54 patients (14.7%) were classified as WEA. The proportion of patients with work-related asthma (WRA) was therefore 32.9%. Asthmatic patients with WRA took more sick leave than CA patients (P<.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A high prevalence of WRA was found, mostly treated in PHC. Under-diagnosis of WRA is widespread in PHC."
          }
        ]
      },
