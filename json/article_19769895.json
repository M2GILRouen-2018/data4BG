      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "We evaluate the safety and efficacy of a pain protocol using 1 mg intravenous (IV) hydromorphone followed by an optional dose of 1 mg IV hydromorphone 15 minutes later."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Prospective interventional study at an urban academic emergency department (ED). One milligram of IV hydromorphone was administered to adults 21 to 64 years of age who had acute severe pain. Fifteen minutes later, patients were asked whether they wanted more pain medication. If they answered yes, they received another 1 mg of IV hydromorphone and were again asked 15 minutes later whether they wanted more pain medication. The primary efficacy outcome was the proportion of patients who had adequate analgesia, defined as declining additional hydromorphone within 1 hour of entering the protocol. The primary safety outcome was incidence of oxygen desaturation less than 95%. Secondary outcomes included numeric rating scale pain scores and adverse events."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of the 223 patients with complete data, 1 mg IV hydromorphone provided adequate analgesia for 77% (95% confidence interval 71% to 82%) within 15 minutes and 96% (95% confidence interval 92% to 98%) within 1 hour of entering the protocol. Eighty-six percent of patients reported pain scores that decreased by 2 or more numeric rating scale units. Five percent experienced transient oxygen desaturation below 95%, which was corrected promptly with oxygen."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A rapid titration protocol using IV hydromorphone (1 mg hydromorphone followed by an optional 1 mg 15 minutes later) is efficacious in nonelderly ED patients with acute severe pain. There were no serious adverse events."
        }
      ]},
