      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the success of fluoroscopically guided, contrast-enhanced lumbar zygapophyseal joint (Z-joint) aspiration and steroid injection combined with transforaminal epidural steroid injections (TFESIs) for the treatment of lumbar Z-joint cyst-induced radicular pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective case series with independent follow-up."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Institutional, referral center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Twenty-three patients referred to a single provider for procedure-based management of radicular pain believed secondary to lumbar Z-joint cyst. Inclusion criteria consisted of lumbar radicular pain that was consistent with the level and side of the Z-joint cyst as a causative lesion."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Eighteen patients were treated with a fluoroscopically guided, contrast-enhanced Z-joint aspiration and steroid injection at the level of the causative cyst coupled with a fluoroscopically guided, contrast-enhanced TFESI over the level of the presumably irritated spinal nerve."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Patient satisfaction, and whether or not surgery was performed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Fifty percent of patients treated with the procedure had significant long-term benefit and avoided surgical intervention at an average follow-up of 9.9 months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Fluoroscopically guided, contrast-enhanced spinal procedures as part of an aggressive nonsurgical treatment program are a safe and effective alternative to surgical intervention for lumbar Z-joint cyst-induced radicular pain."
        }
      ]},
