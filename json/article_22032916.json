      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe food and beverage types offered and consumed during classroom celebrations at an elementary school in a low-income, urban community. In addition, to report student intake of fresh fruit provided alongside other party foods."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Observations held during 4 classroom celebrations. Food and beverage items were measured and counted before and after each celebration. Consumption data were recorded in aggregate for the entire classroom and later adjusted to mean intake per student."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Majority of items offered were low-nutrient, energy-dense foods. Mean caloric intake during celebrations ranged from 259 to 455 cal. Fruit provided during 2 of the 4 classroom celebrations resulted in a mean intake of 1 full serving per student."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Caloric intake from low-nutrient, energy-dense foods and beverages offered during classroom celebrations contributed 20% or more of daily caloric needs. However, fresh fruit may be a reasonable addition to the party food table."
          }
        ]
      },
