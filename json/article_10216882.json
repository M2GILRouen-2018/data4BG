      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Acute gout arthritis and tophaceous gout of the spine is rare."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "EXEGESIS",
          "content": "We report the case of a 54-year-old man with chronic low back pain. Physical examination and myelography showing neurological compression on L4 laminectomy evidenced tophaceous gout."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Gout arthritis should always be suspected and investigated in patients with either chronic low back pain or non-specific spinal cord compression."
        }
      ]},
