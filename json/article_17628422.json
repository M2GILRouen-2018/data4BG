      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Cardiac shock wave therapy (CSWT) improves cardiac function in patients with severe coronary artery disease (CAD). We aimed to evaluate the clinical outcomes of a new CSWT treatment regimen."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The 55 patients with severe CAD were randomly divided into 3 treatment groups. The control group (n = 14) received only medical therapy. In group A ( n = 20), CSWT was performed 3 times within 3 months. In group B ( n = 21), patients underwent 3 CSWT sessions/week, and 9 treatment sessions were completed within 1 month. Primary outcome measurement was 6-minute walk test (6MWT). Other measurements were also evaluated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The 6MWT, CCS grading of angina, dosage of nitroglycerin, NYHA classification, and SAQ scores were improved in group A and B compared to control group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A CSWT protocol with 1 month treatment duration showed similar therapeutic efficacy compared to a protocol of 3 months duration."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CLINICAL TRIAL REGISTRY",
          "content": "We have registered on ClinicalTrials.gov, the protocol ID is CSWT IN CHINA."
        }
      ]},
