      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To analyze the efficacy and safety of laparoscopic adjustable gastric placation (LAGBP), a new procedure for surgical treatment of obesity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Clinical and 1-year follow-up data of 10 patients who underwent LAGBP in our department between September and November 2011 were analyzed retrospectively."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The mean operative time was (93.0±13.4) min, while the mean intraoperative blood loss was (15.5±4.7) ml. The mean excessive body weight loss rate(%EWL) at 3, 6, 9 and 12 months after the operation was 25.1%, 40.6%, 45.3% and 50.8% respectively. There were no severe post operative complications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "LAGBP is associated with high safety and good short-term efficacy."
        }
      ]},
