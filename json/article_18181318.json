      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine the attitudes, beliefs, and expectations of gynecological patients regarding postoperative pain and management."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHOD",
          "content": "A prospective study performed in 112 patients undergoing major gynecological surgery, using a preoperative questionnaire regarding expectations toward postoperative pain and management and a postoperative questionnaire regarding actual pain experience, attitudes, and beliefs about pain and management."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The majority expected (92%) and experienced (89%) postoperative pain at moderate to very severe levels. The median visual analog scales (VAS) of expected and maximum experienced pain were 6.4 and 6 6, respectively. Ninety-eight percent reported at least moderate pain relief from the analgesics administered. Ninety-two percent were satisfied with their pain management. A significant number held misconceptions about postoperative pain and its management."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Patients should be preoperatively advised regarding postoperative pain and management. Misunderstandings should be corrected to improve the quality and adequacy of postoperative pain management."
        }
      ]},
