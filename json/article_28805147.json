      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Transdermal lidocaine therapy has become a gold standard as part of a treatment regimen for patients who suffer from localized pain. We compared transdermal patches: over-the-counter (OTC) lidocaine 3.6% combined with menthol 1.25%, prescription lidocaine 5% (Rx) and placebo."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In a double-blind, placebo-controlled trial, 87 patients were randomized to: OTC, Rx or placebo."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "OTC met primary end points of noninferiority compared with Rx for efficacy, side effects and quality of life. Versus placebo, OTC proved superiority for efficacy, general activity and normal work. Side effects were similar."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "It is theorized that menthol's ability to increase skin permeability facilitated more efficient drug delivery to the site of pain causing higher than expected efficacy. Decreased cost and resource utilization could benefit patients and payers."
        }
      ]},
