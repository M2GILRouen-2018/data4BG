      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the efficacy and safety of topical anaesthesia in reducing pain and incidence of vasovagal reactions during diagnostic hysteroscopy with endometrial biopsy in postmenopausal women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomised placebo-controlled double-blind study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Eighty postmenopausal women undergoing diagnostic hysteroscopy and endometrial biopsy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Two millilitres of 2% mepivacaine or saline solution were injected transcervically into the uterine cavity before performing the procedures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Evaluation of pain reduction on a visual analogue scale and continuous monitoring of heart rate and blood pressure."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The use of the anaesthetic significantly reduced the pain experienced at hysteroscopy and endometrial biopsy. The occurrence of vasovagal reactions was significantly lower in the anaesthetised group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Topical anaesthesia attenuated pain and effectively prevented the occurrence of vasovagal reactions during hysteroscopy and endometrial biopsy in postmenopausal women."
        }
      ]},
