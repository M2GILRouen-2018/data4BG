      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Editora Ltda. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We aimed to determine the value of ultrasonography (US) in the diagnosis of carpal tunnel syndrome (CTS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Two hundred patients (400 hands) were submitted to wrist US to measure median nerve area (MNA), questioning on paresthesia and pain in the median nerve territory, Tinel and Phalen maneuvers. An MNA > 9 mm(2) was considered diagnostic of CTS."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Measurement of MNA by US was > 9 mm(2) in 27% of the hands. A good association with pain (p < 0.0001), paresthesia (p < 0.0001), Tinel test (p < 0.0001) and Phalen test (p < 0.0001) was found. According to the clinical criteria for classification of CTS from American Academy of Neurology the MNA by US had 64.8% of sensibility and 77.0% of specificity in this sample."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Measurement of MNA by US performs well and can be used as first option for the investigation of patients with CTS."
          }
        ]
      },
