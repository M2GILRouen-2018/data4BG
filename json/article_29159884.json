      "Abstract": {
        "CopyrightInformation": "© 2017 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study was designed to investigate serum homocysteine (HCY) levels in acne patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Acne patients (n = 124) and healthy volunteers (n = 70), matched in terms of both age and sex, were enrolled. Serum HCY levels for all subjects were measured by a clinical laboratory."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Serum HCY levels in male and female patients with severe and moderate acne were significantly higher than in the healthy control group (P < .05). The constituent ratio of male and female acne patients with HCY above the normal range (10 mmol/L) was significantly higher than the healthy control group. The severity of acne patients was positively correlated with serum homocysteine concentration, (P < .01)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Hyperhomocysteinemia may be an independent risk factor for acne vulgaris. Detection of serum HCY is important for acne patients."
          }
        ]
      },
