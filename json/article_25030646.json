      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2014. Published by Elsevier B.V.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose of this study was to develop evidence-based guidelines on postoperative pain management via the web and to examine the effects in terms of pain level of patients undergoing abdominal surgery and nurses' knowledge of postoperative pain management."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "First, evidence-based pain guidelines were developed via the web in a tertiary hospital. Second, a special educational program on evidence-based pain guidelines for nurses was developed after validation of content by experts. Third, diverse strategies were adopted in order to facilitate incorporation of evidence-based pain guidelines in practice. Fourth, nurses in the study units were educated on evidence-based guidelines using the developed educational program for 3 weeks before their implementation of evidence-based pain guidelines to patients. Patients were assigned to the control group (from July 29 to August 20, 2011) and the experimental group (from September 24 to October 25, 2011) according to interrupted time interval. The data were analyzed using chi-square test, analysis of variance test with Scheffé's test as a post hoc and repeated measure of analysis of variance."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patients in the experimental group showed a significantly lower level of pain. Nurses' knowledge of management of postoperative pain showed a significant increase after installation of evidence-based guidelines."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Evidence-based pain guidelines were effective in reducing the pain level of patients as well as improving nurses' knowledge of pain management."
          }
        ]
      },
