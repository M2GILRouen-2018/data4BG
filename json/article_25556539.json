      },
      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© 2014 Nordic Federation of Societies of Obstetrics and Gynecology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the effect of bilateral ultrasound-guided transversus abdominis plane block with ropivacaine compared with placebo as part of a multimodal analgesic regimen."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A randomized, double-blind, placebo-controlled trial following the CONSORT criteria."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Hvidovre University Hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Forty-six women scheduled for total abdominal hysterectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Women received either ropivacaine 0.75%, 20 mL (n = 24) or 0.9% saline, 20 mL (n = 24) in the transversus abdominis plane on each side."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Primary outcome was the 24-h postoperative morphine consumption. Secondary outcomes were pain scores at rest and during coughing, postoperative nausea and vomiting at 1, 2, 4, 6, 8, and 24 h, and time to first mobilization."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was no difference in the mean 24-h postoperative morphine consumption between the two groups (p = 0.733). The ropivacaine group had significantly lower median pain scores at 1 h (p = 0.008) and 2 h (p = 0.027) postoperatively at rest and at 8 h (p = 0.028) during coughing. There was no significant difference in other secondary outcomes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "There was no reduction in 24-h morphine consumption when using an ultrasound-guided transversus abdominis plane block in women undergoing total abdominal hysterectomy. As part of a multimodal regimen the transversus abdominis plane block showed some effect on pain scores at rest only in the early postoperative period."
          }
        ]
      },
