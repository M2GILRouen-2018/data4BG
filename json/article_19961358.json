      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "IMPORTANCE OF THE FIELD",
          "content": "New formulations of opiods can provide round-the-clock pain relief to improve pain management and quality of life for patients with chronic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "AREAS COVERED IN THIS REVIEW",
          "content": "Information and comments on the pharmacokinetic processes associated with a new once-daily formulation of the potent opiod hydromorphone."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "WHAT THE READER WILL GAIN",
          "content": "This review presents an overview of data from several small pharmacokinetic studies to gain a better perspective on the pharmacokinetic properties of a new long-acting formulation of hydromorphone."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "TAKE HOME MESSAGE",
          "content": "The development of advanced oral formulation that deliver analgesic drugs over an extended period provides new solutions to improve pain management and quality of life for patients with chronic pain."
        }
      ]},
