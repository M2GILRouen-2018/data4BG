      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To compare recovery times and respiratory complications during emergence after deep extubation using either desflurane alone or a lower concentration of desflurane with remifentanil."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective randomized double-blind clinical trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Intraoperative."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "A total of 62 patients between the ages of 20 and 60 years with American Society of Anesthesiologists class I or II and who underwent low- to intermediate-risk surgery of 2- to 4-hour duration were enrolled."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Randomly assigned either 1.5 minimum alveolar concentration desflurane (group D; n = 31) or 1.0 minimum alveolar concentration of desflurane and 1.0 ng/mL effect-site concentration of remifentanil (group DR; n = 31)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Recovery times, from the time of extubation to the time when the patients could breathe without assistance, were awake enough to maintain the airway independently, and exited the recovery room, as well as respiratory complications were compared between the groups."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Recovery times were significantly reduced in the group DR (P < .001). The incidence of respiratory complications was also lower in group DR than in group D (48% vs 3.8%; P < .001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The combined use of remifentanil while lowering the concentration of desflurane improves recovery profiles during emergence after deep extubation."
          }
        ]
      },
