      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We describe a newly defined syndrome of protracted febrile myalgia in patients with familial Mediterranean fever (FMF)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Fourteen patients with FMF were admitted with an attack of severe disabling myalgia accompanied by fever, high erythrocyte sedimentation rate, and hyperglobulinemia, lasting up to 6 weeks."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Unlike in the classical manifestations of FMF response to corticosteroids therapy was prompt."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Protracted febrile myalgia is an uncommon dramatic manifestation of FMF that may occur despite colchicine therapy and requires treatment with corticosteroids."
        }
      ]},
