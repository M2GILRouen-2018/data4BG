      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Arnica is commonly used by the public as a treatment for bruising and swelling."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess whether Arnica administration affects recovery from hand surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Double-blind, randomized comparison of Arnica administration versus placebo."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Specialist hand surgery unit at the Queen Victoria NHS Trust."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Thirty-seven patients undergoing bilateral endoscopic carpal-tunnel release between June 1998 and January 2000."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Homeopathic Arnica tablets and herbal Arnica ointment compared to placebos."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Grip strength, wrist circumference, and perceived pain measured 1 and 2 weeks after surgery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No difference in grip strength or wrist circumference was found between the 2 groups. However, there was a significant reduction in pain experienced after 2 weeks in the Arnica-treated group (P<.03)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The role of homeopathic and herbal agents for recovery after surgery merits further investigation."
        }
      ]},
