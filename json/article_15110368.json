      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVES",
          "content": "To investigate, in mastectomy patients, the effectiveness of continuous cervical epidural block using a low-dose fentanyl infusion in combination with local anesthetics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, observational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "450-bed, university-affiliated hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "21 ASA physical status I and II female patients undergoing modified radical mastectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "An epidural catheter was inserted at the C(7)-Th(1) interspace before the induction of anesthesia. Anesthesia was maintained using a low concentration of sevoflurane with nitrous oxide-oxygen (N(2)O-O(2)). A mixture of 100 microg fentanyl and 49 mL of 1% mepivacaine was prepared, and 7 mL of this solution was epidurally injected before the initial incision. This same solution was continuously infused at a rate of 7 mL/hr (fentanyl 17.5 microg/hr) throughout the anesthesia, and at 2 mL/hr (fentanyl 5 microg/hr) postoperatively."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Intraoperative mean arterial pressure (MAP) and heart rate (HR), postoperative pain and analgesic use, and the frequency of postoperative side effects of anesthesia, including nausea, dizziness, and respiratory depression, were recorded. The protocol described provided stable intraoperative hemodynamic control with no or low-dose nicardipine infusion. Sufficient postoperative analgesia was achieved in 18 of 21 patients. One patient reported postoperative nausea, and no other side effects were reported."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Continuous epidural infusion of the low-dose fentanyl mixture described above provides adequate intraoperative hemodynamic control and postoperative pain relief, with a low rate of side effects in mastectomy patients."
        }
      ]},
