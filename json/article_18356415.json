      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This purpose of this study was to evaluate the accuracy and reproducibility of a voxel analysis technique for measuring noncalcified plaque in the coronary arteries."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Polyethylene phantoms representing noncalcified plaque were scanned in both MDCT and micro-CT scanners and inter- and intrareader variability of volume calculation was performed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Volume measurements by both MDCT and micro-CT were comparable to the true volume as measured by micrometry (< 3%, p = 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "There appears to be no significant difference (< 3%) between MDCT and micro-CT measurements."
        }
      ]},
