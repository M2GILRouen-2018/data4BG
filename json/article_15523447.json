      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study was undertaken to demonstrate the safety and efficacy of in vitro, radioallergosorbent test (RAST)-based inhalant allergen immunotherapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN AND SETTING",
          "content": "Prospective 22 year single site clinical study, with outcome evaluations of 480 perennial allergic rhinitis patients, including 96 with concomitant asthma."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Rhinitis symptom control after 2 years of immunotherapy was excellent in 32.5% of patients, good in 45.6%, and fair in 14.2%. There was no improvement in 7.7%. For patients with asthma, 81% had good or excellent pulmonary symptom improvement, and no patient failed to improve. No severe reactions occurred, but there were 5 limited systemic reactions, or 0.008% of injections, during a 2.5-year mean immunotherapy treatment course."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "RAST-based immunotherapy is safe and effective for patients with perennial allergic rhinitis, with or without concomitant asthma. Significance This is the first large, multiyear study of safety and efficacy of RAST-based immunotherapy for treatment of perennial allergic rhinitis and asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "EBM RATING",
          "content": "C."
        }
      ]},
