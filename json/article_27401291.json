      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "ETHNOPHARMACOLOGICAL RELEVANCE",
            "content": "Andrographis paniculata (Burm. f.) Nees (Acanthaceae) has a considerable medicinal reputation in most parts of Asia as a potent medicine in the treatment of Endocrine disorders, inflammation and hypertension."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM OF THE STUDY",
            "content": "Water extract of A. paniculata and its active constituent andrographolide are known to possess anti-inflammatory and anti-apoptotic effects. Our aim is to identify whether A. paniculata extract could protect myocardial damage in high-fat diet induced obese mice."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "The test mice were divided into three groups fed either with normal chow or with high fat diet (obese) or with high fat diet treated with A. paniculata extract (2g/kg/day, through gavage, for a week)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We found that the myocardial inflammation pathway related proteins were increased in the obese mouse which potentially contributes to cardiac hypertrophy and myocardial apoptosis. But feeding with A. paniculata extract showed significant inhibition on the effects of high fat diet."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Our study strongly suggests that supplementation of A. paniculata extract can be used for prevention and treatment of cardiovascular disease in obese patients."
          }
        ]
      },
