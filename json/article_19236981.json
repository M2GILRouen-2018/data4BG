      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the effects of steroid plus hyaluronate injections for scapulothoracic bursitis in patients with scapular pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective open-label unicenter trial with a 3-month follow-up."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University rehabilitation hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Twenty-two cases of suspected scapulothoracic bursitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Injections into scapulothoracic bursa were performed with steroid plus hyaluronate. Injections were administered once a week for 3 weeks."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Visual analog scale (VAS), Rubin scale, adverse events, and injection-associated complications."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Mean outcome scores at 3-month follow-up visits showed significant improvements versus baseline (mean VAS increased from 7.8 to 2.2) (P<.05). Furthermore, mean VAS scores at 1, 2, and 3 weeks after treatment commencement showed significant improvements versus baseline (P<.05). No serious complication occurred during the study."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Scapulothoracic bursitis should be considered when treating patients with perimarginal scapular pain or subscapular pain. Our findings show that steroid plus hyaluronate injections into the scapulothoracic bursa provide an effective means of treating patients with scapulothoracic bursitis."
        }
      ]},
