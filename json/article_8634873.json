          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To provide the allergist information regarding the recognition, diagnosis, classification, and management of headaches."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Literature and relevant articles pertaining to various types of headache are reviewed and the clinical experience of the authors is presented."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "After reading this article, the allergist should know the various causes of headache, recognize the warning signs of serious neurologic disease, and determine whether allergy or adverse food reactions are playing a role."
        }
