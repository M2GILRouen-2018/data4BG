      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the distribution and sociodemographic associations of BMI (kg/m2) among adults aged ≥40 years living in Timor-Leste."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "BMI was calculated for participants of a population-based cross-sectional survey."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Urban and rural Timor-Leste."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Adults aged ≥40 years living in Timor-Leste."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of those enumerated, 2014 participated (89·5 %). Male gender, rural domicile, older age, illiteracy and source of household income were associated with BMI < 18·5 kg/m2 on multivariate analysis. Female gender, urban domicile and literacy were associated with BMI ≥25·0 and ≥30·0 kg/m2. Adjusting for gender, age and domicile, and extrapolating to those aged ≥40 years across Timor-Leste, 9·9 %, 36·0 %, 6·6 % and 0·8 % had BMI <16·0, <18·5, ≥25·0 and ≥30·0 kg/m2, respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "At this time, being 'underweight' or 'severely thin' is more prevalent in the Timorese adult population than being 'overweight' or 'obese'."
        }
      ]},
