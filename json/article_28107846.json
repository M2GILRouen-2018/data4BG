      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Assess the efficacy of the breathing patterns during the active phase of the first stage of labor for maternal anxiety."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "DESING",
            "content": "Randomised trial with two treatment arms and intention-to-treat analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "One Hundred and forty patient in active labour, age between 12 and 40 years old and gestational age between 37 and 41 weeks. The breathing patterns waere made depending on the dilation phase and intensity of contraction, while the control group received routine care service."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was no difference between groups two hours after the first evaluation regarding to anxiety (MD 0.3 CI95% -4.2 to 4.8), pain (MD 0.0 CI95% -0.8 to 0.7), fatigue (MD -0.5 CI95% -1.4 to 2.5) and maternal satisfaction (MD 0.9 CI95% -0.1 to 2.0)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The study results showed that the use of breathing patterns during the first period of labour were not effective to control anxiety, pain, fatigue and maternal satisfaction."
          }
        ]
      },
