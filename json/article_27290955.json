      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To assess the efficacy of both Bonfils and GlideScope in obese patient with difficult airways for bariatric surgery using awake intubation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Comparative study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Operating room."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "The study was carried out on 60 patients, for laparoscopic bariatric surgery, after approval of the Medical Ethics Committee and having an informed written consent from each patient. Patients were randomly categorized into 2 equal groups 30 patients in each group."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Awake intubation with either Retromolar Bonfils or GlideScope."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Time to visualize the laryngeal inlet, time of intubation, time of scope manipulation, success rate at each attempt, the lowest oxygen saturation, hemodynamic parameters, and any complication."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Regarding intubation criteria, GlideScope achieves shorter times compared with Retromolar for visualization of the vocal cords and intubation, in addition to less intubation attempts, but both without a statistically significant difference. Retromolar shows better patient satisfaction than does GlideScope, with statistically significant difference."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Both Bonfils fiberscope and the GlideScope can be successfully used for awake intubation in morbidly obese patients with expected difficult airways. Bonfils intubating fiberscope was more tolerated by patients with statistical difference; on the other hand, GlideScope provided shorter intubation time and less intubation attempts but not statistically significant."
          }
        ]
      },
