      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate and compare the effectiveness of oral and vaginal misoprostol versus placebo to facilitate office hysteroscopy without anesthesia during infertile diagnostic evaluation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized, prospective trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Patients scheduled for diagnostic office hysteroscopy at a university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Seventy-five infertile patients scheduled for diagnostic office hysteroscopy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Patients were divided into three groups: group A received oral misoprostol 600 μg; group B, vaginal misoprostol 400 μg; and group C, oral placebo."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Pain, evaluated by visual analogue scale, and surgical time were recorded and compared. Statistical analysis was done using Student's t-test."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Pain was low in the vaginal misoprostol group. Mean visual analogue scale in the oral misoprostol group was 6.04 ± 1.5; in the vaginal misoprostol group 2.85 ± 1.2; and in the placebo group 7.50 ± 1.5. Procedural time for office hysteroscopy was shorter in the vaginal misoprostol group (2.7 ± 1.0 minutes) compared with group A (5.5 ± 1.1 minutes) and group C (6.3 ± 3.8 minutes)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Vaginal misoprostol, 400 μg, administered the day before office hysteroscopy considerably reduces pain and the time needed for hysteroscopy. This simple strategy may facilitate office hysteroscopy during an infertility work-up."
          }
        ]
      },
