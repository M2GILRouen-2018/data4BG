      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the adequacy and efficacy of postoperative pain management."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective clinical study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The Georgetown and New Amsterdam Public Hospitals, Guyana."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Two hundred consecutive patients undergoing major abdominal surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Presence or absence of significant postoperative pain during the first 24 hours."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All the patients experienced pain postoperatively. Sixty one per cent of patients considered their pain severe, 30% rated it moderate and only 9% mild. Reasons for this deficiency of care are partly attributable to the patients themselves and also the health care staff."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Postoperative pain is poorly managed in our general hospitals."
        }
      ]},
