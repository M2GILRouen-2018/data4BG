      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To review the key emerging side effects of precision medicine and provide discussion supporting multidisciplinary, interprofessional management."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "Journal articles indexed on the National Library of Medicine database."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Emerging side effects of the precision medicine era are distinct from those associated with traditional cytotoxic chemotherapy on a variety of dimensions. Management benefits from the expertise of an interprofessional team. Data supports the expansion of the interprofessional team to include other medical specialists to assure that patients experience maximum benefit from today's precision medicine treatments."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR NURSING PRACTICE",
            "content": "Oncology nurses must broaden their standard assessment to incorporate emerging side effects and collaborate effectively with an expanded interprofessional team."
          }
        ]
      },
