      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether a difference in breastfeeding behaviors could be observed between newborns whose mothers received epidural analgesia for labor pain relief and those newborns whose mothers received no pain medication in labor."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "There were two groups of neonates in this study. One group was born to mothers who received epidural analgesia, and one group was born to mothers who received no pain medication for labor. Both groups were observed for initial breastfeeding behaviors using the Premature Infant Breastfeeding Behavior Scale following birth and at 24 hours. Central nervous system functioning in the newborn was measured with the Neurologic and Adaptive Capacity Score at 2 and 24 hours of age."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A large tertiary hospital in northeast Ohio."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Fifty-six breastfeeding mother-newborn dyads. All mothers were healthy multiparae who gave birth vaginally to normal, full-term, healthy newborns."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Newborns were observed for rooting, latch on, sucking, swallowing, activity state, and neurobehavior."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no statistically significant differences in breastfeeding behaviors at birth or at 24 hours of age."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A possible cause for the lack of significant results may have been the ultra low dose of bupivacaine and fentanyl used in this sample."
        }
      ]},
