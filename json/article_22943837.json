      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "This study examined the relationship between childhood sexual abuse (CSA) and myocardial infarction in men and women, while controlling for social determinants (i.e., socioeconomic status, social support, mental health) and traditional cardiovascular risk factors (i.e., age, race, obesity, smoking, physical inactivity, diabetes mellitus)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Population-based data were obtained from the 2010 Behavioral Risk Factor Surveillance System. Myocardial infarction was ascertained by self-report of a health-professional diagnosis. CSA was defined as forced sex with someone at least 5 years older before the age of 18. The final sample included 5,095 men and 7,768 women."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After adjustment for 15 factors, abused males had nearly 3 times the odds of heart attack compared to non-abused males (OR=2.96; 95% CI=1.12, 7.85). Among women, CSA was not associated with heart attack in the age-race adjusted (OR=1.20; 95% CI=0.39, 3.68) or fully-adjusted (OR=0.88; 95% CI=0.28, 2.75) analyses."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "CSA was associated with heart attack in men, even when controlling for traditional risk factors; however, no association was found among women. Future research is needed to replicate the study's unique findings."
          }
        ]
      },
