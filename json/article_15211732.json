      "Language": "ita",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe the distribution of coronary risk in primary prevention using both the New Zealand and Italian charts, and to assess whether there is a relationship between the two scales built on data from populations at different natural coronary risk."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Carpi's district, Territorial Health Authority in Modena province."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Population between 40 and 69 years old without any background of cardiovascular disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN MEASURES",
          "content": "The variables studied corresponded to the Jackson's New Zealand table and the Italian Progetto Cuore's one. Concordance was assessed with the kappa coefficient."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "We studied 1850 men and 2235 women with an average age of 56 years. The percentage of 'high' coronary risk men and women at the New Zealand's chart was 27% and 8% respectively. Ten percent of 'high' risk men and no woman were found at the Italian chart. The kappa coefficient to evaluate the agreement on high risk men between the two charts was 'moderate' (kappa = 0.403). No estimation was allowed for women."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "There was moderate agreement between the New Zealand and the Progetto Cuore charts."
        }
      ]},
