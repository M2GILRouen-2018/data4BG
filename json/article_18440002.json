      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of ureterovaginal fistula secondary to transvaginal oocyte retrieval (TVOR)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "IVF Center IN a private hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 31-year-old woman presented immediately after TVOR with right lower abdominal pain with irradiation to the suprapubic area and vaginal discharge."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Vaginal examination, creatinine dosage in plasma and vaginal discharge, excretory urography. A double-J catheter was inserted under general anesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Clinical follow-up."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Vaginal leakage ceased a few hours after catheter insertion. Transfer of two embryos was performed 3 days after TVOR, but no pregnancy occurred. The double-J catheter was removed 21 days after its placement. Imaging studies done 6 weeks later demonstrated a normal urinary tract morphology."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Given the elective nature of TVOR and IVF, patients should be informed about all potential complications, including ureterovaginal fistula."
        }
      ]},
