      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To report long-term results of a novel sirolimus-eluting stent with biodegradable polymer BACKGROUND: Newer generation drug-eluting stents are characterized by thin struts, improved platform design and highly biocompatible polymer carrying the antiproliferative drug. The RapstromTM stent, sharing these features, showed promising outcomes in preclinical models and in a first-in-man trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The present study is a multicenter, non-randomized post-market registry, including patients with de novo coronary artery disease treated with implantation of one or more Rapstrom stents. Primary endpoint of the study was the rate of major adverse cardiac events (MACE) at three-year follow-up."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "1073 patients were enrolled, with a high prevalence of diabetes (35%) and acute coronary syndrome at presentation (82%); at three-year follow up, MACE rate was 14.8%, with a low incidence of definite or probable stent thrombosis (0.75%)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These data confirm the good clinical performance of the Rapstrom stent, supporting the concept that the combination of thin struts and biodegradable polymer is associated with positive clinical outcomes."
          }
        ]
      },
