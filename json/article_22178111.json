      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 The Canadian Society of Clinical Chemists. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate the laboratory diagnosis aspects of obesity-related health problems with special reference to postmenopausal breast cancer."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "We conducted a systemic search of the literature primarily from the PubMed to obtain the relevant data."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Obesity is associated with the dysregulations of a number of body components such as blood constituents, extracellular matrix, and hormones/growth factors axes, which could be utilized for early diagnosis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Obesity-related disorders including breast cancer have emerged as major health problems in almost all the nations. There is a need to elucidate different biochemical markers that are being used in the clinics or have the potential for such use. A precise understanding of the complex pathologies related with obesity is useful in prevention, early diagnosis and overall clinical management."
          }
        ]
      },
