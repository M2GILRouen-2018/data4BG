      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The AAOS guidelines are unable to recommend for or against operative treatment of distal radius fractures in older patients."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "This study compares the outcomes of older patients (≥60 years) against a cohort of younger patients treated with volar locking plate (VLP) fixation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We assessed 78 patients, comparing range of movement (ROM), grip and pinch strength, subjective Visual Analogue Score (VAS) for pain and function and composite outcome scores."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was no difference in clinical outcomes between the two groups at six months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Open reduction and VLP for distal radius fractures gives comparable outcomes in the older population."
        }
      ]},
