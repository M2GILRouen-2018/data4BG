      "Abstract": {
        "CopyrightInformation": "Georg Thieme Verlag KG Stuttgart, New York.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "HISTORY AND CLINICAL FINDINGS",
            "content": "A 72-year-old woman was admitted to the hospital with upper abdominal pain, nausea, vomiting, and obstipation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INVESTIGATIONS",
            "content": "Percutaneous ultrasound found aerobilia, a biliary-digestive fistula, and an ileus with gallstones within the small bowel. The findings were confirmed at computed tomography."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "TREATMENT AND COURSE",
            "content": "A gallstone ileus on the basis of a biliary-digestive fistula was diagnosed. The patient was treated by surgery and with antibiotics."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This case report demonstrates that percutaneous ultrasonography should be used as the first imaging procedure in the diagnosis of acute abdominal pain. This procedure makes it possible to detect a gallstone ileus. It is important also to define various intestinal structures accurately."
          }
        ]
      },
