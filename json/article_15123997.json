      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report and review of the literature."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To describe two patients with angiolipoma in the ventral aspect of the lumbar epidural space, to discuss the clinical, radiologic, and surgical features of these lesions, and to review previously reported cases."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Rome, Italy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Two cases, a 60-year-old man and a 54-year-old woman presented with lumbar-sciatic pain but with no abnormal neurological signs. Investigation (CT and MRI) demonstrated lumbar tumours."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Laminectomy and excision of the tumors were performed, and symptoms improved immediately."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Magnetic resonance imaging with suppression fat sequences allows the recognition of these lesions. The prognosis after surgical removal of spinal angiolipoma is favorable."
        }
      ]},
