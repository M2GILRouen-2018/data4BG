      "Abstract": {
        "CopyrightInformation": "Copyright © 2017. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Obesity (BMI≥30) may be an etiologic and prognostic factor in inflammatory breast cancer (IBC). We examined the relationship between BMI, pathologic complete response (pCR), and circulating-tumor-cell (CTC) levels in IBC."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Cohort included IBC patients diagnosed 2005-2015 who had neoadjuvant chemotherapy during a prospective trial on CTCs and pathologic review describing pCR. Chi-square, logistic regression, and Cox proportional hazards models were used to identify clinicopathologic associations with event-free survival (EFS)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 73 patients, 61 (84%) had CTC values, 22 (30%) achieved a pCR, and 39 (53%) were obese. There was no difference between obese and non-obese patients for pCR rates (31% vs. 29%, p = 0.90) or presence of CTCs (23% vs. 26%, p = 0.80). Among non-obese patients, CTCs were associated with worse EFS (HR 11.69, p < 0.01), but among obese patients, there was no difference in EFS between those with and without CTCs."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "BMI mediates CTCs' prognostic significance in IBC."
          }
        ]
      },
