      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine uric acid (UA) as a possible predictor of the progression of coronary artery calcification (CAC) using data from the prospective Coronary Artery Calcification in Type 1 Diabetes (CACTI) Study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "RESEARCH DESIGN AND METHODS",
          "content": "CAC was measured by electron beam tomography at the baseline and at a follow-up 6.0±0.5 years later. The study population included 443 participants with type 1 diabetes and 526 control subjects who were free of diagnosed coronary artery disease at baseline. The presence of renal disease was defined by the presence of albuminuria and/or low glomerular filtration rate."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In subjects without renal disease, serum UA predicted CAC progression (odds ratio 1.30 [95% CI 1.07-1.58], P=0.007) independent of conventional cardiovascular risk factors including diabetes and the presence of metabolic syndrome."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Serum UA levels predict the progression of coronary atherosclerosis and may be useful in identifying who is at risk for vascular disease in the absence of significant chronic kidney disease."
        }
      ]},
