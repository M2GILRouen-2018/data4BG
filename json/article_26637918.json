      "Abstract": {
        "CopyrightInformation": "Copyright© 2015 International Institute of Anticancer Research (Dr. John G. Delinassios), All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "Although the impact of testosterone or obesity on the efficacy of androgen-deprivation therapy (ADT) has been reported, there exist few comprehensive analyses on the impact of these factors on ADT outcome. Therefore, in the present study, we investigated the relationship between serum testosterone or body mass index (BMI) and prognosis among men treated with primary ADT for metastatic prostate cancer."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "The study included fifty-six Japanese patients with prostate cancer treated at our Institution from 2000 through 2012. The relationship between serum testosterone or BMI and progression-free survival, cancer-specific survival, and overall survival among men with metastatic prostate cancer treated with primary ADT was examined."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The median of serum testosterone and BMI were 397 ng/dl (interquartile range (IQR), 278-464 ng/dl) and 21.9 kg/m(2) (IQR, 19.2-23.6 kg/m(2)), respectively. Median progression-free survival, cancer-specific survival, and overall survival were 23.2 months, 68.9 months, and 68.1 months, respectively. Among clinicopathological parameters, the lowest-quartile group of serum testosterone level was a significant predictor of poor cancer-specific survival and overall survival as well as survival from castration resistance. However, BMI was not associated with prognosis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Serum testosterone level, but not obesity, is a prognostic factor for outcome including survival after getting castration-resistant prostate cancer in men with metastatic prostate cancer having undergone primary ADT."
          }
        ]
      },
