      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the prevalence of hypertension and to identify predictors of adult hypertension specifically in an underdeveloped urban region of eastern India."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Population-based cross-sectional study, with multi-stage random sampling technique."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTINGS",
          "content": "A main urban city located in South Orissa in eastern India."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "1178 adults 20-80\u2005years of age randomly selected from 37 electoral wards of an urban locale."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STATISTICAL METHODS",
          "content": "Descriptive and multivariable logistic regression analyses."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The prevalence of hypertension was 36%. Significant predictors of hypertension were age, central obesity, inadequate fruit intake, diabetes, low high-density lipoprotein level and physical inactivity."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "One-third of the adults in this urban population of eastern India are reported to be hypertensive and the classical risk factors have been found to contribute to the increased burden, which reinforces the importance of preventive cardiovascular interventions in tackling this burden."
        }
      ]},
