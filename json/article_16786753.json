      "Language": "pol",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "The aim of this study was to assess the score of HADS and the correlation with sociodemographic data in patients after spine surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL",
          "content": "40 patients after spine surgery because of low back pain and 20 persons of control group participated in the study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "HADS was used in the study. Socidemographic data were collected by means of Socio-demographic data questionnaire."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients after spine surgery had worse results in HADS-A and HADS-D in comparison to control group. Men, older, worse-educated, unemployed, reporting more concomitant disease and medicine taking patients were more depressed. Anxiety correlated with age, education, tacking medicine and improvement after surgery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Patients after spine surgery need multidisciplinary care because of higher level of anxiety and depression."
        }
      ]},
