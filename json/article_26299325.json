      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "The primary aim of the study is to determine if Hip Abduction and External Rotation (HABER) test is capable of reproducing familiar pain in individuals with low back pain (LBP) of sacroiliac joint (SIJ) origin (SIJ-positive) when compared with LBP of Non-SIJ origin (SIJ-negative). If so, the secondary aim is to determine the diagnostic accuracy of HABER test against the reference standard of pain provocation tests, and to determine which increments of the HABER test has highest sensitivity and specificity for identifying SIJ-positive individuals."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Single-blinded diagnostic accuracy study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Participants [n(122)] between ages of 18-50 y, suffering from chronic non-specific LBP (≥3 months) volunteered in the study. An experienced musculoskeletal physiotherapist evaluated and classified participants into either SIJ-positive [n(45)] or SIJ-negative [n(77)], based on reference standard of pain provocation tests [≥3 positive tests = SIJ-positive]. Another musculoskeletal physiotherapist, blinded to clinical groups, evaluated participants for reproduction of familiar pain during each increment (10°, 20°, 30°, 40°, and 50°) of HABER test."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The HABER test reproduced familiar pain in SIJ-positive individuals when compared with SIJ-negative individuals [p (0.001), R(2) (0.38), Exp(β) (5.95-10.32)], and demonstrated moderate level of sensitivity (67%-78%) and specificity (71%-72%) for identifying SIJ-positive individuals. Receiver operator curve analysis demonstrated that the HABER increments of ≥30° have the highest sensitivity (83%-100%) and specificity (52%-64%)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The HABER test is capable of reproducing familiar pain in SIJ-positive LBP individuals and has moderate levels of sensitivity and specificity for identifying SIJ-positive LBP individuals."
          }
        ]
      },
