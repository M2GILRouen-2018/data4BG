      "Abstract": {
        "CopyrightInformation": "© 2015 The Authors. Journal of Paediatrics and Child Health © 2015 Paediatrics and Child Health Division (Royal Australasian College of Physicians).",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To investigate association between nutritional status, adiposity and asthma severity and control in children."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We conducted a case control study at two teaching hospitals in Brazil. Cases were children (3-12 years) with persistent asthma and age-matched controls were those with intermittent asthma. Nutritional status was assessed by body mass index (BMI). Adiposity was assessed by sum of skinfolds and waist circumference (WC). Crude and adjusted odds ratios (ORs) and 95% confidence intervals (95% CIs) were calculated using conditional logistic regression or multinomial logistic regression as appropriate."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Two hundred sixty-eight cases and 126 controls were included. Obesity (>2 BMI\u2005z-score for age) was significantly associated with persistent asthma (adjusted OR 2.62; 95% CI 1.39-4.95). There was a significant linear relationship between BMI\u2005z-scores (≤1, >1 to ≤2, >2) and risk of having persistent asthma (P = 0.003 for linear trend). Children with WC >90th percentile had a higher risk of persistent asthma when compared with those with WC ≤90th percentile (adjusted OR 3.38; 95% CI 1.26-9.06). No significant difference was found in terms of nutritional status and adiposity between children whose asthma was controlled by inhaled corticosteroids and those requiring inhaled corticosteroids plus other medications for asthma control."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Obesity measured by BMI and increased abdominal adiposity are significantly associated with risk of persistent asthma but not type of controller medications."
          }
        ]
      },
