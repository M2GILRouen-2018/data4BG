      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study explored the associations between work patterns and indicators of cardiometabolic risk in female hospital employees."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Aspects of work environments potentially influence the health of employees; however, we have a poor understanding of how different hospital work patterns contribute to cardiovascular risk in female employees."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We conducted a cross-sectional study of 466 female employees from 2 hospitals in Ontario. Data were collected through self-report, physical examination, and use of hospital administrative work data."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In the adjusted analyses, full-time work status, extended shift length, and working 35 or more paid overtime hours per year were significantly associated with metabolic syndrome."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Different work patterns increase cardiometabolic risk in female employees, suggesting a need to better monitor the health of the workforce and implement healthy workplace policy."
        }
      ]},
