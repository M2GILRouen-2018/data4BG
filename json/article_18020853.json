      "Abstract": {
        "CopyrightInformation": "(PsycINFO Database Record (c) 2007 APA, all rights reserved).",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The current study tested the effectiveness of interactive versus passive distraction that was delivered via a virtual reality type head-mounted display helmet for children experiencing cold pressor pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Forty children, aged 5 to 13 years, underwent 1 or 2 baseline cold pressor trials followed by interactive distraction and passive distraction trials in counterbalanced order."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Pain threshold and pain tolerance."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Children who experienced either passive or interactive distraction demonstrated significant improvements in both pain tolerance and pain threshold relative to their baseline scores. In contrast, children who underwent a second cold pressor trial without distraction showed no significant improvements in pain tolerance or threshold."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Although both distraction conditions were effective, the interactive distraction condition was significantly more effective. Implications for the treatment of children's distress during painful medical procedures are discussed."
          }
        ]
      },
