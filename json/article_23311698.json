      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© 2013 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "There is controversy about the relation of thyroid functions and body mass index. The present study was aimed to assess the relationship between thyroid function and body mass index in Indian school children."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Population survey."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Data were collected from 25 schools in 19 cities across five different geographical zones of India. Children, who consented, were evaluated for anthropometry and blood tests. Children were categorized as overweight and obese based on standard BMI criteria."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Serum samples were analysed for free T3, free T4, TSH and anti-TPO antibodies."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 13,691 children in the age group of 5-18 years formed the study population. The mean age and mean BMI were 11·9 ± 3·0 years and 18·48 ± 3·89 kg/m² respectively. Among these, 2119 (15·5%) children were overweight and 536 (3·9%) were obese. Subclinical hypothyroidism was present in 943 (6·9%) children.FT3 and TSH levels increased and FT4 levels decreased with increasing BMI in euthyroid boys and girls. Prevalence of SCH was significantly higher in obese/overweight children (9·0%, vs 6·5%; P = 0·034) as compared with normal BMI children."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Serum FT3 and TSH were positively while FT4 was negatively associated with BMI in apparently healthy euthyroid children."
          }
        ]
      },
