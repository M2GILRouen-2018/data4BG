      "Abstract": {
        "CopyrightInformation": "© 2014 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Understanding occupational variations in health risks is necessary to identify high risk groups. We examined the recent prevalence of obesity, heavy alcohol consumption, smoking, and leisure time physical activity (PA) across occupations."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Data from the 2010 National Health Interview Survey were used. Analysis was limited to adults, 18 and older who had a job or business the week before the interview (n\u2009=\u200914,754). Adjusted prevalences of outcomes across occupations were calculated using logistic regression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The highest prevalence of obesity was within community and social services and morbid obesity was in computer and mathematical occupations. That of smoking was highest in healthcare support, heavy drinking in food preparation and serving related, and non-adherence to PA recommendations in the farming, fishing, and forestry occupations."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Important health risk factors vary across occupations. Worksite and public health interventions need to be designed and modified to address such occupational health disparities."
          }
        ]
      },
