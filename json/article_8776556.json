        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "We describe two patients with cancer-related low back and bilateral lower extremity pain that failed pharmacologic treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In both cases, commissural myelotomy provided significant pain relief. The role of myelotomy in the management of cancer pain is discussed."
        }
