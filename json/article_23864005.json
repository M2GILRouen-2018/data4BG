      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To present a structured approach for an outpatient consultation of a child with hypermobility."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Review of the literature and a description of the approach commonly adopted in a paediatric out-patient setting."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A focused history and examination is the key to reaching an appropriate differential diagnosis and planning management for children with hypermobility."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "A 10-year-old child is referred to your general paediatric clinic with frequent 'cracking and clicking' of her joints and a history of intermittent aches and pains over the last 6 months."
        }
      ]},
