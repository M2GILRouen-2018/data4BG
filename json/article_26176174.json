      "Abstract": {
        "CopyrightInformation": "© 2015 Asia Pacific League of Associations for Rheumatology and Wiley Publishing Asia Pty Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS",
            "content": "Explorations of travel impediments among patients suffering from rheumatic diseases have been very limited. Research has consistently indicated a shortage of rheumatologists, resulting in patients potentially having to travel long distances for care. The purpose of our study was to explore how systemic lupus erythematosus (SLE) patients experience travel issues differentially by race and socio-economic status."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We conducted semi-structured interviews and a brief demographic survey with 10 patients diagnosed with SLE. Interview transcripts were coded and analyzed using NVivo Analysis Software to facilitate the reporting of recurrent themes and supporting quotations, and an initial codebook was independently developed by two researchers on the study team and then verified together."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patients described three major areas of concern with respect to travel burden in accessing their rheumatologists: reliance on caregivers; meeting financial priorities; and pain and physical limitations."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our data suggest general traveling challenges interfering with medical appointment compliance for several participants and the importance of socio-economic issues when considering travel issues. This study highlights an important area with implications for adherence to medical appointments and participation in research among patients with SLE."
          }
        ]
      },
