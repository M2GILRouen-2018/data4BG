      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine the use of a standard hospital glove, inflated as a balloon with a face drawn on it, as a distraction technique in children with an acute injury."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We designed a study to assess the 'best' way to orientate the glove when drawing a face on it. A prospective study was performed in the authors' institution, where all children between the ages of 2 and 8 years presenting during the study period were given the option of playing with one of two glove balloons with a face drawn on it in two different ways."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "149 paediatric patients were assessed, of whom 136 picked a glove, 75 picked the 'Jedward' version and 61 the 'Mohawk' version."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A standard hospital glove, inflated as a balloon with a face drawn on it, is a useful distraction for children with an acute injury. The face drawn should be drawn 'Jedward' style."
        }
      ]},
