      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Omentin-1, an adipokine secreted from visceral adipose tissue, has been reported to be associated with coronary artery disease (CAD) and metabolic disorders."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To clarify the relationship between serum omentin-1 levels and the presence and severity of CAD in patients with metabolic syndrome (MetS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We measured serum omentin-1 levels in 175 consecutive patients with MetS and in 46 controls."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Serum omentin-1 levels are inversely associated with the presence and angiographic severity of CAD in MetS patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Serum omentin-1 might be a potential biomarker to predict the development and progression of CAD in MetS patients."
        }
      ]},
