      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 National Association of Pediatric Nurse Practitioners. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The two main objectives were to identify addictive-like eating in youth and determine the relationship between addictive-like eating, hedonic hunger, and psychological variables."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A cross-sectional design was used. Each subject's objective heights and weights were measured. Subjects completed questionnaires about anxiety, depression, appetitive responsiveness, addictive-like eating, other forms of disordered eating, and exercise patterns."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Sixty-five children, ages 9 to 14 years, participated in the study. The mean body mass index percentile for age and gender was 69%. Thirty-eight percent of the children were either overweight or obese. Sixteen percent reported three or more addictive-like eating behaviors, and 4% met the criteria for \"food addiction.\" Addictive-like eating was significantly correlated with appetitive responsiveness but not body mass index, anxiety, depression, or other measures of disordered eating."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Addictive-like eating occurs in children as young as 9 years and appears to be a different type of disordered eating. The hedonic value and proximity of food is a contributor to addictive-like eating behaviors."
          }
        ]
      },
