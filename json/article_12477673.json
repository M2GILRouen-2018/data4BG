      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the efficacy of transcutaneous electroacupoint stimulation with a train-of-four (TOF) mode for the prevention of postoperative nausea and vomiting (PONV) in the patients undergoing laparoscopic cholecystectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Ninety-six ASA Grade I - II patients scheduled for laparoscopic cholecystectomy were randomized into Neiguan (P6) electroacupoint stimulation group (treated group) and a placebo control group (placement of electrodes without electroacupoint stimulation). The anesthetic regimen was standardized by needling at Neiguan on the left side and connecting the TOF peripheral nerve stimulator. The incidence of nausea, vomiting, severity, antiemetic dosage and the degree of pain were assessed at 0, 60, 120 min, and 24 h after surgery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The incidence of nausea and vomiting, the dose of antiemetics and the occurrence of severe nausea were all significantly lower in the treated group compared with the control group and the score for pain was obviously reduced in patients of the treated group at 24 h post-operation (P<0.05 or P<0.01)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Transcutaneous electroacupoint stimulation at P6 with the TOF mode could reduce the incidence and severity of nausea and vomiting with analgesic effects."
        }
      ]},
