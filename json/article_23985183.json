      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the association between high blood cholesterol diagnosis and colorectal cancer screening practices."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Data were obtained from the 2007 Behavioral Risk Factor Surveillance System files."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Among individuals diagnosed with high cholesterol, 97% did not engage in colon cancer screenings compared to 3% who engaged in screenings (p < .001); 72% were more likely to be overweight/obese compared to 28% of normal weight; 76% consumed fewer fruits and vegetables per day compared to 24% who consumed more; 54% did not participate in physical activity compared to 46% who were active (p < .001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The behaviors of individuals diagnosed with high blood cholesterol are different relative to colon cancer screening practices."
        }
      ]},
