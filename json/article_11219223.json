      "Abstract": {
        "CopyrightInformation": "© 2013 Diabetes Technology Society.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Disturbed sleep and nocturnal altered breathing are related to disturbances of glucose metabolism. The present uncontrolled observational study explores the role of these factors on the variability of fasting glycemia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The number and duration of nocturnal awakenings and the fasting glycemia of 97 patients with type 2 diabetes treated with diet, metformin, or gliptins were recorded over seven consecutive days. During the same time period, the main respiratory indexes-oxygen disturbance index, apnea/hypopnea index, and respiratory disturbance index-were recorded for one night."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The three respiratory indexes and the number of nocturnal awakenings are highly correlated with the coefficient of variation of the fasting blood glucose recorded over the 7-day period at p < .005 level. A multiple regression analysis showed that the variables in the model explained 86% of the variability."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Respiratory/sleep disturbances appear to be modulators superimposed on blood glucose levels determined by other factors."
          }
        ]
      },
