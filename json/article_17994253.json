      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "To determine objective and subjective indications of quality of life in hospitalized geriatric patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Data were collected on 267 items using standardized interviews of 90 patients, including B-L and SF-36."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In comparison to the control population, geriatric patients have worse SF-36 values; 91% have pain, and 63% depression and elevated B-L values. Pain therapy is usually with non-opiates and with warm/cold physical therapies."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Pain therapy in the geriatric population surveyed does not reach the same standard as is usually offered to hospitalized medical and surgical patients."
        }
      ]},
