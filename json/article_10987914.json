      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report the association of temporal arteritis and enhancement of the dura mater and temporalis muscle."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND METHODS",
          "content": "A single patient with a complaint of headache and diplopia was studied."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Academic medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT",
          "content": "A 69-year-old man presented with lateral rectus weakness, temporal artery tenderness, and an erythrocyte sedimentation rate of 65 mm/h."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Biopsy of temporal artery and dura mater."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Brain magnetic resonance imaging and pathological findings."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Magnetic resonance imaging of the brain showed multifocal dural enhancement and enhancement of the temporalis muscles. The temporal artery showed a necrotizing vasculitis and the dura showed perivascular inflammatory cells."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "It is proposed that the temporal arteritis caused the multifocal dural enhancement and temporalis muscle enhancement on magnetic resonance imaging."
        }
      ]},
