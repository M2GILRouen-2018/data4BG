      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study presents the prevalence of different somatic and psychological complains in a sample of Italians early-adolescents and adolescents. Aim of the study is to verify sex and age (11, 13 and 15) differences in a variety of symptoms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "The survey is part of the larger Health Behaviour in School Aged Children (HBSC) trans-national study co-ordinated by the European Office of the World Health Organization. The data were gathered through self-completion questionnaire. The main areas covered in the questionnaire were health and health behaviour."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "151 middle school and 92 high school randomly retrieved from the list of the Italian public and private school."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "The questionnaire was filled out by a representative sample of 4,386 (48.4% males) Italian early adolescents."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Psychological and somatic complains."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Results revealed an increase of health problem with age, and these increases being greater for females than males."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Increasing morbidity for female occurs during transitions phase of early-adolescence."
        }
      ]},
