      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© 2014 Royal College of Obstetricians and Gynaecologists.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the effectiveness of an eHealth intervention on recovery and return to work, after gynaecological surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomised multicentre trial that ran from March 2010 until September 2011."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Secondary care in seven general and university hospitals in The Netherlands."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "POPULATION",
            "content": "A cohort of 215 women (aged 18-65 years) who had a hysterectomy and/or laparoscopic adnexal surgery for a benign indication."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The women were randomly assigned to the intervention group (n = 110) or the control group (n = 105). The intervention group received an eHealth programme that provided personalised tailor-made pre- and postoperative instructions on the resumption of daily activities, including work, and tools to improve self-empowerment and to identify recovery problems. The control group was provided with access to a control website."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "The primary outcome was the duration of sick leave until a full sustainable return to work. Secondary outcome measures were quality of life, general recovery, and pain intensity."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In intention-to-treat analysis the eHealth intervention was effective on time to return to work (hazard ratio 1.43; 95% confidence interval 1.003-2.040; P = 0.048). The median duration of sick leave until a full sustainable return to work was 39 days (interquartile range 20-67 days) in the intervention group and 48 days (interquartile range 21-69 days) in the control group. After 26 weeks pain intensity was lower (visual analogue scale, cumulative odds ratio 1.84; 95% confidence interval 1.04-3.25; P = 0.035) and quality of life was higher (Rand-36 health survey, between-group difference 30, 95% confidence interval 4-57; P = 0.024) in the intervention group, compared with the control group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The use of the eHealth intervention by women after gynaecological surgery results in a faster return to work, with a higher quality of life and less pain."
          }
        ]
      },
