      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the effectiveness of rectal naproxen for reducing perineal pain after vaginal delivery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A double-blind randomized controlled trial of 142 post partum women randomly allocated to receive either naproxen (71 patients) or placebo (71 patients) suppositories. The first dose was given immediately after complete perineal suturing, while the second dose was given 6 hours post partum. The validated Thai short-form McGill pain questionnaire was used to evaluate perineal pain at 0, 6, and 24 hours post partum. Pain scores were analyzed using the unpaired t test."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pain scores at 6 and 24 hours for women in the naproxen group were significantly lower compared with women in the placebo group (6.4 and 2.3 vs 18.4 and 5.5; P<0.001). No side effects with naproxen were found."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Rectal naproxen is effective and safe for reducing perineal pain after vaginal delivery."
        }
      ]},
