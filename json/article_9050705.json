      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To evaluate the efficacy and safety of topical anesthesia in reducing pain and the frequency of vasovagal reactions during diagnostic hysteroscopy with endometrial biopsy in postmenopausal women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, placebo-controlled, double-blind study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Forty-two postmenopausal women undergoing diagnostic hysteroscopy and endometrial biopsy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Two milliliters of 2% mepivacaine or saline solution was injected transcervically into the uterine cavity before performing the procedures."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Pain was evaluated on a visual analog scale, and heart rate and blood pressure were monitored continuously. Anesthesia reduced the pain experienced at hysteroscopy and endometrial biopsy, but not significantly. The frequency of vasovagal reactions was significantly lower in the anesthetized group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Topical anesthesia effectively prevents the occurrence of vasovagal reactions in postmenopausal women undergoing hysteroscopy and endometrial biopsy."
        }
      ]},
