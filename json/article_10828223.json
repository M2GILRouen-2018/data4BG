      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright 2000 Harcourt Publishers Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "to clarify the efficacy and safety of Prostar Plus, a new percutaneous vascular surgical device (PVS) for vascular haemostasis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "prospective randomised controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "a consecutive series of 60 patients were randomised to either PVS (n =30) or conventional manual compression ( n =30) following coronary angioplasty or stenting with femoral access using an 8-F sheath."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "PVS significantly shortened the time to haemostasis (10 s.d. 3 vs. 27 s.d. 9 min, p <0.001), ambulation (2.2 s.d. 0.9 vs. 11.0 s.d. 1.4 h, p <0.001), and discharge (2.2 s.d. 0.4 vs. 3.1 s.d. 0.7 days, p <0.01), compared with the manual compression group with no major complications. PVS also increased patient comfort assessed by using a visual-analogue scale method. Although these clinical benefits reduced the hospital cost ($1301 s. d. 248 vs. 1613 s.d. 460, p <0.05), the cost of the PVS device (approximately $350) cancelled the cost-saving benefit."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "this randomised study indicates that Prostar Plus is safe, more effective and comfortable than conventional manual compression."
          }
        ]
      },
