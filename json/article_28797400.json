      "Abstract": {
        "CopyrightInformation": "Published by Elsevier Inc.",
        "AbstractText": {
          "NlmCategory": "METHODS",
          "Label": "CASE PRESENTATION",
          "content": "An 84-year-old man without a history of smoking presented with progressive dyspnea of 6 months' duration accompanied by fatigue and unintentional weight loss. He denied fever, chills, chest pain, hemoptysis, rash, joint pains, or muscle aches. He had multiple hospitalizations for similar presentations that were diagnosed as pneumonia. History was significant for diastolic heart failure, hypertension, and type 2 diabetes mellitus."
        }
      },
