      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright 2002 American Orthopaedic Society for Sports Medicine",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Back pain is prevalent among intercollegiate rowers."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "We conducted a large-scale study to determine the rate of and the potential etiologic factors for clearly defined back pain that developed during intercollegiate rowing."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Survey."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Surveys from 1632 former intercollegiate rowing athletes were analyzed. These surveys concerned training methods and back pain before and during intercollegiate rowing. Back pain was defined as pain that lasted at least 1 week."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Five hundred twenty-six subjects reported that back pain developed during intercollegiate rowing. Factors significantly associated with the development of back pain included age at the time of the survey; history of rowing before age 16; use of a hatchet oar blade; training with free weights, weight machines, and an ergometer; midline ergometer cable position; and ergometer training sessions longer than 30 minutes. Back pain while in college also was associated with higher mean college weight and height."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Intercollegiate rowers in the last 10 years covered by this study were larger, started rowing at an earlier age, trained more intensely, and developed more back pain during college than their predecessors."
          }
        ]
      },
