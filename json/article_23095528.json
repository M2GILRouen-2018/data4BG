      "Abstract": {
        "CopyrightInformation": "Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Patients with müllerian agenesis may be at an increased risk of ovarian torsion due to the absence of the utero-ovarian ligament and the fact that the ovary is not tethered to a fixed and relatively non-mobile structure, the uterus."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE",
            "content": "We report a case of a 14-year-old female with abdominal pain who had a physical examination suggestive of müllerian agenesis. Imaging was non-diagnostic and demonstrated an abdominal mass. Emergent surgery revealed ovarian torsion."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "SUMMARY AND CONCLUSION",
            "content": "We present this case of ovarian torsion and müllerian agenesis, in order to highlight the association and to review potential risk factors."
          }
        ]
      },
