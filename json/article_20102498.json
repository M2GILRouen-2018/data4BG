      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Equine recurrent airway obstruction (RAO) shares many characteristics with human asthma. In humans, an inverse relationship between susceptibility to asthma and resistance to parasites is suspected."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "HYPOTHESIS/OBJECTIVES",
          "content": "Members of a high-incidence RAO half-sibling family (F) shed fewer strongylid eggs compared with RAO-unaffected pasture mates (PM) and that RAO-affected horses shed fewer eggs than RAO-unaffected half-siblings."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANIMALS",
          "content": "Seventy-three F and 73 unrelated, age matched PM."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Cases and controls kept under the same management and deworming regime were examined. Each individual was classified as RAO affected or RAO unaffected and fecal samples were collected before and 1-3 weeks and 3 months after deworming. Samples were analyzed by combined sedimentation-flotation and modified McMaster methods and classified into 3 categories of 0 eggs per gram of feces (EpG), 1-100 EpG, and > 100 EpG, respectively."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "PM compared with RAO-affected F had a 16.7 (95% confidence interval [CI]: 2.0-136.3) times higher risk for shedding > 100 EpG compared with 0 EpG and a 5.3 (95% CI: 1.0-27.4) times higher risk for shedding > 100 EpG compared with 0 EpG. There was no significant effect when RAO-unaffected F were compared with their PM. RAO-unaffected compared with RAO-affected offspring had a 5.8 (95% CI: 0.0-1.0) times higher risk for shedding 1-100 EpG. Age, sex, breed, and sharing pastures with other species had no significant confounding effects."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION AND CLINICAL IMPORTANCE",
          "content": "RAO is associated with resistance against strongylid parasites in a high-prevalence family."
        }
      ]},
