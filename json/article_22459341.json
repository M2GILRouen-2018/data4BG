      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To determine the efficacy of two different doses (150 mg and 300 mg) of preoperative pregabalin on pain relief and total opioid consumption after laparoscopic cholecystectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, randomized, placebo-controlled, double-blinded study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Training and research hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "90 adult, ASA physical status 1 and 2 patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients were randomly assigned to three groups to receive orally one hour before surgery, a placebo (Group 1), pregabalin 150 mg (Group 2), or pregabalin 300 mg (Group 3). Patients were observed for pregabalin side effects, somnolence via Ramsay Sedation Scale, dizziness, confusion, and ataxia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "In the operating room, heart rate and noninvasive systolic and diastolic blood pressures were measured. Visual analog scale (VAS), Ramsay Sedation Scale, and Aldrete scores were also recorded on arrival at the Postanesthesia Care Unit (time 0), 15, 30, 60, 120 minutes and 3, 4, 6, 8, 10, 12 and 24 hours after surgery. Additional doses of drugs (fentanyl and/or metoclopramide) were also recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Preemptive pregabalin decreased pain scores and postoperative fentanyl consumption in patients after laparoscopic cholecystectomy in a dose-dependent manner. There were no differences between the groups in side effects."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Preoperative pregabalin may be a useful analgesic for patients after laparoscopic cholecystectomy, as it lowers pain intensity and opiod consumption, and does not increase the frequency of side effects."
          }
        ]
      },
