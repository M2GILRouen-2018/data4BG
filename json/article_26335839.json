      "Abstract": {
        "CopyrightInformation": "© 2015 ARS-AAOA, LLC.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The impact of poor adherence and medication administration is well documented, as are the difficulties with asthma inhaler and device usage. However, difficulties with these devices and inhalers continue to present significant challenges to many healthcare providers and patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A systematic review of the published, peer-reviewed international literature was performed to identify likely teaching needs as well as available and recommended resources to address same."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Asthma inhaler and device use and educational needs vary as widely as do the types and severity of usage errors committed. Multiple interventions have been studied and found to be effective at improving both patient technique and overall asthma outcomes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Providers must ensure that patient teaching is performed by suitably prepared staff members. Education should be device-specific, patient-centered, and repeated at frequent intervals. Providers must frequently reassess patient understanding and ability with regard to asthma inhalers and devices in order to maximize therapeutic outcomes."
          }
        ]
      },
