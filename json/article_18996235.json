      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Test effects of pushrim-activated power-assisted wheelchairs (PAPAWs) on the energetics and perceptual responses to steady-state and intensity-graded wheelchair propulsion in persons with paraplegia and tetraplegia having chronic shoulder pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Test, retest with a control condition."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Academic medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Subjects (N=18) aged 19 to 70 years with chronic, motor-complete paraplegia and tetraplegia having confirmed shoulder pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Study participants underwent testing on 4 randomized nonconsecutive days during either 6 minutes of steady-state or 12 minutes of intensity-graded wheelchair propulsion on stationary rollers. Participants used their own manual wheelchair and either their customary wheels or power-assist wheels attached with an axle bracket."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Oxygen consumption (V(.)O2, L/min), distance (m), energy cost (L/m), and ratings of perceived exertion (RPE; Borg Categorical 6-20 Scale) were measured during propulsion."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Significant main effects of testing were observed for V(.)O2, heart rate, and RPE in both subject groups. Distances propelled were significantly increased in both groups across both tests and in each of their 2-minute exercise stages."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Use of PAPAWs by persons with paraplegia and tetraplegia having shoulder pain significantly lowers energy cost responses and perceived exertion compared with manual wheelchair propulsion while significantly increasing the distanced propelled."
        }
      ]},
