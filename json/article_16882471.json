      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Menstrual irregularity is a common major complaint in women of reproductive age. It is also a known marker for underlying insulin resistance. We investigated the association between menstrual irregularity and metabolic syndrome in the general population of middle-aged women in Korea."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This cross-sectional study used data from the Korea National Health and Nutrition Examination Survey 2010-2012. A total of 2,742 subjects were included in the analysis. Participants were divided into two categories based on their menstrual cycle regularity and the relationship between metabolic syndrome and its variables was investigated by multiple logistic regression analysis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Adjusted analyses revealed significantly higher odds ratios for metabolic syndrome, high waist circumference, high triglyceride levels, and low high density lipoprotein cholesterol levels with the presence of menstrual irregularity."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Metabolic syndrome and its components (high waist circumference, high triglyceride levels, and low high density lipoprotein cholesterol levels) were significantly associated with menstrual irregularity in women of reproductive age."
        }
      ]},
