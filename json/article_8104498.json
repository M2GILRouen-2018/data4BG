      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess pulmonary function, pain, and fatigue after elective laparoscopic cholecystectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "The first 53 patients listed to undergo laparoscopic cholecystectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Assessments of pain, peak flow, and the subjective feeling of fatigue before, and 6 hours after, operation, and then daily for the first week."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pain scores at rest and while coughing and fatigue score were less than have been reported after open cholecystectomy. Peak flow was reduced 6 hours after operation (p < 0.01) but less than has been reported after open surgery, and it returned to the preoperative value within the study period."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The less disturbance of pulmonary function and the lower pain and fatigue scores may explain the observed early discharge from hospital and the rapid mobilisation, including ability to go to work, in patients who have undergone laparoscopic cholecystectomy."
        }
      ]},
