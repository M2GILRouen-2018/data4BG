      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of this case report was to describe the chiropractic management of a patient with neck-tongue syndrome (NTS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CLINICAL FEATURES",
          "content": "A 34-year-old female patient sought treatment at a chiropractic clinic for symptoms involving neck pain associated with left-sided paresthesia of the tongue that had persisted for >2 years. A diagnosis of NTS was made."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "INTERVENTION AND OUTCOME",
          "content": "The patient was treated with spinal manipulation, myofascial release, and home exercises. After 2 weeks, she was symptom free. At the 2-year follow-up, the patient remained free of symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This patient with NTS responded favorably to a course of chiropractic care."
        }
      ]},
