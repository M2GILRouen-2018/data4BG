      "Abstract": {
        "CopyrightInformation": "© 2016 World Obesity Federation.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "There has been a growing amount of evidence indicating that excess visceral fat is associated with alterations in brain structure and function, including brain cortical thinning in adults."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "This study aims to investigate the relationship between brain cortical thickness with obesity assessments, in adolescents."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In this study, we measured three different obesity assessments within an adolescent population (aged 15\u2009-\u200918\u2009years): body mass index (BMI), visceral fat ratio measured with an MRI and hepatorenal gradient measured with an ultrasound. Volunteers also underwent an MRI scan to measure brain structure."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Results indicated that there was no relationship of BMI or hepatorenal gradient with brain cortical dimensions. However, there was a significant association between visceral fat ratio and an increase of cortical thickness throughout the brain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These results suggest that visceral fat, but not BMI, is correlated with cortical thickening in adolescence."
          }
        ]
      },
