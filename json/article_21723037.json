      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "CLINICAL QUESTION",
          "content": "In adults with chronic pain, do yoga and other meditative movement therapies to improvement in chronic pain symptoms?"
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "ANSWER",
          "content": "Yes. However, in each of the studies reviewed, yoga classes were included as part of the pain management regime, sometimes alone and sometimes in tandem with DVDs or audiotapes. We feel that no exercise therapy program should be undertaken without professional coaching from certified, registered and qualified instructors."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "DATE ANSWER WAS DETERMINED",
          "content": "August 2014, June, 2015, August 2015."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "LEVEL OF EVIDENCE FOR THE ANSWER",
          "content": "A."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "SEARCH TERMS",
          "content": "chronic pain, yoga, exercise therapy, meditative movement therapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INCLUSION CRITERIA",
          "content": "Adults; meta-analyses; systematic reviews; cohort studies; randomized controlled trials; practice guidelines; articles from 2010 to present."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "EXCLUSION CRITERIA",
          "content": "Children younger than 18 years of age, Pilates."
        }
      ]},
