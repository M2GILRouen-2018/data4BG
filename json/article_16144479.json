      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The present research studies the effects of AsGaAl (low-intensity laser) on the bite strength of the masseter muscle in order to evaluate the contribution of laser therapy in patients with orofacial pain."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND DATA",
          "content": "Studies on laser therapy suggest its usefulness in the treatment of temporomandibular disorders. This paper presents the effects of low-intensity laser in the contraction of the masseter muscle in patients with neuromuscular discomfort."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Fifteen patients of both genders, ages 19-29, suffering from pain in the masseter muscle, were exposed to laser application (AsGaAl) applied from a 2-mm distance."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All patients showed improvement in muscle contraction strength of about 2.51-3.01 kgf on the right and left masseter muscle."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These results suggest that low-level laser application is an effective tool for the treatment of patients with orofacial pain."
        }
      ]},
