      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES/HYPOTHESIS",
          "content": "To determine if placement of autologous platelet-rich plasma (PRP) on the tonsil beds at the time of tonsillectomy would decrease postoperative pain and complications."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Double blind, randomized, prospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Seventy children were recruited to participate in the study, ranging in age from 4 to 15 years. They were randomized to treatment (PRP) or control groups. The parents, patients, and nurses were blinded as to which group they were in. Postoperative pain scores were obtained using the FACES pain scale and recorded in a home diary."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Seventy patients were recruited to the study, and 12 did not submit their diaries and were considered to drop out of the study. Demographic data were similar for both control and treatment groups. Median pain scores, medication use, days to normal diet, and office visits did not differ between the two groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "PRP applied once at the time of tonsillectomy does not improve postoperative pain or recovery in pediatric patients."
        }
      ]},
