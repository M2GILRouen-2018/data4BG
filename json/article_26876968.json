      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 North American Society for Pediatric and Adolescent Gynecology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Imperforate hymen prevents menstrual blood drainage, which causes cyclic lower abdominal pain and amenorrhea. Untreated patients might develop serious complications such as endometriosis and infertility. Hymenectomy represents the adequate treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE",
            "content": "In a 16-year-old female virgin presented with recurrent lower abdominal pain, urine retention, and secondary amenorrhea after 3 hymenectomy surgeries. The examination revealed imperforate hymen. A fourth hymenectomy was performed with continuous locked sutures over all of the edges."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "SUMMARY AND CONCLUSION",
            "content": "Recurrent imperforate hymen after hymenectomy should be suspected if symptoms recur. Diagnosis can be achieved through meticulous clinical examination and appropriate imaging techniques."
          }
        ]
      },
