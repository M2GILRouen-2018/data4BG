      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "systemically evaluate the association between +276G/T single nucleotide polymorphisms of adiponectin gene and coronary atherosclerotic heart disease in Chinese population."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "8 case-control studies about +276G/T polymorphism that were based on our inclusion criterion and available in the literature were reviewed. Meta analysis was carried out by Review Manager 4.2 software."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Results from Metaanalysis demonstrated no significant heterogeneity among the studies about +276G/T polymorphisms and showed significant association between the +276G/T polymorphism and coronary disease in the Chinese population, and the fixed effects OR of the allele +276G to susceptibility of the disease was (OR = 1.93, 95% CI 1.32-2.82, P = 0.0007)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The current paper on Meta-analysis demonstrated a correlation between the +276G/T single nucleotide polymorphism and the cononary disease in Chinese population."
        }
      ]},
