      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare whether an individual could appreciate the pain relief, if any, in either one of his/her tonsillar fossa topically suffused with a local anaesthetic (bupivacaine)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PLACE AND DURATION OF STUDY",
          "content": "Department of ENT/Head and Neck Surgery, Combined Military Hospital, Peshawar, from January to June 2007."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODOLOGY",
          "content": "Forty-six patients of either gender, aged 10-42 years undergoing tonsillectomy for recurrent tonsillitis were enrolled for this study. At the end of surgery, having secured haemostasis, one tonsillar fossa was randomly packed with a gauze piece soaked in 3 ml of 0.5% bupivacaine for 5 minutes, while the other was not. Effects of postoperative analgesia were assessed using visual analogue scale (VAS) up to 8 hours."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Majority of the patients (85%, n=39) failed to experience an appreciable pain relief on the side of local anaesthetic (bupivacaine) application (p=0.006)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Topical application of local anaesthetic (bupivacaine) confers no appreciable pain control in post-tonsillectomy patients."
        }
      ]},
