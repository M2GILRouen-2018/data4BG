      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Owing to difficulties faced by individuals with severe and persistent mental illness (SPMI) in accessing multiple services, the Australian Government trialed a care coordinated service model called the Partners in Recovery (PIR) initiative."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL",
          "content": "A total of 45 stakeholders in Gippsland were asked what difference the initiative had made."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "The PIR initiative benefited not only clients and carers but also service providers. It addressed an unmet need in service delivery for individuals with SPMI."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The PIR initiative has filled a gap in delivery of care for individuals with SPMI in Gippsland."
        }
      ]},
