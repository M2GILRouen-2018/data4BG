      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To see if modifications to the processing of intravenous immunoglobulin to include a virus inactivation stage alter immunoglobulin G (IgG) resulting in hypotension in patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Clinical trials were done involving extensive patient monitoring during infusion: in vitro - testing for markers of hypotension, and in vivo - an animal model which closely simulates clinical use."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No hypotensive response was seen in the animal model or clinical trial."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The production process used does not damage IgG or create vaso-active kinins as the preparation was free of hypotensive effects."
        }
      ]},
