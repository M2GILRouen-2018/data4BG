      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report a new surgical technique for excising pediatric corneal limbal dermoid and the post-resection ocular surface reconstruction."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We describe a method of deep lamellar excision followed by sutureless multilayered amniotic membrane transplantation in surgical management of corneal limbal dermoid."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "This technique achieves a rapid corneal re-epithelization, reduces post-operative pain, and will diminish post-operative scarring. Preoperative corneal astigmatism will persist."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This method offers an alternative surgical approach in comparison to simple excision in removal of simple pediatric corneal limbal dermoids."
        }
      ]},
