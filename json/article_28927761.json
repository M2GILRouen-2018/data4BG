        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To discuss the evolution and effectiveness of the comprehensive geriatric assessment (CGA), the need for interprofessional collaboration, and the role of oncology nurses in the assessment and care coordination of the older patient with cancer."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "Historical and recent publications."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Oncology nurses collect and synthesize geriatric data and can be a central resource to the multidisciplinary team."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR NURSING PRACTICE",
            "content": "Oncology nurses can incorporate CGA and results into their practice to enhance the care of the older person."
          }
        ]
