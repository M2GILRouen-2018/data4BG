      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "to compare the general and specific health-related quality of life (HRQoL) between the Intervention (IG) and Control (CG) groups of coronary artery disease patients after the implementation of Action Planning and Coping Planning strategies for medication adherence and to verify the relationship between adherence and HRQoL."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "this was a controlled and randomized study."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "the sample (n=115) was randomized into two groups, IG (n=59) and CG (n=56). Measures of medication adherence and general and specific HRQoL were obtained in the baseline and after two months of monitoring."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "the findings showed that the combination of intervention strategies - Action Planning and Coping Planning for medication adherence did not affect the HRQoL of coronary artery disease patients in outpatient monitoring."
        }
      ]},
