      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The main purpose was to study associations between different risk factors for coronary heart disease in order to find out whether such associations already exist during the fourth decade of life."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A study carried out by the primary healthcare staff in the community of Habo in Skaraborg County in south-western Sweden."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "All men living in Habo aged 33-42 years who were willing to participate in the study--in total 652 men (participation rate 86%)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Risk factors for coronary heart disease considered as markers of lifestyle: body-mass index as a measure of general obesity, waist-to-hip circumference ratio as a measure of central obesity, arterial blood pressure, serum cholesterol concentration and serum triglyceride concentration."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were statistically significant correlations between all the factors analysed including anthropometric data, blood pressure and serum lipids."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The results indicate associations between different risk factors at an early age and emphasises the need for a multifactorial view on risk as early as at the ages which were the focus of this study."
        }
      ]},
