      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This report describes a case of a malignant cylindroma arising in the external auditory canal."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Retrospective surgical case review."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary care teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Wide local excision with margin control."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Local control of disease at 2-year follow-up."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "To our knowledge, this is the first report describing a malignant degeneration of cylindroma in the external auditory canal. This tumor represents an extremely rare cutaneous neoplasm, thus raising diagnostic and therapeutic challenges."
        }
      ]},
