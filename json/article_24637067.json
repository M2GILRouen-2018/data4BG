      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Longer operation times, poorer patient outcomes and increased early post-operative complications are reasons cited for not undertaking total knee arthroplasty (TKA) on morbidly obese patients. This study tests the hypothesis that there is no difference in intra-operative parameters between morbidly obese and non-obese patients, and no difference in patient outcome."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Intra-operative parameters, post-operative complications, patient outcomes and knee range of motion were compared between morbidly obese patients (BMI>40 kg/m2) and individually age and gender matched non-obese patients (BMI<30 kg/m2) undergoing cementless rotating platform TKA."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Anaesthetic times and length of hospital stay were not significantly different between the morbidly obese and non-obese patients. Surgical time was significantly greater in morbidly obese patients. Improvements in patient outcomes following TKA were not significantly different between the morbidly obese and non-obese patients at early and short-term follow-up."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In contrast to previous studies, post-operative complication rates within three months of surgery and up to one year post-operatively were not significantly higher for morbidly obese patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "III."
          }
        ]
      },
