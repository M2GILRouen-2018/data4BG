        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "A case presented with chronic pelvic pain since a Fothergills repair 9 years back. Over the years she had received multiple courses of antibiotics and anti-inflammatory drugs to no avail."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Thorough evaluation revealed the presence of a foreign body in the form of a surgical needle in the cervix."
        }
