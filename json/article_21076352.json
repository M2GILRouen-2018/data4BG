      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To determine if simple, robust spectacle mounted devices are feasible for the replacement of the mirror boxes currently used in the rehabilitation of patients suffering from phantom limb pain, complex regional pain syndrome and stroke."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Four devices, using three different optical systems were produced: plane mirror, astronomical telescope using cylindrical lenses and two reflecting prism systems."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "The illusory effect of the devices was similar to that of the mirror box."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Any of the systems would be suitable to replace the mirror box, but the reflecting prism system is the easiest to set up."
        }
      ]},
