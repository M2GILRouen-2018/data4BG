      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The effects of actiponin was investigated, a heat-processed Gynostemma pentaphyllum extract, on body weight, fat loss, and metabolic markers of Korean participants in a 12-week, randomized, double-blind, placebo-controlled clinical trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "Obese participants (BMI\u2009≥\u200925 kg m(-2) and WHR\u2009≥\u20090.90 for male or WHR\u2009≥\u20090.85 for female) who had not been diagnosed with any disease and met the inclusion criteria were recruited for this study. The 80 subjects were randomly divided into actiponin (n\u2009=\u200940, 450 mg day(-1) ) and placebo (n\u2009=\u200940) groups. Outcomes included measurement of efficacy (abdominal fat distribution, anthropometric parameters, and blood lipid profiles) and safety (adverse events, laboratory test results, electrocardiogram data, and vital signs)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "During 12-week of actiponin supplementation, total abdominal fat area, body weight, body fat mass, percent body fat, and BMI were significantly decreased (P\u2009=\u20090.044, P\u2009<\u20090.05, P\u2009<\u20090.0001, P\u2009<\u20090.0001, and P\u2009<\u20090.05, respectively) in the actiponin group compared to the placebo group. No clinically significant changes in any safety parameter were observed."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Our study revealed that actiponin is a potent antiobesity reagent that does not produce any significant adverse effects. These results suggest that actiponin supplementation may be effective for treating obese individuals."
          }
        ]
      },
