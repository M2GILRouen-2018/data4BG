      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To determine differences in fat-signal fraction (FF) from chemical-shift-encoded water-fat MRI of interscapular BAT in mice housed at different ambient temperatures (Ta )."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "C57BL/6J male mice (8 weeks old) were singly housed at 16°C, 23°C, or 30°C (n\u2009=\u200916/group) for 4 weeks. Measures included food intake, body weight (both measured weekly) and body composition (at baseline, 2, and 4 weeks post-thermal exposure); chemical-shift-encoded water-fat MRI was performed on a 9.4 Tesla Bruker magnet with respiratory gating and anesthesia at 4 weeks post-thermal exposure."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A significant inverse relationship between food intake and Ta was evidenced (P\u2009<\u20090.0001). Lean mass was similar among groups, while total fat mass was significantly different among groups ([mean\u2009±\u2009SE]: 30°C\u2009=\u20095.10\u2009±\u20090.19 g; 23°C\u2009=\u20094.18\u2009±\u20090.16 g; 16°C\u2009=\u20093.48\u2009±\u20090.54 g; P\u2009<\u20090.0001). Mean BAT-FF was positively related to Ta (means: 30°C\u2009=\u200979.4%; 23°C\u2009=\u200961.8%; 16°C\u2009=\u200950.9%; P\u2009<\u20090.0001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These cross-sectional results demonstrate that MRI measurement of FF within the interscapular BAT in mice reflects recent functional status of the tissue, with a lower Ta leading to a significantly reduced BAT-FF, indicative of the tissue's involvement in thermogenesis."
          }
        ]
      },
