      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Both kyphoplasty (KP) and vertebroplasty (VP) are effective for patients with osteoporotic vertebral compression fracture (OVCF), but which approach might be more effective remains unclear, so we decided to update earlier systematic reviews."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Review and analyze studies published as of August 2015 that compared clinical outcomes and complications of KP versus VP."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Systematic review and meta-analysis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SEARCH METHOD",
          "content": "Published reports up to August 2015 were found in PubMed, EMBASE and the Cochrane Central Register of Controlled Trials (CENTRAL)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SELECTION CRITERIA",
          "content": "Randomized controlled trials (RCTs) and prospective and retrospective cohort stud.ies comparing KP and VP in patients with OVCF."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA COLLECTION AND ANALYSIS",
          "content": "Two authors independently assessed the studies and extracted data."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Thirty-two studies involving 3274 patients fulfilled the inclusion criteria. There were significant differences between the two groups in short- and long-term postoperative changes in measures of pain intensity and dysfunction (P < .01), in anterior and middle height (P < .01), kyphotic angle (P < .01), and time to injury, but not in posterior height (P=.178). There were no significant differences in the rate of postoperative fractures including adjacent and total fractures, but cement leakage to the intraspinal space was greater in the VP group (P=.035). KP surgery took longer and required a greater volume of injected cement."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "KR resulted in better pain relief, improvements in Oswestry dysfunction and radiographic outcomes with less cement leakage, but further RCTs are needed to verify this conclusion."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "LIMITATIONS",
          "content": "Only four RCTs with a certain of risk of bias. Most studies were observational."
        }
      ]},
