      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To test the convergent validity of the Manchester pain scale when compared to the current 'gold standard' in children's pain assessment, the Oucher pain scale."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "One hundred and fifty two children presenting to the emergency department had pain scale assessments using both the Manchester and Oucher pain scales. The order of presentation of the scales was randomised. The degree of convergence between the scales was assessed using Spearman's rank correlation as well as Bland and Altman plots."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "One hundred and thirteen children used numerical scales; the correlation coefficient for these was 0.802. Thirty nine children used pictorial scales; the correlation coefficient was 0.820."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "There is strong convergent validity between the scales as demonstrated by a high degree of correlation between the numerical and pictorial scores generated by the Manchester and Oucher pain scales. The Manchester pain scale can be used to assess pain in children presenting to emergency departments."
        }
      ]},
