      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effects of cyst ablation with absolute ethanol in autosomal-dominant polycystic kidney disease (ADPKD) patients with symptomatic cysts."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Using absolute ethanol, cyst ablation was performed in 11 patients with documented ADPKD who suffered cyst pain refractory to medical treatment. An ethanol solution was instilled into the largest symptomatic cysts through a catheter. We assessed the therapeutic efficacy of the procedure by tracking subjective pain relief during a 3 to 24-month follow-up period after ablation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At follow-up, we found that the duration of subjective pain relief was 12 to 24 months in seven patients, 4 to 11 months in one, and less than 3 months in three."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Selective ablation of a symptomatic cyst may be a valid option in managing chronic pain caused by one or a few large cysts in ADPKD patients."
        }
      ]},
