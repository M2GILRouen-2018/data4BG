      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A recent randomized control trial in children with steroid-resistant nephrotic syndrome revealed that two doses of rituximab did not reduce proteinuria."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "CASE CHARACTERISTICS",
          "content": "A 14-month-old boy developed refractory steroid-resistant nephrotic syndrome due to focal segmental glomerulosclerosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OBSERVATION",
          "content": "The patient achieved complete remission 11 months after disease onset following eight doses of rituximab combined with steroids and cyclosporine."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "MESSAGE",
          "content": "Long-lasting B cell depletion with repeated rituximab administrations may be required to achieve complete remission in patients with steroid-resistant nephrotic syndrome and massive proteinuria."
        }
      ]},
