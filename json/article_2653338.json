      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the short-term outcomes of two different-sized needles for genetic amniocentesis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "A total of 271 amniocentesis were retrospectively evaluated in 2 groups concerning the size of the needles used during the procedure: Conventional 20-gauge (G) (n=164) and 22G (n=107). Periprocedural complications and cost-effectiveness were compared across the groups."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no differences between groups concerning complications within 15 days after the procedure (fetal loss, 0.6% versus 0.9%, and amniotic fluid leak 1.2% versus 1.8%, p=0.99 for each). The 22G needle was significantly more cost efficient (p<0.0001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The 22 G spinal needle is convenient for second trimester amniocentesis with similar complication rate and has a favorable cost profile."
        }
      ]},
