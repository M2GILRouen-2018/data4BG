      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To examine the association between worksite social support and changes in diet, physical activity, and body mass index (BMI)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cohort analysis of an underlying randomized, controlled weight gain prevention worksite trial: Promoting Activity and Changes in Eating."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The trial occurred in the greater Seattle area."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Baseline and follow-up data were obtained on a nested cohort of employees (n = 958-1078) from 33 small- to medium-sized worksites."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASURES",
          "content": "Worksite social support, diet, physical activity, and BMI measures were assessed using a self-reported questionnaire."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANALYSIS",
          "content": "To adjust for multilevel data and multiple time points, we used generalized estimating equations and logistic mixed models."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Higher baseline worksite social support was associated with greater changes in fruit and vegetable intake (p = .001; summary food-frequency questions)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This study does not support a conclusive relationship between worksite social support and health behavior change."
        }
      ]},
