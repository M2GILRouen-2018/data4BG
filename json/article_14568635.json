      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The objective of this study was to assess screening practices for detecting major depression in workers complaining of somatic symptoms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 1443 Japanese white-collar workers (991 men and 452 women, mean age 34 years) completed a medical symptom checklist (major 12 somatic symptoms) and were diagnosed using the structured clinical interviews of the Diagnostic and Statistical Manual of Mental Disorders, Fourth Edition (DSM-IV)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were 42 cases (2.9%) with major depression in the total sample. Of the 902 subjects without somatic symptoms, only one (0.1%) was identified as having major depression. The prevalence of the disorder was positively associated (P<.001) with the total number of somatic symptoms, and the area under the receiver operator characteristic curve was 0.92 for men and 0.81 for women, which showed the sensitivity and specificity of the total number of somatic symptoms for detecting major depression."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The number of reported somatic symptoms is a simple and useful predictor of major depression."
        }
      ]},
