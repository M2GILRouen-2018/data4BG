      "Abstract": {
        "CopyrightInformation": "Copyright © 2014. Published by Elsevier Ireland Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUNDS",
            "content": "In-stent restenosis (ISR) remains an important issue even in the current drug-eluting stent (DES) era. We performed a meta-analysis to assess the clinical efficacy and safety of drug-eluting balloon (DEB) as compared with DES for the treatment of ISR."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The published literature was scanned by formal searches of electronic databases from January 2005 to February 2014. All randomized controlled trials were eligible for inclusion if they compared DEB with DES in patients with ISR."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Prespecified criteria were met by 4 trials involving 803 patients. There was no significant difference in the primary endpoint (12-month major adverse cardiac events) between the 2 groups (risk ratio [RR] 1.04, P=0.80). The incidence of death (RR 0.81, P=0.62), myocardial infarction (RR 0.66, P=0.29), and target lesion revascularization (RR 1.35, P=0.12) in the DEB group was also similar to those in the DES group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This meta-analysis showed that DEB was associated with comparable clinical outcomes to DES for the treatment of ISR. DEB might be the preferred interventional strategy for patients with ISR by obviating the need of additional stent layer."
          }
        ]
      },
