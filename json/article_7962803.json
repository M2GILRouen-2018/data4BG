      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Percutaneous injection of ethanol was evaluated in terminally ill cancer patients with painful osteolytic bone metastases treated previously without success by radiation or chemotherapy and conventional pain therapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS AND MATERIALS",
          "content": "Twenty-five patients with 27 bone metastases in various locations underwent one to three instillations of 3-25 ml ethanol (95%) under CT guidance, which allowed precise needle positioning and control of the diffusion of alcohol thus minimizing the complications."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Within 24 to 48 h 74% of the cases experienced a reduction of analgesic needs."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Percutaneous ethanol injection under CT guidance is useful in reducing pain and in improving the quality of life of patients with advanced stages of cancer and painful bone metastases."
        }
      ]},
