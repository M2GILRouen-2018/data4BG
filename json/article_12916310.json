      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To provide a better treatment method of lumbar stenosis and root pain resulting from simple hypertrophy of ligamentum flavum."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "By studying the records of 143 lumbar pain cases, we found 5 cases caused by simple hypertrophy of ligamentum flavum. All the patients were old man with a long progressed history. There was little difference of clinical features between the disc herniation and hypertrophy of ligamentum flavum. All cases accepted resection of ligamentum flavum."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All the symptoms were relieved postoperatively. The patients could walk."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The degeneration of lumbar ligamentum flavum can cause lumbar stenosis and root pain. Resection of ligamentum flavum can relieve the symptom."
        }
      ]},
