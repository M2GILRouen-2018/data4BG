      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In a prospective study, the efficacy of manual therapy and dry needling was examined in 84 patients with chronic low back pain (mean duration of pain 4.4 years)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The initial value of pain on the visual analogue scale was about 6.6, the follow up value was reduced to 3.67 (p=0.0033)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Manual trigger point therapy of myofascial trigger points in the low back is effective."
        }
      ]},
