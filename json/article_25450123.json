      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the reduction in phantom pain and sensation with combined training of progressive muscle relaxation, mental imagery, and phantom exercises."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized controlled prospective trial with 2 parallel groups."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Amputee unit of a rehabilitation hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Subjects with unilateral lower limb amputation (N=51) with phantom limb pain (PLP) and/or phantom limb sensation (PLS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "The experimental group performed combined training of progressive muscle relaxation, mental imagery, and phantom exercises 2 times/wk for 4 weeks, whereas the control group had the same amount of physical therapy dedicated to the residual limb. No pharmacological intervention was initiated during the trial period."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "The Prosthesis Evaluation Questionnaire and the Brief Pain Inventory were used to evaluate changes over time in different aspects (intensity, rate, duration, and bother) of PLS and PLP. Blind evaluations were performed before and after treatment and after 1-month follow-up."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The experimental group showed a significant decrease over time in all the Prosthesis Evaluation Questionnaire domains (in terms of both PLS and PLP; P<.04 for both) and the Brief Pain Inventory (P<.03). No statistically significant changes were observed in the control group. Between-group analyses showed a significant reduction in intensity (average and worst pain) and bother of PLP and rate and bother of PLS at follow-up evaluation, 1 month after the end of the treatment."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Combined training of progressive muscle relaxation, mental imagery, and modified phantom exercises should be taken into account as a valuable technique to reduce phantom limb pain and sensation."
          }
        ]
      },
