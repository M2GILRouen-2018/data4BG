      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Blue rubber bleb nevus syndrome is a rare disease involving venous malformations."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "CASE CHARACTERISTICS",
          "content": "We present a 6-year-old female with the syndrome, and consumptive coagulopathy."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "INTERVENTION/OUTCOME",
          "content": "After management with sirolimus, symptoms resolved."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "MESSAGE",
          "content": "Sirolimus may be a valuable option for reducing bleeding complications and cosmetic sequelae for the patients with this syndrome."
        }
      ]},
