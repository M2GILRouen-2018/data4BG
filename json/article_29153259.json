      "Abstract": {
        "CopyrightInformation": "Copyright © 2017. Published by Elsevier B.V.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Acute mountain sickness (AMS) is caused by a low partial pressure of oxygen and may occur above 2500m. The aim of this research was to evaluate olfactory and gustatory abilities of healthy subjects during baseline conditions and after seven hours of normobaric hypoxia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Sixteen healthy subjects were assessed using the Sniffin' Sticks, as well as intensity and pleasantness ratings. Gustatory function was evaluated utilizing the Taste Strips. Experiments were carried out under baseline conditions (518m altitude) followed by a second testing session after seven hours of normobaric hypoxia exposure (comparable to 4000m altitude)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "During normobaric hypoxia olfactory sensitivity and intensity estimates were significantly reduced."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "We conclude that normobaric hypoxia leads to a significant decrease of olfactory sensitivity and intensity ratings."
          }
        ]
      },
