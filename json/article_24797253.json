      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2014.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The experience of pain associated with surgery has been a challenge for health care professionals for many years, and culture is said to influence pain."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "This study focused on patients' experiences of postoperative pain (POP) and factors that affect POP."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "The study employed qualitative ethnographic principles."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Data were collected through individual face-to-face interviews. Data were saturated after analyzing data from 13 patients from two hospitals in Ghana."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "Themes that emerged were the subjective nature of pain, which described pain dimensions and communication; psycho-sociocultural factors, such as personal inclinations and sociocultural background; and health system factors, such as personnel attitudes and health financing."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "IMPLICATIONS FOR FUTURE RESEARCH AND PRACTICE",
            "content": "Health professionals need to understand the sociocultural effects of pain in order to give effective care."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The study highlighted the need for patient education and the importance that health care professionals understand context-specific factors that influence POP management."
          }
        ]
      },
