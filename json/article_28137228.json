      "Abstract": {
        "CopyrightInformation": "Copyright© Bentham Science Publishers; For any queries, please email at epub@benthamscience.org.",
        "AbstractText": [
          {
            "Label": "BACKGROUND",
            "content": "Despite the substantial progress over the time, malaria remains a major public health concern and causing hundreds of thousands of deaths. Resistance to the available antimalarial therapy increases threat to the global public health."
          },
          {
            "Label": "OBJECTIVE",
            "content": "Overview of currently available antimalarials."
          },
          {
            "Label": "METHOD",
            "content": "Literary survey."
          },
          {
            "Label": "RESULTS",
            "content": "The summarized data about different types of antimalarial therapies and their efficiency and modes of action."
          },
          {
            "Label": "CONCLUSION",
            "content": "Despite the seemingly large number of the drugs currently available for malaria treatment, this arsenal is limited due to the narrow variation of their mechanism of action."
          }
        ]
      },
