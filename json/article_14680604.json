      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate relationship between ApoE gene polymorphism and coronary heart disease (CHD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Meta-analysis was applied with a random-effect model for the collected data."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Difference in pooled frequencies, d, of apoE genotypes E3/2, E4/2, E3/3, E4/3 and E4/4 between case and control groups were 2.3%, -0.8%, -8.5%, 10.5% and 0.9%, respectively. Difference in pooled frequencies, d, of apoE alleles epsilon2, epsilon3 and epsilon4 were -1.5%, -4.2% and 5.8%, respectively, with a statistical significance between four groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "apoE gene polymorphism was involved in coronary heart disease. Persons with apoE E3/3 genotype or epsilon3 allele were not susceptible to CHD, but those with apoE E4/4 genotype or epsilon4 allele had higher risk suffering from CHD than others."
        }
      ]},
