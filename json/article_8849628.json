      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine the influence of patient ethnicity on receipt of postoperative analgesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Chart review of 250 consecutive patients hospitalized for open reduction and internal fixation of a limb fracture. Analgesics consumption in the postoperative period was measured in terms of morphine equivalents."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were significant differences (p < .005) in analgesics administered to black, Hispanic, and white patients. Whites received 22 mg/day, blacks 16 mg/day, and Hispanics 13 mg/day. These ethnic differences persisted after controlling for possible confounding variables."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ethnicity exerts a powerful impact on medical care. We cannot determine from our data whether these differences stem from differences in pain behavior of the patients or differences in medical staff's perception and treatment of such patients."
        }
      ]},
