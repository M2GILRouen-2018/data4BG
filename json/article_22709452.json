      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To analyze clinical and laboratory findings in order to find variables predictive of severity of Biliary Peritonitis (BP). Patients and methods. Physical findings, course of illness, imaging and laboratory data were evaluated in 42 patients with BP, and statistically analysed to assess their prognostic significance."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Serious illness and worse outcome were associated with: age ≥ 60 years (P=0.034), long time between onset of symptoms and treatment (P=0.025), fever > 38°C (P=0.009), WBC count > 17,000 cell/mm³ (P=0.043), diffuse abdominal pain (P=0.034), and infected bile (P=0.048)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Most patients become severely ill due to supervening infection, while early bile drainage avoids serious complications. In addition, abdominal pain, fever and WBC count are also predictive of severity of BP."
        }
      ]},
