      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the efficacy of injecting 1% lignocaine into the subserosal aspect of the cornual end of the fallopian tubes to control post-operative pain after laparoscopic Filshie clip application."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A double blind, randomised controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The day surgery unit of the Dunedin Public Hospital, Otago, New Zealand."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Fifty-nine women attending the public hospital requesting sterilisation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "The experimental group received an infiltration of 1% lignocaine into the subserosal aspect of the cornual end of the fallopian tubes. The control group received an infiltration of normal saline in the same site."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The use of post-operative pethidine and the scores obtained on a modification of the McGill present pain intensity score, a visual analogue scale of present pain, a pain relief score and comparisons of time to first analgesia use."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The use of pethidine in the experimental group was significantly reduced [P = 0.001] Pain relief scores indicated significant benefit from the intervention. The time to first analgesic use was significantly greater in the experimental group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Lignocaine infiltration at the cornual end of the fallopian tubes during laparoscopic Filshie clip application is highly effective in producing post-operative pain relief."
        }
      ]},
