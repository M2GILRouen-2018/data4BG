      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "A new midline posterior column pathway related to visceral pain has been recently discovered."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To present its interruption by a punctate midline myelotomy providing significant visceral oncologic pain relief."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Three patients with abdominal cancer refractory pain from opiate analgesics were treated by a punctate midline myelotomy through thoracic laminectomy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Complete pain control was achieved in two patients, one had no more narcotics and the other one had significant lowering of opiate intake doses. The third patient was intolerant to narcotics having 80% relieving pain. There were no postoperative neurological deficits."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The present report reaffirms the existence of a dorsal column midline pathway related to visceral pain in humans, and its interruption ameliorates abdominal pain due to cancer."
        }
      ]},
