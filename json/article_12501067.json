      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of the study was to determine the efficacy of static magnetic field therapy for the treatment of chronic pelvic pain (CPP) by measuring changes in pain relief and disability."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Thirty-two patients with CPP completed 2 weeks and 19 patients completed 4 weeks of randomized double-blind placebo-controlled treatment at a gynecology clinic. Active (500 G) or placebo magnets were applied to abdominal trigger points for 24 hour per day. The McGill Pain Questionnaire, Pain Disability Index, and Clinical Global Impressions Scale were outcome measures."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients receiving active magnets who completed 4 weeks of double-blind treatment had significantly lower Pain Disability Index (P <.05), Clinical Global Impressions-Severity (P <.05), and Clinical Global Impressions-Improvement (P <.01) scores than those receiving placebo magnets, but were more likely to correctly identify their treatment (P <.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "SMF therapy significantly improves disability and may reduce pain when active magnets are worn continuously for 4 weeks in patients with CPP, but blinding efficacy is compromised."
        }
      ]},
