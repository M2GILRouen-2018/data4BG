      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe the clinical efficacy of Tiaozhi Jiangtang Tablet (TZJT) on patients suffering from diabetes mellitus with blood stasis syndrome."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Sixty patients were randomly assigned into 2 groups, the TZJT group (n = 30) treated with TZJT tablet and asprin, the control group (n = 30) treated with asprin alone."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The improvement of symptoms was more significant in the TZJT group than that in the control group (P < 0.05). Levels of serum endothelin (ET), nitric oxide (NO) content and blood viscosity were decreased in both groups after treatment, and the effect of TZJT plus asprin was superior to that of asprin alone."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "TZJT combined with asprin is effective in improving the serum content of ET and NO and reducing blood viscosity."
        }
      ]},
