      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 American College of Cardiology Foundation. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The authors evaluated the 5-year cumulative incidence of cardiovascular events following Resolute zotarolimus-eluting stent (R-ZES) implantation."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Individual trials are often underpowered to show differences for low-frequency adverse events. The R-ZES was studied in 10 prospective clinical trials, designed with identical adverse event definitions, ascertainment, and adjudication."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The RESOLUTE Global Clinical Trial Program includes 7,618 patients treated with R-ZES: RESOLUTE first-in-human study (N = 139), RESOLUTE All Comers (N = 1,140), RESOLUTE International (N = 2,349), RESOLUTE US (N = 1,402), RESOLUTE US 38 mm (N = 114), RESOLUTE Japan (N = 100), RESOLUTE Japan Small Vessel Study (N = 65), RESOLUTE Asia (N = 311), RESOLUTE China Randomized Controlled Trial (N = 198), and RESOLUTE China Registry (N = 1,800). The 5-year cumulative incidence of events was calculated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The 5-year cumulative incidence of cardiac events was 13.4% for target lesion failure and included 5.0% cardiac death, 4.4% target vessel myocardial infarction, and 6.3% clinically driven target lesion revascularization. Dual-antiplatelet therapy at 1, 3, and 5 years was 91%, 37%, and 32%, respectively. The 5-year cumulative incidence of definite or probable stent thrombosis was 1.2%, which comprised 0.7% at 1 year and an annualized rate of 0.1% thereafter. Five-year use of dual-antiplatelet therapy varied geographically from 63% in Japan to 11% in Europe."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In the largest group of R-ZES patients examined to date, the majority of stent-related events, including target vessel myocardial infarction and stent thrombosis, occurred within the first year of implantation with much lower risks of these events out to 5 years."
          }
        ]
      },
