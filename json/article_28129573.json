      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Little research has been completed exploring knowledge development and transfer from and between simulated and clinical practice settings in nurse education."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "This study sought to explore the content learned, and the knowledge transferred, in a hybrid mental health clinical course consisting of simulated and clinical setting experiences."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A qualitative, interpretive descriptive study design."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTINGS",
            "content": "Clinical practice consisted of six 10-hour shifts in a clinical setting combined with six two-hour simulations."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "12 baccalaureate nursing students enrolled in a compressed time frame program at a large, urban, Canadian university participated."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Document analysis and a focus group were used to draw thematic representations of content and knowledge transfer between clinical environments (i.e., simulated and clinical settings) using the constant comparative data analysis technique."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Four major themes arose: (a) professional nursing behaviors; (b) understanding of the mental health nursing role; (c) confidence gained in interview skills; and, (d) unexpected learning."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Nurse educators should further explore the intermingling of simulation and clinical practice in terms of knowledge development and transfer with the goal of preparing students to function within the mental health nursing specialty."
          }
        ]
      },
