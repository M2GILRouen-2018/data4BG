      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Headache is one of the commonest medical complaints. It is usually benign but may be the first presentation of serious disease."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This article reviews the symptoms and signs that suggest the diagnosis of the common headaches and discusses which headache presentations require investigation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "An accurate clinical history is the key to diagnosing the cause of a headache. A new headache of acute onset or progressing over days to weeks or associated with abnormal neurological signs requires investigation."
        }
      ]},
