      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To investigate the associations of high body fat and low muscle mass with arterial stiffness in Asian Indians with type 2 diabetes mellitus (T2DM) in North India."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In this cross sectional study, subjects with T2DM (males n=110, females n=58, mean age: 53.8±10.0years) were recruited. Anthropometry and body composition analysis were performed and measures of glycemia, lipids and PWV were analyzed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Significant positive correlation was observed between PWV and body fat (p<0.05), left leg fat (p<0.05), and right leg fat (p<0.01) percentages only in females. In males, significant negative correlation was observed between PWV and truncal fat free mass (p<0.05) and fat free mass in right arm (p=0.05) and left arm (p<0.05). In both males and females, significant negative correlation was observed between PWV and fat free mass in left leg (p<0.01) and for right leg fat free mass only in females."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Excess adiposity and low fat free mass are associated with arterial stiffening in Asian Indians with T2DM in North India, with significant gender differences."
          }
        ]
      },
