      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Botulinum toxin injections are effective in the treatment of palmar and plantar hyperhidrosis, but discomfort has limited its use."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the use of ethyl chloride medium-stream spray in reducing injection discomfort."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We used ethyl chloride medium-stream spray, in conjunction with precooling by frozen ice packs, in our No Sweat Clinic for our most recent 51 consecutive cases of botulinum toxin injection."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Ethyl chloride spray greatly facilitated the injection procedure, and all patients completed the injections without hesitation or delay."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ethyl chloride medium-stream spray, in conjunction with precooling by frozen ice packs, is highly effective in reducing painful injection sensations. Its use is safe, economical, and easy to learn and does not require special equipment."
        }
      ]},
