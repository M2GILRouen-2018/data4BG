      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine serum levels of insulin, glucose and lipid profile in children of young parents with CAD."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cohort study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary care teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Fifty children in the 5-18 years age group of young parents (< 45 years) with CAD, evaluated for fasting blood glucose, insulin and lipid profile compared with children of normal parents in the same age group."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Serum total and LDL-Cholesterol, blood sugar and B.P., both systolic and diastolic were significantly higher in test group as compared to controls though there was no significant difference observed for weight and body mass index (BMI) between the two groups. The insulin levels were also significantly high in the test cases."
        }
      ]},
