      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "This study aimed to evaluate the association of factors such as pain, lower urinary tract symptoms (LUTS), anxiety, depression and psychiatric morbidity on health-related quality of life (HRQoL) of patients with LUTS."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 227 patients with LUTS were recruited into the study. The patients were assessed on pain, LUTS, anxiety, depression, psychiatric morbidity and health-related quality of life (HRQoL) using standardized questionnaires."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The study showed that after adjustment, age, pain, anxiety, depression, psychiatric morbidity and LUTS contributed 31%, 13%, 45%, 16% and 48% respectively to the variability of the physical, mental, social, global and overall HRQoL."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Age, pain, psychiatric morbidity, anxiety and depression are associated with HRQoL among patients with LUTS."
        }
      ]},
