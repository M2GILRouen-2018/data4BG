      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 The Academy of Psychosomatic Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The presentation of posterior reversible encephalopathy syndrome (PRES) features neuropsychiatric symptoms in the context of predominantly white matter cerebral edema in the setting of a diverse variety of underlying clinical entities."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To illustrate the presentation and diagnostic strategy for this under-recognized condition."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "We present two cases of PRES and review the available literature."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "PRES may be due to a number of underlying conditions, but typically presents with symptoms consistent with delirium."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Psychiatrist practicing in the general hospital should be aware of the presentation and appropriate work-up of PRES to forestall serious potential sequelae."
          }
        ]
      },
