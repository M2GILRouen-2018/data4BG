      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "Buffered lidocaine was compared with plain lidocaine as a local anesthetic for simple lacerations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, double-blind, prospective clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Urban emergency department."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "TYPE OF PARTICIPANTS",
          "content": "Ninety-one adult patients with simple linear lacerations were enrolled. Patients with allergy to lidocaine and patients with an abnormal mental status were excluded."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Each wound edge was anesthetized with either plain or buffered lidocaine using a randomized, double-blind protocol. The pain of infiltration was measured with a previously validated visual analog pain scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Analysis of pooled data and paired data (using patients as their own controls) revealed that infiltrating buffered lidocaine was significantly less painful than plain lidocaine (P = .03 and P = .02, respectively). There was no significant difference in the anesthetic effectiveness of the two agents during suturing."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Buffered lidocaine is preferable to plain lidocaine as a local anesthetic agent for the repair of simple lacerations."
        }
      ]},
