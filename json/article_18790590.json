      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Internal carotid artery dissection typically presents with a clear history of blunt cranial-cervical trauma. Presenting symptoms include headache, focal cerebral ischemic symptoms, and oculosympathetic paresis (Horner syndrome). It is usually thought that internal carotid dissection is a serious but infrequent cause of Horner syndrome."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "A review of the literature reveals that carotid dissection is under-recognized as a cause of Horner syndrome, and outcome is thought to be compromised by diagnostic delay."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "This case report describes a patient who presented to the Emergency Department with a traumatic Horner syndrome caused by internal carotid dissection."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "SUMMARY",
            "content": "The etiology, clinical manifestations, diagnostic evaluation, and treatment options of carotid dissection are discussed."
          }
        ]
      },
