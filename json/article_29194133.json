      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "The aim is to explore nurse residency programs described in the literature and evaluate the evidence supporting their use."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The Institute of medicine and the Joint Commission recommend that organizations provide nurse residency programs for newly licensed nurses."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "An integrative review was conducted of empirical and program development articles published from 2006 to july 2013."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Most articles included in this study had limitations, which are discussed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The literature demonstrates benefits associated with NRPs. More evidence is needed to determine if NRPs contribute to nurse-sensitive patient outcomes, thereby influencing quality of nursing care."
        }
      ]},
