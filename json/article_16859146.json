      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the clinical significance of the number and manifestation of ventricular arrhythmia in ambulatory electrocardiogram."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The ambulatory electrocardiogram of 135 cases with ventricular arrhythmia more than 1,000 times were analysed retrospectively, and the multiple parameters were compared."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Ventricular arrhythmia in patients with coronary heart disease showed more pleomorphism, bigeminy, ventricular tachycardia and R-ON-T phenomena than patients with non-coronary disease."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Expression of bigeminy and tachycardia of ventricular arrhythmia can reflect the cardiac ischemia more accurately than the number of simple ventricular premature beats."
        }
      ]},
