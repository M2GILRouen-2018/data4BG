      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Identifying predictors of weight loss could help to triage people who will benefit most from programs and identify those who require additional support. The present research was designed to address statistical, conceptual and operational difficulties associated with the role of self-efficacy in predicting weight loss."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In Study 1, 115 dieting overweight/obese women at high risk of breast cancer were weighed and completed questionnaires assessing motivation, global self-efficacy and self-efficacy for temptations. The main outcome measure was weight, measured 3-months post-baseline. Study 2 was identical (n=107), except changes in psychological variables were computed, and used to predict weight 6-months post-baseline."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In Study 1, self-efficacy for temptations was a significant predictor of weight loss at 3-month follow-up. In Study 2, improved self-efficacy for temptations between baseline and four-weeks was predictive of lower weight at 6 months."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The key finding was that self-efficacy for temptations, as opposed to motivation and global self-efficacy, was predictive of subsequent weight loss."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "The implication is that augmenting dieters' capability for dealing with temptations might boost the impact of weight loss programs."
          }
        ]
      },
