      "Abstract": {
        "CopyrightInformation": "Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To demonstrate a novel approach to office tubal patency assessment through infusing air into saline during flexible office hysteroscopy. We also provide data addressing pain and patient experience relative to hysterosalpingography (HSG)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Video presentation of clinical technique with supportive crossover data (Canadian Task Force classification II-1). Its University of Mississippi Medical Center Institutional Review Board protocol number is 2013-0230."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Academic hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Women undergoing office hysteroscopy and ultrasound, with a subset also having HSG."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Air infusion into saline during office hysteroscopy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "The focus is on demonstrating how the technique appears and is performed, with supplemental Likert data addressing subjective pain and preference relative to HSG."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "When performed as described, this office technique has 98.3%-100% sensitivity to tubal occlusion and 83.7% specificity. The gentle technique is central to accurate outcomes, which is facilitated through use of a small-caliber (<3 mm), flexible hysteroscope and avoiding uterine overdistention. Patients are far more likely to report maximum discomfort with HSG. Among patients who also had HSG, 92% somewhat or strongly prefer hysteroscopic assessment. Also, 96% of patients reporting maximum discomfort with HSG had mild to no discomfort with the described technique."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Air-infused saline at flexible office hysteroscopy can accurately, gently, and rapidly assess tubal patency. Coupled with strong patient preference for this technique over HSG, it is a promising option for evaluating fertility."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "CLINICAL TRAIL REGISTRATION NUMBER",
            "content": "NCT02005263."
          }
        ]
      },
