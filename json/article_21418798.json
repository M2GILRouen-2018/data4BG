      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the prevalence of coronary artery disease and risk factors in patients with abdominal aortic aneurysm (AAA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Coronary angiography was performed immediately after abdominal angiography in 70 elderly (> 50 years) consecutive patients with AAA. Medical history and imaging characteristics were evaluated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "CAD was diagnosed in 63 patients (90.0%) by coronary angiography: 20 (28.6%) patients with single-vessel disease (SVD), 15(21.4%) with 2VD, 22 (31.4%) with 3VD and 6 (8.6%) with left main disease + 3VD. Multi-variance logistic analysis showed that peripheral disease was the strongest predictor for CAD in AAA patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Coronary angiography should be performed in elderly AAA patients due to the high prevalence of CAD in this patient cohort."
        }
      ]},
