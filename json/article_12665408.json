      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND PURPOSE",
          "content": "Mulligan has proposed the use of mobilization with movement for lateral epicondylalgia. In this study, mobilization with movement for the elbow was examined to determine whether this intervention was capable of inducing physiological effects similar to those reported for some forms of spinal manipulation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Seven women and 17 men (mean age=48.5 years, SD=7.2) with chronic lateral epicondylalgia participated in the study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A placebo, control, repeated-measures study was conducted to evaluate whether mobilization with movement at the elbow produced concurrent hypoalgesia and sympathoexcitation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The treatment demonstrated an initial hypoalgesic effect and concurrent sympathoexcitation. Improvements in pain resulted in increased pain-free grip force and pressure pain thresholds. Sympathoexcitation was indicated by changes in heart rate, blood pressure, and cutaneous sudomotor and vasomotor function."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION AND CONCLUSION",
          "content": "This study showed that a mobilization with movement treatment technique exerted a physiological effect similar to that reported for some spinal manipulations."
        }
      ]},
