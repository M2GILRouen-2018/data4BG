      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case report of low back pain associated with a diagnosis of melorheostosis of the lumbosacral spine."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe a rare presentation of melorheostosis and subsequent successful surgical treatment."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Melorheostosis is a rare condition and spinal pain has not been described in association with the condition."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A patient with disabling low back pain and suspected melorheostosis of the lumbosacral spine responded favorably to diagnostic facet joint blocks. Treatment was lumbosacral fusion and biopsy of the abnormal bone. The densely sclerotic bone presented technical difficulties requiring modification of surgical technique."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Dramatic pain and disability reduction occurred following lumbosacral fusion. Histologic examination was consistent with melorheostosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Melorheostosis rarely causes severe low back pain that can respond favorably to fusion surgery."
        }
      ]},
