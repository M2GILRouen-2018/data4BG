      "Abstract": {
        "CopyrightInformation": "© 2013 Association of Rehabilitation Nurses.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "Sarcopenia and vitamin D deficiency increase risk of disability outcomes associated with a million hip and knee replacements annually. The purpose of the present study was to identify protein and vitamin D inadequacy in arthroplasty patients, and observe the effect of supplementation on metabolic markers on protein and vitamin D status."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "One hundred and eighty obese arthroplasty patients admitted for inpatient rehabilitation, positive for protein and vitamin D insufficiency, received supplemental protein and vitamin D."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "RESULTS AND CONCLUSION",
            "content": "Following supplementation, normalization of protein and vitamin D status was achieved. Nutrient supplementation during physical rehabilitation provided an efficient and effective means to reverse nutrient deficiency in an obese, orthopedic population."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL RELEVANCE",
            "content": "Inpatient physical rehabilitation is an opportune environment for nurses to provide education and intervention of nutrient supplementation, which may lessen consequences of sarcopenic obesity and related frailty disorders."
          }
        ]
      },
