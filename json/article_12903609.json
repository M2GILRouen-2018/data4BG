      "Language": "ita",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate satisfaction rate, efficacy and complication rate of carbon dioxide (CO2) vs normal saline as uterine distension medium for outpatient diagnostic hysteroscopy in patients with suspicious endometrial cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Thirty-eight undergoing outpatient hysteroscopy performed with carbon dioxide (group A) or normal saline (group B). Quality of vision of uterine cavity, procedure time, complications, patient discomfort, satisfaction rate have been evaluated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In group B a significant reduction in abdominal pain, shoulder tip pain and a lower incidence of vasovagal reactions were observed in comparison to group A. In normal saline group we found a higher satisfaction rate and a lower operative time in comparison to the CO2 group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Uterine distension with normal saline seems to have less adverse effects and is better accepted by patients."
        }
      ]},
