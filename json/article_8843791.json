      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 The Authors. Published by Elsevier GmbH.. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE AND METHODS",
            "content": "Metabolic viscera and their vasculature are richly innervated by peripheral sensory neurons. Here, we examined the metabolic and inflammatory profiles of mice with selective ablation of all Nav1.8-expressing primary afferent neurons."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "While mice lacking sensory neurons displayed no differences in body weight, food intake, energy expenditure, or body composition compared to controls on chow diet, ablated mice developed an exaggerated inflammatory response to high-fat feeding characterized by bouts of weight loss, splenomegaly, elevated circulating interleukin-6 and hepatic serum amyloid A expression. This phenotype appeared to be directly mediated by the ingestion of saturated lipids."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These data demonstrate that the Nav1.8-expressing afferent neurons are not essential for energy balance but are required for limiting the acute phase response caused by an obesogenic diet."
          }
        ]
      },
