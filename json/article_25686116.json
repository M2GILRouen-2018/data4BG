      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Lymphadenectomy or lymph node dissection is a topic of controversy in endometrial cancer (EC) treatment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS & METHODS",
          "content": "Associations between lymph node dissections and clinical factors were retrospectively examined in obese, endometrioid endometrial cancer patients with early-stage disease between 1995 and 2005. Overall, EC-specific and recurrence-free survival were also evaluated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Out of 192 patients, 61 (32%) did not have a lymph node examination, 55 (29%) had less than ten lymph nodes removed and 76 (39%) had ≥10 removed. Lymph node dissection count was not significantly associated with overall, EC-specific or recurrence-free survival."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Analysis revealed no significant associations between ≥10 dissected lymph nodes and survival outcomes among obese, EC patients, which supports the need for additional investigation of the merit of lymphadenectomy among these patients."
        }
      ]},
