      "Abstract": {
        "CopyrightInformation": "2006 John Wiley & Sons, Ltd and Eating Disorders Association",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This is the first published report to illustrate the potential for dental treatment to precipitate weight loss leading to anorexia nervosa."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Documentation of history and clinical findings on three adolescents referred to a specialist eating disorder service are presented."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "These cases illustrate that dental treatment may be precipitants of weight loss leading to anorexia nervosa."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "There is a need for increased awareness of this area amongst parents of children and adolescents vulnerable to eating disorders and also their dentists."
          }
        ]
      },
