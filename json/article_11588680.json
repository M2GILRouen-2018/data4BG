      "Abstract": {"AbstractText": [
        {
          "Label": "UNLABELLED",
          "content": "CT-guided thoracal sympathicolysis for the treatment of peripheral arterial occlusive disease and chronic thoracal pain syndromes in 6 patients."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "Retrospective evaluation of the safety and effectivity of CT-guided percutaneous thoracal sympathicolysis (CT-TSL) in the treatment of patients with peripheral arterial occlusive disease (PAOD) of the upper limb and chronic thoracal pain syndromes. Comparison of our own experience with literature reports."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Between 6/96 and 12/99, 4 patients with PAOD of the upper limb and two with chronic thoracal pain syndromes caused by herpes zoster were treated by unilateral CT-TSL."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "18, 21 and 32 months after the intervention 3 out of 4 patients treated for PAOD reported subjective improvements, and one remained unchanged. Two patients treated for pain syndromes showed no long-term benefit of the procedure. There were no serious complications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The CT-TSL is an alternative method in the treatment of PAOD in patients who are unsuitable for treatment by revascularization."
        }
      ]},
