      "Abstract": {
        "CopyrightInformation": "© 2017 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS",
            "content": "To assess the effectiveness of vaginal misoprostol in minimizing the pain perceived by patients with no risk factors for cervical stenosis (i.e., parous women of reproductive age who have no history of cesarean section or cervical surgery) during diagnostic office hysteroscopy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A total of 100 patients with no risk factors for cervical stenosis were randomized to the misoprostol group (n = 50) or the placebo group (n = 50). In the misoprostol group, 2 misoprostol tablets (400 µg) were administered vaginally 12 h before office hysteroscopy. In the placebo group, 2 placebo tablets were administered. The patients rated the intensity of pain perceived during the procedure and at 30 min after the procedure with the use of a 100 mm visual analog scale (VAS). The hysteroscopists also scored the difficulty of hysteroscope insertion into the uterine cavity with the use of a 100 mm VAS."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There were no significant differences between both groups in the VAS pain scores during or at 30 min after the procedure (28.3 ± 13.58 vs. 30.42 ± 15.13 and 11.1 ± 10.23 vs. 13.32 ± 11.12, respectively). The difficulty of hysteroscope insertion into the uterine cavity was comparable between both groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Misoprostol administration prior to diagnostic office hysteroscopy appears to have no beneficial role in the subgroup of patients with no risk factors for cervical stenosis."
          }
        ]
      },
