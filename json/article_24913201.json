      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 International Federation of Gynecology and Obstetrics. Published by Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the effect of chronic pelvic pain (CPP), a debilitating condition, on sleep quality."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The present case-control study enrolled women older than 18 years attending the Gynecology Clinic of Çanakkale Onsekiz Mart University Hospital, Çanakkale, Turkey, with CPP between August 2011 and August 2012. The control group was selected from women attending the clinic for another complaint. Sleep quality was evaluated via the Pittsburgh Sleep Quality Index, and differences between the groups were compared by t and χ(2) tests."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "During the study period, 157 women were enrolled. Seventy-two had CPP symptoms, and 85 attended the clinic for other complaints. Poor sleep quality was found in 80% (n = 58) of the women with CPP, and 55% (n = 47) of the control group (P < 0.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Women with CPP were found to have poor sleep quality. Sleep education should be recommended in psychiatry and neurology clinics to increase the awareness of sleeping problems among these women."
          }
        ]
      },
