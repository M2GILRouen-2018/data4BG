      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Data are being accumulated on the presence of inflammatory response in patients with acute coronary syndromes."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "HYPOTHESIS",
          "content": "The study was undertaken to confirm that the adhesive state of the peripheral blood leukocytes can provide information on an inflammatory process in patients with unstable angina pectoris."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The study included 21 patients with unstable angina, 32 patients with stable angina, and 13 patients with chest pain and no evidence of coronary artery disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The percentage of aggregated leukocytes in patients with unstable angina (5.8 +/- 3.2%) was significantly (p < 0.02) increased compared with that of patients with no evidence of active coronary disease (3.2 +/- 2.6%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Additional evidence for an existing smoldering inflammatory process in unstable angina pectoris can be provided by testing the percentage of aggregated leukocytes in peripheral blood."
        }
      ]},
