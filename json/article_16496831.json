      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The objectives of this randomised controlled study were to determine if pre-admission patient education affects post-operative pain levels, domiciliary self-care capacity and patient recall following a laparoscopic cholecystectomy (LC). Participants were randomised to receive the standard preadmission program (SP) or an individualised, education intervention (El)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A pre-operative questionnaire was administered in the pre-admission clinic to determine participants' knowledge of LC and post-operative management. Telephone follow-up and post-operative questionnaire were conducted approximately 14 days post discharge."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Preadmission clinic of a Sydney, Australia, tertiary referral hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "Ninety-three elective LC patients."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "EI participants experienced lower pain levels and had significantly greater recall of provided information. However, no significant differences were found between the control and intervention groups for domiciliary self-care."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Pre-admission education intervention helps reduce post-operative pain levels following LC and significantly increases patients' knowledge of self-care and complication management."
        }
      ]},
