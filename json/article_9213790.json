      "Language": "dut",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the effects of treatment with and without 'slow-acting antirheumatic drugs' (SAARDs) for patients with recent-onset rheumatoid arthritis (RA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Open randomized clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient clinics of six medical centers, the Netherlands."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "The study population consisted of 304 consecutive patients with recently diagnosed RA. A therapeutic strategy with delayed introduction of a SAARD was compared with a strategy comprising early start of SAARD treatment. Primary endpoints were functional disability, pain, joint score, erythrocyte sedimentation rate and progression of radiological abnormalities at 12 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Four of the five endpoints improved statistically significantly more in the early-SAARD group than in the non-SAARD group; radiological abnormalities progressed at an equal rate in the two groups. Adverse reactions remained at an acceptable level and were the same in the two groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Early introduction of a SAARD was more beneficial than a therapeutic strategy with delayed introduction of a SAARD for patients with recently diagnosed RA."
        }
      ]},
