      "Abstract": {
        "CopyrightInformation": "Copyright 1999 S. Karger AG, Basel",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND/AIM",
            "content": "An angiolipoma is a common benign neoplasm with a characteristic vascular component that occurs in the subcutaneous tissue and rarely in the gastrointestinal tract. We report on a 69-year-old man with a submucosal angiolipoma in the cecum."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This patient was treated with a laparoscopy-assisted ileocecostomy, and a side-to-side anastomosis was performed extracorporeally."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A light microscopic study supported the diagnosis of an angiolipoma of the colon. After 5 years of follow-up, the patient has no symptoms or signs of recurrence."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The colonic angiolipoma was successfully removed using a minimally invasive laparoscopic technique."
          }
        ]
      },
