      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The effect of statin therapy before PCI with direct stenting may reduce the development of flow limited edge dissections (ED) in patients with stable angina."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Flow limited ED after PCI is associated with an increased risk of major adverse cardiovascular events. Statin therapy induces important changes in the plaque composition which have been previously identified as strong predictors of ED."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "100 patients complicated with flow limited ED and 100 control patients with successful procedure were enrolled into the study. EDs were described as the 5-mm regions that were immediately adjacent to the stent borders, both distally and proximally on the coronary angiography."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Rate of statin use and duration of statin use were significantly higher in patients with non-ED group (63%) versus ED group (25%) (p<0.001). In addition, patients in ED group had significantly higher levels of C-reactive protein (CRP) at admission (9.9mg/dL (5.89-16.45) vs. 4.40mg/dL (3.5-7.09), respectively, p=0.014)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our findings suggested that maintenance statin treatment before PCI with direct stenting may reduce the development of flow limited ED in patients with stable angina."
          }
        ]
      },
