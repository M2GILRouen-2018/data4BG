      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Arthroscopy Association of North America. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "This article discusses current evidence in nutraceuticals and viscosupplementation uses in osteoarthritis (OA) treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A search was carried out to identify systematic reviews, randomized controlled trials, review articles, and original articles (PubMed and Cochrane Database) about nutraceuticals and viscosupplementation. The keywords used were nutraceuticals, glucosamine, chondroitin, diacerein, avocado, soybean unsaponifiables, nutraceuticals, and viscosupplementation, independently or combined with the terms \"review\" and \"randomized.\""
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Glucosamine hydrochloride has no effect on pain management, although the sulfate formulation has a moderate effect. Diacerein leads to pain relief, with a superior carryover effect when compared with placebo. Avocado and soybean unsaponifiables may have positive effects on knee and hip OA, but long-term results could not be confirmed. Despite the American Academy of Orthopaedic Surgeons' recommendation against the use of hyaluronic acid in OA, some systematic reviews found some benefits in the knee."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "There is no evidence that nutraceuticals or viscosupplementation influences OA's natural progression. However, some of these agents seem to reduce pain and improve function."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "Level IV, systematic review of studies with Level I through Level IV evidence."
          }
        ]
      },
