      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Hainan Medical College. Published by Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To observe the effect on the inhibition of coronary atherosclerosis hardening of the paraoxonase gene (PON-1) which transfected to the rabbit epicardial adipose tissue."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Rabbit coronary atherosclerosis model was established by high-fat feeding, liposome-encapsulated recombinant plasmid pEGFP-PON-1 50 μ L was injected to the rabbit pericardial cavity, and was harvested 4 weeks after transfection."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The epicardial fat transfected PON-1 gene had effect on the high lipid level. It significantly increased expression of PON-1 in peripheral arterial vascular tissue (P <0.05); and significantly reduced total cholesterol and low-density lipoprotein cholesterol levels (P<0.05), and the thickness ratio of coronary artery intima/media (P <0.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The injection of the PON-1 gene in the pericardial cavity can effectively suppress the formation of coronary atherosclerosis."
          }
        ]
      },
