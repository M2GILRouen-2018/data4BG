      "Abstract": {
        "CopyrightInformation": "© 2015 ARS-AAOA, LLC.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "As part of this primer, this article is intended to introduce new and emerging therapies for treating asthma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A PubMed search was performed for the years 2013 through 2015 for asthma review, asthma treatment, asthma therapy, and asthma new. Subset searches were additionally performed as suggested by information contained in the first round of searches."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There is continuing work toward the identification of additional cellular and molecular mechanisms of asthma. Many of these suggest additional targets for therapy. New pharmaceuticals, biologics, and procedures are reviewed in greater depth."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This is a summary of new and emerging asthma therapies."
          }
        ]
      },
