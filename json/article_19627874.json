      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the effect of intravenous sedation on postprocedural pain relief for patients undergoing a spinal injection procedure in which there is no expectation of immediate relief."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective audit to compare Visual Analog Scale (VAS) responses before and after interlaminar epidural corticosteroid injections without epidural anesthetic in those who did and did not receive intravenous sedation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "This audit was undertaken in 2 interventional spine practices."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "A total of 102 patients were allotted to receive or not receive intravenous sedation depending on preference."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Interlaminar epidural injections of corticosteroid without epidural anesthetic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASUREMENTS",
          "content": "Outcomes were measured by mean (VAS) scores after the procedure and mean VAS differences before and after the procedure."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no significant differences between mean VAS scores or mean differences in VAS scores between those who did or did not receive intravenous sedation. A relatively high percentage of patients in both groups obtained greater than 50% immediate pain relief."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Intravenous mild or moderate conscious sedation did not have an effect on postprocedural VAS pain scores in those receiving a therapeutic spinal injection procedure. Immediate pain relief was most likely the result of nonspecific effects."
        }
      ]},
