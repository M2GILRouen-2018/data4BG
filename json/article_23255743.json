        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This article reviews the role of coronary calcium quantification in symptomatic patients and the pros and cons of acquiring an unenhanced coronary calcium scan in every patient with suspected coronary artery disease referred for coronary CT angiography."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The acquisition of a coronary calcium scan in every symptomatic patient referred for coronary CT angiography requires a case-by-case approach."
        }
