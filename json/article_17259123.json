      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the clinical value of quantitative tissue velocity imaging (QTVI) in detection of regional wall movement abnormalities in patients with coronary artery disease (CAD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The segmental left ventricular wall motion velocity was measured in 45 normal subjects and 48 patients with CAD, and the parameters of QTVI were analyzed between the two groups."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Velocity decrement and wave form alterations were shown in abnormal segmental movements in the CAD group. There were obvious differences in the velocity between normal and abnormal segment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "QTVI is valuable in quantitative and sensitive evaluation of regional wall movement abnormalities for non-invasive diagnosis of CAD."
        }
      ]},
