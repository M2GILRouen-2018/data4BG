      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the curative effect of leukotriene receptor antagonist on cough variant asthma (CVA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Sixty-four CVA patients received treatment with bricany and montelukas and 68 control patients had bricany treatment for 4 weeks. The recurrence rate was observed in the two groups during the follow-up for 6 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The remission time of two groups were 2.5-/+3.6 and 5.3-/+3.8 days in acute phase, respectively, showing a significant difference between them (P<0.05). The recurrence rate of the two groups within 6 months were 20.09% and 40.87%, respectively, showing also significantly differences (P<0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Leukotriene receptor antagonist and bricany can effectively control CVA and significantly lower the short-term recurrence rate of CVA."
        }
      ]},
