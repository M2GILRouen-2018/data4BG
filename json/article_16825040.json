      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND CONTEXT",
          "content": "Substantial variation exists regarding the use of sedation before interventional spine techniques. Patient preference should play an important role in decision making regarding the need for sedation. However, little is known about patients' anxiety levels before spinal injections and their perceptions about the necessity of sedation."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To determine patient perception for need for sedation before epidural steroid injections and zygapophyseal joint injections."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN/SETTING",
          "content": "Survey of consecutive spinal injection patients in an outpatient spine center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT SAMPLE",
          "content": "500 consecutive lumbar, thoracic, and cervical patients receiving spinal injections."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "A 12-item questionnaire assessing patients' perceived anxiety before to a spinal injection."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Subjects were given the questionnaire after their spinal injection. Percentages requesting sedation for a first and potential second procedure were assessed. Additionally, anxiety level and pain rating, location of injection, age, sex, and other medication use were analyzed to determine the effect on the request for sedation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "17% of patients questioned requested sedation before an injection, and 28% would request sedation if they were to have a second injection."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Routine sedation before diagnostic and therapeutic injections is not necessary as the majority of patients would not request sedation before the procedure when given the option. However, in some patients sedation is indicated, and all patients would benefit from educational material on sedation before the injection."
        }
      ]},
