      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Aim of the study is to compare clinical results and patient's satisfaction between direct anterior approach and Hardinge approach in primary total hip arthroplasty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A group of 30 patients operated with DAA (group B) were compared to 39 patients operated by Hardinge approach (group A). Peri- and postoperative complications, Harris Hip Score (HHS), implant positioning, experienced pain and patient satisfaction were evaluated at a mean follow-up of 30 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "HHS at follow-up was significantly better in group B (92.2 ± 11.9 vs 95.2 ± 4.5 p = 0.04 Student's t test). There was no difference in femoral stem positioning while cup inclination was significantly better in group B (40.6° ± 6.6° vs 44.3° ± 7.9°, p = 0.04 Student's t test). Overall pain recalled by patients was significantly lower in group B."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The introduction of DAA does not affect patients' final outcome but comes with comparable functional recovery and greater patient satisfaction."
        }
      ]},
