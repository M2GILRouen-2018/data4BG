      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To detect origin and course and to evaluate viability in patients with anomalous RCA."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "3D coronary MR angiography and viability study using gadolinium-enhanced magnetic resonance imaging (Gd-MRI) was performed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A tertiary hospital center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Four patients, selected from the catheter lab, were studied."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Anomalous RCA from the left sinus of Valsalva was identified in all patients. Inferior myocardial infarction was documented in three patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Magnetic resonance imaging can non-invasively identify anomalous RCA and perform viability study in the same examination."
        }
      ]},
