      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The ability to maintain a lumbopelvic position (LPP) was assessed in athletes with a history of long-standing groin pain (LSGP) and athletes without LSGP."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case-control study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University motion analysis laboratory."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Thirty male athletes-15 with a history of LSGP (>12 weeks) and 15 without."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Maintenance of LPP was assessed using a pressure biofeedback unit (PBU) during supine single leg lift (SLL), single leg extension (SLE) and bent knee fallout (BKFO). Repeatability was assessed using intra-class correlation coefficients (ICC) and group differences analysed using MANOVA."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Differences were detected between involved and uninvolved sides in the LSGP group during SLL (mean difference [md] = 9.82 mmHg, p < 0.01) and BKFO (md = 8.56 mmHg, p < 0.01) but not during SLE (md = 0.38 mmHg, p = 0.96). Between group differences were found during the SLL of the involved leg (md = 5.22 mmHg p = 0.034) and the BKFO of the uninvolved leg (md = 6.22 mmHg p = 0.017). Inter-session reliability varied for the different movement tasks in both groups (ICC = 0.35-0.94)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Ability to maintain LPP differed between the involved and uninvolved legs within the LSGP group and between the athletes with and without LSGP. Despite resolution of groin pain, altered control of lumbopelvic position existed with possible implications for later injury recurrence."
          }
        ]
      },
