      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This clinical review presents proposed theories regarding the etiology of Crohn's disease (CD), the pathophysiology of the disorder, and current diagnostic methods."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Pertinent publications in the literature, the Crohn's and Colitis Foundation web page, and relevant texts regarding pathophysiology of the gastrointestinal system."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "CD can be a devastating disease and difficult to diagnose. The advanced practice nurse (APRN) should be aware of the etiology, pathophysiology, diagnostic methods, and current treatment options of this disorder."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR PRACTICE",
          "content": "In collaboration with a gastroenterologist, APRNs can provide much needed information to the patient with CD. Practice recommendations include patient education, pain management, and support for quality of life issues."
        }
      ]},
