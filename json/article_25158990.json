      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVE",
            "content": "Sacroiliac joint (SIJ) injection can occasionally be challenging. We describe our experience in using conventional technique, and we developed an adjustment to overcome difficulties incurred."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Conventional technique required superimposition of the posterior and anterior SIJ lines. If this technique failed to provide entry into the joint, fluoroscopy was slightly adjusted to obtain an oblique view."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 50 SIJ injections, 29 (58%; 44-72%) were successfully performed using conventional technique. In another 21 procedures, 18 (85.7%; 64-99%) were subsequently completed using oblique view technique. The medial joint line, viewed from this angle, corresponded to the posterior joint line in 17 cases. The lateral joint line corresponded to the posterior joint line in one case."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Oblique view technique can improve the success rate of SIJ injection."
          }
        ]
      },
