      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Although several studies have shown that adolescent musculoskeletal pain is associated with psychological problems in a cross-sectional setting, the associations of long-term musculoskeletal pain with psychological distress and anxiety are not known."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The study included 1773 adolescents belonging to the Northern Finland Birth Cohort 1986. They received a postal questionnaire at the age of 16years and a follow-up questionnaire two years later. The first inquiry contained questions about the sites of musculoskeletal pain; the second had the same pain questions, along with measures of distress and anxiety. Risk ratios (RR) were assessed by log-linear regression analysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Multi-site musculoskeletal pain (in ≥2 body locations) at both 16 and 18years was common, reported by 53% of girls and 30% of boys. Multi-site pain at both ages, compared to those with multi-site pain neither at 16 nor 18years, was associated with psychological distress at the age of 18 among both girls (RR 1.8 95% CI 1.2-2.7) and boys (RR 3.5 95% CI 2.1-5.9). For anxiety, the corresponding relative risks were 1.5 (95% CI 1.0-2.2) and 1.8 (95% CI 1.4-2.3), respectively. For short-term multi-site pain (prevalent only at the age of 16 or 18), these relative risks were between 0.8 and 2.3."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Adolescents with long-term multi-site pain have higher levels of distress and anxiety than those without or with only short-term multi-site pain. Associations were found in both genders, but the relationship between pain and distress was more pronounced among boys. The associations had modest effect strength."
          }
        ]
      },
