      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Splenic abscesses are uncommon manifestation of an acute abdomen. We reported a case of splenic abscess managed by tube drainage."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "A case report using the case note records of the patient and review of the relevant literature on splenic abscess."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "A forty five year old Nigerian who presented with features of splenic abscess and was managed by tube drainage. His post operative recovery was uneventful."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Tube drainage of the splenic abscess is encouraged if there is easy access to the abscess and there is evidence of residual splenic tissue in the critically ill patient."
        }
      ]},
