      "Abstract": {
        "CopyrightInformation": "Copyright 2009. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The aim of this study is to report on the impact of neuromodulation to the superior hypogastric plexus in patients with bladder atonia secondary to pelvic surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In 4 consecutive patients with bladder atonia secondary to pelvic surgery, we performed a laparoscopic implantation of a neurostimulator--LION procedure--to the entire superior hypogastric plexus."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of the 4 reported patients, 3 are able to partially void or empty their bladder."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "If the presented results could be obtained in further patients and maintained in long-term follow-up, the LION procedure to the superior hypogastric plexus could change the management of bladder function in patients with bladder atonia."
          }
        ]
      },
