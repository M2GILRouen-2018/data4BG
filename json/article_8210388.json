      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Acute renal infarction (ARI) is an uncommon and often overlooked diagnosis in patients presenting with acute kidney injury and abdominal pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORTS",
          "content": "We present 2 cases of ARI in the setting of atrial fibrillation along with a review of medical literature pertaining to ARI."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This article should aid clinicians in the diagnosis of ARI."
        }
      ]},
