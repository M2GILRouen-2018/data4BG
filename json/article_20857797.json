      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of cancer of the colon which presented as secondaries to the ovaries."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Case report."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "The case presented is that of a 39-year-old female who presented with lower abdominal pain and a multinodular pelvic mass which led to an initial diagnosis of multiple uterine fibroids and pelvic inflammatory disease. The presence of a colonic mass was first suggested by ultrasound. Laparotomy revealed carcinoma of the colon with bilateral krukenberg's tumour and an insignificant fibroleiomyoma."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This case is reported to alert practitioners that all multinodular pelvic masses should not be assumed to be multiple fibroids."
        }
      ]},
