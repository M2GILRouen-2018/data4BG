      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To test the hypothesis that adjunctive intracameral 1% lidocaine reduces intraoperative pain during phacoemulsification using topical anesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, double-masked, randomized, controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "A total of 200 patients undergoing routine phacoemulsification under topical 1% tetracaine were studied."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Randomization to 0.5 ml intracameral, unpreserved, epinephrine-free 1% lidocaine or placebo was conducted."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Intraoperative pain was quantified by the patients using a 0-10 visual analog pain scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Intraoperative pain scores (+/- standard deviation) for the lidocaine and control groups were 1.29 +/-1.24 and 1.44 +/- 1.33, respectively (P > 0.35)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In a rigorously double-masked, prospective, randomized, controlled trial there was no significant reduction in intraoperative pain when intracameral 1% lidocaine was used during phacoemulsification under topical anesthesia."
        }
      ]},
