      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The risk factors for cardiovascular disease (CVD) are associated with coronary atherosclerosis and having multiple risk factors potentiates atherosclerosis. This study examined the prevalence of multiple biological and lifestyle/behavioral risk factors and their association with coronary artery calcium (CAC), a marker for subclinical coronary atherosclerosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This is a cross-sectional study of 1607 community-dwelling asymptomatic individuals from central Appalachia who participated in CAC screening between January 2011 and December 2012. Data on demographics (sex and age) and 7 traditional risk factors for coronary artery disease (CAD) were collected and categorized into 5 groups (0-1, 2, 3, 4, and ≥5). Prevalence of these risk factors and CAC scores (0, 1-99, 100-399, ≥400) were assessed, and the impact of the number of risk factors on CAC scores were delineated using multiple logistic regression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Over 98% of participants had ≥1 risk factor. While obesity, diabetes, hypertension, and family history of CAD significantly increased the odds of having CAC, CAC scores significantly increased with number of risk factors. After adjusting for demographic factors, having 3, 4, and ≥5 risk factors was significantly associated with increased odds of having higher CAC scores when compared to zero CAC score by more than one and half times [OR=1.65, CI (1.20-2.25)], two times [OR=2.32, CI (1.67-3.23)] and three times [OR=3.45, CI (2.42-4.92)], respectively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The high prevalence of multiple risk factors in the study population suggests the need for aggressive multiple risk factors interventions for primary prevention of CAD, which could address CVD health disparities."
          }
        ]
      },
