      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the feasibility of obtaining hemodynamic metrics of echocardiographically derived 3-dimensional printed mitral valve models deployed in a pulse-duplicator chamber."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Exploratory study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary-care university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Percutaneous MitraClip procedure patient."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Three-dimensional R-wave gated, full-volume transesophageal echocardiography images were obtained after deployment of the MitraClip device. A high-quality diastolic frame of the mitral valve was segmented using Mimics Innovation Suite and merged with a flange. The data were exported as a stereolithography (.stl) file, and a rigid 3-dimensional model was printed using a MakerBot Replicator 2 printer. A flexible silicone cast then was created and deployed in the pulse-duplicator chamber filled with a blood-mimicking fluid."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "The authors were able to obtain continuous-wave Doppler tracings of the valve inflow with a transesophageal echocardiography transducer. They also were able to generate diastolic ventricular and atrial pressure tracings. Pressure half-time and mitral valve area were computed from these measurements."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This pulse duplicator shows promising applications in hemodynamic testing of patient-specific anatomy. Future modifications to the system may allow for visualization and data collection of gradients across the aortic valve."
          }
        ]
      },
