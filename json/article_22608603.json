      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Patients with end-stage renal disease (ESRD) often present to the Emergency Department with a multitude of complaints. Abnormal vital signs and a chief complaint of pain can produce a diagnosis ranging from a cardiac etiology to an infectious source."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Our goal is to discuss a case in which an ESRD dialysis patient presented with a rare, life-threatening emergency."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "A 55-year-old man with ESRD presented with acute abdominal pain and hypotension caused by a spontaneous retroperitoneal hemorrhage."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This case report demonstrates the necessity of having broad differential diagnoses when evaluating patients with ESRD."
          }
        ]
      },
