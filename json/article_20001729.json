      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To review the evidence on a number of biomarkers that show potential clinical utility in the prediction of and treatment responsiveness for the four most common symptoms associated with cancer and its treatment (ie, pain, fatigue, sleep disturbance, depression)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "Review and synthesis of review articles and data-based publications."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "A growing body of evidence suggests that sensitive and specific biomarkers will be available to assist clinicians with the assessment and management of symptoms."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR NURSING PRACTICE",
            "content": "Nurses will play a critical role in educating patients about their risk for specific symptoms based on an evaluation of specific biomarkers. Nurses will be involved in using biomarker data to titrate medications based on patient's responses to symptom management interventions."
          }
        ]
      },
