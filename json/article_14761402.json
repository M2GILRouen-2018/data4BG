      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effects of different vibration frequency on the back muscle fatigue during simulated driving."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Thirty-six subjects performed three simulated driving experiments under three vertical vibration frequencies which were 1.8, 4.0, 6.0 Hz respectively and the driving time was 90 minutes. At the same time the electromyography of low back was recorded."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The median frequencies calculated from the power spectrum were decreased exponentially under three vertical vibration frequencies, especially under 4.0 Hz vibration frequency."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The 4.0 Hz vibration frequency has the most important effect on the back muscle fatigue under simulated driving condition."
        }
      ]},
