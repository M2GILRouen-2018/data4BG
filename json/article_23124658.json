      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 John Wiley & Sons, Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "RATIONALE",
            "content": "20(S)-ginsenoside Rg3 is an active component of Panax ginseng. It is known that 20(S)-ginsenoside Rg3 has a protective effect against hyperglycemia, obesity and diabetes in vivo, but the precise mechanisms of these actions have not yet been entirely elucidated."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A urinary metabonomics method based on rapid-resolution liquid chromatography/mass spectrometry (RRLC/MS) was developed to investigate the effect of 20(S)-ginsenoside Rg3 on type 2 diabetic rats."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "With multivariate statistical analysis, a clear separation between type 2 diabetic rats and those treated with 20(S)-ginsenoside Rg3 was achieved. Six potential biomarkers were found and identified."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This work shows that the mechanism of the effect of 20(S)-ginsenoside Rg3 on type 2 diabetes may be involved with the regulation of nucleic acid metabolism, energy metabolism and gut flora metabolism."
          }
        ]
      },
