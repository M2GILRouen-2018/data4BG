      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To study sexual hormones levels in risk of beginning and development of coronary heart disease (CHD) in young and middle-aged (up to 50 years) men and women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Sexual hormones were studied in 105 patients (53 males and 52 females) aged 25-50 years. Of them, 88 suffered from IHD and 17 had CHD risk factors. Twenty healthy controls were matched by age and gender. LH, FSH, estradiol, testosteron were measured in blood serum by enzyme immunoassay (Elecsys kit, Beringer Mannheim)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Young and middle-aged (under 50 years of age) males and females with IHD or its risk factors have changed levels of sexual hormones."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In IHD male hormones levels increase in women but decrease in men while female hormones increase in men and decrease in women."
        }
      ]},
