      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To characterize brown adipose tissue (BAT) in the human perirenal adipose tissue depot."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Perirenal adipose tissue biopsies were obtained from 55 healthy kidney donors. Expression analysis was performed using microarray, real-time PCR, immunoblotting and immunohistochemistry. Additional studies using human stem cells were performed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "UCP1 gene expression analysis revealed a large intra-individual variation in the perirenal adipose tissue biopsies. Both multi- and unilocular UCP1-positive adipocytes were detected in several of the adipose tissue samples analyzed by immunohistochemical staining. Microarray analysis identified 54 genes that were overexpressed in UCP1-positive perirenal adipose tissue. Real-time PCR analysis of BAT candidate genes revealed a set of genes that were highly correlated to UCP1 and a set of three transcription factor genes (PRDM16, PGC1α, and RXRγ) that were highly correlated to each other. RXRγ displayed nuclear immunoreactivity in brown adipocytes and an increased gene expression during brown adipogenesis in human stem cells."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Our data provides the first molecular characterization of BAT in the perirenal adipose tissue depot. Furthermore, it highlights the transcription factor RXRγ as a new player in BAT development."
          }
        ]
      },
