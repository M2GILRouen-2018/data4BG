      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Vertebra plana has been considered a contraindication for vertebroplasty for various reasons including difficulty in needle placement. Recently, vertebroplasty under conventional fluoroscopic guidance has been shown to be feasible in patients with vertebra plana."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Cone-beam CT with a navigation guidance system can be used during vertebroplasty in patients with severe vertebra plana to allow safe needle trajectory and placement."
        }
      ]},
