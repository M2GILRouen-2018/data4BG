      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Oxidative stress is a characteristic of exercise-induced asthma (EIA), however antioxidant supplementation may attenuate EIA. The purpose of this study was to determine if ascorbic (AsA) and α-tocopherol supplementation would improve airway function in subjects with EIA."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A single-blind randomized crossover design with eight clinically diagnosed EIA subjects (22.0 ± 0.7 year) and five healthy control subjects (28.2 ± 1.4 year) was used. Subjects consumed vitamins (V) (AsA 500 mg; α-tocopherol 300 IU) or placebo (PLA) daily for three weeks, followed by a three week washout period and then three weeks of the alternative treatment. Ten-minute treadmill tests (90% VO2peak) were performed with pulmonary function testing (forced vital capacity (FVC), forced expiratory volume in one second (FEV1) and between 25 and 75% (FEF25-75%), and peak expiratory flow rates (PEFR)) measured pre-exercise and 1, 5, 15, and 30 min post-exercise."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Supplementation led to significant improvements at minute 5 and minute 15 in FVC; FEV1; PERF; FEF25-75% and minute 30 in FEV1 and FEF25-75% post-exercise."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "AsA and α-tocopherol may aid the recovery of pulmonary function in subjects with EIA."
          }
        ]
      },
