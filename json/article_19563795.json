      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "This study was conducted to investigate the expression of cytokines and growth factors in disc specimens obtained from patients with herniated nucleus pulposus (HNP) and degenerated disc disease (DDD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND METHODS",
          "content": "MRI and Western blot analyses were performed to evaluate the levels of disc degeneration and the expression levels of cytokines and growth factors."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The levels of TNF-alpha and IL-8 were significantly greater in the DDD group than in the HNP group, but no statistical differences were observed in the expression of IL-1beta, IL-6 and IL-12 between the HNP and DDD groups. In addition, the expression of TGF beta, VEGF and NGF was significantly higher in the DDD group than in the HNP group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The greater levels of cytokine and growth factor expression in the DDD group than in the HNP explain why discogenic patients usually have more severe back pain than patients with herniated discs."
        }
      ]},
