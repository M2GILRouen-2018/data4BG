      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To discuss the variation of resistance of airway (Raw) and the diagnostic value of the bronchus diastole test for asthma patient."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The forced expiratory volume of the first second (FEV1) and Raw were measured."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "1. The positive rate of FEV1 increase after the test was 68% (20/31). 2. There was a significant difference in percentage of FEV1 increase after the test between positive group and negative group. 3. After the bronchus diastole test, the Raw decreased significantly in both groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The decrease of Raw after bronchus diastole test is more valuable for the asthma diagnosis than that of FEV1."
        }
      ]},
