      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM OF THE STUDY",
          "content": "The ethanol extract (LF) of Ligularia fischeri var. spiciformis (leaf) has been evaluated for antinociceptive and anti-inflammatory activities in mice."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Analgesic and anti-inflammatory activities were studied by measuring nociception induced by formalin, acetic acid and hot-plate, and inflammation induced by carrageenan, formalin, and arachidonic acid."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The acute treatment of mice with LF at doses of 100 and 200mg/kg, by oral administration, produced a significant antinociceptive effect in the acetic acid-induced writhing, formalin-induced pain licking and hot-plate-induced pain. Also, the LF significantly inhibited both carrageenan- and formalin-induced inflammation as well as arachidonic acid-induced ear edema in mice."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These inhibitions were statistically significant (P<0.05). Thus, our investigation suggests a potential benefit of Ligularia fischeri in treating conditions associated with inflammatory pain."
        }
      ]},
