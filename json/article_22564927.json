      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 AAGL. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To estimate the long-term complication rate of office hysteroscopy with the vaginoscopic approach."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective cohort study (Canadian Task Force classification II-A)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University-affiliated teaching hospital with outpatient hysteroscopy facilities."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Between January 2005 and October 2007, all consecutive patients undergoing office hysteroscopy with the vaginoscopic approach were analyzed, 1028 procedures in total."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Therapeutic or diagnostic office hysteroscopy with the vaginoscopic approach. The complication registration of the gynecology department and a random sample of one third of the medical records were analyzed for long-term complications."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "Of the 1028 hysteroscopic procedures, 622 (60%) were diagnostic, 328 (32%) were therapeutic hysteroscopic procedures, and 78 (8%) procedures failed. In the complication registration and in the medical charts, 1 significant complication could be identified."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Office hysteroscopy with the vaginoscopic approach is a safe procedure. This study showed an extremely low risk of long-term complications."
          }
        ]
      },
