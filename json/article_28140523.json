      "Abstract": {
        "CopyrightInformation": "© 2017 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Neonatal coronary thrombosis is a rarely reported disorder, with variable outcomes described. This study assessed the feasibility and safety of an institutional protocol using tissue plasminogen activator (tPA) administration for the treatment of neonatal coronary artery thrombi."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "They reviewed the outcome of three neonates with clinical evidence of myocardial infarction secondary to coronary thrombosis. All three underwent the tPA treatment protocol."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The three described cases presented at 5 hours, 15 hours, and 10 days of life. The patients identified underwent the tPA protocol at least once. There was clinical evidence of improvement in coronary flow, as well as demonstration of increased left ventricular function and decreased mitral regurgitation. No major adverse events occurred."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Thrombolytic therapy with this tPA protocol may be safe and effective in treating neonates with coronary thrombosis."
          }
        ]
      },
