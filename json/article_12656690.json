      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Drugs for the management of cardiovascular disease may provoke gastrointestinal discomfort and complications."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To evaluate whether upper gastrointestinal symptoms affect the health status of patients with cardiovascular disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Two weeks after discharge, 958 consecutive patients, who had been admitted to the Coronary Care Unit of the University Hospital Nijmegen between January and September 2001, were sent a questionnaire for the evaluation of gastrointestinal symptoms and health status."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The questionnaire was returned by 632 patients (66%), with 334 patients (53%) reporting gastrointestinal symptoms. The self-rated health status (mean and 95% confidence interval), evaluated by visual analogue scale, was 70 (68-72) for patients without and 61 (59-63) for patients with gastrointestinal symptoms (P = 0.001). Patients with gastrointestinal symptoms reported significantly higher rates of problems with mobility (50% vs. 37%), self-care (19% vs. 10%), usual activities (70% vs. 52%), pain/discomfort (96% vs. 38%) and anxiety/depression (41% vs. 20%) when compared with those without gastrointestinal symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Upper gastrointestinal symptoms strongly impaired the health status of patients with cardiovascular disease."
        }
      ]},
