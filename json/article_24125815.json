      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American Association for Geriatric Psychiatry. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The present study examines racial/ethnic variations in the relation between body mass index (BMI) and cognitive function among older adults."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional study of secondary data."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Data were obtained from the 2010 Health and Retirement Study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Racial/ethnic groups analyzed were black (n = 546), Hispanic (n = 110), and non-Hispanic white (n = 4,104)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "BMI was calculated based on self-reported height and weight. Cognitive function was measured based on Telephone Interview for Cognitive Status-Health and Retirement Study version scores."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Significant main effects were found for both BMI and race/ethnicity, indicating that cognitive function varies significantly by both. The BMI × race/ethnicity interaction was also found to be significant. The interaction revealed that among the white sample cognitive function scores tended to increase as BMI increased whereas the opposite relation was observed in the Hispanic sample. The black sample displayed a similar pattern as the white sample, although a decrease was observed in cognitive function scores once BMI reached obesity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The results suggest that the relation between BMI and cognitive function does vary by race ethnicity. Therefore, it can be concluded that high or low BMI may vary as a risk or protective factor for cognitive dysfunction among older adults by race/ethnicity. Implications for research and clinical work are discussed."
          }
        ]
      },
