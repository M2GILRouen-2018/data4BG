      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effectiveness of modified hysterosalpingography using <3 mL amount of contrast medium followed by injection of saline to minimize the adverse effects associated with the procedure."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "For modified hysterosalpingography, 1-2 mL of water-soluble contrast medium were injected to visualize the uterine cavity, followed by injection of 10 mL of saline to check tubal patency and spillage. A control group of patients underwent hysterosalpingography with undiluted contrast medium."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Seventy-eight infertile women [study (n = 40)/control (n = 38) groups]."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Modified and standard hysterosalpingography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Assessment of uterine cavity, tubal patency, and sensation of pain during modified hysterosalpingography was compared with that during standard hysterosalpingography."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Uterine cavity and tubal patency were properly visualized during modified hysterosalpingography. Saline pushed the contrast medium successfully from the uterine cavity through the open fallopian tubes and into the pelvic cavity. The study group reported significantly less pain than did the control group. Between-group differences were statistically significant when pain perception (no pain vs. minimal pain vs. severe pain; no pain vs. any kind of pain) was analyzed by type of adnexal pathology (bilateral passage or unilateral passage)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Modified hysterosalpingography was sufficient to diagnose tubal and pelvic mechanical factors. The procedure was associated with a significant reduction in self-reported pain and no medical complications."
        }
      ]},
