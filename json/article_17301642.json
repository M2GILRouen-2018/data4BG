      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Most prognostic studies of the acute coronary syndrome (ACS) have been performed in patients selected for inclusion into clinical trials. We stratified the risk of death during the year after hospitalization for a first episode of ACS in unselected patients based on clinical and socio-economic information."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In 2000-2002 we identified 457 consecutive unselected patients admitted to hospital with a first episode of ACS. Vital status was obtained from Danish national registers."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The 1-year case-fatality proportion was 9.8%. Positive predictors of mortality were living alone, Q waves and diabetes. Negative predictors were chest pain, ST elevation and treatment with angioplasty or thrombolysis."
        }
      ]},
