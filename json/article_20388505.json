      "Abstract": {
        "CopyrightInformation": "Copyright 2010 The Canadian Society of Clinical Chemists. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To examine if pregnancy-associated plasma protein-A (PAPP-A) in patients with chest pain, could identify patients at risk for death or myocardial infarction."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "Patients admitted with chest pain and both normal ECG and normal biomarkers were evaluated by serial measurement of PAPP-A. Main outcome measures were mortality and non-fatal myocardial infarction."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Median age of patients included (415) was 67years and 43% were women. The risk of death or non-fatal myocardial infarction after 3 months was 15% in the highest quartile of circulating PAPP-A compared with 3% in the lowest quartile (relative risk 3.7, p<0.01). Corresponding numbers after 1 year were 24% and 10% (relative risk 2.4, p=0.01)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "In patients admitted with chest pain and both normal ECG and normal biomarkers PAPP-A seems to be valuable for predicting patients at high risk of death or non-fatal myocardial infarction."
          }
        ]
      },
