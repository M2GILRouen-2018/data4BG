      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Pain is a common symptom in Parkinson's disease (PD), and is often related to the illness itself."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To prospectively establish the occurrence of pain in PD patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "This study was conducted within a population composed of 50 patients with PD to evaluate the presence of pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Twenty-eight patients reported pain; comparing the group with pain and the group without pain, there were no differences related to the beginning of the illness and the motor symptoms of PD. However, many patients related an improvement of pain when antiparkinsonian therapy was initiated or adjusted."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The use of techniques for analgesia and the adjustment of PD medication contribute to improve the manifestations of pain and the life quality of patients with PD."
        }
      ]},
