      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To examine whether wheelchair users' self-reports of height and weight differed significantly from direct measurements and whether weight category classifications differed substantially when based on self-reported or measured values."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Single group, cross-sectional analysis. Analyses included paired t tests, chi-square test, analysis of variance, and Bland-Altman agreement analyses."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A university-based exercise lab."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Community-dwelling wheelchair users (N=125)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Not applicable."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE",
            "content": "Participants' self-reported and measured height, weight, and body mass index."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Paired t tests revealed that there were significant differences between wheelchair users' self-reported and measured values for height (difference of 3.1±7.6cm [1.2±3.0in]), weight (-1.7±6.5kg [-3.6±14.2lb]), and BMI (-1.6±3.3). These discrepancies also led to substantial misclassification into weight categories, with reliance on self-reported BMI underestimating the weight status of 20% of the sample."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our findings suggest that similar to the general population, wheelchair users are prone to errors when reporting their height and weight and that these errors may exceed those noted in the general population."
          }
        ]
      },
