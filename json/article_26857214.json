      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 SIR. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To determine incidence, predictors, and clinical outcomes of postcontrast acute kidney injury (PC-AKI) following renal artery stent placement for atherosclerotic renal artery stenosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "This retrospective study reviewed 1,052 patients who underwent renal artery stent placement for atherosclerotic renal artery stenosis; 437 patients with follow-up data were included. Mean age was 73.6 years ± 8.3. PC-AKI was defined as absolute serum creatinine increase ≥ 0.3 mg/dL or percentage increase in serum creatinine ≥ 50% within 48 hours of intervention. Logistic regression analysis was performed to identify risk factors for PC-AKI. The cumulative proportion of patients who died or went on to hemodialysis was determined using Kaplan-Meier survival analysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Mean follow-up was 71.1 months ± 68.4. PC-AKI developed in 26 patients (5.9%). Patients with PC-AKI had significantly higher levels of baseline proteinuria compared with patients without PC-AKI (odds ratio = 1.38; 95% confidence interval, 1.11-1.72; P = .004). Hydration before intervention, chronic kidney disease stage, baseline glomerular filtration rate, statin medications, contrast volume, and iodine load were not associated with higher rates of PC-AKI. Dialysis-free survival and mortality rates were not significantly different between patients with and without PC-AKI (P = .50 and P = .17, respectively)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Elevated baseline proteinuria was the only predictor for PC-AKI in patients undergoing renal artery stent placement. Patients who developed PC-AKI were not at greater risk for hemodialysis or death."
          }
        ]
      },
