      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To evaluate causes of failed optional inferior vena cava filter (IVCF) retrievals."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Single-center retrospective study."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "IVCF retrievals were attempted in 26/211 (12%) patients at a mean 42.9 days. There were 9 failures (all OptEase) due to: inability to snare the hook (n=5), noncollapsible IVCF (n=3), and unusual procedural pain (n=1). Median duration of retrieved IVCFs was 31 days compared to 53 days for failures (P<.05). IVCFs aligned with the IVC's cephalocaudal axis were retrieved in 13/16 cases, while misaligned IVCFs were retrieved 4/10 cases (P<.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Filter duration and misalignment were significantly associated with retrieval failures."
          }
        ]
      },
