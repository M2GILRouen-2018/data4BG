      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To explore the role of gammadeltaT cells in the pathogenesis of allergic bronchial asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Forty patients with Der.p and Der f allergy and partly-controlled asthma were involved in a random study. Besides the fact that all patients were treated with same basic treatment. Patients in group A were nebulized with 5 mL normal saline while group B with specific allergen twice a week for six months. The percentage of gammadeltaT cells in peripheral blood and induced sputum and the percentage of IL-4(+) and IFN-gamma(+) gammadeltaT cells were detected by flow cytometry(FCM) before and after treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The percentage of gammadeltaT cells in group B decreased after treatment, and the percentage of IFN-gamma(+) gammadeltaT cells in both peripheral blood and induced sputum increased significantly in group B than that in group A."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "gammadeltaT cells, which may participate in the pathogenesis of bronchial asthma, may contribute to the prevention and treatment of bronchial asthma by desensitization of allergen nebulization."
        }
      ]},
