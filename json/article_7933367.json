      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the appropriateness of performing coronary angiography and revascularization in a Swedish population."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective population study of questionnaires and medical records."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "All the hospitals in southwestern Sweden that perform coronary angiography and revascularization."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Random sample of 831 patients (with chronic stable angina) on the waiting list for coronary angiography or revascularization in southwestern Sweden in September 1990."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Percentage of patients referred for coronary angiography or revascularization for appropriate, uncertain, or inappropriate indications."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of the patients referred for angiography, 89% were classified as appropriate, 9% as uncertain, and 2% as inappropriate. The percentages are similar for patients referred for coronary artery bypass graft surgery and for angioplasty (91% and 86%, respectively, classified as appropriate). The majority of patients had chest pain rated as Canadian Cardiovascular Society classes II through IV (93%), despite maximum anti-ischemic therapy in 90% of these patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Few patients were referred for coronary angiography or revascularization for inappropriate or uncertain indications. The percentage of these patients who are from southwestern Sweden is similar to the percentage recently reported from New York State."
        }
      ]},
