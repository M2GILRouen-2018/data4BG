      "Abstract": {
        "CopyrightInformation": "Copyright 2010 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM OF STUDY",
            "content": "Extracts of Pistacia integerrima galls have been dispensed by Traditional Practitioners of Subcontinent for chest diseases as well as for aches and pains in the body. This study was planned to evaluate the possible analgesic and antiinflammatory effects of Pistacia integerrima extracts."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "Analgesia was determined using acetic acid induced abdominal constriction and formalin induced paw licking in mice. Antinociceptive effect was observed by thermally induced algesia in mice."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pistacia integerrima leaves extracts showed significant response against chemically induced pain (P<0.001) whereas galls extracts had highly significant protection (P<0.0001) in a dose dependent manner. In thermally induced algesia, Pistacia integerrima galls extracts 200 mg/kg (p.o.), showed significant (P<0.05) response but less than pentazocine and diclofenac, positive references. The extracts of Pistacia integerrima 50-200 mg/kg (p.o.) had modest activity against hind paw acute and chronic inflammation induced by formalin (P<0.01)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These results demonstrate that Pistacia integerrima extracts have antinociceptive and analgesic effects and no apparent acute toxicity on oral administration."
          }
        ]
      },
