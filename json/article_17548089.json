      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To address the endometrial safety of tibolone."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "The Tibolone Histology of the Endometrium and Breast Endpoints Study (THEBES) is a randomized, double-blind, parallel-group trial of tibolone compared with continuous combined conjugated equine estrogen (CEE) and medroxyprogesterone acetate (MPA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Multi-country, multi-center ambulatory care setting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A total of 5,185 subjects were screened, and biopsies were obtained from 4,446 women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Participants were randomized in a 1:1:2 ratio, to tibolone (1.25 or 2.5 mg/d) or CEE-MPA."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "The one-sided 95% confidence intervals for the incidence of hyperplasia or cancer were evaluated for tibolone compared with CEE-MPA."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Endometrial biopsy results at baseline: atrophic (87.29%), inactive (0.25%), proliferative (6.12%), secretory (2.86%), menstrual type (0.40%), and hyperplasia (0.18%). Only subjects with atrophic or inactive endometrium were eligible for this study, and 3% of the women at screening either had no tissue (0.18%) or had an amount of tissue that was insufficient for diagnosis (2.72%). Three thousand two hundred forty postmenopausal women with a mean (+/-SD) age of 54.4 +/- 4.4 years and a mean time since menopause of 4.5 +/- 3.6 years were randomized."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "The Tibolone Histology of the Endometrium and Breast Endpoints Study is a prospective, randomized clinical trial, designed to provide evidence of the endometrial safety of tibolone compared with estrogen and progestogen. Screening endometrial histology shows a low prevalence of endometrial hyperplasia (0.18%) and no carcinoma."
        }
      ]},
