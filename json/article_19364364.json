      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND PURPOSE",
          "content": "Central neuropathic pain (CNP) is a prevalent and distressing symptom in patients with multiple sclerosis (MS). The anticonvulsant levetiracetam (LEV) has been shown to be efficacious in some types of CNP, but its efficacy in MS-related CNP has not been confirmed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "To investigate the tolerability and potential effects of LEV against CNP in MS subjects, we performed a single-center, prospective, randomized, single-blind, placebo-controlled study in twenty patients with MS and CNP. Outcomes before and during the 3-month study were assessed using validated measures of pain, depression, disability and quality of life."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The medication was well tolerated and analysis revealed a significant difference between the LEV and placebo arm in all study outcomes related to pain (mean pain intensity score, mean pain difference, percentage of patients with a clinically significant pain reduction). Furthermore, the individual quality of life rating improved in treated patients, showing a significant correlation with pain reduction."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These findings suggest that further studies with larger samples of patients be carried out in order to confirm the efficacy of LEV in MS-related CNP population."
        }
      ]},
