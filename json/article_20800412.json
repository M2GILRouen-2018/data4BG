      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Bilateral mastoiditis in adults has previously been reported only in association with diabetes mellitus or immunocompromised patients."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To describe a case of bilateral mastoiditis in a healthy adult and to investigate the etiology."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "A 53-year-old woman presented to the Emergency Department with bilateral otitis externa and mastoiditis after scuba diving during a harmful algal bloom, commonly known as a \"red tide.\" The levels of coliform bacteria recorded at the time and location of her dive exceeded health regulatory limits and correlate with her atypical culture results."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Elevated bacterial counts that result from harmful algal blooms may account for this rare infection."
          }
        ]
      },
