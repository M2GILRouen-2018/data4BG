      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Schwannomas comprise 8% to 10% of all primary intracranial tumors. Primary intraorbital schwannomas are rare, accounting for 1% to 2% of all intracranial tumors. Schwannomas arise from Schwann cells in the myelin sheaths of sensory and cranial nerves."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We present the case of a 56-year-old white man blind since 1970 who presented to an outside hospital for a painful right eye. Physicians identified no clinical or radiologic features of neurofibromatosis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The patient underwent enucleation; the final pathologic diagnosis was ancient schwannoma."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "We describe herein a case of intrascleral schwannoma with ancient changes arising within the globe of the right eye occupying the subretinal space and completely replacing the vitreous body."
          }
        ]
      },
