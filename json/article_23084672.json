      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 AAGL. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To describe the effects of laparoendoscopic single-site (LESS) surgery performed over 3 consecutive years to treat adnexal disease and to report patient perioperative outcomes."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective clinical study (Canadian Task Force classification III)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary care academic medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Women undergoing LESS because of a benign gynecologic indication, from January 2009 through December 2011."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Women with benign adnexal disease ≤10 cm underwent LESS surgery through a single 1.5- to 2.0-cm umbilical incision. Intraoperative and postoperative outcomes were carefully recorded, including the need for postoperative rescue analgesia."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "One hundred twenty-five patients were enrolled. Median patient age was 49 years, and median body mass index was 23. Surgical procedures included unilateral or bilateral salpingo-oophorectomy and unilateral or bilateral cyst enucleation. Median operative time was 48 minutes. Pain control was optimal, with an average visual analog score of 4/10. Both patients and surgeons were highly satisfied with the cosmetic result, and the cosmetic visual analog score was 9/10 at discharge and at 30 days after surgery. The number of women who underwent unilateral or bilateral salpingo-oophorectomy increased progressively and significantly yearly over the study period (16 vs 23 vs 40; p = .001). Median operative time for unilateral or bilateral salpingo-oophorectomy increased significantly from 2009 to 2010 and 2011 (34 vs 45 and 44 minutes; p = .001), together with median BMI (23 vs 23 vs 25; p = .04)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "LESS is a desirable surgical approach in patients with simple adnexal disease."
          }
        ]
      },
