      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "This is a retrospective study of 250 patients who describe low back pain with pain drawings. A computer application using artificial neural networks was designed to analyze pain drawings and evaluate the contribution of pain sensation to drawing classification."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The primary goal of this study was to assess the contribution of patient recorded pain sensation marks in classifying pain drawings into one of five broadly defined categories. The hypothesis was that including pain sensation would improve classification."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "With no perfect diagnostic test for patients with low back pain, many approaches have been proposed and are used. One common diagnostic tool is the pain drawing. Several quantitative methods have been proposed to score the drawings. Some methods use pain sensation in the scoring; however, the contribution of pain sensation has not been defined."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A custom computer application classified the pain drawing. Data consisted of 250 pain drawings from patients with low back pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patient recorded pain sensation is not necessary in computer-based scoring of pain drawings."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Patient-reported pain sensation does not improve classification when quantitatively scoring pain drawings."
        }
      ]},
