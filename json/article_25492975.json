      "Abstract": {
        "CopyrightInformation": "© International Headache Society 2014.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Cluster headache (CH) is a debilitating disorder characterized by unilateral, severe pain attacks with accompanying autonomic symptoms, often waking the patient from sleep. As it exhibits strong chronobiological traits and genetic studies have suggested a link with the hypocretin (HCRT) system, the objective of this study was to investigate HCRT-1 in CH patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Cerebrospinal fluid HCRT-1 concentration was measured in 12 chronic and 14 episodic CH patients during an active bout, and in 27 healthy controls. The patients were well characterized and clinical features compared to the HCRT concentration."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We found significantly lower HCRT levels both in chronic (p\u2009=\u20090.0221) and episodic CH (p\u2009=\u20090.0005) patients compared with controls. No significant relationship was found with other clinical features."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This is the first report of significantly reduced HCRT concentrations in CH patients. We speculate that decreased HCRT may reflect insufficient antinociceptive activity of the hypothalamus. The mechanism of the antinociceptive effect of HCRT is not known and requires further investigation. This study supports the hypothesis of a connection between arousal regulation and CH."
          }
        ]
      },
