      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Systemic administration of lidocaine has been widely reported to provide effective analgesia in both cancer and non-malignant pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "We report the use of intravenous lidocaine in the management of cancer-related neuropathic pain and its pivotal role in restoring function and facilitating end-of-life care at home."
        }
      ]},
