      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "The pain associated with peripheral neuropathy (PN) observed in patients living with HIV/AIDS represents a difficult complication to manage."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "A total of 22 participants with a diagnosis of PN were recruited to assess the effects of using night splints on pain and sleep quality."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "For 3 weeks, the participants were instructed to use bilateral night splints and given an exercise regimen for 3 additional weeks. Scores from pain and sleep questionnaires were analyzed using repeated measures analysis of variance (ANOVA)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The change in pain scores (F(1.16) = 13.41,η(2) =.456, P = .002) and sleep index scores (z = -2.69, P = .004, 1-tailed) was found to be significant following the use of night splints. No difference was found with the use of the exercises."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "The use of night splints in HIV-infected patients with PN represents an additional tool for managing pain and improving sleep."
        }
      ]},
