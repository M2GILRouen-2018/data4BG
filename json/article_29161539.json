      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 the Alzheimer's Association. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "A national consensus panel was convened to develop recommendations on future directions for home-based dementia care (HBDC)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The panel summarized advantages and challenges of shifting to HBDC as the nexus of care and developed consensus-based recommendations."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The panel developed five core recommendations: (1) HBDC should be considered the nexus of new dementia models, from diagnosis to end of life in dementia; (2) new payment models are needed to support HBDC and reward integration of care; (3) a diverse new workforce that spans the care continuum should be prepared urgently; (4) new technologies to promote communication, monitoring/safety, and symptoms management must be tested, integrated, and deployed; and (5) targeted dissemination efforts for HBDC must be employed."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "HBDC represents a promising paradigm shift to improve care for those living with dementia and their family caregivers: these recommendations provide a framework to chart a course forward for HBDC."
          }
        ]
      },
