      "Language": "ita",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Several studies report a high prevalence of low back pain (LBP) among video-terminal (VDT) workers. Targeted ergonomic interventions can help reduce the burden."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "We investigated the long-term efficacy of an ergonomic postural intervention to address LBP among VDT workers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Non-randomized, crossover trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "POPULATION AND SETTING",
          "content": "Four hundred employees working in the administrative offices of the two main buildings of the town hall ofForlì who used VDTs for at least 20 hours a week; we randomly selected 100 participants from each building."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Ergonomic adjustment of the VDT workstation design."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Changes in prevalence of LBP and work-related posture."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The ergonomic adjustment of the workstation improved work-related posture and reduced LBP in VDT operators who benefited from the intervention."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A personalized ergonomic prevention intervention can improve work-related posture and LBP for VDT workers."
        }
      ]},
