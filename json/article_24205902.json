      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Vitamin D deficiency is common among immigrants in the Nordic region. It may lead to osteomalacia with severe musculoskeletal pain. There are reports that vitamin D deficiency without osteomalacia may lead to pain but little is known of the effect of treatment."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate whether a moderate dose of cholecalciferol and calcium improves strength and pain in a group of vitamin D deficient women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Twentyfive immigrant women with vitamin D deficiency diagnosed during pregnancy were treated postpartum with a daily dose of 1,600 IU cholecalciferol and 1,000 mg of calcium. They were examined at the start of treatment and again after 3 months of treatement and the results were statistically compared."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Southern parts of Stockholm."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Serum 25-hydroyvitamin D (25(OH)D), serum-parathyroid hormone (PTH), pain measured by a visual analogue scale (VAS), musculoskeletal strength by performance on a chair stand test (seconds), and bone tenderness by pressure algometer (kilo-Pascal)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Following the treatment, the 21 women attending had lowered cm in VAS, improved musculoskeletal strength, - and 25(OH)D levels were normalized."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A moderate dose of vitamin D normalized l vitamin D levels, improved muscular strength and reduced pain in this group of vitamin D deficient immigrant women."
        }
      ]},
