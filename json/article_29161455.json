      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This study aimed to understand American Indian and Alaska Native (AI/AN) adolescents' perspectives on concerning social media posts, including those expressing suicidal intent."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A purposive sample of AI/AN youth were recruited; trained facilitators conducted focus groups. Participants discussed experiences viewing concerning posts on social media. Qualitative analysis used the constant comparative method."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 32 AI/AN youth ages 14-22 participated. Three salient themes emerged: 1) youth typically respond alone; 2) barriers to action; 3) recommended training and support - trusted adults, anonymity, and privacy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Study findings will guide the development of resources trusted by AI/AN youth."
        }
      ]},
