      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of this correlational study was to explore the physical activity and quality of life of postcoronary artery bypass graft patients with metabolic syndrome."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Seventy patients were recruited via purposive sampling. Data were collected through three instruments: a demographic questionnaire, the Modifiable Activity Questionnaire, and the Medical Outcomes Study Short Form 36-Health Survey. The data were analyzed using SPSS software, version 17.0 (SPSS, Inc., Chicago, IL), and data analysis included percentages, means, standard deviations, correlation coefficients, and forward regressions."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patients with a higher level of physical activity tended to have better quality of life. Our findings also indicated that the total Modifiable Activity Questionnaire score and age explained 15.1% of the variance in the physical component summary of quality of life, and 13.6% of the variance in the mental component summary of quality of life."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Based on this research, nursing staff should develop physical activity-related interventions to promote quality of life."
          }
        ]
      },
