      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the prevalence of lactose and fructose intolerance in children with chronic abdominal pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Hydrogen breath tests were done to detect lactose and fructose malabsorption in 86 children with chronic abdominal pain (44 irritable bowel syndrome, 24 functional abdominal pain and 17 functional abdominal pain syndrome as per Rome III criteria) presenting to a Pediatric Gastroentreology department."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "14 (16.3%) of patients were diagnosed with lactose intolerance and 11 (12.8%) with fructose intolerance."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Lactose and fructose intolerance in children can lead to chronic abdominal pain and symptoms improve with dietary modifications."
        }
      ]},
