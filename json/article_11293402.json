      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The -455G/A (HaeIII) polymorphism of the beta-fibrinogen gene influences levels of plasma fibrinogen. We determined whether it influences risk of coronary heart disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We conducted a case-cohort study nested within a prospective investigation, the Atherosclerosis Risk in Communities Study. We accumulated 398 incident coronary heart disease cases over a median of 5.3 years of follow-up and compared their -455G/A status with a random sample of the cohort (n = 498)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Plasma fibrinogen was higher (p = 0.04) in AA homozygous participants (341 mg/dL) than in persons carrying the G allele: GA (290 mg/dL), GG (298 mg/dL). However, there was no significant association between -455G/A and incident CHD."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Although a small effect cannot be excluded, -455G/A does not appear to be an important genetic determinant of CHD."
        }
      ]},
