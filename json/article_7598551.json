      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "A case of acute abdomen arising from endometriosis of the bladder is described. The rarity of this condition prompted us to report on the present case and the problems encountered in making the differential diagnosis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "METHODS/RESULTS",
          "content": "A patient with endometriosis of the muscle layer of the bladder mimicking acute gynecological abdomen is described."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Endometriosis of the bladder is extremely rare and usually presents as urinary problems and rarely as acute abdomen."
        }
      ]},
