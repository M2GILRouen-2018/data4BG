      "Abstract": {
        "CopyrightInformation": "Published by the BMJ Publishing Group Limited. For permission to use (where not already granted under a licence) please go to http://group.bmj.com/group/rights-licensing/permissions.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To assess the current health of the Deaf community in the UK and compare with the general population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A quota sample of adult Deaf British Sign Language (BSL) users underwent a health assessment and interview in 2012-2013. Comparative data were obtained from the Health Survey for England (HSE) 2011 and the Quality Outcomes Framework (QOF) 2012."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Participants completed a structured interview and health assessment at seven Bupa centres across the UK, supported in BSL by Deaf advisers and interpreters."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "298 Deaf people, 20-82\u2005years old, 47% male, with 12% from ethnic minorities."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Self-reported health conditions, medication usage, tobacco and alcohol consumption; measured blood pressure (BP), body mass index, fasting blood sugar and lipid profile."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Rates of obesity in the Deaf sample were high, especially in those over 65\u2005years, and 48% were in a high risk group for serious illness. High BP readings were obtained in 37% of Deaf people (21% in HSE): 29% were unaware of this (6% in HSE). Only 42% of Deaf people being treated for hypertension had adequate control, compared with 62% of the general population. Deaf people with self-reported cardiovascular disease (CVD) were significantly less than the general population. One-third of Deaf participants had total cholesterol >5\u2005mmol/L but although control rates were high compared with HSE, treatment rates for self-reported CVD were half the general population rate. Eleven per cent of Deaf participants had blood sugar at prediabetic or diabetic levels, and 77% of those at prediabetic levels were unaware of it. Deaf respondents self-reported more depression (31% of women, 14% of men), but less smoking (8%) and alcohol intake (2-8 units/week)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Deaf people's health is poorer than that of the general population, with probable underdiagnosis and undertreatment of chronic conditions putting them at risk of preventable ill health."
          }
        ]
      },
