      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "A 28-year old female presented with a non-radiating persistent left upper quadrant pain and tenderness for 5 weeks."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A preliminary CT scan displayed bony structures in the spleen. A delayed scanning subsequently showed the bones to have changed position, consistent with a life fetus."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Ultrasound confirmed the CT findings, and ascertained the fetus to be consistent with 13 weeks of gestation. Laparoscopic splenectomy was performed and examination of the intact spleen confirmed a male fetus that was morphologically normal."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This is the first report of fetal bony structures in the spleen associated with an advanced intra-splenic pregnancy."
        }
      ]},
