      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We conducted a systematic review to evaluate the influence of race and ethnicity on clinical pregnancy and live birth outcomes after in vitro fertilization (IVF)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY",
            "content": "We searched PubMed, EMBASE, Web of Science, CINAHL, POPLINE, and Cochrane Central, and hand-searched relevant articles published through July 22, 2015."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY APPRAISAL AND SYNTHESIS METHODS",
            "content": "Two reviewers independently evaluated abstracts to identify studies that compared clinical pregnancy rates and live birth rates for ≥2 racial and/or ethnic groups after nondonor IVF cycles."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Twenty-four studies were included. All 5 US registry-based studies showed that black, Hispanic, and Asian women had lower clinical pregnancy rates and/or live birth rates after IVF, compared with white women. Similarly, most clinic-specific studies reported significant disparities in these primary outcomes, potentially attributable to differences in infertility diagnosis, spontaneous abortion, and obesity. Studies varied with respect to definitions of race/ethnicity, inclusion of first cycles vs multiple cycles for individual women, and collected covariates. Most studies were limited by sample size, inadequate adjustment for confounding, selection bias, and extensive missing data."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Although current evidence points to race and ethnicity, especially black race, as strong predictors of poorer outcomes after IVF, the utility of results is constrained by the limitations described."
          }
        ]
      },
