      "Abstract": {"AbstractText": [
        {
          "Label": "UNLABELLED",
          "content": "An adolescent was hospitalized for recurring abdominal pains, which had previously led to appendicectomy. Laboratory data finally led to the diagnosis of hereditary angioneurotic oedema, after several hypotheses had been raised and ruled out."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Angioneurotic oedema is a rare condition, which should be suspected in children with recurring abdominal pains, especially when there is liquid within the peritoneal cavity."
        }
      ]},
