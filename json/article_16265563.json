        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A 58-year-old female with a history of hypertension and asthma presented to an internist for a routine physical examination. A grade II/VI systolic ejection murmur and electrocardiogram abnormalities were noted. She was referred to a cardiologist for further assessment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INVESTIGATIONS",
          "content": "Transthoracic echocardiography, transesophageal echocardiography, contrast-enhanced CT and MRI, exploratory laparotomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DIAGNOSIS",
          "content": "Intracardiac leiomyomatosis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MANAGEMENT",
          "content": "Surgical excision."
        }
