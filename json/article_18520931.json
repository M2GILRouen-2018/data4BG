      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A cross-sectional study on young adults."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the relationships between low back pain (LBP), maximal isometric trunk muscle strength, and body sway among young adults."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "The results of previous studies evaluating the association between trunk muscle strength and LBP are conflicting and heterogeneous. Furthermore, there are only few studies on the association between body sway and LBP."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The subjects (n = 874) belonged to a subcohort of the Northern Finland Birth Cohort 1986 (mean age 19 years). Trunk muscle strength and body sway were measured from all subjects. LBP symptoms were inquired with a questionnaire, which was completed concurrently with the examinations. Latent Class Analysis (LCA) was used to cluster the subjects according to their LBP symptoms."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "LCA analysis produced 6 clusters differing with respect to LBP symptoms. There were no statistically significant differences between the clusters in trunk muscle strength or body sway."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "LBP does not seem to be associated with maximal isometric trunk muscle strength or body sway in young adults."
        }
      ]},
