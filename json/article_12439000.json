      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case report of transient blindness after lumbar epidural steroids is presented."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report the diagnosis and treatment of a case of blindness after administration of lumbar epidural steroids."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Nine previous cases of blindness after lumbar epidural injection for back pain were identified. Retinal hemorrhages were identified on ophthalmologic examination in all cases."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The 1-year follow up evaluation of a 39-year-old male who sustained transient blindness after administration of lumbar epidural steroids is reported."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At 1 year, the patient had significant return of vision, but it did not improve back to baseline."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Transient blindness is a rare complication of lumbar epidural injection. The pathophysiology and prevention of this rare entity is reviewed."
        }
      ]},
