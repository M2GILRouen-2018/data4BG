      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 AEU. Published by Elsevier Espana. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CONTEXT",
            "content": "Chronic pelvic pain is localized in the lower abdomen or pelvis and persists for at least 6 months. It may be continuous or intermittent, without association to a cyclic menstrual condition or to maintaining sexual relationships."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To justify the important role played by the myofascial component in the etiology and clinical manifestation of Chronic Pelvic Pain and encourage the consideration of a therapeutic approach to such component in the intervention protocols."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "ACQUIRING OF EVIDENCE",
            "content": "A systematic review was made in PubMed and Cochrane Library (2000-2009) that included previous reviews, randomized controlled clinical studies, cohort studies and case studies with patients suffering chronic pelvic pain."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "SYNTHESIS OF EVIDENCE",
            "content": "Chronic pelvic pain and the different conditions associated to it occur with myofascial alterations that may be responsible for the perpetuation of the body symptoms and lack of evolutive resolution of the condition when said component is not approached in a specific way."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This is a clinical situation with elevated prevalence and incidence with significant impact in terms of quality of life and financial cost."
          }
        ]
      },
