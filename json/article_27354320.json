      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Acute arterial thromboembolism to the renal arteries can be treated promptly by local thrombolysis, conventional surgical thrombectomy, or anticoagulation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We report a patient who presented with acute loin pain as a result of atrial fibrillation-related thromboembolism to the right renal artery supplying his horseshoe kidney. He was already on warfarin treatment with international normalized ratio of 1.7 and had acute bleeding from malignant peptic ulcer disease, so thrombolysis was contraindicated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "He underwent timely endovascular revascularization with aspiration thrombectomy, with good clinical and radiological consequence. He subsequently underwent curative partial gastrectomy and made a steady recovery."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Early endovascular target-directed therapy such as intra-arterial thrombolysis and mechanical aspiration in combination with intravenous heparin therapy will result in renal salvage."
          }
        ]
      },
