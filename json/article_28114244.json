      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "Patients with cystic fibrosis (CF) and pancreatic insufficiency are prescribed fat-soluble vitamins, although compliance remains low. Our objective was to identify patient and caregiver knowledge deficits regarding vitamin supplementation, provide targeted education, and examine serum vitamin levels pre-and posteducation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This prospective quality improvement study involved 118 patients. A vitamin knowledge survey was given to patients/caregivers during a clinic visit, education was provided targeting knowledge deficits, and the survey was re-administered at the next clinic visit. Serum vitamin levels were collected at pre- and postsurvey."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Results showed significant pre-post increases for patient and caregiver knowledge scores, and significant decreases in self-reported nonadherence to vitamin use and number of reported barriers affecting adherence. A significant change in vitamin E level to therapeutic range post-education was demonstrated."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Our brief, targeted educational interventions regarding vitamin supplementation showed utility in a routine clinic setting."
        }
      ]},
