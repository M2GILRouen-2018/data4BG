      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Chronic kidney disease (CKD) is associated with adverse outcomes in patients who undergo coronary artery bypass grafting (CABG). However, the impact of preoperative dialysis dependence and duration in CKD patients on outcomes after CABG has limited research."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate the effect of preoperative dialysis dependence and duration on CABG outcomes in patients with CKD."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A total of 33,920 patients without CKD and 2573 patients with CKD, all of whom underwent isolated CABG between 1998 and 2009, were identified using the Taiwan National Health Insurance Research Database. The patients with CKD were divided into non-dialysis (N=1167), dialysis<3years (N=749), and dialysis≥3years (N=657) groups. The primary outcomes were cumulative incidence of all-cause mortality, cardiovascular (CV) death, and myocardial infarction (MI) or repeat revascularization."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After adjustment of all covariates, a higher all-cause mortality was associated with dialysis≥3years than with dialysis<3years (hazard ratio [HR], 1.56; 95% confidence interval [CI], 1.35-1.80; P<0.001) and with non-dialysis (HR, 1.41; 95% CI, 1.20-1.66; P<0.001) after 2years of follow-up. Similar results were observed for CV death. In addition, both the dialysis groups had a higher risk of MI or revascularization than the non-dialysis group. Furthermore, subgroup analysis revealed that longer duration was associated with a higher risk of 30-day mortality (P for linear trend <0.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Among the CABG recipients, dialysis dependence is associated with a higher incidence of MI or repeat revascularization, and longer dialysis duration is associated with a higher risk of mortality."
          }
        ]
      },
