      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Myofascial Trigger points (MTrPs) may be caused or aggravated by many factors, such as mental stress associated with exams and impaired posture."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To compare the prevalence and sensitivity of MTrPs, and forward head position (FHP) during exam period vs. mid-semester among physical therapy students."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "39 physical therapy students were palpated for MTrPs in neck and shoulder muscles and were photographed laterally for FHP measurement during the academic semester and during the academic examination period."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The subjects showed higher prevalence of active MTrPs in the right Trapezius and Levator Scapula muscles, and higher prevalence of latent MTrPs in the left Sternocleidomastoideus and Levator Scapula muscles during exams, as well as a higher rate of tenderness in suboccipital musculature."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Physical therapy students show greater prevalence of MTrPs during exams. The authors recommend implementing preventative programs towards the examination period."
          }
        ]
      },
