      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Editora Ltda. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To identify the prognostic factors for conventional physical therapy in patients with chronic low back pain (CLBP)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Prospective observational study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "One hundred thirteen patients with CLBP selected at the Spinal Disease Outpatient Clinic."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Pain intensity was scored using the Numeric Rating Scale (NRS), and function was measured using the Roland-Morris Disability Questionnaire (RMDQ)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The Fear-Avoidance Beliefs Questionnaire work subscale results (FABQ-work; odds ratio [OR]=0.27, 95% confidence interval [CI] 0.13 to 0.56, p<0.001) and extraspinal pain (OR=0.35, 95% CI 0.17 to 0.74, p=0.006) were independently associated with a decreased response to conventional physical therapy for CLBP."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "We identified high FABQ-work and extraspinal pain scores as key determinants of a worse response to physical therapy among CLBP patients, supporting the need for a special rehabilitation program for this subgroup."
          }
        ]
      },
