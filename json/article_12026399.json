      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To explore the relationships among appraisals of vaso-occlusive events, coping behavior during the event, and adjustment in adolescents with sickle cell disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "A descriptive, correlation design used a purposive sample of 68 adolescents with sickle cell disease. Three questionnaires were used to collect the data: Pain Beliefs and Perceptions Inventory (PBPI), Coping Strategies Questionnaire (CQS), and a demographic questionnaire. Correlation and multiple regression were used to analyze the data."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Appraisal factors positively correlated with coping strategies and adjustment. Multiple regression found that appraisal of the event as catastrophic predicted the reinterpretation of pain sensations (p < .001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Adolescents with more negative thoughts during vaso-occlusion crisis used ineffective coping strategies and reported poorer adjustment."
        }
      ]},
