      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To assess the value of multidetector computed tomography (MDCT) in the non-invasive evaluation of stents."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We studied 88 patients (142 stents): 48 with 1.2-mm MDCT, 40 with 0.6-mm MDCT considering accuracy in assessing the vessel lumen, stent patency and intra-stent restenosis. Coronary angiography comprised the gold standard."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Occlusion was detected, respectively, in three of 72 versus four of 70 cases. Patency was assessed in all cases. In-stent restenosis was diagnosed in two of eight cases with thin-slice MDCT."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "0.6-mm MDCT allows a better visualization of stent lumen and in-stent restenosis versus 1.2-mm MDCT."
        }
      ]},
