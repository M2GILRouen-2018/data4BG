      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 by the American Occupational Therapy Association, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We evaluated factors contributing to activity limitations in people with rheumatoid arthritis (RA) according to the International Classification of Functioning, Disability and Health model."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "In a cross-sectional study, we measured five activity constructs in 81 people with RA."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Multiple regression analysis revealed the following results for the five constructs: (1) RA Activities (R² = .512) included handgrip strength, range of motion deficit, deformity, and mental health; (2) Upper-Limb Activities (R² = .473) included time since diagnosis, dexterity, handgrip strength, and range of motion deficit; (3) Timed Activities (R² = .320) included dexterity and work activities; (4) Physical Autonomy Activities (R² = .562) included range of motion deficit, vitality, pain, and functional classification; and (5) Physical Conditions for Activities (R² = .416) included functional classification and vitality."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Factors most associated with activity limitations were handgrip strength and hand range of motion deficits. Activity limitations in people with RA are multifactorial."
          }
        ]
      },
