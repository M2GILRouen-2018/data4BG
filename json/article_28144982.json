      "Abstract": {
        "CopyrightInformation": "Published 2017. This article is a U.S. Government work and is in the public domain in the USA.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine sex and age distributions in neuroleptic malignant syndrome (NMS) patients based on a systematic literature review."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "EMBASE and PubMed databases were searched to identify any observation of NMS published from January 1, 1998 through November 1, 2014 that was accessible and interpretable (using language translation software). Redundant and equivocal reports were excluded. Sex ratio and age distributions were examined using standard graphical techniques and measures of association."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Twenty-eight independent sex ratio estimates were included. Males predominated in most (75%) estimates with an overall median sex ratio of 1.47 (95% CI, 1.20-1.80). NMS incidence peaked at age 20-25 years and declined steadily thereafter, with males consistently outnumbering females at all but the oldest age intervals."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "NMS patients are 50% more likely to be males, and NMS is most likely to occur in young adulthood."
          }
        ]
      },
