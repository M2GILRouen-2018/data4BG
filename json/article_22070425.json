      "Abstract": {
        "CopyrightInformation": "© 2011 John Wiley & Sons A/S.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PROBLEM",
            "content": "Our study aimed to assess in vitro production of IL-10, IL-6, TNF-A, and adiponectin serum levels in pregnant women with and without gestational diabetes mellitus (GDM) and to investigate a possible association between GDM and IL-10-1082 A>G (rs1800896), IL-6-174 G>C (rs1800795), TNF-A-308 G>A (rs1800629), adiponectin +45 T>G (rs2241766), and adiponectin-11377 C>G (rs266729) gene polymorphisms."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD OF STUDY",
            "content": "This case-control study included 79 women with GDM and 169 healthy controls (C) grouped according to pre-pregnancy BMI. IL-10, IL-6, and TNF-A culture supernatant and adiponectin serum levels were assessed by ELISA. DNA genotype was performed by PCR-RFLP."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Adiponectin levels were significantly higher in C than GDM women, even within the same BMI category. Cytokines levels were similar between the groups. There were no associations between GDM and the analyzed gene polymorphisms."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Women with GDM have significantly lower adiponectin levels in the third trimester, regardless of BMI."
          }
        ]
      },
