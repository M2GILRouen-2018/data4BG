      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine associations between television viewing, sugar-sweetened beverage consumption, eating out, physical activity, and body weight change over 1 year."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Secondary data analysis from randomized intervention trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Households in the community."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Adults (n = 153) and adolescents (n = 72) from the same households."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Households were randomized to a home-based obesity prevention intervention or to a no-intervention control group for a 1-year period."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Self-reported television viewing (TV) hours, diet, and physical activity. Body mass index (BMI) computed from measured weight and height (primary outcome measure)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Mixed-model regression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Among adolescents, a significant prospective association was observed between decreases in television viewing hours and lower BMI z score at 1-year follow-up (decreased TV hours: BMI z score mean = 0.65; no change or increase TV hours: BMI z score = 0.92; P < .02). No significant prospective associations were observed among adults."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Reducing television viewing may be an effective strategy to prevent excess weight gain among adolescents."
          }
        ]
      },
