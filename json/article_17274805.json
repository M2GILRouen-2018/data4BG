      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To evaluate the association between caesarean section and risk of developing asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "We evaluated this association in a Danish cohort, comprising of 11,147 mothers and their babies of which 7119 mother-child pairs were included in the analyses. The mothers' reported asthma data on their children were linked to hospitalization records on mode of delivery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The adjusted odds ratio for developing asthma was 1.11 (95% CI, 0.88-1.39) for caesarean sections versus vaginal births."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "We found no evidence that children being delivered by caesarean section have an increased risk of asthma."
        }
      ]},
