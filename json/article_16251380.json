      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To describe the latent period for symptomatic sensitization in bread bakery workers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Data on the latent period for symptomatic sensitization, resulting in either asthma or rhinitis, were obtained from an in-house health surveillance programme in a single large organization."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Over a period of 10 years, 90 employees were identified with symptoms attributable to sensitization. The mean latent period was 7.3 years, with three employees describing the onset of symptoms in their first year of exposure."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The long latent period, typically more than 1 year, suggests that health surveillance on appointment and then at annual intervals thereafter should be adequate to identify affected individuals in a bakery environment."
        }
      ]},
