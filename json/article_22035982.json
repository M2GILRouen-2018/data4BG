      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Stress and heart failure are associated with increased systemic levels of chromogranin A (CGA). Here we analyzed the effects of marathon running on systemic CGA levels and the association with cardiac burden and stress."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We recruited 47 lean and obese runners for a 10week training program aiming at running a marathon. Heart rates, individual fitness and marathon finishing times were monitored. CGA, proBNP and troponin T levels were analyzed by ELISA."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We found a significant increase of CGA (+51%; p<0.01) in lean runners after marathon. The obese group showed the highest troponin T (0.22ng/ml; p<0.01) and proBNP (176.6ng/ml; p<0.01) levels. There were no correlations between proBNP, troponin T and CGA. An inverse correlation (r=-0.45; p<0.01) was found between CGA and finishing times."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Marathon running is associated with increased CGA levels. However, this does not seem to reflect cardiac burden but rather marathon induced stress."
          }
        ]
      },
