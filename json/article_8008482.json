      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To explore perceptions of pain and pain management by nurses and physicians who care for pediatric emergency room patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "A descriptive survey design using the Adapted Klein Premedication Questionnaire explored the attitudes and practices of 24 nurses and 21 physicians about children's pain in the emergency setting."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The majority of nurses and physicians who care for pediatric emergency room patients would medicate children experiencing pain. Both groups perceived pain in children the same way. There was a lack of knowledge in both groups regarding the appropriate dosages of pain medications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Nurses and physicians need a stronger knowledge base regarding pain management practices."
        }
      ]},
