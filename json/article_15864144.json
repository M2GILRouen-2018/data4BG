      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of ossification of the posterior atlantoaxial membrane (PAAM) and ossification of the transverse ligament of the atlas (TAL)."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Ossification of the PAAM and TAL are both very rare clinical entities. This is the first case involving ossification of both the PAAM and TAL with the development of cervical myelopathy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Patient's history, physical examination, radiographic evaluation, surgical treatment, and outcome are examined. Relevant literature is also reviewed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The patient's neurological symptoms significantly improved after posterior decompressive surgery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Ossification of various parts of the spinal ligament have been reported previously. Among them, ossification of both the PAAM and TAL has never been reported previously and is thus extremely rare. Surgical intervention improved the neurological impairment."
        }
      ]},
