      "Abstract": {
        "CopyrightInformation": "© 2015 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Psoriasis is frequently associated with obesity which possibly contributes to reduced treatment response."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Assessment of the prevalence of obesity in patients with psoriasis in Germany 2013/2014."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "The frequency of overweight and obesity was assessed by the body mass index (BMI) and evaluated according to the severity of psoriasis [Psoriasis Area and Severity Index (PASI)]."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "This national, cross-sectional survey involved 83 dermatological practices and outpatient clinics, including 1,265 patients (mean age 52 years; 43.4% female). The BMI of patients with psoriasis in 2013/2014 was found to be 28.0 and therefore was significantly higher compared to that of patients with psoriasis in 2007 with a BMI of 26.9 as well as compared to the normal population in 2013 with an overall BMI of 25.9."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The prevalence of obesity in patients with psoriasis is higher than in the normal population. The trend towards a higher BMI in patients with psoriasis continues over time."
          }
        ]
      },
