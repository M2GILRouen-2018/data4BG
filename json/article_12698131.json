      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case of chronic low back pain caused by a glomus tumor that persisted more than 30 years is presented."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To emphasize the need to consider skin tumors in the differential diagnosis of low back pain."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Chronic low back pain can be caused by a myriad of factors. There are six relatively common skin tumors, which present as painful lesions. As seen in the reported case, if they occur in the lumbar region, they can cause low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A subject with low back pain underwent an excision biopsy of a localized area of tenderness where his symptoms were reproduced when light pressure was applied."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Histology confirmed that a glomus tumor accounted for the subject's pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Painful skin tumors may cause low back pain and need to be considered in the differential diagnosis of chronic low back pain."
        }
      ]},
