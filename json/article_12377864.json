      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine if topical 4% amethocaine gel can reduce the pain associated with arterial punctures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, placebo-controlled, double-blinded trial with parallel groups."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Adults requiring arterial punctures for blood gas estimation as part of routine care."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Four percent amethocaine gel applied for 30 min prior to the radial arterial puncture, compared with a placebo gel."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Pain scored on a visual analog scale from 0 to 100, and heart rate during the procedure."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The mean pain score for the amethocaine group was 16.0 (SD, 23.3) and for the placebo group was 20.7 (SD, 18.5). The mean heart rates during arterial puncture were 84.1 beats/min (SD, 10.7) for the amethocaine group, and 83.8 beats/min (SD, 12.7) for the placebo group. These differences were not statistically significant."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The topical use of 4% amethocaine gel does not reduce the pain associated with arterial puncture."
        }
      ]},
