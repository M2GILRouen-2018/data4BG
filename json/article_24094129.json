      "Abstract": {
        "CopyrightInformation": "© 2013, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose was to understand how African American children with asthma and their families living in underserved urban areas experience and perceive asthma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "A narrative inquiry design with metaphorical analysis was used in this study with 20 African American children and their 10 families."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Participants metaphorically viewed the family system as a functioning healthcare facility. Children didn't find their asthma abnormal but did use asthma symptoms to their advantage. Caregivers were viewed as first-line medical responders but often made errors in delivering medical treatment. Lack of knowledge relating to appropriate asthma interventions led to insufficient asthma care."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Results provide evidence to improve patient-nurse interactions for this vulnerable patient group."
          }
        ]
      },
