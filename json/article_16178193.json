      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the status of the temporomandibular joint (TMJ) in patients with complaints of joint pain for improving clinical therapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Twenty three joints in twenty patients who complained of TMJ pain were examined radiographically and arthroscopically."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were at least one and more to six pathological changes could be found arthroscopically in the 23 temporomandibular joints, which were different in some respects with radiographic findings."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "TMJ related pain may be associated with pathological alterations in the TMJ, and synovitis may be one of the causes of TMJ pain."
        }
      ]},
