      "Abstract": {
        "CopyrightInformation": "© Veterinary Emergency and Critical Care Society 2017.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe the clinical course, treatment, and outcome of 5 dogs following ingestion of mushrooms belonging to the Inocybe genus."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "CASE SERIES SUMMARY",
            "content": "Five dogs with witnessed Inocybe ingestions were presented with clinical signs compatible with poisoning. Vomiting, ptyalism, diarrhea, depression, and tachycardia were common clinical findings in the dogs in this case series. The prognosis with Inocybe toxicosis appears to be excellent as all dogs fully recovered following supportive care."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "NEW OR UNIQUE INFORMATION PROVIDED",
            "content": "This is the first reported case series of Inocybe mushroom ingestions in dogs where identification of the mushrooms were confirmed by an expert mycologist."
          }
        ]
      },
