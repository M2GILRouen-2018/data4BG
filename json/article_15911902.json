      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The International Verapamil/Trandolapril Study (INVEST) demonstrated comparable efficacy between verapamil SR and atenolol antihypertensive treatment strategies for clinical outcomes and blood pressure (BP) control in hypertensive patients with coronary artery disease (N = 22,576). Effects of these antihypertension strategies on mood-related issues are not well understood."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The objectives of this study were 1) to compare depressive symptoms by strategy and 2) to identify predictors of depressive symptoms in INVEST patients after 1 year of follow up."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN, SETTING, AND PATIENTS",
          "content": "Depressive symptoms were assessed in a subset (N = 2317) of consecutively randomized U.S. patients enrolled between April 1, 1999, and October 31, 1999. Patients were mailed surveys after randomization and after 1 year of treatment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Patients were assigned to either a verapamil SR or atenolol strategy to achieve Joint National Committee on Prevention, Detection, Evaluation, and Treatment of High Blood Pressure BP goals. Trandolapril and/or hydrochlorothiazide were recommended as add-on agents."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Depressive symptoms were measured by the Center for Epidemiologic Studies-Depression (CES-D) scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "CES-D scores improved 1.45 points (p < .001) after 1 year in patients assigned to the verapamil SR strategy, whereas a nonsignificant improvement was observed in patients assigned to the atenolol strategy (0.27 points, p = .44). Predictors of higher depressive symptoms were higher baseline CES-D score (p < .001), history of depression diagnosis (p = .03), history of stroke (p < .001), and assignment to the atenolol strategy (p < .001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A verapamil SR strategy is a viable alternative to beta-blocker therapy for hypertensive patients with coronary artery disease, especially those at risk of depression."
        }
      ]},
