      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 AAGL. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To explore the feasibility and effectiveness of a modified posterior vaginal mesh suspension method in treating female rectocele with intractable constipation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Descriptive study (Canadian Task Force classification II-3)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "The study was performed in the Study Center for Female Pelvic Dysfunction Disease, Department of Obstetrics and Gynecology, Tongji Hospital, Tongji University School of Medicine, Shanghai, China. The Study Center includes 15 physicians, most of whom have received advanced training in pelvic floor dysfunctional disease and can skillfully perform many types of operations in patients with such disease. Almost 1500 operations to treat pelvic floor dysfunctional disease are performed every year at the center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Thirty-six women with rectocele with intractable constipation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Posterior vaginal mesh suspension."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "All patients were followed up for 15 to 36 months. In 29 patients, the condition was cured completely; in 5 patients it had improved; and in 2 patients, the intervention had no effect. Insofar as recovery and improved results, the overall effectiveness rate was 94.4%."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Posterior vaginal mesh suspension is an effective, harmless, and convenient method for treatment of female rectocele with intractable constipation. It has positive short-term curative effects, with few complications and sequelae. However, the long-term effects of posterior vaginal mesh suspension should be evaluated."
          }
        ]
      },
