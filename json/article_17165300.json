      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The aim of this study was to identify the effects of tooth wear on patients' quality of life and satisfaction with their dentition."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Seventy-six tooth wear patients and 76 control subjects were recruited for the study. A Dental Impact on Daily Living questionnaire was used to assess the affect of tooth wear on daily living and satisfaction with the dentition. An ordinal scale was used to assess the severity of tooth wear in a patient cohort."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The results showed that tooth wear has a measurable impact on patients' satisfaction with their appearance, pain levels, oral comfort, general performance, and chewing and eating capacity (P < .001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Tooth wear has an impact on patients' satisfaction with their dentition regardless of tooth wear severity or personal factors."
        }
      ]},
