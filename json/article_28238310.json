      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To describe the social characteristics of women seeking a medical abortion, and the conditions of that abortion, according to whether they had one or more previous induced abortions."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "An observational study was carried out in 11 French units in 2013-2014, among women 18 years or older. A self-administered questionnaire on the abortion context and social situation was given to them, as well as a diary to record the pain level for each of five days following the mifepristone intake. The sample included 453 women."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Among the respondents, 22% had had one previous abortion and 8% had had two or more. Women having had a previous voluntary abortion were more often isolated and in a poorer social situation than women having their first abortion."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Better support for contraception after abortion could reduce the number of repeated abortions."
          }
        ]
      },
