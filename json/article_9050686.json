      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To compare the classic intrafascial Semm hysterectomy (CISH) with abdominal hysterectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective analysis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Community hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "The first 100 women with intractable uterine bleeding, leiomyomata, and chronic pelvic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "The CISH procedure, initially with the Endo GIA stapler, but later, electrocoagulation and suture to lower costs and eliminate automatic staple complications."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Operating time for CISH decreased and our ability to remove larger uteri increased as we became more proficient. Complications were limited to one cystotomy and four transfusions. The average hospital stay was 36 hours and most patients were back to normal activity in 3 weeks."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Our experience suggests that the CISH is organ preserving, is minimally invasive, decreases recovery time, and can be performed in women in whom an open abdominal approach once would have been the only option."
        }
      ]},
