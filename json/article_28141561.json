      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate and compare the efficiency of general and disease-specific life quality scales in children with asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Children with asthma, and their parents completed the Childhood Asthma Control Test (C-ACT), Pediatric Asthma Quality of Life Questionnaire (PAQLQ), Pediatric Quality of Life Inventory (PedsQL), and also underwent spirometry."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "82 children (55 males) with a median (IQR) age of 10.1 (8.9-10.5) years were included. C-ACT, PAQLQ and PedsQL child scores were significantly higher in children with controlled asthma."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Quality of life in children, assessed using disease- specific quality of life measures, is better for children with good asthma control."
        }
      ]},
