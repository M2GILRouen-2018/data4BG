      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Obesity is associated with poor asthma outcomes; weight loss improves such outcomes. Inaccurate recognition of obesity may impede weight control."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "We examined perception of weight by early adolescents with uncontrolled asthma and their caregivers, and tested the relationship between medical visit frequency and accuracy of perceived weight status."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 373 adolescents and their caregivers reported the adolescent's height/weight and weight perception; caregivers reported healthcare utilization. We measured height/weight. Logistic regression modeled accuracy of weight perception."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 43.7 % of the overweight/obese adolescents and caregivers accurately perceived weight status. BMI percentile [odds ratio (OR) = 1.19, confidence interval (CI) = 1.10-1.28] and total medical visits (OR = 1.18, CI = 1.05-1.33) were associated with higher accuracy in caregivers. Total medical visits (OR = 0.84, CI = 0.74-0.96) was associated with lower accuracy in adolescents."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Accurate perception of weight status was poor for overweight adolescents with uncontrolled asthma and their caregivers. Frequent medical visits were associated with improved caregivers' but not adolescents' perceptions."
        }
      ]},
