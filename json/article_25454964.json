      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Emotional stability is important for individual and team performance during operating room (OR) emergencies. We compared physiologic and psychological anxiety assessments in OR teams during simulated events."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twenty-two teams participated in a \"cannot intubate/cannot ventilate\" simulation. Participants completed the State-Trait Anxiety Inventory and wore a galvanic skin response (GSR) sensor. Differences in State-Trait Anxiety Inventory scores and GSR levels were analyzed. Anxiety scores were correlated with GSR levels."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Resident physicians had significantly higher trait anxiety than the nurses, certified registered nurse anesthetists, and surgical technicians (43.9 ± 9.9 vs 38.3 ± 9.3, P < .01). Senior practitioners had significantly higher trait anxiety than junior practitioners (43.7 ± 9.6 vs 40.0 ± 9.9, P = .03). All groups showed significant increases in GSR. Psychological and physiologic data did not correlate."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Senior practitioners and residents have higher levels of baseline trait anxiety for unclear reasons. Also, OR team training results in physiological signs of anxiety that do not correlate to self-reported psychological measurements."
          }
        ]
      },
