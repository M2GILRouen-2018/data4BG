      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECT",
          "content": "The authors report the results of endoscopic partial laminectomy performed in 10 patients with degenerative cervical compressive myelopathy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Endoscopic partial laminectomy was performed safely in 10 patients with cervical myelopathy. All of the patients experienced symptomatic improvement with slight postoperative wound pain. The mean operative duration was 164+/-35 minutes and the mean intraoperative blood loss was 45.5+/-27 ml."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Endoscopic partial laminectomy may be used as a minimally invasive alternative for the treatment of cervical compressive myelopathy."
        }
      ]},
