      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American College of Allergy, Asthma & Immunology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Administration of subcutaneous immunoglobulin (SCIG) via rapid push, an alternative to infusion pump delivery, can offer heightened simplicity and convenience for patients with primary immunodeficiency disease (PIDD)."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess dosing and administration patterns, serum IgG responses, safety, and tolerability of the subcutaneous (SC) rapid push technique."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A retrospective medical record review captured data on 173 patients with PIDD (1,140 follow-up visits) who self-administered SCIG (16% or 20%) via infusion pump or SC rapid push."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Serum IgG levels increased from a mean (SD) trough of 903.8 (285.4) mg/dL during intravenous immunoglobulin use to a steady-state mean (SD) of 1,121.6 (257.6) mg/dL on SCIG. Mean frequency of weekly SCIG administration was 2.3 days per week with pump and 2.8 days per week with SC rapid push. Mean serum IgG levels were higher among push vs pump users (1,164 vs 1,048 mg/dL). Mean (SD) SCIG volume administered per infusion site with SC rapid push was 15.0 (7.3) mL (maximum, 60.0 mL). Most patients using SC rapid push infused in 9 minutes or less; median pump infusion duration was 49 minutes. Use of 20% SCIG was associated with smaller mean weekly product volumes vs 16% SCIG (41.7 vs 51.0 mL) and fewer mean dosing days per week (2.0 vs 2.8 days). Adverse events, primarily local, were reported on fewer visits with SC rapid push (15.6%) than with infusion pump (20.7%)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The SC rapid push technique is a safe, viable alternative to an infusion pump, seemingly preferred by patients and offering more rapid administration."
          }
        ]
      },
