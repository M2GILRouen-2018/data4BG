      "Abstract": {
        "CopyrightInformation": "© 2015 The Authors Pain and Medicine Published by Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The cost of caring for patients with chronic pain conditions poses a significant burden to both the healthcare system and patients. We were interested in analyzing the financial costs and benefits of treating these patients in a comprehensive outpatient pain rehabilitation program."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "All participants completed the 3-week outpatient Mayo Clinic Florida Pain Rehabilitation Program (PRC) between October 2011 and September 2013. Healthcare costs were compared during the 3-, 6-, 12-, and 18-month periods pre- and post-treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "The sample included 53 patients."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Medical costs decreased by 86, 68, 64, and 90% in the 3-, 6-, 12-, and 18-month post-treatment periods, respectively, when compared with the same pretreatment periods."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The appropriate use of a comprehensive outpatient rehabilitation program for chronic pain patients can result in a significant reduction in medical costs."
          }
        ]
      },
