      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the left atrial appendage (LAA) function and potential for embolization in severe mitral stenosis (MS)."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Patients with MS and atrial fibrillation or in sinus rhythm develop systemic emboli. LAA function has not been well studied in sinus rhythm."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Forty consecutive patients with MS (valve area < or =0.7 cm2/m2) were studied. LAA ejection fraction and peak emptying velocity were measured along with other data."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients were subgrouped according to LAA Doppler flow pattern. Group I (n=13) in sinus rhythm had biphasic high velocity > or =25 cm/s. Group II (n=13) in sinus rhythm had biphasic low velocity <25 cm/s. Group III (n=14) in atrial fibrillation had multiphasic irregular flow <25 cm/s or no definite flow. The LAA ejection fraction and peak emptying velocity were strikingly different in all groups. They were lower in group II when compared to group I. Group II had intermediate risk for thromboembolism compared to Group I and III as judged by systemic embolization, spontaneous echo contrast, thrombus in left atrium and LAA."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A subset of mitral stenosis in sinus rhythm at increased risk of embolization can be suspected by Doppler transesophageal echocardiographic LAA flow profile."
        }
      ]},
