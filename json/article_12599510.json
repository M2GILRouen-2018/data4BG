      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To identify nursing diagnoses, interventions, and outcomes used with patients undergoing abdominal surgery, and the links among them."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A review of the nursing records of 60 patients undergoing abdominal surgery. Three checklists developed by the researchers were used to document nursing diagnoses made, interventions specified, and outcomes selected."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Pain was the most frequent diagnosis, \"pain management\" the most frequent intervention, and Pain Level the most frequent outcome. Further study is needed with various samples and settings."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Most of the suggested NIC-NANDA interventions and NOC-NANDA outcomes listed in NANDA Nursing Diagnoses: Definitions and Classification, 1999-2000, were used in this study, but some additional interventions and outcomes should be considered for inclusion."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "PRACTICE IMPLICATIONS",
          "content": "This study provides a framework for documenting nurses' work; the results of the study can promote more rapid computerization of nursing records."
        }
      ]},
