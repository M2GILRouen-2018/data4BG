      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Both the potential analgesic effects and side-effects of topical diclofenac sodium 0.1% are points of interest after excimer laser phototherapeutic keratectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Excimer laser phototherapeutic keratectomy was performed in 134 eyes of 134 patients. In 65 eyes (65 patients), the effects of topical diclofenac given three times a day for 3 to 4 days were compared to a control group of 69 eyes (69 patients). All patients received paracetamol for systemic analgesia and were patched after surgery until reepithelialization."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Twenty-eight patients (43%) of the diclofenac group needed additional systemic analgesics compared to 67 patients (95%) in the control group. Seventy-two hours after surgery we found no significant differences in corneal epithelial wound healing and no severe complications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Topical diclofenac sodium reduces postoperative pain in patients after phototherapeutic keratectomy."
        }
      ]},
