      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To estimate the prevalence of medically unexplained symptoms in patients who most frequently attend outpatient services."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective cohort study over three years with review of case notes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Secondary care services in the South Thames (West) NHS region."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Outpatient attenders with new appointments in 1993."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Number of outpatient appointments, and number of consultation episodes for medically unexplained conditions."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Medical records of 361 of 400 sampled frequent attenders were examined, and 971 consultation episodes were recorded. Ninety seven (27%) had one or more consultation episodes in which the condition was medically unexplained; 208 (21%) of the 971 consultation episodes were medically unexplained. Abdominal pain, chest pain, headache, and back pain were commonly found to be medically unexplained."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Medically unexplained symptoms present in most hospital specialties and account for a considerable proportion of consultations by frequent attenders in secondary care."
        }
      ]},
