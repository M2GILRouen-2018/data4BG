      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 IMSS. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND AIMS",
            "content": "Malnutrition has been identified as a prognostic factor in children and adolescents with leukemia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A review of the data available on this topic has been carried out."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "RESULTS AND CONCLUSIONS",
            "content": "In children and adolescents (0-19 years of age), acute lymphoblastic leukemia (ALL) is the commonest form of cancer worldwide and malnutrition is prevalent in this age group, especially in low- and middle-income countries where most of these young people live. Obesity, measured by body mass index, is associated with poorer survival rates in children and adolescents with ALL and acute myelogenous leukemia in high-income countries. In contrast, undernutrition is linked to poorer survival rates among young people with leukemia in low- and middle-income countries."
          }
        ]
      },
