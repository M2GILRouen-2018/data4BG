      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To study the clinical efficacy of modified percutaneous vertebroplasty (PVP) in the treatment of painful old osteoporosis vertebral compression fractures (OVCF)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "From April 2007 to October 2009, 16 cases (23 vertebrae) of symptomic old OVCF were treated with a modified PVP. Before operation, all the patients were examined by standing anteroposterior and lateral X-Ray and MRI. The pain level of each patient was assessed before operation and 1 week, 6, 12 months after the operation using visual analogue scale (VAS) and Oswestry disability index (ODI). The middle line vertebral body height and local sagittal Cobb's angle were also measured."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Postoperative average VAS, Oswestry disability index (ODI), the local sagittal Cobb's angle decreased from 7.8, 72.3%, and 38.2° to 3.1, 26.8%, and 21.5° respectively before and after surgery (p<0.05). The mean midline vertebral height increased from 13.8mm to 26.6mm before and after surgery (p<0.05). There was no infection, nerve injury, pulmonary embolism, or death after operation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The modified PVP can increase the space for bone cement filling and is good for the restoration of vertebral body height. It is an optimal procedure for the treatment of painful old OVCF."
          }
        ]
      },
