      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Diabetes India. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The relationship between cardio-ankle vascular index (CAVI) and components of metabolic syndrome (MetS), in addition to age and sex as confounders was explored to verify the characteristics of CAVI."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A cross-sectional study was conducted for 144 subjects (108 males and 36 females), aged 31-86 years, who were inhabitants undergoing intensive health checkups. Multiple logistic regression analysis was performed to analyze the association."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "MetS was present in 36 of 108 males (33%) and 13 of 36 females (36%). Significant association between CAVI≥9 and male subjects or age was recognized. Although five metabolic components did not show any significant association with CAVI≥9, there was a trend of positive association between CAVI and BMI<25 (p=0.060), high blood pressure (p=0.074) or hypertriglyceridemia (p=0.088)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Male and age were significantly associated with CAVI≥9. Further study is needed to verify the association between CAVI≥9 and MetS components."
          }
        ]
      },
