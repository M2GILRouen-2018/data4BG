      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Nurses' modifiable lifestyles have important health-related consequences."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To examine the literature on U.S. hospital nurses' activity, diet, and health outcomes of cardiovascular disease (CVD) risks and health-related quality of life (HRQOL)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A systematic review using of the literature from June 2006 to June 2016 resulted in 13 studies on U.S. hospital nurses' diet, physical activity and CVD and HRQOL outcomes. Methodological rigor was assessed using Cummings et al., adapted quality rating tool."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Nurses are at risk for poor health outcomes due to inadequate physical activity (60%-74%) and eating a poor quality diet (53%-61%). Fewer than 5% of U.S. nurses engage in five healthy lifestyle behaviors (diet, activity, no tobacco, alcohol, and weight). Adequate physical activity contributes to better HRQOL and a healthy diet reduces CVD risks (hypertension, diabetes mellitus, obesity, stroke)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Nurses' inactivity and poor diet increases risks for CVD and diminished HRQOL."
          }
        ]
      },
