      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To characterize the ability of patients with symptomatic knee osteoarthritis (OA) to perform a weight-bearing activity compatible with upright magnetic resonance imaging (MRI) scanning and how this ability is affected by knee pain symptoms and flexion angles."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional observational study assessing effects of knee flexion angle, pain level, and study sequence on accuracy and duration of performing a task used in weight-bearing MRI evaluation. Visual feedback of knee position from an MRI compatible sensor was provided. Pain levels were self-reported on a standardized scale."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Simulated MRI setup in a research laboratory."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Convenience sample of individuals (N=14; 9 women, 5 men; mean, 69±14y) with symptomatic knee OA."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Not applicable."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Averaged absolute and signed angle error from target knee flexion for each minute of trial and duration tolerance (the duration that subjects maintained position within a prescribed error threshold)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Absolute targeting error increased at longer trial durations (P<.001). Duration tolerance decreased with increasing pain (mean ± SE, no pain: 3min 19s±11s; severe pain: 1min 49s±23s; P=.008). Study sequence affected duration tolerance (first knee: 3min 5s±9.1s; second knee: 2min 19s±9.7s; P=.015)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The study provided evidence that weight-bearing MRI evaluations based on imaging protocols in the range of 2 to 3 minutes are compatible with patients reporting mild to moderate knee OA-related pain."
          }
        ]
      },
