      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 North American Society for Pediatric and Adolescent Gynecology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To determine the SCUBE1 levels in adolescents with primary dysmenorrhea."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A prospective cross-sectional study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "A university hospital outpatient clinic, Rize, Turkey."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "A total of 40 adolescent girls, 15 on menses and 25 not on menses."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS AND MAIN OUTCOME MEASURES",
            "content": "Demographic features and menstrual history of the participants were assessed and blood samples were obtained for detecting the platelet volume, platelet counts, and SCUBE1 levels of the participants."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No difference was detected between the 2 groups in mean platelet volume, platelet count, and SCUBE1 levels."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Future trials are required to investigate the relation between SCUBE1 levels and primary dysmenorrhea."
          }
        ]
      },
