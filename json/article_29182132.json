      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The aim of this study was to observe if the re-fracture rate after forearm both bones was decreased by protecting the forearm with a preventive brace for 6 months following the fracture and by ceasing all physical activities."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We performed a retrospective study in 75 consecutive cases of diaphyseal fracture of both bone of forearms, in 52 boys and 23 girls aged from 6 months to 11 years. It concerned a first episode of fracture in 84% of cases and a re-fracture in 17%."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Re-fracture rate was 0% in the group where a protective brace was worn while it was 20% in the group without brace."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Both the wearing of a protective brace and absence of sport for 6 months may decrease the re-fracture rate to 0%, if the patient is compliant by wearing it and by ceasing all physical activities."
        }
      ]},
