      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Premenstrual syndrome (PMS) is a common finding in luteal phase of menstrual cycle resulting in several changes in woman life including pain sensation."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "This study evaluated the alterations of postoperative pain sensation in those with and without a history of PMS."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "A total of 140 women in in postoperative period were assigned to four groups regarding luteal or follicular phase of menstrual cycle and the history of PMS and were evaluated regarding scale of pain sensation and morphine demand in recovery room. To evaluate the difference among the groups, Mann Whitney U, Kruskal-Wallis, and Bonferroni tests were used."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients with PMS presented higher pain sensation and analgesia request (P = 0.003). Patients in luteal phase showed less pain and analgesia request in two out of five studied outcomes (P = 0.075)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The most comfortable postoperative women were those in luteal phase without history of PMS group."
        }
      ]},
