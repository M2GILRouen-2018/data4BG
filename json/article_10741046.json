      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Typical angina pectoris is easy to recognize, but coronary insufficiency may present with nonspecific chest discomfort."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS OF STUDY",
          "content": "We wanted to investigate long-term prognosis in men with different types of chest pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A random population sample comprising 5,773 men aged 51-57 years at baseline were followed for 16 years."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Mortality due to coronary heart disease was 8.0% among men without chest pain, 19.5% (total mortality 44%) among those with non-specific chest pain, 24.8% (total mortality 45%) among those with typical angina and 48.5% among those with a history of myocardial infarction at baseline."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Non-specific chest pain is associated with poor prognosis, and coronary risk factors have strong predictive value."
        }
      ]},
