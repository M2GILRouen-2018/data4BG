      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "This study aimed to investigate the effect of adjusting pulse amplitude of transcutaneous electrical nerve stimulation versus fixed pulse amplitude in treatment of chronic mechanical low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "El-sahel Teaching Hospital, Egypt."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Forty-five patients with chronic low back pain assigned to three equal groups. Their ages ranged from 20 to 50 years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "The three groups received the same exercise program. Group A received transcutaneous electrical nerve stimulation with fixed pulse amplitude for 40 minutes. Group B received transcutaneous electrical nerve stimulation with adjusted pulse amplitude for 40 minutes, with the pulse amplitude adjusted every 5 minutes. Group C received exercises only. Treatment sessions were applied three times per week for 4 weeks for the three groups."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "A visual analogue scale was used to assess pain severity, the Oswestry Disability Index was used to assess functional level, and a dual inclinometer was used to measure lumbar range of motion. Evaluations were performed before and after treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Visual analogue scale, Oswestry Disability Index, and back range of motion significantly differed between the two groups that received transcutaneous electrical nerve stimulation and the control group and did not significantly differ between fixed and adjusted pulse amplitude of transcutaneous electrical nerve stimulation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Adjusting pulse amplitude of transcutaneous electrical nerve stimulation does not produce a difference in the effect of transcutaneous electrical nerve stimulation used to treat chronic low back pain."
        }
      ]},
