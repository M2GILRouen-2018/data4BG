      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe the patterns of use of cardiac rehabilitation in Victoria and to assess whether the survival benefits predicted in clinical trials have been realised in the community."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cohort study based on data linkage."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "All patients admitted for acute myocardial infarction (AMI), coronary artery bypass grafting (CABG) or percutaneous transluminal coronary angioplasty (PTCA) in Victoria in 1998 (n = 12821)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Attendance at one of 66 participating outpatient cardiac rehabilitation centres in Victoria."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Rates of attendance at rehabilitation based on key factors such as diagnosis, age, sex, and comorbidity. Five-year survival for attendees compared with non-attendees."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Rates of participation in rehabilitation were 15% for AMI, 37% for CABG, and 14% for PTCA. Rehabilitation attendance rates dropped sharply after 70 years of age. Attendees had a 35% improvement in 5-year survival (hazard ratio for death associated with rehabilitation attendance, 0.65 [95% CI, 0.56-0.75])."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Attendance rates at cardiac rehabilitation are suboptimal, even though attendance confers a clinically significant difference in 5-year survival. The elderly, women, and those with comorbid conditions may benefit measurably from increased rates of attendance."
        }
      ]},
