      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "This article discusses the real-life experience of two senior registrars who are approaching the end of their training under the 2012 Competency Based Fellowship Program. We have shared some practical tips to assist trainees in completing the Program, with particular emphasis on examination preparation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Whilst stressful at times, we believe that going through the Competency Based Fellowship Program has helped us build our knowledge, skills base, and expertise for practising psychiatry as consultants."
        }
      ]},
