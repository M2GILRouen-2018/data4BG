      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Academy of Allergy, Asthma & Immunology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Chitinases have recently gained attention in the field of pulmonary diseases, particularly in asthma and chronic obstructive pulmonary disease, but their potential role in patients with cystic fibrosis (CF)-associated lung disease remains unclear."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to assess chitinase activity systemically and in the airways of patients with CF and asthma compared with healthy subjects. Additionally, we assessed factors that regulate chitinase activity within the lungs of patients with CF."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Chitinase activities were quantified in serum and bronchoalveolar lavage fluid from patients with CF, asthmatic patients, and healthy control subjects. Mechanistically, the role of CF airway proteases and genetic chitinase deficiency was assessed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Chitinase activity was systemically increased in patients with CF compared with that in healthy control subjects and asthmatic patients. Further stratification showed that chitinase activity was enhanced in patients with CF colonized with Candida albicans compared with that in noncolonized patients. CF proteases degraded chitinases in the airway microenvironment of patients with CF. Genetic chitinase deficiency was associated with C albicans colonization in patients with CF."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Patients with CF have enhanced chitinase activation associated with C albicans colonization. Therefore chitinases might represent a novel biomarker and therapeutic target for CF-associated fungal disease."
          }
        ]
      },
