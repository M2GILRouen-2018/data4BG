      "Abstract": {
        "CopyrightInformation": "© The Author 2016. Published by Oxford University Press. All rights reserved. For Permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "MOTIVATION",
            "content": "Despite the widespread popularity of genome-wide association studies (GWAS) for genetic mapping of complex traits, most existing GWAS methodologies are still limited to the use of static phenotypes measured at a single time point. In this work, we propose a new method for association mapping that considers dynamic phenotypes measured at a sequence of time points. Our approach relies on the use of Time-Varying Group Sparse Additive Models (TV-GroupSpAM) for high-dimensional, functional regression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "This new model detects a sparse set of genomic loci that are associated with trait dynamics, and demonstrates increased statistical power over existing methods. We evaluate our method via experiments on synthetic data and perform a proof-of-concept analysis for detecting single nucleotide polymorphisms associated with two phenotypes used to assess asthma severity: forced vital capacity, a sensitive measure of airway obstruction and bronchodilator response, which measures lung response to bronchodilator drugs."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "AVAILABILITY AND IMPLEMENTATION",
            "content": "Source code for TV-GroupSpAM freely available for download at http://www.cs.cmu.edu/~mmarchet/projects/tv_group_spam, implemented in MATLAB."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CONTACT",
            "content": "epxing@cs.cmu.edu"
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "SUPPLEMENTARY INFORMATION",
            "content": "Supplementary data are available at Bioinformatics online."
          }
