      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To describe the role of outcome expectancy in the use of cognitive-behavioral interventions and to test three variables (history of imagery use, preferred coping style, and perceived credibility of the imagery provider) as predictors of outcome expectancy regarding guided imagery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Secondary analysis using a descriptive, correlational design."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Surgery clinics at a large, midwestern university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "75 women undergoing surgery for gynecologic or breast cancers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Data were collected as part of an ongoing trial of guided imagery. Participants completed measures of outcome expectancy and predictor variables at a preoperative clinic visit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Outcome expectancy regarding a guided imagery intervention, previous history with imagery, preferred coping style, and perceived credibility of the imagery provider."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Significant relationships were demonstrated between previous history of imagery use and outcome expectancy (r = 0.47, p < 0.01) and between perceived credibility of the imagery provider and outcome expectancy (r = 0.45, p < 0.05). Preferred coping style was not related to outcome expectancy in this sample. Psychometric properties of new instruments were satisfactory."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Previous history of imagery use and perceived credibility of the imagery provider were supported as predictors of outcome expectancy. Future research will be necessary to reexamine the predictive role of preferred coping style."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Nurses should be aware of the potential role of outcome expectancy in effectiveness of nursing interventions. Patients' previous use of cognitive-behavioral interventions and perceptions of credibility may be helpful in selecting appropriate strategies."
        }
      ]},
