      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Obese leptin deficient (ob/ob) mice are a model of adiposity that displays increased levels of fat, glucose, and liver lipids. Our hypothesis is that HO-1 overexpression ameliorates fatty liver development."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Obese mice were administered cobalt protoporphyrin (CoPP) and stannic mesoporphyrin (SnMP) for 6 weeks. Heme, HO-1, HO activity, PGC1α, FGF21, glycogen content, and lipogenesis were assessed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "CoPP administration increased hepatic HO-1 protein levels and HO activity, decreased hepatic heme, body weight gain, glucose levels, and resulted in decreased steatosis. Increased levels of HO-1 produced a decrease in lipid droplet size, Fatty acid synthase (FAS) levels involving recruitment of FGF21, PPARα, and Glut 1. These beneficial effects were reversed by inhibition of HO activity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Increased levels of HO-1 and HO activity reduced the levels of obesity by reducing hepatic heme and lipid accumulation. These changes were manifested by decreases in cellular heme, increases in FGF21, glycogen content, and fatty liver. The beneficial effect of HO-1 induction results from an increase in PPARα and FGF21 levels and a decrease in PGC1α, levels they were reversed by SnMP. Low levels of HO-1 and HO activity are responsible for fatty liver."
          }
        ]
      },
