      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the endocrine activity and clinical characteristics of benign ovarian fibro-epithelial tumors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A retrospective analysis was done on 16 cases of benign fibro-epithelial tumor collected from the department of obstetrics and gynecology, Peking Union Medical College Hospital from 1981 to 2000."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The examinations of endocrine activity was measured in 15 cases. Serum estradiol and follicle-stimulating hormone levels in 4 cases, it was (166.5 +/- 83.0) pmol/L and (39.4 +/- 12.6) IU/L respectively; low to moderate level of estrogen influence was observed in 8 cases by vaginal cytology; endometrium proliferation was observed in 10/15 cases by pathological examination."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "CLINICAL MANIFESTATIONS",
          "content": "post-menopausal vaginal bleeding in 10 cases, lower abdominal recessive pain in 3 cases, pelvic mass in all of the 16 cases with both pelvic examination and ultrasonography."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Most of the benign fibro-epithelial tumor have endocrine activity and related clinical manifestations."
        }
      ]},
