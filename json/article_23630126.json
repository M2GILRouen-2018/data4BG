      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "A recently developed parameter, the body adiposity index (BAI)-a composite index based on hip circumference and height-estimates the percentage (%) body adiposity indirectly. The BAI was compared with dual energy X-ray absorptiometer (DEXA)-derived % adiposity to validate the BAI in the local Chinese population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "105 Chinese were recruited and % adiposity estimated by BAI was compared with that derived from DEXA using the Bland Altman plot. A correlation study comparing the BAI with body mass index (BMI) was also done."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "BAI underestimated DEXA-derived % adiposity by a mean of 5.77% with 95% limits of agreement of ±8.4%. When stratified by gender, BMI correlated with DEXA-derived % adiposity better than BAI (r\u2009=\u20090.81 vs. 0.74 for males, P\u2009=\u20090.088, and r\u2009=\u20090.87 vs. 0.82 for females, P\u2009=\u20090.087). Hip circumference and waist circumference also correlated better with the BMI than BAI (r\u2009=\u20090.94 vs. 0.71 for hip circumference, P\u2009<\u20090.001, and r\u2009=\u20090.93 vs. 0.50 for waist circumference, P\u2009<\u20090.001, respectively)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The BAI underestimates DEXA-derived % adiposity in a Chinese population in Singapore and is unlikely to be a better overall index of adiposity than the established BMI."
          }
        ]
      },
