      "Abstract": {
        "CopyrightInformation": "Copyright © 2013. Published by Elsevier B.V.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "We examined correlations between the two asthma assessment tools, pulmonary function tests, and Childhood Asthma Control Test (C-ACT) scores, in 5-11-year-old children with asthma to determine if the C-ACT scores could predict pulmonary function test results."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "A total of 172 children with asthma aged 5-11 years completed C-ACT questionnaires and underwent pulmonary function testing. Correlations between these test results were examined. Patients were also placed into two groups, C-ACT scores ≤19 and >19, to determine if patients with scores >19 had better pulmonary function test results."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Weak correlations were found between pulmonary function test results and childhood asthma control test scores in 5-11-year-old children with asthma, with or without the use of an asthma controller. These correlations included: 0.061 for FEV1 [confidence interval (CI): -0.022-0.049] and 0.074 for MMEF (CI: -0.013-0.037). The proportions of children with C-ACT test scores ≤19 group and those with scores >19 group were not significantly different."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Correlations between C-ACT scores and pulmonary function test results were poor for children aged 5-11 years with asthma. FEV1, FVC, FEF25, FEF50, FEF75, MMEF, and PEFR were not significantly correlated with C-ACT scores."
          }
        ]
      },
