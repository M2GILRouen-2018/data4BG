      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Low-energy shock wave (SW) therapy has improved myocardial ischemia in both a porcine model and in patients with severe angina pectoris."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "METHODS AND RESULTS",
          "content": "To further confirm the effectiveness and safety of SW therapy, 8 patients with severe angina pectoris were treated with SW therapy in a double-blind, placebo-controlled and cross-over manner. SW therapy, but not placebo, significantly improved chest pain symptoms and cardiac function without any complications or adverse effects."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Extracorporeal cardiac SW therapy is an effective, safe and non-invasive therapeutic option for severe angina pectoris."
        }
      ]},
