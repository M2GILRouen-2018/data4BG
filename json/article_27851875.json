      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To develop a spectral-spatial (SPSP) excitation RF pulse for simultaneous water and lipid suppression in proton (1H) magnetic resonance spectroscopic imaging (MRSI) of body extremities."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "An SPSP excitation pulse is designed to excite Creatine (Cr) and Choline (Cho) metabolite signals while suppressing the overwhelming water and lipid signals. The SPSP pulse is designed using a recently proposed multidimensional Shinnar-Le Roux (SLR) RF pulse design method. A minimum-phase spectral selectivity profile is used to minimize signal loss from T2\u204e decay."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The performance of the SPSP pulse is evaluated via Bloch equation simulations and phantom experiments. The feasibility of the proposed method is demonstrated using three-dimensional, short repetition-time, free induction decay-based 1H-MRSI in the thigh muscle at 3T."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The proposed SPSP excitation pulse is useful for simultaneous water and lipid suppression. The proposed method enables new applications of high-resolution 1H-MRSI in body extremities."
          }
        ]
      },
