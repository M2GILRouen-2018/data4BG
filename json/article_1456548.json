      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 The Authors. Journal of Veterinary Internal Medicine published by Wiley Periodicals, Inc. on behalf of the American College of Veterinary Internal Medicine.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Prophylactic gastropexy has been promoted as a means of preventing gastric volvulus during gastric dilatation and volvulus (GDV) syndrome. Little is known about the impact of gastropexy on gastrointestinal transit time."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "HYPOTHESIS",
            "content": "Laparoscopic-assisted gastropexy (LAG) will not alter gastrointestinal transit times when comparing gastric (GET), small and large bowel (SLBTT), and whole gut transit times (TTT) before and after surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANIMALS",
            "content": "10 healthy client-owned large-breed dogs."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Prospective clinical trial. Before surgery, all dogs underwent physical examination and diagnostic evaluation to ensure normal health status. Dogs were fed a prescription diet for 6 weeks before determination of gastrointestinal transit with a wireless motility capsule. LAG was then performed, and dogs were fed the diet for 6 additional weeks. Measurement of transit times was repeated 6 weeks after surgery."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Ten dogs of various breeds at-risk for GDV were enrolled. No complications were encountered associated with surgery or capsule administration. There were no significant differences in GET 429 [306-1,370] versus 541 [326-1,298] (P = 0.80), SLBTT 1,243 [841-3,070] versus 1,540 [756-2,623] (P = 0.72), or TTT 1,971 [1,205-3,469] versus 1,792 [1,234-3,343] minutes (median, range) (P = 0.65) before and after LAG."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND CLINICAL IMPORTANCE",
            "content": "An effect of LAG on gastrointestinal transit time was not identified, and wireless motility capsule can be safely administered in dogs after LAG."
          }
        ]
      },
