      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the application of quantitative temperature testing (QTT) in forensic identification and clinical diagnosis of neurogenic erectile dysfunction (NED)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "TSA-II-NeuroSensory Analyzer was used to measure the thresholds of four kinds of sensory, including cold, cold pain, heat, heat pain, in 22 normal and 35 NED patients at dorsal glans (DG), left thigh interior (LTI) and left thenar (LT). To calculate the relative thresholds of the sensory mentioned above between DG and LTI (DG/LTI), and between DG and LT (DG/LT). Then to analyze those thresholds and the relative thresholds."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "NED group showed significant higher threshold than the normal group in DG-heat, DG-heat pain, LTI-heat, LTI-heat pain, DG/LTI-heat, DG/LT-heat, DG/LT-heat pain (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The threshold of QTT at dorsal glans could be used as an accessory indicator in forensic medicine and clinical diagnosis of NED."
        }
      ]},
