      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We present a very interesting and extremely rare case of an accessory tragus in the middle ear."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Case report and review of literature."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Accessory tragus is not an uncommon congenital malformation of the external ear. The exact prevalence of accessory tragus as an isolated physical finding is unknown but it has been estimated to be 1.7:1000. There are many case reports on accessory tragus but there is no report of accessory tragus being found in the middle ear in English literature. We report the presentation and discuss the radiology and histopathology findings of this interesting case."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "To our knowledge, this is the first one to be reported in the English literature."
          }
        ]
      },
