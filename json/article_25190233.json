      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American College of Cardiology Foundation. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Acute kidney injury (AKI) is a known complication after coronary revascularization, but few studies have directly compared the incidence of AKI after coronary artery bypass surgery (CABG) or after percutaneous coronary intervention (PCI) in similar patients."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim of this study was to investigate whether multivessel CABG compared with PCI as an initial revascularization strategy is associated with a higher risk for AKI."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A retrospective analysis of patients undergoing first documented coronary revascularization was conducted using 2 complementary cohorts: 1) Kaiser Permanente Northern California, a diverse, integrated health care delivery system; and 2) Medicare beneficiaries, a large, nationally representative older cohort. AKI was defined in the Kaiser Permanente Northern California cohort by an increase in serum creatinine of ≥0.3 mg/dl or ≥150% above baseline and in the Medicare cohort by discharge diagnosis codes and the use of dialysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The incidence of AKI was 20.4% in the Kaiser Permanente Northern California cohort and 6.2% in the Medicare cohort. The incidence of AKI requiring dialysis was <1%. CABG was associated with a 2- to 3-fold significantly higher adjusted odds for developing AKI compared with PCI in both cohorts."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "AKI is common after multivessel coronary revascularization and is more likely after CABG than after PCI. The risk for AKI should be considered when choosing a coronary revascularization strategy, and ways to prevent AKI after coronary revascularization are needed."
          }
        ]
      },
