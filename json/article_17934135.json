      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVES",
          "content": "The fraction of exhaled nitric oxide (Feno) is elevated in subjects with asthma and atopy, and it has been proposed to be a noninvasive marker of airway inflammation. In addition to asthma and atopy, there is limited information about the determinants of Feno in a general population."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cross-sectional."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A random adult general population sample."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "A total of 2,200 subjects, 1,111 women and 1,089 men, aged 25 to 75 years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "The subjects were examined with regard to Feno, pulmonary function, anthropometric variables, and blood samples for Ig E, and completed a respiratory questionnaire. The associations between different determinants and Feno were analyzed with multiple linear regression models."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The median value of Feno was 16.0 parts per billion (ppb), ranging from 2.4 to 199 ppb. Height, age, atopy, reporting of asthma symptoms in the last month, and reported use of inhaled steroids were positively associated with Feno. Current smokers had lower values of Feno. Gender was not associated with Feno."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In this random adult population sample, height, but not gender, was associated with Feno. Furthermore, asthma symptoms in the last month, reported use of inhaled steroids, and atopy were positively and independently associated with Feno, while there was a negative association with smoking."
        }
      ]},
