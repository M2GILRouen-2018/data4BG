      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the changes in natural killer (NK) cell count in the peripheral blood of asthmatic patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The number of NK cells in the peripheral blood was determined with flow cytometry in 63 asthmatic patients with acute episodes, 65 patients with stable asthma and 62 healthy nonatopic subjects."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A significant decrease in NK cell number was noted in asthmatic patients during acute exacerbation [(13.9-/+9.4) %] in comparison with patients with stable asthma [(22.5-/+12.3) %] and healthy subjects [(19.6-/+10.1)%] (P<0.05), and the NK cell number showed no significant difference between the latter two groups (P>0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "NK cell number is reduced in acute exacerbation of asthma, suggesting its important role in the asthmatic process."
        }
      ]},
