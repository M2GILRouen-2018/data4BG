      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Bariatric surgery is associated with improved cognition, and it is possible that such improvements are found at extended follow-ups. We hypothesized that cognitive improvement would be maintained 3 years after bariatric surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Fifty bariatric patients were recruited from the Longitudinal Assessment of Bariatric Surgery parent project. Participants completed a computerized cognitive test battery to assess cognitive function at 12 weeks, 12 months, 24 months, and 36 months after surgery."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Repeated measures revealed main effects for attention, executive function, and memory. Attention improved up to 24 months and then slightly declined although it still fell within the average range at 36 months. Improvements in executive function reached their peak at 36 months after surgery. Short-term improvements in memory were maintained at 36 months. No main effect emerged for language."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Bariatric surgery may lead to lasting improvements in cognition. Prospective studies with extended follow-ups (eg, 10 years) should examine whether bariatric surgery can attenuate cognitive decline in severely obese patients."
          }
        ]
      },
