      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the incidence of angina pectoris during induced myocardial ischemia in patients who have had thrombolytic therapy for acute myocardial infarction in comparison with patients with angina pectoris."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "During percutaneous transluminal coronary angioplasty, both study groups had coronary artery occlusion by the balloon dilatation catheter for 5 minutes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A tertiary, cardiology referral center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Twenty-five patients with angina pectoris who were undergoing angioplasty were compared with 30 patients having angioplasty 2 days after thrombolytic therapy for acute myocardial infarction."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "OUTCOMES",
          "content": "Development of angina pectoris during balloon occlusion of the coronary artery was the primary end point; the ischemic response and muscle viability were assessed using both surface and intracoronary electrocardiograms and pulmonary artery wedge pressure."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "During balloon occlusion 16 (64%) of 25 patients in the angina pectoris group developed angina. In contrast, nine (30%) of 30 patients in the thrombolysis group had angina pectoris during balloon occlusion of the infarct artery (P less than .01). The electrocardiographic response to ischemia and changes in pulmonary wedge pressure were similar in the two study groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "After thrombolytic therapy for myocardial infarction, silent ischemia may be the rule rather than the exception."
        }
      ]},
