      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To identify motor and non-motor symptoms independently associated with distress in Parkinson's disease (PD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Clinical and patient-reported data from 118 people with PD (mean age and PD-duration, 64 and 8 years) were analyzed regarding associations with patient-reported distress using multiple regressions (controlling for age)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Non-motor symptoms independently associated with distress were pain, fatigue, sleep, depression and anxiety (R(2), 0.81). The only significant motor aspect was mobility (R(2), 0.31). When considering both motor and non-motor symptoms, fatigue, pain, depression and sleep showed independent associations with distress (R(2), 0.76)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Distress in PD is primarily associated with non-motor features."
          }
        ]
      },
