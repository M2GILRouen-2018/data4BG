      "Abstract": {
        "CopyrightInformation": "Copyright 2008 Wiley-Liss, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The prevalence of musculoskeletal symptoms (MSS) among U.S. dairy farmers is relatively unknown. The purpose of this study was to assess the prevalence of neck and upper extremity MSS, and to examine associations between symptoms and dairy operation activities among dairy farmers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Questionnaires were mailed to randomly selected dairy farmers in the State of Iowa, USA. Demographic, site specific MSS, and dairy operation activity information was obtained. Odds ratios and 95% confidence intervals were estimated with logistic regression adjusting for potential confounders."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Among the participants (N = 341), shoulder MSS were reported most frequently (54%). Neck MSS were significantly associated with manually feeding (OR(adj) = 2.29; 95% CI = 1.09-4.80) and tractors use (OR(adj) = 2.17; 95% CI = 1.05-4.50). Also, wrist/hand MSS were associated with manually cleaning animal stalls (OR(adj) = 1.96; 95% CI = 1.06-3.63)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Neck and upper extremity MSS were common and associated with common dairy farming practices. Future studies need to more accurately assess exposures to physical risk factors for MSS so ergonomic interventions can be developed."
          }
        ]
      },
