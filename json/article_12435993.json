      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Peer-reviewed literature was reviewed and summarized."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To synthesize the indications and published outcomes of reconstructive lumbar spine surgery for the treatment of chronic pain of spinal origin."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A literature review was conducted."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The most common indication for reconstructive lumbar surgery is pain that is refractory to nonsurgical treatment. Lumbar fusion has been shown to improve symptoms in carefully selected patients with incapacitating pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A successful arthrodesis is the fundamental surgical goal for patients with chronic pain of spinal origin. However, a successful fusion does not always correlate with a successful clinical result."
        }
      ]},
