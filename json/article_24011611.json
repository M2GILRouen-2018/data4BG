      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To appraise critically the published randomized controlled trials (RCTs) comparing carbon dioxide (CO2) with normal saline (NS) as distension medium for diagnostic hysteroscopy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Systematic review and meta-analysis of RCTs."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Outpatient and inpatient hysteroscopy clinics."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Women undergoing diagnostic hysteroscopy."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "REFVENTION(S)",
            "content": "CO2 or NS as distension medium for diagnostic hysteroscopy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Procedural and shoulder pain, side effects, satisfaction, quality of view, duration of procedure."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Ten RCTs involving 1,839 women (905 in the CO2 group, 934 in the NS group) were systematically analyzed. There was significant heterogeneity among the included trials. Compared with NS, CO2 was associated with greater procedural pain, more occurrences of shoulder pain and side effects, less satisfaction, less quality of view, and greater duration of procedure."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "A meta-analysis from the available moderate quality trials suggests that NS might be superior to CO2 for use in diagnostic hysteroscopy. Owing to problems of clinical diversity, statistical heterogeneity, and risk of bias, it is clear that additional pragmatic multicenter RCTs are needed to corroborate these findings before firm evidence-based guidelines can be given."
          }
        ]
      },
