      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the efficacy and safety of continuous epidural analgesia (CEA) with butorphanol in elderly patients undergoing hip replacement."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Sixty patients scheduled for selective hip replacement were randomized into group B (n=30) to receive patient-controlled epidural analgesia (PCEA) with butorphanol and group M (n=30) to receive PCEA with morphine. Their pain distribution at 5 time points, postoperative global score and the adverse effects in 48 h were observed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The pain distribution at the 5 time points or the global score for postoperative PCEA in 48 h showed no statistically significant difference between the two groups (P<0.05). Analgesia with butorphanol caused less adverse effects (respiratory depression, nausea and vomiting, itching and abdominal distension) than that with morphine (P<0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "CEA with butorphanol is safe and effective for the treatment of postoperative pain in elderly patients and causes less adverse effects than morphine."
        }
      ]},
