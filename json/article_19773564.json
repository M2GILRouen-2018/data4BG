      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Background",
          "content": "A literature review did not reveal any study investigating the prevalence of depression among plastic surgery residents."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Methods",
          "content": "We conducted a cross-sectional mail survey and included all Saudi Plastic Surgery residents in our local program in Saudi Arabia. The Beck Depression Inventory II was used."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Results",
          "content": "The inventory showed that mild, moderate, and severe depressive symptoms were prevalent in 20.6%, 38.2%, and 11.8%, respectively. Junior residents were more prone to depression."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Conclusions",
          "content": "The high prevalence rate of depression among plastic surgery residents is alarming, and further studies are warranted. The problem has received no attention in the plastic surgery literature."
        }
      ]},
