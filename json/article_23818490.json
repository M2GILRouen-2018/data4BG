      "Abstract": {
        "CopyrightInformation": "© 2013 The Authors. Pediatric Obesity © 2013 International Association for the Study of Obesity.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "Insulin responses to oral and intravenous glucose markedly differ by ethnicity. This study examined whether ethnic differences in pancreatic insulin secretion, hepatic insulin extraction and clearance explain these disparate findings in 35 obese African-American and 41 Latina girls (Tanner Stages: IV-V; ages: 14-18; body mass index percentile: 85.9-99.8%)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Pancreatic insulin secretion, hepatic insulin extraction and clearance were estimated by C-peptide and insulin modeling during an oral glucose tolerance test. Insulin sensitivity (SI), acute insulin response to glucose (AIRG ) and disposition index were derived from a frequently sampled intravenous glucose tolerance test."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Compared to Latinas, obese African-American adolescents had lower pancreatic insulin secretion (21.3%; P\u2009<\u20090.01), glucose incremental area under the curve (IAUC) (41.7%, P\u2009=\u20090.02), C-peptide IAUC (25.1%, P\u2009<\u20090.01) and SI (33.7%; P\u2009<\u20090.01). There were no ethnic differences in hepatic insulin extraction and clearance (P's\u2009>\u20090.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Compensatory mechanisms to insulin resistance do not appear to explain the ethnic differences in insulin responses to oral and intravenous glucose in obese African-American and Latina girls."
          }
        ]
      },
