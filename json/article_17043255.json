      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effectiveness of sucralfate in influencing throat pain, otalgia, analgesic requirement, bleeding, mucosal recovery, and incidence of postoperative bleeding in patients undergoing uvulopalatopharyngoplasty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective double-blind randomized study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University-affiliated tertiary referral hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Eighty adult patients with obstructive sleep apnea syndrome requiring uvulopalatopharyngoplasty were recruited and randomly allocated into either a sucralfate treatment group or a control group."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "All patients underwent uvulopalatopharyngoplasty. Patients enrolled in the sucralfate group (n=40) were instructed to gargle the sucralfate suspension and then to swallow. Patients enrolled in the control group (n=40) were instructed to gargle placebo suspension at the same doses and schedule."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Postoperative throat pain, otalgia, amount of analgesic required, degree of strength (defined as patients' general well-being and return to regular daily activities), percentage of mucosal covering, and postoperative bleeding."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Throat pain and otalgia occurred significantly less often in sucralfate group, with less analgesic requirement and with rapid mucosal healing and early return to regular daily activities. There was no significant difference in episodes of postoperative bleeding between the 2 groups (P=.37)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Although sucralfate therapy may not provide complete analgesia after uvulopalatopharyngoplasty, it may reduce the amount of analgesic required, thus preventing dose-related adverse effects from the analgesic agent. It can also significantly reduce the total number of days needed to return to normal daily activities (P=.41)."
        }
      ]},
