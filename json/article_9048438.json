      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To provide a review of the problem of cancer pain and cancer pain management around the world."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Review articles, World Health Organization reports, guidelines, and personal experience relating to international efforts in the relief of cancer pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Cancer pain is a worldwide problem that is not even addressed in most countries of the world because of limited options for cancer treatment and scare resources. Yet pain relief for many patients is possible in developing countries with international assistance and support."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Oncology nurses have the ability to advocate for the needs of patients with cancer throughout the world. Oncology nurses can work with nurses in developing countries to enhance pain management through support of existing programs, serving as volunteers, and recruitment of resources to assist nurses in these countries."
        }
      ]},
