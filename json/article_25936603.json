      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier España, S.L.U. and Sociedad Española de Reumatología y Colegio Mexicano de Reumatología. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe the history, clinical features and microorganisms involved in a group of adult subjects with and without septic arthritis (SA) at a tertiary care in Mexico."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "A cross-sectional descriptive study was conducted on 96 adults with clinical suspicion of AS in one or more joints. In all cases synovial fluid arthrocentesis and culture was performed. The comparison group subjects were culture negative. A descriptive statistical analysis and binary logistic regression model was performed between the variables associated with the development of AS. A value of P≤.05 was significant."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 49 out of 96 subjects had a positive culture, mostly of the monoarticular type (96%; P=.02). The knee was the most common site (61%; P=.06) and pain was the main clinical manifestation (59%; P=.001). Staphylococcus was the most common etiological agent (65%; P<.001). The risk factors revealed in the final regression model were SA the history of joint disease (OR=25; P=.03) and volume increase (OR=13.16; P=.06). Functional limitation (OR=8.54; P=.04) showed a significant risk among borderline for SA."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our results are consistent with previous studies, and can be generalized to geographical areas with similar clinical features to those observed in this study."
          }
        ]
      },
