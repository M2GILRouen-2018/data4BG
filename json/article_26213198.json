      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Society for Surgery of the Hand. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To conduct a systematic review to guide hand surgeons in an evidenced-based approach in managing postoperative pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We performed a literature review for primary research articles on management of postoperative pain in hand surgery patients using Medical Literature Analysis and Retrieval System Online (MEDLINE; PubMed), Excerpta Medica database (EMBASE), and the Cochrane Collaboration Library. Inclusion criteria were primary journal articles examining treatment of acute postoperative pain based on any modality. Data related to pain assessment, postoperative recovery, and total postoperative analgesic consumption were extracted."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 903 publications were reviewed; 184 publications underwent abstract review. After applying inclusion and exclusion criteria, 10 primary articles were selected for inclusion in this review. Data were noted to be heterogeneous and findings were compiled. Results were divided into groups evaluating postoperative pain medications or pain infusion catheters."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Although this review did not demonstrate a best practices model for postoperative pain management, it provides evidence for alternative medications and treatment strategies. The evidence available suggests that postoperative pain control should begin before surgery and that combining multiple strategies for pain treatment is beneficial. Given the increasing attention paid to narcotic prescriptions and the potential for abuse, surgeons should adopt evidence-based pain management practices. We provide an example algorithm for pain treatment in hand surgery based on available data and the authors' experience."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "TYPE OF STUDY/LEVEL OF EVIDENCE",
            "content": "Therapeutic III."
          }
        ]
      },
