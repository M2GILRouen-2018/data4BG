      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To evaluate the effectiveness of 8 weeks of weekly spinal stabilization exercises compared with 1-time treatment in participants with adolescent idiopathic scoliosis and low back pain at a 6-month follow-up."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Thirty-two participants were evaluated at a 6-month follow-up. The supervised group received weekly spinal stabilization exercises. The unsupervised group received a 1-time treatment and home exercise program."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Both groups improved in all outcome measures. The supervised group had significantly reduced Numeric Pain Rating Scale and Improved Global Rating of Change scores, but had no differences in the revised Oswestry Back Pain Disability Questionnaire, or Patient-Specific Functional Scale scores in comparison with the unsupervised group."
        }
      ]},
