      "Abstract": {
        "CopyrightInformation": "Copyright 2001 S. Karger AG, Basel",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The present monocenter prospective study was designed to evaluate the efficacy of intravenous high-dose methylprednisolone pulse therapy in patients with severe alopecia areata (AA)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "30 patients (aged 14-56 years) were treated with methylprednisolone (8 mg/kg body weight) intravenously on 3 consecutive days at 4-week intervals for at least 3 courses."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "67% of patients with AA plurifocalis showed >50% regrowth of hair. None of the patients with AA totalis or universalis and only 1 patient with ophiasic AA responded to therapy. In patients with AA plurifocalis, higher response rates could be observed in those suffering from long-term disease compared to patients treated during their first episodes of AA (73 vs. 57%)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "High-dose methylprednisolone pulse therapy is an effective and well-tolerated treatment for patients with severe AA plurifocalis but might be less beneficial for patients with ophasic AA, AA totalis or universalis."
          }
        ]
      },
