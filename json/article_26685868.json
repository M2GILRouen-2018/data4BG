      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of the study was to define pharmacodynamic markers for sudemycin D6, an experimental cancer drug that changes alternative splicing in human blood."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Blood samples from 12 donors were incubated with sudemycin D6 for up to 24\u2009hours, and at several time points total RNA from lymphocytes was prepared and the pre-messenger RNA (mRNA) splicing patterns were analyzed with reverse transcription-polymerase chain reaction."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Similar to immortalized cells, blood lymphocytes change alternative splicing due to sudemycin D6 treatment. However, lymphocytes in blood respond slower than immortalized cultured cells."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Exon skipping in the DUSP11 and SRRM1 pre-mRNAs are pharmacodynamic markers for sudemycin D6 treatment and show effects beginning at 9\u2009hours after treatment."
        }
      ]},
