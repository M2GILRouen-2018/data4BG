      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The effect of a community-based physical activity program in Pawtucket, RI, was evaluated relative to one in a comparison community."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Cross-sectional surveys of 7529 residents of Pawtucket, RI, and 7732 residents of the comparison city were conducted at 2-year intervals during 7 years of intervention."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no differences in self-reported knowledge of the benefits of physical activity, attempts to increase exercise, or prevalence of physical inactivity between Pawtucket and the comparison community."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Future community-based physical activity interventions should attempt to involve a wider range of individuals."
        }
      ]},
