      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE OF REVIEW",
          "content": "Exposure to forest fire smoke is episodic, which makes its health effects challenging to study. We review the newest contributions to a growing literature on acute respiratory outcomes."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RECENT FINDINGS",
          "content": "Smoke exposure was associated with increases in self-reported symptoms, medication use, outpatient physician visits, emergency room visits, hospital admissions, and mortality. The associations were strongest for the outcomes most specific to asthma."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "Studies with varied approaches to exposure assessment and varied measures of respiratory outcomes were consistent among themselves, and consistent with most previous work."
        }
      ]},
