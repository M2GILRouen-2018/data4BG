      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To investigate specific MRI findings for the prompt diagnosis of tubal torsion by reviewing 12 cases."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The MRI findings presenting surgically and pathologically proven isolated tubal torsion were evaluated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Key specific findings, including whirlpool sign and plicae tubaliae, were frequently associated with the diseases and were grouped for three types."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Knowledge of specific MRI findings and the types of tubal torsion may lead to a correct and prompt diagnosis, resulting in preservation of fertility."
          }
        ]
      },
