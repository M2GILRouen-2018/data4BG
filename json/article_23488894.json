      "Abstract": {
        "CopyrightInformation": "© 2013, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "Thirty-six patients with psoriasis and 56 healthy volunteers were included in this study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Echocardiographic examination included transmitral peak flow velocities of the early phase (E) and late phase (A) of the mitral inflow, left ventricular myocardial velocity measurements, and coronary flow reserve (CFR) measurement."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Baseline coronary diastolic peak flow velocity (DPFV) of left anterior descending artery (LAD) was significantly higher in the psoriasis group. However, hyperemic DPFV was slightly lower and CFR (2.19 ± 0.39 vs. 2.60 ± 0.31, P < 0.0001) was significantly lower in the psoriasis group than in the control group. CFR was significantly and inversely correlated with disease duration, Psoriasis Area and Severity Index (PASI) score, and hsCRP."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "CFR is decreased in patients with psoriasis, and it correlates to disease duration, PASI score, and inflammation."
          }
        ]
      },
