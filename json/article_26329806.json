      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To estimate annual medical and nonmedical costs of care for children diagnosed with irritable bowel syndrome (IBS) or functional abdominal pain (syndrome; FAP/FAPS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Baseline data from children with IBS or FAP/FAPS who were included in a multicenter trial (NTR2725) in The Netherlands were analyzed. Patients' parents completed a questionnaire concerning usage of healthcare resources, travel costs, out-of-pocket expenses, productivity loss of parents, and supportive measures at school. Use of abdominal pain related prescription medication was derived from case reports forms. Total annual costs per patient were calculated as the sum of direct and indirect medical and nonmedical costs. Costs of initial diagnostic investigations were not included."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 258 children, mean age 13.4 years (±5.5), were included, and 183 (70.9%) were female. Total annual costs per patient were estimated to be \u20ac2512.31. Inpatient and outpatient healthcare use were major cost drivers, accounting for 22.5% and 35.2% of total annual costs, respectively. Parental productivity loss accounted for 22.2% of total annual costs. No difference was found in total costs between children with IBS or FAP/FAPS."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Pediatric abdominal pain related functional gastrointestinal disorders impose a large economic burden on patients' families and healthcare systems. More than one-half of total annual costs of IBS and FAP/FAPS consist of inpatient and outpatient healthcare use."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "TRIAL REGISTRATION",
            "content": "Netherlands Trial Registry: NTR2725."
          }
        ]
      },
