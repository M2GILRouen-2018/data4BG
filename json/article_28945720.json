      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Early childhood dental caries (dental cavities) is an infectious process. The development of oral problems during cancer care results in pain, fever, and delay in treatment. \u2029."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The objective of this project was to integrate preventive oral care into pediatric oncology care. \u2029."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This project consisted of an educational program for pediatric oncology providers who completed pre- and postprogram surveys assessing oral health knowledge, attitudes, and practice; attended an oral health education session; and performed oral assessment and fluoride varnish application on children during cancer treatment. \u2029."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Three major outcomes resulted from this project."
        }
      ]},
