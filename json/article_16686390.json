      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "This is an explorative study of growth-related nasal geometry in healthy children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 88 girls and boys between the ages of 4 and 16 years were followed over a period of 2 years by acoustic rhinometry. The registrations were correlated to height at each occasion."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Although both the minimal cross-sectional area and the nasal volume increased in all age groups over 7 years, large individual variations in nasal geometry led to a weak relationship with growth."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In the undecongested nasal cavity in children, correlation of nasal geometry makes sense for height but not for age."
        }
      ]},
