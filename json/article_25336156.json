      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Pregabalin is a gamma-aminobutyric acid (GABA) analogue approved for the treatment of neuropathic pain, partial seizure and generalized anxiety disorder. As a GABA analogue, there is a raising concern regarding the abuse potential of this drug."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "We present a first case of pregabalin dependence in a 26-year-old woman without a previous history of illicit drug abuse."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Physician should be aware about the addictive potential of pregabalin even in patients without a previous history of substance abuse."
        }
      ]},
