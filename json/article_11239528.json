      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effectiveness of a levonorgestrel-releasing IUD as therapy for endometriosis of the rectovaginal septum."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective therapeutic non-randomized, self-controlled clinical trial analyzing changes in pain symptoms and size of lesions induced by the levonorgestrel-releasing IUD over 12 months."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary referral center for treatment of deep endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Eleven symptomatic patients with rectovaginal endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "A levonorgestrel-releasing IUD was inserted and maintained for 12 months."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Severity of dysmenorrhea, pelvic pain, and deep dyspareunia were assessed before insertion of the IUD and throughout treatment. The size of rectovaginal endometriotic lesions were evaluated by using transrectal and transvaginal ultrasonography."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Dysmenorrhea, pelvic pain, and deep dyspareunia greatly improved and the size of the endometriotic lesions was significantly reduced by treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Insertion of a levonorgestrel-releasing IUD alleviates pain and reduces the size of lesions in patients with endometriosis of the rectovaginal septum."
        }
      ]},
