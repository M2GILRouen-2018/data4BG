      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To determine the incidence of flare-up and the effect of age, gender, visit type, treatment duration, preoperative pain and intraoperative pain on flare-up in Nigerian adults."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "A total of 175 participants, aged 18 to 60 years with a necrotic central incisor, with or without preoperative pain, participated. They received postoperative paracetamol tablets and were asked to report back if unbearable pain/swelling developed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A 10% flare-up rate was recorded, while none of the studied factors had a significant relationship with flare-up."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The relationships between flare-up and studied related factors were not proven."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CLINICAL SIGNIFICANCE",
          "content": "Age, gender, visit type, treatment duration, preoperative pain and intraoperative pain have no effect on flare-up incidence."
        }
      ]},
