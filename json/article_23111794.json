        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "HISTORY AND ADMISSION FINDINGS",
            "content": "A 62-year-old, obese male patient was referred because of an increasing prominent epigastric mass and bloated feeling. An epigastric hernial defect was clinically excluded."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INVESTIGATIONS",
            "content": "Abdominal imaging by ultrasound and CT-scan demonstrated a giant liver cyst in the left lobe of 20 cm in diameter with a displacement of the stomach. Endoscopy showed an external compression of the stomach. Cystic echinococcosis was excluded by serology."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "TREATMENT AND COURSE",
            "content": "Laparoscopic deroofing of the cyst resulted in immediate freedom of symptoms. The further course was uneventful. The patient was discharged one day after the operation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Liver cysts may become symptomatic by intestinal compression syndromes or - occasionally - as a prominent abdominal mass. Laparoscopic deroofing is the golden standard of symptomatic non parasitic liver cysts and is associated with a good clinical outcome."
          }
        ]
      },
