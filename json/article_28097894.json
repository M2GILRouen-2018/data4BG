      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "We investigated the predictive value of chitinase-like protein YKL-40 in coronary artery disease (CAD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Serum YKL-40 levels in 116 CAD patients and 82 healthy controls were analyzed. Severity of CAD was evaluated using Gensini scores. Spearman's correlation was used to evaluate the correlation between Gensini scores and YKL-40 levels. The predictive value of YKL-40 was determined by receivers operating characteristic curve analysis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Serum YKL-40 levels were significantly elevated in CAD group as compared with control group. A positive correlation was found between the serum YKL-40 level and Gensini score. The optimum cut-off value of YKL-40 concentration was 127.7 ng/ml for distinguishing CAD patients from healthy controls with a 75.9% sensitivity and 57.3% specificity."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A positive correlation exists between YKL-40 levels and CAD, and YKL-40 might be a useful adjunct in the diagnosis of CAD."
        }
      ]},
