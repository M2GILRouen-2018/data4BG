      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVES",
            "content": "Physical pain can reduce emotional distress, perhaps especially the psychic pain of guilt. This implies that people who continually experience guilt may exhibit greater tolerance for pain relative to people who do not."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "To test this hypothesis, we administered a pressure algometer procedure to assess pain tolerance in patients with obsessive-compulsive disorder (OCD) plagued by moral obsessions (e.g., concerns about harming others, violating religious values), in patients with OCD with non-moral obsessions (e.g., regarding contamination and symmetry), and in healthy comparison subjects."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The results indicated that the OCD groups did not differ in levels of guilt, emotional distress tolerance, or in pain endurance. However, when we collapsed across subtypes, OCD subjects endured pain significantly longer than did healthy subjects."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "Limitations included small sample size and use of a sample with complex OCD symptoms that were, in some instances, difficult to categorize."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The results suggest that individuals with severe OCD might be willing to endure physical pain as a distraction from emotional distress, an expression of negative self-worth, or as a means to gain control over some aspect of suffering."
          }
        ]
      },
