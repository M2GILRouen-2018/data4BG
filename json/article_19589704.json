      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "This report presents a rare cause of dysmenorrhea in the adolescent female and the usefulness of magnetic resonance imaging (MRI) with T2 weighted sequence in the identification of adenomyosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "Two adolescents who presented with persistent pelvic pain in the absence of outflow tract obstruction or biopsy confirmed endometriosis had MRI-findings consistent with adenomyosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY AND CONCLUSION",
          "content": "In the adolescent female presenting with persistent dysmenorrhea, a diagnosis of adenomyosis is rare but should remain a possibility as one considers the differential diagnosis."
        }
      ]},
