      "Abstract": {
        "CopyrightInformation": "© 2015, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose was to understand the processes Hispanic parents undergo in managing postoperative care of children after routine surgical procedures."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "Sixty parents of children undergoing outpatient surgery were interviewed. Data were analyzed using grounded theory methodology."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Parents experienced five subprocesses that comprised the overall process of caring for a child after routine surgery: (a) becoming informed; (b) preparing; (c) seeking reassurance; (d) communicating with one's child; and (e) making pain management decisions."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Addressing cultural factors related to pain management in underserved families may instill greater confidence in managing pain."
          }
        ]
      },
