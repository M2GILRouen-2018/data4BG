      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the incidence and clinical features of hypokalemia in children with acute episode of bronchial asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The clinical records of 56 children with acute episode of bronchial asthma were reviewed and analyzed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Altogether 21 children with the complication of hypokalemia were identified from the 56 patients, with the incidence of the complication of 37.5%. Multiple factors were involved in the occurrence of hypokalemia during the acute episode of asthma and its treatment. Due to the unspecific manifestations, hypokalemia was easy to escape detection."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Hypokalemia is highly likely in children with acute episodes of bronchial asthma, which poses potential danger for the patients. Potassium supplementation should be timely administered especially in children taking glucocorticosteroid and beta2 receptor agonist."
        }
      ]},
