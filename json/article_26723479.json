      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Society for Surgery of the Hand. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To determine the prevalence of an estimated diagnosis of major depression in patients with upper extremity conditions and factors that help identify patients who might benefit from psychological treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In this observational cross-sectional study, 190 patients completed questionnaires measuring symptoms of depression with the Patient Health Questionnaire, upper extremity disability with the Patient-Reported Outcomes Measurement Information System Upper Extremity, pain interference with the Patient-Reported Outcomes Measurement Information System Pain Interference, and health anxiety with the Short Health Anxiety Inventory."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The estimated prevalence of an estimated diagnosis of major depression (Patient Health Questionnaire 9 ≥ 10) among this group of patients was 12%. Having multiple pain conditions, a history of depression, and greater limitation from pain for daily activities were independently associated with an estimated diagnosis of major depression."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The finding that 1 in 8 patients presenting to a hand surgeon have untreated or undertreated symptoms of depression sufficient to qualify for an estimated diagnosis of major depression emphasizes the importance of assessing for depression at all levels of care."
          }
        ]
      },
