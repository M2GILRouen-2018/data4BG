      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To assess the effects of a 9-week yoga intervention on chronic nonspecific neck pain 12 months after completion."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Twelve-month follow-up of the pooled data of both arms of a randomized, controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Department of Internal and Integrative Medicine at an academic teaching hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "Fifty-one patients with chronic nonspecific neck pain (mean age 47.8 years; 82.4% female)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "A 9-week yoga group intervention."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Neck pain intensity (100-mm visual analog scale), functional disability (neck disability index), health-related quality of life (short-form 36 questionnaire, SF-36), generic disability (days with restricted activities), and global improvement."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "From baseline to 12-month follow-up, pain intensity improved from 48.81\u2009±\u200917.71 to 32.31\u2009±\u200920.68 (P\u2009<\u20090.001), neck-related disability decreased from 25.26\u2009±\u20099.02 to 19.49\u2009±\u200911.52 (P\u2009=\u20090.001), and bodily pain in the SF-36 improved from 49.37\u2009±\u200912.40 to 59.26\u2009±\u200917.57 (P\u2009=\u20090.005). Improvements in pain intensity were predicted by weekly minutes of yoga practice during the past 4 weeks (r(2) \u2009=\u20090.12, P\u2009=\u20090.028); improved neck-related disability (r(2) \u2009=\u20090.24, P\u2009=\u20090.001) and bodily pain (r(2) \u2009=\u20090.26, P\u2009=\u20090.006) were predicted by regular yoga practice during the past 12 months. Generic disability did not decrease significantly. Twenty-four patients (68.6%) rated their health as at least somewhat improved."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A 9-week yoga intervention improved pain and neck-related disability for at least 12 months after completion. Sustained yoga practice seems to be the most important predictor of long-term effectiveness."
          }
        ]
      },
