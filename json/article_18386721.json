      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Propofol-Lipuro 1% is consisting of long-chain triglycerides (LCT) and medium-chain triglycerides (MCT) that have been reported to reduce injection pain."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the incidence and intensity of injection pain with 1% Propofol-LCT with 1% Propofol-LCT/MCT in female populations for minor surgery under total intravenous anesthesia (TIVA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHOD",
          "content": "One hundred and ten female patients were double-blind randomized into two groups. Group long-chain triglycerdes (L) received 1% propofol-LCT while group long-chain triglycerides/medium-chain triglycerides (L/M) received 1% propofol-LCT/MCT. All patients received no benzodiazepine premedication and fentanyl 1 microg/kg was given 3 minutes before propofol injection. The propofol 1 mg/kg was manually injected at 0.5 mL/sec. The verbal rating score (VRS 0-10) was recorded on pain of injection. VRS > 4 indicates a significant response to pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was a significantly greater incidence and intensity of injection pain in group L compared with group L/M (p < 0.001 and p = 0.013 respectively)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Propofol-LCT/MCT is superior to propofol-LCT on reducing pain of injection."
        }
      ]},
