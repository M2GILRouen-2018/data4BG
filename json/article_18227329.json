      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Using a rat L5 spinal nerve transection model we previously showed that pentoxifylline prevents hyperalgesia through antiinflammation in the prefrontal brain. In this study, we examined efficacy when applied after injury."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We examined the effect of pentoxifylline on existing mechanical allodynia, observing glial activation and proinflammatory cytokine expression in the lumbar spinal cord, when given 7 days after L5 spinal nerve transection."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was no effect from pentoxifylline on existing hypersensitivity, glial activation, and cytokine expression when applied after L5 spinal nerve transection."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Pentoxifylline administered intraperitoneally on day 7 postsurgery failed to alleviate existing hypersensitivity, or reduce glial activation and cytokine expression."
        }
      ]},
