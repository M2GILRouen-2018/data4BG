      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine if Paraspinal Square Wave Stimulation (PSWS) is effective in treating Post Traumatic Stress Disorder (PTSD) and or Chronic Pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "PSWS is applied to the paraspinal area from the craniocervical junction to the lower sacrum."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patient achieved dramatic relief from PTSD, unequaled by any previous pharmacologic or psychotherapies. The chronic pain is almost completely disappeared, unlike any previous therapies."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "PSWS is the treatment of choice for this patient with PTSD and Chronic Pain. This patient appears to have completely recovered from PTSD, unlike any other study reported so far."
        }
      ]},
