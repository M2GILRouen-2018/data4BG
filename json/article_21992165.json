      "Abstract": {
        "CopyrightInformation": "© 2010 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "This is a case report and description of a new ultrasound-guided caudad epidural needle placement for percutaneous stimulation of the lumbosacral roots."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "Case report."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Using ultrasonography pertinent spinal and neuroaxial anatomy was visualized. In-plane approach with continuous monitoring of the needle advancement was utilized. The needle was seamlessly placed in the epidural space on the first attempt."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Spinal sonography is a promising imaging method to facilitate percutaneous caudad epidural access."
          }
        ]
      },
