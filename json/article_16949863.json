      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the reliability and validity of resting electrical activity from tender areas in muscle."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In seven subjects with tender areas in their trapezius muscles, electromyographic (EMG) signals were obtained from monopolar needles at various depths over the tender area and at the same depths over the control area, and from surface electrodes. At selected depths, multiple epochs were recorded."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Increased electrical activity occurred from the electrode inserted toward the tender area in all seven subjects (to a mean of 47.6 microV), but not from control areas. The depths of the maximal EMG amplitudes advancing and withdrawing the needle were usually within 3 mm. The EMG amplitude from the first of multiple epochs (38.4 microV) did not differ from the average (40.0 microV) of subsequent epochs (paired-t test, 6 df, 0.2<p<0.3)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "We suggest that the electrical activity arises from a localized zone and is stable over time."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SIGNIFICANCE",
          "content": "Our data provide evidence for the reliability and validity of the electrical activity from myofascial tender areas."
        }
      ]},
