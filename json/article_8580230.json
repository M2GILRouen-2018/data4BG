      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "To investigate the cause of chest pain during the use of bupropion as an aid to stop smoking."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The Netherlands Pharmacovigilance Centre received 22 reports of chest pain, associated with the use of bupropion as an aid to smoking cessation. Additional information about long-term follow up was collected to analyze whether these complaints herald manifest cardiac disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All but one patient recovered after withdrawal of bupropion. Seven patients were additionally investigated and in six of them, a cardiac cause could be excluded. During long-term follow-up, no coronary heart diseases were diagnosed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These reports indicate that chest pain seems to be associated with the use of bupropion, but its origin remains unclear."
        }
      ]},
