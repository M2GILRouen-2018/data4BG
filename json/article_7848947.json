      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND OBJECTIVES",
          "content": "Meperidine is an opioid with local anesthetic properties that produces spinal anesthesia after subarachnoid injection for surgical procedures. The aim of this study was to evaluate the clinical relevance of spinal meperidine for cesarean delivery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Twenty-eight ASA I-III parturients scheduled for cesarean delivery were included in the study. Meperidine 1 mg/kg was administered subarachnoid. Patients were monitored for appropriate anesthesia and side effects."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Cesarean delivery was successfully performed under spinal meperidine in 22 cases: two cases required general anesthesia before incision and the duration of sensory anesthesia was too short in four cases. Side effects included moderate hypotension (decrease in arterial blood pressure > 30 mm Hg in 36% of the cases), nausea (32%), and pruritus (10.7%). No respiratory depression was documented in mothers and newborns."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Although short-acting, meperidine can be used as a substitute for local anesthetics for cesarean delivery, especially when local anesthetics are not available."
        }
      ]},
