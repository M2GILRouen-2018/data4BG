      "Abstract": {
        "CopyrightInformation": "Copyright Â© 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To determine whether shoulder and head elevation, such that the patient's ear lies at or higher than the sternum (\"ramp\"), improves laryngoscopic grade in adult patients of various body mass index (BMI) values."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, unblinded study, with patients and laryngoscopists acting as their own controls."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Operating room of a university-affiliated hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "189 adult ASA physical status 1, 2, and 3 patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "After performing a standard preoperative airway evaluation and inducing general anesthesia, the anesthetist performed and graded two laryngoscopies: one in the \"ramp\" position and one in the \"sniff\" position."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Patient BMI, Mallampati airway class, thyromental distance, neck circumference, cervical extension ability, Cormack and Lehane laryngoscopic grade for each laryngoscopy, subjective lifting force required, and need for external laryngeal pressure were recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Use of the \"ramp\" provided significantly better or equal laryngoscopic views, relative to those with the \"sniff\" position, in the entire study population."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Shoulder and head elevation by any means that brings the patient's sternum onto the horizontal plane of the external auditory meatus maintains or improves laryngoscopic view significantly."
          }
        ]
      },
