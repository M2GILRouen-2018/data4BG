      "Abstract": {
        "CopyrightInformation": "© 2014 Scandinavian Society of Clinical Physiology and Nuclear Medicine. Published by John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to evaluate the test-retest reliability, concurrent validity and agreement with peak oxygen uptake (VO2 ) obtained during cardiopulmonary exercise testing (CPX) on a treadmill for the incremental shuttle walking test (ISWT) in obese women."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Prospective study with a convenient sample of 46 community-dwelling obese women (BMI > 30 kg m(-2) ). The main outcome measures were walking distance on the ISWT and peak VO2 ."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Test-retest reliability was good to excellent for the exercise tests (ISWT distance ICC: 0.90; and CPX peak VO2 ICC: 0.90). Peak VO2 obtained during CPX correlated significantly with ISWT distance (r = 0.54, P<0.05) and peak VO2 obtained during the ISWT (r = 0.64, P<0.05). Bland and Altman plots demonstrated a high degree of repeatability."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The ISWT had excellent reliability as well as good concurrent validity and agreement. The ISWT may be a potential tool for monitoring clinical status and intervention efficacy (e.g. programmes for weight loss and rehabilitative strategies) in this population."
          }
        ]
      },
