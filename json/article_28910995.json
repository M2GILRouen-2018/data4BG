      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Introduction",
          "content": "Effective data sharing does not occur in the UK despite being essential for the delivery of high-quality genomic services to patients across clinical specialities and to optimize advances in genomic medicine."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Sources of data",
          "content": "Original papers, reviews, guidelines, policy papers and web-resources."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Areas of agreement",
          "content": "Data sharing for genomic medicine requires appropriate infrastructure and policies, together with acceptance by health professionals and the public of the necessity of data sharing for clinical care."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Areas of controversy",
          "content": "There is ongoing debate around the different technical approaches and safeguards that could be used to facilitate data sharing while minimizing the risks to individuals of identification. Lack of consensus undermines trust and confidence."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Growing points",
          "content": "Ongoing policy developments around genomics and health data create opportunities to ensure systems and policies are in place to support proportionate, effective and safeguarded data sharing."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "Areas timely for developing research",
          "content": "Mechanisms to improve public trust."
        }
      ]},
