      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "There is an unmet medical need for allergic asthma patients who are uncontrolled on conventional therapies. The aim of this study was to collect efficacy and safety data for QAW039, an oral chemoattractant receptor-homologous molecule expressed on Th2 cells (CRTh2) receptor antagonist, for the treatment of asthma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This was an exploratory phase II, double-blind, randomized, placebo-controlled multi-center study. Patients with mild-to-moderate uncontrolled allergic asthma (N = 170) were either without or weaned off inhaled corticosteroids (ICS) and long-acting β-agonists (LABA) and randomized (1:1) to QAW039 (500 mg once daily) or to placebo for 28 days."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Overall, 157 patients completed the study. There were no significant differences between QAW039 and placebo for trough forced expiratory volume in 1 s (FEV1) or Asthma control questionnaire (ACQ) in the total population. Subgroup analyses demonstrated that patients with a FEV1 <70% of predicted at baseline treated with QAW039 had significant improvement compared with placebo in trough FEV1 (QAW039- Placebo [Δ] = 207 mL; 90% confidence interval [CI]: 96, 319; P = 0.002) and ACQ7 (Δ = -0.41; 90%CI: -0.69, -0.13; P = 0.009). QAW039 reached a mean maximum concentration (Cmax) of 3440 ng/mL on day 28 at a median Tmax of 1 h (range 0.5-4 h). Most adverse events (AEs) were mild/moderate and balanced between both groups, with no serious AEs."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In the general study population, no improvement in lung function was observed with QAW039. However, a subgroup analysis revealed that patients with greater severity of airflow limitation (FEV1 < 70%) had improved lung function and asthma control when treated with QAW039. QAW039 also demonstrated a favorable safety profile."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "TRIALS REGISTRATION",
            "content": "ClinicalTrials.govNCT01253603."
          }
        ]
      },
