      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Testicular torsion associated with undescended testis is uncommon but requires immediate treatment. Ultrasound Doppler is recognized as the preferred imaging modality for testicular torsion due to its high specificity, sensitivity and availability."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine the accuracy of ultrasound Doppler in diagnosis of torsion of undescended testis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We describe three patients with known undescended testis who were admitted with groin pain and had preoperative ultrasound Doppler. The discrepancy between these and the intraoperative findings is discussed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In two patients incarcerated inguinal hernia was diagnosed with ultrasound Doppler; however, surgery revealed torsion of an undescended testis. In the third patient ultrasound Doppler diagnosed torsion of undescended testis, but at surgery incarcerated inguinal hernia was found, without evidence of testicular torsion."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Torsion of undescended testis should be a clinical rather than radiologic diagnosis."
        }
      ]},
