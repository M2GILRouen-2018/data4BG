      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To study the correlation of obesity with various metabolic parameters and correlation between insulin resistance and leptin and retinol binding protein 4 (RBP4) levels."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This is a cross sectional study in a tertiary care children's hospital wherein 98 obese children were included and their metabolic parameters analysed with regards to insulin resistance and RBP4 levels."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Leptin levels were abnormal for all children and high RBP4 levels were observed in 69.6 %. There was no significant association between insulin resistance and RBP4 levels (p 0.8)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "RBP4, the sole retinol transporter in blood, secreted from adipocytes and liver has been implicated in insulin resistance. The index study however, did not show a significant positive association."
        }
      ]},
