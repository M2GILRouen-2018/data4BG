      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "This study compared elderly patients' reported experiences of pain and distress with enrolled nurses' assessments and related potential differences to patient and enrolled nurse characteristics."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Many elderly suffer from chronic pain but few studies have focused on this group of patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Data were collected through personal interviews with 38 patients and questionnaires completed by 38 enrolled nurses."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Enrolled nurses underestimated patients' experiences of physical pain, physical discomfort, breathing problems, resignation, and dependency. Pain and distress were overestimated by enrolled nurses who had lower scores on three of the five personality scales used. In contrast, enrolled nurses who had higher scores on these personality scales tended to underestimate the patients' pain and distress."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "There is a need to develop staff training programmes in order to optimize the care for elderly patients with chronic pain in the community."
        }
      ]},
