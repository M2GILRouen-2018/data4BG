      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The purpose of this study was to assess the usefulness of electrocardiogram on admission to predict short-term prognosis in patients with acute myocardial infarction (AMI) associated with left main coronary artery (LMCA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Electrocardiogram was obtained on admission in 41 patients with AMI associated with LMCA who underwent reperfusion therapy. Electrocardiographic findings were compared between nonsurvivors and survivors."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were 24 nonsurvivors and 17 survivors during 30-day follow-up. Nonsurvivors had ST-segment elevation in both leads aVR and aVL (54% vs 18%, P < .05), left anterior fascicular block (83% vs 41%, P < .05), and right bundle-branch block (54% vs 18%, P < .05) more frequently, and ST-segment depression in lead V(5) (17% vs 59%, P < .05) less frequently than survivors among patients with AMI associated with LMCA."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Our data suggested that electrocardiogram on admission might be useful to predict short-term prognosis in patients with AMI associated with LMCA."
        }
      ]},
