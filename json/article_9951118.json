      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To analyze the characteristics of testicular torsion between 6-12 hours."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The records of 47 patients treated for testicular torsion within 6-12 hours were reviewed. We evaluated the reason for consultation, previous patient history, clinical features, urinalysis findings, diagnostic methods and surgical findings."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The reason for consultation was scrotal pain in 42 patients; 17% of the patients had a previous history of ascending testis. Orchidectomy was required in 17% of the patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The need for performing orchidectomy is higher in cases with testicular torsion diagnosed between 6-12 hours. The results of urinalysis are generally normal. The clinical findings and the diagnostic techniques are useful in making early diagnosis and instituting early treatment."
        }
      ]},
