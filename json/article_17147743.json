      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Pulsed radiofrequency treatment (PRF) applied to the suprascapular nerve may provide pain relief for patients suffering from shoulder pain as described in three case series."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "The effect of PRF to the suprascapular nerve was retrospectively analysed on 28 patients with shoulder pain lasting longer than 1 month, with a 6-month follow-up. Group A was treated with PRF and local anaesthetics only while group B was treated with PRF, local anaesthetic and steroid. Pain scores were evaluated before and after the procedure and at 1, 3 and 6 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "More than 50% of patients in both groups had significant pain relief after 3 months. No major, but only one minor complication occurred."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Our results suggest that the analgesic effects of PRF last more than 3 months in the majority of patients. The addition of steroid to the PRF treatment appears to have no benefit."
        }
      ]},
