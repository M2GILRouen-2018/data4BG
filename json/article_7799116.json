      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To test a combination treatment of ibuprofen and methylprednisolone for pain and swelling."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The efficacy of 32 mg methylprednisolone on pain and swelling when given 12 hours before and after surgery in combination with 400 mg ibuprofen three times a day given immediately on the day of the operation and on the two subsequent days following removal of impacted third molars was investigated in a placebo-controlled, intraindividual double-blind study."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After use of ibuprofen/methylprednisolone, ultrasonic examination showed a reduction in swelling of 56% (P < .001) compared with the placebo group; measurement with a tape measure showed a 58% (P < .001) reduction in swelling. The visual analog scale showed a reduction of 67.7% in postoperative pain in comparison with placebo."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The combination of ibuprofen and methylprednisolone has good analgesic and antiinflammatory action."
        }
      ]},
