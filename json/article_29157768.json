      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Society of PeriAnesthesia Nurses. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To explore professional identity of registered nurse anesthetists (RNAs) and RNAs' expectations of their professional self and the expectations RNAs meet from interdisciplinary team members when preparing patients for general anesthesia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Focused ethnography was used for data collection."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Participant observations and interviews were conducted with patients scheduled for surgery and with RNAs in charge of the patients during the anesthetic procedures. Interviews with RNAs, anesthesiologists, and operation nurses with a specific focus on RNAs' professional identity were performed. The analysis was inspired by grounded theory."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "A core variable of Identifying the professional self is presented, and two subcore variables are delineated: Gliding between tasks and structures and Depending on independence."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "RNAs are at risk of downsizing psychosocial and relational aspects of fundamentals of care in favor of performing technological procedures, and RNAs' professional values are influenced by the work culture in the Department of Anesthesiology."
          }
        ]
      },
