      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To discuss a patient whose spinal abnormalities may have caused subliminal visual field loss."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CLINICAL FEATURES",
          "content": "A 22-yr-old man suffered from a painful neck. His vision was in the normal range, as measured by computerized static perimetry."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "INTERVENTION AND OUTCOME",
          "content": "To define a guideline for a proposed investigation into visual field changes with spinal adjustment, his visual fields were tested before and after a normal office spinal manipulation. After this procedure, there was a measurable rise in the visual sensitivity of both eyes."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The use of computerized static perimetry changes to measure the cerebral effects of spinal manipulation is recommended for future chiropractic research."
        }
      ]},
