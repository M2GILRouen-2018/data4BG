      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 John Wiley & Sons, Ltd and Eating Disorders Association.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "GOALS",
            "content": "This study aimed to analyse the association, commonalities and differences between obesity and eating disorders (ED)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A total of 150 female patients [50 obese with bulimia nervosa (OB\u2009+\u2009BN), 50 obese with binge eating disorders (OB\u2009+\u2009BED), 50 obese without eating disorders (OB)] and 50 female healthy-eating/weight control (CG) volunteers participated in this study."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "ASSESSMENT",
            "content": "All participants were assessed by the Eating Disorders Inventory-2 (EDI-2), the Symptom Checklist-Revised (SCL-90-R) and the Temperament and Character Inventory-Revised."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In general, all the groups differed significantly and showed linear trends (OB\u2009+\u2009BN\u2009>\u2009OB\u2009+\u2009BED\u2009>\u2009OB\u2009>\u2009CG) on general and eating psychopathology (SCL-90-R and EDI-2). Regarding personality traits, statistically significant differences across all four groups were found on Harm Avoidance and Self-Directedness. Whereas some symptoms were shared in extreme weight conditions, others were specifically related to ED."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The presence of binge and purge symptomatology in obese patients is clinically relevant. These findings help to understand the relationship between Obesity and ED."
          }
        ]
      },
