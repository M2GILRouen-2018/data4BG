      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To determine the effect of heating and humidifying CO2 on the tolerance of awake laparoscopy and frequency of shoulder pain and patient recovery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, controlled study (Canadian Task Force classification I)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University-affiliated hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Forty consecutive women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Awake laparoscopy with and without heating and humidifying CO2."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Heating and humidifying CO2 decreased the frequency of shoulder pain and increased tolerance of the procedure. Thirty percent of patients required no intravenous sedation and did not experience shoulder pain when 3 L of gas or 15 mm Hg pressure was achieved. When shoulder pain did occur with heated and humidified gas, it was brief."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Heating and humidifying CO2 increases tolerance of awake laparoscopy and decreases the frequency and duration of shoulder pain."
        }
      ]},
