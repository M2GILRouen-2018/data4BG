      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the relation between preeclampsia (PE) and pregravid body mass index (BMI) in twin pregnancy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Retrospective cohort study of 542 women pregnant with twins."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Forty-nine patients developed PE (9%). Underweight, overweight and obese women were at a higher risk of PE than normal-weight mothers. There was no linear (p\u2009=\u20090.7) but significant U-shaped relation between BMI and PE (p\u2009<\u20090.006). The lowest risk of PE development was related to BMI of about 23\u2009kg/m(2)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Nonlinear relation between PE occurrence and BMI suggests that using homogeneous PE risks of BMI groups may be incorrect."
        }
      ]},
