      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Academy of Dermatology, Inc. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Intraoperative pain during Mohs micrographic surgery (MMS) has not been characterized. However, many patients report postoperative pain on the day of MMS."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We sought to determine if patients experience pain during their MMS visit."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In phase I of this study, patients were asked to report intraoperative pain level using the verbal numerical rating scale (0-10) at discharge. In phase II, pain levels were assessed before each Mohs layer and at discharge, to determine whether pain was experienced throughout the day."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pain was reported at some point during the MMS day for 32.8% of patients (n = 98). The mean pain number reported was 3.7 (range 1-8) out of 10. Pain was more commonly reported by patients who spent a longer time in the office, had 3 or more Mohs layers, and had a flap or graft repair. Patients most frequently reported pain with surgical sites of the periorbital area and nose."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "Time between Mohs layers was not measured. There was nonstandardized use of intraoperative local anesthesia volume and oral pain medications."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Some patients experience pain during MMS. However, the majority of patients report a low level of pain. Additional preventative measures could be considered in patients at higher risk."
          }
        ]
      },
