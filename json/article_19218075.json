      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To examine soft tissue release (STR) as an intervention for delayed onset muscle soreness (DOMS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A mixed-subjects experimental design was used. Participants performed 4 x 20 eccentric elbow extensions at 80% of 1RM. Participants received either STR (50%) or no treatment (50%). DOMS measurements were taken before the elbow extensions and at 0, 24, and 48 h afterwards."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The study was conducted at the University of Essex exercise physiology laboratory."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Twenty male participants, unaccustomed to strength conditioning, completed the study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "DOMS was evaluated using relaxed joint angle (RJA), active range of motion (AROM), passive range of motion (PROM), and arm girth measurements. Soreness ratings were measured using a 100 mm visual analogue scale (VAS)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In both conditions there were post-DOMS task increases in VAS ratings (p < 0.0001) and arm girths (p < 0.0001), and decreases in RJA (p < 0.0001), AROM (p < 0.0001), and PROM (p < 0.0001). STR group VAS scores were higher immediately (p < 0.01) and 48 h after treatment (p < 0.005). There were no other between-group differences and none of the measurements returned to baseline levels by 48 h."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "STR exacerbates the DOMS sensation yet does not seem to improve the rate of recovery during the first 48 h."
        }
      ]},
