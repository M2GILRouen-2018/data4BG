      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Multimodal postoperative care regimens accelerate recovery after abdominal surgery. The benefit of thoracic epidural (TE) analgesia over patient-controlled analgesia (PCA) remains unproven when used with a fast-track postoperative care plan."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Fifty-six patients undergoing major intestinal resection, and on a fast-track postoperative care plan, were randomized to preemptive TE or PCA. Patients were evaluated at standard time points for pain score, quality of life (Short Form-36), and complications. Oral analgesia was substituted for TE and PCA on the second postoperative day. Discharge criteria were identical for both groups."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Six patients (20.6%) had a failed epidural. There was no difference in length of stay (5.8 versus 6.2 days, TE versus PCA, P = .55), total length of stay (including readmissions), pain scores, quality of life, complications, or hospital costs at any time point."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "TE offers no advantage over PCA for patients undergoing major intestinal resections who are on a fast-track postoperative care plan using PCA."
        }
      ]},
