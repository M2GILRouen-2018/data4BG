      "Abstract": {
        "CopyrightInformation": "© 2016 British Small Animal Veterinary Association.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To assess the prevalence of impinged spinous processes in asymptomatic dogs."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "One hundred and ninety lateral thoracic radiographs of asymptomatic dogs radiographed for reasons other than spinal pain, were retrospectively reviewed by two board-certified radiologists. Images were assessed for impinged spinous processes and graded for narrowing, sclerosis or remodelling of the spinous processes."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The prevalence of impinged spinous processes in unaffected dogs was 33·2%. Seventy-five of 79 (95%) lesions were located between T8 and T11. Impingement of the spinous processes was more common in older dogs and larger dogs displayed more frequent and more severe impingement of the spinous processes compared with smaller breeds."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL SIGNIFICANCE",
            "content": "Spinous process impingement is common in animals with no history of spinal pain, indicating that this radiographic finding should be interpreted with caution."
          }
        ]
      },
