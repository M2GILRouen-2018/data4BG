      "Abstract": {
        "CopyrightInformation": "© 2012 John Wiley & Sons A/S.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate surgical complications and clinical outcome in a consecutive series of 96 patients undergoing anterior cervical discectomy and fusion (ACDF) for cervical disk degeneration (CDD) in an outpatient setting."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Pre-, per-, and postoperative data on patients undergoing single- or two-level outpatient ACDF at the private Oslofjord Clinic were prospectively collected."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "This study includes 96 consecutive patients with a mean age of 49.1 years. 36/96 had a two-level ACDF. Mean postoperative observation time before discharge was 350 min, and 95/96 were successfully discharged either to their home or to a hotel on the day of surgery. The surgical mortality was 0%, while the surgical morbidity rate was 5.2%. Two (2.1%) patients developed postoperative hematoma, 2 (2.1%) patients experienced postoperative dysphagia, and 1 (1%) experienced deterioration of neurological function. Radicular pain, neck pain, and headache decreased significantly after surgery. 91% of patients were satisfied with the surgery, according to the NASSQ."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "ACDF in carefully selected patients with CDD appears to be safe in the outpatient setting, provided a sufficient postoperative observation period. The clinical outcome and patient satisfaction of outpatients are comparable to that of inpatients."
          }
        ]
      },
