      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To determine if rofecoxib 50 mg administered 1 hour preoperatively to patients undergoing arthroscopic knee surgery reduces postoperative pain, provides a narcotic-sparing effect, and reduces time spent in recovery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "TYPE OF STUDY",
          "content": "Prospective, randomized, double-blinded clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Fifty patients (age range, 30 to 60 years) undergoing knee arthroscopy under spinal anesthesia were randomized to receive either 50 mg of rofecoxib or placebo 1 hour preoperatively. Postoperatively, pain was assessed in recovery, 8 hours postoperatively, and 24 hours postoperatively, using a 100-mm visual analog scale. Pain medication usage was monitored for 24 hours and time in recovery room was determined. Mann-Whitney tests determined significance between groups."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients in the rofecoxib group showed significantly lower pain scores at 8 and 24 hours postoperatively. They also showed a significant reduction in postoperative narcotic consumption."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Rofecoxib 50 mg as a single preoperative dose should be considered as part of a perioperative analgesic plan in arthroscopic knee surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "LEVEL OF EVIDENCE",
          "content": "Level I, Therapeutic Study (randomized controlled trial)."
        }
      ]},
