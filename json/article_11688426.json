      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "Assessment of coronary artery bypass graft patency by three-dimensional reconstructed computed tomography angiography (3D-CTA) derived from electrocardiography-gated contrast-enhanced electron beam tomography (EBT) was evaluated."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Thirty-nine patients with 99 grafts (45 arterial grafts and 54 venous grafts) underwent 3D-CTA and selective coronary angiography within a 3-week interval. 3D-CTA images of the coronary bypass grafts were compared with the coronary angiography images used as the control."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "3D-CTA defined 42 of 44 arterial grafts as patent (sensitivity: 95%), all 47 venous grafts as patent (sensitivity: 100%) and all 7 venous grafts as occlusive (specificity: 100%). The overall sensitivity and specificity were 98% and 88%, respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "3D-CTA is an useful noninvasive technique with adequate sensitivity and specificity to assess coronary artery bypass graft patency."
        }
      ]},
