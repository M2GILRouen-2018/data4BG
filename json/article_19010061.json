      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "A 64-year-old female presented with a 2-year history of worsening angina."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Subsequent investigations revealed aortic valve tumor. The patient had history of hypertension, coronary artery disease, atrial fibrillation, hyperlipidemia, and hyperthyroidism. The patient was nondiabetic, nonsmoker, and had marfanoid features."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The tumor was excised, and aortic valve replacement was done using partial sternotomy (minimally invasive). Histology was suggestive of spindle cell lipoma of the aortic valve."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Although lipomas have benign pathology and slow growth, they warrant surgical excision in view of possible fatal complications."
        }
      ]},
