      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate health care resource use, costs, and cost drivers among patients with neuropathic pain (NeP) after spinal cord injury (SCI) in a commercially insured population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective longitudinal cohort study comparing SCI patients with and without NeP."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Truven Health MarketScan commercial claims database from 2005 through 2012."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Commercially insured SCI patients with NeP (n=3524) propensity score matched to SCI patients without NeP (n=3524)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Not applicable."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOMES MEASURES",
            "content": "Health care resource utilization and expenditures for the 12 months after NeP onset (index event; identified through International Classification of Diseases, 9th Revision, Clinical Modification diagnosis 338.0x or use of NeP-specific antiepileptic drugs or NeP-specific antidepressants) in patients with SCI compared with matched patients without NeP."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Utilization over 12 months postindex among patients with SCI-associated NeP was higher than among SCI-only patients for inpatient admissions (27.4% vs 22.1%), emergency department visits (36.7% vs 26.4%), and office visits per patient (mean ± SD: 13.0±9.5 vs 9.5±8.3); all P values were <.001. All-cause expenditures showed adjusted incremental costs of $22,545 (95% confidence interval, $19,010-$26,168) per patient with SCI-associated NeP during the 12-month postindex period."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Patients with evidence of NeP secondary to SCI have significantly higher health care utilization and total costs compared with SCI patients without evidence of NeP. Factors contributing to NeP in patients with SCI need to be clinically assessed to determine the optimal approach for treating these individuals."
          }
        ]
      },
