      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "There is currently no standardised management protocol following functional endoscopic sinus surgery. This study assessed frequent endoscopic cleaning versus minimal intervention in the early post-operative period following such surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Prospective, randomised controlled, single-blinded, within-subject trial involving 24 patients with bilateral chronic rhinosinusitis undergoing bilateral functional endoscopic sinus surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "The primary outcome measure was ethmoid cavity healing, based on endoscopic appearance, graded using a modified Lund-MacKay endoscopic score."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SECONDARY OUTCOME MEASURE",
          "content": "Lund-MacKay symptom score before and after surgery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was no overall statistically significant difference between the two groups (p = 0.37). Subgroup analysis revealed a significant effect of regular suction clearance on adhesions at three months (p = 0.048), but not on oedema, polyps, granulation, discharge or crusting."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "There is no evidence from this study to support frequent endoscopic cleaning in the early post-operative period after functional endoscopic sinus surgery. Less intensive post-operative management is recommended, resulting in decreased patient morbidity and fewer post-operative follow-up appointments."
        }
      ]},
