      "Abstract": {
        "CopyrightInformation": "© 2011 The Gerodontology Society and John Wiley & Sons A/S.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Complete tooth loss among the elderly is still frequent in developing countries and the incidence of temporomandibular disorders (TMD) is a common finding in complete denture wearers."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim of this study was to evaluate the prevalence of temporomandibular disorders (TMD) in a population of complete denture wearers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "The data were collected by four examiners for the diagnosis of use and need for complete dentures followed by the World Health Organization standards and interviews for TMD signs and symptoms evaluation. Exploratory variables included demographic, socio-economic status and TMD prevalence."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The prevalence of TMD among denture wearers was 55.12%. Chi-squared test showed no statistical difference between subjects with or without TMD for gender, geographical location and skin colour (p < 0.05). The number of subjects with TMD increased as the period of complete denture wear increased, although no statistical difference between groups were found (p < 0.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "There is a need of educational programmes aiming at the importance of health care and periodical change of a complete denture, and strategies with a preventive approach to quality general dental care."
          }
        ]
      },
