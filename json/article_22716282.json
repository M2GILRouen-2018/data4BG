      "Abstract": {
        "CopyrightInformation": "© 2012 The Authors. Pain Practice © 2012 World Institute of Pain.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Botulinum toxin is a neurotoxin that has been widely used in chronic pain for the treatment of multiple conditions with a component of localized muscle spasm. Recent studies suggest that botulinum toxin is effective in the treatment of neuropathic pain syndromes such as post-herpetic neuralgia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "We report the case of a 67-year-old man who underwent atypical segmentectomy of a right lower lobe lung nodule. The patient was referred to our pain management department with a of 2-year history persistent pain along the thoracotomy scar having a predominantly neuropathic component, refractory to standard treatments. He was successfully treated with subcutaneous botulinum toxin type A."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "On the basics of our own experience and on the analysis of the reports published in the literature, fractioned subcutaneous injections of botulinum toxin may be useful for the treatment of various chronic localized pain conditions including chronic post-thoracotomy pain."
          }
        ]
      },
