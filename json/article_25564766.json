      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare micronutrient intake status of those overweight and those obese with normal weight adults."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Using total nutrient intake (from foods and supplements) from the National Health and Nutrition Examination Survey (NHANES) 2001-2008, we determined usual intakes for micronutrients using the National Cancer Institute methodology in adults (n = 18,177). Only subjects with reliable dietary records were included and pregnant and lactating females were excluded. Subjects were categorized by body weight status as either normal weight (body mass index [BMI] < 25), overweight (BMI ≥ 25 to < 30), or obese (BMI ≥ 30)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A substantial proportion of the adult population (over 40%) had inadequate intakes of vitamin A, vitamin C, vitamin D, vitamin E, calcium, and magnesium. Compared to normal weight adults, obese adults had about 5% to 12% lower (p < 0.05) intakes of micronutrients and higher (p < 0.01) prevalence of nutrient inadequacy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "We conclude that obese adults compared to normal weight adults have lower micronutrient intake and higher prevalence of micronutrient inadequacy."
        }
      ]},
