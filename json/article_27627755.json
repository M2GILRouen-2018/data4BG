      "Abstract": {
        "CopyrightInformation": "© 2016 The Author(s) Published by S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND/AIMS",
            "content": "To assess the efficacy of intravesical hyaluronic acid (HA) and HA/chondroitin sulfate (CS) instillation in patients with interstitial cystitis/painful bladder syndrome by systematic review and meta-analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A systematic literature search was performed using the keywords: 'interstitial cystitis' or 'painful bladder syndrome' or 'bladder pain syndrome' and 'hyaluronic acid', up to March 31, 2016. The primary outcome was visual analogue scale related pain symptom (VAS). Secondary outcomes were the O'Leary-Sant Interstitial Cystitis Symptom Index (ICSI) and Problem Index (ICPI), frequency, nocturia, bladder volume, and voided urine volume."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Ten articles involving 390 patients were retrieved and assessed in analysis. A significant improvement in mean VAS on fixed-effect and random-effect models (mean difference [MD] -3.654, 95% confidence interval [CI] -3.814 to -3.495, and MD -3.206, 95% CI -4.156 to -2.257, respectively) was found. Significant improvements were found in the ICSI (MD -3.223, 95% CI -4.132 to -2.315) and ICPI (MD -2.941, 95% CI -3.767 to -2.116). Similarly, the other outcomes were significantly improved."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Intravesical HA and HA/CS instillation improved pain symptom, quality of life, and other outcomes and could be included as therapeutic modality of interstitial cystitis/painful bladder syndrome."
          }
        ]
      },
