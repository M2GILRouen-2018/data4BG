      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report a case of glaucomatocyclitic crisis (Posner-Schlossman syndrome) in a child."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Case report. A 13-year-old boy presented with decreased vision, photophobia, halos, and pain in the right eye."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "Findings in this child were consistent with a diagnosis of Posner-Schlossman syndrome."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Glaucomatocyclitic crisis can occur in a child and must be included in the differential diagnosis of uveitis and glaucoma in pediatric patients."
        }
      ]},
