      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2015.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of this study is to introduce and define a disease entity on a continuum of eosinophilic otitis media: eosinophilic mucin otomastoiditis and otopolyposis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A case of a 66-year-old woman with complicated chronic otitis media is reported. A literature review of the National Library of Medicine's online database, with a focus on eosinophilic otitis media and eosinophilic mucin rhinosinusitis, was performed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The authors report the case of a 66-year-old woman with a history of asthma, chronic rhinosinusitis, nasal polyposis, and chronic otitis media who presented with allergic middle ear mucin and otic polyps. Treatment involved a tympanomastoidectomy with removal of otic polyps and steroid therapy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Eosinophilic mucin otomastoiditis with otopolyposis is a disease entity on a continuum of eosinophilic otitis media. This disease process shares similarities with eosinophilic mucin rhinosinusitis. Otic polypectomy and steroids are suggested therapeutic measures."
          }
        ]
      },
