      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To systematically evaluate if an interdisciplinary functional restoration program (FRP), shown to be a viable treatment option for patients with chronic disabling occupational lumbar disorders, is as effective in treating chronic disabling occupational upper extremity disorders."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants were 2484 consecutive patients with either arm or lumbar disorders admitted to an FRP. Analyses compared demographic, psychosocial, and work-related factors, and 1-year post-rehabilitation socioeconomic outcomes."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Socioeconomic outcomes showed that work-return and work-retention rates after successful completion of the FRP did not differ between the two groups, or among the upper extremity subgroups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "FRP is equally effective for patients with chronic upper extremity or lumbar spine disorders, regardless of the injury type, site in the upper extremity, or the disparity in injury-specific and psychosocial factors identified before treatment."
        }
      ]},
