      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Comparison of the clinical efficacy of a transparent, DPI (transparent Rotahaler) with MDI and spacers in childhood asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Open, randomized, crossover trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTINGS",
          "content": "Out patient clinic of a referral pediatric center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Thirty (mean 6.1 +/-2.7 years) children with moderate persistent asthma were randomized to receive long-term medications by a DPI or a metered dose inhaler with spacer for six weeks and then crossed over to receive the same drugs for another period of six weeks after an initial run in period of one week for training in inhalation techniques. The preventative therapy consisted of inhaled Beclomethasone dipropionate (600 mcg/day) and Salbutamol as per requirement. The patients were monitored by a symptom diary, weekly PEFR, and PEFR variability by the parental record of PEFR measurements at home with Mini Wright s Peakflow meter in accordance with the Consensus guidelines."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Comparisons made on weekly symptom scores, PEFR at interval visits, PEFR variability, additional beta sympathomimetic use and acute exacerbations of asthma did not reveal any statistically significant differences during the two treatment periods (>0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Metered dose inhaler and dry powder inhaler have equal efficacy in anti-inflammatory therapy of bronchial asthma in children."
        }
      ]},
