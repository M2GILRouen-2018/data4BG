      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To evaluate the effect of sympathomimetic amine therapy for a life threatening autoimmune disorder."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Dextroamphetamine sulfate was used to treat edema, myalgia, and chronic fatigue associated with autoimmune hepatitis (AIH)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Sympathomimetic amine therapy completely abrogated the symptoms associated with AIH."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "AIH should be added to the long list of chronic treatment-refractory conditions that respond quickly and effectively to treatment with sympathomimetic amines."
        }
      ]},
