      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effects of combined treatment of hormone therapy with strontium-89 for pain from bone metastases in patients with prostate cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Sixteen patients with metastasis prostate cancer received hormone therapy with strontium-89 chloride (89Sr), and 4 of them received radiotherapy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The pain was relieved. Relief occurred in 75.6% of the patients for 3 months, 80.5% for 6 months and 63.4% for 9 months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Hormone therapy enhances the effect of 89Sr without obvious toxicity. The combined treatment not only significantly raises pain palliation, prolongs pain-free survival, but improves the patients life quality."
        }
      ]},
