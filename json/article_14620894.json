      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Caudal epidural steroid injections are used for the symptomatic treatment of radicular lumbosacral pain syndromes, but incorrect injection placement has been recognized as a common problem with the routinely used unguided technique. We aimed to explore the use of sonography to facilitate this procedure."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In patients with clinically unreliable anatomic landmarks, high-resolution real-time sonography was used to identify those landmarks and to assist in correct needle placement."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Sonography enabled localization of the sacral hiatus landmarks. We found this method particularly useful for guiding needle placement in patients with moderate obesity."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Real-time sonography can facilitate caudal epidural steroid injections."
        }
      ]},
