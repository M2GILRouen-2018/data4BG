      "Abstract": {
        "CopyrightInformation": "© 2016 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "To evaluate the efficacy of adjunctive tamsulosin therapy after extracorporeal shockwave lithotripsy (SWL) for renal stones."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "This prospective study was conducted on patients who underwent single-session SWL for solitary renal stone less than 20 mm. Post-SWL, patients were randomly divided into 2 groups; the tamsulosin group (TG), received a daily dose of tamsulosin 0.4 mg, for a maximum of 12 weeks, with post-SWL traditional analgesia and control group (CG), received the traditional analgesia alone."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The study enrolled 271 patients and eventually only 249 (123 in TG and 126 in CG) completed the study. The overall stone free rate was 73.5%: 78.0% in TG and 69.0% in CG (p = 0.108). In TG, 8.1% of patients experienced at least one episode of acute renal/ureteral colic compared with 19.8% of controls (p = 0.008). The mean cumulative analgesia dosage per subject was 313 mg in TG and 346 mg in CG (p < 0.001). Overall, 14 patients developed steinstrasse and 6 of them (all in CG) needed urgent intervention (p = 0.031)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Daily tamsulosin therapy does not enhance the clearance of stone fragments but decreases the pain episodes, analgesia dosage and need for adjuvant intervention after SWL for renal stones."
          }
        ]
      },
