      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report one case of progressive bilateral ureteral stenosis without demonstrable etiologic cause."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We diagnosed and treated a 73-year-old female patient who developed progressive bilateral distal ureteral stenosis without a demonstrable cause."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Surgery was carried out and the pathologic study showed a bilateral ureteral stenosis secondary to fibrosis and chronic unspecific inflammation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Idiopathic ureteral stenosis is a rare clinical picture, more if progressive and bilateral."
        }
      ]},
