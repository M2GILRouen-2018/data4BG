      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To examine the impact of pain education on family members providing home care to elderly patients with cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Quasiexperimental."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Homes of selected patients from two California medical centers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "Fifty family caregivers of patients experiencing cancer-related pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The pain education program included three components: pain assessment, pharmacologic interventions, and nonpharmacologic interventions. Patients and their family caregivers were evaluated prior to initiation of the program and at one and three weeks following the interventions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Quality of life (QOL); knowledge and attitudes about pain; and caregiver burden."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Findings based on measures of QOL and caregiver burden demonstrated the physical and psychological impact of family caregiving and pain management. Comparison between elderly patients with cancer and family caregivers revealed the pain experience's significant impact on family members caring for a loved one in pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The pain education program was effective in improving knowledge and attitudes regarding pain management."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Pain management is a priority for nurses, and use of interventions such as structured pain education improves QOL outcomes for elderly patients and their family caregivers."
        }
      ]},
