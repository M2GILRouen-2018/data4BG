      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier España, S.L. and AEEH y AEG. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe the etiology, symptoms and management of portal vein thrombosis associated with biliary tract infection and to compare our findings with classical causes of pylephlebitis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "We performed a retrospective descriptive study of 10 patients in a tertiary hospital."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Portal vein thrombosis was associated with biliary tract infection in seven patients and with classical causes of pylephlebitis in three. In both groups, symptoms consisted of fever and abdominal pain accompanied by leukocytosis and increased liver enzymes. Blood cultures were positive in most patients and the main complication was liver abscess. The therapeutic management and outcomes were similar in both groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Portal vein thrombosis can be associated with biliary tract infection. Clinical presentation and outcomes are highly similar to those in classical causes of pylephlebitis."
          }
        ]
      },
