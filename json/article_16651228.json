      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND CONTEXT",
          "content": "Brucellosis can affect the musculoskeletal system, and bony involvement ranges from 2% to 70% in the literature. Spinal brucellosis is generally localized to the sacroiliac region; thoracic brucellosis is rarely seen."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To present a case with noncontiguous multilevel thoracic brucellosis with spinal cord compression."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The patient underwent aggressive surgical debridement (posterior decompression, fusion and stabilization, and two noncontiguous level anterior corpectomy and fusion procedures with titanium mesh cages)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At the latest follow-up of 2 years, her clinical, radiological, and laboratory examination showed no recurrence of infection. The neurological examination was completely normal."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Early aggressive debridement and stabilization together with medical treatment, especially in the elderly and immunocompromised patients, would be the most beneficial treatment for eradication of pathology."
        }
      ]},
