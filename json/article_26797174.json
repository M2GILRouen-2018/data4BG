      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Altered pattern of muscle activity is commonly seen with chronic neck pain (CNP). However, limited investigations have been done on dorsal neck muscles' activity pattern while performing upper limb tasks in patients with CNP."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To investigate dorsal neck muscles' thickness changes during isometric contraction of shoulder muscles."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case-control study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This study investigated dorsal neck muscles' thickness changes during isometric contraction of shoulder muscles in 20 healthy participants (mean age 27 ± 4.37) and 17 patients with CNP (mean age 29 ± 5.50). Effects of isometric force of shoulder muscles on dorsal neck muscles' thickness changes were also evaluated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Significant muscle × group interaction was observed for the dorsal neck muscles thickness changes (p = 0.008) indicating different pattern of muscle activity in terms of changes in muscle thickness of two groups. Significant main effects of direction was observed (P = 0.003), with the abduction had the greatest impact on changing the dorsal neck muscles thickness."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "patients with CNP showed altered pattern of muscle thickness changes in comparison to healthy participants. Isometric abduction of shoulder muscles induced the greatest changes of dorsal neck muscles thickness among other force directions."
          }
        ]
      },
