      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine the prevalence of acetabular dysplasia in subjects presenting with hip pain to primary care and its relationship with radiographic osteoarthritis (OA) of the hip."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cross sectional analysis of a prospective cohort."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "35 general practices across the UK."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "195 patients (63 male, 132 female) aged 40 years and over presenting with a new episode of hip pain"
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The prevalence of acetabular dysplasia in this study of new presenters with hip pain was high (32%). There was no significant relationship between acetabular dysplasia and radiographic OA overall."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The high prevalence of acetabular dysplasia across all grades of OA severity suggests that dysplasia itself may be an important cause of hip pain (\"symptomatic adult acetabular dysplasia\")."
        }
      ]},
