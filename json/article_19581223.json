      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To determine whether dry versus moist heat application to the upper extremity improves IV insertion rates."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Two-group, randomized, controlled clinical design."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "An academic cancer infusion center in the western United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "136 hematologic outpatients with cancer or other malignancies."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants were randomly assigned to dry or moist heat with warmed towels wrapped around each patient's arm for seven minutes prior to IV insertion. Skin and room temperatures were monitored pre- and postwarming. Two experienced chemotherapy infusion nurses performed the venipunctures according to protocol. Outcomes were examined using variance analysis, with 34 patients for each combination of nurse and heat type."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Number of IV insertion attempts, time to achieve IV insertion postheating, patient anxiety levels pre- and postheating, and patient comfort."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Dry heat was 2.7 times more likely than moist heat to result in successful IV insertion on the first attempt, had significantly lower insertion times, and was more comfortable. Heat type had no effect on patient anxiety."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Dry heat application decreases the likelihood of multiple IV insertion attempts and procedure time and is comfortable, safe, and economical to use in an outpatient oncology setting."
        }
      ]},
