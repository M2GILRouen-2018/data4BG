      "Abstract": {
        "CopyrightInformation": "Copyright 2017, SLACK Incorporated.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVE",
            "content": "To evaluate the effects of obesity on choroidal thickness (CT) in childhood."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Forty-four patients with obesity (study group) and 42 healthy children (control group) were enrolled in the study. Subjects underwent a complete ocular examination. The mean CT was measured by enhanced depth imaging optical coherence tomography (EDI-OCT). Body mass index (BMI) was calculated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Mean BMI value was 31.8 ± 1.9 in the study group and 19.8 ± 4.4 in the control group. The mean subfoveal CT value 385.77 µm ± 6.09 µm in the study group and 348.43 µm ± 73.21 µm in the control group. There was a significant difference between the study and control groups with regard to subfoveal CT (P = .017). Subfoveal CT and BMI were positively correlated (r = 0.288; P = .004)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "CT increases in childhood obesity. Findings revealed that adiposity causes a significant increase in CT, and it may be related to ocular complications. [Ophthalmic Surg Lasers Imaging Retina. 2017;48:10-17.]."
          }
        ]
      },
