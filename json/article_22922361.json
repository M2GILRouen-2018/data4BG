      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Cancer-related pain is a common problem that may be intractable by medical and neuromodulatory treatment. The dorsal root entry zone (DREZ) is a hyperactive focus in neuropathic pain syndromes, and DREZotomy has been used in selective cases of neuropathic cancer pain."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to describe the technique of spinal DREZotomy in the treatment of cancer pain and review the relevant published literature."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A PubMed database search for 'DREZ', 'dorsal root entry zone' and 'cancer', and a search of the references of these manuscripts, was undertaken."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "14 papers were identified and reviewed that described a total of 123 patients with cancer pain or radiation-induced pain who have been treated with DREZotomy. Though heterogeneous, these studies reported an overall favorable outcome in carefully selected patients with topographically limited pain syndromes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "For patients with well-localized neuropathic cancer pain intractable to medical and first-line surgical management, DREZotomy is a viable treatment option. Further prospective studies are needed to evaluate the outcomes of this procedure."
          }
        ]
      },
