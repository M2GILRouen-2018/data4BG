      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the long term clinical results of postanal repair for idiopathic faecal incontinence."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital, The Netherlands."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "38 patients with idiopathic faecal incontinence."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Clinical outcome and its correlation with anorectal manometry."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After a median follow up of 43 months (15-126) 19 patients were classified grades 1 and 2 (satisfied) and 19 patients grades 3 and 4 (dissatisfied). Six patients deteriorated and went from grades 1 or 2 to grade 3 or 4. Satisfied patients had a significant rise in resting pressure (median 13.5 mmHg, p = 0.01, 95% CI 5 to 25) and dissatisfied patients did not."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Long term follow up of patients after postanal repair shows that half the patients have a good result, although only 21% are fully continent. Long term follow up is necessary as a number of patients deteriorate."
        }
      ]},
