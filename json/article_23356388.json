      "Abstract": {
        "CopyrightInformation": "©2013 The Author(s)/Acta Paediatrica ©2013 Foundation Acta Paediatrica.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To investigate conversations between nurses and parents in Swedish child health services and to assess to what extent attention is directed towards dietary and physical activity behaviours in children."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twenty-three nurses audio-recorded one session each. Recordings were assessed and topics were classified according to predetermined categories."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The three most frequent topics of conversation concerned physical examinations of the child (30% of session time), talking to the child to establish or maintain contact and interest (15%), and development of language skills (12%). Dietary habits came on fourth place (10%), and physical activity ranked 14 (4%)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Attention to dietary and physical activity behaviours in children is infrequent in Swedish child health services. Concern is raised about the efficacy of prevention efforts against childhood obesity."
          }
        ]
      },
