      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine the relationship of patient-perceived and nurse-perceived caring behaviors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Three not-for-profit hospitals in a large metropolitan western city."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Thirty coronary care patients and 30 coronary care nurses."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Larson's nurse caring behaviors (CARE-Q) were rank ordered by the Q-sort method."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The patient's study group perceived behaviors that involved technology as most important, which differed from nurses, who perceived listening as the most important caring behavior."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This study supports the findings of other researchers that patients' and nurses' perceptions of important nurse caring behaviors are divergent."
        }
      ]},
