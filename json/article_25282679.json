      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 National University of Health Sciences. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of this study was to investigate the effect of active vs passive scapular correction on pain and pressure pain threshold at the most symptomatic cervical segment in patients with chronic neck pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twenty-three volunteers with chronic, idiopathic neck pain were recruited (age, 38.9 ± 14.4 years; sex [man/woman], 3/20; Neck Disability Index, 28.1% ± 9.9%). Subjects were randomly allocated to 2 groups: active scapular correction or passive scapular correction. Pressure pain threshold and pain intensity rated on a numerical rating scale during a posteroanterior glide over the most symptomatic cervical segment were measured before and immediately after the active or passive scapular intervention."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Only the active scapular correction produced a reduction in pain (pre, 6.3 ± 1.2; post, 3.7 ± 2.4; P < .05) and increase in pressure pain threshold (pre, 8.7 ± 4.2 kg/cm(2); post, 10.1 ± 3.8 kg/cm(2); P < .05) at the most painful cervical segment."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "An active scapular correction exercise resulted in an immediate reduction of pain and pressure pain sensitivity in patients with chronic neck pain and scapular dysfunction."
          }
        ]
      },
