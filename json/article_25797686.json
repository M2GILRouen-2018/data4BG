      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CONTEXT",
            "content": "Given the growth in the number of bariatric surgeries, it is important for healthcare practitioners to maximize symptom management for these patients, including the option of complementary therapies such as Healing Touch."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "A quasi-experimental study was conducted to determine the feasibility of a Healing Touch intervention for reducing pain, nausea, and anxiety in patients undergoing laparoscopic bariatric surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Following surgery, a nurse administered the Healing Touch intervention once daily. Study participants reported levels of pain, nausea, and anxiety immediately before and after the Healing Touch intervention using separate numeric rating scales."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Significant decreases in pain, nausea, and anxiety were observed immediately following the intervention on post-operative days one and two, and in pain and anxiety on post-operative day three compared with pre-intervention levels. These findings indicate that the Healing Touch intervention is feasible and acceptable to patients undergoing bariatric surgery, and significantly improved pain, nausea, and anxiety in these patients."
          }
        ]
      },
