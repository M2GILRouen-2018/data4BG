      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Acute red eye is a common presentation in both primary and secondary care. Presentation in combination with other systemic symptoms can indicate serious underlying pathology."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE PRESENTATION",
          "content": "73-year-old lady presenting with endogenous endophthalmitis and thoracic discitis secondary to sub-acute bacterial endocarditis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Acute red eye in combination with systemic symptoms requires immediate investigation. If endogenous endophthalmitis is diagnosed, a source of sepsis should be comprehensively investigated and referral made to individual specialties if necessary."
        }
      ]},
