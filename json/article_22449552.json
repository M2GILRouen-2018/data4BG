      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare pain perception using 3 anesthetics (eutectic mixture of local anesthetics [EMLA], vapocoolant spray, and ice) compared with a control (no anesthetic) during botulinum toxin type A (BTX-A) injections for lower limb spasticity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A placebo-controlled, single-blinded study where each study patient served as their own control."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Spasticity clinic."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Subjects (N=30) with ankle spasticity who visited the clinic for BTX-A injections in the gastrocnemius muscle were consecutively sampled."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "The gastrocnemius muscle was divided into 4 quadrants and 1 of the 3 different anesthetic agents was applied to each quadrant with 1 quadrant using no anesthetic, control."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Numerical Rating Scale (NRS) and the Wong-Baker FACES scale."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pain perception using the NRS and FACES scale was significantly lower using ice and EMLA compared with control and spray conditions (P<.05). Pain perception using EMLA and ice was similar. These results indicate that patients experience minimal to moderate pain during BTX-A injections."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Pain relief offered by EMLA and ice was comparable, suggesting that ice is a more convenient option because of brief application time (compared with EMLA). Spray may have made the patients more sensitive to pain and alternative approaches for using vapocoolant should be considered."
          }
        ]
      },
