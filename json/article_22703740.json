      "Abstract": {
        "CopyrightInformation": "Copyright © 2011. Published by Elsevier Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To update evidence-based clinical practice guideline (EBCPG) on the use of massage compared to a control or other treatments for adults (>18 years) suffering from sub-acute and chronic neck pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A literature search was performed from January 1, 1948 to December 31, 2010 for relevant articles. The Ottawa Panel created inclusion criteria focusing on high methodological quality and grading methods. Recommendations were assigned a grade (A, B, C, C+, D, D+, D-) based on strength of evidence."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 45 recommendations from ten articles were developed including 8 positive recommendations (6 grade A and 2 grade C+) and 23 neutral recommendations (12 grade C and 11 grade D)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Therapeutic massage can decrease pain, tenderness, and improve range of motion for sub-acute and chronic neck pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The Ottawa Panel was able to demonstrate that the massage interventions are effective for relieving immediate post-treatment neck pain symptoms, but data is insufficient for long-term effects."
          }
        ]
      },
