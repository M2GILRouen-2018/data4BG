      "Abstract": {
        "CopyrightInformation": "© 2016 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Self-reports tend to differ from objective measurements of food intake, particularly in adults with obesity; however, no studies have examined how neural responses to food (an objective measure) and subjective ratings of food differ by BMI status. This study tested normal-weight women (NWW) and women with obesity (OBW) for group differences in neural indices of attention towards food pictures, subjective ratings of these pictures, and the disparity between objective and subjective measurements."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twenty-two NWW (21.8\u2009±\u20091.7 kg/m(2) ) and 22 OBW (37.0\u2009±\u20095.7 kg/m(2) ) viewed food and flower pictures while late positive potential amplitude, an event-related potential, was recorded. Participants rated pictures for arousal and valence."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Late positive potential amplitude was larger toward food than flower pictures. OBW self-reported flower pictures as more pleasant than food; NWW showed no difference for pleasantness. There were no significant main effects or interactions for arousal. Standardized scores showed that only on subjective, but not objective, measures did OBW compared with NWW disproportionately indicate food pictures as less pleasant than flowers."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Compared with NWW, OBW showed larger discrepancies between neural and subjective reports of attention towards food. Inaccurate self-reports of attention towards food may reduce the efficiency of health interventions."
          }
        ]
      },
