      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "There is currently no information regarding predisposing factors for chronic and recurrent rhinosinusitis (RS), although these are considered to be multifactorial in origin, and allergic diseases contribute to their pathogenesis. We evaluated the predisposing factors that may be associated with chronic and recurrent RS."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In this prospective study, we examined patients with RS younger than 13 years of age, diagnosed with RS at six tertiary referral hospitals in Korea between October and December, 2006. Demographic and clinical data related to RS were recorded and analyzed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In total, 296 patients were recruited. Acute RS was the most frequent type: 56.4% of the patients had acute RS. The prevalences of other types of RS, in descending order, were chronic RS (18.9%), subacute RS (13.2%), and recurrent RS (11.5%). Factors associated with recurrent RS were similar to those of chronic RS. Patients with chronic and recurrent RS were significantly older than those with acute and subacute RS. The prevalences of allergic rhinitis, atopy, and asthma were significantly higher in patients with chronic and recurrent RS than those with acute and subacute RS."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "An association between atopy and chronic/recurrent RS, compared to acute and subacute RS, suggests a possible causal link."
        }
      ]},
