      "Language": "spa",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 SESPAS. Published by Elsevier Espana. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Given the increasing use and importance of mobile telephone applications (apps) in the health setting, this study aimed to ascertain the views of health professionals involved in the treatment of obesity about their current needs and gaps in their requirements, their willingness to use mobile apps, and the features these devices should have for the treatment of obesity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A qualitative study was conducted through semi-structured interviews with experts treating obesity."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The experts believed that apps could be useful to interact or deal with patients. However, their willingness to use apps contrasts with the current limited use of these devices. Practitioners felt that apps could partly compensate for the lack of daily contact between patients and professionals and could increase interaction with patients, achieving more favourable weight control results, especially with regard to improved adherence and motivation. In terms of the functionality and requirements of such apps, the main elements to be included were records of weight, physical activity and food consumption."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Adding apps to the existing treatment of overweight and obesity still requires further definition of its functions. Additionally, further investigation is needed into both the role and involvement of professionals in the design process and during treatment."
          }
        ]
      },
