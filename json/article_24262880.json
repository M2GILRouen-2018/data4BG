      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Survivorship and quality of life issues are becoming increasingly relevant in endometrial cancer as a result of the marked increase in incidence of the disease combined with excellent and improving long term survival."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of this study was to evaluate the effect of obesity on quality of life (QoL) in endometrial cancer survivors."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Participants were endometrioid endometrial cancer survivors diagnosed between 2008 and 2013. Quality of life was measured through the European Organisation for Research and Treatment of Cancer (EORTC) quality of life questionnaire (QLQ-C30, version 3.0). Associations between BMI and quality of life were determined by means of multivariate analyses."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "322 women diagnosed with endometrioid endometrial cancer were invited to participate. Excluded were 15 women with unknown BMI, 40 with non-endometrioid histology and 10 with concurrent cancer. The QLQ-C30 questionnaire was completed by 158 (61.5%) women, of which 63 women (40%) were obese (BMI ≥ 30-39.9), and 30 women (19%) were morbidly obese (BMI ≥ 40). Morbidly obese women reported worse physical, role and social functioning and more somatic complaints."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Morbid obesity is associated with poorer quality of life in endometrial cancer survivors. Life style interventions such as exercise programs and diet interventions could be viable means to improve the quality of life of obese endometrial cancer survivors. Future research should focus on means to improve quality of life in obese endometrial cancer survivors."
          }
        ]
      },
