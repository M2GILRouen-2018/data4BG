      "Abstract": {
        "CopyrightInformation": "© The International Society for Prosthetics and Orthotics 2014.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Surgeons still use a range of criteria to determine whether amputation is indicated. In addition, there is considerable debate regarding immediate postoperative management, especially concerning the use of 'immediate/delayed fitting' versus conservative elastic bandaging."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To produce an evidence-based guideline for the amputation and prosthetics of the lower extremities. This guideline provides recommendations in support of daily practice and is based on the results of scientific research and further discussions focussed on establishing good medical practice. Part 1 focuses on amputation surgery and postoperative management."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Systematic literature design."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Literature search in five databases. Quality assessment on the basis of evidence-based guideline development."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "An evidence-based multidisciplinary guideline on amputation and prosthetics of the lower extremity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The best care (in general) for patients undergoing amputation of a lower extremity is presented and discussed. This part of the guideline provides recommendations for diagnosis, referral, assessment, and undergoing amputation of a lower extremity and can be used to provide patient information."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL RELEVANCE",
            "content": "This guideline provides recommendations in support of daily practice and is based on the results of scientific research and further discussions focussed on establishing good medical practice."
          }
        ]
      },
