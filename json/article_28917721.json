      "Abstract": {
        "CopyrightInformation": "Copyright © 2017. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Semaphorin-4D (CD100), generated by CD4/CD8 cells, plays an important role in T cells activation. It also regulates B cell differentiation via its receptor the CD72. Both have soluble forms - sCD100/sCD72."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "sCD100 and sCD72 levels were determined by ELISA (MyBioSource, USA)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "28 chronic HIV patients and 50 matched healthy volunteers participated in our study. Before treatment, CD4 cell counts were 267±216cells/mcl and viral load (VL) was 586,675±1,897,431copies/ml. Two years following HAART, CD4 cell counts rose to 475±264cells/mcl and VL dropped to 2050±10,539copies/ml. CD8 cell counts were stable. sCD72 levels prior and following HAART were similar to control levels. sCD100 levels before and following HAART were significantly lower compared to controls despite the significant increase in CD4 cell counts."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The permanent low levels of the immunoregulator sCD100 suggests a role for CD100 in the immune dysfunction and T cell exhaustion of HIV."
          }
        ]
      },
