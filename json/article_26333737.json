      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 by The Journal of Bone and Joint Surgery, Incorporated.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Metastatic spinal cord compression is a disastrous consequence of non-small-cell lung cancer (NSCLC). There have been few studies of the outcomes or prognostic factors in patients with metastatic spinal cord compression from NSCLC treated with surgery and adjuvant therapies."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "From 2002 to 2013, 116 patients with metastatic spinal cord compression from NSCLC treated with surgery and adjuvant therapies were enrolled in this retrospective analysis. Kaplan-Meier methods and Cox regression analysis were used to estimate overall survival and identify prognostic factors for survival."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Multivariate analysis suggested that the Eastern Cooperative Oncology Group performance status (ECOG-PS), preoperative and postoperative Frankel scores, postoperative adjuvant radiation therapy, and target therapy were independent prognostic factors. Ninety patients died at a median of twelve months (range, three to forty-seven months) postoperatively, and twenty-six patients were still alive at the time of final follow-up (at a median of fifteen months [range, five to fifty-four months])."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The complete disappearance of deficits in spinal cord function after surgery was the most robust predictor of survival. Adjuvant radiation therapy and target therapy were also associated with a better prognosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "Prognostic Level IV. See Instructions for Authors for a complete description of levels of evidence."
          }
        ]
      },
