      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "CONCEPT",
          "content": "Drug seeking behavior (DSB) is often mixed in illicit drug diversion confounding legitimate attempts to control acute and chronic pain."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To review the literature of acute and chronic pain control against the medical and legal context of DSB."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective literature review from National Library of Medical Computerized Data Base 1990--2004."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Preference to human prospective on retrospective clinical trials."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Drug use and abuse have significant adverse consequences. Pain control is desirable and necessary with chronic pain syndromes more prone to DSB. This behavior can be accurately profiled and information used to assist recovery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "It is desirable to address DSB stressing acceptance and a multidisciplinary approach to recovery."
        }
      ]},
