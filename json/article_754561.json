        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Stomach perforation after cardiopulmonary resuscitation is a rare finding. This is mainly caused by incorrect management of the airway during CPR performed by non-medical personnel."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PRESENTATION OF CASE",
            "content": "We report a case of 72year old female who sustained a stomach perforation during prolonged CPR in an out of hospital arrest situation. This was diagnosed on a computed tomography scan of the abdomen requiring midline laparotomy and a primary repair of the stomach."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "The training of medical and non-medical persons in cardiopulmonary resuscitation is to be encouraged. However it should be emphasized that any technique which breaches the normal integrity of the body can itself lead to life-threatening complications."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "A high degree of vigilance is required in patients presenting after a cardiac arrest and CPR."
          }
        ]
      },
