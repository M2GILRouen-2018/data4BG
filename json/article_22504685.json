      "Language": "jpn",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "It has been confirmed by several clinical trials that the fentanyl patch causes less adverse events than sustained-release oral morphine, and after rotation. However, there has been no evidence comparing the fentanyl patch with controlled-release oral oxycodone in terms of adverse events."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "We prospectively investigated the reduced effects of adverse events caused by sustained-release oral morphine and controlled-release oxycodone after rotating to the fentanyl patch in patients with metastatic breast cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Metastatic breast cancer patients requiring sustained-release oral morphine or controlled-release oral oxycodone(n=9, 2 taking oral morphine, 7 taking oral oxycodone, mean age, 57. 5 years)were recruited. Those experiencing adverse events from oral morphine or oral oxycodone were administered a fentanyl patch."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The pain score was reduced significantly at the 4th week. The fentanyl patch was associated with significantly less nausea, vomiting, constipation, sleepiness and dizziness over the study period."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This study suggested that the fentanyl patch can reduce adverse events caused by sustained-release oral morphine as well as controlled-release oral oxycodone."
        }
      ]},
