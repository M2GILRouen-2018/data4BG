      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "In asthmatic patients receiving long-term inhaled corticosteroid therapy, there are concerns regarding the potential for developing systemic adverse effects on bone metabolism, possibly even in the absence of adrenal suppression."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of this study was to investigate whether exposure to inhaled ciclesonide at high vs. low doses over 1 yr causes any significant systemic adverse effect on sensitive biomarkers of bone turnover in asthmatic patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Post hoc analysis of stored samples was performed in a subgroup of patients from a prospective, randomized parallel group trial with 1 yr follow-up."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "We conducted a primary care study in Tayside, Scotland."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "A total of 164 mild-moderate persistent asthmatics aged 18-65 yr with evidence of airway hyperresponsiveness using mannitol bronchial challenge were enrolled into the original study. Of the 119 completed patients per protocol, 100 participants had bone marker samples available for analysis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Ciclesonide was titrated to control persistent asthma against either mannitol bronchial challenge [airway hyperresponsiveness (AHR) strategy] or a control group (based on symptoms, reliever use, and pulmonary function) over 1 yr."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "We measured markers of bone formation [amino-terminal propeptide of type I collagen (PINP), amino-terminal propeptide of type III collagen (PIIINP)], resorption [carboxy-terminal telopeptide of type I collagen (ICTP), type I collagen cross-linked C-telopeptide (CTx)], and adrenal suppression (overnight urinary cortisol/creatinine ratio) at 0 and 12 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Mean ciclesonide doses after 12 months were: AHR, 507 μg/d (n = 50); and controls, 202 μg/d (n = 50) (P < 0.00001). There were no significant differences between AHR and control groups either at baseline or after 12 months in PINP, PIIINP, ICTP, or CTx; or in ratios of bone turnover as PINP/ICTP, PIIINP/CTx, or overnight urinary cortisol/creatinine ratio."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Higher doses of inhaled ciclesonide do not adversely affect sensitive markers of bone turnover in persistent asthmatics over 12 months."
        }
      ]},
