      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To report a successful treatment of an atypical case of pseudotumor cerebri."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Pseudotumor cerebri is a disorder of raised intracranial pressure. Multiple Case Series have been published about its treatment with sinus stenting. All these cases have had typical presentations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "An atypical fulminant case of pseudotumor cerebri which was treated successfully with venous sinus stenting."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Venous sinus stenting can be done effectively in atypical cases of pseudotumor cerebri."
        }
      ]},
