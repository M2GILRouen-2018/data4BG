      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the effect of using hydroxyethyl starch (HES) for intraoperative fluid therapy on outcomes in high-risk vascular surgery patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective case series."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Single-center academic hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "The study included 1,395 adult vascular surgery patients with peripheral vascular disease."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Retrospective review of hospital databases."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "Outcomes were compared between patients who were intraoperatively administered HES (Voluven [Fresenius Kabi, Bad Homburg, Germany] or Pentaspan [Bristol-Myers Squibb Canada, Montreal, Quebec, Canada]) versus patients who received only crystalloids during their procedure. Logistic regression was used to assess for association between these groups and mortality (in-hospital, 30-day), intensive care unit admission, hemodialysis requirement, vasopressor requirement, and ventilator requirement. Overall, 796 patients had complete fluid records and were included in the analysis. After adjustment for potential confounders, receiving an HES solution was associated with increased likelihood of 30-day mortality (odds ratio [OR] 2.11, 95% confidence interval [CI] 1.05-3.80), postoperative requirement for hemodialysis (OR 6.17, 95% CI 1.09-35.10), intensive care unit admission (OR 3.52, 95% CI 2.15-5.74), and mechanical ventilation (OR 3.16, 95% CI 1.84-5.41)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Intraoperative administration of HES was associated with an increased likelihood of adverse outcomes compared with use of crystalloids alone."
          }
        ]
      },
