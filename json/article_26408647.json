      "Abstract": {
        "CopyrightInformation": "© 2015, Human Factors and Ergonomics Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "In the present study, we examined the effect of working while seated, while standing, or while walking on measures of short-term memory, working memory, selective and sustained attention, and information-processing speed."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The advent of computer-based technology has revolutionized the adult workplace, such that average adult full-time employees spend the majority of their working day seated. Prolonged sitting is associated with increasing obesity and chronic health conditions in children and adults. One possible intervention to reduce the negative health impacts of the modern office environment involves modifying the workplace to increase incidental activity and exercise during the workday. Although modifications, such as sit-stand desks, have been shown to improve physiological function, there is mixed information regarding the impact of such office modification on individual cognitive performance and thereby the efficiency of the work environment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "In a fully counterbalanced randomized control trial, we assessed the cognitive performance of 45 undergraduate students for up to a 1-hr period in each condition."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The results indicate that there is no significant change in the measures used to assess cognitive performance associated with working while seated, while standing, or while walking at low intensity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These results indicate that cognitive performance is not degraded with short-term use of alternate workstations."
          }
        ]
      },
