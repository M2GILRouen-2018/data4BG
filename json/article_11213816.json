      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the outcome of open and laparoscopic splenectomy for haematological diseases in terms of quality of life and haematological measures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective non-randomised study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary care hospital, USA."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "44 patients, 27 treated laparoscopically and 17 by open splenectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Quality of life judged by the SF-36 and adequacy of control of the haematological disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Both quality of life and haematological disease were significantly improved by operation; laparoscopically treated patients had less pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In properly selected patients laparoscopic splenectomy is preferable to open splenectomy."
        }
      ]},
