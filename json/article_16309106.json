      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To further analyze and identify effective components of anti-asthma in acupuncture serum."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Changes of eosinophils in the peripheral blood of rats with eosinophilia were observed for 10 days after intravenous injection of the different segments of serum (serum: normal saline = 1:20, 2.5 mL/kg, from the first day of the model establishment, for 3 consecutive days)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After intravenous injection of different segments of serum, the eosinophil counts in the peripheral blood decreased significantly from the 3rd day as compared with those of the model group (P<0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The effective components of acupuncture serum from asthmatic rats treated by acupuncture for eosinophils are not a single component, and acupuncture stimulation may produce many kinds of components of anti-asthma."
        }
      ]},
