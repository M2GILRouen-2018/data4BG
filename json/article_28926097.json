      "Abstract": {
        "CopyrightInformation": "© 2017 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose of this report is to provide clinical strategies to manage patients with schizophrenia taking clozapine."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Serious side effects and required blood monitoring impede the use of clozapine, despite the benefits of clozapine for managing psychiatric symptoms. Well-managed patients receiving evidence-based interventions exhibit reduced symptoms, improved functioning, and better adherence to treatment."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Preexisting medical conditions should be considered before prescribing clozapine. Ongoing education on medication and mental illness for patients and family members is essential to prepare them for adherence to management plans. Healthcare providers are responsible for monitoring the side effects of clozapine."
          }
        ]
      },
