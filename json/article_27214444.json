      "Abstract": {"AbstractText": [
        {
          "Label": "UNLABELLED",
          "content": "Theme: Parenting/parenthood."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "As delivering care is an inherent part of becoming parents, providing high-level care to the child with health problems might be a burden for the caregiver."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "This systematic review investigated the effects of caregiver burden of parents who are primarily responsible for the caring of children with asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "PubMed, CINAHL, Web of Science and Scopus databases were searched for the studies published between 2000-2015. Key search terms used were 'caregiver', 'burden, 'childhood asthma' and 'parent'."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 23 studies were examined for this review."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Providing care to the child with asthma affects parents as caregivers negatively. Caregivers of the children with asthma often experience anxiety, fear, disappointment, grief, physical distress and low quality of life as the outcomes of caregiving burden."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "It is absolutely crucial to determine caregiver burden risks and protective factors since wellness level of caregivers affect the asthma management practices and decisions."
        }
      ]},
