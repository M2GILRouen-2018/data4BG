      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the efficacy of single infusion of bisphosphonate AHPrPB (APD) (60 mg) in active Paget's disease of bone."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Twenty-six patients with symptomatic Paget's disease of bone were treated with a single infusion of APD (60 mg) over 12 h and were assessed for clinical as well as biochemical improvement for a mean period of 2 years. Treatments were repeated if relapse occurred during followup."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Bone pain improved in 92% of patients within one month and over 76% of patients had no pain at 6 months. Serum alkaline phosphatase fell to normal level in 78% of patients at 6 months and about 77% at one year. Further treatment with intravenous (iv) APD (60 mg) was given for relapse in 7 patients at one year, 13 at 18 months and 2 at 24 months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Our prospective study demonstrates that 60 mg APD given iv is an effective, simple, safe and less expensive treatment for active Paget's disease of bone and this therapy may well be given in a daycare unit or an outpatient setting."
        }
      ]},
