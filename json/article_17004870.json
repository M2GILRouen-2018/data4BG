      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Bilioenteric fistulas are rare complications of cholecystolithiasis that are associated with high morbidity and mortality and mainly appear in elderly patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE PRESENTATION",
          "content": "This is the report of a patient suffering from cholecystoduodenal fistula with additional cholecystocolonic fistula."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "This cholecystocolonic fistula provoked a short bowel syndrome with symptomatic diarrhea and prevented an upper gastrointestinal ileus caused by the large perforated gallstone into the duodenum. This interesting constellation has not been described in literature yet."
        }
      ]},
