      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Patellar resurfacing during total knee arthroplasty (TKA) remains controversial. The aim of this study was to evaluate the long-term outcomes of a mobile-bearing TKA without patellar resurfacing."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We assessed the outcomes in 503 patients (600 knees) who had cemented LCS (low contact stress) mobile bearing TKA without patellar resurfacing at a minimum follow-up of 10 years. Clinical outcome scores and radiological assessment were used."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Four knees were revised, two had bearing dislocation and nine patients (1.5%) had secondary resurfacing for anterior knee pain. There were no radiolucent lines or osteolytic defects on radiographic evaluation. The overall survivorship was 97.8% with re-operation for any reason as the endpoint."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Non-resurfacing of the patella does not adversely affect the outcome of the LCS mobile bearing TKA at minimum 10 years follow-up."
          }
        ]
      },
