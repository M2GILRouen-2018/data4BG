      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The aim of the present study was to determine whether certain background factors such as gender, education and social status were associated with an individual's knowledge of coronary heart disease (CHD) risk factors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A questionnaire survey."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A questionnaire survey designed to evaluate participants' general knowledge about the risk factors for CHD was used. A total of 1011 50-year-old individuals (457 men and 554 women) from 34 Health Care Centers participated in the study."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Knowledge about CHD risk factors was significantly poorer in men than in women. Low education and low socio-economic status were other factors related to poor knowledge of CHD risk factors."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This study showed that men with low educational level and low socio-economic status had inadequate information about the risk factors involved in CHD."
        }
      ]},
