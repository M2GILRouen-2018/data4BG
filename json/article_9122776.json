      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A survey of pain intensity and psychological symptoms in patients with chronic neck pain after whiplash injury."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To describe the pain and psychological profiles of patients with chronic whiplash."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Reports in the literature mention a constellation of symptoms associated with chronic whiplash injury but no systematic survey using objective patient report measures has been reported."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "One hundred forty consecutive referred patients with chronic neck pain after a motor vehicle accident were studied using the SCL-90-R psychological profile and the McGill Pain Questionnaire."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Psychological profiles and pain intensity ratings, similar to profiles obtained from patients suffering from rheumatoid arthritis and low back pain of organic origin, were obtained."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The SCL-90-R is a convenient instrument to administer to patients with whiplash. It yielded a characteristic profile of pain and appears to be more expedient than other psychometric tests for these patients."
        }
      ]},
