      "Abstract": {
        "CopyrightInformation": "© Georg Thieme Verlag KG Stuttgart · New York.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Emotional parentification is considered harmful to a child's development."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A total of about 975 patients were examined at a Department of Psychosomatic Medicine and in the practices of general practitioners with regard to childhood adversities."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Emotional parentification is a risk factor for 2 symptom groups: the patients with depression and the patients with somatoform pain. While the occurrence of depression is mainly predicted by maternal emotional parentification, paternal influences are also relevant in regard to the development of somatoform pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Emotional parentification is an important risk factor for the occurrence of psychological and somatoform complaints in adulthood. This is especially apparent in combination with further risk factors, such as low reported values for love, sexual abuse, or being raised without a father."
          }
        ]
      },
