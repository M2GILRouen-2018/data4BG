      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Interstitial cystitis (IC) is a common cause of pelvic pain in the general female population and is thought to be understated in young female patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "A 12-year-old girl with IC and endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "A single case report."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "It is important to screen for IC in young patients with endometriosis and vice versa."
        }
      ]},
