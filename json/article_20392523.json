      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "A prospective randomized unblinded controlled trial was conducted by comparing acellular dermis with temporalis fascia as graft materials in tympanoplasty (type 1) in terms of operative time, postoperative pain, graft success rate, and audiologic outcome."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Forty-two patients with (inactive) chronic suppurative otitis media of tubotympanic type were randomized, matched, and divided equally into 2 groups of 21 each. One group underwent tympanoplasty (type 1) via transcanal route using temporalis fascia graft and the other using acellular dermis. Both groups were compared for operative time, postoperative pain, graft success rate, and audiologic improvement in hearing."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was a statistically significant reduction in operative time (P < .05) and postoperative pain (P < .05) in the acellular dermis group. However, there was no statistical difference in graft success rate (P > .05) and hearing improvement (P > .05) between both the groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Results of tympanoplasty using acellular dermis as graft material are comparable to that using temporalis fascia in terms of graft uptake and hearing improvement. However, tympanoplasty using acellular dermis has the advantage of shorter operative time and lesser postoperative pain."
          }
        ]
      },
