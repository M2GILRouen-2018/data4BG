      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To determine the effectiveness of epidural scopolamine in preventing nausea and vomiting in patients receiving epidural morphine."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, double-blind study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Inpatient surgery clinic at a regional general hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "50 patients undergoing major abdominal and lower limb surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Morphine alone 2.5 to 4 mg was administered via epidural catheter to one group, while the other group received morphine plus scopolamine 0.25 mg via epidural catheter."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Occurrence of nausea and vomiting was recorded during the first postoperative day. Compared with the morphine alone group, the incidence of nausea and vomiting was significantly lower in the morphine plus scopolamine group without difference in the adequacy of analgesia."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Epidural scopolamine can be used as an adjunct to epidural morphine in effectively reducing the incidence of postoperative nausea and vomiting."
        }
      ]},
