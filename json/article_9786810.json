      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Exercise stress testing in patients with abdominal aortic aneurysms may cause enlargement or rupture of aneurysms."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the safety of treadmill exercise stress testing in patients with abdominal aortic aneurysms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective descriptive study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary care center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "262 patients who had abdominal aortic aneurysms more than 4 cm in diameter and underwent treadmill exercise stress testing."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Pain after stress testing, rupture of the aneurysm or death, aneurysm size, and exercise stress test results."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The average aneurysm diameter was 5.5 +/- 1.1 cm. One patient with a 6.1-cm aneurysm was found to have a contained rupture 12 hours after stress testing. The event rate for aneurysm rupture was 0.4% (95% CI, 0.0% to 2.1%). No deaths or other negative outcomes were documented."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Despite theoretical concerns, exercise stress testing of patients with abdominal aortic aneurysms seems to be safe and is associated with a low incidence of acute adverse events."
        }
      ]},
