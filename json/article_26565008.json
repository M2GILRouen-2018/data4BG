      "Abstract": {
        "CopyrightInformation": "© The Author 2015. Published by Oxford University Press for the Infectious Diseases Society of America. All rights reserved. For permissions, e-mail journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Managing recurrent Clostridium difficile infection (CDI) presents a significant challenge for clinicians and patients. Fecal microbiota transplantation (FMT) is a highly effective therapy for recurrent CDI, yet availability of a standardized, safe, and effective product has been lacking. Our aim in this study was to assess the safety and effectiveness of RBX2660 (microbiota suspension), a commercially prepared FMT drug manufactured using standardized processes and available in a ready-to-use format."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Patients with at least 2 recurrent CDI episodes or at least 2 severe episodes resulting in hospitalization were enrolled in a prospective, multicenter open-label study of RBX2660 administered via enema. Intensive surveillance for adverse events (AEs) was conducted daily for 7 days following treatment and then at 30 days, 60 days, 3 months, and 6 months. The primary objective was product-related AEs. A secondary objective was CDI-associated diarrhea resolution at 8 weeks."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of the 40 patients enrolled at 11 centers in the United States between 15 August 2013 and 16 December 2013, 34 received at least 1 dose of RBX2660 and 31 completed 6-month follow-up. Overall efficacy was 87.1% (16 with 1 dose and 11 with 2 doses). Of 188 reported AEs, diarrhea, flatulence, abdominal pain/cramping, and constipation were most common. The frequency and severity of AEs decreased over time. Twenty serious AEs were reported in 7 patients; none were related to RBX2660 or its administration."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Among patients with recurrent or severe CDI, administration of RBX2660 via enema appears to be safe and effective."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CLINICAL TRIALS REGISTRATION",
            "content": "NCT01925417."
          }
        ]
      },
