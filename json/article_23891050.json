      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Chlamydophila pneumoniae is a common agent of respiratory infections. Severe acute neurological infections are very infrequently linked to this bacterium. We report such a case and give a rapid overview of published cases of acute encephalitis occurring after a respiratory infection due to C. pneumoniae."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT AND METHODS",
            "content": "A 12-year-old child without any prior medical history was hospitalized for encephalitis associated to respiratory symptoms."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "C. pneumoniae DNA was identified by multiplex PCR assay in respiratory secretions and C. pneumoniae IgM and IgG antibodies were assessed in the serum. This bacterium was not detected in CSF, nor was any other pathogen. A macrolide treatment was prescribed for two weeks. The outcome was good without any sequels."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This observation correlates to the few similar cases reported in the medical literature. C. pneumoniae must be suggested in the etiological diagnosis of acute encephalitis, notably in a context of respiratory infection, when no more common cause can be identified."
          }
        ]
      },
