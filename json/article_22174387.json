      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "The aim of the present study was to evaluate the effectiveness of microsurgical varicocele repair in patients with grade III lesions and chronic dull scrotal pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "The study was based on 8 patients with grade III left-sided varicocele and chronic dull scrotal pain for whom a microsurgical subinguinal varicocele repair was performed. The 1-year follow-up included pain assessment and scrotal examination."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of the 8 patients, 7 (88%) reported complete resolution of pain with no palpable varicocele on scrotal examination. No cases of testicular atrophy or hydrocele formation were reported."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "These results indicated that microsurgical varicocele repair may benefit patients with grade III lesions and chronic dull scrotal pain."
        }
      ]},
