      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To define threshold limit values and legally binding occupational exposure limits."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Review of suitable literature."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY SELECTION",
          "content": "Studies based on detailed descriptions and/or measurements of airborne allergenic dust, total allergens, or even key allergens were selected."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Prevalences of IgE-mediated sensitization and occupational asthma are related to the aeroallergen load in workplaces. Data to set threshold limit values for flour, latex, a-amylase, and isocyanates are already sufficiently available."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "To optimize primary prevention in workplaces,health-based occupational exposure limits should be set for major occupational allergens."
        }
      ]},
