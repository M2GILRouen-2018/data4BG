      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To compare diagnostic value of electron-beam CT (EBT) and multislice CT (MSCT) angiography in detection of coronary artery stenosis in patients with coronary artery disease (CAD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "140 CAD patients who had undergone EBT (n = 97) or 4-slice CT (n = 43) coronary angiography and conventional coronary angiography as a gold standard were included in the study."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Sensitivity and specificity of EBT angiography in coronary stenosis detection (proximal and mid segments) were 86 and 97%, respectively. Sensitivity and specificity of MSCT angiography were 87 and 98%, respectively. 6 and 7% of coronary segments were excluded from the study because of bad image quality in EBT and MSCT groups, respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "No significant difference was registered in diagnostic value of EBT and 4-slice MSCT angiography in coronary artery stenosis detection."
        }
      ]},
