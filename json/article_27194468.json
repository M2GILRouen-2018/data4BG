      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Recent studies have suggested that coronary perivascular adipose tissue (PVAT) impairs coronary vasomotion, so we examined whether PVAT is increased at the spastic coronary segment in patients with vasospastic angina (VSA)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "METHODS\u2004AND\u2004RESULTS",
          "content": "PVAT volume in the left anterior descending (LAD) coronary arteries on CT coronary angiography was significantly increased in 48 VSA patients with LAD spasm compared with 18 controls (30.7±2.0 vs. 21.0±3.2 cm(3), P=0.01), whereas that of total epicardial adipose tissue was comparable between the 2 groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The results suggested an important role of PVAT in the pathogenesis of coronary spasm. (Circ J 2016; 80: 1653-1656)."
        }
      ]},
