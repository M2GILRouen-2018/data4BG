      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 International Federation of Gynecology and Obstetrics. Published by Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Definitive management with hysterectomy could be appropriate for some patients with endometrial cancer and its precursor lesions, but poses challenges for those desiring future fertility."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To review risk factors for endometrial hyperplasia/cancer among premenopausal women and discuss management options for fertility preservation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SEARCH STRATEGY",
            "content": "A literature search through the PubMed, Ovid, and Cochrane databases was conducted using the terms \"endometrial hyperplasia\" and \"endometrial cancer,\" cross-referenced with \"fertility preservation.\""
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SELECTION CRITERIA",
            "content": "All articles published in English between January 1, 2000, and January 1, 2015, were considered if they were readily available online."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA COLLECTION AND ANALYSIS",
            "content": "Articles were analyzed and information was synthesized into a comprehensive review."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Chronic anovulation, obesity, polycystic ovarian syndrome, metabolic syndrome, insulin resistance, and type 2 diabetes mellitus must be appreciated as risk factors for endometrial pathology. Providers must exert vigilance in identifying patients at risk and in initiating pre-emptive strategies. Risk reduction with lifestyle modification, weight loss, and glycemic control can improve regression and overall health. Fertility outcomes for these patients are promising, especially with assisted reproductive technology."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Conservative management could be appropriate for carefully selected women with complex atypical endometrial hyperplasia or early-stage endometrial cancer who desire future fertility."
          }
        ]
      },
