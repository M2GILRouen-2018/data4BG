      "Abstract": {
        "CopyrightInformation": "© 2015 American Academy of Pain Medicine. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "Label": "OBJECTIVE",
            "content": "To evaluate the effectiveness of a computer tablet as a distraction tool for minimizing pain and distress in children undergoing an injection."
          },
          {
            "Label": "DESIGN",
            "content": "Using an experimental design, the subjects were randomly assigned to either participate in tablet distraction or receive no distraction during an injection."
          },
          {
            "Label": "SETTING",
            "content": "A pediatric clinic in a small city in the Southeast region of the United States."
          },
          {
            "Label": "SUBJECTS",
            "content": "Forty-one children, ages 4-11 years, who were receiving an immunization and their parents."
          },
          {
            "Label": "METHODS",
            "content": "During an injection, children either participated in distraction using a computer tablet or did not receive distraction according to their group assignment. Children's emotional response was assessed using a behavioral observation to examine distress. Pain was also measured using a behavior observation scale. After the injection, children reported the level of pain they felt during the injection."
          },
          {
            "Label": "RESULTS",
            "content": "A significant difference was found for pain, both self-reported and observed, and observed emotions. Children receiving distraction using a tablet displayed significantly higher amounts of pain and negative emotions. Gender differences in pain and emotions were found with females having a significantly higher amount of pain and negative emotions."
          },
          {
            "Label": "CONCLUSIONS",
            "content": "The use of a tablet as a distraction was not effective in decreasing pain and distress in children receiving an injection."
          }
        ]
      },
