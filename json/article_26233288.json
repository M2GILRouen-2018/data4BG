      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 North American Society for Pediatric and Adolescent Gynecology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To demonstrate that adenomyosis is a rare cause of dysmenorrhea or chronic pelvic pain (CPP) in the adolescent population that can be identified with magnetic resonance imaging (MRI) and to report resolution of adenomyosis by MRI after a course of hormonal suppression in 4 adolescents."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN, SETTING, AND PARTICIPANTS",
            "content": "Retrospective case series of 4 adolescents with adenomyosis on pelvic MRI at Texas Children's Hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Continuous oral contraceptive (COC) therapy or leuprolide acetate."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Lesions on pelvic MRI after treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We reviewed medical records of 4 adolescents with CPP and adenomyosis on T2-weighted pelvic MRI. All patients had initial diagnostic pelvic MRI and then definitive hormonal intervention. Repeat imaging was obtained after a symptom-free interval."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patient ages ranged from 12 to 16 years. One patient had resolution of symptoms with COC therapy. MRI performed 3 years later showed no adenomyosis. Three patients failed COC therapy. All were symptomatically improved after therapy with a gonadotropin-releasing hormone agonist. Follow-up MRI performed at intervals between 6 months and 3 years showed resolution of adenomyosis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "MRI can raise suspicion for the diagnosis of adenomyosis in adolescents with refractory CPP. Subsequent MRI can show regression of lesions after symptom resolution with hormonal therapy."
          }
        ]
      },
