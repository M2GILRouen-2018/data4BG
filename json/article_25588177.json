      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The influence of hormonal fluctuations on pain and mastication was evaluated in patients with painful temporomandibular disorder (TMD) symptoms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Fifty women were assigned to menstrual cycle and oral contraceptive groups (n = 25). Their TMD was diagnosed by Research Diagnostic Criteria for Temporomandibular Disorders. Pain levels, maximum oclusal force (MOF), and masticatory performance (MP) were measured in all menstrual cycle phases."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A lower pain level was observed in the ovulatory phase when compared to menstrual and luteal phases (P = .02). No differences were found regarding MOF (P = .20) or MP (P = .94)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Hormonal fluctuations intensify pain in women with symptomatic TMD without impairing mastication."
        }
      ]},
