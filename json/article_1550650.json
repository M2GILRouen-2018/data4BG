      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "We aimed to evaluate periarticular multimodal drug injection (PMDI) in bilateral total knee arthroplasty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In 154 knees of 77 patients, PMDI was administered intraoperatively through the regions other than posterior capsule to one knee; other knee was control."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Drug-injected knees had lower visual analog scale scores and higher passive range of motion postoperatively (p < 0.05). The active straight leg raise was higher in drug-injected knees (47 [61%] vs 19 [24.7%], p = 0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "PMDI is a safe and effective method of early postoperative pain management in total knee arthroplasty when applied through regions other than posterior capsule."
        }
      ]},
