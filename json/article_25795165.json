      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Diabetes India. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND AIMS",
            "content": "Recent data shown that both general and central obesity indices are significantly associated with diabetes (T2DM) and prediabetes (impaired glucose tolerance [IGT] and impaired fasting glucose [IFG]). Data regarding association of obesity with T2DM and prediabetes in rural Bangladeshi population is scarce. This study aims to observe the association of general and central obesity with diabetes (T2DM) and prediabetes in rural Bangladeshi population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "A total of 2293 rural Bangladeshi adults aged ≥20 years were randomly selected in a population-based, cross-sectional survey which was conducted in 2009. The association of general (defined by body mass index [BMI]) and central obesity (defined by waist circumference [WC] and waist hip ratio [WHR]) with T2DM and prediabetes was assessed by using receiver operating characteristic curve analysis and logistic regression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Subjects with T2DM, IGT and IFG had a higher rate of general and central obesity than normal subjects. WHR was more closely associated with T2DM than WC and BMI. However, all three obesity indices were significantly associated with IGT and IFG."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In rural Bangladeshi population, both general and central obesity showed good association with T2DM and prediabetes."
          }
        ]
      },
