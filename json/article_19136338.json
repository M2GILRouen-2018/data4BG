      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To determine whether a difference exists in perceived pain during preprocedure anesthetic injection for bone marrow biopsy between buffered and unbuffered lidocaine, to determine whether pain levels change over time, and to investigate relationships between perceived pain scores and other variables."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A double-blind, randomized, experimental, crossover design."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A large hospital in the midwestern region of the United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "48 patients undergoing bone marrow biopsy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The patients served as their own controls for the bilateral procedure. A 100 mm visual analog scale measured pain. A demographic questionnaire gathered the between-subjects exploratory variables."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Perceived pain scores and type of lidocaine anesthetic solution (buffered versus unbuffered)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Participants reported significantly lower pain scores on the side anesthetized with buffered lidocaine compared with the side anesthetized with unbuffered lidocaine. Higher pain scores were reported on the treatment side for participants who had received more than two surgical procedures. Patients who were members of a minority group had higher mean pain scores than Caucasians on the control side."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Buffered lidocaine is superior to unbuffered lidocaine as an anesthetic for bone marrow biopsy procedures."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "Advanced practice nurses perform a significant number of bone marrow biopsies and aim to improve patient comfort during invasive procedures. Use of unbuffered lidocaine should be questioned."
        }
      ]},
