      "Language": "rus",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Assessment of effects of a 3-month course of atorvastatin and a nicotinic acid derivative acipimox on the lipid spectrum, platelet aggregation, results of brachial artery reactive hyperemia test and clinical outcomes in patients with unstable angina pectoris (UAP)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "A total of 109 males with new-onset and progressive UAP entered the trial. They had LDLP cholesterol > or = 115 mg/dl."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The addition of atorvastatin to combined therapy of UAP patients resulted in achievement of a target level of LDLP cholesterol level in 64% dose-adjusted patients while in acipimox patients the target level was achieved in 20% patients. In spite of a more potent effect on endothelial function, acipimox had an insignificant effect on the treatment outcomes."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Hypolipidemic therapy with atorvastatin and acipimox for UAP leads to a significant reduction in LDLP cholesterol. The effect of atorvastatin comes much earlier and more frequently provides a target level of LDLP cholesterol."
        }
      ]},
