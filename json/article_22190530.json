      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the effect of proton pump inhibitor (PPI) on in-stent restenosis (ISR) in patients receiving clopidogrel therapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Total 439 patients underwent percutaneous coronary intervention (PCI) were enrolled in the study,including 250 post-PCI patients discharged on clopidogrel alone and 189 patients discharged on clopidogrel with PPI. The in-stent restenosis (ISR) ratio of the patients in these two groups were observed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "During a mean follow-up period of (13 ± 5.9) months, the post-PCI patients discharged on concomitant clopidogrel-PPI therapy had higher risk of ISR than those discharged on clopidogrel alone (19.6% Compared with 8%, P<0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Concomitant use of clopidogrel and PPI after hospital discharge would increase the risk of ISR for post-PCI patients."
        }
      ]},
