      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of a noncommunicating accessory uterine cavity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University-affiliated reproductive endocrinology practice."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 15-year-old nulligravida with increasing dysmenorrhea."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Pelvic ultrasound, intravenous pyelogram, hysterosalpingogram, laparoscopy, laparotomy, and resection of noncommunicating accessory uterine cavity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Results of imaging studies, surgical examination, and resection of anomaly."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Complete resection of accessory cavity and resolution of dysmenorrhea."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "The patient had a müllerian anomaly in which the uterus contained two uterine cavities. One normal uterine cavity with communication to both fallopian tubes was present along with a noncommunicating, accessory uterine cavity."
        }
      ]},
