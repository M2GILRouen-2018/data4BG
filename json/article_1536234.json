      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "This study examined the prevalance of dysmenorrhea in female adolescents and the effect of experiencing a reduction in dysmenorrhea on oral contraceptive use."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "This was a prospective panel study in which 308 adolescent women at an inner-city family planning clinic were interviewed about their experiences with dysmenorrhea and their oral contraceptive use at three points in time over a 6-month period. A chi 2 test and multiple logistic regression analysis were done."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The overall prevalence of dysmenorrhea in this population was 79.6%; 18.2% reported severe dysmenorrhea. Those who had severe dysmenorrhea and also experienced the reduction of dysmenorrhea as a result of oral contraceptives were eight times more likely to be consistent oral contraceptive users (p less than or equal to 0.02)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "It is important to screen female adolescents for dysmenorrhea, provide them with information about the beneficial side effects of oral contraceptives, and follow up these young women to make sure they are experiencing the alleviation of their symptoms."
        }
      ]},
