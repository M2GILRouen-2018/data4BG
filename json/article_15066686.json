      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We examined the prevalence of disability in valued life activities (VLAs) among a group of adults with asthma and the impact of general physical function and performance of VLAs on asthma-specific quality of life (QOL)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN AND SETTING",
          "content": "Interview data collected from two waves of a longitudinal cohort study were used to examine the prevalence of disability in VLAs, the cross-sectional association of general function and performance of VLAs with QOL, and the longitudinal association of changes in general function and changes in performance of VLAs with changes in QOL. General function was assessed with the SF-12; VLAs were assessed with a newly developed measure."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A substantial portion of subjects reported disability in VLAs. VLA function was a stronger predictor of QOL than general physical function in cross-sectional and longitudinal analyses."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Performance of VLAs is more closely tied to asthma-specific QOL than is general physical function."
        }
      ]},
