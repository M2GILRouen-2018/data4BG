      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 European Society for Vascular Surgery. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To obtain Western European perspectives on the economic burden of atherothrombosis in patients with multiple risk factors only (MRF), cerebrovascular disease (CVD), coronary artery disease (CAD), and in the under-evaluated group of patients with peripheral arterial disease (PAD), we examined vascular-related hospitalisation rates and associated costs in France and Germany."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "The prospective REACH Registry enrolled 4693 patients in France, and 5594 patients in Germany (from December 2003 until June 2004)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "For each country, 2-year rates and costs associated with cardiovascular events and vascular-related hospitalisations were examined for patients with MRF, CVD, CAD, and PAD."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Two-year hospitalisation costs were highest for patients with PAD (3182.1\u20ac for France; 2724.4\u20ac for Germany) and lowest for the MRF group (749.1\u20ac for France; 503.3\u20ac for Germany). Peripheral revascularizations and amputations were the greatest contributors to costs for all risk groups. Across all PAD subgroups, peripheral procedures constituted approximately half of the 2-year costs."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Hospitalisation rates and costs associated with atherothrombotic disease in France and Germany are high, especially so for patients with PAD."
          }
        ]
      },
