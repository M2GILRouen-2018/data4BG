      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Extracorporeal shockwave treatment (ESWT) and ultrasound-guided percutaneous lavage (UGPL) are two effective ways of treating rotator cuff calcific tendinopathy (RCCT)."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "The aim of the present study was to compare the effectiveness of these techniques in the treatment of RCCT."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomized, controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Patients treated in our sports medicine and rehabilitation center (Centro Médico Deyre, Madrid. Spain) between January 2007 and December 2013."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This randomized study compares the results achieved with these techniques over one year following their use to treat the above condition. Eighty patients received ESWT and 121 received UGPL. A visual analogue scale was used to measure pain, and ultrasound to determine the extent of calcification, at 3, 6, and 12 months after treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pain and the amount of calcification were significantly reduced by both techniques at 3, 6 and 12 months (P<0.001 for each), but significantly more so by UGPL (P<0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Both techniques are valid for the treatment of RCCT, although UGPL is associated with a greater reduction of calcification and greater reduction in pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CLINICAL REHABILITATION IMPACT",
          "content": "The results obtained applying UGPL, the low cost and the lack of complications should therefore make the treatment of choice in centers that are appropriately equipped and staffed."
        }
      ]},
