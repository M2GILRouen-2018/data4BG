      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Acute pharyngitis is a frequent and well-documented complaint in general practice but the associated suffering has remained largely unaddressed in the literature. Evidence, however, from five randomised controlled trials suggests that corticosteroids may be useful in relieving pain and discomfort arising from the condition."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To determine if short-acting oral therapy with prednisone was more effective than placebo in alleviating the suffering from acute pharyngitis in adults in a general practice setting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN OF STUDY",
          "content": "Randomised placebo-controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "General practice in Israel."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Patients with acute pharyngitis were randomised to receive 60 mg prednisone orally for 1 or 2 days, or identical placebo treatment. The main outcome measures were throat pain, measured by a visual analogue scale at 12, 24, 48 and 72 hours after presentation, time off work, fever, dysphagia, recurrence of symptoms and bacterial recurrence."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients treated with prednisone experienced more rapid throat pain resolution than those in the placebo group. No adverse effects were reported nor any differences between the two groups regarding either symptom or positive bacterial culture recurrence."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Short-acting oral steroid therapy is effective for shortening throat pain duration in acute pharyngitis."
        }
      ]},
