      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report a rare case of bilateral anterior uveitis with hypopyon formation following systemic topiramate use."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "A 40-year-old woman with migraine headache who was under topiramate treatment referred with bilateral ocular pain and visual blurring. Physical examination disclosed shallow anterior chamber and high intraocular pressure in both eyes. Following discontinuation of topiramate a severe bilateral anterior uveitis with posterior synechiae and hypopyon developed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Ocular inflammation resolved with systemic and topical steroid. Because of severe cataract and synechiae formation she underwent phacoemulsification/posterior chamber intraocular lens implantation and visual acuity of both eyes improved to 20/25."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Topiramate should be added to the list of drugs that may cause anterior uveitis and hypopyon formation."
        }
      ]},
