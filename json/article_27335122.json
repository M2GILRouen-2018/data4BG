      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the relationship between types of pathological narcissism and somatic symptoms among psychiatric outpatients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Patients (N\u2009=\u200995) completed measures of somatic symptoms, narcissistic grandiosity and vulnerability, and psychiatric symptoms. Relationships among variables were analysed using t-tests and correlations, controlling for psychiatric distress."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Somatic symptoms were positively associated with two types of narcissistic dysfunction. Among women there was a positive association between somatic symptoms and narcissistic vulnerability, but not grandiosity. Among men, somatic symptoms were positively associated with narcissistic grandiosity, but not vulnerability."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The connection between narcissistic pathology and somatic symptom severity appears to differ based on gender. Further research is needed to confirm and extend this preliminary finding."
        }
      ]},
