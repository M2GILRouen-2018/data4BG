      "Abstract": {
        "CopyrightInformation": "© 2012 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The use of intrathecal (IT) infusion of analgesic medications to treat patients with chronic refractory pain has increased since its inception in the 1980s, and the need for clinical research in IT therapy is ongoing. The Polyanalgesic Consensus Conference (PACC) panel of experts convened in 2000, 2003, and 2007 to make recommendations on the rational use of IT analgesics based on preclinical and clinical literature and clinical experiences."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The PACC panel convened again in 2011 to update the standard of care for IT therapies to reflect current knowledge gleaned from literature and clinical experience. A thorough literature search was performed, and information from this search was provided to panel members. Analysis of published literature was coupled with the clinical experience of panel members to form recommendations regarding the use of IT analgesics to treat chronic pain."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After a review of literature published from 2007 to 2011 and discussions of clinical experience, the panel created updated algorithms for the rational use of IT medications for the treatment of neuropathic pain and nociceptive pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The advent of new algorithmic tracks for neuropathic and nociceptive pain is an important step in improving patient care. The panel encourages continued research and development, including the development of new drugs, devices, and safety recommendations to improve the care of patients with chronic pain."
          }
        ]
      },
