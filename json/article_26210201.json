      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To review research on spiritual perspectives and spiritual care of adolescents and young adults (AYA) living with cancer."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "Peer-reviewed publications, book chapters, and websites of professional organizations."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "There is a paucity of research specifically investigating AYA spirituality and lack of AYA-sensitive instruments to measure spirituality. Research that applies robust scientific methods to the study of AYA spirituality is needed. Research that provides evidence on which to base best practices for spiritual care that supports AYA spiritual well-being is likewise necessary."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR NURSING PRACTICE",
            "content": "Nurses can influence AYA health-related outcomes and experiences by providing ethical and evidence-based spiritual nurture."
          }
        ]
      },
