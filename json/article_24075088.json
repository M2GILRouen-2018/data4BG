      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 North American Society for Pediatric and Adolescent Gynecology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To determine the relationship between dysmenorrhea and posttraumatic stress disorder (PTSD) among Japanese adolescent girls 9 months after the Great East Japan Earthquake."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Two high schools in Sendai, the largest city in northeastern Japan."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "1489 female adolescents aged between 15 and 18 years."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Impact of Event Scale-Revised (IES-R), intensity of menstrual pain."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The intensity of menstrual pain increased according to the comorbidity of PTSD (P < .001). The IES-R subscale and total scores significantly increased according to the severity of menstrual pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This study showed a significant association between natural disaster-induced PTSD and the severity of dysmenorrhea."
          }
        ]
      },
