      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The purpose of this paper was to describe the imaging features of intrapelvic complications of total hip arthroplasty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The clinical presentation, ultrasound, and radiographic findings of three cases were reviewed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Intrapelvic extrusion of cement or medial migration of prosthetic hardware caused extrinsic compression of the bladder."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Intrapelvic complications due to the mechanical effects of total hip arthroplasty are rare but may simulate intrinsic pelvic or bladder pathology on sonography. Plain radiographs and contrast studies provide clues to the correct diagnosis."
        }
      ]},
