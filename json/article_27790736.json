      "Abstract": {
        "CopyrightInformation": "© 2016 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Obesity has been implicated in the acquisition of Clostridium difficile infections (CDI), however, no study has investigated whether there is a correlation between body mass index (BMI) and CDI severity."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To determine whether obesity, as measured by BMI correlates with severe hospital-onset or community-onset CDI."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Patients admitted with CDI at a tertiary-care center from January 2013 to June 2015 were identified. The cohort was stratified by onset of disease using the National Healthcare Safety Network criteria, and by severity using the 2013 American College of Gastroenterology guidelines. Multivariate logistic regression was used to determine independent predictors of severe CDI."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 196 met the inclusion criteria, of which 57.1% (112) met criteria for severe disease. Overall, BMI >35 kg/m(2) was 1.7-fold more likely to be associated with severe CDI compared to a BMI 20-35 kg/m(2) (P < 0.005), and was an independent predictor of severe CDI (P = 0.038). In patients with community-onset-CDI and hospital-onset-CDI, a BMI >35 kg/m(2) was associated with a 1.96-fold and 1.48 greater rate of severe CDI compared to a BMI 20-35 kg/m(2) (P = 0.004 and 0.048), and was an independent predictor of severe CDI in these cohorts (P = 0.039 and 0.027) respectively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This study has identified an association between body mass index and Clostridium difficile infection severity. A BMI>35 kg/m(2) is an independent risk factor for severe community-onset and hospital-onset Clostridium difficile infections."
          }
        ]
      },
