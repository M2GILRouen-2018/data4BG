      "Abstract": {
        "CopyrightInformation": "© 2008 The Authors. Journal compilation © 2008 Blackwell Publishing Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Patients with functional chest pain (FCP) represent a therapeutic challenge for practising physicians."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To determine the efficacy of Johrei as compared to wait-list in improving symptoms of FCP patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Patients with chest pain of noncardiac origin for at least 3 months were enrolled into the study. All patients had to have negative upper endoscopy, pH testing and oesophageal manometry prior to randomization. Subsequently, patients were randomized to either Johrei or wait-list control. Patients received 18 Johrei sessions from a Johrei practitioner for 6 weeks."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 21 FCP patients enrolled into the Johrei group and 18 into the wait-list group. There was no difference in symptom intensity score between Johrei group and wait-list group at baseline (20.28 vs. 23.06, P = N.S.). However, there was a significant pre- and post-treatment reduction in symptom intensity in the Johrei group (20.28 vs. 7.0, P = 0.0023). There was no significant reduction in symptom intensity score between baseline and at the end of the study in the wait-list group (23.06 vs. 20.69, P = N.S.)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This pilot study shows that Johrei may have a role in improving FCP symptoms; however, future studies are needed to compare Johrei treatment with sham Johrei or supportive care."
          }
        ]
      },
