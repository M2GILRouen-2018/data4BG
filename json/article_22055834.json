      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS",
            "content": "This study tested the impact of combining a motivational intervention based on protection motivation theory (PMT, Rogers, 1983 [18]) plus a volitional intervention based on action planning and coping planning, as a way to promote the prevention of type 2 diabetes among UK undergraduates."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Eighty-four participants were randomly assigned to either a control group or one of three experimental conditions: motivational intervention (PMT), volitional intervention (APCP), or combined motivational and volitional intervention (PMT&APCP). PMT variables, dietary and exercise behaviours were measured at three time-points over a four-week period."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The motivational intervention significantly changed PMT variables. The combined motivational and volitional intervention significantly decreased fat intake and increased the frequency of exercise relative to all other groups, and significantly increased the amount of fruit and vegetables consumed relative to control and volitional intervention groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These results suggest that motivational intervention is effective at changing cognitions but changing behaviour requires an intervention based on both motivation and volition."
          }
        ]
      },
