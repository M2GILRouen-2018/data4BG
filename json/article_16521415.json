      "Language": "pol",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "THE AIM",
          "content": "Evaluation of the knowledge on CHD risk factors in selected Lódź population was made."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Realization of primary and secondary CHD prevention principles was assessed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Over 20% of patients with CHD and over 38% of subjects without CHD did not realize the prevention principles. Hypolipemic therapy was effective only in 44.21% of patients with CHD and 35.9% of subjects without CHD. Antihypertensive therapy was successful in about 55% of patients with CHD and 35% of subjects without CHD."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The results of our study have shown low effectiveness of both CHD prevention principles realization and hipolipemic and antihypertensive therapy in selected Lódź population."
        }
      ]},
