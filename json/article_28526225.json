      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Sports Medicine Australia. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To determine changes in lung function following an acute bout of high intensity interval exercise (HIIE), moderate intensity interval exercise (MIIE), and moderate intensity continuous exercise (MICE) in adults with airway hyper-responsiveness (AHR)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A randomized cross-over design was used."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Participants completed five laboratory sessions: (1) eucapnic voluntary hyperpnea challenge (2) maximal exercise test to determine peak power output (PPO) and, (3-5) HIIE (90% PPO for 1min followed by 10% PPO for 1min, repeated 10 times), MIIE (65% PPO for 1min followed by 10% PPO for 1min, repeated 10 times) and MICE (65% PPO for 20min). Lung function was assessed pre and post-exercise."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Thirteen participants (age: 21.1±2.7years) with mild/moderate asthma completed all protocols. Lung function was significantly lower following the MICE (-14.8%±12.2) protocol compared to the HIIE (-7.1%±8.3) and MIIE (-4.5%±3.3)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "It appears that MICE is associated with the greatest decline in post-exercise FEV1 among those with AHR. Interval exercise may be better tolerated than continuous exercise among those with AHR."
          }
        ]
      },
