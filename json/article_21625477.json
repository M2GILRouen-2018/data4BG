      "Abstract": {
        "CopyrightInformation": "© Article author(s) (or their employer(s) unless otherwise stated in the text of the article) 2017. All rights reserved. No commercial use is permitted unless otherwise expressly granted.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Immune recovery following highly active antiretroviral therapy (HAART) is commonly assessed by the degree of CD4 reconstitution alone. In this study, we aimed to assess immune recovery by incorporating both CD4 count and CD4:CD8 ratio."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Observational cohort study SETTING AND PARTICIPANTS: Clinical data from Chinese HIV-positive patients attending the largest HIV service in Hong Kong and who had been on HAART for ≥4 years were accessed."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Optimal immune outcome was defined as a combination of a CD4 count ≥500/μL and a CD4:CD8 ratio ≥0.8."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 718 patients were included for analysis (6353 person-years). At the end of year 4, 318 out of 715 patients achieved CD4 ≥500/μL, of which only 33% (105 out of 318) concurrently achieved CD4:CD8 ratio ≥0.8. Patients with a pre-HAART CD8 ≤800/μL (428 out of 704) were more likely to be optimal immune outcome achievers with CD4 ≥500/μL and CD4:CD8 ratio ≥0.8, the association of which was stronger after adjusting for pre-HAART CD4 counts. In a multivariable logistic model, optimal immune outcome was positively associated with male gender, younger pre-HAART age and higher pre-HAART CD4 count, longer duration of HAART and pre-HAART CD8 ≤800/μL. Treatment regimen and cumulative viral loads played no significant role in the pattern of immune recovery."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A combination of CD4 count and CD4:CD8 ratio could be a useful approach for the characterisation of treatment outcome over time, on top of monitoring CD4 count alone."
          }
        ]
      },
