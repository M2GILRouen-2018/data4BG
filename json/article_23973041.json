      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier HS Journals, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "International studies suggest almost half of all major coronary episodes annually occur in survivors of acute coronary syndrome (ACS)."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "A greater focus on medium- and long-term ACS management and adherence to proven therapies is essential if out-of-hospital reductions in mortality and morbidity are to be optimized."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A national panel of clinical and research opinion leaders in ACS care met for 2 days to set future priorities in health care delivery."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Lifestyle, control of risk factors, and prescription of pharmacological therapies can improve the course of coronary heart disease (CHD) by reducing all-cause and cardiovascular mortality by 15% to 25%. All ACS patients stand to benefit from rehabilitation and systematic secondary prevention, however, underutilization and suboptimal adherence to rehabilitation and secondary prevention measures persist globally."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A range of new initiatives in Australia and elsewhere indicate that time is ripe for change to improve the uptake of preventative treatments in patients after ACS. Key universal drivers of delivering best evidence practice for medium- to long-term care after ACS are economics and locality."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Health-service redesign involving all stakeholders will be integral to increasing access, uptake, and adherence to lifestyle, control of risk factors, and pharmacologic therapies shown to improve cardiovascular outcomes."
          }
        ]
      },
