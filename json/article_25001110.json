      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Sociedad Española de Oftalmología. Published by Elsevier España, S.L.U. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe the results of the meibomian gland probing as a treatment of severe posterior blepharitis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Prospective, longitudinal study of patients with signs and symptoms of severe posterior blepharitis, who were treated with meibomian gland probing in Centro Oftalmológico Interlomas (CENOFI). A total of 16 patients were included, 62.5% female and 32.5% male, diagnosed with severe posterior blepharitis. Treatment was performed in one eye. The time of rupture of the tear film was evaluated, using a subjective scale of 0-10 photophobia, the improvement in pain and visual acuity was measured before the procedure, and at one week and 6 months after."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "All the patients showed a statistically significant improvement in all 4 variables al 6 months. There were no complications."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "The dysfunction of the meibomian glands is a common reason for ophthalmology consulting. The study describes the results obtained by performing an intraductal survey, which was shown to be safe and effective in 100% of the sample."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "It can be concluded from this study that meibomian gland probing is an effective and promising treatment for blepharitis resistant to conservative treatment."
          }
        ]
      },
