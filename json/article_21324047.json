      "Abstract": {
        "CopyrightInformation": "© 2011 Blackwell Publishing Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "A descriptive tool or validated scale of consciousness is desirable in infants to test the value of any depth of anesthesia monitor."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We have reviewed published descriptions and scales of observed behavior that may be applicable to the study of infants during the transition from anesthesia to wakefulness."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Potentially useful scales were found that had been developed for the assessment and study of natural sleep, neurological state, arousal, anesthesia, sedation, coma, and pain. Scales or criteria of behavior had been developed for anesthetised children, but there were no agreed definitions or criteria specifically for anesthetised infants or neonates."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Criteria for awakening of infants from anesthesia need to be developed and agreed."
          }
        ]
      },
