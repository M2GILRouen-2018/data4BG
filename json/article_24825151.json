      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Cross-sectional."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine whether 3 types of chronic pain are associated with absenteeism and with the number of days absent from work in the general population of Spain."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Chronic pain has been associated with absenteeism, but most of the evidence is based on unadjusted analyses and on specific professional categories."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A cross-sectional analysis was performed on the basis of data of 8283 Spanish workers. Chronic pain was ascertained from self-reported information on frequent symptoms of pain in the low back and neck and/or migraine in the last 12 months. Absenteeism was defined as missing at least 1 day from work because of health problems. Multivariate regression models were adjusted for the main confounders."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Health-related absenteeism was reported by 27.8% of subjects. The prevalence of chronic pain was reported to be 12.3% in the neck, 14.1% in the low back, and 10.3% migraine. In adjusted analyses, absenteeism was associated with chronic neck pain (odds ratio: 1.20; 95% confidence interval [CI], 1.02-1.40), low back pain (odds ratio: 1.22; 95% CI, 1.06-1.42), and migraine (odds ratio: 1.22; 95% CI, 1.04-1.44). These associations were strongest in younger (18-34 yr) rather than in older workers. Furthermore, those who reported frequent pain in the neck and low back were 44% more likely to be absent for more than 30 days in the past year than those who did not report these symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Spanish workers with chronic pain were more likely to be absent from work and to stay absent from work for longer. These associations are independent of sociodemographic characteristics, occupation, lifestyle, health status, and analgesics use."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "LEVEL OF EVIDENCE",
          "content": "N/A."
        }
      ]},
