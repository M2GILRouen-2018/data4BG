      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To identify reasons for delay in management of patients with cauda equina syndrome (CES) and to determine commonly presented features of CES."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Retrospectively, the presenting features and management of patients treated for CES over a 4-year period were reviewed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Reasons for delay in treatment were identified in over half of the patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Most patients do not present with all the characteristic features of CES. Sacral sensory loss is a sensitive and relatively specific sign for diagnosing CES."
        }
      ]},
