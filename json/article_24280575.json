      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 IAP and EPC. Published by Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Pancreatic cancer is often accompanied by severe abdominal or back pain. It's the first study to evaluate the analgesic effect of electroacupuncture on pancreatic cancer pain. A randomized controlled trial compared electroacupuncture with control acupuncture using the placebo needle."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Sixty patients with pancreatic cancer pain were randomly assigned to the electroacupuncture group (n = 30) and the placebo control group (n = 30). Patients were treated on Jiaji (Ex-B2) points T8-T12 bilaterally for 30 min once a day for 3 days. Pain intensity was assessed with numerical rated scales (NRS) before the treatment (Baseline), after 3 treatments, and 2 days follow-up."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Baseline characteristics were similar in the two groups. After 3 treatment, pain intensity on NRS decreased compared with Baseline (-1.67, 95% confidence interval [CI] -1.46 to -1.87) in the electroacupuncture group; there was little change (-0.13, 95% CI 0.08 to -0.35) in control group; the difference between two groups was statistically significant (P < 0.001). Follow-up also found a significant reduction in pain intensity in the electroacupuncture group compared with the control group (P < 0.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Electroacupuncture was an effective treatment for relieving pancreatic cancer pain."
          }
        ]
      },
