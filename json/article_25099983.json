      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Few randomized controlled trial studies have focused on the effect of music in cancer patients, and there are no randomized controlled trials on the effects of live music with saxophone in cancer patients."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine the effects of live saxophone music on various physiological parameters, pain level, and mood level."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A randomized controlled trial study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "52 cancer patients were randomized to a control group (n = 26), an experimental group (n = 26) whose members received 30 minutes of live music therapy with saxophone."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Systolic and diastolic blood pressure, pulse rate, glycemia, oxygen saturation, pain level, and mood level were measured before and after the live music performance."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was a statistical difference between the groups for oxygen saturation (0.003) and mood level (0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Live music performed with a saxophone could be introduced in oncology care to improve the oxygen saturation and mood in cancer patients."
        }
      ]},
