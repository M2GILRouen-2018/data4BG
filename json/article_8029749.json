      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A patient with sciatica resulting from a hemorrhagic cyst of the ligamentum flavum is reported. Surgical removal of the cyst relieved the patient of her sciatic symptoms."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Cyst of ligamentum flavum is an uncommon cause of radiculopathy. There are 13 cases in the literature."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The differential diagnosis of benign interspinal extradural mass lesions includes spinal synovial cysts, ligamentum flavum cysts, perineural cysts, dermoid cysts, and parasitic cysts."
        }
      ]},
