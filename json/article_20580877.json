      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "In 1982, Wellens and colleagues described characteristic electrocardiogram (ECG) findings in angina patients virtually pathognomonic for significant stenosis of the proximal left anterior descending coronary artery and associated with a high risk of acute anterior wall myocardial infarction."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "We present the case of a 74-year-old emergency department patient with classic ECG findings of Wellens syndrome and progression to acute ST elevation within 55 min."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "SUMMARY",
            "content": "We present this case to increase awareness among emergency physicians of the characteristic findings of Wellens syndrome."
          }
        ]
      },
