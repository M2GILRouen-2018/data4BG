      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare quality of life after extracorporeal shock wave lithotripsy (ESWL) and open cholecystectomy for symptomatic gallstones."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomised study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital, The Netherlands."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "49 Patients, 23 of whom were randomized to undergo ESWL and 26 to undergo open cholecystectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Health questionnaires were filled out before, and at 3, 6 and 12 months after treatment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Improvements of quality of life after one year."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Both treatments improved quality of life. Open cholecystectomy improved quality of life significantly better than ESWL (median percentage gains in Nottingham Health Profile scores at 1 year 17.1 and 10.5, respectively, p = 0.003)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Open cholecystectomy is superior to ESWL in improving quality of life, so cholecystectomy remains the treatment of choice for symptomatic gallstones. For patients who are unfit or unwilling to undergo operation, however, ESWL is adequate because most patients have some benefit from it in terms of quality of life."
        }
      ]},
