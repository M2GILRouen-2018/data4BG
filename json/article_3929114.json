      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To assess motives for nonmedical use of prescription opioids among US high school seniors and examine associations between motives for nonmedical use and other substance use behaviors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Nationally representative samples of US high school seniors (modal age 18 years) were surveyed during the spring of their senior year via self-administered questionnaires."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Data were collected in public and private high schools."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "The sample consisted of 5 cohorts (2002-2006) of 12 441 high school seniors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Self-reports of motives for nonmedical use of prescription opioids and substance use behaviors."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "More than 1 in every 10 high school seniors reported nonmedical use of prescription opioids and 45% of past-year nonmedical users reported \"to relieve physical pain\" as an important motivation. The odds of heavy drinking and other drug use were lower among nonmedical users of prescription opioids motivated only by pain relief compared with nonmedical users who reported pain relief and other motives and those who reported non-pain relief motives only. The odds of medical use of prescription opioids were lower among nonmedical users who reported only non-pain relief motives compared with other types of nonmedical users."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The findings indicate motives should be considered when working with adolescents who report nonmedical use of prescription opioids. Future efforts are needed to identify adolescents who may need appropriate pain management and those at increased risk for prescription opioid abuse."
        }
      ]},
