      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM OF STUDY",
          "content": "To study the efficacy of tetracycline (or doxycycline) and nicotinamide in the treatment of less extensive bullous pemphigoid."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "An open trial of 11 patients with bullous pemphigoid. Treatment was initiated with tetracycline 1.5-2 g/day and nicotinamide 1.5-2 g/day and gradually tapered down. Doxycycline was substituted for tetracycline in patients who could not tolerate tetracycline due to gastrointestinal side effects or headache."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "6 out of 11 patients achieved complete response (> 90% decrease in lesions) while another 2 had partial response (50-90% decrease in lesions)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Tetracycline/doxycycline and nicotinamide is a useful alternative treatment for localized bullous pemphigoid, especially in those whose concurrent medical illnesses preclude the use of systemic corticosteroids."
        }
      ]},
