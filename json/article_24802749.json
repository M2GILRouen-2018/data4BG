      "Abstract": {
        "CopyrightInformation": "© Copyright 2014 by The American College of Veterinary Surgeons.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare intraoperative physiologic variables and post-operative pain associated with lift laparoscopy and conventional capnoperitoneum laparoscopy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Prospective randomized case controlled study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANIMALS",
            "content": "Healthy dogs (n\u2009=\u200930)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Dogs having laparoscopic ovariohysterectomy were randomly assigned to lift laparoscopy (n\u2009=\u200914) or capnoperitoneum (16) laparoscopy. Physiologic variables measured intraoperatively were documented. Postoperatively, pain response was assessed in a blinded fashion using the short Glasgow pain scale and von Frey filament aesthesiometry."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Lift laparoscopy was associated with less frequency of hypercapnia, required less anesthetic gas, and was not more time-consuming or painful than capnoperitoneum laparoscopy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Lift laparoscopy is a feasible alternative to capnoperitoneum laparoscopy, especially in dogs where pressurized capnoperitoneum is not desired."
          }
        ]
      },
