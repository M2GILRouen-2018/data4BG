      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Limited studies have examined the predictors of HRQoL among patients with rheumatoid arthritis. This study helped to ascertain the predictors of HRQoL from the pool of influencing factors identified by previous studies."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "This study investigated the health-related quality of life (HRQoL) of adult patients with rheumatoid arthritis and its predictors."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Using a descriptive correlational design, this study explored the relationship between HRQoL and pain, functional disability, anxiety, depression, medication adherence and social support. Eligible outpatients (n=108) were recruited via their attending doctors who were co-investigators of this study. Informed consent forms were distributed and questionnaires administered in a teaching hub by the main researcher."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Significant correlations were found between HRQoL and all of the study variables. Pain, functional disability and depression were main predictors of HRQoL."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Future evidence-based interventions focusing on pain relief, delaying disability or improving functional ability and reducing depressive symptoms are required to enhance the HRQoL of patients with rheumatoid arthritis."
          }
        ]
      },
