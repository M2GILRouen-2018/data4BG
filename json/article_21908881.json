      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine if infants developing bronchopulmonary dysplasia (BPD), particularly mild BPD, initially had minimal lung function abnormalities, which then worsened throughout the neonatal period."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective observational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary neonatal intensive care unit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "74 infants with a median gestational age of 30 weeks (24-32) and birth weight of 1200 g (474-2000) were studied; 35 had no BPD, 12 developed mild BPD and 23 developed moderate/severe BPD."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "BPD was diagnosed in infants who were oxygen dependent beyond 28 days after birth."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Lung function was assessed by measurement of functional residual capacity (FRC) by helium gas dilution and compliance and resistance of the respiratory system. Measurements were attempted on days 3, 5, 7, 14, 21 and 28."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Infants developing BPD, particularly moderate/severe BPD, had lower mean FRC (p=0.009) and mean compliance (p=0.005) throughout the 28-day period than those who did not develop BPD. Lung function improved over the neonatal period in all three groups, but the rate of improvement in FRC (p=0.004) and compliance (p=0.002) results over the first 28 days varied by BPD status, being greatest in infants developing moderate/severe BPD (all p values <0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Overall, in infants who did and did not develop BPD, lung function improved throughout the neonatal period. Infants with more severe initial lung disease were more likely to develop moderate/severe BPD."
        }
      ]},
