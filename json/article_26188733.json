      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the correlation between pain measurements performed using a visual analogue scale (VAS) and pressure pain threshold (PPT) in individuals with temporomandibular disorders who underwent conservative treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "This prospective study assessed 78 individuals diagnosed with myofascial pain, and the treatment consisted of counseling and self-care therapy sessions. Pain was assessed by means of a VAS and PPT at baseline (T0), after 15 to 30 days (T1), and after 75 to 90 days (T2). The participants were divided into two groups: \"Compliant Group\" and \"Non-Compliant Group.\" The data were analyzed by means of Spearman's correlation test and Friedman's analysis of variance by ranks."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Correlations were not identified between the VAS and PPT values at time points-T0, T1, or T2-in any group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Although, VAS and PPT represent subjective features, such as the perception of pain, the hypothesis that high pain intensity levels are equivalent to high pain sensitivity levels was not demonstrated."
          }
        ]
      },
