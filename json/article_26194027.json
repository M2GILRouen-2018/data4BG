      "Abstract": {
        "CopyrightInformation": "© 2015 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To compare the prevalence and predictors of depression in Taiwanese and American older patients with arthritis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "A secondary analysis was conducted to assess 151 Taiwanese and 70 American arthritic patients in Taipei, Taiwan and Chicago, USA."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "The prevalence of depression of Taiwanese and American older arthritic patients was 34% and 40%, respectively. Depression was explained by life satisfaction and functional ability in Taiwanese patients, and by life satisfaction and level of pain in American patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Nurses should assess patients' level of pain and functional ability, as well as their life satisfaction and depression."
          }
        ]
      },
