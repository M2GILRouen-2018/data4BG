      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To describe the symptom concerns of patients with hepatocellular carcinoma (HCC) and pancreatic cancer and explore the effect of symptoms on patients' quality of life (QOL)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive, longitudinal study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Ambulatory clinics of a comprehensive cancer center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "45 patients actively receiving treatment for either HCC or pancreatic cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Patients were followed from baseline for three months, with outcome measures repeated monthly. Outcome measures included the Functional Assessment of Cancer Therapy-Hepatobiliary (FACT-Hep) and the Functional Assessment of Chronic Illness Therapy-Spirituality Subscale (FACIT-Sp-12). Descriptive analysis of demographic, treatment, and symptom data was conducted, followed by two-way repeated measures analysis of variance of FACT-Hep and FACIT-Sp-12 scale scores by diagnosis and treatment type."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Symptoms, QOL."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Overall QOL is poor in patients with hepatobiliary cancer, and this trend continues over time. Symptoms such as abdominal pain, fatigue, weight loss, and poor appetite commonly are reported in this population."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Patients with hepatobiliary cancer suffer from multiple symptoms that may have a negative affect on overall QOL. Specific QOL domains, such as physical and functional well-being, are of particular concern for patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "The identification of specific symptom and QOL concerns in hepatobiliary cancers will enhance clinical care and aid in the future development of multidisciplinary interventions for this understudied cancer population."
        }
      ]},
