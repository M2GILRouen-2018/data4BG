      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The purpose of this preliminary study was to report the short-term local control of percutaneous image-guided cryoablation of localized symptomatic abdominal scar endometrioma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Four consecutive patients (mean age 34.5 years) with a total of ten lesions were included, with mean preoperative pain of 7 (range 5-9) on the visual analog scale. Cryoablation was performed in a single session under general anesthesia."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Postoperative superficial edema disappeared within 2 weeks for all patients. No severe complications (>grade 2 according to the CTCAE classification) were reported. Mean postoperative pain was 1.7 at 6 months (range 0-5) and magnetic resonance imaging demonstrated a significant volume decrease for all patients (range 72.2-100%; p = 0.028)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Percutaneous cryoablation shows promising local control in patients with symptomatic abdominal wall endometriosis."
        }
      ]},
