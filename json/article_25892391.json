      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The primary aim of this review was to investigate whether fibromyalgia (FM) patients can engage in sufficient muscle strengthening activity (MSA) to elicit positive strength and functional outcomes, while not exacerbating pain. The second aim was to report strength training recommendations based upon the findings of this review."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Studies published between January 1, 2000 and May 1, 2014 were located using the electronic databases CINHAL, PubMed and Google Scholar. Studies were included if a strength training component (e.g. resistance machines, bodyweight, exercise tubing, dumbbells) was part of the intervention, and if the investigation reported pain and/or strength outcomes. A total of eleven comparative controlled trials were included in this review."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The majority of the studies demonstrated encouraging increases in strength, along with significant reductions in pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "MSA can be a safe and effective mode of exercise for FM patients, particularly when progressed from low intensities."
          }
        ]
      },
