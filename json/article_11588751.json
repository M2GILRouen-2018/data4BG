      "Abstract": {
        "CopyrightInformation": "Copyright 2001 by the American Congress of Rehabilitation Medicine and the American Academy of Physical Medicine and Rehabilitation",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate the electromyographic activities of vastus medialis obliquus (VMO) and vastus lateralis (VL) muscles in open and closed kinetic chain exercises in subjects with patellofemoral pain syndrome (PFPS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case-controlled study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Rehabilitation science center in a tertiary medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Ten patients with bilateral knee pain diagnosed with PFPS and 10 healthy volunteers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Subjects performed open kinetic chain exercise on an isokinetic dynamometer and closed kinetic chain exercise by squat-to-stand and stand-to-squat tasks. Surface electromyography was done for the VMO and VL muscles."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "VMO/VL ratios were calculated after normalization of muscle activities."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The VMO/VL ratios of PFPS subjects were significantly lower than were those of unimpaired subjects during knee isokinetic closed kinetic chain exercises (p = .047). However, there was no statistical difference in VMO/VL ratio between subjects with and without PFPS during closed kinetic chain exercises (p = .623). Maximum VMO/VL ratio was obtained at 60 degrees knee flexion in closed kinetic chain exercise."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "In closed kinetic chain exercises, more selective VMO activation can be obtained at 60 degrees knee flexion. Maximal VMO/VL ratio was observed at this knee flexion angle, and muscle contraction intensity was also greatest."
          }
        ]
      },
