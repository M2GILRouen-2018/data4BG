      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Solid tumors have a markedly decreased incidence in individuals with Down syndrome (DS), including lung cancers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The clinical presentation of epidermal growth factor receptor (EGFR)-mutant non-small-cell lung cancer (NSCLC) in DS was reported and literature on the subject reviewed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In individuals with DS, the risk of lung cancer appears markedly lower. EGFR mutation and EGFR tyrosine kinase inhibitors (EGFR-TKIs) resistance also exist in DS with lung cancer."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Clinicians should consider EGFR mutation and EGFR-TKIs resistance in lung cancer patients with DS."
        }
      ]},
