      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report a case of severe anterior segment inflammation secondary to exposure to a high-power blue laser device."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Case report."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A 14-year-old male presented with redness, pain and decreased vision in his left eye after exposure to blue laser. Examination indicated severe conjunctival injection associated with 4+ cells in the anterior chamber with fibrinous reaction. The posterior pole was normal."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Blue laser devices are easily available through the Internet. These devices can cause devastating ocular injuries. National safety guidelines are required to regulate use."
        }
      ]},
