      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "This report describes the case of a boy with severe haemophilia A and factor VIII inhibitor who suffered subarachnoid haemorrhage at age 7 years, followed by bleeding in the right cerebellar hemisphere and an epidural haematoma at age 12 years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "The patient received intensive replacement treatment leading to reversal of neurological signs and symptoms and resorption of haematomas, as demonstrated by CT scans."
        }
      ]},
