      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare intraoperative pain responses following intraovarian versus mesovarian injection of lidocaine in mares undergoing laparoscopic ovariectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANIMALS",
          "content": "15 mares between 4 and 20 years old."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PROCEDURE",
          "content": "Standard bilateral laparoscopic ovariectomy was performed. Prior to manipulation of the ovary, 2% lidocaine (10 mL) was injected into the ovary and saline (0.9% NaCI) solution (10 mL) was injected into the mesovarium on 1 side, with saline solution (10 mL) injected into the ovary and 2% lidocaine (10 mL) injected into the mesovarium on the other side. Presence (yes vs no) and severity (visual analogue scale) of pain were scored at 5 times (grasping of the ovary, dissection of the mesosalpinx, tightening of the first loop ligature, tightening of the second loop ligature, and transection of the ovarian pedicle) by 2 individuals blinded to treatment and each other's observations."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "During 4 of the 5 observation periods, significantly fewer mares had signs of pain following mesovarian injection of lidocaine, and during 2 of the 5 observation periods, visual analogue scale score was significantly lower."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS AND CLINICAL RELEVANCE",
          "content": "Results suggest that mesovarian injection of lidocaine is associated with significantly lower pain responses, compared with intraovarian injection, in horses undergoing laparoscopic ovariectomy."
        }
      ]},
