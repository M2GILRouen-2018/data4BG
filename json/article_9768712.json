      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The purpose of this study was to assess whether the presence or absence of myocardial viability during dobutamine echocardiography (DE) predicts survival in patients with coronary artery disease (CAD) and severe left ventricular (LV) dysfunction."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "In patients with CAD, the presence of myocardial viability during DE identifies viable myocardium and predicts recovery of LV systolic function after revascularization. However, there is little data on the relation between myocardial viability and clinical outcome in patients with CAD and severe LV dysfunction."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We studied 318 patients with CAD and a LV ejection fraction (EF) < or =35% who underwent DE and were followed for 18+/-10 months. Patients were classified into four groups. Group I (n=85) consisted of patients who had evidence of myocardial viability and subsequently underwent revascularization. Group II (n=119) consisted of patients with myocardial viability who did not undergo revascularization. Group III (n=30) consisted of patients who did not have myocardial viability and underwent revascularization. Finally, group IV (n=84) patients lacked myocardial viability and did not undergo revascularization."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The four groups had similar baseline characteristics and rest LVEF. During follow-up there were 51 deaths (16%). The mortality rate was 6% in group I, 20% in group II, 17% in group III and 20% in group TV (p=0.01, group I vs. other groups)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In patients with CAD and severe LV dysfunction who demonstrated myocardial viability during DE, revascularization improved survival compared with medical therapy."
        }
      ]},
