      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This cross-sectional study was done to find the prevalence of eye strain and other ocular morbidities among students in Udupi, Karnataka."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The study protocol included interview, visual acuity examination using Snellen chart, and measuring classroom illumination through lux meter."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "26% students had visual morbidity and the most prevalent symptoms of eyestrain were headache (38.6%), watering of eyes (25.7%), pain around eyes (15.6%) and blurred vision (11.9%). 55.5% classrooms and 88.4% blackboards did not have proper illumination."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Low classroom illumination levels may be a possible factor for development of visual morbidity."
        }
      ]},
