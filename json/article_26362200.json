      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Mesh repair reduces the risk of reoperation for recurrence in patients with primary ventral hernias. However, reoperation for recurrence underestimates total recurrence (reoperation + clinical) and mesh reinforcement may induce chronic pain. This study investigated the total recurrence and risk of chronic pain in small primary ventral hernias."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A cohort study with questionnaire and clinical follow-up was conducted. Patients with primary, elective, open mesh or sutured repair for a small umbilical or epigastric hernia (≤ 2 cm) were included."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "One thousand three hundred thirteen patients completed the questionnaire. The total cumulated recurrence rate after primary repair was 10% for mesh repair and 21% for sutured repair (P = .001). The incidence of chronic pain was 6% after mesh repair and 5% after sutured repair (P = .711)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Mesh repair halved long-term risk of recurrence after repair for small ventral hernias without increased risk of chronic pain."
          }
        ]
      },
