      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the psychometric properties of the Family Impact Module (FIM), a parent self-report measure of health-related quality of life (HRQOL) and family functioning, among parents of youth with chronic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Parents (N = 458) completed the FIM (Total Impact, HRQOL, and Family Functioning scales); parents and youth (N = 332) completed measures of pain catastrophizing, pediatric quality of life, and emotional/behavioral functioning."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The FIM demonstrated strong internal consistency and item-total correlations. All FIM scales were positively associated with pain catastrophizing, functional disability, and emotional/behavioral problems; and inversely related to pediatric quality of life. Mothers reported significantly worse HRQOL than fathers. Mothers and fathers did not differ on reports of Family Functioning. HRQOL and Family Functioning did not differ as a function of pain diagnosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The FIM appears to be a suitable measure of parent self-reported HRQOL and family functioning in pediatric chronic pain."
        }
      ]},
