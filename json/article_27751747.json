      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Carry out a preliminary study comparing postoperative pain and intraoperative and postoperative complications between micro-laparoscopy and laparoscopic monotrocart non-oncological adnexal surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "All patients should benefit from a benign adnexal surgery were included prospectively from February to May 2014. The insufflation pressure, infiltration of trocar holes with a local anesthetic, postoperative analgesics were prescribed standardized. Operative and postoperative complications, type and length of hospital stay as well as EVA and analgesic consumption were recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Nine patients were included in monotrocart group versus 7 in the micro-laparoscopy group. There were no differences in operative and postoperative complications, the type and length of hospital stay, as well as cosmetics satisfaction. However, there was a significant difference in the VAS to D2 (2.15 vs. 4.08, P=0.04) and analgesic consumption at D0 (P=0.04), D1 (P=0.04), D2 (P=0.02) and D3 (P=0.01), for the benefit of micro-laparoscopy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION AND CONCLUSION",
            "content": "Despite an enrollment of patients low, micro-laparoscopy appears to have a significant advantage over the monotrocart laparoscopy for postoperative pain in benign adnexal surgery."
          }
        ]
      },
