      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study women's experience of postoperative pain and pain relief after cesarean birth and factors associated with pain assessment and the birth experience."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive patient survey. Data were collected through a questionnaire. The outcome variables were assessments of pain using a Visual Analog Scale and women's birth experience measured on a seven-point Likert scale."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Central Swedish county hospital, maternity unit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS/PARTICIPANTS",
          "content": "The sample consisted of 60 women undergoing cesarean birth."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Women reported high levels of experienced pain during the first 24 hours. Seventy-eight percent of the women scored greater than or equal to 4 on the Visual Analog Scale, which can be seen as inadequately treated pain. There was no difference between elective and emergency cesarean births in the levels of pain. In spite of high levels of pain, women were pleased with the pain relief. The risk of a negative birth experience was 80% higher for women undergoing an emergency cesarean birth compared with elective cesarean birth. Postoperative pain negatively affected breastfeeding and infant care."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "There is a need for individual and adequate pain treatment for women undergoing cesarean birth, as high levels of pain interfere with early infant care and breastfeeding."
        }
      ]},
