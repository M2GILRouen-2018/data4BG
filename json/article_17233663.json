      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To examine psychosocial care needs of children with recent-onset asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN/METHODS",
          "content": "Data were collected over 2 years from 63 children ages 8-14 years."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Children's need for attention to specific aspects of their asthma care remained high over the 2 years, as did their perceived needs for information and support and their concerns and fears."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "PRACTICE IMPLICATIONS",
          "content": "Children have many needs, and healthcare professionals may not be providing care that addresses these needs. The Child Report of Psychosocial Care can be used as a quick tool to assess and guide interventions related to specific areas of need."
        }
      ]},
