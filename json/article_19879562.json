      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe a novel technique for the acute management of a transverse vaginal septum with hematocolpos."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective case series."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Secondary- and tertiary-care centers in Australia and New Zealand."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Three patients with a transverse vaginal septum presenting with pain and a hematocolpos."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Laparoscopic drainage of the hematocolpos."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Pain relief until definitive resection of the transverse vaginal septum."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "All patients were free of pain after the procedure. Two patients had a second laparoscopic procedure to drain the hematocolpos which had reaccumulated while awaiting definitive surgery. All three patients have undergone resection of the septum."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Laparoscopic drainage provides a novel approach to the acute management of a transverse vaginal septum, providing pain relief without compromising the success of definitive surgery which can be performed at a later date."
          }
        ]
      },
