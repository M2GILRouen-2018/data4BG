      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS AND BACKGROUND",
          "content": "Neuroendocrine tumors are uncommon clinical entities and only a few cases of the co-occurrence of neuroendocrine tumors and retroperitoneal fibrosis have been described in the literature."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS AND STUDY DESIGN",
          "content": "We report the promising results achieved in a case of neuroendocrine tumor complicated by retroperitoneal fibrosis causing right ureteral obstruction treated with long-acting release octreotide and tamoxifen."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RESULTS AND CONCLUSIONS",
          "content": "The treatment resulted in a complete response without toxicity."
        }
      ]},
