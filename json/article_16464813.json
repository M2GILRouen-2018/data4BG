      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore barriers in the health service to diagnosis and treatment experienced by women at increased risk of coronary heart disease (CHD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Qualitative study using semi-structured interviews."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Norway."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Twenty women diagnosed with heterozygous familial hypercholesterolemia (FH) recruited through a lipid clinic."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Women reported three specific barriers related to diagnosis and treatment of CHD. They had to struggle to take a cholesterol test; they experienced that their risk was being downplayed by doctors; and that their symptoms of CHD were misinterpreted when they consulted doctors for evaluation and treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Stereotyping CHD as a man's disease may result in barriers to diagnosis and treatment for women. Doctors should ask the patient about the family history of CHD if a concern about heart disease is on the patient's agenda."
        }
      ]},
