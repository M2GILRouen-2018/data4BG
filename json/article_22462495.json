      "Abstract": {
        "CopyrightInformation": "© 2012 British HIV Association.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of the study was to evaluate the interleukin-17 (IL-17) plasma level in HIV-1-infected patients and its relation to central obesity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Eighty-four HIV-1-infected patients [42 with visceral obesity (group A) and 42 without visceral obesity (group B)] and 46 HIV-negative subjects [23 with visceral obesity (group C) and 23 without visceral obesity (group D)] were enrolled in the study. Sonographic measurements of perirenal fat diameter/body mass index (PRFD/BMI) were used to assess visceral adipose tissue thickness."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "HIV-1-infected patients had higher plasma levels of IL-17 than HIV-negative subjects [837.8 ± 260 pg/mL (mean ± standard deviation) vs. 395.3 ± 138.6 pg/mL, respectively; P<0.001]. Furthermore, HIV-1-infected patients with a diagnosis of visceral obesity had lower levels of IL-17 than HIV-infected lean patients (756.9 ± 282.9 pg/mL vs. 918.7 ± 208.4 pg/mL, respectively; P<0.01). IL-17 (r=\u2009-0.21; P=0.03) and waist circumference (r=0.48; P<0.001) were significantly associated with visceral adipose tissue thickness. A negative correlation of IL-17 (r=\u2009-0.23; P<0.001) with PRFD/BMI was found."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This study suggests a linear negative association between IL-17 and visceral adipose tissue thickness."
          }
        ]
      },
