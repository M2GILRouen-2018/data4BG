      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the morbidity rate of and relevance to coronary stenosis in cerebral infarction patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "CT coronary angiography was performed in 112 cases of cerebral infarction after CT cerebral angiography. Multivariate logistic regression analysis was carried out between the clinical data and coronary stenosis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In 112 cases receiving CT cerebral angiography, the morbidity rate of coronary stenosis was 46.4%. In 95 cerebral infarction patients, the morbidity rate of coronary stenosis was 51.6%. Multivariate logistic analysis showed that age, hypertension, hyperlipidemia, significant narrowing of cerebral artery were identified as independent predictors for coronary stenosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Heart examination with 64 row CT should be routinely performed after cerebral angiography in cerebral infarction patients, especially in those with age greater than 65 years, hypertension, hyperlipidemia and significant narrowing of cerebral artery so as to detect coronary stenosis early."
        }
      ]},
