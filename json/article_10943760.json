      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine if nonspecific gastrointestinal (GI) symptoms justify cholecystectomy in patients with spinal cord injury (SCI)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "The frequency of GI symptoms was determined in a sample of patients with SCI in whom the presence or absence of gallstones had been previously determined by screening ultrasonography or a known history of cholecystectomy. The prevalence of various symptoms in patients with and without gallstones was compared."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The Spinal Cord Injury Unit of the Veterans Affairs Puget Sound Health Care System, which provides rehabilitation and longitudinal primary care for SCI veterans."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Two hundred ninety-four patients who had undergone either right upper quadrant ultrasonography or cholecystectomy in the past, and who completed a questionnaire concerning GI symptoms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Bivariate logistic regression was used to calculate odds ratios (ORs) to determine the strength of associations between the presence of each symptom and the presence of gallstones."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pain in the right upper quadrant or epigastrium that occurred after meals or at night was significantly associated with gallstones (OR: 3.5; 95% confidence interval [CI] 1.02-11.73). Abdominal pain in other locations and nonspecific symptoms such as bloating and nausea, were not predictive of the presence of gallstones."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Nonspecific symptoms in patients with SCI are not associated with gallstones and do not justify cholecystectomy in patients with otherwise asymptomatic gallstones."
        }
      ]},
