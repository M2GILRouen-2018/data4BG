      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 National Association of Pediatric Nurse Practitioners. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Although adolescent substance use can have direct effects on asthma symptoms and interact with medications used to treat asthma, no validated health-related quality of life (HRQL) instrument exists for adolescents 17 to 19 years of age with asthma."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The American Academy of Pediatric's HRQL instrument, the Child Health Survey for Asthma (CHSA)-Child version, was modified with a substance use subscale to address outcomes specific to adolescents ages 17 to 19 years with asthma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Two cohorts (N = 70) were recruited for instrument testing at pediatric primary care practices and two university clinics. A small methodological study with 24 adolescents was conducted to obtain initial support of the psychometric properties for the CHSA-Teen version at baseline, day 14, and day 16. A follow-up study included 46 teens to provide further support."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The psychometric properties of the CHSA-Teen version were good and comparable with the CHSA-Child version for feasibility, reliability, and validity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Health care providers need to be aware of each adolescent's substance use to personalize counseling related to asthma medications."
          }
        ]
      },
