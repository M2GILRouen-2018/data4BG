      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the prevalence of otologic symptoms in patients undergoing surgical decompression for symptomatic Chiari I malformation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Cross-sectional, prospective, nonrandomized."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Urban tertiary referral center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Patients with Chiari I malformation before surgical intervention."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "None."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Results of completed questionnaire."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Sixteen consecutive patients with Chiari I malformation completed the self-administered questionnaire. Eighty-one percent of patients reported episodic aural fullness, 81% reported tinnitus, 69% reported vertigo, and 56% reported fluctuating hearing loss. Headaches were reported as frequently as aural fullness and tinnitus."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Most patients with Chiari I malformation have symptoms that mimic primary otologic pathologic changes. The existence of common pathophysiologic mechanisms is proposed."
        }
      ]},
