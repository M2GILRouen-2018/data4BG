      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the accuracy of 64-slice computed tomography and coronary angiography in the diagnosis of coronary atherosclerosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The imaging data of both 64-slice computed tomography and coronary angiography in 65 patients were analyzed retrospectively."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Among the 455 coronary arteries evaluated, the sensitivity, specificity and accuracy of 64-slice computed tomography were 54.6%, 95.1%, and 85.5%, respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "64-slice computed tomography has a good potential in the diagnosis of coronary atherosclerosis with excellent sensitivity and specificity."
        }
      ]},
