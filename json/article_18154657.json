      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "RATIONALE",
          "content": "Alström syndrome is an autosomal recessive disorder characterized by hearing loss, blindness, obesity, non-insulin dependent diabetes, and others."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "PATIENT CONCERN",
          "content": "A 10 years old Saudi girl, who presented with diabetic ketoacidosis and found to have hearing loss and blindness."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DIAGNOSIS",
          "content": "Alström syndrome."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Multidisciplinary team approach, with echocardiography, hearing test, eye exam and genetic test for Alström syndrome."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "OUTCOMES",
          "content": "The patient has retinitis pigmentosa, bilateral hearing loss, double diabetes with weakly positive anti-insulin antibodies and DNA analysis showed novel mutation for Alström syndrome."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "LESSONS",
          "content": "the combination of obesity, diabetes, hearing loss and blindness should alert the physician to test for Alström syndrome."
        }
      ]},
