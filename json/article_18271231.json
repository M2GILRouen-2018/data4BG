      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the therapeutic effects between acupuncture and Bezoxazocine injection in treatment of orthopedic postoperative pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Sixty patients were randomly divided into an acupuncture group and a medication group, 30 cases in each group. The patients in the acupuncture group were treated by acupuncture at Xuanzhong (GB 39) as main point and Ashi points for 30 minutes; the medication group were treated by intramuscular injection of Bezoxazocine injection, 20 mg once, three times per day. Then the pain changes within 48 hours were observed and recorded in two groups."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The good rates at 24 hours and 48 hours were 89.2% and 100.0% in the acupuncture group and 81.4% and 96.3% in the medication group, respectively. The analgesic effect of acupuncture was better than that of Bezoxazocine injection (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Analgesic effect of acupuncture at Xuanzhong (GB 39) on orthopedic postoperative pain and Ashi points is better than Bezoxazocine injection."
        }
      ]},
