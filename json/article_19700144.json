      "Abstract": {
        "CopyrightInformation": "©2014 American Association for Cancer Research.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Children with Down syndrome have unique immune profiles and increased leukemia susceptibility."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Mothers of 158 children with Down syndrome diagnosed with acute leukemia at 0 to 19 years in 1997 to 2002 and 173 children with Down syndrome but no leukemia were interviewed. Associations were evaluated via multivariable unconditional logistic regression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No associations were detected for asthma, eczema, allergies, or hypothyroidism. Diabetes mellitus associated with leukemia (OR = 9.23; 95% confidence interval 2.33-36.59); however, most instances occurred concurrent with or after the leukemia diagnosis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPACT",
            "content": "Children with Down syndrome who develop leukemia have increased diabetes risk, likely due to treatment and underlying susceptibility factors."
          }
        ]
      },
