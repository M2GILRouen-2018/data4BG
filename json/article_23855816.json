      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Evaluate analgesic efficacy, functional benefit, and patient satisfaction with fentanyl buccal tablet vs immediate-release oxycodone for breakthrough pain (BTP)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized, double-blind, active-controlled crossover trial and 12-week open-label extension."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Forty-two U.S. sites."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Opioid-tolerant patients with predominantly chronic noncancer pain experiencing BTP."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Patients were randomized to open-label titration periods with fentanyl buccal tablet followed by oxycodone or vice versa for BTP management. After titrating to a successful dose of both medications (single dose providing adequate analgesia without unacceptable adverse events), patients were re-randomized to treat 10 BTP episodes with one medication and 10 with the other."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "The primary efficacy measure was pain intensity (PI) difference 15 minutes postdose. Secondary measures included PI difference 5, 10, 30, 45, and 60 minutes postdose; sum of PI differences 30 and 60 minutes postdose; ≥33% and ≥50% reduction in PI; and pain relief. Questionnaires assessed functional status/satisfaction."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 213 patients enrolled, 149 achieved a successful dose of both medications; 131 completed the double-blind phase and 112 the open-label phase. PI difference at 15 minutes (mean [standard deviation]) was greater with fentanyl buccal tablet (0.88 [1.20]) vs oxycodone (0.76 [1.13]; P\u2009<\u20090.001). Patients preferred fentanyl buccal tablet (47%) over oxycodone (35%); 18% had no preference. Patients and clinicians reported consistently better functional improvement and satisfaction with fentanyl buccal tablet vs short-acting opioids (P\u2009<\u20090.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Fentanyl buccal tablet was associated with rapid onset of analgesia and improvements in functional status and patient satisfaction compared with immediate-release oxycodone."
          }
        ]
      },
