      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effect of two intervention modalities concerning overweight and obesity among children in general practice."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A total of 60 general practices in the former County of Funen, Denmark."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Overweight children, identified by International Obesity Task Force criteria, aged 5-9 years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Model 1 with health consultations in general practice during a two-year period or Model 2, an educational programme for the children and their families in addition to the health consultations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Change in body mass index (BMI) z-score in order to compare the results, independent of gender- and age-related changes over time."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 80 children were recruited with 35 and 45 children allocated to Model 1 and Model 2, respectively. No significant differences were found in the change in BMI z-score (SDS) between the two groups. A decrease in the mean BMI z-score from baseline to study end of -0.20 (95%CI -0.38 to -0.01) in Model 1 and -0.26 (95%CI -0.44 to -0.09) in Model 2, respectively, was detected. The majority of the participants (2/3) continued in the study for more than one year in both models, with a mean of 12 consultations in general practice."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In this particular setting the two intervention strategies against overweight and obesity did not differ significantly with regard to change in BMI z-scores."
        }
      ]},
