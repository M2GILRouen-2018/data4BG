      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Our aim was to evaluate the effects of percutaneous laser disc decompression (PLDD) as discogenic pain treatment using the MacNab criteria."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND DATA",
          "content": "Discogenic back pain is believed to be produced from tears in the posterior longitudinal ligament and annulus fibrosus. This pain is exacerbated through increases in intradiscal pressure via provocative discograms and transmitted through the sinuvertebral nerve."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "A total of 37 patients were selected based on clinical findings and provocative discograms. These patients underwent PLDD to the affected disc and were interviewed via telephone and outcome evaluated based on the MacNab criteria."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Survey results revealed that 14 patients (44%) reported a good response, 14 (44%) reported a fair response, and four (12.5%) reported a poor response. The 28 patients (88%) who reported a good and fair response were considered to be successful cases."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "PLDD is a safe, effective, and minimally invasive procedure that can be used to treat patients with discogenic back pain."
        }
      ]},
