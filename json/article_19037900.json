      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case report and literature review is presented."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To review relevant data for the management of Bertolotti's syndrome and to determine whether the transverse process-ilium articulation may be a pain generator."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Bertolotti's syndrome is associated with axial low back pain secondary to arthritic changes; the pain generator in the disorder is unclear."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We present a case report of symptomatic Bertolotti's syndrome managed with intra-articular steroid injections."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A patient with Bertolotti's syndrome had significant relief of axial pain after steroid injection of the ilium-transverse process articulation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Steroid therapy may be a non-surgical alternative for the treatment of symptomatic Bertolotti's syndrome."
        }
      ]},
