      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Exercise induced broncho-constriction (EIB) is a significant problem in asthmatic patients. The link between allergic rhinitis and asthma is now well established. Patients with allergic rhinitis may have EIB."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study compared the effects of desloratadine and placebo on EIB in a group of patients with allergic rhinitis and EIB."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This was a double blind placebo controlled, randomized, crossover study. Exercise challenge tests were performed before and after 7 days of treatment with either 5 mg desloratadine or placebo. Patients then underwent a washout period for 7 days and were crossed over to receive either 5mg desloratadine or placebo. The exercise challenge tests were repeated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Desloratadine had no effect on the reduction in percentage fall in FEV(1), the AUC (0-60 min) and the time to recovery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Desloratadine has no effect in attenuating the broncho-constriction caused by exercise in patients with allergic rhinitis and exercise induced broncho-constriction."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CLINICAL IMPLICATIONS",
          "content": "Patients with allergic rhinitis and exercise induced broncho-constriction must be treated with either a beta(2)-agonist or LRTA for relief or prophylaxis of their EIB."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CAPSULE SUMMARY",
          "content": "Desloratadine does not have an effect on exercise induced bronchoconstriction. Patients with allergic rhinitis with exercise induced bronchoconstriction who are on desloratadine will still require treatment with beta(2) agonist or leukotriene receptor antagonist for their symptoms."
        }
      ]},
