      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Neck and shoulder complaints can be a direct result of a neck dissection."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Maximal active lateral flexion of the neck, forward flexion and abduction of the shoulder, and self-perceived function were determined in 145 patients treated for oral cancer."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No short-term influence of radiotherapy was found on measured range of motion and self-perceived neck and shoulder function (p > .05). One year after a bilateral neck dissection, patients showed deteriorated lateral flexion of the neck, whereas patients treated with a unilateral modified radical neck dissection still reported pain during neck movements. Maximal forward flexion of the shoulder recovered to the level of healthy controls, but maximal abduction was still reduced in all patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Neck dissection, tumor site, and extensive reconstruction are related to deterioration of shoulder function shortly after intervention. Maximal active shoulder abduction was affected most."
          }
        ]
      },
