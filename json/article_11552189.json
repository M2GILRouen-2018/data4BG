      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study the effect of manipulating a shoulder with adhesive capsulitis (frozen shoulder) under anesthesia with and without corticosteroid injection."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Twenty-four patients referred for manipulation of a frozen shoulder."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "The patients were randomized into 2 groups. One group received an injection of corticosteroid and manipulation; the other was only administered manipulation during anesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The degree of shoulder mobility and pain before and after the manipulation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Manipulation under anesthesia increased the mobility of the affected shoulder. Injection with lidocaine and betamethason did not enhance the effect of the manipulation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Manipulation under anesthesia without intraarticular corticosteroids is recommended as the therapy for frozen shoulder."
        }
      ]},
