      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CONTEXT",
            "content": "Integrative medicine (IM) is a rapidly growing field whose providers report clinical success in treating significant stress, chronic pain, and depressive and anxiety symptoms. While IM therapies have demonstrated efficacy for numerous medical conditions, IM for psychological symptoms has been slower to gain recognition in the medical community."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE AND DESIGN",
            "content": "This large, cross-sectional study is the first of its kind to document the psychosocial profiles of 4182 patients at 9 IM clinics that form the BraveNet Practice-Based Research Network (PBRN)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "IM patients reported higher levels of perceived stress, pain, and depressive symptoms, and lower levels of quality of life compared with national norms. Per provider reports, 60% of patients had at least one of the following: stress (9.3%), fatigue (10.2%), anxiety (7.7%), depression (7.2%), and/or sleep disorders (4.8%). Pain, having both physiological and psychological components, was also included and is the most common condition treated at IM clinics. Those with high stress, psychological conditions, and pain were most frequently treated with acupuncture, IM physician consultation, exercise, chiropractic services, diet/nutrition counseling, and massage."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "With baseline information on clinical presentation and service utilization, future PBRN studies can examine promising interventions delivered at the clinic to treat stress and psychological conditions."
          }
        ]
      },
