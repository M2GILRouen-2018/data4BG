      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE OF REVIEW",
          "content": "Description of recent studies evaluating growth and inhaled corticosteroids."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RECENT FINDINGS",
          "content": "Corticosteroids are the gold standard of asthma maintenance treatment, but effects on growth remain controversial. This is a review of recent research in this area, which has focused on medications causing less adrenal suppression as well as alternative regimens for chronic illness such as asthma."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "The use of newer corticosteroids and regimens shows short-term evidence of minimal growth effects without worsening of asthma control."
        }
      ]},
