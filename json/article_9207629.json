      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The present study aimed to determine the role of nitric oxide (NO) and angiotensin-converting enzyme (ACE) in bradykinin (BK)-induced dilation of human coronary arteries in vivo."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "BK, produced by way of the kinin-kallikrein system, causes endothelium-dependent vasodilation. However, little is known about the mechanism of BK-induced dilation of coronary arteries in humans in vivo."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The effects of an inhibitor of NO synthesis and of an ACE inhibitor on BK-induced coronary vasodilation were examined in 20 patients who had no significant atherosclerotic stenosis in the artery under study. Lumen diameters of the large epicardial coronary arteries and coronary blood flow (CBF) were measured by quantitative coronary arteriography and intracoronary Doppler technique."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Intracoronary infusion of BK (0.6 and 2.0 micrograms/min) increased coronary artery diameter and CBF with no change in arterial pressure or heart rate. The BK-induced increases in coronary artery diameter and CBF were significantly reduced (p < 0.01) after pretreatment with NG-monomethyl-L-arginine (200 mumol) and were significantly increased (p < 0.01) after pretreatment with enalaprilat (50 micrograms)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "BK-induced dilation of human large epicardial and resistance coronary arteries is mediated by NO and increased by prior ACE inhibition."
        }
      ]},
