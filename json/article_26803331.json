      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier HS Journals, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To describe a case of breakthrough pain associated with a reduction in serum buprenorphine concentration during dialysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Pharmacokinetic sampling of total and free buprenorphine and norbuprenorphine in an 80 year old male undergoing haemodialysis three times per week who received 5760 µg oral and transdermal buprenorphine daily was performed. The patient's serum albumin concentration was 23g/l (reference range: 35-52 g/l)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "Pharmacokinetic sampling revealed a free buprenorphine fraction of 32% (consistent with the hypoalbuminaemia), which was markedly reduced at the end of dialysis (free buprenorphine concentration 2.4 µg/l before vs. <0.1 µg/l after dialysis)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS",
            "content": "Clinicians should be aware that some patients may require extra buprenorphine doses during dialysis to prevent significant falls in the concentration of active drug."
          }
        ]
      },
