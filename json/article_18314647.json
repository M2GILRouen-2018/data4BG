      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To probe the use of Zoledromic acid in the control of the pain due to bone methastasis of a prostate cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHOD",
          "content": "We included in our study 37 consecutive patients diagnosed of prostate cancer who developed bone methastasis during 2005 and 2006 to whom we gave a 4 mg dose of Zoledromic acid during a mean time of 10.24 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "We observed a complete control of the pain in 8 of the 20 patients, and partially in 6 of those patients. We did not evaluate any adverse reaction due to this treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "We still yet to know whether the administration of this treatment in the early stages of the prostate cancer could prevent or retard the appearance of bone methastasis."
        }
      ]},
