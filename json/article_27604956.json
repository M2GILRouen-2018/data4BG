      "Abstract": {
        "CopyrightInformation": "Copyright© Bentham Science Publishers; For any queries, please email at epub@benthamscience.org.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM AND OBJECTIVE",
            "content": "Rheumatoid Arthritis (RA) is a progressing autoimmune inflammatory disease of joint, hallmarked by inflammation, pain and atrophy of bones. Toll-like receptor 5 (TLR5) is a novel inflammatory mediator in RA, and TLR5 inhibitors are speculated to have a therapeutic potential for the treatment of RA."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHOD",
            "content": "Here we applied fragment pharmacophore-based virtual screening to identify novel TLR5 ligands."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Among compounds collected from Otava peptidomimetic compounds, Maybridge fragment and ZINC libraries, 3355 compounds were selected for docking into the flagellin-binding site of TLR5. 16 compounds with the required interaction, critical amino acid residues and the binding free energies <-7 kcal/mol were identified as potential TLR5 inhibitors, one of which was followed up by molecular dynamics simulation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These compounds open a possibility to discover novel TLR5 inhibitors for the treatment of RA."
          }
        ]
      },
