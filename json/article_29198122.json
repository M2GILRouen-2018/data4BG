      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Mobile phone application may cause structural, functional changes and accumulation of toxic elements in brain."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The aim of this study was to investigate iron accumulation in rabbit cerebellum after exposure to RF EMF with light and scanning electron microscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Histochemical analysis of iron distribution by light and electron microscopy with energy-dispersive microanalysis was used."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Light microscopy revealed dystrophic changes of Purkinje cells in irradiated groups and iron deposits located in various parts of cerebellum. Deposits consists of C, O, Na, Mg, Al, Si, P, S, Cl, Ca and Fe."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Our experiment revealed structural changes of Purkinje cells and iron and aluminium accumulations in stratum granulosum of rabbit's cerebellum after exposure to RF EMF (Fig. 6, Ref. 33)."
        }
      ]},
