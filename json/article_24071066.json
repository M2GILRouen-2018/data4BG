      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To report our experience related to the use of spinal cord stimulation (SCS) for relief of chronic pancreatitis-related neuropathic visceral pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Two patients, 50 years old and 39 years old, presented with intractable visceral pain related to chronic pancreatitis. A quadripolar electrode for SCS was inserted at the T8-10 level using a percutaneous technique. After a successful trial, a permanent stimulator was inserted."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "At a mean follow-up of 7 years, both patients showed a marked improvement, with 80% and 90% decrease of pain, respectively, as assessed by Visual Analogue Scale. Pain medications were discontinued in both cases."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "SCS appears to be an effective long-term treatment for neuropathic visceral pain related to chronic pancreatitis."
          }
        ]
      },
