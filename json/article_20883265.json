      "Abstract": {
        "CopyrightInformation": "© 2010 The International Society of Dermatology.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The gold standard treatment of Old World leishmaniasis, a common tropical parasitic infestation, is intralesional meglumine antimoniate injection. Mesotherapy is a new minimally invasive method of administration of variable substances to the skin."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Comparison of the efficacy and adverse effects of treatment of leishmaniasis with intralesional injection of meglumine antimoniate using conventional method and mesotherapy method."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Eighty-five patients with proven leishmaniasis were recruited and randomly treated by one of the two methods, either by conventional injection or by mesotherapy administration weekly. Lesion characteristics were evaluated at every treatment session as well as 1 week, 1 month and 3 months after cessation of treatment."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The improvement in lesions was similar in both groups, while it was noted sooner in mesotherapy group with less amount of drug usage (P = 0.005 and 0.016 respectively). Also, patients treated with mesotherapy experienced less pain severity (P = 0.005)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Mesotherapy is a safe and effective method of meglumine antimoniate injection for the treatment of cutaneous leishmaniasis and is less painful."
          }
        ]
      },
