      "Abstract": {
        "CopyrightInformation": "© 2015 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Leprosy is a major source of nerve damage and may lead to neuropathic pain as well as complex regional pain syndrome (CRPS). Spinal cord stimulation is an effective treatment for CRPS, but there are no reports of this treatment in a patient with leprosy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE PRESENTATION",
            "content": "The patient is a 55-year-old man who presented with CRPS in the arms and legs secondary to leprosy that persisted despite multidrug therapy, steroid treatment, and intravenous immunoglobulin. His pain and opioid use were both decreased with insertion of cervical and thoracic spinal cord stimulators."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Spinal cord stimulation may be a valuable intervention for patients with leprosy-induced CRPS."
          }
        ]
      },
