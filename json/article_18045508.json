      "Abstract": {
        "CopyrightInformation": "Published by the BMJ Publishing Group Limited. For permission to use (where not already granted under a licence) please go to http://group.bmj.com/group/rights-licensing/permissions.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To produce free, expert-informed postoperative information for lumbar discectomy patients, satisfying UK National Health Service Information Standards."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A mixed methods approach utilising the Delphi technique and focus groups."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Five spinal centres across the UK."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Panel members included 23 physiotherapists, 11 patients and 17 spinal surgeons."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Three rounds of questionnaires including open and closed questions and attendance at a clinician/patient focus group."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Response rates of 85%, 26% and 35% were achieved for the Delphi rounds. Ten clinicians and six patients participated in the focus groups. Consensus for leaflet sections was achieved in round 1 and content in round 3. The focus groups informed further revisions."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A consensually agreed, Information Standard compliant, patient lumbar discectomy leaflet was produced containing: (1) normal spine anatomy; (2) anatomy disc herniation and surgery; (3) back protection strategies and (4) frequently asked questions. Illustrations of exercises enable tailoring to the individual patient."
          }
        ]
      },
