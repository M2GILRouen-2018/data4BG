      "Abstract": {
        "CopyrightInformation": "Crown Copyright © 2016. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Laparoscopic sleeve gastrectomy (LSG) is an effective treatment for obesity and associated metabolic complications. Obesity and type 2 diabetes are associated with increased oxidative stress. Previous studies have examined changes in plasma oxidative stress after laparoscopic Roux-en-Y gastric bypass, but there is limited evidence of the effects of LSG."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To examine the effects of LSG on plasma thiobarbituric acid reactive substances (TBARS) and total antioxidant status (TAOS) at 1 and 6 months after LSG in patients with obesity and impaired glucose regulation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University hospital, United Kingdom."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twenty-two participants with impaired glucose homeostasis undergoing LSG (body mass index 50.1 kg/m(2), glycated hemoglobin 53 mmol/mol) were studied. Measurements of fasting and 120-minute TBARS and TAOS were performed during an oral glucose tolerance test preoperatively and postoperatively."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Compared with preoperative levels, significant decreases were seen 6 months postoperatively in fasting TBARS (61.0±17.9 versus 39.4±13.8 ng/mL, P = .04) and 120-minute TBARS (76.0±29.5 versus 46.5±16.3 ng/mL, P = .02). No significant changes were observed in plasma TAOS. No significant association was observed between changes in TBARS and other clinical or biochemical measures."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "We observed a significant reduction in TBARS, a global measure of lipid peroxidation 6 months after LSG in participants with obesity and impaired glucose regulation."
          }
        ]
      },
