      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe demographic and disability-related characteristics, to examine the patterns of treatment for depression, and to investigate correlates of depression severity and predictors of who receives treatment among a sample of depressed rural women with physical disabilities."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A correlational analysis of data gathered from women recruited for a depression intervention study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Rural centers for independent living located in nine different states across the United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Women (N=134) who reported at least mild depression and expressed interest in participating in a depression intervention study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Depressive symptomatology based on the Beck Depression Inventory-II; treatment for depression in the past 3 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The majority of participants reported moderate to severe depression (n=101, 75.4%), with nearly 20% reporting thoughts of suicide. At risk of severe depression were women who were younger, had greater problems with pain, had more limited mobility, and were less satisfied with their social network. Despite the high levels of depressive symptomatology in the sample, more than one third of the women had not received recent treatment for depression."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This study suggests that depression and access to treatment are critical issues for women with physical disabilities living in rural areas."
        }
      ]},
