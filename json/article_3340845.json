      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The aim of this study was to analyze the relationship between the specific level of knowledge on health and back care-related physical activity practice and exercise with low back pain (LBP) in adolescents."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This is a cross-sectional study. The sample consisted of a total of 576 adolescents aged 13-18 years (mean age 15.5, SD 1.4). Self-reported questionnaires were used to record specific knowledge on health and back care and LBP in healthy adolescents."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The prevalence of LBP was 46.3% [95% confidence interval (CI) 44.9-47.8]. Students with LBP scored slightly higher than non-sufferers, getting non-significant values. The level of specific knowledge increased with age (F = 7.308; p = 0.002). Stepwise logistic regression analysis showed that older girls group (>16 years old) was significantly associated with LBP odds ratio (OR) 2.9 (95% CI 1.77-4.74; p = 0.000)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "High school students have a low level of specific knowledge. Back care education in the school curriculum is recommended."
        }
      ]},
