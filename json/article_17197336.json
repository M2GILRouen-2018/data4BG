      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND CONTEXT",
          "content": "Discography has been successfully used to distinguish painful from asymptomatic intervertebral discs."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report a case of chronic back pain following two-level interbody and posterolateral fusion in the lumbar spine that was evaluated with marcaine injection into the disc space."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A patient with chronic back pain after a two-level anteroposterior lumbar fusion was evaluated. A complete description of the history, physical examination, and relevant radiographic images along with a brief review of the pertinent literature are included."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Injection of marcaine into the area of previous interbody fusion resolved the painful symptoms, and surgery confirmed the nonunion."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In cases of interbody lumbar fusion with questionable solidity, marcain injection within the disc space can help in the assessment of the source of pain even at the intervertebral spaces with cages."
        }
      ]},
