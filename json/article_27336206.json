      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the feasibility of a brief, intensive weight loss intervention (IWL) to improve reproductive outcomes in obese subfertile women."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Pilot study of IWL versus standard-of-care nutrition counseling (SCN)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Single-site, academic institution."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Obese women (body mass index, 35-45 kg/m(2)) with anovulatory subfertility."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Women were rigorously prescreened to rule out secondary causes of subfertility. Eligible women were randomized to IWL or SCN. IWL consisted of 12 weeks of very-low-energy diet (800 kcal/day) + 4 weeks of a low-calorie conventional food-based diet (CFD) to promote 15% weight loss. SCN consisted of 16 weeks of CFD to promote ≥5% weight loss. Women were transitioned to weight maintenance diets and referred back to reproductive endocrinology for ovulation induction."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Feasibility of recruitment, randomization, intervention implementation, and retention."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Thirty-nine women were screened; 25 (64%) were eligible to participate, and 14 of those eligible (56%) agreed to be randomized, seven in each group. One withdrew from the IWL group and two from the SCN group. Percent weight loss was greater in the IWL group than in the SCN group (13% ± 5% vs. 4% ± 4%). Three of six women in the IWL group conceived and delivered term pregnancies. No pregnancies occurred in the SCN group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "After rigorous screening, 44% of eligible women completed the study. IWL was associated with greater percentage weight loss and improvements in insulin sensitivity."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CLINICAL TRIAL REGISTRATION",
            "content": "NCT01894074."
          }
        ]
      },
