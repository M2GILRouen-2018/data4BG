      "Abstract": {
        "CopyrightInformation": "© 2014 Nordic Federation of Societies of Obstetrics and Gynecology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To study the frequency and determinants of potentially avoidable planned cesarean sections, with a classification based on their indications, maternal obstetric history, and information about the current pregnancy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional population-based study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "All maternity units in France (n = 535)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "POPULATION",
            "content": "A total of 14,681 women from the 2010 French National Perinatal Survey, a routine survey of a representative sample of births."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Planned cesareans were classified in two groups: potentially avoidable and unavoidable. The classification was based on the French national guidelines and used data from medical records. We used logistic regression analyses to compare characteristics of the mothers with potentially avoidable cesareans with those of women who had a trial of labor. Analyses were performed separately in primiparas and multiparas."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE",
            "content": "Rate of potentially avoidable planned cesarean sections."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The overall planned cesarean rate was 10.9%; 28% of these cesareans were found to be potentially avoidable. Breech presentation and history of one previous cesarean accounted for 83% of them. Determinants of potential avoidability were maternal age >35 years, intensive surveillance during pregnancy, and private status of the unit [adjusted odds ratio (OR) 1.9, 95% CI 1.2-3.2 among primiparas; adjusted OR 2.5, 95% CI 1.5-4.3 among multiparas]. Obesity was also a significant determinant but only among multiparas (adjusted OR 2.7, 95% CI 1.9-3.8). No association was found with maternal social characteristics."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Our results suggest a high proportion of potentially avoidable cesareans and highlight the associated obstetric situations. They can help to target policies aimed at reducing cesarean rates."
          }
        ]
      },
