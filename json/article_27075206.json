      "Abstract": {
        "CopyrightInformation": "© 2016 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS AND OBJECTIVES",
            "content": "To determine consensus across acute care specialty areas on core physical assessment skills necessary for early recognition of changes in patient status in general wards."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Current approaches to physical assessment are inconsistent and have not evolved to meet increased patient and system demands. New models of nursing assessment are needed in general wards that ensure a proactive and patient safety approach."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A modified Delphi study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Focus group interviews with 150 acute care registered nurses at a large tertiary referral hospital generated a framework of core skills that were developed into a web-based survey. We then sought consensus with a panel of 35 senior acute care registered nurses following a classical Delphi approach over three rounds. Consensus was predefined as at least 80% agreement for each skill across specialty areas."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Content analysis of focus group transcripts identified 40 discrete core physical assessment skills. In the Delphi rounds, 16 of these were consensus validated as core skills and were conceptually aligned with the primary survey: (Airway) Assess airway patency; (Breathing) Measure respiratory rate, Evaluate work of breathing, Measure oxygen saturation; (Circulation) Palpate pulse rate and rhythm, Measure blood pressure by auscultation, Assess urine output; (Disability) Assess level of consciousness, Evaluate speech, Assess for pain; (Exposure) Measure body temperature, Inspect skin integrity, Inspect and palpate skin for signs of pressure injury, Observe any wounds, dressings, drains and invasive lines, Observe ability to transfer and mobilise, Assess bowel movements."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Among a large and diverse group of experienced acute care registered nurses consensus was achieved on a structured core physical assessment to detect early changes in patient status."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "RELEVANCE TO CLINICAL PRACTICE",
            "content": "Although further research is needed to refine the model, clinical application should promote systematic assessment and clinical reasoning at the bedside."
          }
        ]
      },
