      "Language": "rus",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To assess immediate and long-term outcomes after BioDiamond-stent implantation in patients with native coronary artery disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "The BioDiamond stent was implanted in 112 patients with 132 de novo lesions. Most patients (54%) had unstable angina, 33% of the lesions were of type B2-C."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No stent deployment failure occurred as well as acute or subacute stent thrombosis. The 6-month angiographic follow-up was obtained in 108 patients (98%) (125 lesions). The loss index was 0.40 +/- 0.27. Angiographic restenosis rate occurred in 14%. Repeat target lesion revascularization was successful in 16 patients with restenosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The results of this study indicate a potential benefit of BioDiamond for prevention of stent thrombosis and restenosis in these relatively high-risk patients."
        }
      ]},
