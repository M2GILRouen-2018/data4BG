      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a successful treatment of symptomatic adenomyosis using magnetic resonance-guided focused ultrasound surgery (MRgFUS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "General hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 47-year-old premenopausal woman with focal symptomatic adenomyosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "MRgFUS."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Score on the Uterine Fibroids Symptoms Quality of Life (UFS-QOL) questionnaire and the degree of menstrual pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Uterine Fibroids Symptoms reduced from 53 to 28 and the degree of menstrual pain reduced from 10 to 5."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "For adenomyosis patients who wish to preserve their uterus, MRgFUS may be a promising alternative to hysterectomy. Additional studies of the safety and efficacy of MRgFUS in this indication should be conducted."
        }
      ]},
