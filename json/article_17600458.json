      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Socioeconomic status (SES) and racial-ethnic disparities in smoking cessation among U.S. adults with a history of asthma have received limited attention."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This study examined sociodemographic characteristics associated with smoking cessation in national samples of adults with a self-reported history of asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Data from the National Health Interview Survey (years 2000 and 2001 combined) was used to assess the quit ratio (i.e., former smokers as a proportion of ever-smokers) by sociodemographic characteristics, and predictors of former versus current smoking status were examined with multiple logistic regression."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Quit ratios were 53% in Hispanics, 52% in non-Hispanic Whites, and 42% in African American ever-smokers. The quit ratio reached 70% in college graduates versus 45% in those with less than 12 years of education. In multivariate analyses, education and marital status but not racially classified social groups/ethnicity were independently associated with former versus current smoking."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Expanded smoking cessation efforts are needed among persons with a history of asthma, especially those of lower SES."
        }
      ]},
