      "Abstract": {
        "CopyrightInformation": "© 2017 The American Laryngological, Rhinological and Otological Society, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of the study was to investigate whether extracapsular dissection of a primarily unsuspected lesion in the parotid gland could be oncologically sufficient for carefully selected cases of parotid gland malignomas."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Retrospective clinical study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The records of all patients treated for primary malignant tumors of the parotid gland solely by means of extracapsular dissection between 2006 and 2013 were studied retrospectively. Patients with manifestation of malignant tumors in the parotid gland that were not of primary salivary gland origin (squamous cell carcinomas, lymphomas, melanomas) or who had had revision surgery or other malignant tumors in their history, as well as patients with insufficient data, were excluded from our study sample."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Nine patients, all with low-grade parotid malignancies, were detected. Our study showed acceptable oncologic and functional outcomes throughout."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Our study was able to show very encouraging preliminary results following primary extracapsular dissection as sole surgical therapy for carefully selected low-stage, low-grade, inferiorly located lesions in patients with high compliance."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "4. Laryngoscope, 127:1804-1807, 2017."
          }
        ]
      },
