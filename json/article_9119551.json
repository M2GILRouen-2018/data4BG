{"PubmedArticle": {
  "MedlineCitation": {
    "Status": "MEDLINE",
    "Owner": "NLM",
    "Article": {
      "Pagination": {"MedlinePgn": "266-75"},
      "PublicationTypeList": {"PublicationType": {
