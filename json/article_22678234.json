      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Recently, Th17 cells have been found to participate in the pathogenesis of allergic asthma. IL-23 is a cytokine that may be implicated in modulating Th17 response. This study aimed at evaluating IL-23 and relating it to lung function in asthmatic children."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Seventy-eight asthmatic children and 40 healthy children were evaluated. Spirometry and serum IL-23 measurement (ELISA kit) were performed in all asthmatic children."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "IL-23 levels were higher in asthmatic than in healthy children (p < 0.001). There was a strong inverse relationship between FEV(1) and IL-23 (r = -0.787)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This preliminary study suggests that serum IL-23 could be a suitable marker of bronchial function impairment in allergic asthmatic children."
          }
        ]
      },
