      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 SESPAS. Published by Elsevier Espana. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To analyse the trend in potentially avoidable hospitalisations (PAH) in frail patients or those with chronic conditions in Spain during the period 2002-2013."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "An observational, ecological study was conducted to analyse the trend in age-sex standardised rates of PAH affecting six clinical conditions, and their variation, in the 203 health care areas composing the publicly-funded health system in Spain."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "During the period 2002-2013, overall PAH standardised rates decreased by 35%, but systematic variation remained moderately high, around 13% above that expected by chance. Angina admissions showed the largest reduction, followed by those for asthma and chronic obstructive pulmonary disease. In contrast, the prevalence of admissions for dehydration doubled."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Despite the decrease in PAH rates, systematic variation among areas remains, indicating differences in chronic care management that lead to distinct healthcare outcomes."
          }
        ]
      },
