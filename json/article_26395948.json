      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Aortic knob width on chest radiography is independently related to cardiovascular disease. However, little is known about the correlation between aortic knob width and central hemodynamics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Central blood pressure was measured invasively with diagnostic catheter in 92 patients with known or suspected coronary artery disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Aortic knob width was positively associated with age (r = 0.42; p < 0.001), central systolic blood pressure (r = 0.35; p < 0.001) and central pulse pressure (r = 0.34; p < 0.001). Multivariate analysis showed that larger aortic knob width was independently related to the higher central systolic blood pressure."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Lager aortic knob width on chest radiography is an independent predictor of increase of central systolic blood pressure."
        }
      ]},
