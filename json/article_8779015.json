      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A cross-sectional survey was conducted."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To describe the occurrence of back pain and associated behaviors and disabilities in a semitraditional Australian aboriginal community."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "There are few studies of back pain in isolated and nonindustrial societies."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The authors lived with, observed, and interviewed most adult members of a small aboriginal community and placed information about spinal pain in context of aboriginal beliefs and practices."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Nearly half the adults in this community experienced long-term private spinal pain, but because of their cultural beliefs, did not commonly make this pain public."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Cultural beliefs and practices influence how people respond to back pain in themselves and in others, including how and whether they present to health professionals or seek involvement of others."
        }
      ]},
