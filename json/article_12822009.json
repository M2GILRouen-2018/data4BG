      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "This report considers the relationship between the effect of training on pain and joint manifestations in patients with rheumatoid arthritis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A review of randomized controlled trials published from 1997 to February 2001."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Six randomized controlled trials confirm results from previous research indicating that exercise leads to unchanged or reduced self-reported pain and unchanged or reduced tender joint counts in patients in ACR functional classes I or II with low to moderate disease activity. This effect may possibly be generalized to patients with higher disease activity. The effect is less clearly demonstrated in patients with serious joint destruction and loss of function."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "INTERPRETATION",
          "content": "The results indicate that exercise leads to unchanged or reduced self-reported pain and joint tenderness for patients with rheumatoid arthritis. Further studies are needed in order to demonstrate to what extent and how different kinds of exercise influence pain and joint tenderness in rheumatoid arthritis patients."
        }
      ]},
