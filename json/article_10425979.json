      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "An 8-week parallel, placebo-controlled, double-blind trial evaluated the efficacy of the antidepressant trazodone in the treatment of chronic burning mouth pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Thirty-seven carefully selected women aged 39 to 71 (mean 58.6 years) were randomized to receive either 200 mg of trazodone or a placebo in a similar manner. Pain and pain-related symptoms were evaluated on a visual analogue scale and other measures at 0, 2, 4, and 8 weeks."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no significant differences between the groups in treatment effects for pain or pain-related symptoms. Seven patients in the trazodone group and 2 in the placebo group failed to complete the trial because of side effects. The most common side effects were dizziness and drowsiness."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In this controlled trial, trazodone failed to relieve burning mouth pain."
        }
      ]},
