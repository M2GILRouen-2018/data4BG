      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe the outcome of cases with subacromial impingement syndrome managed with arthroscopic subacromial decompression."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Quasi-experimental study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PLACE AND DURATION OF STUDY",
          "content": "Section of Orthopaedics, Department of Surgery, The Aga Khan University Hospital, Karachi from April 2005 to March 2006."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODOLOGY",
          "content": "Thirty patients with impingement syndrome who underwent arthroscopic subacromial decompression after failed conservative treatment were included. The Constant and Murley shoulder scoring system was used for the clinical assessment of pain and function pre-operatively and 1, 6 and 24 weeks postoperatively."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The postoperatively significant improvement was observed in the Constant and Murley scores in all the patients (by mean 40 points, p < 0.01), which was progressive over six months. Lower scores were noted in patients over 40 years of age, with advanced stage of impingement and partial tears of the rotator cuff."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Arthroscopic subacromial decompression was effective in reducing pain and improving function in the studied patients with subacromial impingement syndrome."
        }
      ]},
