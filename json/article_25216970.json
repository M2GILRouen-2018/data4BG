      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American College of Allergy, Asthma & Immunology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Several cross-sectional studies have found an association between respiratory disease and increased mood or anxiety disorders among adults. Little is known about the nature of these associations over time or the role of potential confounders in these links."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To investigate the association between respiratory disease and incident and persistent depression or anxiety disorders 10 years later and to examine potential pathways of these associations."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Data were drawn from the Midlife Development in the United States survey, a representative sample of adults in the United States ages 18 to 74 years. Participants (N = 2,101) were interviewed on a range of health domains at baseline at wave 1 (1994) and again at wave 2 (2005)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Respiratory disease was associated with increased odds of depression and anxiety disorders cross-sectionally at both time points. Respiratory disease at wave 1 was not associated with incident depression or anxiety disorders at wave 2. Respiratory disease at wave 1 was associated with increased odds of persistent depression or anxiety disorders 10 years later among those with depression or anxiety disorders at wave 1. Associations were not explained by differences in demographic characteristics, secondhand smoke exposure, cigarette smoking, or history of exposure to childhood maltreatment."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Findings shed new light on the association between respiratory disease and depression or anxiety disorders. Individuals with respiratory disease appear to have higher prevalence of concurrent depression or anxiety disorders and persistent depression or anxiety disorders compared with those without respiratory disease. However, a history of respiratory disease does not appear to confer increased risk of new onset of depression or anxiety disorders."
          }
        ]
      },
