      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE OF REVIEW",
          "content": "Cancer pain management is in continuous innovation and new data are available that could change the therapeutical approach and guidelines."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RECENT FINDINGS",
          "content": "There are different fields of research that produce new data and interesting findings. The principal data regard the factors influencing the analgesic response, breakthrough cancer pain management, opioid switching, and pharmacogenetics."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "The findings reported in this review provide new ideas to be developed in further studies to confirm or not confirm some suggestive data."
        }
      ]},
