      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case of vertebral osteomyelitis secondary to epidural catheter use is reported."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the occurrence of vertebral osteomyelitis after the use of an epidural catheter."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Vertebral osteomyelitis is a rare but serious complication of epidural catheter use that apparently has not been reported previously in orthopedic literature."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A patient underwent abdominal surgery, and an epidural catheter was used for postoperative pain relief. He presented 3 months later with severe midlumbar pain. Magnetic resonance imaging and microbiologic examination of a specimen obtained at open biopsy were used in the investigation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Magnetic resonance imaging suggested vertebral osteomyelitis involving L1-L3. The patient underwent open debridement and posterior instrument stabilization. Biopsies taken from L3 pedicles yielded Pseudomonas aeruginosa, which had been recovered earlier from the epidural catheter tip."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Vertebral osteomyelitis is a rare but serious complication of epidural catheter use."
        }
      ]},
