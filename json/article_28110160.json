      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Childhood trauma has been regarded as a risk factor for adolescent depression. Resilience has been found to be a protective factor for adolescent mental health. However, it is not clear about the role of resilience in the relationship between childhood trauma and depression."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "School attending adolescents (n=6406) aged 9-17 years were drawn from five primary schools, three middle schools and two high schools in Wuhan city of China in 2015. The participants were invited to complete self-report questionnaires, including demographics, childhood trauma, resilience and depressive symptoms."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Resilience played a partially mediating role in the relationship between childhood trauma and depressive symptoms. Resilience also moderated the association of childhood trauma with depressive symptoms."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATION",
            "content": "The limitations of this study include cross-sectional study and self- reported instruments."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "We conclude that resilience may play an important role in the relationship between childhood trauma and depressive symptoms. Our results suggest that enhancing resilience may provide new possibilities for prevention and intervention of depression in adolescents."
          }
        ]
      },
