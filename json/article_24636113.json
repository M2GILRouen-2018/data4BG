      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine associations between technology usage and specific health factors among college students."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The research employed was a quantitative, descriptive, cross-sectional design; undergraduate students enrolled in spring 2012 general health education courses were recruited to participate. To explore college students' specific technology usage and health-related behaviors, a 28-item questionnaire was utilized."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Statistical significant differences of technology usage were found between 3 of the 4 health-related behaviors under study (BMI, sleep, and nutrition) (p < .05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "As technology usage continues to evolve within the college student population, health professionals need to understand its implications on health behaviors."
        }
      ]},
