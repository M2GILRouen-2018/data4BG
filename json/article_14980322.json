      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of this postal survey was to know how were treated infants with hypertrophic pyloric stenosis in France in 1999."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A questionnaire was sent to all French members of the Association Des Anesthésistes Réanimateurs Pédiatriques d'Expression Française (Adarpef)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Half the cases of pyloric stenosis treated in France in 1999 were related by the survey. Preoperative management was short lasting (24 h) while the advised guidelines regarding biologic criteria for operation were poorly followed. Nevertheless, crush induction was only performed in 80%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The management of infants with pyloric stenosis must be improved, at least to obtain the generalization of crush induction."
        }
      ]},
