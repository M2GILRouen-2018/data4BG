      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Several neoplasms including cutaneous T-cell lymphomas, malignant melanoma and Kaposi's sarcoma have been successfully treated with systemic or intralesional interferons (IFNs). Recently, intralesional alpha-IFN has also been employed in the treatment of basal cell carcinoma (BCC)."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of our study was to evaluate the efficacy of IFN alfa-2b in the treatment of BCC."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "140 patients with BCC were treated with intra- und perilesional injections of recombinant IFN alfa-2b at a dosage of 1.5-3 x 10(6) IU, three times a week for 4-8 weeks."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Complete response was achieved in 94 patients (67.1%), partial response in 33 patients (23.6%) and no response in 13 patients (9.3%). Side effects included fever, headache, fatigue and nausea but were reversible with the use of paracetamol. None of the patients discontinued therapy due to side effects. After a mean follow-up period of 36 months (12-54 months) no relapse has been observed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Based on our results, intra- and perilesional IFN alfa-2b represents an effective, alternative treatment for BCC."
        }
      ]},
