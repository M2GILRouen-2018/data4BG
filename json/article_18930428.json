      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "A pilot study was implemented to evaluate the efficacy of patient controlled analgesia (PCA) with continuous intra-articular infusion of ropivacaine following trapeziectomy with ligament reconstruction and tendon interposition."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Twelve patients were prospectively included. A catheter was placed into the trapezium void and connected to a PCA pump set on a continuous intra-articular infusion rate of ropivacaine: 2mg/ml. Patients were allowed to deliver additional boluses when analgesia was incomplete."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pain was evaluated less than 3/10 (Numeric Scale Evaluation) by 92% of the patients during the first 48 h. No toxicity of the local anaesthetic nor catheter-related complication were reported."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This preliminary study showed continuous basal and bolus infusion of ropivacaine through a single catheter placed into the trapezium void to provide an excellent postoperative pain control and to be related to a high patient's satisfaction level."
        }
      ]},
