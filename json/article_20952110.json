      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate maternal labour pain, fatigue, duration of the second stage of labour, the women's bearing-down experiences and the newborn infant Apgar scores when spontaneous pushing is used in an upright position."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Quasi-experimental study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Medical centre in Taichung, Taiwan."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "66 Women giving birth at the hospital, with 33 primigravidas assigned to each group."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "During the second stage of labour, the women in the experimental group pushed from an upright position and were given support to push spontaneously; the women in the control group pushed from a supine position and were supported via Valsalva pushing."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Pain scores were recorded at two evaluation time points: at 10 cm of cervical dilation and one hour after the first pain score evaluation. One to four hours after childbirth, the trained nurses collected the fatigue and pushing experience scores."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "The women in the experimental group had a lower pain index (5.67 versus 7.15, p = 0.01), lower feelings of fatigue post birth (53.91 versus 69.39, p < 0.001), a shorter duration of the second stage of labour (91.0 versus 145.97, p = 0.02) and more positive labour experiences (39.88 versus 29.64, p < 0.001) compared with the control group. There was no significant difference in the Apgar score for newborn infants during either the first minute (7.70 versus 7.73, p = 0.72) or the fifth minute (8.91 versus 8.94, p = 0.64)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "KEY CONCLUSIONS",
            "content": "The pushing intervention during the second stage of labour lessened pain and fatigue, shortened the pushing time and enhanced the pushing experience."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR PRACTICE",
            "content": "Pushing interventions can yield increased satisfaction levels for women giving birth."
          }
        ]
      },
