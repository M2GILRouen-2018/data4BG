      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Available evidence on the prognostic role of procalcitonin levels in acute coronary syndromes (ACS) is so far controversial."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "To evaluate the association between procalcitonin, major cardiovascular events (MACE) and total mortality in acute coronary syndromes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Procalcitonin levels were measured in 247 patients admitted to our Intensive Cardiac Care Unit (ICCU) with ACS. Three subgroups were considered according to procalcitonin levels."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At Cox regression analysis, procalcitonin levels were both an unadjusted and an adjusted predictor (corrected for diagnosis and TnI) of intra-ICCU mortality and of 1-year follow-up MACE and total mortality."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In ACS, admission procalcitonin values identify a \"higher risk\" group of patients for short and long-term mortality."
        }
      ]},
