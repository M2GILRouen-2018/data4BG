      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the interrater reliability of judgments of status change, including the centralization phenomenon during examination of the lumbar spine, and to determine the effects of training and experience on reliability."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A videotape study of judgments by physical therapists and physical therapy students of the results of movement testing during the examination of patients with low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient physical therapy clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Patients receiving physical therapy treatment for low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Patients with low back pain were videotaped while performing a variety of movement tests including single, repeated, and sustained movements. Forty licensed physical therapists and 40 physical therapy students were provided with operational definitions of the three potential judgments of status change with movement testing; centralization, peripheralization, status quo. All therapists and students viewed the videotape and made a judgment regarding the patient's status change in response to the test."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Percentage agreement and kappa coefficient values for agreement."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Interrater reliability was excellent for the total sample of examiners (kappa = .793), for the licensed physical therapists (kappa = .823), and for the students (kappa = .763)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Judgments of status change are reliable when operational definitions are provided. Clinical experience does not appear to substantially improve reliability."
        }
      ]},
