      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This was a preliminary investigation of patients' beliefs about cannabinoids and the associations between those beliefs, beliefs about medication, and personal and pain variables with regard to patients' willingness to try cannabinoids as analgesics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A self-completion questionnaire was used."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The investigation took place in an outpatient pain clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Sixty-seven patients with chronic pain were involved."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "The outcome measures were patients' stated willingness to use cannabinoids and the extent of their agreement or disagreement with statements concerning cannabinoids and medicines in general."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Fifty-two percent of patients were doubtful about taking cannabinoids: unwillingness was strongly associated with specific concerns about side effects, addiction, tolerance, and losing control but not with general beliefs about medication or personal or medical variables other than age."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The concerns of patients with chronic pain about taking cannabinoids as analgesics may reduce their utility and efficacy; accurate information is required to counter this effect."
        }
      ]},
