      "Abstract": {
        "CopyrightInformation": "© 2017 Australian Dental Association.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "This study aimed to adapt a measure of trust in physicians to trust in dentists and to assess the reliability and validity of the measure."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Questionnaire data were collected from a simple random sample of 596 Australian adults. The 11-item General Trust in Physicians Scale was modified to apply to dentists."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The Dentist Trust Scale (DTS) had good internal consistency (α = 0.92) and exploratory factor analysis revealed a single-factor solution. Lower DTS scores were associated with less trust in the dentist last visited, having previously changed dentists due to unhappiness with the care received, currently having dental pain, usual visiting frequency, dental avoidance, and with past experiences of discomfort, gagging, fainting, embarrassment and personal problems with the dentist."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The majority of people appear to exhibit trust in dentists. The DTS shows promising reliability and validity evidence."
          }
        ]
      },
