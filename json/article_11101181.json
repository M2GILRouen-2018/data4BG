      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Nuts are one of the most common foods causing allergic reactions in children and adults although an allergic reaction to macadamia nut has been reported only once previously."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of macadamia nut-induced allergic reaction."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Skin prick test with macadamia nut was performed in a private practice office."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The results demonstrated type-I hypersensitivity reaction with macadamia nut."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Macadamia nut ingestion can cause immediate-type allergic reactions."
        }
      ]},
