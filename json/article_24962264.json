      "Abstract": {
        "CopyrightInformation": "© 2014 John Wiley & Sons A/S. Published by John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To investigate salivary function in patients with primary burning mouth syndrome (BMS) compared with control and to evaluate salivary hypofunction using salivary gland scintigraphy (SGS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A total of 33 patients with primary BMS and 30 control subjects were enrolled in our study. The severity of the pain and the burning sensation on a 10-cm visual analog scale (VAS) and the Oral Health Impact Profile-14 (OHIP-14) were assessed. Unstimulated and stimulated salivary flow rates (SFRs) were measured. (99m) Tc pertechnetate SGS was used to evaluate salivary gland function."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Unstimulated SFR in patients with BMS was significantly lower than that in the control group (0.11 ± 0.15 vs 0.21 ± 0.16 ml min(-1) , P = 0.014). There was no significant difference in stimulated SFR between the two groups. The VAS scores for oral pain and burning sensation, the total OHIP-14 score, and salivary gland function by salivary scintigraphy were not significantly different between BMS patients with normal flow rate and hyposalivation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Patients with primary BMS exhibited a significant decrease in unstimulated SFR compared with control group. In addition, we could not find any difference in salivary gland function between BMS patients with or without hyposalivation."
          }
        ]
      },
