      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To determine if treatment with dextroamphetamine sulfate can reduce pelvic pain that was attributed to adenomyosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Dextroamphetamine sulfate was given to a 32-year-old woman who suffered on a daily basis from severe chronic pelvic pain that was not relieved by laparoscopic removal of endometriosis by oral contraceptive and ibuprofen. The adenomyosis was diagnosed by magnetic resonance imaging."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Within three months the pain was completely gone and has remained absent for six months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Dextroamphetamine sulfate relieved pain from adenomyosis similar to its effect on endometriosis."
        }
      ]},
