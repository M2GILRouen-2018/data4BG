      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Airway inflammation assessed by bronchial biopsies demonstrates distinct eosinophilic and noneosinophilic phenotypes in severe asthma, but their relationship to other biomarkers of disease (induced sputum and nitric oxide [NO]) is not clear."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "We sought to compare airway inflammation using noninvasive (induced sputum, exhaled NO), and invasive (bronchial biopsies) methods in moderate and severe asthma and to assess whether induced sputum and exhaled NO would allow the identification of eosinophilic and noneosinophilic phenotypes in severe asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We performed a cross-sectional study of 32 subjects with severe asthma and 35 subjects with moderate asthma, from whom we obtained bronchial biopsies, induced sputum, and exhaled NO measurements."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Among subjects with severe asthma, we identified eosinophilic and noneosinophilic phenotypes using both bronchial biopsies and sputum cell counts. However, the vast majority of subjects with high sputum eosinophil counts did not have high mucosal eosinophil counts. Exhaled NO was increased in the eosinophilic phenotype as judged from bronchial biopsy findings, but not on the basis of induced sputum. Subjects with high sputum eosinophil counts experienced more asthma exacerbations than the subjects with low sputum eosinophil counts. In contrast, we did not find any differences in the clinical characteristics between eosinophilic and noneosinophilic phenotypes that were identified by bronchial biopsies."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The use of sputum cell counts allowed the identification of a subgroup of subjects with severe asthma who were at risk of more frequent asthma exacerbations."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CLINICAL IMPLICATIONS",
          "content": "Monitoring sputum eosinophil counts in subjects with severe asthma may allow identifying the subjects with the greatest disease activity."
        }
      ]},
