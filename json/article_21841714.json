      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine if solvent-assisted tape removal reduces pain when compared with dry tape removal."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "A double-blinded comparative study was performed, in which commonly used solvents, namely water, alcohol, peanut oil, sunflower oil, and Leukotape remover (BSN medical), were applied to six zinc oxide adhesive tapes (Leukoplast, BSN medical), 10 cm long, 2.5 cm wide that had been placed on the volar side of each forearm of adult volunteers. One tape was left dry. Pain was measured using a visual analogue scale (VAS) and statistically analysed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no statistically significant differences in VAS pain scores between the used substances when compared with the dry tape (p=0.39). The use of oil (peanut and sunflower) caused remains of adhesive to occur significantly more often (p<0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Applying substances to ease pain associated with the removal of adhesive tapes does not lead to a reduction of pain when compared with dry tape."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONFLICT OF INTEREST",
          "content": "None."
        }
      ]},
