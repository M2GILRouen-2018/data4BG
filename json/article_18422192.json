      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the analgesic and sedative effects of various species of Rhizoma Cimicifugae and their processed products with honey."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The three kinds of analgesic experiments of formalin, hot plate and writhing tests, and the number of spontaneous activities and raise forelimbs were adopted in mice."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All samples showed antinociceptive activities in the two phases of formalin, tail immersion and writhing tests and sedative properties in the spontaneous locomotor activity test. The analgesic and sedative effects of processed Rhizoma Cimicifugae were higher than crude drugs."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The present results demonstrate that the antinociceptive and sedative activity of samples processed with honey are more potent than crude drugs."
        }
      ]},
