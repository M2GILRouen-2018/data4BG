      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate adhesion reformation after laparoscopic excision of endometriosis and adhesiolysis in women with chronic pelvic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Thirty-eight women with endometriosis and chronic pelvic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "A primary and second-look laparoscopy with adhesiolysis and excision of endometriotic lesions with a neodymium-yttrium argon garnet surgical laser technologies (SLT) contact laser."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Adhesion formation and character (thin, thin and thick, or thick). Location of adhesions at a first laparoscopy was compared with de novo or reformation of adhesions and the location of adhesions at a second surgery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Adhesions or adhesions combined with endometriotic lesions were significantly more likely to reform at second surgery compared with sites having only an endometriosis lesion. Thick adhesions were associated with a significantly increased likelihood of an adhesion reforming, compared with thin adhesions or thin and thick adhesions. Lesions or adhesions involving the ovary were more likely to be associated with adhesions at a subsequent surgery, compared with lesions in the adjacent ovarian fossa or fallopian tube."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Most patients developed adhesions after radical surgical excision of endometriosis for pelvic pain. The high incidence of adhesion formation after surgery for endometriosis underscores the importance of optimizing surgical techniques to potentially reduce adhesion formation."
        }
      ]},
