      "Abstract": {
        "CopyrightInformation": "Copyright © 2016. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The diagnosis of previous lateral myocardial infarction is based on QRS morphology."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To explore the diagnostic role of T wave abnormalities."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We studied 166 patients with known or suspected ischemic heart disease who underwent a 12-lead electrocardiogram, myocardial perfusion scintigraphy, and coronary arteriography within 90days. We excluded patients with bundle-branch block, hypertrophy, or paced rhythm."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Only one patient had a prominent R wave in V1, no patient showed lateral Q waves of necrosis. T wave amplitude in V2-V6 ≥0.6mV, and T wave amplitude in lead 1+V6 ≤0mV detected a lateral infarction (sensitivity 33 and 44%, specificity 83 and 80%). T wave amplitude in lead 1+V6 ≤0mV was the only independent predictor of infarction or LCx occlusion (AUC 0.72 and 0.74). Serum potassium values were not associated with T wave abnormalities."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "T wave abnormalities identify previous lateral infarction and LCx disease."
          }
        ]
      },
