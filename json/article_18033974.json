      "Abstract": {
        "CopyrightInformation": "(c) 2007 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To review the literature comparing operative techniques in tonsillectomy and postoperative pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Randomized controlled trials comparing operative techniques and pain outcomes over a 10-year period were reviewed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "44 trials met inclusion criteria for analysis. A total of nine different techniques for complete or partial tonsillectomy were compared. There were several studies with contradictory results. Many of the studies were performed under different parameters."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Future studies comparing tonsillectomy technique and pain outcomes should be conducted using a standard protocol to allow for accurate comparisons between numerous techniques."
          }
        ]
      },
