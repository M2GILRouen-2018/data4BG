      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 AAGL. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To evaluate the effect on postoperative pain of intraperitoneal instillation of dilute bupivacaine at the conclusion of laparoscopic hysterectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, randomized, double-blind, placebo-controlled trial (Canadian Task Force classification I)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary care, urban, academic teaching hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Women aged 18 to 65 years undergoing total or supracervical laparoscopic hysterectomy with or without salpingo-oophorectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Randomization to intraperitoneal instillation of bupivacaine vs normal saline solution at the conclusion of laparoscopic hysterectomy performed because of benign indications."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "A total of 160 patients consented to participate in the study and were randomized to receive either intraperitoneal instillation of 100 mg bupivacaine in 100 mL normal saline solution or 100 mL normal saline solution alone, at the conclusion of laparoscopic hysterectomy. Sixty seven of 77 patients (87%) in the treatment group and 73 of 80 patients (91%) in the placebo group completed the study. There were no significant differences in demographic profile, indication for hysterectomy, or number of previous surgeries between the two groups. All patients were prescribed a standardized routine postoperative analgesic regimen. Pain was measured by patient self-report using a 10-cm visual analog scale (VAS) at 1, 2, 4, 6, 12, and 24 hours postoperatively. Mean VAS scores at all time points were between 2.0 and 4.3 and were highest in the first postoperative hour. VAS scores were not significantly different between the two groups at any time point. None of the measured secondary outcomes were significantly different between the bupivacaine and placebo groups, including total postoperative opioid analgesic use in morphine equivalents (23.2 mg vs 27.5 mg; p = .09), length of hospital stay in hours (23.3 vs 23.0; p = .49), patient satisfaction on a 10-cm VAS (9.0 vs 8.2; p = .12), and complication rates (9% vs 15%; p = .35)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Intraperitoneal instillation of bupivacaine at the conclusion of laparoscopic hysterectomy does not reduce postoperative pain. Opioid analgesic use, length of hospital stay, overall patient satisfaction, and complication rates are also unchanged. Self-reported postoperative pain was low in both groups after this major gynecologic surgery performed laparoscopically."
          }
        ]
      },
