      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "This study assessed the safety and efficacy of a new beverage on suppressing hunger and improving feelings of satiety in healthy volunteers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In the safety study, participants (n = 269) received either 1) a control beverage-coffee alone (group C); 2) the study beverage-coffee, whey protein, inulin, and dextrin (group S); or 3) an inulin-enriched beverage (I group). The study was held over a 7-d period during which participants were required to consume 2 cups of coffee a day."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There were no significant differences between the groups in any reported adverse effects, apart from more abdominal pain after the first cup in group I versus S (P < 0.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This study showed that a coffee beverage enriched with inulin, dextrin, and whey is safe and has possible benefits with regard to feelings of hunger and satiety 2 h after ingestion."
          }
        ]
      },
