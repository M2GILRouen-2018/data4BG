      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 AAGL. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To describe the long-term fertility outcomes in young patients with endometriosis-associated pelvic pain treated with laparoscopic surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective case series (Canadian Task Force classification II-2)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary care hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Women aged 18 to 25 years who underwent laparoscopic surgery between 2000 and 2005 at the Cleveland Clinic Foundation solely to treat endometriosis-associated pelvic pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients answered a telephone or mail survey questionnaire assessing fertility outcome after surgery."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MEASUREMENTS AND MAIN RESULTS",
            "content": "Twenty-eight of 74 eligible patients (37.8%) were enrolled in the study. With a median (interquartile range) age of 23.5 (1.5) years at follow-up, these patients completed the telephone or postal questionnaire to assess fertility outcomes at follow-up of 102.5 (16.6) months. In most participants the diagnosis was less advanced endometriosis (stage I, 60.7%; stage II, 28.6%). Twenty women (71.4%) had at least 1 pregnancy during follow-up that resulted in a live birth, of which >80% were spontaneous without the use of assisted reproductive technologies."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Long-term pregnancy rates are excellent in young women undergoing laparoscopic surgery to treat pelvic pain. However, a future prospective study is needed to determine whether laparoscopy has any hindrance on future fertility."
          }
        ]
      },
