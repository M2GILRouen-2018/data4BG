      "Abstract": {
        "CopyrightInformation": "Copyright 2009. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We tested the association between PON1 polymorphism, PON1 activity, oxidative susceptibility of LDL and coronary artery disease in Egyptians."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "PON1 polymorphism, serum PON1 activity, lipoprotein oxidation susceptibility and lipid profile were measured."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Levels of HDL and paraoxonase activity were significantly decreased in CAD patients compared to control group, and in patients with three vessels compared to those of single or two vessels disease. High-activity allele (R) has a more atherogenic lipid profile than for the low activity allele (Q). PON1 RR genotype has nine fold risks to develop CAD in Egyptians while those with PON1 QR genotype have four fold risks."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The PON1 activity is lower in subject with CAD and there is a significant relationship between activity of PON1 and the severity of coronary atherosclerosis. Also, we provide evidence of a significant association between R allele of the PON1 polymorphism and the development of coronary artery disease."
          }
        ]
      },
