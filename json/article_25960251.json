      "Abstract": {
        "CopyrightInformation": "© 2015 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The longitudinal trajectories of body composition of children born to mothers with normal weight, overweight, and obesity have not been evaluated using precise body composition methods. This study investigated the relationship between maternal prepregnancy BMI and offspring body composition trajectories during the first 6 years of life."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Healthy infants (N\u2009=\u2009325) were assessed longitudinally (at ages 0.25, 0.5, 0.75, 1, 2, 3, 4, 5, and 6 years) using dual-energy X-ray absorptiometry. Mixed-effects regression for repeated measures was used to model each continuous outcome as a function of maternal BMI and covariates (race, gestational age, birth weight, and mode of infant feeding)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Maternal obesity differentially impacted body fat, but not bone mineral content or density, of girls and boys. Boys born to mothers with obesity have higher body fat from ages 2-6 years compared to boys born to normal-weight and overweight mothers (P\u2009<\u20090.05), whereas body composition of girls born to mothers with obesity was not different across groups during the first 6 years of life (P\u2009>\u20090.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This clinical observational study demonstrates a sexual dimorphism in offspring body composition until age 6 years based on maternal BMI, with a greater effect of maternal adiposity seen in boys than in girls."
          }
        ]
      },
