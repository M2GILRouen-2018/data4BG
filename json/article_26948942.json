      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 American Society for Bariatric Surgery. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Osteogenesis imperfecta (OI) is an inherited disorder, which causes brittle bones resulting in recurrent fractures. The associated poor mobility of children with OI increases susceptibility to obesity, and obesity further dramatically limits mobility and increases fracture risk."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim of this report is to describe outcomes of weight loss surgery (WLS) in 2 adolescents with severe obesity and OI."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Two University Hospitals (in the United Kingdom and in the United States)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Two cases of OI treated with WLS were identified. Pre- and postoperative anthropometric and biochemical data and clinical course were reviewed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In these 2 cases, preoperative Body Mass Index (BMI) values were 38 and 46 kg/m(2). Following laparoscopic sleeve gastrectomy (LSG), BMI decreased by 55% and 60% by 26 and 24 months, respectively. There were no surgical complications, and both patients experienced improvement in their mobility and ability to perform activities of daily living."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "WLS effectively treated severe obesity in 2 OI patients and substantially improved mobility and quality of life, theoretically reducing fracture risk."
          }
        ]
      },
