      "Abstract": {
        "CopyrightInformation": "© 2012 International Society for Sexual Medicine.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Vulvar lichen sclerosus (LS) is a chronic inflammatory and mutilating disease, which goes often undetected for years. Advanced disease severely affects quality of life like sexual disorders and is also associated with an increased risk of vulvar cancer."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To develop and validate a patient-administered symptom score and a physician-administered clinical score for the diagnosis and evaluation of vulvar LS."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We included 24 patients with established LS diagnosis and 49 with other vulvar disease. The physician-administered score was based on six clinical features and the patient-administered score was a symptom-based four-item composite score. We determined inter-item correlations and internal consistency of both scores, and estimated sensitivities, specificities, likelihood ratios, and posttest probabilities for different cutoffs of the physician-administered score."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Characteristics of patients with and without LS were compared using χ(2) and unpaired t-test as required. We then determined Cronbach's alpha as a measure of the overall consistency of scores and calculated positive and negative likelihoods."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Lack of redundancy of items (correlation coefficients < 0.90) and internal consistency (Cronbach's α ≥ 0.70) suggested that final composite scores were valid and yielded excellent power to rule in LS."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Scores may be useful for assessing symptoms of vulvar disorders, to ease diagnosis of LS and to evaluate treatment response over time."
          }
        ]
      },
