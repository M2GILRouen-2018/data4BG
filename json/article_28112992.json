      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To benchmark Dutch pharmacists knowledge, experience and attitudes toward pharmacogenetics (PGx) with a specific focus on the effects of awareness of the Dutch Pharmacogenetics Working Group guidelines."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A web-based survey containing 41 questions was sent to all certified Dutch pharmacists."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 667 pharmacists completed the survey (18.8%). Virtually all responders believed in the concept of PGx (99.7%). However, only 14.7% recently ordered a PGx test (≤6 months), 14.1% felt adequately informed and 88.8% would like to receive additional training on PGx. Being aware of the Dutch Pharmacogenetics Working Group guidelines did not have any significant effect on knowledge or adoption of PGx."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Dutch pharmacists are very positive toward PGx. However, test adoption is low and additional training is warranted."
        }
      ]},
