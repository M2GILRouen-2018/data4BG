      "Abstract": {
        "CopyrightInformation": "© 2011 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Spinal cord stimulation (SCS) has been widely noted as a treatment for ischemic pain secondary to peripheral vascular disease, but evidence in the vasculitis disease state is lacking. In this paper we present two cases that exemplify the potential of SCS in this unique population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "Two case studies involving patients with the conditions noted including initial findings, treatment protocol, and results documented throughout the treatment regimen. A comprehensive review of the critical literature also was performed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Both patients showed marked improvement with SCS. Pain scores improved dramatically, with a major improvement in disease symptom and quality of life."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Based on literature and our results, SCS is an effective and safe therapy for patients with therapeutically refractory vasculitis."
          }
        ]
      },
