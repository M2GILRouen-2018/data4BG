      "Abstract": {
        "CopyrightInformation": "Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Foramen magnum meningiomas are very rare and challenging lesions. Their presentation in women during pregnancy tremendously complicates the course of gestation. Conservative management is always the first option, but in cases of a deteriorating clinical picture, there are currently no clear guidelines on best management."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE DESCRIPTION",
            "content": "A woman presents in the 30th week of pregnancy with pain and progressive numbness in right posterior aspect of neck and right arm. Foramen magnum meningioma was diagnosed and successful surgical resection was performed with intraoperative fetal hearth monitoring and three fourths prone position of the patient."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "We believe a three fourths prone position of a pregnant patient is safe and adequate for the far-lateral exposure of craniocervical lesions. Rapid growing of tumor can be precipitated by steroids management during pregnancy."
          }
        ]
      },
