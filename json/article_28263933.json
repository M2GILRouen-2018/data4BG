      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine operative findings and outcome of microvascular decompression (MVD) for glossopharyngeal neuralgia (GPN). This research displayed the long-term outcomes of a large series of 35 cases with GPN treated with MVD."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "From January 2004 to June 2006, 35 consecutive patients were diagnosed with GPN. All of them underwent MVD. Demographic data, clinical presentation, operative findings, clinical results, operative complications were reviewed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 33 patients (94.3%) experienced complete pain relief immediately after MVD. Long-term follow-up was available for 30 of these 35 patients, and 28 of these 30 patients continued to be pain-free. There was no long-term operative morbidity in all cases. One patient had a cerebrospinal fluid leak and 1 case presented with delayed facial palsy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Classic GPN is usually caused by pulsatile neurovascular compression of the glossopharyngeal and vagus rootlets. MVD is a safe, effective, and durable operation for GPN."
          }
        ]
      },
