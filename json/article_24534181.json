      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Interindividual differences in response to weight loss and maintenance thereafter are ascribed to genetic predisposition and behavioral changes."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine whether body weight and short and long-term body weight loss were affected by candidate single nucleotide polymorphisms (SNPs) and changes in eating behavior or by an interaction between these genetic and behavioral factors."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "150 healthy subjects (39 males, 111 females) aged 20-50 y with a BMI of 27-38 kg/m(2) followed a very low energy diet for 8-weeks, followed by a 3-month weight maintenance period. SNPs were selected from six candidate genes: ADRB2, FTO, MC4R, PPARG, PPARD, and PPARGC1A. Changes in eating behavior were determined with the Three Factor Eating Questionnaire."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A high genetic predisposition score was associated with a high body weight at baseline and more short-term weight loss. From the six selected obesity-related SNPs, FTO was associated with increased body weight at baseline, and the effect allele of PPARGC1A was positively associated with short-term weight loss, when assessed for each SNP separately. Long-term weight loss was associated with a larger increase in dietary restraint and larger decrease in disinhibition."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "During long-term weight loss, genetic effects are dominated by changes in eating behavior."
          }
        ]
      },
