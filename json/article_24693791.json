      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To summarize the research progress of the difference between high-flexion prosthesis and conventional prosthesis in total knee arthroplasty, so as to offer a reference for clinical choice of prosthesis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The relevant literature on high-flexion prosthesis and conventional prosthesis in recent years was extensively reviewed and analyzed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There are some controversies in range of motion and complications between high-flexion prosthesis and conventional prosthesis; while no obvious difference is found in knee function and satisfaction."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Comprehensive evaluation should be considered when high-flexion prosthesis is selected; and the effectiveness needs further follow-up."
        }
      ]},
