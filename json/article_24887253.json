      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS AND OBJECTIVES",
          "content": "The aim was to identify any relationship between obesity and peripheral arterial disease (PAD) in diabetic subjects."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS AND METHODS",
          "content": "Male and female diabetic subjects aged 50-89 years. Body mass index (BMI) was used to estimate total body weight and the waist-to- hip ratio (WHR) as well as waist circumference (WC) were used for abdominal fat distribution estimation. Peripheral arterial disease was defined by an ankle brachial index <0.9."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Peripheral arterial disease (PAD) was observed in 52.5% of the subjects. BMI, WHR and WC did not correlate with PAD."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "None of the parameters (i.e BMI, WHR and WC) used to assess the relationship between obesity and PAD was found to correlate with PAD."
        }
      ]},
