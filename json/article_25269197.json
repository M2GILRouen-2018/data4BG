      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Comparative analysis of effects of hypothiazide and verospiron on platelet aggregation in patients with arterial hypertension and abdominal obesity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Hypothiazide and verospiron were prescribed to 28 and 23 patients respectively for 16 weeks. The parameters estimated included dynamics of blood lipid profile, lipid peroxidation in plasma and platelets, antioxidant protection of the blood liquid fraction and platelets, platelet aggregation. The results were treated with the use of Student's t-test."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Verospiron had positive influence on peroxidation syndrome and platelet aggregation. Its prolonged application maintained the achieved effect. Hypothiazide did not change the parameters of interest."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Combined verospiron and non-medicamental therapy is recommended to reduce body mass in patients with arterial hypertension and abdominal obesity."
        }
      ]},
