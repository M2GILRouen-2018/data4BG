      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© 2015 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Identify a gene expression signature in white adipose tissue (WAT) that reports on WAT browning and is associated with a healthy phenotype."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "RNA from several different adipose depots across three species were analyzed by whole transcriptome profiling, including 1) mouse subcutaneous white fat, brown fat, and white fat after in vivo treatment with FGF21; 2) human subcutaneous and omental fat from insulin-sensitive and insulin-resistant patients; and 3) rhesus monkey subcutaneous fat from healthy and dysmetabolic individuals."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A \"browning\" signature in mice was identified by cross-referencing the FGF21-induced signature in WAT with the brown adipose tissue (BAT) vs. WAT comparison. In addition, gene expression levels in WAT from insulin-sensitive/healthy vs. insulin-resistant/dysmetabolic humans and rhesus monkeys, respectively, correlated with the gene expression levels in mouse BAT vs. WAT. A subset of 49 genes were identified that were consistently regulated or differentially expressed in the mouse and human data sets that could be used to monitor browning of WAT across species."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Gene expression profiles of WATs from healthy insulin-sensitive individuals correlate with those of BAT and FGF21-induced browning of WAT."
          }
        ]
      },
