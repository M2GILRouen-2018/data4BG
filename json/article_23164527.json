      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier HS Journals, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The integration of genome-based knowledge into public health or public health genomics (PHG) aims to contribute to disease prevention, health promotion, and risk reduction associated with genetic disease susceptibility. Men and women differ, for instance, in susceptibilities for heart disease, obesity, or depression due to biologic (sex) and sociocultural (gender) factors and their interaction. Genome-based knowledge is rapidly increasing, but sex and gender issues are often not explored."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To explore the implications of a sex and gender analysis for PHG."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We explore genome-based knowledge in relation to sex and gender aspects using depression as an example, gender equality, and the intersection of sex and gender with other social stratifiers such as ethnic background or socioeconomic status."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We advocate a sex- and gender-sensitive genomics research agenda alongside studies that provide sex-disaggregated data rather than controls based on sex. Such a research agenda is needed to guide research on how genomics is understood and perceived by men and women across groups, and for the equitable and responsible translation of such knowledge into the public health domain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Including sex and gender analysis in PHG research will not only shed more light on phenomena such as diseases with a higher prevalence in either men or women, but will ultimately lead to gendered innovations by way of exploring how gendered and cultural environments increase or safeguard genetic predispositions."
          }
        ]
      },
