      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 The Authors. Published by Elsevier Ltd.. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Hematogenous spread of bacteria from the bowel due to bacterial translocation has been postulated in animal and trauma studies. This case presents a patient with possible hematogenous bacterial spreading after acute laparotomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE PRESENTATION",
            "content": "A 57-year old woman was admitted with abdominal pain. A computed tomography showed mechanical small bowel obstruction. A laparotomy was performed showing no contamination, and no bowel resection was performed. The patient was not given any antibiotics during this time. The patient was re-admitted 24h after discharge with fever, elevated white count and abdominal pain. A computed tomography showed newly developed intrahepatic abscesses. These were treated with antibiotics, and the patient was discharged with follow-up ultrasound showing diminished abscesses."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "This case discusses the possible pathophysiology behind the development of intrahepatic abscesses after small bowel obstruction."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Febrilia and pain in upper right quadrant of the abdomen days after a simple operation for bowel obstruction could be caused by translocation of intestinal bacteria and subsequent formation of hepatic abscesses."
          }
        ]
      },
