      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine the effect of using the diagnosis of metabolic syndrome (MetSx) on risk perception."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We randomized 74 participants to receive either the diagnosis of MetSx or the diagnosis of individual cardiovascular risk factors. The MetSx group was subdivided into those receiving written patient education material or written patient education plus educational videos."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At 6 weeks, participants receiving the diagnosis of MetSx were more likely to increase their health concerns, perceived risk of myocardial infarction, and their motivation toward health behavior."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Sharing the diagnosis of MetSx increases risk perception and motivation toward a healthier behavior."
        }
      ]},
