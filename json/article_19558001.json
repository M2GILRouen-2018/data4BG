      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe the current knowledge of the T-cell epitopes of common aeroallergens, how they were discovered, and implications for future therapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "PubMed search of English-language articles without date limits pertaining to T-cell epitopes of aeroallergens included on a standard skin test panel."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY SELECTION",
          "content": "A total of 127 articles were screened based on the results of the PubMed search and cross-indexed as needed. The highest quality and most clinically relevant articles were included for discussion."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of the 47 allergen extracts included on the standard skin test panel at our instittition, T-cell epitopes have been described for 13. Immunodominant epitopes have been used for peptide immunotherapy trials."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "T-cell epitopes have been characterized for a minority of common aeroallergens. However, knowledge is rapidly expanding and can lay the groundwork for therapies that specifically target T cells."
        }
      ]},
