      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The association between non-nutritive sweeteners and obesity is controversial."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To determine whether the consumption of non-nutritive sweeteners is related to higher risk for overweight or obesity among university students in Chile, Panama, Guatemala and Peru."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "A total of 1,224 (472 from Chile, 300 from Panama, 248 from Guatemala and 204 from Peru) male and female university students aged between 18 and 26 years participated in the study. Each student reported their food intake (frequency of weekly consumption) in a survey that contained photos of foods containing non-nutritive sweeteners adapted for each country. Anthropometry was also measured."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "More than 80% of students consumed at least one product containing non-nutritive sweeteners. Females who ate acesulfame potassium and sucralose had a lower risk of overweight or obesity with an odds ratio (OR) of 0.5 (confidence intervals (CI) = 0.3-0.9; p = 0.003) and OR = 0.4 (IC = 0.2-0.8; p = 0.01), respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In this sample of Latinamerican university students, consumption of non-nutritive sweeteners was associated with lower risk of overweight only in females."
        }
      ]},
