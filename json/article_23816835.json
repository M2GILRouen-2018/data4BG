      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Crohn's disease (CD) is frequently associated with weight loss and malnutrition. However, as the prevalence of obesity increases worldwide, it may become a clinical problem even in CD."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To assess the prevalence of severe/morbid obesity in CD patients and to compare their disease characteristics to nonobese CD patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A retrospective analysis of a computerized CD patient database was performed to identify severely/morbidly obese patients (BMI >35). Prevalence was compared to data of the general population. Severely/morbidly obese CD patients were then compared to randomly selected nonobese CD patients (BMI <30) in a 1:3 ratio."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Thirteen severely/morbidly obese patients out of 560 CD patients were found (2.3%), which is significantly lower than the prevalence in the general population (5.6%, p = 0.001). When compared to 39 nonobese CD patients, colonic disease was significantly more common among severely/morbidly obese CD patients (odds ratio: 6, 95% CI: 1.35-26.3, p = 0.02), while there was no difference in other disease parameters. Interestingly, 4 morbidly obese CD patients had undergone laparoscopic sleeve gastrectomy for treatment of morbid obesity with a favorable surgical course."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "CD in severely/morbidly obese patients is more often colonic, but otherwise no different than CD in nonobese patients. Sleeve gastrectomy is a viable therapeutic option for morbidly obese CD patients."
          }
        ]
      },
