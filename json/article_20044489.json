      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The aim of the present study was to describe the clinical outcomes and activity levels of young patients after distal humeral hemiarthroplasty (DHH)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Six patients under 55 years (mean 44 years; range 29 years to 52 years) treated with DHH at a mean postoperative time of 81 months (range 24 months to 133 months) were studied retrospectively. Two other patients had been revised for aseptic loosening and were excluded."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The mean Mayo Elbow Score (MEPS) (88), Subjective Elbow Value (SEV) (89), Quick Disabilities of the Arm, Shoulder and Hand (QuickDASH) (12) and American Shoulder and Elbow Surgeons (ASES) elbow pain (6), function (23) and satisfaction scores (9) were satisfactory. The mean University of California, Los Angeles (UCLA) activity score was 7.2."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Although only rarely indicated, DHH has satisfactory clinical outcomes in young patients and allows a higher level of function than is generally advised after total elbow arthroplasty."
        }
      ]},
