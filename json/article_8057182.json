      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare definitions of comfort held by a group of postpartum substance users with those of a group of nonusers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The postpartum unit of a large university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "The convenience sample constituted 36 postpartum women; half were substance users and half denied substance use. The nonusing participants were matched to the users according to age, race, type of delivery, and parity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Qualitative, descriptive."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Data were collected through semistructured, individual interviews. Patients defined comfort and described the characteristics and patterns of comfort during the postpartum period."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Data were analyzed into three categories of themes. Attributes of comfort were resolution of pain, resolution of fatigue, satiation of hunger, resolution of individual irritants, and relaxation. Interventions for comfort were standard therapy, supportive presence, and caring nursing approach. Modifiers of comfort were individualized comfort patterns, environmental ease, and maternal concern."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Comfort is more than the absence of pain. A supportive presence and a caring nursing approach were the most helpful interventions."
        }
      ]},
