      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To systematically review the literature to identify the impact of polycystic ovary syndrome (PCOS) on specific health-related quality of life domains."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Meta-analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "N/A."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "The outcomes of 423 patients and 285 controls from 5 articles that used the Short Form 36 (SF-36) questionnaire were used for meta-analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "N/A."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "The SF-36 dimensions including physical function, physical role function, body pain, general health, vitality, social function, emotional role function, and mental health were evaluated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Compared with controls, women with PCOS had lower scores in all SF-36 dimensions: physical function (mean differences [MD], -5.46; 95% confidence intervals [CI], -8.52, -2.41), physical role function (MD, -5.76; 95% CI, -8.49, -3.03), body pain (MD, -4.55; 95% CI, -7.99, -1.11), general health (MD, -11.34; 95% CI, -19.53, -3.15), vitality (MD, -15.14; 95% CI, -17.43, -12.84), social function (MD, -15.95, 95% CI, -18.57, -13.33), emotional role function (MD, -23.86; 95% CI, -27.51, -20.21), and mental health (MD, -13.83; 95% CI, -16.13, -11.53)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "The meta-analysis showed that women with PCOS score lower in each dimension of the SF-36, mostly in the emotional role function."
          }
        ]
      },
