      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess anticipated and perceived pain associated with transabdominal chorionic villus sampling (TA CVS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Sixteen consecutive patients completed 0 (no pain) to 10 (excruciating pain) visual analog scales before and after TA CVS."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Anticipated pain (5.1 +/- 2.9) and perceived pain (5.5 +/- 3.2) were similar (p = 0.42) and moderate. Actual pain was less in five (31%), the same in six (38%), and greater in five (31%) compared to anticipated pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These baseline data are useful for patient counseling and designing interventional trials to decrease procedural pain. TA CVS is associated with moderate perceived pain."
        }
      ]},
