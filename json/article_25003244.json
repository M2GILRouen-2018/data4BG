      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "The activation of peripheral immune cells and the infiltration of immune cells into adipose tissue in obesity are implicated in the development of type 2 diabetes mellitus."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of the study was to compare peripheral immune cells from obese and normal-weight women with regard to composition of immune cell subpopulations, surface expression of the chemokine receptors (CCRs) CCR2, CCR3, CCR5, and CXCR3 (chemokine (C-X-C motif) receptor 3) and cell-intrinsic migration capacity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "This was a case-control study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The study was conducted at a university clinical study center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Obese females and normal-weight females were included for fluorescence-activated cell sorting analysis and migration assays."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Peripheral blood mononuclear cells were prepared from fasting blood samples and used for fluorescence-activated cell sorting analysis and migration assays."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "An increase in the percentages of CD14(+)CD16(+) monocytes was observed in obese subjects compared with controls. The CCR profile of monocytes differed significantly in the obese state; in particular, CCR2 levels were increased. In addition, a higher chemotactic activity of monocytes from obese subjects was observed in a migration assay, which was associated with both insulin resistance and CCR2 expression."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Our results suggest that the enhanced intrinsic migratory capacity of peripheral monocytes in obese women may be due to the increased CCR expression, further supporting a link between peripheral immune cell dysfunction and obesity."
        }
      ]},
