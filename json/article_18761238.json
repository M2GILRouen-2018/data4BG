      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To compare the efficacy of remifentanil-propofol with that of fentanyl-propofol for monitored anesthesia care during hysteroscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomized study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Operating room and postanesthesia care unit of a university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "30 ASA physical status I and II adult patients undergoing hysteroscopic procedures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "After propofol infusion, patients received a bolus of remifentanil (group R, 0.5 microg/kg) or fentanyl (group F, 1 microg/kg) 4 minutes before starting the procedure and then received a continuous infusion of remifentanil (group R, 0.05 microg/kg per min) or bolus doses of fentanyl (group F, 0.5 microg/kg)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Patients in group R had lower pain scores than patients in group F (0-0 vs 0-7, P < 0.05) and more stable blood pressures (74 +/- 15 vs 85 +/- 9 mmHg, P < 0.05) one minute after the start of the procedure. However, no differences were observed in other variables (recovery profiles and satisfaction scores)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Remifentanil seems to be a safe and effective analgesic adjunct for monitored anesthesia care of hysteroscopic surgery."
        }
      ]},
