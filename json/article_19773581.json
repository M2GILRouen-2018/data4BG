      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Coronary artery disease (CAD) is a major cause of death in industrial countries, leading to high health-related costs and decreased quality of life."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To develop and validate a decision-analytic model for CAD risk screening in Germany (German Coronary Artery Disease Screening Model)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Markov model."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "TARGET POPULATION",
          "content": "Age- and gender-specific cohorts of the German population."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Mortality rates posted by the German Federal Statistical Office, the German Health Survey, social health insurance institutions, the MONICA Augsburg study, and the literature."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "TIME HORIZON",
          "content": "Lifetime."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "CAD risk screening for high-risk individuals using Framingham risk equation and use of statins as the primary preventive measure, compared with a setting without screening."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Life-years (LY) gained, quality-adjusted life-years (QALYs) gained."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The model-based CAD incidence corresponds well with empirical data from the MONICA Augsburg study. Health outcomes depend on the screening threshold (cutoff value of Framingham 10-year risk) and on the age and gender of the cohort screened (0.03 to 0.26 LYs and 0.06 to 0.42 QALYs gained per person screened in cohorts of 50- and 60-year-old men and women, respectively)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The model provides a valid tool for evaluating the long-term effectiveness of CAD risk screening in Germany. Using statins as a primary prevention intervention for CAD in high-risk individuals identified by screening could improve the long-term health of the German population."
        }
      ]},
