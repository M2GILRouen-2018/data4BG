      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "This study describes recent United States trends and regional variations in the management of low back pain."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The authors investigated recent temporal trends and compared practices in different geographic regions."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Controversy exists concerning the appropriate medical and surgical management of patients with low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "National Hospital Discharge Survey data from 1979 through 1990 were analyzed. Case selection was based on previously developed algorithms intended to exclude nonmechanical causes of back pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Over the period of study, nonsurgical hospitalizations for low back pain decreased dramatically. In contrast, low back operation rates, particularly for fusion surgery, increased substantially. In recent years, surgery and hospitalization rates were highest in the South and lowest in the West."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Rapidly increasing surgical rates and wide geographic variations suggest the need for a more consistent approach to back problems."
        }
      ]},
