      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study explores self-reported perception of asthma symptoms in African-Americans."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Qualitative methodology was used to analyze the responses from African-Americans within focus groups from Nashville, Tennessee."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Common symptoms were chest tightness, \"breathing problems,\" and wheeze. Less commonly reported symptoms included cough, chest pain, dizziness, sweating, and \"short of breath.\" A single participant reported nocturnal wheezing."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This study provides insight into the descriptors and perception of asthma symptoms in African-Americans. Understanding the descriptors of symptoms and disease severity in African-American patients may lead to more accurate diagnosis, treatment, and reduced mortality within this high-risk population."
        }
      ]},
