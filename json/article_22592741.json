      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Antiepileptic drugs have been used in pain management since the 1960s; some have shown efficacy in treating different neuropathic pain conditions. Phenytoin is an established antiepileptic drug that has been used occasionally to treat intractable trigeminal neuralgia."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To assess the analgesic efficacy and adverse effects of the antiepileptic drug phenytoin in neuropathic pain and fibromyalgia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SEARCH METHODS",
          "content": "We searched the Cochrane Central Register of Controlled Trials (CENTRAL) (The Cochrane Library 2012, Issue 2), MEDLINE, and EMBASE to 28 February 2012, together with reference lists of retrieved papers and reviews, and ClinicalTrials.gov."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SELECTION CRITERIA",
          "content": "We planned to include randomised, double-blind studies of eight weeks duration or longer, comparing phenytoin with placebo or another active treatment in chronic neuropathic pain or fibromyalgia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA COLLECTION AND ANALYSIS",
          "content": "Two review authors would independently extract data for efficacy and adverse events, and examine issues of study quality."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MAIN RESULTS",
          "content": "We did not identify any studies that satisfied the inclusion criteria."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "AUTHORS' CONCLUSIONS",
          "content": "This review uncovered no evidence of sufficient quality to support the use of phenytoin in chronic neuropathic pain or fibromyalgia."
        }
      ]},
