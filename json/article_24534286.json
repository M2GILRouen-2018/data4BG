      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To study the association between endocrine disturbances and metabolic complications in women seeking gynecologic care."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective study, cluster analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Outpatient clinic, university medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "573 women, including 384 at low risk and 189 at high risk of cardiometabolic disease."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "None."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Cardiovascular and metabolic parameters and clinical and biochemical characteristics."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Risk factors for metabolic disease are associated with a low age of menarche, high levels of high-sensitivity C-reactive protein and liver enzymes, and low levels of sex hormone-binding globulin. Overweight/obese status, polycystic ovary syndrome, oligo/amenorrhea, and hyperandrogenism were found to increase the risk of cardiometabolic disease. However, hyperprolactinemia and premature ovarian failure were not associated with the risk of cardiometabolic disease. In terms of androgens, the serum total testosterone level and free androgen index but not androstenedione or dehydroepiandrosterone sulfate (DHEAS) were associated with cardiometabolic risk."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Although polycystic ovary syndrome is associated with metabolic risk, obesity was the major determinant of cardiometabolic disturbances in reproductive-aged women. Hyperprolactinemia and premature ovarian failure were not associated with the risk of cardiovascular and metabolic diseases."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CLINICAL TRIAL REGISTRATION NUMBER",
            "content": "NCT01826357."
          }
        ]
      },
