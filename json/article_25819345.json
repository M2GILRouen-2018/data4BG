      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 North American Society for Pediatric and Adolescent Gynecology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Bilateral ovarian Burkitt's lymphoma was diagnosed in a 10-year-old girl who presented with abdominal pain, constipation, and signs of ovarian torsion."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE",
            "content": "Left salpingo-oopherectomy and biopsy of the right ovary were carried out as initial surgical intervention. She remained well in first complete remission at 25 months after multiagent chemotherapy, with pubertal development on clinical examination, hormonal measurements, and pelvic sonography."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "SUMMARY AND CONCLUSION",
            "content": "Although rare, Burkitt's lymphoma should be included in the differential diagnosis of bilateral ovarian tumors in childhood, and more conservative surgical management is indicated to preserve ovarian function and fertility."
          }
        ]
      },
