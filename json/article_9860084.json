      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Examine correlates of asthma self-management among 12,154 adolescents with physician-diagnosed asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "All 7th and 8th grade students in North Carolina completed a survey to assess asthma prevalence and self-management behaviors among those with asthma."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Adolescents who were allowed to carry their inhaled medication at school, shown how to use a peak flow meter, and had access to more asthma care resources were more confident that they could prevent an asthma exacerbation. Adolescents who were allowed to carry their inhaled medication at school and who had a private doctor were more confident that they could control their symptoms. Adolescents taking anti-inflammatory medicine were less confident that they could prevent an exacerbation and control their symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Various indicators of autonomy and control were associated with greater self-efficacy for managing asthma. Adolescents who require anti-inflammatory medicines would benefit from additional intervention efforts to improve their asthma management self-efficacy."
        }
      ]},
