      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "To determine the biologic variability of N-terminal pro-brain natriuretic peptide (NTproBNP) in healthy dogs and dogs with various stages of myxomatous mitral valve disease (MMVD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANIMALS",
            "content": "Thirty-eight privately owned dogs: 28 with MMVD and 10 healthy controls."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "Prospective clinical study with comprehensive evaluation used to group dogs as healthy or into three stages of MMVD based on current guidelines. NTproBNP was measured hourly, daily, and weekly. For each group, analytical (CVA), within-subject (CVI), and between-subject (CVG) coefficients of variability were calculated in addition to percent critical change value (CCV) and index of individuality (IoI)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "For healthy dogs, calculated NTproBNP values were: CVA = 4.2%; CVI = 25.2%; CVG = 49.3%; IoI = 0.52, and CCV = 70.8%. For dogs with MMVD, calculated NTproBNP values were: CVA = 6.2%; CVI = 20.0%; CVG = 61.3%; IoI = 0.34, and CCV = 58.2%."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Biologic variability affects NTproBNP concentrations in healthy dogs and dogs with MMVD. Monitoring serial individual changes in NTproBNP may be clinically relevant in addition to using population-based reference ranges to determine changes in disease status."
          }
        ]
      },
