      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Raman spectroscopy has the unique potential to detect and quantify cholesterol and calcification in an atherosclerotic plaque in vivo."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the sensitivity and specificity of this technique for detecting cholesterol or calcification in human coronary artery and aorta specimens ex vivo, using a compact clinical fibreoptic based Raman system developed for in vivo applications."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "From nine coronary arteries and four aorta specimens, 114 sites were evaluated for the presence of cholesterol and calcification by Raman spectroscopy and standard histology. Raman spectra were acquired and evaluated on-line in around five seconds."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The correlation between Raman spectroscopy and histology was r = 0.68 for cholesterol and r = 0.71 calcification in the plaque (p < 0.0001). Sensitivity and specificity for detecting cholesterol and calcification were excellent: receiver operating characteristic (ROC) analysis for each of the components revealed areas under the curves of > 0.92 (p < 0.0001). At the optimal cut-off values determined by ROC analysis, positive predictive values of > 80% and negative predictive values of > 90% were obtained."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "On-line real time catheter based Raman spectroscopy detects accumulation of cholesterol and calcification in atherosclerotic plaque with high sensitivity and specificity."
        }
      ]},
