      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The authors report a case of extremely aggressive endometriosis involving a 32-year-old woman."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Different types of medication were used and various surgical procedures applied in order to reduce the clinical signs and symptoms. Among the surgical procedures employed was presacral neurectomy when endometriosis was identified in the presacral nerve."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Receptor determination in the surgical piece was negative."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The etiopathogenic and therapeutic aspects of this process are discussed."
        }
      ]},
