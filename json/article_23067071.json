      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the impact of obesity in the safety of laparoscopic hysterectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A retrospective study was conducted using a database of 2271 women undergoing laparoscopic hysterectomy for benign diseases between January 1995 and December 2008 at the Centre Hospitalier Universitaire Estaing (Clermont-Ferrand, France). Patients were divided into two groups according to the body mass index: <30 kg/m(2) (n=2088) and ≥ 30 kg/m(2) (n=183). Primary outcomes were differences in conversion rates, operating time, estimated blood loss, intraoperative complications, and early postoperative complications."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was no difference in the operative time (121.3 versus 122.5 minutes; P=.71), in the difference between pre- and postoperative hemoglobin levels (1.8 versus 1.6 g/dL; P=.28), and in the conversion rate (4.6% versus 5.5%; P=.62) comparing the two groups. The overall intraoperative complication rate was 14.03% (n=293) and 13.66% (n=25) for nonobese and obese patients (P=.89), respectively. The overall postoperative complication rate was 8.81% (n=184) and 7.65% (n=14), respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Obesity does not have an adverse effect on the feasibility and safety of laparoscopic hysterectomy in experienced hands."
        }
      ]},
