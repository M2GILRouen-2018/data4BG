      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The objective of this study was to explore the relation between the application of a mixture of lidocaine/prilocaine cream (eutectic mixture of local anesthetics [EMLA]) before intravenous cannula insertion and perceived pain in the pediatric patient."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Double-blind placebo-controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A general inpatient pediatric ward."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "We examined 26 male and 31 female patients between the ages of 4 and 12 years who required intravenous cannula insertion. Intravenous insertion was performed on 57 patients, with 29 patients in the placebo group (mean age, 8.1 years) and 28 in the EMLA group (mean age, 8.0 years)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Application of either EMLA cream or placebo 45 minutes before intravenous cannulation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Pain was scored by the patients using a 0- to 10-cm visual analogue scale combined with a Faces pain scale as well as visual observation by a nurse. Adverse side effects were recorded in a separate table."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Data collected and the differences between the placebo and treated groups were tested using a Mann-Whitney U test. Those children in the EMLA group (mean pain score, 1.25) experienced less pain than those in the placebo group (mean, 8.39). There was no statistical significance between age, sex, and race."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The authors conclude that a topical preparation of lidocaine/prilocaine significantly reduces children's pain during intravenous cannula insertion when applied to an intact dermal layer of the skin and that this effect occurs within 45 minutes."
        }
      ]},
