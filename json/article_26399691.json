      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Develop vignettes depicting different pain types in verbal and nonverbal children with cognitive impairments that could help examine pain assessment and management decisions of secondary caregivers, and conduct initial convergent and divergent validity analyses."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "For six vignettes, 76 undergraduate students (38 females, mean age = 19.55) rated (0-10): pain intensity, difficulty rating pain intensity, need for medical attention and need for other attention (e.g., physical comfort)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Ratings significantly varied by pain source (e.g., headache was rated more painful than injections). Verbal ability did not impact ratings."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Vignettes could serve as an alternative method to study pain decisions by caregivers of children with cognitive impairments when ethical barriers limit more naturalistic research."
        }
      ]},
