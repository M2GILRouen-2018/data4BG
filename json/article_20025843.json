      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To describe the characteristics and the management of migraine."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Data on headaches, drug consumption and life habits of 762 patients were collected using questionnaires and pharmacy records."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The migraine attack was characterized by a severe pain for more than 80% of the patients. The frequency was more than 2 attacks a week in 16% of the cases. Eighty four per cent of the patients had triptans and 45% had a long-term migraine treatment. Nonspecific analgesics were prescribed for 55%. The frequency of over-consumption of treatments of migraine attacks was 46%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The management of migraine still remains inadequate. The pharmacist could contribute to its improvement."
        }
      ]},
