      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To describe the course of acute low back pain and sciatica and to identify clinically important prognostic factors for these conditions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Systematic review."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Searches of Medline, Embase, Cinahl, and Science Citation Index and iterative searches of bibliographies."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Pain, disability, and return to work."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "15 studies of variable methodological quality were included. Rapid improvements in pain (mean reduction 58% of initial scores), disability (58%), and return to work (82% of those initially off work) occurred in one month. Further improvement was apparent until about three months. Thereafter levels for pain, disability, and return to work remained almost constant. 73% of patients had at least one recurrence within 12 months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "People with acute low back pain and associated disability usually improve rapidly within weeks. None the less, pain and disability are typically ongoing, and recurrences are common."
        }
      ]},
