      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "There are currently limited lipidomics data for human umbilical cord blood. Therefore, the lipidomes of cord sera from six newborns and sera from six nonpregnant females were compared."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS & METHODS",
          "content": "Sera lipidomics analyses were conducted using a high-resolution mass spectrometry analytical platform."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Cord serum contained a diverse array of glycerophospholipids, albeit generally at lower concentrations than monitored in adult serum. The unexpected observations were that cord serum contained several neurosteroid sulfates and bile acid sulfates that were not detectable in adult serum."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Our data are the first to demonstrate that cord serum contains bile acid sulfates that are synthesized early in the hydroxylase, neutral and acidic pathways of primary bile acid biosynthesis and support previous publications of cord blood perfluoralkyl toxins in newborns."
        }
      ]},
