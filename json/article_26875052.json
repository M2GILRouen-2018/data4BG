      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 The Authors. Published by Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Total knee arthroplasty (TKA) is a common procedure resulting in significant post-operative pain. Percutaneous cryoneurolysis targeting the infrapatellar branch of the saphenous nerve and anterior femoral cutaneous nerve could relieve post-operative knee pain by temporarily blocking sensory nerve conduction."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A retrospective chart review of 100 patients who underwent TKA was conducted to assess the value of adding perioperative cryoneurolysis to a multimodal pain management program. The treatment group consisted of the first 50 patients consecutively treated after the practice introduced perioperative (five days prior to surgery) cryoneurolysis as part of its standard pain management protocol. The control group consisted of the 50 patients treated before cryoneurolysis was introduced. Outcomes included hospital length of stay (LOS), post-operative opioid requirements, and patient-reported outcomes of pain and function."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A significantly lower proportion of patients in the treatment group had a LOS of ≥2days compared with the control group (6% vs. 67%, p<0.0001) and required 45% less opioids during the first 12weeks after surgery. The treatment group reported a statistically significant reduction in symptoms at the six- and 12-week follow-up compared with the control group and within-group significant reductions in pain intensity and pain interference at two- and six-week follow-up, respectively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Perioperative cryoneurolysis in combination with multimodal pain management may significantly improve outcomes in patients undergoing TKA. Promising results from this preliminary retrospective study warrant further investigation of this novel treatment in prospective, randomized trials."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "III."
          }
        ]
      },
