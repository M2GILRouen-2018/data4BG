      "Abstract": {
        "CopyrightInformation": "© 2015 Sigma Theta Tau International.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose of this study was to identify the prevalence of xerostomia and related factors among low-income older adults in South Korea."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "A cross-sectional, population-based study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Using data from the Home Healthcare Service Project, a population-based interview survey with home healthcare service, a total of 9,840 adults 65 years of age and older were assessed for the presence of xerostomia in association with aspects of health lifestyles, chronic disease, oral conditions, and oral function."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Overall, 40% of participants reported experiencing xerostomia. Multivariate regression analysis indicated xerostomia was more likely to be reported by women having symptoms of gingival bleeding/pain, having difficulty swallowing liquid or chewing solid food, and having multiple chronic diseases. Interestingly, older adults who live alone and drink alcohol (two or more times per week) reported fewer problems with xerostomia."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Increased focus on the detrimental health consequences of xerostomia would make treatment a higher priority. Improved assessment of at-risk populations, particularly among the elderly, could lead to earlier preventative interventions, lessening the negative impact on quality of life."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL RELEVANCE",
            "content": "Health professionals along with the general public need increased knowledge about the detrimental effects of xerostomia on overall health. There is a need for earlier assessment and treatment to facilitate optimal health promotion and disease prevention."
          }
        ]
      },
