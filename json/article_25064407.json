      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare the incidence of hypertension, stroke, coronary heart disease, and diabetes in women who have delivered after in vitro fertilization (IVF) with those who delivered after natural conception."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A cohort study in Sweden between 1990 and 2008."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Sweden."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "23,498 women who had given birth to a child after IVF and 116,960 individually matched women."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "None."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Incidence rates of hypertension, diabetes, stroke, and coronary heart disease in both groups."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Inpatient and outpatient diagnoses of hypertension, stroke, coronary heart disease, and diabetes were identified by linkage to the Swedish National Patient Register. The mean time of follow-up was 8.6 years in both groups. Multivariable analysis showed that hypertension had a higher incidence in IVF mothers with a hazard ratio (HR) of 1.27, 95% confidence interval (CI) 1.13-1.41, as compared with mothers from the Medical Birth Register. There was a trend to a higher incidence of stroke (HR 1.27; 95% CI, 0.96-1.68), but the incidence of coronary heart disease and diabetes did not differ."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Hypertension was more prevalent in the IVF group, which suggests that these women should be aware of their blood pressure and cardiovascular risk profile."
          }
        ]
      },
