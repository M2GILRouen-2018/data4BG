      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "This was a study of a standardized functional restoration program that included 11 centers in seven states, involving 303 patients in the treatment group and 94 patients in the comparison group."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To illustrate the positive effect a functional restoration program has on return to work rates and work retention regardless of previous surgical intervention."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Data were obtained from the initial and discharge evaluations as well as at 6- and 12-month follow-up."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Patients received a standardized work capacity assessment upon entrance and were recommended to the program if they adhered to specific entrance criteria. Treatment patients received the same evaluation at discharge."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Significant improvement in functional abilities, actual return to work, and work retention were noted in the treatment group regardless of treatment intervention."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This study demonstrated improved return to work rates and work retention with surgical and nonsurgical patients after their participation in a functional restoration program."
        }
      ]},
