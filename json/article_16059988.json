      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the clinical application of lung function analysis in diagnosis of children respiratory diseases."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Respiratory function was evaluated with portable lung function detector in 6 261 children with respiratory diseases. FEV1, FVC and PEFR were measured in 268 children with cough variant asthma (CVA) and 147 children with asthma (AS), and the results were self-compared during follow-up."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "There were no significant differences in above parameters between children with cough variant asthma and those with asthma (P>0.05). Lung functions of asthma children were improved evidently by administration of glycocorticoid inhalator (P<0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Lung function detection is essential for diagnosis of asthma and it can be used as a reliable index for therapeutic effect of asthma children."
        }
      ]},
