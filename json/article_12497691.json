      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Few data exist on treating spinal cord endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "Total excision of the endometriotic lesion, followed by a bilateral oophorectomy and aromatase inhibitor therapy, led to a clinical improvement."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Attempts at total removal of spinal cord endometriosis may be safer after achieving pharmacologic control."
        }
      ]},
