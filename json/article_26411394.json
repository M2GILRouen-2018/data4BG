      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "One-stage bilateral total hip arthroplasty (B-THA) is rarely performed despite a 20% incidence of bilateral degenerative hip disease requiring surgical intervention."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We retrospectively evaluated functional outcomes in 22 consecutive patients undergoing B-THA with a matched cohort undergoing unilateral THA by the same surgeon using the direct anterior approach."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Although there was a significant difference in blood loss (P < .01) and surgical time (P < .001), there was no difference in length of hospital stay (P = .09), number of discharges to a rehabilitation facility (P = .22), or postoperative Harris Hip scores (P = .75)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Advances in blood loss and pain management protocols in association with the direct anterior approach should renew interest in the efficacy of 1-stage B-THA."
          }
        ]
      },
