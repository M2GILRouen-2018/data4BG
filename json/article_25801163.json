      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "The study objective is to investigate the effects of a simple price list sticker placed on vaporizers on anesthetic use and costs. The price list only showed the cost per hour of the annually most expensive drugs, which had a low-cost alternative."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "The design is a prospective database study with historical controls."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "The setting is at operating rooms."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "All patients are undergoing a surgical procedure under anesthesia in both study periods, except cardiothoracic and day care patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "The intervention is application of a price list sticker on the vaporizers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Monthly cost and amount of anesthetic agents used during the 9 months before and after the intervention."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "After application of the price stickers, the use of both the annually most expensive agents and the anesthetic budget decreased substantially. Most notable was a decrease of 28% in the use of sevoflurane."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Price sticker on vaporizers may be an effective, simple, and cheap method to reduce anesthetic costs."
          }
        ]
      },
