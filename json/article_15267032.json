      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "ISSUES AND PURPOSE",
          "content": "Using Andersen's Behavioral Model of Health Care Use, this pilot study was conducted to better understand the experiences of children with asthma as they access an urban healthcare system."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND METHODS",
          "content": "This descriptive study used a convenience sample of 34 families of pediatric asthma patients who participated in semistructured interviews and closed medical record review."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Only one patient reported having a written exacerbation management plan. Beliefs regarding medication addiction and side effects were frequently reported as barriers to medication adherence, and children seeking asthma care in primary care settings saw many care providers."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "PRACTICE IMPLICATIONS",
          "content": "Exploring how expanded nursing roles can help address both family and system factors serving as barriers to health care ought to be a key priority for nursing."
        }
      ]},
