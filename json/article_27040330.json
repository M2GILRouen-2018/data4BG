      "Abstract": {
        "CopyrightInformation": "© 2016 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Limited research has examined the fat-but-fit paradigm among coronary artery disease patients."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The objective of this study was to evaluate the fat-but-fit paradigm as it relates to mortality risk among patients with coronary artery disease."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A total of 766 coronary artery disease patients (Mage = 65.4 years) were evaluated. Physical activity was assessed via self-report, with weight status determined from measured body mass index. Six mutually exclusive groups were evaluated, including (i) Normal Weight and Inactive (referent), (ii) Overweight and Inactive, (iii) Obese and Inactive, (iv) Normal Weight and Active, (v) Overweight and Active and (vi) Obese and Active."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 301 died over the follow-up period, with the duration of the unweighted median follow-up period being 86 months (IQR: 62-113). The Cox proportional hazard results, after adjusting for age, gender, and race-ethnicity, were as follows: Group 2: HRadjusted = 0.95, 95% CI: 0.57-1.60, p = 0.87; Group 3: HRadjusted = 0.91, 95% CI: 0.57-1.44, p = 0.68; Group 4: HRadjusted = 0.35, 95% CI: 0.14-0.86, p = 0.02; Group 5: HRadjusted = 0.51, 95% CI: 0.28-0.93, p = 0.02; Group 6: HRadjusted = 0.43, 95% CI: 0.21-0.85, p = 0.01."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These findings provide support for the fat-but-fit paradigm applied to CAD patients. Ultimately, these findings underscore the importance of promoting physical activity to all weight groups of CAD patients."
          }
        ]
      },
