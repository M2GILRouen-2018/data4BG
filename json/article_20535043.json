      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case reports of stage 4 compressive-extension injury (CES-4)."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To present CES-4, which has been known as a theoretical stage."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Compressive-extension stage 3 and 4 lesion has been considered as theoretical stages between the mild and advanced lesions of the compressive-extension phylogeny."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Clinical and radiologic details are presented documenting the CES-4 injury."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The authors have encountered 2 cases of CES-4 injury and in this study report the radiographic findings and describe the surgical treatment of the cases."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "CES-4 is not a theoretical stage."
        }
      ]},
