      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "n-Hexanal is a major component in emissions from stored wood pellets. The production and use of wood pellets has increased dramatically. Our aim was to evaluate acute health effects of n-hexanal vapors."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Twelve healthy volunteers were exposed to 0, 2, and 10 ppm n-hexanal for 2 hours at rest in a balanced order."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Ratings of discomfort in the eyes and nose, solvent smell, and headache increased significantly with the level of exposure. Frequency of blinking was significantly increased at 10 ppm. No effects on pulmonary function and nasal swelling were detected, except a not-significant tendency to increased nasal obstruction at 10 ppm. No clear effects on plasma inflammatory markers (C-reactive protein and interleukin-6) were observed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Two hours of exposure to n-hexanal results in mild irritation at 10 ppm, with no apparent adversity at 2 ppm."
        }
      ]},
