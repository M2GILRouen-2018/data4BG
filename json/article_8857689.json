      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To provide an overview of pain management of the cancer patient in the home setting, including assessment, planning and implementation of care and evaluation if interventions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Review articles, research studies, and book chapters pertaining to pain management."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A major concern of cancer patients and caregivers is their ability to control the pain at home. With competent, consistent care, 24-hour access, and working in collaboration with other healthcare professionals, nurses can be a decisive force in maintaining patient, comfort, supporting and educating the patient and caregiver at home and preventing rehospitalization for pain control."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "The goal of achieving effective pain control is one of the greatest challenges facing the home, care nurse. Meeting this challenge can decrease patients' suffering and relieve caregivers' stress."
        }
      ]},
