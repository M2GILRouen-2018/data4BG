      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To examine the impact of a small-changes weight loss program across a 3-month intervention followed by a 6-month follow-up program."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A one-group pre-post intervention study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Medium-sized Southwestern university."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Twenty-five obese adult women (mean body mass index [BMI] \u200a=\u200a 31.8 kg/m(2), standard deviation [SD] \u200a=\u200a 4.9)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Participants were asked to choose and adopt small changes in their diet and physical activity relative to baseline during weekly group-based meetings over 3 months. Participants then received bi-weekly phone calls across a 6-month follow-up period."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASURES",
          "content": "Weight change was the primary outcome. Secondary outcomes included waist circumference, daily step count, and caloric intake."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANALYSES",
          "content": "Intention-to-treat analysis of change from baseline and completers-only analysis (n \u200a=\u200a 22) for secondary outcomes."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Participants achieved clinically significant weight loss (mean [M] \u200a=\u200a -3.2 kg, standard error [SE] \u200a=\u200a .47 kg, p < .001) across the initial small changes treatment program. Moreover, participants continued to lose weight across the 6-month phone-based follow-up program (M \u200a=\u200a -2.1 kg, SE \u200a=\u200a .83 kg, p < .017), totaling >5% weight loss across the 9-month program (M \u200a=\u200a 5.3 kg, SE \u200a=\u200a 1.1 kg, p < .001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Using a small changes approach, participants achieved weight loss in an initial group-based program, which continued with minimal phone-based follow-up. Larger randomized studies comparing a small changes approach to traditional obesity treatment are warranted."
        }
      ]},
