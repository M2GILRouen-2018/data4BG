      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "To assess to which extent lowering the level of HbA1c influences the 10-year risk of coronary heart disease (CHD) and all-cause mortality in patients with type 2 diabetes mellitus."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A literature search in Pubmed and Embase was performed, and the absolute risks in the results of the relevant and valid studies compared."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Each study shows that with a decreasing percentage of HbA1c, both the risk of developing CHD and the risk of mortality decrease."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Lowering HbA1c in type 2 diabetics decreases the absolute risk of developing CHD by 5-17%, as well as decreasing all-cause mortality by 6-15%."
        }
      ]},
