      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We report an extremely rare case of bilateral posterior nasal septal abscess in an otherwise healthy adult patient."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Case report and a review of the world literature concerning atraumatic nasal septal abscess and its management."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The development of an atraumatic nasal septal abscess is rare, but it has been reported in association with acute sinusitis, in patients with poor immunity and in children. The presentation, clinical course and treatment are discussed in the presented patient."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "To our knowledge, this is the first report in the world literature of a bilateral posterior septal abscess associated with acute sinusitis in an otherwise healthy adult."
        }
      ]},
