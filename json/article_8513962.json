      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To evaluate the efficacy of goserelin versus a low-dose cyclic oral contraceptive (OC) in improving pelvic pain in women with endometriosis and to compare recurrence of symptoms during follow-up."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Open-label, randomized trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital endometriosis center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Fifty-seven women with moderate or severe pelvic pain and laparoscopically diagnosed endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Six-month treatment with goserelin depot (n = 29) or a low-dose cyclic OC (n = 28) followed by 6-month follow-up."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Variation in severity of symptoms during treatment and at the end of follow-up as shown by a linear analog scale and a verbal rating scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At 6 months of treatment, a significant reduction in deep dyspareunia was observed in both groups, with goserelin superior to the OC at linear analog scale assessment. Nonmenstrual pain was diminished on both scales without differences between treatments. Women taking the OC experienced a significant reduction in dysmenorrhea. At the end of follow-up, symptoms reappeared without differences in severity between the groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Low-dose cyclic OCs may be a valuable alternative for the treatment of dysmenorrhea and nonmenstrual pain associated with endometriosis. Symptoms recurred in most subjects 6 months after drug withdrawal."
        }
      ]},
