      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate tubal patency by transvaginal sonosalpingography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Comparative study of transvaginal sonosalpingography with chromolaparoscopy in subjects with unknown tubal function."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient infertility clinic at Zeynep Kamil Maternity Hospital in Istanbul, Turkey."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Forty-two cases of unknown tubal function with infertility complaints were included."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Isotonic saline was injected into the uterine cavity through a catheter."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Transvaginal sonosalpingography is a safe, easy, and cost-effective procedure for screening tubal status."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The results obtained from transvaginal sonosalpingography and laparoscopy were completely consistent for 29 cases (76.32%) and partially consistent for 8 cases (21.05%). Transvaginal sonosalpingography accurately showed patency in 26 patients and bilateral nonpatency in 3 patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Transvaginal sonosalpingography, with its accuracy and safety, is a promising screening and diagnostic technique in the evaluation of tubal patency on ambulatory basis."
        }
      ]},
