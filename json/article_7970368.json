      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To reduce the time taken to achieve relief when a strong narcotic is indicated for the control of cancer pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "A method of accelerated titration of morphine dosage is described. The time taken to achieve good pain control in 50 consecutive terminally ill cancer patients was recorded."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The average time to taken to control pain was 26 hours for patients being cared for at home, and 6 hours for hospice inpatients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Rapid pain control with morphine can be achieved safely within hours in most cancer patients with morphine responsive pain."
        }
      ]},
