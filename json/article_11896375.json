      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether clinical and statistically significant changes in back pain, shoulder pain, spine stiffness, and quality of sleep may be documented after use of a prescribed bedding system."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Quasi-experimental field study of single group pretest-posttest design with subjects serving as their own controls."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Two chiropractic clinics and the Oklahoma State University Program of Health and Human Performance."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Convenience sample of 22 subjects (women, n = 13; men, n = 9) between the ages of 25 and 75 years with documented disturbed sleep, shoulder pain, low back pain, and spine stiffness of a chronic nature."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Pretest and posttest 28-day Visual Analog Scales for pain, spine stiffness, and quality of sleep."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MAIN RESULTS",
          "content": "The experimental bedding system reduced back pain by 57.21% (P =.000001), reduced shoulder pain by 60.83% (P =.000005), reduced back stiffness by 59.12% (P =.000004), and improved quality of sleep by 60.73% (P =.000001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Results suggest that subjects obtain significant improvement in shoulder and back pain, back stiffness, and quality of sleep after 28 days of prescribed bedding system use as compared with 28 days of personal bedding use. Female subjects and those with lower body weight were more likely to significantly improve than heavier and more obese subjects."
        }
      ]},
