      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "We report our experience of revision of failed stemmed shoulder hemi-arthroplasty for causes other than infection."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL/METHOD",
          "content": "Seventeen revisions were followed for a minimum of 2 years. Fifteen cases were revised for symptomatic glenoid erosion. Sixteen were revised to a total shoulder arthroplasty and one to a cuff tear arthropathy head."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "The mean visual analogue pain score following revision surgery was reduced from 6.7 to 3.2 (P = 0.008). However the Constant-Murley and the Association of Shoulder and Elbow Surgeons scores failed to improve significantly."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "We conclude that revision surgery for failed stemmed shoulder hemi-arthroplasty improves pain but not function."
        }
      ]},
