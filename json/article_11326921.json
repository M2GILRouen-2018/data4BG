      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "In order to assess the safety after cesarean section, the complications and morbidity rate within 2 years after delivery between cesarean section and spontaneous delivery were compared."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A retrospective cohort study was used in this study."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The prevalence of anemia, mobility restriction of uterus, chronic pelvic pain and wound ache during the 2 years postpartum in cesarean section group were 11.1%, 9.6%, 4.3% and 5.1% respectively, which were significantly higher than those in women with spontaneous delivery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In order to protect women's health, the indications for cesarean section must be mastered strictly."
        }
      ]},
