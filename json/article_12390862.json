      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the approach for coronary artery bypass grafting without cardiopulmonary bypass and assess the feasibility and safety of this procedure."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The clinical data of 6 patients receiving coronary artery bypass grafting without cardiopulmonary bypass were reviewed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No death occurred in these patients during the operation and the follow-up visit for 3 to 12 months found no incidence of angina pectoris, and the life quality of the patient was obviously improved."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Coronary artery bypass grafting without cardiopulmonary bypass is applicable in patients with multiple coronary artery disease, especially those at high risk for cardiopulmonary bypass procedures."
        }
      ]},
