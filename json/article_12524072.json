      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effectiveness of uterine artery embolization in women with uterine myomas in terms of the clinical results for the relief of related symptoms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A pilot study on 26 women affected by uterine single myoma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary level care in an university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Twenty-six patients, aged 32 to 54 years, suffering of menorrhagia, pelvic pain, and abdominal mass for single myoma, intramural localization."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Selective uterine artery embolization performed under peridural anesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "We measured the x-ray dose to which patients were exposed. Color power Doppler ultrasound examinations were performed during the follow-up evaluations at 1 to 6 months and 1 year after the procedure."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Uterine artery embolization was successfully performed in 100% of cases. The mean fluoroscopy time was of 20 minutes during the procedure. The mean dose of x-ray absorbed by the ovary was estimated at 18.7 cGy and the mean dose of x-ray absorbed by the skin was 126.7 cGy. A reduction of myoma volume of 55% was found at 6 months' ultrasound examination and 75% at the 1-year examination."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Patients are well satisfied and have short recovery times with this procedure. Uterine artery embolization may be a valid alternative to traditional surgery."
        }
      ]},
