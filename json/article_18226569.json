      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To compare the outcome of arthroscopic lysis and lavage of TMJ with internal derangement of Wilkes stages II, III, IV, and V."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Arthroscopic lysis and lavage was performed in 45 TMJ of 39 patients with internal derangement. The cases were divided into 4 groups corresponding to Wilkes stages II, III, IV, and V. Two parameters were compared pre- and postoperatively: pain and mouth opening. Statistical significance was determined using the chi(2) test."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Overall success rate was 86.7% (Wilkes stage II 90.9%, Wilkes stage III 92.3%, Wilkes stage IV 84.6%, Wilkes stage V 75%). There were no statistically significant differences between the success rates for Wilkes stages II, III, IV, and V."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Arthroscopic lysis and lavage should be performed as a standard operation for internal derangement of the TMJ after failure of conservative treatment in all Wilkes stages."
        }
      ]},
