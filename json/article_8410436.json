      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the relationship between women's symptoms of endometriosis and self-esteem."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Private practice."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Twenty-three mostly middle class, employed women who had been diagnosed with endometriosis and had received treatment from a physician."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "The volunteer subjects completed a two-part questionnaire. One part consisted of questions on demographic characteristics, health history, menstrual history, and symptoms of endometriosis, and the other part consisted of the Rosenberg Self-Esteem Scale."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The relationship between women's self-esteem and perceptions of the number, frequency, and severity of their symptoms."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No significant correlation was found between self-esteem and the number, frequency, and severity of endometriosis symptoms. Significant correlations were found between the number/frequency of symptoms and the severity of pain and between the frequency and number of symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Although endometriosis symptoms did not influence self-esteem, they interfered with women's lives. Assessment of psychosocial status and nursing interventions designed to relieve pain are important factors in assisting women with endometriosis."
        }
      ]},
