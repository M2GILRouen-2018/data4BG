      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Wiley-Liss, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To demonstrate the variety of stent abnormalities that may be evaluated by coronary computed tomographic angiography (CTA)."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The application of CTA to the evaluation of coronary stents has focused almost entirely on the detection of in-stent restenosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "All CTA performed for stent evaluation at a single institution were reviewed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In addition to in-stent restenosis, stent fracture, and overlap failure, a multiplicity of stent-related problems not previously addressed by CTA was categorized and illustrated: late stent thrombosis, jailed branches, edge stenosis, bifurcation stents, inadequate stent expansion, stent aneurysms, peri-stent plaque, and stenting into bridged myocardium."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "CTA may be used to evaluate the full range of stent-related problems. This work provides the framework for future studies validating these applications."
          }
        ]
      },
