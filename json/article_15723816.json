      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Evaluation and improvement of pain management in our emergency department (ED)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "This was a \"before-after\" study. For each subject, the nurse, the physician, and the patient were asked to rate the initial intensity of the pain on a Visual Analogue Score (VAS). The timing and the type of analgesics administered were then recorded and follow-up VAS was performed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A teaching, community-based, 400-bed hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY PARTICIPANTS",
          "content": "140 patients admitted for acute pain related to orthopedic injuries."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The gap between the VAS expressed by the patient and estimated by the staff, the proportion of patients receiving analgesics, and the length of time delays between admission and analgesic administration."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "The intervention included education of medical and nursing staffs, insertion of a VAS template in the patient's chart, initiation of routine VAS assessment and re-assessment, and implementation of a protocol for pain management with standing orders for nurses."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The VAS gap between the patient and the nurse decreased significantly from 1.91 2.04 to 1.03 1.97 after the intervention (P = 0.01). The percentage of patients receiving analgesics rose from 70 to 82% following the intervention. Time from admission to analgesia decreased from 80 +/- 68 min (mean +/- SD) before the intervention, to 58 +/- 37 min after the intervention (P = 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Inadequate pain management in the ED appears related to poor staff assessment of pain and may be improved by routine VAS recording and by a nurse-based pain protocol."
        }
      ]},
