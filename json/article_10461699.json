      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To provide an overview on the presentation, diagnosis, and treatment of metastatic epidural spinal cord compression (MESCC)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Published articles, book chapters, and research reports."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "MESCC is a common oncologic emergency that requires prompt recognition and emergency treatment to relieve pain and preserve neurologic function. The signs and symptoms of MESCC are easily detected and can be integral assessment components of the nursing care of any patient with a solid tumor."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Nurses can have a dramatic impact on preventing neurologic complications caused by this oncologic metastatic problem. When neurologic compromise is not prevented or reversed, nurses also can provide expert care to patients and families in the rehabilitation phase of MESCC."
        }
      ]},
