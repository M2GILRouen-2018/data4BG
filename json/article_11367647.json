      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe the effect of Xuefuzhuyu Pill (XFZYP) on blood stasis syndrome and risk factor of atherosclerosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Fifty-seven patients of atherosclerosis were randomly divided into XFZYP group (30 cases) and aspirin group (27 cases) treated with XFZYP (6 g, three times daily) and aspirin (40 mg per day) oral taken respectively for one month."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "XFZYP could improve blood stasis syndrome of patients (P < 0.01) and reduced the level of risk factor of atherosclerosis, including high blood cholesterol (P < 0.01), oxidation of low density lipoprotein (P < 0.05) and plasma granule membrane protein alpha (P < 0.01)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "XFZYP is beneficial to retard the progress of atherosclerosis."
        }
      ]},
