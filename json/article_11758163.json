      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study latent adenovirus infection in the stable stage of chronic obstructive pulmonary disease(COPD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "The bronchial epithelial cells and alveolar macrophages from 12 patients with chronic bronchitis, 10 patients with COPD, 6 patients with asthma and 8 healthy volunteers were obtained by bronchosocpy. The adenoviral DNA was determined in the epithelial cells and macrophages. All patients were in the stable stage. The polymerase chain reaction(PCR) was used for detection of the adenoviral genome E1A."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The E1A region of adenovirus was found in the epithelial cells of COPD and chronic bronchitis patients (27%), not found in the patients with asthma and normal volunteers. Furthermore, E1A DNA was much more commonly in the COPD patients (50%) than in the patients with chronic bronchitis (8%) (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Latent adenoviral infection was present in the stable stage of COPD and may be related to the pathogenesis of the disease."
        }
      ]},
