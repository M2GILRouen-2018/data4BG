      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Ltd and The Ergonomics Society. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Back problems are a major occupational health issue for prehospital emergency care professionals. The goals of this article are to: 1) provide descriptive data about the prevalence and the severity of lower back and upper back disorders in EMTs and paramedics; 2) identify some individual and collective strategies used by EMTs and paramedics to protect their health as they perform prehospital emergency missions; 3) assess the possible effectiveness of strategies in preventing back problems by exploring associations between the use of strategies and the presence and severity of symptoms."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "The method includes a questionnaire survey (sample n = 334; paramedics and emergency medical technicians) and ergonomics work practice analysis involving shadowing ambulance crews in 12 medical emergency services (over 400 h)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A majority of ambulance professionals had experienced back pain in the twelve-month period before the survey. Work practice analysis revealed strategies and tricks of the trade used by ambulance professionals to reduce the chances of back strain while working. Multiple regression analyses showed that self-reported use of such strategies was associated with fewer back symptoms."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Preventive strategies should be integrated into specialised training programs for prehospital medical emergency professionals. This approach could also be used in other work settings."
          }
        ]
      },
