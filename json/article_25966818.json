      "Abstract": {
        "CopyrightInformation": "© 2015 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "First studies have shown that juvenile psoriasis is associated with an increased prevalence of comorbidity."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "We carried out a data analysis to characterise the profiles of comorbidity in children with psoriasis and atopic eczema."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Prevalence data were derived from the database of a German statutory health insurance company according to ICD-10 codes L40 (psoriasis) and L20 (atopic eczema) of children up to 18 years insured in 2009."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Data sets included 1.64 million persons and 293,181 children. 1,313 children = 0.45% (0.42-0.47) had a diagnosis of psoriasis and 30,354 = 10.35% (10.24-10.47) had a diagnosis of atopic eczema. Obesity, hyperlipidaemia, arterial hypertension and diabetes were more often diagnosed in children with psoriasis in comparison to all children without psoriasis and to those with atopic eczema."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Children with psoriasis and atopic eczema show different and specific patterns of comorbidity which should be detected early and treated adequately."
          }
        ]
      },
