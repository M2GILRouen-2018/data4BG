      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess parent-child agreement of child disability and pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Twenty children with juvenile chronic arthritis aged between 8 and 16 years and their mothers were assessed using a recently developed measure of child disability and pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Results demonstrated a high level of agreement between children and their mothers with respect to disability. However, there was no correlation between the children's and their mothers' assessment of pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This suggests that parents of children with chronic arthritis give accurate information regarding disability, but not regarding pain."
        }
      ]},
