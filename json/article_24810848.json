      "Abstract": {
        "CopyrightInformation": "© The Author 2014. Published by Oxford University Press. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Pain is common in advanced malignancy but also prevalent in other non-malignant life-limiting diseases such as advanced heart disease; end stage renal failure and multiple sclerosis. Patients with renal or liver impairment need specific consideration, as most analgesics rely on either or both for their metabolism and excretion."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SOURCES OF DATA",
            "content": "Recent evidence-based guidelines and the systematic reviews that have informed their recommendations."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "AREAS OF AGREEMENT",
            "content": "The principles of the WHO (World Health Organisation) analgesic ladder are commonly endorsed as a structured approach to the management of pain. For neuropathic pain, the efficacy of different agents is similar and choice of drug more guided by side effects, drug interactions and cost."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "AREAS OF CONTROVERSY",
            "content": "Evidence supporting the WHO analgesic ladder is disputed and alternatives suggested, but no overwhelming evidence for an alternative approach exists to date."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "GROWING POINTS",
            "content": "Alternative approaches to the WHO analgesic ladder, new analgesic agents, e.g. rapid onset oral/intranasal fentanyl."
          }
        ]
      },
