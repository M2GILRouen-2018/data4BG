      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the injury patterns among competitive curlers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants at two curling championship events were asked to complete injury history questionnaires."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "76 curlers (39%) participated; 79% of these reported curling related musculoskeletal pain, most commonly involving the knee (54%), back (33%), and shoulder (20%). Sweeping and delivering the stone were most likely to provoke symptoms. Time loss injuries were estimated to occur at a rate of 2 per 1000 athlete exposures."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Curling appears to be a relatively safe winter sport. Prospective studies are needed to confirm these preliminary findings and to further define the risk factors for curling related injuries."
        }
      ]},
