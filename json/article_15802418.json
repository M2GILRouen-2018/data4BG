      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Pregnancy developing in a cesarean scar is a very rare but possibly life-threatening condition because of the risk of rupture and excessive hemorrhage."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "A 34-year-old woman presented with lower abdominal pain at 6 weeks of gestation. A cesarean delivery had been performed 3 years earlier. Transvaginal ultrasound examination revealed a viable pregnancy developing in the anterior wall of the uterus. The patient was treated successfully with systemic methotrexate and curettage."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Conservative management with methotrexate and curettage can be considered in the treatment of ectopic cesarean scar pregnancy."
        }
      ]},
