      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To investigate the expression and localization of FGFR family in squamous cell carcinoma of head and neck (SCCHN) cell lines."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Total protein was extracted from 10 SCCHN cell lines and the expression of FGFR was detected by Western blot. The localization of FGFR was further demonstrated by immunofluorescence staining in SCC25 and HN4 cell lines. Gray value was measured by Image J. GraphPad Prism 5.01 software package was used for data processing and analysis."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "FGFR1 expression was detected in 6/10 cell lines and FGFR2, 3, 4 was detectable in all cell lines. The expression of FGFR1, 2, 4 was mainly in the nucleus and cytoplasm while FGFR3 was predominantly localized in cytoplasm."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "FGFR shows co-expression in SCCHN cell lines, which may be associated with the tumorigenesis and development of SCCHN."
        }
      ]},
