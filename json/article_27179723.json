      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "Label": "UNLABELLED",
            "content": "Little is known about the long-term outcomes after first-generation sirolimus-eluting stent (SES) implantation. We aimed to investigate the clinical outcomes up to 10 years after SES implantation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The study population comprised 342 patients (504 lesions) who underwent SES implantation between January 2002 and December 2004. The median duration of follow-up was 3816 days (interquartile range [Q1-Q3], 3,705-3,883 days)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The cumulative event rate of definite stent thrombosis was 3.9%. The cumulative rate of target lesion revascularization (TLR) at 1, 5, and 10 years was 8.7%, 18.8%, and 31.1%, respectively, and the annual rate of TLR was 3.1%. Clinically driven TLR occurred at relatively constant rate during 10 years (2.0% per year). In a multivariate analysis, higher body mass index, hemodialysis, in-stent restenosis (ISR) target lesion, and total stent length >30 mm were independent risk factors of TLR within 5 years. An independent risk factor of TLR beyond 5 years was ISR target lesion."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Late TLR after SES implantation is a long-term hazard, lasting up to 10 years. The ISR target lesion is a risk factor of TLR during 10 years."
          }
        ]
      },
