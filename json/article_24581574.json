      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine if meaningful weight loss (≥10%) improved conception and live birth rates of overweight patients with infertility."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A retrospective cohort study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Academic medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Overweight patients (body mass index ≥25 kg/m(2); n = 52) being treated for infertility and referred for weight loss counseling."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Patients were given a \"meaningful\" weight loss goal of 10%. They were followed by an endocrinologist who provided diet and exercise recommendations, metabolic screening, and pharmacologic intervention when indicated."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Pregnancy rate, live birth rate, weight loss."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Thirty-two percent of the patients achieved meaningful weight loss. Patients achieving meaningful weight loss had significantly higher conception (88% vs. 54%) and live birth rates (71% vs. 37%) than those who did not."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Weight loss improves live birth rates in overweight patients with infertility. Health care providers should incorporate weight loss counseling when caring for overweight patients who plan to conceive."
          }
        ]
      },
