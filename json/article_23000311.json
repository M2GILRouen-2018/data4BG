      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 The Canadian Society of Clinical Chemists. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Complement C1q tumor necrosis factor-related protein 1 (CTRP1), a recently identified adipokine, was found to stimulate aldosterone production. Obesity and metabolic syndrome are frequently associated with elevated levels of aldosterone. Therefore, it would be interesting to investigate whether the secretion of CTRP1 in human serum is associated with obesity as well as with hypertension."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "This study evaluated serum CTRP1 concentrations in healthy individuals and patients with metabolic syndrome."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Serum samples from 61 healthy individuals and 46 patients with metabolic syndrome were measured for CTRP1 by enzyme-linked immunosorbent assay (ELISA)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Correlation analyses showed that serum CTRP1 in healthy individuals did not correlate with BMI, leptin, TG, HDL-CH, and LDL-CH; however, in patients with metabolic syndrome, CTRP1 correlated with glucose, HbA1c and BMI. CTRP1 level was significantly higher in subjects with metabolic syndrome compared to healthy subjects."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Our results support the hypothesis that adipokine CTRP1 is associated with metabolic syndrome and obesity compared to healthy individuals."
          }
        ]
      },
