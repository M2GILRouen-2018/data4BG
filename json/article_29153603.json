      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Patients with melanoma brain metastases (MBM) have been excluded from trials evaluating immunotherapy in melanoma. As such, immunotherapy's role in MBM is poorly understood, particularly in combination with radiotherapy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The National Cancer Database was queried for patients with MBM receiving brain radiotherapy. They were classified according to immunotherapy receipt. Multivariate Cox regression was performed to identify factors associated with survival."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Among 1287 patients, 185 received immunotherapy. Factors associated with improved survival included younger age, academic facility, lower extracranial disease burden, stereotactic radiotherapy, chemotherapy, and immunotherapy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Adding immunotherapy to radiotherapy for MBM is associated with improved survival."
          }
        ]
      },
