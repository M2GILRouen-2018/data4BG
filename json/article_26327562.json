        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Sclerosing stromal tumor is an extremely rare type of benign ovarian sex cord stromal tumor."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE",
            "content": "The benign characteristic of this tumor is well known but we present an uncommon case of paraovarian sclerosing stromal tumor with high mitotic activity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "RESULTS AND CONCLUSION",
            "content": "Despite this potential malignancy, our patient was treated successfully with enucleation only."
          }
        ]
      },
