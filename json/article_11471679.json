      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the effect of retention sutures on the postoperative course of patients after major abdominal operations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomised study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Teaching hospital, Germany."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "95 patients who were at increased risk of wound failure after major abdominal operations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Conventional mass closure either with (n = 44) or without (n = 51) reinforcement by wire retention sutures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Pain intensity on postoperative days 3, 6, 9, and 12, patients' acceptance, retention-suture-related morbidity, general morbidity."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Postoperative pain was overall more severe with retention sutures. On day 6, 31/49 control patients but only 13/41 patients with retention sutures were pain-free (p = 0.003, 95% CI 0.12 to 0.51). Twelve of 44 patients with retention sutures developed local complications of the sutures, and 21 of the 44 had to have them removed prematurely, in most cases because of intolerable pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Retention sutures used to close abdominal wounds cause inconvenience, pain, and specific morbidity."
        }
      ]},
