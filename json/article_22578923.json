      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "CLINICAL QUESTION",
          "content": "Can an accelerated 2-hour diagnostic protocol using the cardiac troponin I (cTnI) measurement as the only biomarker be implemented to allow an earlier and safe discharge of low-risk chest pain patients?"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ARTICLE CHOSEN",
          "content": "Than M, Cullen L, Aldous S, et al. 2-Hour accelerated diagnostic protocol to assess patients with chest pain symptoms using contemporary troponins as the only biomarker: the ADAPT trial. J Am Coll Cardiol 2012;59(23):2091-8."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether an accelerated diagnostic protocol (ADP) for possible cardiac chest pain could identify low-risk patients suitable for early discharge using cTnI as the sole biomarker."
        }
      ]},
