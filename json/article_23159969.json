      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Neuropathic pain is a relatively common outcome of Lyme disease. Pain management options for these patients have been limited to pharmaceutical treatments."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We present a case of chronic pain following Lyme disease treated successfully using spinal cord stimulation (SCS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Pain management clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A 62-year-old patient presented with a 5-year history of bilateral foot pain following Lyme disease that failed to respond to medication and physical therapy. The patient was treated by a trial of SCS at the clinic and then implanted with a spinal cord stimulator. The Visual Analog Scale (VAS) assessed pain before and after SCS."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The patient reported significant pain relief and improved foot function. The 10 point VAS score was reduced from 8-10 to 1-3."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "LIMITATIONS",
          "content": "Single case report."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Spinal cord stimulation may be an effective option for relieving chronic pain originating from Lyme disease."
        }
      ]},
