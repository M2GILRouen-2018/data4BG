      "Abstract": {
        "CopyrightInformation": "© The Author 2014. Medical Council on Alcohol and Oxford University Press. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIMS",
            "content": "Stress neurocircuitry may modulate the relationship between alcohol drinking and chronic pain. The corticotropin-releasing factor (CRF) system is crucial for regulation of stress responses. The current study aimed to elucidate the role of the endogenous CRF ligand Urocortin 3 (Ucn3) in the relationship between alcohol drinking behavior and chronic pain using a genetic approach."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Ucn3 (KO) and wildtype (WT) littermates were subjected to a 24-h access drinking procedure prior to and following induction of chronic inflammatory pain."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Ucn3 KO mice displayed significantly increased ethanol intake and preference compared with WT across the time course. There were no long-term effects of chronic pain on alcohol drinking behavior, regardless of genotype, nor any evidence for alcohol-induced analgesia."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The increased drinking in Ucn3 KO supports a role for this peptide in alcohol-related behavior. These data suggest the necessity for more research exploring the relationship between alcohol drinking, chronic pain and the CRF system in rodent models."
          }
        ]
      },
