      "Abstract": {"AbstractText": [
        {
          "Label": "UNLABELLED",
          "content": "OBJECTIVES & AIM: The purpose of this investigation was to examine children's anxiety across the perioperative setting."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Although several studies have examined preoperative anxiety in children, few researchers have illustrated perioperative anxiety; that is, anxiety in children throughout the pre and postoperative continuum."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants were 261 children ages 2-12. Anxiety was rated prior to surgery, immediately after surgery, and for 2 weeks at home following surgery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Low child sociability and high parent anxiety predicted perioperative anxiety. Perioperative anxiety was related to postoperative pain and negative postoperative behavioral change."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Identification and prevention of anxiety in children can help prevent negative outcomes following surgery."
        }
      ]},
