      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Asociación Mexicana de Gastroenterología. Publicado por Masson Doyma México S.A. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Circulating anti-CdtB/anti-vinculin antibodies have been validated as biomarkers to distinguish IBS-D from IBD, but there is no experience with them in Latin America."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "The analysis was carried out on patients seen at a FGIDs/motility clinic over the last 7 months for diarrhea with abdominal pain and/or bloating who were tested for these antibodies. The patients were diagnosed according to the Rome III criteria or with organic disorders, and those presenting with IBS were further classified as post-infectious (PI) or non-PI-IBS."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Thirty patients were studied. Positive biomarkers were found in IBS-D and IBS-D Overlap (58.8%) and IBS-M (33.3%), with no differences between PI-IBS (71.4%) vs. non-PI-IBS (41.7%) subjects (P=.21). There was no positivity in patients with other FGIDs or organic diarrhea, except for one with small intestinal bacterial overgrowth (SIBO)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our findings support the use of this test as a first-line diagnostic tool to confirm the presence of IBS-D/IBS-M according to the Rome III criteria."
          }
        ]
      },
