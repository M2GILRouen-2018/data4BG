      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To investigate the effect of inhalation of cyclosporin (CsA) on antigen-induced airway inflammation in Sprague-Dawley rats."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Rats were sensitized with antigen (ovalbumin, OA). After two weeks, the sensitized rats were pretreated with aerosol CsA (5, 10, 20 g x L(-1)), once per day for 7 days. Then, the sensitized rats were challenged with OA (10 g x L(-1), once per day) for 2 days at day 20 after sensitization. The number of eosinophils in bronchoalveolar lavage fluid (BALF) and peripheral blood, histological changes of lung tissue, and TNF-alpha content in BALF were investigated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Inhalation of CsA significantly reduced the number of eosinophils in BALF and peripheral blood, inflammatory infiltration and tissue edema of lung tissue, decreased the content of TNF-alpha in BALF."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Inhalation of CsA inhibited airway inflammation in rats, and the mechanism is related to inhibition of TNF-alpha release."
        }
      ]},
