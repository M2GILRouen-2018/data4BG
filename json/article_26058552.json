      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "We assessed the correlation between plasma adiponectin levels and carotid intima media thickness (IMT), as a marker of atherosclerosis, in non-obese patients with type 2 diabetes."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The study group included 112 (60 males and 52 females) non-obese Egyptian patients with type 2 diabetes. Fasting plasma adiponectin was measured using ELISA technique. Carotid IMT was assessed using high-resolution color- coded Doppler ultrasonography. Forty age, sex and weight matched normal Egyptian subjects were included in the study as a control group."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A non-significant inverse correlation was found between plasma adiponectin levels and carotid IMT in the study group (p=0.054). Multiple regression analysis revealed that plasma adiponectin was not a determinant of carotid IMT in the study group (p=0.061)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The inverse relation between plasma adiponectin and carotid IMT in type 2 diabetes could be explained, at least partially, by obesity."
          }
        ]
      },
