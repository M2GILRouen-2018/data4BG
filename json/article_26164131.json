      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Society for Nutrition Education and Behavior. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To increase classroom consumption of home-provided fruits (F) and vegetables (V) in obese, overweight, and normal weight children."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Consumption evaluated within and across the baseline phase and the end of the intervention and maintenance phases."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Three Italian primary schools."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "The study involved 672 children (321 male and 329 female) aged 5-11 years. Body mass index measures were available for 461 children."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Intervention schools received the Food Dudes (FD) program: 16 days of repeated taste exposure (40 g of F and 40 g of V), video modeling, and rewards-based techniques. The comparison school was only repeatedly exposed to FV."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE",
            "content": "Grams of FV brought from home and eaten."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Chi-square, independent t test, repeated-measures ANOVA, and generalized estimating equation model."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Intervention schools show a significant increase in home-provided F (P < .001) and V (P < .001) consumption both in overweight and non-overweight children. Approximately half of children in the intervention schools ate at least 1 portion of FV at the end of the intervention and maintenance phases."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "The increase in home-provided FV intake was similar in overweight and non-overweight children in the FD intervention schools compared with the comparison school. The effect of the FD program was higher at the end of the intervention phase than the end of the maintenance phase."
          }
        ]
      },
