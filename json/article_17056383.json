      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To determine if topical gel is superior to subconjunctival injection of lidocaine in relieving pain of intravitreous injection of corticosteroid."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT POPULATION",
          "content": "One hundred patients receiving intravitreous injection of triamcinolone. INTERVENTIONAL PROCEDURE: Topical lidocaine 2% gel and subconjunctival lidocaine 2% injection."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURE",
          "content": "Analog pain score assessment, conducted by technician masked to treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There was no statistically significant difference in pain scores between the treatment groups (P = .1)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The effective relief of pain with lidocaine for intravitreous injection is independent of its mode of application (gel vs subconjunctival injection)."
        }
      ]},
