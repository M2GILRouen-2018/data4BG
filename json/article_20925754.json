      "Abstract": {
        "CopyrightInformation": "© 2009 Blackwell Publishing Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Nursing home residents often have pain as their everyday experiences and experience pain in silence."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim of this study was to gain an understanding of how nursing home residents experienced pain and how it influenced their lives and daily living."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "The present study applied a descriptive design. Fifteen residents from nursing homes were recruited among the participants in a larger quantitative study who reported having pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A qualitative method using in-depth interviews was used. The data were analysed applying Kvale's method of interpretive analysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Two dimensions of pain were identified: physical pain and pain as suffering. These are described in relation to factors that influence the intensity and the consequences of pain experiences."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Physical pain may be relieved by various means of pain management. The residents experienced pain as suffering because pain management was not timely, inappropriate, or insufficient and also because of the nature of their social situation in nursing homes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "RELEVANCE TO CLINICAL PRACTICE",
            "content": "Caregivers in nursing homes need to understand how it feels for residents to live with pain, to be interested in and aware of their needs and finally to know how to respond to their pain and suffering."
          }
        ]
      },
