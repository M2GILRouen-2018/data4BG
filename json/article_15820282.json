      "Abstract": {
        "CopyrightInformation": "© 2011 American College of Physicians",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Long working hours are associated with increased risk for coronary heart disease (CHD). Adding information on long hours to traditional risk factors for CHD may help to improve risk prediction for this condition."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine whether information on long working hours improves the ability of the Framingham risk model to predict CHD in a low-risk, employed population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cohort study with baseline medical examination performed between 1991 and 1993 and prospective follow-up for incident CHD performed until 2004."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Civil service departments in London (the Whitehall II study)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "7095 adults (2109 women and 4986 men) aged 39 to 62 years working full-time without CHD at baseline."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Working hours and the Framingham risk score were measured at baseline. Coronary death and nonfatal myocardial infarction were ascertained from medical screenings every 5 years, hospital data, and registry linkage."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "192 participants had incident CHD during a median 12.3-year follow-up. After adjustment for their Framingham risk score, participants working 11 hours or more per day had a 1.67-fold (95% CI, 1.10- to 2.55-fold) increased risk for CHD compared with participants working 7 to 8 hours per day. Adding working hours to the Framingham risk score led to a net reclassification improvement of 4.7% (P = 0.034) due to better identification of persons who later developed CHD (sensitivity gain)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATION",
            "content": "The findings may not be generalizable to populations with a larger proportion of high-risk persons and were not validated in an independent cohort."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Information on working hours may improve risk prediction of CHD on the basis of the Framingham risk score in low-risk, working populations."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "PRIMARY FUNDING SOURCE",
            "content": "Medical Research Council; British Heart Foundation; Bupa Foundation; and the National Heart, Lung, and Blood Institute and National Institute on Aging of the National Institutes of Health."
          }
        ]
      },
