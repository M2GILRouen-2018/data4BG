      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Respirators are used to maintain work performance and protect against inhaled toxins. The study compared the effects of two commonly used respirator classes--dual cartridge half face mask (HFM) and filtering face piece (N95)--upon work productivity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "107 volunteers performed eight simulated work tasks when using the HFM and N95 respirators. Tasks included several body positions, exertion levels, and concentration requirements. Objective measures of accuracy and speed were developed for each task. Scores for each task were based on the subject's rank among all subjects."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All subjects were capable of performing the tasks. There were no statistically significant differences between respirator types in either task performance metric."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Productivity impact can be measured effectively and should be considered as part of respirator design testing and when selecting the optimal respirator for a worker."
        }
      ]},
