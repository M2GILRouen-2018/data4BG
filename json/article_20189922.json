      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To describe the pain experience of Chinese American patients with cancer and to examine the relationships among pain characteristics, demographic characteristics, performance status, self-reported analgesic use, mood disturbances, and patients' acculturation levels."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive, correlational, cross-sectional study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Three community-based oncology facilities in the San Francisco, CA, Bay area."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "50 Chinese Americans who reported experiencing pain from cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants completed in their preferred language a demographic questionnaire, the Karnofsky Performance Status Scale, the Brief Pain Inventory, the Hospital Anxiety and Depression Scale, the Suinn-Lew Asian Self-Identity Acculturation Scale, and information about analgesic use. Descriptive and correlational statistics were used to evaluate data."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Pain intensity, pain interference, performance status, anxiety, depression, analgesic use, and acculturation level."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Most of the patients reported moderate to severe pain and moderate levels of interference. Lower levels of acculturation were associated with higher least and worst pain intensity scores and higher pain interference scores. Anxiety and depression scores were in the moderate range. Higher depression scores were associated with higher pain interference scores. Self-reported analgesic use for 62% of the patients was classified as inadequate."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A significant percentage of Chinese American patients experience moderate to severe cancer pain that affects their mood and their ability to function."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "Nurses should assume a proactive role in assessing the physical, emotional, and cognitive dimensions of pain in Chinese American patients. Future research should evaluate the cancer pain experience of these vulnerable patients and develop and test culturally appropriate interventions."
        }
      ]},
