      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To quantify pain response in girls affected by Rett syndrome (RTT) using electrodermal activity (EDA), a measure of skin conductance, reflecting sympathetic activity known to be modulated by physical and environmental stress."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "EDA increase, heart rate (HR) increase and Face Legs Activity Cry Consolability (FLACC) values calculated during venipuncture (invasive) and vital signs collection (non-invasive) events were compared with values calculated during a prior baseline and a RTT clinical severity score (CSS)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "EDA and HR increase were significantly higher than baseline during venipuncture only and not significantly correlated with FLACC or CSS. EDA increase was the most sensitive measure of pain response."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These preliminary findings revealed that motor impairment might bias non-verbal pain scales, underscore the importance of using autonomic measures when assessing pain and warrant further investigation into the utility of using EDA to objectively quantify RTT pain response to inform future RTT pain management."
        }
      ]},
