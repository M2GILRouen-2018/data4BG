      "Abstract": {
        "CopyrightInformation": "© 2015 The Author(s).",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CONTEXT",
            "content": "Currently, there is a national focus on establishing and disseminating standardized guidelines for return to play for athletes at all levels of competition. As more data become available, protocols and guidelines are being refined and implemented to assist physicians, coaches, trainers, players, and parents in making decisions about return to play. To date, no standardized criteria for returning to play exist for injuries to the spine."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "EVIDENCE ACQUISITION",
            "content": "Electronic databases including PubMed and MEDLINE and professional orthopaedic, neurosurgical, and spine organizational websites were reviewed between 1980 and 2015."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Clinical review."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "Level 4."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Although clinical guidelines have been published for return to play after spine injury, they are almost exclusively derived from expert opinion and clinical experience rather than from well-designed studies. Furthermore, recommendations differ and vary depending on anatomic location, type of sport, and surgery performed."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Despite a lack of consensus and specific recommendations, there is universal agreement that athletes should be pain free, completely neurologically intact, and have full strength and range of motion before returning to play after spinal injury."
          }
        ]
      },
