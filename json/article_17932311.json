      "Abstract": {
        "CopyrightInformation": "© 2016 The Authors. Journal of Clinical Periodontology Published by John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "Periodontitis is a chronic inflammatory disease, characterized by irreversible destruction of tooth-supporting tissue including alveolar bone. We recently reported mucin 4 (MUC4) and matrix metalloproteinase 7 (MMP7) as highly associated with periodontitis in gingival tissue biopsies. The aim of this study was to further investigate the levels of MUC4 and MMP7 in saliva and gingival crevicular fluid (GCF) samples of patients with periodontitis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "Saliva and GCF samples were collected from periodontitis patients and healthy controls. The levels of MUC4, MMP7, and total protein concentrations were analysed using ELISA or Bradford assay."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "MUC4 levels were significantly lower in saliva and GCF from periodontitis patients relative to healthy controls. MMP7 levels were significantly higher in saliva and GCF from periodontitis patients. Multivariate analysis revealed that MUC4 was significantly associated with periodontitis after adjusting for age and smoking habits and, moreover, that the combination of MUC4 and MMP7 accurately discriminated periodontitis from healthy controls."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "MUC4 and MMP7 may be utilized as possible novel biomarkers for periodontitis."
          }
        ]
      },
