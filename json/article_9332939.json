      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Whereas the complete myocardial revascularization is necessary in high risk group patients, the CABG procedure on the beating heart on circumflex artery still presents a dilemma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Between January 1994 and September 1996, we performed complete myocardial revascularization with left heart bypass in 62 patients (54 male, 8 female, mean age: 57) who had absolute or relative contraindications for CPB."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The hospital mortality was 3.2%, late mortality was 1.6%. Peroperative MI was seen in 2 patients (3.2%). The mean number of distal anastomosis was 3.6 (ranged 2-6)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Complete myocardial revascularization on the beating heart can be performed by using left heart bypass (LHBP) without using an oxygenerator safely in high risk patients."
        }
      ]},
