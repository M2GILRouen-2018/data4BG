      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the effects of a multi-component camp-based intervention on inflammatory markers and adipokines in children."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "One hundred and fifteen children were recruited in Odense, Denmark (2012-2014). The participants were randomly allocated to either the day camp intervention arm (DCIA) or the standard intervention arm (SIA). The intervention for the DCIA consisted of a 6-week camp-based intervention and a 46-week family-based intervention. The SIA was offered one weekly physical activity session for 6 weeks and one educational meeting. C-reactive protein (CRP), monocyte chemoattractant protein-1 (MCP1), leptin, and adiponectin were measured in serum at baseline, 6 weeks and 52 weeks."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In comparison with the SIA, the reductions in CRP (P=0.003) and leptin (p<0.001) were larger in the DCIA at 6 weeks. The intervention effects on leptin were significantly mediated by the changes in body fat mass. No intervention effects on CRP and leptin were seen at 52 weeks. No between-group differences in changes in MCP1 and adiponectin were observed at 6 weeks or 52 weeks."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The 6-week camp intervention resulted in reductions in CRP and leptin. The intervention effects did not persist to 52 weeks. The intervention effect on leptin was explained by changes in body fat mass."
          }
        ]
      },
