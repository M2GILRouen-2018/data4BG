      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To determine the levels of pain intensity and pain interference in patients with multiple myeloma, the relationship between pain and mood disturbance, and factors that influence quality of life (QOL)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive correlational mailed survey."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A private tertiary institution in the Midwest."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "Convenience sample of 346 adult patients with multiple myeloma identified through an institutional database, 206 of whom responded to the surveys."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Mailed, self-administered questionnaires: Brief Pain Inventory Short Form, Profile of Mood States, QOL Scale (Cancer Patient Version), and a demographic tool. Treatment details were obtained from the database on subjects consenting to participate."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Pain intensity, pain interference, psychologic functioning, and QOL."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "29% (n = 60) of subjects reported moderate to severe pain intensity. Significant associations were found between pain intensity and mood disturbance scores. As pain interference increased, so did levels of mood disturbance. A joint predictive model explained 74.6% of the variability in total QOL scores."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Cancer pain remains undertreated, and patients with myeloma are no exception. Pain and mood disturbance scores were significant predictors of QOL in this group of patients. Subjects with multiple myeloma reported higher levels of mood disturbance than patients with cancer from other studies."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "The oncology nurse is in a key position to facilitate ongoing, adequate pain and psychosocial assessment of patients with myeloma. Further study is needed to determine if control of pain and mood disturbance factors has a positive effect on the various domains of QOL."
        }
      ]},
