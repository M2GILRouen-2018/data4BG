      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To review the basic principles of patient education, models of innovative approaches to patient education, and needs for future development in patient education."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Review articles, research studies, book chapters, personal communication, and standards pertaining to cancer pain education."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Patient education based on principles of effective teaching and learning is the cornerstone of effective pain management. Improved methods of patient teaching combined with novel approaches to delivering appropriate pain content can lead to enhanced patient compliance with the prescribed pain medication regimen."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Nurses are essential to improving the care of cancer patients in pain by providing patient education as a care component of professional nursing practice. The challenge remains to overcome significant barriers of limited time and resources to achieve these goals."
        }
      ]},
