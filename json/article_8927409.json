      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe a case of testicular torsion in spinal cord injury (SCI)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Physical Medicine Rehabilitation Training and Research Hospital in Turkey."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We present the first case of testicular torsion in SCI along with its clinical presentation and follow-up results."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Testicular torsion is a rare condition. No case was reported in people with SCI so far. The main difficulty in the diagnosis is that the nociceptive pain is below the injury level and the acute condition could be overlooked."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Testicular torsion is an acute condition for which early diagnosis is critical in the treatment. The case we describe adds new pitfalls in the diagnosis of this rare condition in people with SCI from the perspective of nociceptive pain below the injury level."
        }
      ]},
