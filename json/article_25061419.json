      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Follistatin-like 3 (FSTL3), a circulating glycoprotein, is correlated with obesity and inflammation, which are potential mechanisms of osteoarthritis (OA). This study aims to determine the correlation of FSTL3 concentrations in serum and synovial fluid (SF) with the radiographic severity of OA."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This study consisted of 200 patients with knee OA and 148 healthy controls. The radiological grading of OA in the knee was performed in accordance with Kellgren-Lawrence (KL) grading system."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Knee OA patients had higher serum FSTL3 concentrations compared with healthy controls. Knee OA patients with KL grade 4 showed significantly elevated FSTL3 concentrations in serum and SF compared with those with KL grades 2 and 3. Moreover, knee OA patients with KL grade 3 had significantly higher FSTL3 concentrations in serum and SF compared with those with KL grade 2. FSTL3 concentrations in serum and SF of knee OA patients were significantly correlated with KL grading criteria."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "FSTL3 concentrations in serum and SF are correlated with the radiographic severity of OA."
        }
      ]},
