      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe therapeutic effect of acupuncture on no-premonitory migraine at remission stage."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The scores of pain extent, attack times, lasting time and accompanied symptoms of headache were investigated before treatment and after treatment of 4 weeks."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After treatment of 4 weeks, the scores of all items had significant changes (P < 0.01). The total effective rate was 95.0%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Acupuncture has obvious analgesic effect on no-premonitory migraine at remission stage."
        }
      ]},
