      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To define an optimal diagnostic and therapeutic algorithm when the acute abdominal syndrome occurs in hematological patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "The results of 145 emergency surgeries made in 2006-2008 for acute abdominal syndrome were studied in patients with blood system diseases."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Clinical manifestations of acute abdominal syndrome emerge in 1-1.4% of all the patients treated at the Hematology Research Center, Russian Academy of Medical Sciences. There is a need for surgery in 0.5-0.7% of all the patients admitted. In this group of patients, annual postoperative mortality is 12-16%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The routine algorithm for a diagnostic search in hematological patients with acute abdominal syndrome can lead to both hyperdiagnosis and unwarranted surgery, and incorrect choice of expectant policy as well."
        }
      ]},
