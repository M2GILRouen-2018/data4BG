      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "Does ankle aspiration help with pain control in patients with ankle fractures?"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, double-blind, randomized, placebo-controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Level 1 Academic Medical Center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS/PARTICIPANTS",
          "content": "Consecutive skeletally mature patients with ankle fractures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Randomized between ankle aspiration and sham procedure."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASUREMENTS",
          "content": "Pain scores for 72 hours after injury and pain medicine usage."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Comparison between study subjects receiving ankle aspiration and sham procedure showed no significant differences in pain scores acutely in the emergency department or within 3 days after injury. There were also no statistically significant differences in pain medicine usage within 3 days after injury. Secondary outcomes, including lower leg volume, 6-month functional outcome scores, and complication rate, also showed no significant differences between subjects receiving aspiration and the sham procedure."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Aspiration of acute ankle fractures does not result in decreased pain scores or opioid usage after aspiration. Aspiration of acute ankle fractures does not provide measurable clinical benefit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "LEVEL OF EVIDENCE",
          "content": "Therapeutic Level I. See Instructions for Authors for a complete description of levels of evidence."
        }
      ]},
