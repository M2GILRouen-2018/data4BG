      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A multidisciplinary intervention is necessary to tackle the occupational risk of low back disorders in manual handling ofpatients and to evaluate the effectiveness."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "An intervention was carried out which included risk assessment, testing and purchasing of patient handling devices, training programmes, health surveillance and collection of quantitative and qualitative outcomes to evaluate effectiveness, in a before-after design."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The intervention was effective in reducing exposures, increasing knowledge and skills in patient-handling techniques, decreasing low back pain prevalence and injuries related to patient handling; absenteeism seemed to show a decreasing trend."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The multidisciplinary approach was useful in the overall management of low back pain in health care workers performing patient handling."
        }
      ]},
