      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To investigate if the use of a new double lumen i.v. set (DLIS) decreases the incidence of propofol injection pain compared with single lumen i.v. set (SLIS) administration."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomized, double-blinded study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Operating rooms in a university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "50 adult ASA physical status I and II patients of both genders undergoing general anesthesia for elective surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients were injected with propofol either through a DLIS or a SLIS."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Three different pain indices were recorded to be present or absent: (1) verbal report of pain during propofol injection (2) grimacing during propofol injection, and (3) recall of injection pain in the recovery room. When the DLIS was used, the incidence of verbal pain, grimacing during propofol injection, and recall of pain during recovery were lowered significantly by 53%, 46%, and 52%, respectively (chi square analysis of contingency table with Yates correction, p < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The DLIS significantly reduced the incidence of propofol injection pain compared with SLIS. Further studies are indicated to evaluate the cost-effectiveness of this device."
        }
      ]},
