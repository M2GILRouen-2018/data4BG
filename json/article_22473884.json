      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine if the interaction of waist circumference percentile and waist to height ratio(WHtR) with body mass index (BMI) may serve to provide further risk specification in the lipid and blood pressure assessment of adolescents beyond BMI classification."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Population-based, cross-sectional study. Data collected during the 2009-2010 academic school year."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Geographically and administratively defined Niagara Region, Ontario, Canada. Data collected in school, during subjects\u2019 mandatory physical education class. Part of the Heart Niagara Inc Healthy Heart Schools\u2019 Program."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Entire population of grade 9 (14- and 15-year-old) students in the Niagara Region, Ontario.Four thousand eight hundred eighty-four students enrolled in grade 9 during the study period, of which 4104 participated (51% male) and 3248 (79%) had complete data."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Nonfasting lipid values and blood pressure categories in subjects categorized based on BMI/waist circumference percentile and BMI/WHtR."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The associations between blood pressure, lipid profile, and measures of adiposity (BMI alone, BMI/waist circumference percentile, and BMI/WHtR) were statistically significant but had a limited strength and were not statistically significant from each other. For overweight and obese subjects, increased WHtR categories were associated with worsened lipid profile and increased odds of hypertension both relative to subjects with both normal BMI and normal WHtR and subjects with normal WHtR within each BMI category."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Waist measures should be included in the screening and assessment of overweight and obese adolescents."
        }
      ]},
