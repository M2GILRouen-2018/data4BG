      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Because optical coherence tomography (OCT) requires balloon-occlusion to overcome image attenuation by blood, the present study investigated the safety and usefulness of a new non-occlusive technique."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "METHODS AND RESULTS",
          "content": "The 40 angina patients were assigned to the continuous-flushing method or the balloon-occlusion method group. The continuous-flushing method was superior for observing proximal lesions compared with the balloon-occlusion method (94% vs 55%, p=0.01). There were no differences between groups in the visible length and image quality. There were no major complications during OCT."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The continuous-flushing method is safe and useful for OCT."
        }
      ]},
