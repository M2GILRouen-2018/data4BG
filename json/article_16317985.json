      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the relative association of abdominal visceral adipose tissue (VAT) with cardiometabolic risk factors between African and European Americans."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "We conducted a cross-sectional study of 2035 African Americans from Jackson Heart Study (JHS) and 3170 European Americans from Framingham Heart Study (FHS) who underwent computed tomography assessment of VAT and subcutaneous adipose tissue (SAT). The FHS participants were weighted to match the age distribution of the JHS participants and the metabolic risk factors were examined by study groups in relation to VAT."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "JHS participants had higher rates of obesity, hypertension, diabetes and metabolic syndrome than FHS participants (all p = 0.001). The associations were weaker in JHS women for VAT with blood pressure, triglycerides, HDL-C, and total cholesterol (pinteraction = 0.03 to 0.001) than FHS women. In contrast, JHS men had stronger associations for VAT with high triglycerides, low HDL, and metabolic syndrome (all pinteraction = 0.001) compared to FHS men. Similar associations and gender patterns existed for SAT with most metabolic risk factors."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The relative association between VAT and cardiometabolic risk factors is weaker in JHS women compared to FHS women, whereas stronger association with triglycerides and HDL were observed in JHS men."
          }
        ]
      },
