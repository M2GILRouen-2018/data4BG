      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Little is known about whether secondhand smoke (SHS)-related diseases of young children, such as asthma, induce parental smoking cessation during the early child-rearing period. Our objective was therefore to show the association in addition to other potential determinants of parental cessation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We analyzed data from the Longitudinal Survey of Newborns in the 21st Century in Japan, from 0.5years (N=47,015) to 4.5years (N=39,817), having selected participants whose parents smoked at baseline (maternal smoking N=8,037; paternal smoking N=28,486). Multivariable log-binomial regression models were used to calculate the prevalence ratios for parental smoking cessation according to the onset of SHS-related diseases of their children, using inverse probability weight to account for non-response at follow-up."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 16.7% of smoking mothers and 14.5% of smoking fathers had stopped smoking at follow-up. The onset of SHS-related children's diseases was not statistically significantly associated with either maternal or paternal smoking cessation after multivariable adjustments. Strong determinants were, for example, number of cigarettes smoked per day and partner's smoking status during follow-up."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "SHS-related children's diseases were not associated with parental smoking cessation. It may therefore be necessary to provide additional support for parental smoking cessation within their child's medical care setting."
          }
        ]
      },
