      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To determine the safety of laparoscopic tubal sterilization in women who have had two or more cesarean sections."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective study (Canadian Task Force classification III)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Private clinic and hospitals."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Two hundred ten consecutive women."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Laparoscopic tubal sterilization."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "The procedures were done with no difficulty in all but two women. In addition to the two failures, one woman experienced bladder trauma."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Laparoscopic sterilization after several cesarean sections is possible and is associated with low morbidity. Scarring from cesarean sections should not be a contraindication if extra care is taken."
        }
      ]},
