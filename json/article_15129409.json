      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To study what effects a high-power, pain-threshold, static ultrasound technique applied to acute myofascial trigger points of the upper trapezius has on pain and on active cervical lateral bending."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Double-blind randomized trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Physical therapy unit of a private general hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Seventy-two adults with acute pain on 1 side of the neck, admitted to the outpatient unit during 1999 and 2000."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Not applicable."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Visual analog scale and goniometric measurement of active lateral bending of the neck performed daily after treatment sessions and length of treatment (number of therapy sessions)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "High-power ultrasound applied to the trigger points before stretching the muscle was more effective (P<.05) than conventional ultrasound, and it also significantly (P<.001) decreased the length of therapy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "High-power, pain-threshold, static ultrasound technique may be considered in the treatment of patients with acute myofascial pain syndrome, with the understanding that this technique demands more concentration and communication between the patient and the therapist."
        }
      ]},
