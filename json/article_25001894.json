      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Painful mucositis is one of the most distressing toxicities of chemoradiotherapy (CRT) for head and neck cancer (HNC), with the characteristics of incidental predictable breakthrough pain (BTP) during swallowing. Fentanyl pectin nasal spray (FPNS) could be a good therapeutic option."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Patients were prospectively considered if receiving basal analgesic therapy with opiates for painful mucositis of grade ⩾4 on a numerical rating scale from 0 to 10. They were offered FPNS 100mcg before oral intake. When patients reached the effective dose, they evaluated the basal pain intensity before FPNS use and after 10, 20, 30 and 40min."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Seventeen HNC patients were offered FPNS before oral intake, with 15 patients completing treatment. Mean reduction of incidental BTP intensity after FPNS was 3.1 points (range 1.2-5.8). Mean time elapsed since FPNS use and highest pain reduction was 26min."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "FPNS demonstrated activity against BTP when swallowing in HNC patients. These data should be considered as hypothesis-generating."
          }
        ]
      },
