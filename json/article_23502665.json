      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To identify the risk factors for scholastic backwardness in children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Children in the 6-12 year age group attending regular schools and referred to the child guidance clinic for scholastic backwardness."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary care hospital in South India."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Participants were compared with an age-and sex- matched group of children with good academic performance, to ascertain risk factors for scholastic backwardness."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were 75 boys and 35 girls in the study group. Among them 30 (27%) children had mental retardation, 39 (36%) had borderline intelligence and 12 (11%) had microcephaly. Undernutrition was noted in 36 (33%) children and 31 (28%) had stunted growth. 28 (26%) children had a history of chronic medical problems like epilepsy, bronchial asthma and congenital heart diseases. Visual, hearing and speech defects were present in 6 (6%), 5 (5%) and 12 (11%) children, respectively. Statistically significant differences were noted in the educational level and employment status of parents of children with scholastic backwardness and those with good academic performance."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Social and family factors have a significant influence on the academic functioning of children."
        }
      ]},
