      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Topical treatment with tacrolimus may be complicated by ingestion-related flushing caused by consuming small amounts of alcohol, a reaction that can be mistaken for food allergy."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To increase awareness of a drug interaction with alcohol that can mimic food allergy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We describe 3 patients who used topical tacrolimus, 2 with an atopic history and 1 without, who presented with a flushing reaction after ingesting alcohol."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Cessation of topical tacrolimus use resolves the alcohol-related skin reaction."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A careful history, including consideration of alcohol use, should be obtained in patients who use topical tacrolimus and present with new skin complaints, because these factors may be evidence of an avoidable drug interaction and not worsening of atopic disease or a food allergy."
        }
      ]},
