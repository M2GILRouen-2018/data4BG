      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The purpose of this study was to determine the prevalence of carotid artery calcifications (CAC) detected on panoramic radiographs in patients with metabolic syndrome (MetS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Eighty-five Thai subjects (29 men, 56 women) who had MetS according to the International Diabetes Federation definition were evaluated for CAC detected on panoramic radiographs. The confirmation of findings was done by ultrasonography."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Carotid artery calcifications were detected in 19 subjects (22.4%) with a mean age of 64 years, range 48-74 years. These subjects included 12 men and 7 women. The CAC were significantly more common in men than in women (P = .002). There were 8 subjects (9.4%) with bilateral calcifications and 11 subjects (12.9%) with unilateral calcification. No significant difference between the right and left sides was found (P = .44)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Thai people with MetS have high prevalence of radiographically detectable carotid artery calcifications."
        }
      ]},
