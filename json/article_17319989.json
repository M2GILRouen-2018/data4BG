      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the clinical presentation and outcomes of treatment for patients with chondrosarcomas involving the skull base and temporal bone."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Retrospective review."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary medical centre."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Cases of histologically confirmed chondrosarcoma involving the skull base and temporal bones."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Demographic features of presenting patients; presenting symptoms and signs; surgical approach employed; use of post-operative radiation therapy; histological grade of tumour; and interval of post-operative follow up."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Twelve patients were identified with chondrosarcomas involving the skull base, with post-operative follow up ranging from three to 33 years. The average age at presentation was 42 years. The most common presenting symptoms were diplopia, decreased visual acuity and headaches. Five of the 12 patients required multiple surgical procedures."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Patients with chondrosarcoma involving the skull base and temporal bone may present in a variety of ways. Surgical resection, even subtotal, in combination with radiation therapy, can often provide good tumour control over many years for these rare tumours."
        }
      ]},
