      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To evaluate the effectiveness and acceptability of a lidocaine spray in reducing perineal pain during spontaneous vaginal delivery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomised controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Consultant led obstetric unit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "185 women who had a spontaneous vaginal delivery without epidural analgesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Topically applied local anaesthetic spray (93 women) and placebo spray (92 women)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Primary outcome measure was pain during delivery (0-100 scale). The 16 secondary outcome measures included second degree perineal trauma during delivery, trauma of the genital tract, and dyspareunia by two months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Lidocaine spray did not reduce pain during spontaneous vaginal delivery: mean 77 and 72 on a scale of 0-100 in the lidocaine and placebo groups, respectively (difference between means 4.8, 95% confidence interval -1.7 to 11.2). Lidocaine spray may reduce genital tract trauma during delivery, in particular second degree perineal trauma. The intervention was highly acceptable to the women and midwives."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Although lidocaine spray applied to the perineum during spontaneous vaginal delivery did not reduce perineal pain, it was acceptable to both the women and the midwives."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "TRIAL REGISTRATION",
          "content": "Current controlled trials ISRCTN99732966 [controlled-trials.com]."
        }
      ]},
