      "Abstract": {
        "CopyrightInformation": "© 2016, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To describe the first-in-man experience with the ClearLumen Thrombectomy System (Walk Vascular, Irvine, CA) and report on its safety, feasibility and efficacy when used as an adjunctive therapy during primary PCI."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Thrombus aspiration (TA) aims to improve microvascular perfusion but currently available devices are not optimal."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Prospective, single-centre, non-randomized, safety, and efficacy trial. Patients with acute STEMI were enrolled and the investigational device was used for thrombus aspiration. Safety was evaluated as the overall rate of device related complications while efficacy as the rate of successful device deployment and culprit vessel reperfusion. The composite endpoint based on the achievement of at least two of the following three criteria-TIMI flow 3 and/or myocardial blush grade ≥2 at completion of the case and ST-resolution >70% at 90 minutes after vessel reperfusion-was also evaluated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Over a 3 months period 20 patients were enrolled in the study. Culprit lesion was successfully reached with the investigational device in 19 patients (95%). The pre-specified combined endpoint was met in 16 out of 19 patients (84.2%). Three patients not meeting the combined end point had procedure related, non TA associated, adverse event. Only 2 minor procedural adverse event occurred after thrombus aspiration."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This first-in-man experience with the ClearLumen Thrombectomy System demonstrates initial promising results on safety and efficacy when used as an adjunctive therapy during primary PCI."
          }
        ]
      },
