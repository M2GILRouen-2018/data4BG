      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "This survey focussed on chronic postoperative pain and impairment of quality of life after living donor nephrectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Out of a total of 82 donors 58 (71%) were examined using the Chronic Pain Grade (CPG) by von Korff and Short-Form 12 (SF-12)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of the donors 34% suffered from chronic postoperative pain 22 months (range 9-57 months) after nephrectomy and in 55% of these cases the pain interfered with daily life activities. The quality of life was almost comparable with those of the average German population, but was reduced by chronic postoperative pain particularly with respect to the mental state."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Measures have to be taken to prevent chronic postoperative pain and donors should be encouraged to express their pain to ensure an adequate pain therapy."
        }
      ]},
