      "Abstract": {
        "CopyrightInformation": "© 2017 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "This study aims to assess the correlates of stigma toward mental illness among patients diagnosed with major depressive disorder (MDD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "One hundred and sixty one Jordanian outpatients suffering from MDD completed the study. Participants completed the demographic questionnaire, the Center for Epidemiological Studies for the intensity of depression, and the Devaluation-Discrimination Scale to assess stigma."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Participants reported a moderate level of perceived stigma toward mental illness. Age, perceived pain, the number of relapses, and severity of depressive symptoms were significantly correlated with stigma toward mental illness among the study sample. The severity of depressive symptoms was the strongest correlate of stigma toward mental illness."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Factors associated with stigma toward mental illness should be carefully considered when implementing anti-stigma programs for patients."
          }
        ]
      },
