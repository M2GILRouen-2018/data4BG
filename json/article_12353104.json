      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Evaluate the frequency of depression in women with endometriosis and actual symptom of pelvic pain to determine the necessity of psychological support."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 50 women aged 24 to 48 with endometriosis and referring pelvic pain. The prevalence of depression was evaluated by Beck's Depression Inventory adapted to the Brazilian population."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "It was found that 92% of the subjects presented depressive symptoms, being 56% from moderate to high levels. Although 66% of the women were using hormonal medication to treat endometriosis, there was no significant correlation between the presence of depression and the use of these medications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The results showed a high prevalence of depression symptoms in these patients confirming the necessity of psychological support."
        }
      ]},
