      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Labor pain is the most painful experience in a mother's life. Acupuncture has been reported to be useful for pain relief during labor."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The study was designed to assess the effects of noninvasive electroacupuncture at Hegu (LI4) on labor pain and on adrenocorticotropic hormone (ACTH) and cortisol levels."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "The study was randomized, with an experimental acupuncture group (AG) and a control group (CG)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The study was conducted at the Kayseri Maternity Hospital in Turkey, over a period of 6 months in 2010."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Participants were women in the active phase of labor."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "For the acupuncture group (AG), bilateral, Hegu acupuncture points were stimulated using a transcutaneous electrical nerve stimulation (TENS) acupuncture pen for 20 min in total. The control group did not receive acupuncture. All women received routine and standard nursing care and treatments."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PRIMARY OUTCOME MEASURES",
          "content": "Blood ACTH and cortisol levels and visual analogue scale (VAS) scores were compared between the AG and CG to evaluate the efficacy of acupuncture treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Blood ACTH and cortisol levels and VAS scores were lower in the AG than in the CG; however, these differences did not reach a statistically significant level."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In this study, blood ACTH and cortisol levels and VAS scores were affected by electroacupuncture intervention on Hegu (LI4), although the result was not statistically significant."
        }
      ]},
