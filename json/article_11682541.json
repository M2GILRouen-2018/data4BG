      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To detect Mycobacterium tuberculosis DNA and rifampicin resistance in vertebral bone tissue specimens from spondylitis TB suspects."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "METHODS AND RESULTS",
          "content": "The rapid GeneXpert MTB/RIF and MGIT 960 liquid culture methods have been used in the specimens. Results from 70 suspects with spondylitis TB shown that 31.42% identified positive for spondylitis TB using culture method, while 88.57% shown positive results using rapid GeneXpert MTB/RIF method. The validity of GeneXpert MTB/RIF shown sensitivity value of 100%, specificity value of 16.6%, PPV of 35.48%, and NPV of 100%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "GeneXpert has a high sensitivity but low specificity value in this study."
        }
      ]},
