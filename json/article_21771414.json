      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Hainan Medical College. Published by Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate effects of ethanol extract of Abrus precatorius leaves (EAPL) on egg albumin induced mast cell degranulation in mice and passive cutaneous anaphylaxis in rats."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In present study ethanol extract of Abrus precatorius leaves (EAPL) at doses of 100, 125, 150 mg/kg i.p were evaluated for preliminary phytochemical screening, acute toxicity studies and egg albumin induced mast cell degranulation in mice and passive cutaneous anaphylaxis in rats."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The results of present investigation showed that the LD(50) of EAPL is more than 1\u2009300 mg/kg. EAPL (100-150 mg/kg, i.p.) significantly protect egg albumin induced degranulation of mast cell and inhibit area of leakage of dye in passive cutaneous anaphylaxis. Phytochemical studies observed presence of saponin, alkaloids, flavonoids, and glycosides."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In conclusion EAPL possesses anti asthmatic potential."
          }
        ]
      },
