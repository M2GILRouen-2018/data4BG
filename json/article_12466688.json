      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine the effect of the application of tape over the patella on the onset of electromyographic (EMG) activity of vastus medialis obliquus (VMO) relative to vastus lateralis (VL) in participants with and without patellofemoral pain syndrome (PFPS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomised within subject."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTINGS",
          "content": "University laboratory."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Ten participants with PFPS and 12 asymptomatic controls."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Three experimental taping conditions: no tape, therapeutic tape, and placebo tape."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Electromyographic onset of VMO and VL assessed during the concentric and eccentric phases of a stair stepping task."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "When participants with PFPS completed the stair stepping task, the application of therapeutic patellar tape was found to alter the temporal characteristics of VMO and VL activation, whereas placebo tape had no effect. In contrast, there was no change in the EMG onset of VMO and VL with the application of placebo or therapeutic tape to the knee in the asymptomatic participants."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "These data support the use of patellar taping as an adjunct to rehabilitation in people with PFPS."
        }
      ]},
