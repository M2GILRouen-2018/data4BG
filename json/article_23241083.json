      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the prevalence of zygapophysial joint pain in patients after disc surgery, and to determine the effectiveness of radiofrequency neurotomy for its treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective practice audit."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Review of charts of all patients who underwent lumbar disc surgery during a time period of 2 years."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients with persistent back pain after surgery were tested with repeated medial branch blocks. Those patients who consistently report at least 80% pain relief underwent radiofrequency neurotomy. A successful outcome was defined as at least 50% pain reduction enduring for 6 months."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In a population of 479 patients who underwent microsurgical lumbar disc operations, persistent axial back pain occurred in 120, of whom 34 had positive responses to diagnostic blocks and were treated with radiofrequency neurotomy. Twenty patients (58.8%) achieved at least 50% reduction in pain for a minimum of 6 months."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The prevalence of zygapophysial joint pain appears to be 7% in patients with failed back surgery syndrome. Patients with this condition can be treated with a radiofrequency neurotomy with a success rate of 58.8%."
          }
        ]
      },
