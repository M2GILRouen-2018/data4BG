      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Ultrasound (US) therapy improves symptoms in carpal tunnel syndrome (CTS) patients. Extracorporeal shock wave therapy (ESWT) uses acoustic energy to determine its clinical effects, as US-therapy does."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "The aim of this study was to compare the short-term efficacy of US and ESWT on mild and moderate CTS."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University outpatient service."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "POPULATION",
          "content": "Twenty-five patients with mild to moderate CTS, for a total of 42 wrists."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "patients were randomized to receive US, cryo-US or ESWT, and were evaluated for pain and function before treatment started, at the end of treatment, and four and 12 weeks after the end of the treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Significant improvement was noted in all groups for pain (P<0.05) and functionality (P<0.05). Patients in ESWT group show greater pain improvement at 12-weeks follow-up when compared with both US and cryo-US groups (P<0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Patients affected by CTS might benefit from the application of US, cryo-US or ESWT. Benefits persist 3 months after the end of treatment."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "CLINICAL REHABIL IMPACT",
          "content": "Clinicians might consider the possibility of a short-term non-surgical management for mild-to-moderate CTS."
        }
      ]},
