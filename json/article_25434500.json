      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To evaluate the efficacy and safety profile of paracetamol in comparison with tramadol for pain relief during active labor."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, randomized, double-blind study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Maternity Wing of the Postgraduate Institute of Medical Education and Research, Chandigarh."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT",
            "content": "Sixty laboring, primiparous, full-term parturients with uncomplicated, singleton pregnancy in spontaneous labor and cervical dilatation of 3-5 cm."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Parturients were randomized into 2 groups to receive either 1 mg/kg of tramadol intramuscularly (group T; n = 29) or 1 g of paracetamol intravenously (group P; n = 30). Same doses of the drugs were repeated after 4 hours of initial dose."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENT",
            "content": "Primary outcome of the study was to assess the analgesic efficacy of the 2 drugs as measured by visual analog scale (VAS) score. Secondary outcome recorded was duration of labor, presence of any maternal, or fetal adverse events during the study."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Both the groups showed comparable VAS scores at all times of observation. Lower mean VAS scores were reported in both the groups till 120 minutes only. The duration of first stage of labor was shorter in group P (248.00 ± 98.171 vs 340.63 ± 111.592 minutes; P = .003). The duration of second stage of labor was comparable between the 2 groups. Higher incidence of maternal side effects such as nausea/vomiting and sedation was associated with the use of tramadol. Neonatal outcome was comparable."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Intravenous paracetamol provides comparable analgesia as intramuscular tramadol during active labor."
          }
        ]
      },
