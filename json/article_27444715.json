      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Clinical practice guidelines."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To develop the first Canadian clinical practice guidelines for treatment of neuropathic pain in people with spinal cord injury (SCI)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The guidelines are relevant for inpatient and outpatient SCI rehabilitation settings in Canada."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The CanPainSCI Working Group reviewed the evidence for different treatment options and achieved consensus. The Working Group then developed clinical considerations for each recommendation. Recommendations for research are also included."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Twelve recommendations were developed for the management of neuropathic pain after SCI. The recommendations address both pharmacologic and nonpharmacologic treatment modalities."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "An expert Working Group developed recommendations for the treatment of neuropathic pain after SCI that should be used to inform practice."
        }
      ]},
