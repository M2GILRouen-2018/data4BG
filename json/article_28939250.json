      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Patients with radiographically-identified traumatic brain injury are often transferred to our regional trauma center for neurosurgical evaluation, yet few injuries require neurosurgical intervention. Transfer is costly, inconvenient, and potentially risky in inclement weather. We propose that previously-published brain injury guidelines (BIG)1 can help to determine which patients could avoid mandatory transfer."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Retrospective chart review of patients transferred between January 2012 and December 2013 was performed. Patients were classified as having minor (BIG 1), moderate (BIG 2), or severe (BIG 3) head injuries based on previously-published guidelines. Patient characteristics and outcomes were compared."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No BIG 1 patients deteriorated or required surgical intervention. One BIG 2 patient required a non-emergent operation and another was readmitted with a worsened injury. In the BIG 3 group, 11.9% required neurosurgical procedures and 20% died."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The BIG classification can help stratify patients for whom transfer is considered."
          }
        ]
      },
