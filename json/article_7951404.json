      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the efficacy of nafarelin acetate with danazol in the treatment of dysmenorrhea, dyspareunia, and pelvic pain associated with endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomized double-blind controlled study. PATIENTS, SETTING, TREATMENTS: Two hundred thirteen patients aged 18 to 48 with laparoscopically confirmed pelvic endometriosis and dysmenorrhea, dyspareunia or pelvic pain were randomly assigned to 6 months of treatment with either nafarelin acetate 800 micrograms per day or 400 micrograms per day, or danazol 800 micrograms per day."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The percentage of patients with dysmenorrhea, dyspareunia or pelvic pain before treatment who still had these symptoms after 6 months of treatment and 6 months following completion of treatment. RESULTS [table: see text]"
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Nafarelin acetate and danazol both provided significant relief of dysmenorrhea, dyspareunia, and pelvic pain during treatment and for 6 months following treatment in women with endometriosis."
        }
      ]},
