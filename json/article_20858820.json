      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This article reviews the predisposing conditions, diagnostic criteria, CT appearances, and potential complications of coronary artery aneurysms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "With the increasing use of MDCT to image the coronary arteries, aneurysms will be identified more frequently. Coronary artery aneurysms arise from a variety of causes, with CT appearance, management, and clinical course depending on the cause."
        }
      ]},
