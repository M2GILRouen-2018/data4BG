      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate prevalence and diagnostic accuracy of myocardial hypoenhancement (MH) using multidetector computed tomography (MDCT) in patients admitted for acute chest pain syndromes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Sixty-nine patients underwent first-pass MDCT, coronary angiography, and echocardiography. Using a standardized analysis protocol, left ventricular short-axis reformations were evaluated for presence, size, and density of MH in 16 myocardial segments. These were correlated with the presence and location of myocardial infarction (MI), regional myocardial dysfunction, and coronary artery disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Myocardial hypoenhancement was found in acute MI (27/35), healed MI (6/14), unstable angina (3/9), and atypical chest pain (0/11). Sensitivity, specificity, and positive and negative predictive values of MH for diagnosing any MI were 67%, 85%, 92% and 52%, respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The presence of MH on MDCT in acute chest pain patients has high positive predictive value and specificity but only moderate sensitivity for presence of acute or healed MI using the strict criteria proposed in this study."
        }
      ]},
