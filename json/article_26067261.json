      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report a case of pancreatic adenocarcinoma complicating pregnancy with a review of literature."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A literature search of all English articles on pancreatic adenocarcinoma in pregnancy till December 2014."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A 35-year-old patient presented at 22 weeks of gestation for back pain and weight loss. Subsequent she was confirmed to have metastatic pancreatic adenocarcinoma. There were in total eleven case reports identified. Abdominal pain and back pain were the presenting symptoms in 75% and 33.3% of patients respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Pancreatic adecnocarcinoma is a rare cancer in pregnancy. A high index of suspicion is required in case of atypical symptoms."
        }
      ]},
