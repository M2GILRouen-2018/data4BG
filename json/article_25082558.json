      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 John Wiley & Sons, Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This study aimed to evaluate the associations between depression, sense of control, and cognitive functioning, as well as the predictive power of sense of control and cognitive functioning in older cancer patients' depression."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Eighty-six cancer patients were referred to a palliative care unit. They completed the 15-item Geriatric Depression Scale, the Cancer Locus of Control, and the Mini Mental State Examination questionnaires."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Higher perceived control over the 'course of illness' was associated with higher levels of depressive symptoms (p\u2009<\u20090.0005), whereas lower perceived control over the 'cause of illness' was associated with higher depressive symptoms. The same results were found for 'cause of illness' between non-depressed and depressed patients (p\u2009=\u20090.001). Multivariate analysis revealed that whereas an external orientation in 'course of illness' increased the likelihood of depression (p\u2009=\u20090.002), an external orientation in 'cause of illness' decreased the likelihood of depression (p\u2009=\u20090.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Older cancer patients' sense of control orientation over the course of illness and the cause of illness predicted the levels of depressive symptomatology."
          }
        ]
      },
