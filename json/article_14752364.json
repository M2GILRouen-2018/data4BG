      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Retrospective case report."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "Long-term follow-up."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A 44-year follow-up after surgery at the age of 1 year for congenital scoliosis with original and current information."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND INFORMATION",
          "content": "This long a follow-up after so young a fusion has not previously been reported. Shorter follow-ups have not revealed the problems this patient has had subsequently."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Low back pain began 22 years after surgery (age 23 years) and cervical pain began 24 years after surgery (age 25 years). Anterior cervical discectomy and fusion plus posterior fusion of two disc levels were necessary at the age of 36 years. Continued low back pain resulting from multilevel degeneration causes major disability."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This patient had an excellent result from his posterior spine fusion at the age of 1 year, with no loss of curve correction, no \"crankshafting,\" and minimal loss of vital capacity. Long-term follow-up did indicate major disabilities resulting from both cervical and lumbar degenerative disc disease."
        }
      ]},
