      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine if pretonsillectomy injection of local anesthetics with and without clonidine reduces pain following tonsillectomy in children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective, randomized, double-blind, placebo-controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary care academic medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "A total of 120 children, ages 3 to 17 years, presenting for tonsillectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients were randomized to 1 of 3 pretonsillectomy injection groups: (1) saline, (2) lidocaine plus bupivacaine, or (3) lidocaine plus bupivacaine plus clonidine."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The total number of analgesic doses consumed on postoperative days (PODs) 1, 3, 5, and 7. Secondary outcome variables included total time and intravenous analgesic doses required in the recovery room, visual analog scale pain scores, and maximum tolerated diet on postoperative days 1, 3, 5, and 7."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The total number of analgesic doses on PODs 1, 3, 5, and 7 were not significantly different between the randomization groups (P = .53). The median numbers (interquartile ranges) of analgesic doses were 12.0 (9.0-16.8) for the lidocaine plus bupivacaine plus clonidine group, 12.0 (10.0-16.5) for the lidocaine plus bupivacaine group, and 14.0 (9.0-15) for the placebo group. The placebo group was found to have a more advanced diet on POD 1 (P = .04) and significantly less pain on POD 3 (P = .02). Multivariable analysis showed children in the lidocaine plus bupivacaine plus clonidine group were significantly less likely to need intravenous pain medication in the recovery room compared with children in the placebo group and again showed that the placebo group achieved a significantly more advanced diet and had less pain on PODs 1 and 3."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Pretonsillectomy injection of lidocaine, 1%, and bupivacaine, 0.5%, with or without clonidine (25 μg) is not recommended for the reduction of posttonsillectomy pain."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "TRIAL REGISTRATION",
          "content": "clinicaltrials.gov Identifier: NCT00678379."
        }
      ]},
