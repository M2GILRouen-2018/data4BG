      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "We wanted to examine the factors that were of importance for the hospital outpatient treatment of teenagers with asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "A total of 89 teenagers received a postal questionnaire and an invitation to participate in a focus group interview on outpatient asthma follow-up."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Only 16 answered the questionnaire and 7 participated in the interview. The importance of personal contact was stressed and the teenagers expected much from the personnel aiming to help them. In a questionnaire follow-up of initial non-responders, 82% still had asthma and 75% of these received asthma medication."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "The low participation rate and the high expectations explain why teenagers with asthma constitute a group of patients with less than optimal results of treatment."
        }
      ]},
