      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report the finding of red and brownish precipitates with morphology and chemistry compatible with uric acid crystals in semen in a patient with symptoms of chronic prostatitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Academic clinical biochemistry and immunology laboratory."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 35-year-old man with clinical symptoms of prostatitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Uric acid crystals were detected in the semen samples. Treatment with a low purine diet relieved the symptoms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Study of chemical and morphological characteristics of crystals found in the semen using standard semen analysis and transrectal ultrasound. Analysis of serum, urine, and seminal plasma uric acid levels."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Uric acid crystals were detected in semen. A transrectal ultrasound revealed the presence of microcalcifications in the prostate gland. After treatment with a low purine diet, the patient experienced considerable relief of the clinical symptoms. Determination of uric acid and creatinine levels in serum and seminal plasma were carried out before and after treatment. There were no abnormalities or presence of crystals in the post-treatment semen analysis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "The presence of uric acid crystals in semen of a patient with symptoms of chronic prostatitis can be attributed to the pelvic pain."
        }
      ]},
