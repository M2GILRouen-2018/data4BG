      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Loco-Regional Anaesthesia (LRA) is considered a valid anaesthesiological option in both operative and post-operative time because more safety than General Anaesthesia (GA), reducing perioperative side effects often linked to unsatisfactory analgesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "We studied 72 pts who underwent abdominal surgery, randomized into two group of 36 subjects. Group 1 received GA and Group 2 received LRA, by peridural technique, and in both group the post-operative analgesia was carried out by a 24 hours elastomer. For pain examination a NRS numeric scale was used."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RESULTS AND CONCLUSION",
          "content": "The score of NRS scale was significantly lower in the LRA group than in GA group, thus confirming the LRA safety and effectiveness in reducing pain."
        }
      ]},
