      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Successes of the professional athlete as individuals and team, across codes of football are contingent upon performance measures. The aim of the study was to examine associations between comfort and performance."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective measures of lower limb comfort and coach rating performance criterion. Comfort and performance associations were described using Pearson's correlation coefficient (r) or the R square value from the regression estimate."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Two professional football codes in Australia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "79 professional footballers were followed for one football season, a total of 1724 player weeks."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Study hypothesis was poor lower limb comfort is negatively correlated with good match day rated performance. Aspects of validity and responsiveness to change tested the hypothesis that lower limb comfort, affects rated performance. A validated lower limb comfort index (LLCI) was used to test comfort. Rated performance was evaluated by subjective rating criterion of experienced team coaches."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Poor lower limb comfort and good match day ratings were not well correlated (R(2) = 0.25, P ≤ 0.001) and usual-high comfort was correlated with usual-good performance (R(2) = 0.69, P ≤ 0.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Lower limb comfort may be a sensitive measure of rated performance in football. The LLCI is the first measurement tool to show association between comfort and rated performance."
          }
        ]
      },
