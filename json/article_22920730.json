      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 SIR. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "Percutaneous cementoplasty has proved very effective for the palliation of pain from bone metastases. However, several studies argue that it should be contraindicated for metastases that are located in the proximal femur because of inadequate bone consolidation. The aim of this study was to evaluate the risk factors for fracture despite performing cementoplasty for metastases of the proximal femur."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We retrospectively analyzed all consecutive patients who underwent cementoplasty for metastases of the proximal femur who had a high risk for fracture (N = 21) from June 2003 to October 2010. Cementoplasty was performed for preventive consolidation as well as for pain palliation in 16 patients. The risk factors studied were the patient characteristics, the Mirels score, the maximal size and cortical involvement of the lesion, and a history of a previous fracture of the lesser trochanter."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The 1-year pathologic fracture rate was 40.6% (seven fractures). The risk of fracture was significantly higher for cortical involvement greater than 30 mm (n = 7/11 vs n = 0/10; P = .0005) and a history of a previous fracture of the lesser trochanter (n = 3/3 vs 4/18; P = .0009)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Percutaneous cementoplasty can be considered for patients with metastases of the proximal femur under certain conditions: cortical involvement less than 30 mm and no history of a fracture of the lesser trochanter. Otherwise, the risk of fracture is too high, and cementoplasty is contraindicated."
          }
        ]
      },
