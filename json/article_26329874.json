      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To report the effect of the transcranial direct current stimulation (tDCS) applied over the primary motor cortex (M1) of an individual, a sedentary male subject with complete chronic spinal cord injury at the T11-T12 levels."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The individual underwent three experimental sessions: control, sham and anodal tDCS. Before, during and after exercise sessions, the following variables were recorded: heart rate variability, Rating of Perceived Exertion (RPE), power and glucose (this one only before and after the exercise)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The anodal tDCS provided greater exercise time and power, lower perceived exertion, greater reduction in glucose, and an increase in time to reach the threshold of heart rate variability."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "tDCS caused an improvement in the exercise tolerance, probably due to the modulation of the autonomic nervous system and the pain, characterized by reduced RPE."
          }
        ]
      },
