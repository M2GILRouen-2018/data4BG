      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "While patients with coronary artery disease (CAD) and cerebrovascular disease share similar risk factor profiles, data on whether IS can be considered a \"CAD equivalent\" are limited. We aimed to determine whether ischemic stroke is an independent predictor of CAD by using cardiac computed tomography angiography (CTA)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We analyzed the CTA in 392 patients with no history of CAD (24 patients with acute IS and 368 patients with acute chest pain). Extent of plaque burden was additionally dichotomized into 0-4 versus >4 segments."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patients with IS had a near 5-fold increase odds of having coronary artery plaque (odds ratio [OR] 4.9, P<0.01) as compared to those without IS. After adjustment for age, gender, and traditional cardiac risk factors, there remained a near 4-fold increase odds for coronary plaque (adjusted OR 3.7, P=0.04). When stratified by extent of plaque, patients with IS had over 18-fold increase odds of having >4 segments of plaque than 0-4 segments as compared to patients without stroke (OR 18.3, P<0.01), which remained significantly associated in adjusted analysis (adjusted OR 12.1, P<0.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Acute IS is independently associated with higher risk and greater extent of CAD compared to patients with acute chest pain at low-to-intermediate risk for acute coronary syndrome."
          }
        ]
      },
