      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "Coronary computed tomography angiography (CTA) has proven clinically useful for non-invasive assessment of coronary pathology. However, coronary calcium can reduce its diagnostic value. The objective of this study was to define a calcium score above which CTA appears less reliable."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "We prospectively investigated 109 patients referred for elective coronary angiography (CA). With a 64-slice CT-scanner, coronary calcium was determined and expressed in Agatston unit (AU). A significant coronary stenosis was defined as > or =50% luminal diameter reduction. Following blinded interpretation, diagnostic values of CTA at different levels of AU were calculated using quantitative CA as reference."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A strong association with stent and the severity of coronary calcium was observed. In patients without stents (n = 91) sensitivity, specificity and positive and negative predictive value for presence of significant stenosis were: 100%, 91%, 74%, and 100% in patients with a calcium score < or =400 AU versus 100%, 17%, 75%, and 100% in patients with a score >400 AU."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The diagnostic accuracy of CTA in patients with no or little coronary calcium is excellent. However, in patients with an Agatston score >400 specificity declines and therefore, these patients should not go on to CTA, but be referred to CA instead."
        }
      ]},
