      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Prior studies have demonstrated a decline in the predictive ability of conventional risk factors (RF) with advancing age, emphasizing the need for novel tools to improve risk stratification in the elderly. Coronary artery calcification (CAC) is a robust predictor of adverse cardiovascular events, but its long-term prognostic utility beyond RFs in elderly persons is unknown."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A consecutive series of 9715 individuals underwent CAC scoring and were followed for a mean of 14.6 ± 1.1 years. Multivariable Cox proportional hazards regression (HR) with 95% confidence intervals (95% CI) was employed to assess the independent relationship of CAC and RFs with all-cause death. The incremental value of CAC, stratified by age, was examined by using an area under the receiver operator characteristic curve (AUC) and category-free net reclassification improvement (NRI)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of the overall study sample, 728 (7.5%) adults (mean age 74.2 ± 4.2 years; 55.6% female) were 70 years or older, of which 157 (21.6%) died. The presence of any CAC was associated with a >4-fold (95% CI = 2.84-6.59) adjusted risk of death for those over the age of 70, which was higher compared with younger study counterparts, or other measured RFs. For individuals 70 years or older, the discriminatory ability of CAC improved upon that of RFs alone (C statistics 0.764 vs. 0.675, P < 0.001). CAC also enabled improved reclassification (category-free NRI = 84%, P < 0.001) when added to RFs."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "In a large-scale observational cohort registry, CAC improves prediction, discrimination, and reclassification of elderly individuals at risk for future death."
          }
        ]
      },
