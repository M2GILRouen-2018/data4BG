      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare the efficacy of percutaneous vertebroplasty (PV) with conservative therapy for patients with acute vertebral compression fractures."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, nonrandomized, comparison study."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The efficacy of PV has not been well established because there have been few comparative studies with conservatively treated control groups."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Fifty-five consecutive patients (8 men and 47 women, age 47-94) with osteoporosis and symptomatic acute vertebral compression fractures were enrolled. thirty-two patients received pv, whereas 23 received conservative therapy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Changes in pain intensity, physical functioning, and pain medication requirement were evaluated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Both PV and conservative therapy provided pain reduction (P < 0.001), improvements in physical functioning (P < 0.001), and decreased medication (P < 0.001). Reductions in visual analogue pain scores were more significant in the vertebroplasty group at 1 (P < 0.001) and 4 weeks (P < 0.001) but not at 12 months. Improvements in physical functioning were significant at 1 (P < 0.001) and 4 weeks (P < 0.001). Medication requirements were lower in the vertebroplasty group at all three time points."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Pain relief, physical functioning improvement, and medication requirement after vertebroplasty are immediately and significantly better when compared with conservative therapy."
          }
        ]
      },
