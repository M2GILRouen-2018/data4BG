      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To compare the effects of ropivacaine and saline on pain after laparoscopic excision of endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, double-blind, controlled trial (Canadian Task Force classification I)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Women's hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Ninety-three women undergoing excision of endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Laparoscopic excision of endometriosis, after which saline 100 mg (46 women) or ropivacaine 200 mg dissolved in 100 ml saline (47) was instilled intraperitoneally for postoperative analgesia."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "No differences were seen between groups during the first 7 hours after surgery with respect to pain scores, analgesic requirements, postoperative nausea and vomiting, or time to discharge."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "We found no difference between ropivacaine and saline, instilled intraperitoneally, in their effects on pain after extensive excision of endometriosis."
        }
      ]},
