      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the efficacy of a hysteroscopic local anesthetic intrauterine cornual block (ICOB) on pain experienced during office endometrial ablation (EA) in addition to a traditional direct local anesthetic cervical block (DCB)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, randomized, double-blind, placebo-controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University teaching hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Women with heavy menstrual bleeding scheduled for an office endometrial ablation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Before office EA, DCB plus hysteroscopic ICOB just medial to each tubal ostium using local anesthetic mixture made up of 1 mL 3% mepivacaine plus 1 mL 0.5% bupivacaine versus control group receiving DBC plus ICOB with 2 mL of placebo (saline)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PRIMARY OUTCOME",
            "content": "pain reported during procedure via visual analogue scale (VAS) from 0 to 10; secondary outcomes: postoperative pain, rescue analgesic requirement, and duration of hospital stay."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Most characteristics were similar across groups. The mean VAS score during the procedure was statistically significantly lower by 1.44 (95% confidence interval, -2.65 to -0.21) in the active group compared with the placebo group. There were no statistically significant differences between the two groups in the postprocedural mean VAS scores, rescue analgesic requirement, or duration of hospital stay."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Used in addition to DCB, ICOB reduces the pain experienced during office EA compared with DCB alone."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "CLINICAL TRIAL REGISTRATION NUMBER",
            "content": "NCT01808898."
          }
        ]
      },
