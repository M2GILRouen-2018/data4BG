      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "The present study was conducted to quantitate the oral health of coronary heart disease patients and compare them with controls for a valid inference"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "A total of 100 medically diagnosed coronary heart disease patients were compared with 100 controls using the World Health Organization (WHO) oral health assessment form. Statistical analysis was done using SPSS (version 10) software."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Statistically higher mean sextant value for shallow pockets 4-5 mm, CPI (Community Periodontal Index) score 3 and LOA (Loss of attachment) score 1,2 was found for cases as compared to controls (p≤0.05). Similarly, higher mean DMFT (Decayed-Missing-Filled Teeth) and missing teeth were observed for cases as compared to controls (p>0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The present study shows a slight increase in the level of mild periodontal disease in coronary heart disease patients as compared to controls, with a non-significant difference in dental caries."
        }
      ]},
