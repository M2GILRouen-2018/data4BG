      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To establish a new assay for platelet-activating factor (PAF), to compare it with bio-assay; and to discuss its significance in some elderly people diseases such as cerebral infarction and coronary heart disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "To measure PAF levels in 100 controls, 23 elderly patients with cerebral infarction and 65 cases with coronary heart disease by reversed phase high-performance liquid chromatographic technique (rHPLC)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "rHPLC is more convenient, sensitive, specific, and less confusing, compared with bio-assay. The level of plasma PAF in patients with cerebral infarction was higher than that in the controls (P<0.01), and in patients with coronary heart disease."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Detection of PAF with rHPLC is more reliable and more accurate. The new assay has important significance in PAF research."
        }
      ]},
