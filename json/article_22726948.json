      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Studies have shown that adherence to prehospital treatment guidelines, for patients with non-traumatic chest pain is incomplete and that there is a gender difference in treatment provided."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The aim of this study was to examine adherence to guidelines in a nurse-led ambulance system in southern Sweden."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Retrospective cohort study, including 862 medical records was reviewed. Data relevant to treatment guidelines was obtained e.g. the provision of oxygen, acetylsalicylic acid, glycerin trinitrate, electrocardiogram recorded, pain assessment, patient gender and time of day. Results were presented using descriptive statistics and adherence to present guidelines was described as poor (≤ 20%), fair (21-40%), moderate (41-60%), good (61-80%) and very good (81-100%)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The medical records included 401 women and 461 men. Twenty-three percent of the patients received ≥ 10L/min of oxygen (men vs. women, P<0.81). Sixty-nine percent received treatment with sublingual glyceryl trinitrate, whereas 58% received acetylsalicylic acid (men vs. women, P<0.004). In 95% a twelve lead electrocardiogram was recorded. Pain assessment was performed in 40% before treatment (men vs. women, P<0.011). A significant difference between men and women was found in Time of onset (P<0.013)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "We conclude that adherence to treatment guidelines varies greatly among the variables studied, ranging from fair (≥ 10L/min of oxygen) to very good (obtaining electrocardiogram). There were differences in treatment provided between women and men."
          }
        ]
      },
