      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This meta-analysis investigates the effect of aromatherapy massage on pain in primary dysmenorrhea."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Randomized controlled trials were searched by keywords in several databases (Pubmed, ISI Web of Sciences, and Google Scholar). Six randomized controlled trials that included 362 participants with primary dysmenorrhea, comparing abdominal aromatherapy massage (n = 184) with massage with placebo oils (n = 178), were analyzed in the meta-analysis. The change in the visual analogue scale (VAS) pain score from the first menstruation cycle to the second cycle at the first menstruation day was used as the primary outcome."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Aromatherapy massage with essential oils was superior to massage with placebo oils (standardized mean difference = -1.06 [95% CI: -1.55 to -0.55])."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Abdominal aromatherapy massage with essential oils is an effective complementary method to relieve pain in primary dysmenorrhea."
          }
        ]
      },
