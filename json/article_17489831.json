      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Newborn infants are routinely exposed to pain. We wanted to see how practice regarding pain relief changed over a 6-year period."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Serial audits were carried out of existing practice and attitudes at three points, over a 6-year span, in New Zealand neonatal units."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Almost all units agreed that many commonly performed procedures were painful over the 6-year study period. The number of units using analgesia rose markedly over the same period."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The fact that a simple, cheap and effective intervention (oral sucrose) has taken more than 6 years to be used routinely in New Zealand highlights the problem of turning evidence into practice."
        }
      ]},
