      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Disorders of the salivary glands can be evaluated by bedside ultrasonography and should be considered in patients presenting with undifferentiated neck swelling."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Our aim was to describe the sonographic findings present in sialolithiasis and sialadenitis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "A 61-year-old man presented to the emergency department with 2 days of neck swelling. Initial evaluation included a bedside ultrasound that demonstrated sialolithiasis, which was later confirmed by computed tomography."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Bedside ultrasound can be a useful imaging modality in the evaluation of the patient with neck swelling."
          }
        ]
      },
