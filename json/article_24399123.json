      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Recent advances in surgical and anesthesiology techniques allow simultaneous thoracic and abdominal operations to be performed for severe heart disease and benignant or malignant abdominal diseases."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "The simultaneous surgical management in a 75-year-old patient suffering from severe double coronary artery disease and a renal cell carcinoma with extended intravascular growth into the inferior vena cava is reported."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The postoperative course was uneventful. Simultaneous surgery proved to be beneficial and safe, showing optimal results in our patient."
        }
      ]},
