      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Vocal cord dysfunction (VCD) is an obstructive upper airway syndrome that frequently mimics asthma and for which there is no empirical treatment of choice."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe two military service members experiencing VCD who were treated with psychophysiologic self-regulation training."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Both cases were active-duty military members with VCD confirmed by laryngoscopy They each received biofeedback self-regulation training to decrease tension in the extrinsic laryngeal musculature."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Both patients responded to the treatment, denied the presence of dsypnea, and had resumed military physical training."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Psychophysiologic self-regulation strategies both with and without concurrent speech therapy positively impacted VCD symptoms."
        }
      ]},
