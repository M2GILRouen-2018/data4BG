      "Abstract": {
        "CopyrightInformation": "© International Headache Society 2014.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Migraine is a common disabling condition that affects approximately 15% of the population. Several genome-wide association studies have attempted to identify susceptibility variants involved in migraine, reporting several candidate loci for the disorder."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In order to replicate findings from previous genome-wide association studies, a case-control association study was performed. Twelve single nucleotide polymorphisms were genotyped in a Spanish sample of 512 migraine with aura patients and 535 migraine-free controls."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Nominal associations were found for single nucleotide polymorphisms rs2651899 (within the PRDM16 gene), rs10166942 (near TRPM8), rs12134493 (close to TSPAN2) and rs10504861 (near MMP16) in our migraine with aura sample."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our study provides suggestive replication, in a Spanish migraine with aura sample, of four genome-wide association study findings previously reported in common migraine. However, larger sample sets should be explored to confirm our results."
          }
        ]
      },
