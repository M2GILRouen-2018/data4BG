      "Abstract": {
        "CopyrightInformation": "© 2012 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The purpose of this study was to examine the relationship between perceived physical competence (PPC), actual motor competence (MC) and body mass index (BMI) in young children."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We assessed MC (Test of Gross Motor Development - 2nd Edition), PPC (Pictorial Scale of Perceived Competence and Social Acceptance) and BMI (CDC calculator) of 178 young children ages 4-7 years."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The linear regression model for the overall sample showed that BMI was a better predictor of PPC than MC. Also, obese children had lower PPC, but showed no differences in MC compared with leaner peers."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "PPC of young obese children was lower than their leaner counterparts, yet their MC was similar. That outcome draws attention to the importance of promoting positive PPC in young children."
          }
        ]
      },
