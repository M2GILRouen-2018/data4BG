      "Abstract": {
        "CopyrightInformation": "Crown Copyright © 2014. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Leisure-time physical activity (LTPA) plays a key role in chronic disease prevention and health promotion. The impact of life-changing events on LTPA among adults is unknown."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To examine the association between life-changing events and decreased LTPA levels."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Eight cycles of Canadian National Population Health Survey data were used for this study. A total of 12,901 respondents aged ≥18 years in 1994-1995 completed biannual follow-ups until 2008-2009. The association between life-changing events and decreased LTPA in any 2-year period was assessed with adjustment of potential confounding factors. Data were analyzed in 2012."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "From 1994-1995 to 2008-2009, nine of ten people changed their LTPA levels. Within each 2-year period, individuals were more likely to decrease their LTPA levels if they married within the 2-year period (men); became or remained overweight/obese (women); remained a regular smoker (men); became or remained unhealthy (men and women); developed or continued to have body pain (women); and acquired social support or remained without support (men)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Most people change their LTPA levels or patterns, which are significantly influenced by life-changing events. An improved understanding of factors that influence LTPA may help better target those at high risk."
          }
        ]
      },
