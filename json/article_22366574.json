      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine the friendships and social expectations of children with perinatally acquired HIV and compare them to children with moderate to severe persistent asthma and healthy children of HIV-positive mothers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "70 children (ages 8-14 years) were recruited from pediatric allergy and immunology multidisciplinary clinics and hospital-based HIV-support programming. Children completed measures of friendship quality and interpersonal functioning. Caregivers completed a measure of child psychosocial functioning."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Children with asthma, not HIV, demonstrated poorer indicators of friendship and the most negative social expectations of the three groups. Children with HIV maintained best friendships and rated themselves as socially well-adjusted."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Comprehensive multidisciplinary services and ancillary supports may have buffered against stressors and facilitated positive psychosocial outcomes in children with HIV. Children with asthma displayed higher disease activity, possibly contributing to poorer outcomes. Results suggest a need to better understand the protective factors that enhance social functioning in children with HIV."
        }
      ]},
