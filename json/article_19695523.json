      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the presence of lumbar multifidus atrophy and pain after successful lumbar medial branch radiofrequency neurotomy for zygapophysial joint mediated pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective observational analysis of 5 patients who had undergone successful unilateral radiofrequency neurotomy (RFN) of the lumbar medial branch divisions of the lumbar dorsal rami. At 17 to 26 months after RFN, 3 blinded radiologists evaluated the relative composition and size of the multifidus muscle at different segmental levels on lumbar magnetic resonance imaging (MRI). They were asked to determine the lesioned levels by evidence of multifidus atrophy. The accuracy of predicting the correct side and level lesioned was evaluated."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Private spine practice in Tyler, Texas."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Five patients who had unilateral lumbar medial branch RFN for proven lumbar zygapophysial joint-mediated pain were selected."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "MRI of the lumbar spine at a mean of 21 months (range, 17-26) after successful lumbar RFN."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Multifidus atrophy on a lumbar MRI, pain assessment and use of cointerventions."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Diffuse lumbar multifidus atrophy was detectable with MRI. However, radiologists could not reliably predict the side and segments lesioned. Despite denervation of the multifidus, at 12 months after RFN all subjects had ongoing pain relief and did not require or request additional treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "This preliminary study provides evidence that successful medial branch RFN for lumbar zygapophysial-mediated pain does cause initial denervation but no discernable segmental atrophy of the multifidus at long-term follow-up. Previous denervation and diffuse atrophy in these subjects was not associated with pain."
        }
      ]},
