      "Abstract": {
        "CopyrightInformation": "© 2012 The International Society of Dermatology.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Antitumor necrosis factor (anti-TNF) agents are a well-established treatment for various medical conditions, including psoriasis and psoriatic arthritis. However, anti-TNF agents may themselves induce psoriasis in some patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The authors report two cases of patients with severe and refractory infliximab-induced psoriasis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The patients had good clinical responses after switching to another TNF blocker."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "For severe cases, infliximab withdrawal combined with conventional immunosuppressive psoriasis drugs or with adalimumab may be a therapeutic option."
          }
        ]
      },
