      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Manual therapies for chronic neck pain are imprecise, inconsistent, and brief due to therapist fatigue. A previous study showed that computerized mobilization of the cervical spine in the sagittal plane is a safe and potentially effective treatment of chronic neck pain."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the safety and efficacy of computerized mobilization of the cervical spine in a three-dimensional space for the treatment of chronic neck pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Pilot, open trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Physical therapy outpatient department."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Nine patients with chronic neck pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "A computerized cradle capable of three-dimensional neck mobilizations was used. Treatment sessions lasted 20 minutes, biweekly, for six weeks."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Visual analog scale (VAS) for pain, cervical range of motion (CROM), neck disability index (NDI), joint position error (JPE), and muscle algometry."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Comparing baseline at week one with week six (end of treatment), the VAS scores dropped by 2.9 points (P\u2009<\u20090.01). The six directions of movement studied by the CROM showed a combined increase of 11% (P\u2009=\u20090.01). The NDI decreased significantly from 16 to 10 (P\u2009=\u20090.03), and the JPE decreased significantly from 3.7° to 1.9° (P\u2009=\u20090.047). There was no change in the pressure pain threshold in any muscle tested. There were no significant adverse effects."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These preliminary results demonstrate that this novel, computerized, three-dimensional cervical mobilization device is probably safe. The data also suggest that this method is effective in alleviating neck pain and associated headache, and in increasing the CROM, although the sample size was small in this open trial."
          }
        ]
      },
