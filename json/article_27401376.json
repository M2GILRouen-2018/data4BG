      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Postoperative leaks are the most undesirable complication of bariatric surgery and upper gastrointestinal (GI) series are routinely ordered to rule them out. Despite the published literature recommending against its routine use, it is still being customarily used in Chile."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To examine the usefulness of routine upper GI series using water-soluble iodinated contrast media for the detection of early postoperative leaks in patients undergoing bariatric surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "A cohort of 328 patients subjected to bariatric surgery was followed from October 2012 to October 2013. Most of them underwent sleeve gastrectomy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Upper GI series on the first postoperative day were ordered to 308 (94%) patients. Postoperative leaks were observed in two patients, with an incidence of 0.6%. The sensitivity for upper GI series detection of leak was 0% and the negative predictive value was 99%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Routine upper GI series after bariatric surgery is not useful for the diagnosis of postoperative leak, given the low incidence of this complication and the low sensitivity of the technique."
        }
      ]},
