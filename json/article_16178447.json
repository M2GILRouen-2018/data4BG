      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the possibility of using the lesser saphenous vein as the alternative bypass graft in coronary artery bypasss graft (CABG)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Seven pieces of lesser saphenous veins of 6 patients were harvested as the single or sequential grafts of CABG procedure with No-touch technique."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The diameter and length of lesser saphaneous vein met the requirement of graft for entire revascularization. All grafts achieved good flow without significant complications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The lesser saphenous vein graft is an excellent choice for CABG patient who lacks routine grafts as an alternative material."
        }
      ]},
