      "Language": "por",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To evaluate the capability of coronary angiography, when performed in stable conditions, to predict which arterial segment will be responsible for future acute myocardial infarction."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "POPULATION",
          "content": "17 patients (15 men and 2 woman), mean age 52 +/- 12 years, who suffered a myocardial infarction (AMI), and had been previously submitted to coronary angiography. After the myocardial infarction all the patients had a new angiography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The coronary angiographies performed before and after the AMI were compared, by simultaneous visualization of the films, and the segment related to the AMI was determined with the help of ECG and ventriculography. Among the arterial segments with in the coronary angiography performed before the AMI and who were found to be related with it, three Groups were considered: A-with no angiographic lesion; B-with less then 70% lesion; C-with a lesion equal or superior to 70% (angiographically significant)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In nine patients the arterial segment related to AMI belonged to group A. In four patients it belonged to group B and in four to C. Segments with angiographically significant lesions were responsible for AMI in less then one fourth of the patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Coronary angiography, when performed in stable conditions, has a low predictive value to determine the localization of the arterial segment related to future AMI."
        }
      ]},
