      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "Understanding the characteristics of young adults who have difficulty achieving a healthy weight may help develop more effective interventions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Signal detection was conducted to identify subgroups of overweight/obese young adults more or less likely to lose weight (5% weight loss) over 6 months. Data were collected from a diverse sample involved in a randomized controlled behavioral weight loss intervention (N = 404)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Overall, 15% (N = 57) of participants achieved <5% weight loss. Change in self-monitoring weight, baseline score of gym attendance/participating in exercise classes, and change in eating less fat were the best predictors of weight loss."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "These strategies may be particularly helpful to promote short-term weight loss in overweight/obese young adults."
        }
      ]},
