      "Abstract": {
        "CopyrightInformation": "Copyright © 2017. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Despite the serious behavioral consequences faced by individuals with sexual compulsivity, related neuropsychological studies are sparse."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "To compare decision making and cognitive flexibility at baseline and after exposure to an erotic video in sexually compulsive participants and non-sexually compulsive controls."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The sample consisted of 30 sexually compulsive men and 30 controls. Cognitive flexibility was investigated through the Wisconsin Card Sorting Test and decision making was examined through the Iowa Gambling Task."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Wisconsin Card Sorting Test categories, correct responses, and perseverative errors and Iowa Gambling Task general trends and blocks."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Sexually compulsive subjects and controls performed similarly at baseline. After watching an erotic video, controls performed better in block 1 of the Iowa Gambling Task (P = .01) and had more correct responses on the Wisconsin Card Sorting Test (P = .01)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The controls presented fewer impulsive initial choices and better cognitive flexibility after exposure to erotic stimuli. Messina B, Fuentes D, Tavares H, et al. Executive Functioning of Sexually Compulsive and Non-Sexually Compulsive Men Before and After Watching an Erotic Video. J Sex Med 2017;14:347-354."
          }
        ]
      },
