      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Sociedad Española de Neurología. Publicado por Elsevier España, S.L.U. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Gamma Knife Surgery (GNS) is one of the many techniques used to treat the idiopathic form of trigeminal neuralgia (TN). The aim of this review is to analyse the effectiveness of treatment with GNS in patients affected by recurrent TN."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DEVELOPMENT",
            "content": "a literature search conducted using MEDLINE, CINAHL, and Scopus in January of 2013 yielded 125 results. After applying the inclusion and exclusion criteria, we selected16 articles evaluating the effectiveness of GNS for reducing symptoms in patients with recurrent TN. Assessment criteria were degree of pain, time to pain relief, pain maintenance, and disease recurrence after the procedure."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "GNS is considered a non-invasive, safe, and effective treatment for patients with idiopathic TN refractory to medication and surgery. It is currently considered the most advanced means of treating this disease."
          }
        ]
      },
