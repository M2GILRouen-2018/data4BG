      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To analyse age-gender composition of patients and clinical course of unstable angina."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "The examination covered 2139 (77.5%) patients who had prehospital and discharge diagnosis unstable angina pectoris. AP was confirmed in 926 males and 551 females. Age correlation was the same of persons under and over 60 years."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The background of angina onset was found severe. Many patients suffered from myocardial infarction, diabetes mellitus, arterial hypertension. Age structure of persons with UA corresponds to those with myocardial infarction."
        }
      ]},
