      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© American Academy of Otolaryngology-Head and Neck Surgery Foundation 2015.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Cervical chylous fistula is an uncommon complication after neck dissection, but it might lead to some serious clinical outcomes. Although most cervical chylous fistulas can heal in a few days with standard treatments, some can be intractable. In this study, we describe a new method with local application of Pseudomonas aeruginosa injection for intractable cervical chylous fistula."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Case series with chart review."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "West China Hospital, Sichuan University, Chengdu, China."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS AND METHODS",
            "content": "The charts of 18 patients who were treated with P aeruginosa injection (PAI) for intractable cervical chylous fistula were retrospectively reviewed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "All patients were successfully treated with PAI. Mild fever (temperature, <38°C) occurred in 9 patients, moderate fever (38°C-39°C) in 4 patients, and severe fever (>39°C) in 5 patients. All patients had mild to severe neck pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Local application of PAI is an effective method for the treatment of intractable cervical chylous fistula, of which the most common side effects are transient fever and local pain."
          }
        ]
      },
