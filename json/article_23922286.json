      "Abstract": {
        "CopyrightInformation": "© 2013 Association of Rehabilitation Nurses.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To examine the correlation between participation in a cardiac rehabilitation (CR) program and quality of life (QoL)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A prospective study of patients with coronary artery disease (CAD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Participants completed questionnaires before and after a 3-month CR program. Patients were surveyed using a cardiac history evaluation and the MacNew Heart Disease Health-Related QoL questionnaire."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "Of those eligible, only 14% of the participants were women and 7% were of Arab ethnicity. Patients' QoL significantly improved following participation. Higher level of education was associated with improved QoL. Conversely, cardiac risk factor burden was associated with a decline in QoL. No association was found between cardiac risk stratification, age or religiosity and QoL."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Improved QoL after CR program participation should raise awareness of the significant benefits of CR among healthcare professionals."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL RELEVANCE",
            "content": "CR for those patients with CAD should be implemented, with a focus on women and minorities."
          }
        ]
      },
