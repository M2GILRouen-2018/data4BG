      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the degree of weight loss in subjects enrolled in the Veterans Affairs weight management program (MOVE!)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Retrospective cohort design."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary care US veterans hospital, July, 2007 to September, 2008, using a retrospective database."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Adult veterans (n = 1,659), mostly men (85%)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Encounters with existing nutrition education classes were collected and outcomes were assessed."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Primary outcome was weight change; the predictor was visits or encounters."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "One-way ANOVA."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In this sample, ≥ 3 nutrition education encounters were associated with significantly more body weight loss compared with 1-2 encounters or no education (-1.62%, 0.2%, and -0.23%, respectively; P = .01)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS AND IMPLICATIONS",
            "content": "Three or more nutrition education encounters within the MOVE! weight management program at the Michael E. DeBakey Veterans Affairs Medical Center are associated with modest weight loss. Future prospective studies are needed to determine causality and confirm these findings."
          }
        ]
      },
