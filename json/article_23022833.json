      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Authorship of peer-reviewed publications can create conflict among academics."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To document authorship conflicts of academics at a tertiary faculty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "An anonymous questionnaire eliciting authorship conflicts and knowledge of authorship criteria was administered online to 154 academic staff members at a New Zealand university."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "43 academics responded, a response rate of 27.9%. About half of the academics reported authorship conflicts, mainly regarding ownership of data, gift authorship and academic competition. Of the 43 academics, 31 were aware of formal authorship criteria but only 21 could identify the appropriate source. 23 academics correctly identified all the appropriate criteria for authorship according to the International Committee of Medical Journal Editors guidelines."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Authorship conflicts are prevalent in a New Zealand university that may be related to lack of knowledge of authorship criteria."
        }
      ]},
