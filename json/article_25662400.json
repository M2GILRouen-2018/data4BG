      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To assess changes in participation in society (frequency, restrictions, satisfaction) during and after cardiac rehabilitation (CR) and to assess associations between participation and heath-related quality of life (HRQOL)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective cohort study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Outpatient CR center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Patients with coronary artery disease (N=121; mean age, 57y; 96 men [79%])."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Multidisciplinary CR."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Participation in society was assessed with the Utrecht Scale for Evaluation of Rehabilitation-Participation and HRQOL with the MacNew Heart Disease health-related quality of life questionnaire. All measurements were performed pre-CR, post-CR, and 1 year after the start of CR."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Frequency of participation did not change during and after CR. The proportion of patients experiencing restrictions in participation decreased from 69% pre-CR to 40% post-CR (P<.001) and 29% at 1 year (P<.001 vs post-CR). Pre-CR, 71% of patients were dissatisfied with their participation. This improved to 49% post-CR (P<.001) and 53% at 1 year (P<.001 vs pre-CR). Experienced restrictions explained 5% to 7% of the improvement in HRQOL during CR and satisfaction with participation explained 10% to 19%."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Participation in society improves in patients undergoing CR. Despite these improvements, the presence of coronary artery disease is associated with persistent restrictions and dissatisfaction with participation. Because experienced restrictions and dissatisfaction are related to changes in HRQOL it is important to address these aspects of participation during CR."
          }
        ]
      },
