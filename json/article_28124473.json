      "Abstract": {
        "CopyrightInformation": "© 2017 John Wiley & Sons Australia, Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "Prognosis following early psychosis is highly variable. Long-term prognostic information from research studies is available in only a few areas. We sought to understand how well routine discharge information allows prediction of long-term readmission prognosis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We reviewed the records of 239 people leaving Early Intervention services, after an average of 2.5\u2009years, and counted the number of relapses. The distribution was modelled and extrapolated to a predicted 10 year outcome. Model predictions were compared with published data."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Numbers of relapses varied substantially, with 59% having no relapses before discharge, and 5% having 4 or more. Model predictions for 10-year outcome were close to the observed data."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A simple model can describe the distribution of numbers of relapses among people discharged from EI services, and predict long-term outcomes matching those observed in formal research. This low-cost approach could allow EI services to develop locale-specific prognostic information."
          }
        ]
      },
