      "Abstract": {"AbstractText": [
        {
          "Label": "UNLABELLED",
          "content": "Penetrating stab cranial wounds of the skull by fencing-foil are rare in western countries."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "This 46-year-old man suffered a penetrating stab wound of the skull through the right orbital region. As a consequence he developed an intracranial hematoma requiring surgical evacuation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION AND CONCLUSIONS",
          "content": "Damage of intracranial contents due to transorbital penetrating objects other than missiles is a rare event."
        }
      ]},
