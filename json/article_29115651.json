      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Primer epiploic appendagitis (PEA) is an uncommon condition."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We retrospectively reviewed the clinical records and computed tomography (CT) findings of 45 patients with PEA."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "On the basis of physical examination and pain localization, presumptive clinical diagnosis was acute appendicitis (n=13), acute cholecystitis (n=2), acute diverticulitis (n=19), renal colic (n=7) and ovarian pathology (n=4)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Although it has no characteristic clinical and laboratory features, CT is the best modality for accurate diagnosis of PEA."
        }
      ]},
