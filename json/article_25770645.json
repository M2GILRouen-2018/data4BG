      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Plastic bronchitis (PB) is a rare disease characterized by formation of bronchial casts. It is usually associated with congenital heart disease, sickle cell disease, lymphoma, and lung diseases such as asthma and pneumonia."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To report 14 cases of PB with influenza A or influenza B infection."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We analyzed the clinical manifestations, bronchoscopic and histologic findings, clinical courses, and outcomes."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "These cases indicate that PB is a life-threatening complication of severe influenza. Plastic bronchitis should be considered in the diagnosis of children with acute respiratory distress such as lung atelectasis accompanied by influenza."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Diagnosis should be made by bronchial endoscopy and histopathology, and bronchial casts removed as early as possible."
          }
        ]
      },
