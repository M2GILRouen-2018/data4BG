      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the clinical efficacy of Qiantongding Decoction in the treatment of type III B prostatitis or chronic pelvic pain syndrome (CPPS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Seventy patients with type III B prostatitis / CPPS were randomly divided into an experimental group (n = 36) and a control group (n = 34), the former treated with Qiantongding Decoction, and the latter with oral Indometacin, both for a month. Then their scores on Pelvic Pain Symptom Survey and NIH-CPSI were documented and compared."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "An obvious improvement was observed in both groups after the treatment, with significant differences from pre-treatment (P < 0.05), and the experimental group showed a significantly better alleviation of pain than the control (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Qiantongding Decoction has an obvious therapeutic effect on type III B prostatitis / CPPS."
        }
      ]},
