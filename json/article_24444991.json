      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To evaluate intraperitoneal ropivacaine delivery with the AeroSurge device in the clinical setting and to evaluate the total systemic ropivacaine levels achieved following delivery of 50 mg of aerosolized ropivacaine."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Preliminary, prospective, nonrandomized study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Operating room of a university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "5 consecutive ASA physical status 1 and 2 patients undergoing elective laparoscopic Nissen fundoplication or cholecystectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Five mL of 1% ropivacaine was delivered through the 10 mm port using the AeroSurge device at peritoneal insufflation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Venous blood samples were collected and total ropivacaine concentration was determined using liquid chromatography-mass spectrometry."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "The AeroSurge device delivered ropivacaine, visible as mist within the peritoneal cavity. Peak concentration (Cmax) was attained between 10 and 30 minutes following the end of aerosolized ropivacaine delivery. At no stage did any level approach toxic levels."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This preliminary study confirms that aerosolized intraperitoneal local anesthetic is feasible, with ropivacaine concentrations remaining within safe levels."
          }
        ]
      },
