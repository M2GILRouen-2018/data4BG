      "Abstract": {
        "CopyrightInformation": "© 2012 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To illustrate a new surgical revision strategy for malfunctioning spinal cord stimulation (SCS) paddle electrodes."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "SCS is a treatment for chronic neuropathic pain that delivers therapeutic doses of electric current to the dorsal columns resulting in dermatomal paresthesia and pain reduction. Reasons for SCS failure include hardware malfunction or breakage and medical complications."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "A 34-year-old woman presented with a two-year history of intractable pain in the left upper extremity and thoracic region which was previously controlled by SCS. Imaging demonstrated breakage of the cervical electrode wire that had been advanced in the caudal direction from the C1 spinal level. Revision of the broken electrode was performed by hemilaminectomy of C3-C4 and the replacement electrode was advanced in the cephalad direction."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Ideal and exact paresthesia pattern was confirmed intraoperatively and the patient maintained successful pain reduction at five-year follow-up."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Advancing SCS electrodes into the upper cervical spine in the cephalad direction, using the previously formed scar capsule, offers an alternate strategy for revision of malfunctioning SCS paddle electrodes."
          }
        ]
      },
