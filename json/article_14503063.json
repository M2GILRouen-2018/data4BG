      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe the effect of Pingchuan Mixture (PCM) on plasma eosinophil cation protein (ECP), interleukin-5 in bronchial alveolar lavage fluid (BALF) and inflammatory cell count in experimental guinea pigs with asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The eosinophil, neutrophil, lymphocyte count were conducted by conventional method, IL-5 was detected by ELISA and ECP determined by RIA."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Levels of eosinophil, neutrophil, lymphocyte, ECP and IL-5 after treatment were significantly lower than those before treatment, the difference between groups treated respectively by PCM, aminophylline, dexamethasone and Dingchuan Zhike Tablet was insignificant."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "PCM could treat asthma by reducing the inflammatory cell count, ECP and IL-5."
        }
      ]},
