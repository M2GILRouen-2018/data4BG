      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Pre-test, post-test study of the relationship between exercise-related changes in feeling states and pain among persons with chronic incomplete spinal cord injury (SCI) who performed three separate exercise sessions consisting of body-weight supported treadmill training (BWSTT)."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine whether exercise-related changes in feeling states are related to exercise-related changes in pain and in-task pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Hamilton, Ontario, Canada."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 14 men and women with chronic, incomplete SCI (ASIA B and C) performed three exercise sessions of BWSTT. Measures of pain and feeling states were administered before and after each session along with a measure of pain experienced while exercising."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Participants who experienced greater decreases in pain from pre- to post-exercise also experienced greater improvements in feeling states. Pain experienced during exercise was unrelated to changes in feeling states."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Among persons with SCI, exercise-related changes in pain can influence the effects of individual exercise bouts on feeling states."
        }
      ]},
