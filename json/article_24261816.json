      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study aimed to identify cultural-level variables that may influence the extent to which adolescents from different cultural groups are dissatisfied with their bodies."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A sample of 1730 male and 2000 female adolescents from Australia, Fiji, Malaysia, Tonga, Tongans in New Zealand, China, Chile, and Greece completed measures of body satisfaction, and the sociocultural influences on body image and body change questionnaire, and self-reported height and weight. Country gross domestic product and national obesity were recorded using global databases."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Prevalence of obesity/overweight and cultural endorsement of appearance standards explained variance in individual-level body dissatisfaction (BD) scores, even after controlling for the influence of individual differences in body mass index and internalization of appearance standards."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Cultural-level variables may account for the development of adolescent BD."
        }
      ]},
