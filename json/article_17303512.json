      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To review the surgical treatment options for breast cancer and breast reconstruction options following mastectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Clinical and research articles, textbook chapters, and clinical practice."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Advances have been made in the surgical treatment of breast cancer, and options for less invasive procedures are now available. Patients are often faced with difficult decisions when trying to choose the best treatment option."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Nurses play an integral role in providing patients with the physical, educational, and emotional skills necessary to help them make appropriate surgical decisions and return to optimal health after their treatment."
        }
      ]},
