      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the effects of estrogen deprivation and estrogen replacement on coronary artery atherosclerosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized trials using female cynomolgus monkeys as subjects."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Comparative Medicine Clinical Research Center of an academic medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Premenopausal and postmenopausal female cynomolgus monkeys fed diets comparable in fat and cholesterol to those consumed by human beings."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Menopause was induced by ovariectomy; coronary vasomotion was evaluated during coronary angiography. Treatments involved estrogens and progestins, and coronary artery atherosclerosis was evaluated at necropsy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Coronary artery atherosclerosis extent."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Premenopausal stress induces ovarian dysfunction and exacerbates coronary artery atherosclerosis. Physiologic replacement of ovarian hormones reduces in half the extent of coronary atherosclerosis of surgically menopausal monkeys. Hormone replacement therapy did not enhance regression of established coronary atherosclerosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Estrogen deprivation exacerbates and estrogen diminishes coronary artery atherosclerosis of female cynomolgus monkeys fed atherogenic diets."
        }
      ]},
