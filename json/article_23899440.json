      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2013.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "The aim of the present study was to investigate the predictive value of preoperative neutrophil-lymphocyte ratio (NLR) in postoperative saphenous vein graft patency in patients undergoing coronary artery bypass grafting (CABG) surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "We retrospectively analyzed 444 patients who had undergone CABG and a further control coronary angiography due to recurrence of symptoms. The patients were divided into tertile groups according to the NLR. The primary end point was 50% saphenous vein graft stenosis or more or complete occlusion."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT",
            "content": "The saphenous vein graft failure in the 3 groups based on NLR was 33%, 66.2%, and 79.1%, in the low-, middle- and high-risk groups, respectively. In multivariate regression modeling, current smoker, diabetes mellitus, target artery diameter <1.5 mm, and NLR independently predicted saphenous vein graft patency in patients after CABG."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Preoperative NLR is clearly an independent predictor of saphenous vein graft patency in patients after CABG."
          }
        ]
      },
