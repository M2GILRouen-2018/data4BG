      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Academy of Physical Medicine and Rehabilitation. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess efficacy of an interdisciplinary pain program adapted for persons with spinal cord injury (SCI) and chronic pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective cohort."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University-affiliated rehabilitation hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Twenty-two persons with traumatic or nontraumatic SCI and chronic pain of at least 6 months' duration."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Subjects participated in an interdisciplinary pain program consisting of biweekly group sessions for 10 consecutive weeks. Sessions incorporated patient education on chronic pain and associated pain mechanisms, cognitive behavioral therapy, self-management strategies (eg, energy conservation, ergonomics, goal setting, stress management, anger management, and coping skills), group discussions and activities, and either exercise or guided relaxation at the end of each session."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Multidimensional Pain Inventory SCI, Coping Inventory of Stressful Situations, Pain Stages of Change Questionnaire, and Life Satisfaction Questionnaire."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After participation in an interdisciplinary pain program, persons with SCI and chronic neuropathic pain demonstrated increased involvement in learning and maintenance of coping strategies for chronic pain. Participation also led to less pain interference in daily life and a greater sense of control over one's life."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Participation in an interdisciplinary pain program does not reduce pain severity, but it can help persons with SCI and chronic neuropathic pain cope with pain, lessen interference of pain, and improve their sense of control."
          }
        ]
      },
