      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Reports of sclerosing angiomatoid nodular transformation in the pediatric population are rare."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE CHARACTERISTICS",
          "content": "The 3-year-old child was injured in a car accident and then diagnosed with sclerosing angiomatoid nodular transformation. The patient underwent exploratory surgery with partial splenectomy including total excision of the tumor mass."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "OUTCOME",
          "content": "Neither recurrence nor metastasis occurred over 20 months of follow-up."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "MESSAGE",
          "content": "Sclerosing angiomatoid nodular transformation can occur in early childhood."
        }
      ]},
