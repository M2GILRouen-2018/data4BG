      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2015.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Case report."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Twenty-five percent of people living with HIV/AIDS (PLWHA) are also coinfected with hepatitis C virus (HCV). There are limited reports to assist in the symptom management of PLWHA and HCV coinfection."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE DESCRIPTION",
            "content": "Our case was a 67-year-old man living with HIV/HCV coinfection and other medical complications. Our intervention consisted of a 6-week progressive conditioning program, while his activity and sleep pattern were monitored using a wrist accelerometer."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "OUTCOMES",
            "content": "After completing a conditioning training, there was a 64% decrease in the number of waking episodes per night and 68% decrease in activity at night. Based on Pittsburgh Sleep Quality Index scores, the participant transitioned from being a \"poor sleeper\" to a \"good sleeper.\" A 40% decrease in pain was reported. Functional outcome measures also showed improvements."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "There were improvements in the participant's sleep quality and pain. The use of a commercial accelerometer may assist in objectively tracking compliance and activity changes."
          }
        ]
      },
