      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Auriculotemporal syndrome (AS) is an uncommon disorder that may present with facial erythema with chewing food."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We report a patient referred to an allergist to rule out allergy as a reason for food-associated bilateral facial flushing. She was subsequently found to have bilateral AS."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The symptoms of AS may overlap those associated with food allergy. There are only a few published cases of bilateral AS."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Allergists should be aware of bilateral AS and the clinical spectrum of this disorder as AS patients may be referred to allergists to rule out food allergy."
        }
      ]},
