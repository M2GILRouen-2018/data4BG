      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Arthroscopy Association of North America. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To present the technique and results of ultrasonographically guided percutaneous carpal tunnel release (PCTR) in a consecutive series of patients with carpal tunnel syndrome (CTS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We used previously defined landmarks with the \"safe zones,\" localization, estimated size, and extent of the transverse carpal ligament (TCL) for this prospective clinical study of 91 consecutive cases of carpal tunnel release treated with this technique. The follow-up consisted of 4 time points (1 week and 2, 6, and 12 months) and a final evaluation at an average of 22.5 months."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The sensory disturbances disappeared in 76.8%, 93.4%, 100%, and 100% of the patients at 1 week and 2, 6, and 12 months postoperatively, respectively. Moderate pain was experienced in 24.2% of patients within 1 week, in 6.6% of patients within 2 months, and in 1.1% of patients within 12 months after the operation. In the final evaluation, 2 hands were graded as unsatisfactory: one hand had moderate wrist pain without sensory disturbance, and one hand had a recurrence 14 months after the operation. There were no intraoperative or postoperative complications."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Ultrasonographically assisted PCTR is a safe and effective procedure, but it is technically demanding and requires substantial training to be proficient in its use."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "Level IV, therapeutic case series."
          }
        ]
      },
