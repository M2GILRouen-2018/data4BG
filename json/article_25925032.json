      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Sociedade Brasileira de Anestesiologia. Published by Elsevier Editora Ltda. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVE",
            "content": "The increased use of epidural analgesia with catheter leads to the need to demonstrate the safety of this method and know the incidence of catheter colonization, inserted postoperatively for epidural analgesia, and the bacteria responsible for this colonization."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "From November 2011 to April 2012, patients electively operated and maintained under epidural catheter for postoperative analgesia were evaluated. The catheter tip was collected for semiquantitative and qualitative microbiological analysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 68 cultured catheters, six tips (8.8%) had positive cultures. No patient had superficial or deep infection. The mean duration of catheter use was 43.45 h (18-118) (p=0.0894). The type of surgery (contaminated or uncontaminated), physical status of patients, and surgical time showed no relation with the colonization of catheters. Microorganisms isolated from the catheter tip were Staphylococcus aureus, Pseudomonas aeruginosa and Sphingomonas paucimobilis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Postoperative epidural catheter analgesia, under these study conditions, was found to be low risk for bacterial colonization in patients at surgical wards."
          }
        ]
      },
