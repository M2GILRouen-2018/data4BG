      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To document an unusual cause of abdominal pain in premenarcheal adolescent girls."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A training and research hospital in Istanbul."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Two cases of hematocolpos in two adolescent girls due to imperforate hymen were reported. Both of them manifested lower abdominal pain and urinary retention. Hymenotomy was performed in both the cases."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Imperforate hymen is a rare diagnosis, but should be considered when dealing with premenarcheal adolescent girls with lower abdominal symptoms or back pain."
        }
      ]},
