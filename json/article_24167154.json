      "Abstract": {
        "CopyrightInformation": "© 2013 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To investigate the relationship between weight status (body mass index [BMI] percentile and BMI z-score) and lung volumes in healthy children and adolescents."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "HYPOTHESES",
            "content": "We hypothesized that: (a) there would be a significant inverse relationship between age- and sex-specific BMI distribution and functional residual capacity (FRC), and expiratory reserve volume (ERV), respectively; and (b) obese children would have significantly reduced FRC and ERV compared to their non-obese peers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The medical records of all individuals who successfully performed pulmonary function testing between 2000 and 2007 at two university children's hospitals were reviewed. Participants were excluded if they had cardiopulmonary, neuromuscular, or chest wall disease."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 1,469 record reviewed, 327 subjects met study criteria. Percent predicted ERV was lowest in the obese group (P\u2009<\u20090.001) while residual volume (RV) was lowest in the overweight and obese groups (P\u2009<\u20090.001). Underweight participants had a lower percent predicted forced vital capacity (FVC) (P\u2009=\u20090.027) and vital capacity (VC; P\u2009=\u20090.039). Obese participants had the lowest FEV1 /FVC (P\u2009<\u20090.001). A positive linear relationship existed between BMI z-score and percent predicted FVC, VC, and diffusing capacity of carbon monoxide (DLCO ). A negative linear relationship was found between BMI z-score and percent predicted FRC, ERV, RV, and absolute FEV1 /FVC."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our results show that increasing weight status in children and adolescents is associated with a general reduction in lung volume measurements, which may reflect impaired lung function, increased respiratory symptoms, and decreased functional status."
          }
        ]
      },
