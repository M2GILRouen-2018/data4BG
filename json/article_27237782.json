      "Abstract": {
        "CopyrightInformation": "© 2016 World Obesity Federation.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Childhood obesity is a risk factor for non-alcoholic fatty liver disease and poses important public health issues for children. Racial differences in alanine aminotransferase (ALT) levels among children have not been described. This study aimed to identify racial differences in upper limit normal (ULN) ALT levels and evaluate the effect of obesity on elevated levels in children without other metabolic risk factors."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "National Health and Nutrition Examination Surveys and clinical data from the Loyola University Health System were used to determine ULN ALT by race and gender. Quantile regression was used to evaluate the impact of obesity on elevated ALT and to identify potential risk factors for ALT above the ULN."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Upper limit normal (ULN) ALT was approximately 28.0 and 21.0-24.0\u2009U/L for boys and girls, respectively. No significant difference in ULN ALT across race was observed. Obesity was significantly associated with elevated ALT; obese children with elevated ALT had values 10\u2009U/L higher than normal-weight children."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Racial differences in ALT levels among adults are not evident in children. Obesity, in the absence of metabolic risk factors and other causes of liver disease, is associated with elevated ALT, providing evidence against the concept of healthy obesity in children."
          }
        ]
      },
