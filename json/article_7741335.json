      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To compare the newly described transthecal (TT) and traditional (TD) methods of digital block anesthesia with regard to length of time to achieve anesthesia and pain during infiltration."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomized, controlled, blinded study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Healthy adult paid volunteers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Each subject received a TT block on one hand and a TD block on the opposite hand. All blocks were performed by the same investigator and were rated by an evaluator who was blinded to the technique that was used. Time to loss of pin-prick sensation was measured, and the pain of the procedure was recorded by the subject on a 10-cm visual-analog scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 162 blocks (81 TT and 81 TD) were performed in 31 different subjects. All blocks were successful. Mean time to anesthesia for TT block was 188 seconds compared with 152 seconds for the TD block (P < .01). Mean analog pain score was slightly higher for TT block than for TD block (1.7 versus 1.4, P = .02)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "TT block is clinically equal to the TD method in terms of time to anesthesia and visual-analog pain score."
        }
      ]},
