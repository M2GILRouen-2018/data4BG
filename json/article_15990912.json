      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To determine the changes in knowledge and attitudes of pain resource nurses (PRNs) as a result of an intensive pain management course."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Pre- and post-test design."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A Veterans Administration hospital in the southeastern United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "18 RNs from multiple units where care is provided for veterans with cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The PRNs were tested before and after a 32-hour intensive pain management course."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Knowledge about pain management, attitudes toward pain management, and attitudes toward patients in pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Significant improvements were found in pain knowledge and attitudes toward patients in pain. Improvements in attitudes toward pain management approached significance."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The improvements in scores not only supported the effectiveness of the course but also provided additional evidence of the validity of the assessment instruments."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "Courses such as this should be offered in other settings to encourage practicing nurses to provide better care to patients in pain and to serve as role models for their peers."
        }
      ]},
