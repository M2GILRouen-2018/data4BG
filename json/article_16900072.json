      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This pilot study examined the influence of pain perception on functional status."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A descriptive longitudinal correlational exploratory design was used."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "The sample comprised 23 participants ranging in age from 47 to 85 years."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Data were collected for pain perception components, anxiety, and functional status. Negative correlations were noted between pain and functional status on days 42 and 84. Common descriptors used over the first 3 days were sharp, aching, tender, and tiring."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Pain intensity is only one component of pain perception. Management of the sensory and affective components needs further research."
        }
      ]},
