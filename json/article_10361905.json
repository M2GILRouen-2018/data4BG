      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECT",
          "content": "To assess the value of secondary prevention with lipid lowering therapy following either balloon angioplasty (PTCA) or bypass surgery (CABG) in familial hypercholesterolemia patients, the correlation of the new evolution of stenotic lesions and therapeutically achieved cholesterol levels was studied in 50 patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "All surviving patients were followed angiographically after 5 years, and findings were correlated with the annually determined total serum cholesterol (TC) levels."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "New coronary atherosclerotic plaques were not observed in 18 patients in whom the TC was controlled to <220 mg/dl but in 19 of 32 patients in whom the TC was >220 mg/dl, a new evolution of stenotic lesions was observed angiographically."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The new evolution of stenotic lesions following revascularization in patients with FH can be controlled significantly by lipid lowering therapy to maintain a TC level of <220 mg/dl, and if diet alone can not achieve it, aggressive medication and even LDL apheresis might be justified."
        }
      ]},
