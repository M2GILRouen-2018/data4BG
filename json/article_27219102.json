      "Abstract": {
        "CopyrightInformation": "© 2016 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The objective of this study was to investigate clinical outcomes following single crossover bioresorbable scaffold (BRS) implantation without routine side branch (SB) strut dilation."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "It is unknown whether SB strut dilation is routinely required after single crossover BRS implantation if there is no compromise of the jailed SB."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Among 187 bifurcation lesions treated with Absorb BRS, 115 lesions (101 patients) were treated with single crossover BRS implantation. Strut dilation toward SB was considered only when SB was compromised (SB TIMI flow\u2009<\u20093 or SB ostium\u2009>\u200975%) after main branch (MB) BRS implantation. Clinical outcomes including cardiac death, follow-up myocardial infarction (MI), target lesion revascularization (TLR), target vessel revascularization (TVR), and definite scaffold thrombosis (ST) were investigated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The majority of target lesions were in the left anterior descending artery (73.0%) and the rate of true bifurcation lesions was 42.6%. SB strut dilation was performed in only 20% of lesions (n\u2009=\u200923), and intravascular imaging was used in most cases (90.4%). The rates of TLR per lesion at 1-year was 3.1% in MB, and 0% in SB. In all patients, the cumulative rate of cardiac death was 1.1% at 1-year, follow-up MI 2.2%, TVR 3.5%, and definite ST 1.0%."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Clinical outcomes were acceptable in bifurcation lesions treated with single crossover BRS implantation without routine SB strut dilation. © 2016 Wiley Periodicals, Inc."
          }
        ]
      },
