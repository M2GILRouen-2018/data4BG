      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We sought to assess perioperative outcomes of minimally invasive vs open endometrial cancer staging procedures."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "A total of 181 consecutive patients underwent open or minimally invasive hysterectomy with or without lymphadenectomy. Perioperative outcomes, analgesic, and antiemetic use were compared."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In all, 97 and 84 women underwent open and minimally invasive staging procedures, respectively. In the open staging group, median anesthesia time was shorter (197 vs 288 minutes; P < .0001), but recovery room stay (168 vs 140 minutes; P = .01) and hospital stay (4 vs 1 day; P < .0001) were longer. Median narcotic (13 vs 43 mg morphine equivalents; P < .0001) and antiemetic (43% vs 25%; P = .01) use were lower for minimally invasive surgery in the first 24 hours postoperatively. Median estimated blood loss was lower for minimally invasive procedures (100 vs 300 mL; P < .0001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Minimally invasive staging for endometrial cancer is associated with lower use of narcotics and antiemetics, and shorter hospital stay compared to open procedures."
          }
        ]
      },
