      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To provide a survey of various gynecological conditions causing chronic pelvic pain (CPP) that might be diagnosed by hysteroscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Review article."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Departments of obstetrics and gynecology and pathophysiology of human reproduction at a university in Italy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Women affected by CPP."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Hysteroscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Effectiveness in diagnosing intrauterine pathologies that cause CPP."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Hysteroscopy is highly effective in diagnosing various gynecological causes of CPP, including adenomyosis, chronic endometritis, Müllerian anomalies, retained fetal bones, endocervical ossification, and intrauterine abnormalities. Furthermore, hysteroscopy may play a primary role in the resolution of some of these conditions."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Because it can be executed safely in an office setting without anesthesia, hysteroscopy may be indicated, together with the other noninvasive procedures such as transvaginal ultrasonography, as a first-level investigation in women who are affected by CPP."
        }
      ]},
