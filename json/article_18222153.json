      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To discuss common lung cancer symptoms including prevalence, assessment, etiology, and recommended interventions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Research studies and systematic reviews."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A mandate in care of persons with lung cancer is to deliver supportive care concurrently with life-prolonging care or as the main focus of care. Most are diagnosed with advanced disease that impairs health with both physical and psychological symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Early assessment and comprehensive management of symptoms are main components of improving quality of life and functional status for those living with lung cancer."
        }
      ]},
