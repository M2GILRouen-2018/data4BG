      "Abstract": {
        "CopyrightInformation": "© 2017 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND/AIMS",
            "content": "To compare short- and long-term outcomes of intracorporeal anastomosis (IA) versus extracorporeal anastomosis (EA) in obese (body mass index >30 kg/m2) patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Sixty-four consecutive obese patients who underwent laparoscopic (LPS) right colectomy with IA were matched with 64 patients who underwent LPS right colectomy with EA. Intraoperative variables, short-term outcomes, readmission rates, and morbidity and mortality rates were analyzed along with long-term outcomes."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Conversion to open surgery occurred in 4 patients in the IA group and 11 patients in the EA group (p = 0.097). The overall 30-day morbidity rate was 29.6% in the IA and 32.8% in the EA (p = 0.70). No 30-day mortality occurred. Anastomotic leak occurred in 4.7% of patients in the IA group vs. 7.8% in the EA group (p = 0.71). In the IA group, an earlier recovery of bowel function was observed (p = 0.01). No differences were observed with respect to the length of stay and reoperation rate. No 30-day readmission occurred in the IA compared to 5 patients readmitted in the EA group (p = 0.058). A higher incidence of incisional hernia was observed in the EA group (p = 0.033)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "IA in obese patients is associated with similar short-term outcomes, lower incidence of incisional hernias, and might possibly reduce the risk of hospital readmission."
          }
        ]
      },
