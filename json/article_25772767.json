      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Society for Reproductive Medicine. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To report a technique that safely allows power and hand morcellation for laparoscopic hysterectomy and myomectomy specimens in a contained fashion in the event of unsuspected uterine sarcoma or leiomyosarcoma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Video article introducing a method for enclosed tissue morcellation for laparoscopic specimens."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Hospital of an academic-based practice."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Two patients underwent laparoscopic hysterectomy: a 57-year-old G7 P5025 female for leiomyoma, anemia, and a history of CIN-3; and a 38-year-old G0P0 female with a 10-year history of pelvic pain and severe dysmenorrhea who failed medical therapy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "A technique using the GelPOINT Platform incision extender system and GelSeal Cap (GSP) Advanced Access Platform and a 50 cm × 50 cm 3M Steri-Drape endobag for enclosed intracorporeal and extracorporeal tissue morcellation of laparoscopic specimens."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "For training purposes, we used a pelvic simulator and cadaver to describe the step-by-step process and troubleshoot issues to optimize intra- and extracorporeal morcellation. This allowed for easier implementation on the live patient."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Simulation training and the cadaver model provided a learning platform for contained internal power and external hand morcellation, accelerating the learning curve in its application to the live patient."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "The GSP and 3M Steri-Drape endobag is an alternative for laparoscopic power or hand morcellation. Using simulation training helped transition this technique to the live patient, allowing for easy and safe removal of tissue specimens and minimizing the potential for tissue seeding and dissemination."
          }
        ]
      },
