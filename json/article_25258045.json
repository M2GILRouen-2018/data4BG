      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore perceptions of spinal manipulative therapy and exercise among adults aged 65 years and older with chronic neck pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Mixed methods study embedded within a randomized clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS/PATIENTS",
          "content": "Interviews were conducted with 222 of 241 randomized clinical trial participants. They had a mean age of 72.2 years and they had neck pain of moderate severity and of 6 years mean duration."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Semi-structured interviews were conducted at the completion of the 12 week intervention phase, during which participants received spinal manipulative therapy and exercise interventions. Interviews explored determinants of satisfaction with care, whether or not therapy was worthwhile, and what was liked and disliked about treatment. Interviews were recorded and transcribed; content analysis was used to identify themes within responses."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Participants placed high value on their relationships with health care team members, supervision, individualized care, and the exercises and information provided as treatment. Change in symptoms did not figure as prominently as social and process-related themes. Percpetions of age, activities, and co-morbities influenced some seniors' expectations of treatment results, and comorbidities impacted perceptions of their ability to participate in active care."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Relationship dynamics should be leveraged in clinical encounters to enhance patient satisfaction and perceived value of care."
        }
      ]},
