      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Disproportionate access to unhealthy foods in poor or minority neighborhoods may be a primary determinant of obesity disparities. We investigated whether fast-food access varies by Census block group (CBG) percent black and poverty."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We measured the average driving distance from each CBG population-weighted centroid to the five closest top ten fast-food chains and CBG percent black and percent below poverty."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Among 209,091 CBGs analyzed (95.1% of all US CBGs), CBG percent black was positively associated with fast-food access controlling for population density and percent poverty (average distance to fast-food was 3.56 miles closer (95% CI: -3.64, -3.48) in CBGs with the highest versus lowest quartile of percentage of black residents). Poverty was not independently associated with fast-food access. The relationship between fast-food access and race was stronger in CBGs with higher levels of poverty (p for interaction <0.0001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Predominantly black neighborhoods had higher access to fast-food while poverty was not an independent predictor of fast-food access."
          }
        ]
      },
