      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To evaluate whether intrauterine growth retardation (IUGR) protects against the development of allergy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A case-control study of 1515 subjects (15-25 y), of whom 430 were cases (birthweight/length below -2 SD for gestational age). Birth data were from the national birth register. The frequencies of allergic diseases were evaluated by questionnaire."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "For the 950 who replied, the frequencies of allergic diseases were similar in cases and controls."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "IUGR does not protect against the development of allergy."
        }
      ]},
