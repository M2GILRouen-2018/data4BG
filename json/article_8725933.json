      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case report."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To document the occurrence of hematocolpos causing sciatica and leg weakness in an adolescent girl."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Low back pain resulting from hematocolpos has been reported previously but not associated with symptoms of sciatica or neurologic weakness."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The authors were involved in the care of this patient, and all medical records, radiologic investigations, and related literature were reviewed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After being checked for longstanding symptoms of sciatica and leg weakness, the patient underwent a computed tomographic examination of lumbar spine, which showed a large collection in the pelvis consistent with hematocolpos. Surgical drainage of the collection was associated with complete resolution of her symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Awareness of hematocolpos as a possible cause for sciatica and neurologic symptoms in the lower limbs may lead to earlier diagnosis and, therefore, reduced morbidity in the investigation of the adolescent girl."
        }
      ]},
