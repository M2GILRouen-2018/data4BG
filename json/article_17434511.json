      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effectiveness for the outcomes of endometriosis-related pain and quality of life of conservative surgery plus placebo compared with conservative surgery plus hormonal suppression treatment or dietary therapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized comparative trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "Two hundred twenty-two consecutive women who underwent conservative pelvic surgery for symptomatic endometriosis stage III-IV (r-AFS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Six months of placebo (n = 110) versus GnRH-a (tryptorelin or leuprorelin, 3.75 mg every 28 days) (n = 39) or continuous estroprogestin (ethynilestradiol, 0.03 mg plus gestoden, 0.75 mg) (n = 38) versus dietary therapy (vitamins, minerals salts, lactic ferments, fish oil) (n = 35)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Painful symptoms (visual analogue scale score) and quality-of-life endometriosis-related symptoms (SF-36 score) at 12 months' follow-up."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Patients treated with postoperative hormonal suppression therapy showed less visual analogue scale scores for dysmenorrhoea than patients of the other groups. Hormonal suppression therapy and dietary supplementation were equally effective in reducing nonmenstrual pelvic pain. Surgery plus placebo showed significative decrease in dyspareunia scores. Postoperative medical and dietary therapy allowed a better quality of life than placebo."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Postoperative hormonal suppression treatment or dietary therapy are more effective than surgery plus placebo to obtain relief of pain associated with endometriosis stage III-IV and improvement of quality of life."
        }
      ]},
