      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Association of autoimmune haemolytic anaemia has been seldom reported with Kawasaki disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE CHARACTERISTICS",
          "content": "A 7-month-old boy, presented with prolonged fever, erythematous rash, severe pallor and hepatosplenomegaly."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OBSERVATIONS",
          "content": "Positive Direct Coombs test and coronary artery aneurysm on echocardiography. He was managed with steroids along with intravenous immunoglobulins and aspirin."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "OUTCOME",
          "content": "Early identification of the condition helped in the management."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "MESSAGE",
          "content": "Patients of autoimmune hemolytic anemia with unusual features such as prolonged fever, skin rash, and mixed antibody response in Coombs test should be evaluated for underlying Kawasaki disease as a possible etiology."
        }
      ]},
