      "Abstract": {
        "CopyrightInformation": "Crown Copyright © 2012. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to compare the effect of a hospital clinic group- versus home-based combined exercise-diet program for the treatment of childhood obesity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "One hundred ten overweight/obese Spanish children and adolescents (6-16 years) in 2 intervention groups (hospital clinic group-based [n = 45] and home-based [n = 41]) and a sex-age-matched control group (n = 24) were randomly assigned to participate in a 6-month combined exercise (aerobic and resistance training) and Mediterranean diet program. Anthropometric values (including body weight, height, body mass index, BMI-Z score, and waist circumference) were measured pre- and postintervention for all the participants. Percentage body fat was also determined with a body fat analyzer (TANITA TBF-410 M)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Our study showed a significant reduction in percentage body fat and body mass index Z-score among both intervention-group participants (4%, 0.16, hospital clinic group-based; 4.4%, 0.23, home-based; P < .0001). There was also a significant reduction in waist circumference in the home-based group (4.4 cm; P = .019). Attendance rates at intervention sessions were equivalent for both intervention groups (P = .805)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The study findings indicate that a simple home-based combined exercise and Mediterranean diet program may be effective among overweight and obese children and adolescents, because it improves body composition, is feasible and can be adopted on a large scale without substantial expenses."
          }
        ]
      },
