      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To analyzed the correlation between smoking status and surgical outcomes in patients with non-B non-C hepatocellular carcinoma (NBNC-HCC), and we investigated the patients' clinicopathological characteristics according to smoking status."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We retrospectively analyzed the consecutive cases of 83 NBNC-HCC patients who underwent curative surgical treatment for the primary lesion at Saga University Hospital between 1984 and December 2012. We collected information about possibly carcinogenic factors such as alcohol abuse, diabetes mellitus, obesity and smoking habit from medical records. Smoking habits were subcategorized as never, ex- and current smoker at the time of surgery. The diagnosis of non-alcoholic steatohepatitis (NASH) was based on both clinical information and pathological confirmation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Alcohol abuse, diabetes mellitus, obesity and NASH had no significant effect on the surgical outcomes. Current smoking status was strongly correlated with both overall survival (P = 0.0058) and disease-specific survival (P = 0.0105) by multivariate analyses. Subset analyses revealed that the current smokers were significantly younger at the time of surgery (P = 0.0002) and more likely to abuse alcohol (P = 0.0188) and to have multiple tumors (P = 0.023)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Current smoking habit at the time of surgical treatment is a risk factor for poor long-term survival in NBNC-HCC patients. Current smokers tend to have multiple HCCs at a younger age than other patients."
        }
      ]},
