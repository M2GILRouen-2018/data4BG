      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To investigate prognostic implications of the calcium index estimated tomographycally for identification of patients at high risk to develop cardiovascular complications (non-fatal myocardial infarction, lethal coronary hear disease, coronary revascularization) in the absence of clinical manifestations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Meta-analysis of the results of studies on prognostic implications of coronary arteries calcinosis was made with standardized risk ratio as a metameter. The meta-analysis included tests for systemic error related to publishing primarily positive results and data heterogenicity."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Overall risk ratios for cardiovascular complications ranged from 2.1 to 9.3 for different degrees of coronary artery calcinosis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Calcium index is an independent risk factor of complications of cardiovascular diseases."
        }
      ]},
