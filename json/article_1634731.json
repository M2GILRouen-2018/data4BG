      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the effect of post-operative analgesia using epidural versus intravenous infusions on the incidence of delirium after bilateral knee replacement surgery in elderly patients. Additional risk factors and impact on post-operative recovery were also assessed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Urban referral hospital specializing in elective orthopedic surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "60 consecutive patients undergoing bilateral knee replacement surgery with epidural anesthesia were approached; 51 patients were eligible and consented. The mean age was 68, 55% were women, and there was a high prevalence of comorbid medical disease. No patient was demented pre-operatively."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Random allocation to either continuous epidural infusion of bupivacaine and fentanyl or continuous intravenous infusion of fentanyl. Infusions were initiated at the first complaint of pain and continued through the 36- to 48-hour stay in the recovery room."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Acute post-operative delirium defined using an algorithm based on DSM III criteria."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The overall incidence of acute delirium was 41%, with no difference between types of post-operative analgesia. Predictors of delirium were age, gender, and pre-operative alcohol use. All cases resolved within 1 week, and length of stay and achievement of physical therapy goals were the same for delirious and non-delirious patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "There is a high incidence of post-operative delirium in elderly non-demented patients following bilateral knee replacement, regardless of whether post-operative analgesia is administered by the epidural or intravenous route."
        }
      ]},
