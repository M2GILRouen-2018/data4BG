        "CopyrightInformation": "Published by the BMJ Publishing Group Limited. For permission to use (where not already granted under a licence) please go to http://www.bmj.com/company/products-services/rights-and-licensing/",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine the prevalence of vitamin D deficiency (<37.5\u2005nmol/L) among young adolescents in Malaysia and its association with demographic characteristics, anthropometric measures and physical activity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "This is a cross-sectional study among Form 1 (year 7) students from 15 schools selected using a stratified random sampling design. Information regarding sociodemographic characteristics, clinical data and environmental factors was collected and blood samples were taken for total vitamin D. Descriptive and multivariable logistic regression was performed on the data."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "National secondary schools in Peninsular Malaysia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "1361 students (mean age 12.9±0.3\u2005years) (61.4% girls) completed the consent forms and participated in this study. Students with a chronic health condition and/or who could not understand the questionnaires due to lack of literacy were excluded."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Vitamin D status was determined through measurement of sera 25-hydroxyvitamin D (25(OH)D). Body mass index (BMI) was classified according to International Obesity Task Force (IOTF) criteria. Self-reported physical activity levels were assessed using the validated Malay version of the Physical Activity Questionnaire for Older Children (PAQ-C)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Deficiency in vitamin D was seen in 78.9% of the participants. The deficiency was significantly higher in girls (92.6%, p<0.001), Indian adolescents (88.6%, p<0.001) and urban-living adolescents (88.8%, p<0.001). Females (OR=8.98; 95% CI 6.48 to 12.45), adolescents with wider waist circumference (OR=2.64; 95% CI 1.65 to 4.25) and in urban areas had higher risks (OR=3.57; 95% CI 2.54 to 5.02) of being vitamin D deficient."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The study shows a high prevalence of vitamin D deficiency among young adolescents. Main risk factors are gender, ethnicity, place of residence and obesity."
          }
        ]
      },
