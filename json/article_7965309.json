      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "In this study, the long-term evaluation after surgical treatment of temporomandibular joint with manifested degenerative changes and internal derangement is described. The surgical procedure, including extensive exploration and remodeling of the joint, with interposition of lyophilized human costochondral cartilage, is described."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Thirty-two cases (37 joints) were evaluated at a mean follow-up time of 3.1 and 8.6 years after the surgical treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A significant reduction of dysfunction and pain symptoms was achieved in most cases."
        }
      ]},
