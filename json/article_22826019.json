      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to conduct a preliminary evaluation of Children's Appetite Awareness Training (CAAT), a treatment for childhood obesity which encourages overweight children to eat in response to internal appetite cues."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Overweight children (ages 6-12 years old) were randomized to either the CAAT treatment group (N = 23), to receive 1-h treatment sessions over 6 weeks, or a wait-list group (N = 24). Weight and height of children and parents in both groups were assessed at pre- and post-treatment (or equivalent time for wait-list control) and at a 6-month follow-up for those in the CAAT group."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The intervention had a significant, short-term effect on the BMI of children who participated. Although at 6-month follow-up, children's BMI has not increased significantly, the difference between pretreatment and follow-up BMI was no longer significant."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "These results are encouraging for the use of CAAT with overweight children. Long-term effectiveness could be enhanced through increasing the duration of the program, adding booster sessions and increased involvement of parents."
          }
        ]
      },
