      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Technical case report."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe the novel technique of percutaneous endoscopic herniotomy using a unilateral intra-annular subligamentous approach for the treatment of large centrally herniated discs."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Open discectomy for large central disc herniations may have poor long-term prognosis due to heavy loss of intervertebral disc tissue, segmental instability, and recurrence of pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Six consecutive patients who presented with back and leg pain, and/or weakness due to a large central disc herniation were treated using percutaneous endoscopic herniotomy with a unilateral intra-annular subligamentous approach."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The patients experienced relief of symptoms and intervertebral disc spaces were well maintained. The annular defects were noted to be in the process of healing and recovery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Percutaneous endoscopic unilateral intra-annular subligamentous herniotomy was an effective and affordable minimally invasive procedure for patients with large central disc herniations, allowing preservation of nonpathological intradiscal tissue through a concentric outer-layer annular approach."
        }
      ]},
