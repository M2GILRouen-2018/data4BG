      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To test whether plasma BDNF levels are useful to predict the presence of endometriosis in women with pelvic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS & METHODS",
          "content": "Prospective cross-sectional study including 67 consecutive women aged 24-49 years, scheduled for laparoscopy due to chronic pelvic pain. Preoperative plasma samples were assayed for BDNF using a commercial enzyme immunoassay."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Women with ovarian endometrioma had higher preoperative plasma BDNF (1063 ± 157 pg/ml) compared with women with other benign ovarian tumors (537 ± 131 pg/ml, F = 2.53; p = 0.02). However, plasma BDNF levels were not helpful to indicate the presence of peritoneal or deep infiltrating endometriosis. Plasma BDNF levels were positively correlated with the severity of pelvic pain (r = 0.489; p < 0.0001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Plasma BDNF might be a biomarker of ovarian endometrioma but not a useful diagnostic marker to detect other forms of endometriosis in women with painful symptoms."
        }
      ]},
