      },
      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "To investigate whether betamethasone decreases the incidence of postoperative nausea/vomiting (PONV) and reduces postoperative pain following partial mastectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective randomized, double-blinded study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Operating room and Postanesthesia Care Unit of a university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "80 ASA physical status 1 and 2 women scheduled for elective breast cancer surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients were randomly allocated to two groups in double-blinded fashion: Group B (betamethasone; 37 pts) and Group C (control; 38 pts). Group B received 8 mg of betamethasone intravenously before the start of surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "The rate of PONV and pain were recorded using a numeric rating scale (NRS; 0-10), as well as rescue doses of antiemetics (ondansetron) and analgesics (ketobemidone)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "There was a significant lower incidence of postoperative nausea (PON) scoring NRS ≥ 1 in Group B in the 4 to 12-hour period compared with Group C (P = 0.02). The cumulative incidence of PON was 57% in Group B versus 68% in Group C (P = 0.27). The overall incidence of postoperative vomiting (POV) was 18% and 20% in Groups B and C, respectively. Postoperative pain was reduced by 40% in Group B in the 4 to 12-hour period, but the mean dose of postoperative rescue analgesic did not differ between the groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Preoperative betamethasone reduces the severity of PONV and pain in patients undergoing elective breast surgery."
          }
        ]
      },
