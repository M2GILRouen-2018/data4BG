      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Survivors of lower extremity (LE) malignancies experience functional deficits."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The purpose of this prospective clinical trial was to determine feasibility and functional outcomes of adding pre-habilitation during the 10-12 week period prior to a planned surgery to remove the tumor in children and adolescents with a LE sarcoma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Pilot study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "St. Jude Children's Research Hospital (SJCRH)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Participants included 14 individuals between the ages of 8 and 20 years who were diagnosed with a LE sarcoma. Participant outcomes were compared to a control group of 35 individuals treated for osteosarcoma that obtained the same functional assessments but no pre-habilitation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "The intervention group received strengthening exercises and mobility training 3 times per week for 30-60 minutes for 10-12 weeks preoperatively."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Participants completed the Functional Mobility Assessment (FMA) and measures of strength and range of motion (ROM) of bilateral lower extremities (BLEs) at baseline, after 10-12 weeks of preoperative PT, and at 20-22 weeks."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Twelve participants completed at least 50% of their schedule pre-habilitative sessions. The intervention group scored significantly better on the FMA than the control group at weeks 20-22 (35.6 vs. 25.7, p .0267). No significant difference was found in ROM or strength."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "LIMITATIONS",
          "content": "Due to this study being a pilot study, the sample size was small. Therefore, we cannot infer generalizability."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Findings suggest that those diagnosed with a LE malignancy awaiting a limb sparing procedure or amputation participate in at least 50% of scheduled PT sessions and benefit from them."
        }
      ]},
