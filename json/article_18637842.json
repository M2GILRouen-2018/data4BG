      "Abstract": {
        "CopyrightInformation": "© 2016 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Recurrent joint hemarthroses due to hemophilia (Factor VIII and Factor IX deficiency) often lead to invasive orthopedic interventions to decrease frequency of bleeding and/or to alleviate pain associated with end-stage hemophilic arthropathy."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "Identify trends in invasive orthopedic interventions among people with hemophilia who were enrolled in the Universal Data Collection (UDC) program during the period 2000-2010."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Data were collected from 130 hemophilia treatment centers in the United States annually during the period 2000-2010, in collaboration with the Centers for Disease Control and Prevention (CDC). The number of visits in which an invasive orthopedic intervention was reported was expressed as a proportion of the total visits in each year of the program. Invasive orthopedic interventions consisted of arthroplasty, arthrodesis, and synovectomy. Joints included in this study were the shoulder, elbow, hip, knee, and ankle."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A 5.6% decrease in all invasive orthopedic interventions in all joints of people with hemophilia enrolled in the UDC program over the 11-year study period was observed."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "These data reflect a declining trend in invasive orthopedic interventions in people with hemophilia. Further research is needed to understand the characteristics that may influence invasive orthopedic interventions."
          }
        ]
      },
