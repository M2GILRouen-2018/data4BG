      "Abstract": {
        "CopyrightInformation": "© The International Society for Prosthetics and Orthotics 2015.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Collateral ligament shortening causes extension contractures of the metacarpophalangeal joint, and dynamic flexion splinting has been widely used to treat these contractures; however, there are various problems with these approaches. We developed a novel, pneumatic-type dynamic traction and flexion splint to solve these problems."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE DESCRIPTION AND METHODS",
            "content": "A total of 25 fingers were treated with the dynamic traction and flexion splint for 8\u2009weeks. Every 2\u2009weeks, the average metacarpophalangeal joint flexion angle, total active motion, grasp strength, and pain scores were assessed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS AND OUTCOMES",
            "content": "The finger flexion angle was significantly greater at the final evaluation, starting after 6\u2009weeks of treatment (p\u2009<\u20090.05), than prior to treatment. Similarly, the total active motion results improved significantly over 8\u2009weeks."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our results show that use of the dynamic traction and flexion splint improves patient finger functioning and flexural angle."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL RELEVANCE",
            "content": "The dynamic traction and flexion (DTF) splint appears to be effective for treating patients."
          }
        ]
      },
