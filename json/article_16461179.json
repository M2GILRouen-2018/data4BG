      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To present a case of an uncommon presentation of cellulitis of the neck as benign neck pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CLINICAL FEATURES",
          "content": "A 44-year-old man had severe neck pain and headaches for 2 weeks with an unknown cause. Minimal response to chiropractic treatment leads to coordination of treatment with the patient's primary care physician. Laboratory assessment and magnetic resonance imaging initially were viewed as insignificant but were repeated and showed a retropharyngeal abscess."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "INTERVENTION AND OUTCOME",
          "content": "Chiropractic treatment did not reduce the patient's neck pain as expected. Fusion of C1 to C2 was eventually performed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Neck pain is a common reason for patients to seek chiropractic care. This case shows an uncommon differential diagnosis for a patient who does not respond quickly to chiropractic treatment for neck pain."
        }
      ]},
