      "Abstract": {
        "CopyrightInformation": "© 2015 NANDA International, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "This study aims to evaluate the psychometric properties and sensitivity to change of the Spanish version of the Pain Level Outcome Scale."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This article applied observational longitudinal validation study with patients suffering from acute pain at three hospitals."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "The study included 73 patients. Inter-rater agreement was kappa = .88 and internal consistency α = .93. Principal components analysis yielded four components that explained 81.86% of the variance; the correlation with the Numerical Pain Intensity Scale was r = -.81."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The version with 17 indicators shows good psychometric properties and adequate sensitivity to change. A Spanish version of the Pain Level Outcome Scale with 17 indicators is proposed as a structured multidimensional instrument to help nurses choose the most appropriate indicators for assessing patients' pain."
          }
        ]
      },
