      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Society for Gastrointestinal Endoscopy. Published by Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Comfort during colonoscopy is a critical component of safety and quality."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To develop and validate the Nurse-Assessed Patient Comfort Score (NAPCOMS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective scale validation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Colorectal cancer screening centers in the United Kingdom and Canada."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "A total of 300 consecutive patients undergoing colonoscopy at participating colorectal cancer screening centers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "The NAPCOMS was developed by using a modified Delphi process. During colonoscopy, two endoscopy room nurses independently observed and rated patient comfort and tolerability by using NAPCOMS. In addition, endoscopists reported global comfort scores and patients' reported global comfort by using visual 4-point Likert and National Health Service-United Kingdom Global Rating Scales."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASUREMENTS",
            "content": "Reliability and validity of NAPCOMS was measured by using intraclass correlations (ICC) between nurse ratings of colonoscopies and between NAPCOMS, endoscopist ratings, and patient ratings of global comfort."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The ICC for the overall NAPCOMS was 0.84 (95% confidence interval [CI], 0.80-0.87). There was high agreement between the NAPCOMS and endoscopist ratings of comfort (ICC = 0.77; 95% CI, 0.72-0.81), moderate agreement between the NAPCOMS and patient ratings (ICC = 0.61; 95% CI, 0.53-0.67), and moderate agreement between the endoscopist and patient ratings (ICC = 0.52; 95% CI, 0.43-0.60)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "NAPCOMS was validated in outpatients who received colonoscopy with minimal to moderate sedation as part of a screening and surveillance program, so performance among inpatients or those requiring deep sedation was not tested."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "NAPCOMS is a reliable and valid tool for assessing patient comfort in the setting of outpatient colonoscopy performed with minimal to moderate sedation."
          }
        ]
      },
