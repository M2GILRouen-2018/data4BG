      "Abstract": {
        "CopyrightInformation": "© 2014 John Wiley & Sons A/S. Published by John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "The aim of this study was to compare the clinical and aesthetic outcomes of two different surgical approaches for the treatment of deep gingival recession affecting the mandibular incisors."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Fifty patients with Miller class I and II gingival recessions (≥ 3 mm) in the lower incisors were enrolled. Twenty-five patients were randomly assigned to the control group and the other 25 patients to the test group. All defects were treated with the coronally advanced flap + connective tissue graft (CAF + CTG) and in the test group the labial submucosal tissue (LST) was removed. Post-operative morbidity was evaluated at 1 week. Clinical and aesthetic evaluations were made at 1 year."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Statistically greater recession reduction, probability of CRC (adjusted OR 7.94 95% CI = 1.88-33.50, p = 0.0024) and greater increase in GT were observed in the test group. Greater graft exposure and increase in KTH were demonstrated in the control group. Better aesthetics outcomes were observed in the test group. No statistically significant between groups differences were demonstrated in patient analgesic assumption and post-operative discomfort and bleeding."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "LST removal during CAF + CTG surgery is indicated to provide better root coverage and aesthetic outcomes in the treatment of gingival recessions affecting the lower incisors."
          }
        ]
      },
