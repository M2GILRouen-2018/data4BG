      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Pediatric otolaryngology clinics have tremendous access to children with allergic conditions, yet no research has evaluated in this setting environmental tobacco smoke and the occurrence of atopic diseases."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Caregivers or parents of 201 consecutive patients in a Hungarian pediatric otolaryngology clinic were queried on otolaryngologic conditions; self-reported diagnoses of atopic diseases; and tobacco smoke exposure."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A history of asthma was reported in 10.3% of children; 38.7% had at least one parent who smoked. Fifteen out of the 20 children with asthma (75.0%) had at least one parent who smoked. Having a diagnosis of hay fever and having a parent who smoked greatly increased the odds of having a diagnosis of asthma."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Second hand smoke exposure among children in an otolaryngology clinic was common, and was associated with co-existing atopic conditions. Pediatric otolaryngologists have an important opportunity to address parental smoking as part their care of children."
          }
        ]
      },
