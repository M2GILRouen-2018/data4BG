      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVES",
            "content": "The aim of this study was to clarify mechanisms of psychological fibromyalgia treatment by experimentally examining the effectiveness of its core elements. We assessed the effects of cognitive restructuring and acceptance on experimentally-induced heat and cold pain tolerance and pain intensity in fibromyalgia patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Cold and heat pain were induced in a sample of 60 fibromyalgia patients using a thermode. We conducted ANCOVAs to examine group differences in posttest scores, co-varying for pretest scores. The between-groups factor was the type of instruction provided (acceptance, cognitive restructuring, and a control condition). In addition, we controlled for pain sensitivity, age, and depression."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We found that acceptance and cognitive restructuring were superior to the control condition in increasing heat pain tolerance, but did not differ from one another. With respect to cold pain tolerance, cognitive restructuring was associated with increases in cold pain tolerance compared to the control condition, while acceptance did not differ either from the control condition or from cognitive restructuring."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "Further experimental research on chronic pain treatment mechanisms is needed, particularly research on individually tailoring treatment strategies according to patients characteristics."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Results show that both, cognitive restructuring and acceptance instructions, enhance pain tolerance in fibromyalgia patients."
          }
        ]
      },
