      "Abstract": {
        "CopyrightInformation": "© 2014 BSPD, IAPD and John Wiley & Sons A/S. Published by John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Besides the clinical aspects, the patient's perspective of oral health-related quality of life (OHRQoL) may be influenced by a series of individual characteristics."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "The aim was to investigate the impact of clinical and psychosocial variables on the OHRQoL of Brazilian schoolchildren."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A school-based cross-sectional study was conducted with children of 8-10 year old attending public (15) and private (5) schools (n = 749). Questionnaires were applied to parents to obtain socioeconomic characteristics, and children were interviewed. Assessment of OHRQoL was performed using the Child Perceptions Questionnaire 8-10 (CPQ). Oral health examinations included periodontal condition, dental caries, dental trauma, and malocclusion assessment. Unadjusted analyses were undertaken using t-tests and one-way analysis of variance. Multiple linear regression was used to assess the effects of independent variables on CPQ scores."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Factors associated with higher CPQ scores in the linear regression analysis after adjustments were family income, presence of decayed teeth, self-reported dental trauma, dental fear, and dental pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Oral health-related quality of life was influenced by psychosocial and clinical variables."
          }
        ]
      },
