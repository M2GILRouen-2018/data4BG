      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether obesity is associated with adverse pathologic characteristics, positive surgical margins and the biochemical recurrence free survival (bRFS) after primary treatment with radical prostatectomy (RP)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Medical charts of patients managed with RP between 1999 and 2011 for localized prostate cancer (PCa) were retrospectively reviewed. Population study was split into two groups according to the body mass index (BMI): non obese (BMI< 30 kg/m(2)) and obese (BMI ≥ 30 kg/m(2)). Correlations between obesity and adverse pathological features or bRFS were assessed using univariable and multivariable analyses."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Overall, 328 patients were included in the present study: 278 (84.8%) obese and 50 (15.2%) non obese. In multivariable analysis, obesity was associated with positive surgical margins (P=0.014), extracapsular extension (P=0.004) and pathologic Gleason score ≥ 7 (P=0.048). Obesity was not associated with seminal vesicle invasion (P=0.636) and lymph node metastasis (P=0.132). After a mean follow-up of 60.51 ± 28.82 months, no statistical difference in terms of bRFS was observed between the two groups (P=0.186). Furthermore, obesity was not an independent predictor of bFS in multivariable analysis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Obesity was associated with adverse pathologic characteristics and positive surgical margins but no statistical correlation was found with bRFS."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": 5
          }
        ]
      },
