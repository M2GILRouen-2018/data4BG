      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To perform a bibliographic review on criterion-based use of drugs by children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SOURCES",
          "content": "Articles were searched through Medline database using the terms: acute respiratory diseases, asthma, antibiotics, treatment and children."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "SUMMARY OF THE FINDINGS",
          "content": "There is an excessive use of drugs to treat acute respiratory diseases and asthma. Drugs with unproved action are frequently prescribed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Considering the toxicity of many drugs used in children and the emergency of bacterial strains resistant to antibiotics, it is essential to develop new methods of diagnosing bacterial infections, as well as to educate both physicians and the general public on the judicious use of drugs."
        }
      ]},
