      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To review the differences and similarities of the meta-analyses dealing with asthma immunotherapy (IT)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Published papers by Abramson et al (Am J Respir Crit Care Med 1995;151:969-974) and Ross et al (Clin Ther 2000;22:329-341)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Based on the review of published data concerning meta-analyses of published clinical studies using IT to treat asthma, it is an effective treatment. IT can significantly reduce asthma symptoms and medication requirements. Both specific and nonspecific bronchial hyperresponsiveness were decreased, but improvement as measured by lung function tests was inconsistent."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "IT needs to be considered in the treatment of allergic asthmatic patients."
        }
      ]},
