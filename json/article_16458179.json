      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To review recently published studies that describe the presence of selected cancer-related symptoms and relationships between them in the gero-oncology population."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Research studies, review articles, and government documents."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Cancer-related symptoms have been studied for over two decades, yet little is known about the functional effects of age on the disease experience."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Nurses are encouraged to consider symptoms related to other chronic illnesses that contribute to an older person's daily living when planning oncology nursing care."
        }
      ]},
