      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A 15-year-old boy presented with recurrent episodes of erythema and burning pain in the distal extremities, which he had experienced since early childhood. The episodes were triggered by heat or exertion. His medical history revealed an extensive six-generation family history of similar symptoms."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INVESTIGATIONS",
          "content": "Neurological examination, MRI brain scan, electromyography, skin biopsy, laboratory blood testing, and DNA analysis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DIAGNOSIS",
          "content": "Juvenile onset primary erythromelalgia."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MANAGEMENT",
          "content": "Genetic counseling, and symptomatic management of neuropathic pain."
        }
      ]},
