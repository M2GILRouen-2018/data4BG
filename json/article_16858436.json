      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To describe the use of disposable 31-gauge needles for intraocular injections."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Description of the technique and photographs of the needles."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients feel the injection less and a smaller postinjection bleb is noted."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Consideration should be given to the use of disposable 31-gauge needles or syringes for intraocular injections."
        }
      ]},
