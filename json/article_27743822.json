      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 SPLF. Published by Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Lung resection for cancer is the cause of significant postoperative pain. The aim of this study was to determine whether pulmonary rehabilitation could induce a resurgence of pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In 2014 and 2015, pulmonary rehabilitation was offered to all patients referred to our institution after lung resection for cancer. Patients were assessed at entry and departure for nociceptive pain, neuropathic pain (DN4), for quality of life using questionnaire EORTC QlQ-C30 and for anxiety and depression (HAD questionnaire). Pain was studied before and after the sessions of cycloergometer, gym and massages."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "During the period, 99 patients were admitted to our institution following lung resection for cancer. Medians changed during pulmonary rehabilitation from 3 to 1 for nociceptive pain (p<0.001), 3 to 3 for DN4 (NS), 50 to 67 for the quality of life score (p<0.001), 7 to 5 for the anxiety (p<0.001) and 5 to 3 for depression (p<0.0001). Pain remained stable during the sessions of cycloergometer and gym, and decreased during massage. Patients undergoing thoracotomy or video-assisted thoracic surgery evolved identically."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Postoperative pulmonary rehabilitation after lung resection for cancer was not harmful. It was associated with a decrease in nociceptive pain and was without effect on neuropathic pain."
          }
        ]
      },
