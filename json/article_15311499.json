      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the roles of IL-18 in the perennial allergic rhinitis (PAR)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "We measured IL-18 concentration in sera of 30 PAR patients and 20 health control subjects with enzyme-linked immunosorbent assay (ELISA)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "The concentration of IL-18 in PAR patients [(424.12 +/- 60. 47) ng/L] was significantly higher compared to health control subjects [(210.71 +/- 57. 37) ng/L](P<0.01) and the concentration of L-18 in PAR patients with asthma [(591.19 +/- 46.54) ng/L] was significantly higher than those without asthma [(352.52 +/- 64.25) ng/L](P<0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The IL-18 is high in PAR patients and the persistence of elevated IL-18 concentration suggests its role in the expression of persistence and exacerbation of allergic inflammation."
        }
      ]},
