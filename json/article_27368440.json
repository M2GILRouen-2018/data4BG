      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe physician and parent behavior during pediatric otolaryngology surgical consultations, and to assess whether perceptions of shared decision-making and observed behavior are related."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Parents of 126 children less than 6-years of age who underwent consultation for adeontonsillectomy or tympanostomy tube insertion were prospectively enrolled. Parents completed the Shared Decision-Making Questionnaire-Patient version (SDM-Q-9), while surgeons completed the Shared Decision-Making Questionnaire-Physician version (SDM-Q-Doc) after the consultation. Visits were video-recorded and analyzed using the Roter Interaction Analysis System to quantify physician and parent involvement during the consultation."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Perceptions of shared decision-making between parents (SDM-Q-9) and physicians (SDM-Q-Doc) were significantly positively correlated (p = 0.03). However, there was no correlation between parents' perceptions of shared decision-making and observations of physician and parent behavior/involvement (proportion of physician socioemotional talk, task-focused talk, or proportion of parent talk). Surgeons' perceptions of shared decision-making were correlated with physician task-focused talk and proportion of parent talk."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Parents and physicians had similar perceptions of the degree of shared decision-making to be taking place during pediatric otolaryngology consultations. However, there was variability in the degree to which parents participated, and parent perceptions of shared decision-making were not correlated with actual observed involvement."
          }
        ]
      },
