      "Abstract": {
        "CopyrightInformation": "© 2014 by the Association of Clinical Scientists, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Adipose tissue cells produce cathepsins L and S, which have proatherogenic effects. Obesity is strongly linked to atherogenesis, cardiovascular morbidity, and mortality."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of the present study was to see if life style interventions/weight reduction could decrease cathepsin L and S levels in blood plasma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Study subjects (n=31) were recruited to a life style intervention program aiming at increased physical activity, more healthy eating habits, and weight reduction for most of the participants. Blood samples were collected at inclusion and after 4 and 8 weeks."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Cathepsin L was significantly reduced at 4 weeks (p<0.0001) and 8 weeks (p=0.0004). A similar reduction was also seen for cathepsin S at 4 weeks (p=0.03) and 8 weeks (p=0.008). No significant change in fractalkine values was observed at 4 weeks (p=0.58), but a significant increase was apparent at 8 weeks (p=0.0002)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The intervention program resulted in significant reductions of cathepsin L and S levels in plasma after 4 and 8 weeks of intervention."
          }
        ]
      },
