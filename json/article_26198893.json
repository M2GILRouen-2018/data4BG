      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2015.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "We investigated the effects of inducing an illusion of motion by tendon vibration on sensory and emotional aspects of pain and range of motion in patients with fractures of the distal radius."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A quasi-randomized controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Kawachi General Hospital, Japan."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "A total of 26 patients with fractures of the distal radius were distributed quasi-randomly to either the illusory kinesthesia group (n\u2009=\u200913) or control group (n\u2009=\u200913)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "The intervention was performed on seven consecutive days from postoperative Day 1. Evaluation was performed at seven days, one month, and two months after the surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN MEASURES",
            "content": "Data were collected for pain at rest, movement pain, the pain catastrophizing scale, the Hospital Anxiety and Depression Scale, and range of motion."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The illusory kinesthesia group reported improved pain at rest (p\u2009<\u20090.001), movement pain (p\u2009<\u20090.001), pain catastrophizing scale (p\u2009<\u20090.001), Hospital Anxiety and Depression Scale (p\u2009<\u20090.01), and range of motion (p\u2009<\u20090.05) compared with the control group at seven days, one month, and two months after the surgery. The mean (SD) score of the visual analogue scale of pain at rest was 51.3 (16.8) at one day and 4.2 (4.7) at seven days in the illusory kinesthesia group, and 56.8 (22.1) at one day and 35.5 (16.2) at seven days in the control group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Illusory kinesthesia group improves the sensory and emotion aspects of pain in patients with fractures of the distal radius."
          }
        ]
      },
