      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether changes in motor performance after a course of exercise in patients with mechanical neck pain (MNP) were dependent on the primary behavioral demand of the exercise performed."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University laboratory."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Volunteers (N=60; 35 women, 25 men; mean age, 37.9y) with chronic MNP participated in the study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Exercise targeted to improve cervical motor performance including endurance training (ETr; n=20), coordination training (CTr; n=20), and active mobility training (n=20)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Changes in the cervical motor performance domains of strength, endurance, coordination, and active mobility were evaluated immediately after the 10-week training program, and at a 26-week follow-up."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Between-group comparisons revealed significantly greater gains in endurance (P<.02) by the ETr group, and significantly greater gains in coordination (P<.01) by the CTr group. All 3 groups had improvement in pain (P<.01) and disability (P<.01)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Changes in motor performance in individuals with MNP in response to an exercise program were dependent on the specific mode of exercise performed, with minimal improvement in other domains of motor performance."
          }
        ]
      },
