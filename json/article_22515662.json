      "Abstract": {
        "CopyrightInformation": "© The Authors. Developmental Medicine & Child Neurology © 2012 Mac Keith Press.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "Theta-burst stimulation (TBS) is a lower intensity, high-frequency repetitive transcranial magnetic stimulation technique developed recently for quantifying and modulating cerebral cortical function. Nearly all published studies have involved adults. The aim of this study was to obtain safety data as a basis for evaluating potential risks versus benefits of TBS research in children."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Forty participants under 18 years: 16 with Tourette syndrome (five females, 11 males; mean age 12y, SD 2y 10mo) and 24 typically developing children (12 females, 12 males; mean age 12y 11mo, SD 2y 10mo) underwent intermittent or continuous TBS over the left motor cortex. Open questions, a structured 16-question review of systems, and visual analog mood scale (VAMS) were administered before and after TBS. A Wilcoxon signed-rank sum test was used to analyze differences in VAMS scores before and after TBS."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There were no serious adverse events. Five of the 40 children reported mild, self-limited adverse events: a subjective sensation of finger twitching (n=1), neck stiffness (n=1), and mild headache (n=3). The total adverse event rate was 11.6%. There was no significant change in VAMS score in either group after one session of TBS."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "INTERPRETATION",
            "content": "A single session of TBS in children appears to be safe and well tolerated."
          }
        ]
      },
