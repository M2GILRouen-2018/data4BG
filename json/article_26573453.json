      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To compare effects of kinesio taping with sham taping at the end of 3 consecutive taping periods in knee osteoarthritis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "41 patients diagnosed with knee osteoarthritis according to American College of Rheumatology were randomized to receive either KT or sham taping. Baseline evaluations included a visual analog scale (VAS) for activity and nocturnal pain, Lequesne index for functional assessment and Nottingham Health Profile (NHP) for the quality of life. Taping was applied every four days, three times, and all of the assessments were repeated at the end of the treatment period."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In both groups VAS for activity pain, VAS for nocturnal pain, Lequesne index score, NHP score decreased significantly. NHP energy scores were different significantly between the groups in favor of sham taping at the end of the 12-day period."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Our findings indicate inconclusive evidence of a beneficial effect of kinesio taping over sham taping in knee osteoarthritis."
          }
        ]
      },
