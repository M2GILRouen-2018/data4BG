      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To evaluate the effect of sucrose solution given by mouth on infant crying times and measures of distress in the immunisation clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomised, double blind, placebo controlled trial of sucrose solution 75% wt/vol v sterile water as a control."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The immunisation clinic of the Women's and Children's Hospital, Adelaide."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "A total of 107 healthy infants attending for 2, 4, or 6 month immunisations with polio by mouth (Sabin), intramuscular diphtheria, tetanus, and pertussis (DTP), and intramuscular Haemophilus influenzae type b were randomised to receive 2 ml 75% sucrose solution or sterile water by mouth before the two injections."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The duration of infant crying was recorded during and immediately after two intramuscular immunisations and infant distress was assessed by a visual analogue scale (Oucher scores) independently by a nurse and a parent."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The administration of 2 ml 75% sucrose solution by mouth reduced the infant crying time and Oucher distress scores after immunisation with DTP/H influenzae type b."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Infant immunisation by intramuscular injection is a distressing procedure for infants and parents. Sucrose solution at a high concentration reduces infant distress and is safe and clinically useful in this setting."
        }
      ]},
