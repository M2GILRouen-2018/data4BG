      "Abstract": {
        "CopyrightInformation": "Copyright 2006 John Wiley & Sons, Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The objective of this review is to evaluate whether clinical research has gained any evidence of effectiveness of Rosa canina preparations."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Several databases and other sources were searched to identify randomized controlled trials of Rosa canina preparations."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Trials were described in a narrative way, taking into consideration methodological quality scores. Four trials were included in this review and two were identified as subgroup analyses."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Moderate evidence exists for the use of a powder of the seeds and husks of a Rosa canina subspecies in patients suffering from osteoarthritis."
          }
        ]
      },
