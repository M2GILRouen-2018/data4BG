      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Although obesity putatively occurs when individuals consume more calories than needed for metabolic needs, numerous risk factor studies have not observed significant positive relations between reported caloric intake and future weight gain, potentially because reported caloric intake is inaccurate."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The present study tested the hypothesis that objectively measured habitual energy intake, estimated with doubly labeled water, would show a stronger positive relation to future weight gain than self-reported caloric intake based on a widely used food frequency measure."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Two hundred and fifty-three adolescents completed a doubly labeled water (DLW) assessment of energy intake (EI), a food frequency measure, and a resting metabolic rate (RMR) assessment at baseline, and had their body mass index (BMI) measured at baseline and at 1- and 2-year follow-ups."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Controlling for baseline RMR, elevated objectively measured EI, but not self-reported habitual caloric intake, predicted increases in BMI over a 2-year follow-up. On average, participants under-reported caloric intake by 35%."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "RESULTS provide support for the thesis that self-reported caloric intake has not predicted future weight gain because it is less accurate than objectively measured habitual caloric intake, suggesting that food frequency measures can lead to misleading findings. However, even objectively measured caloric intake showed only a moderate relation to future weight gain, implying that habitual caloric intake fluctuates over time and that it may be necessary to conduct serial assessments of habitual intake to better reflect the time-varying effects of caloric intake on weight gain."
          }
        ]
      },
