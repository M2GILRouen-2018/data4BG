      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "Report a series of patients with exposure keratopathy following phacoemulsification under local anaesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A case series."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Four patients were found to have exposure keratopathy within hours after surgery resulting in a visit to the casualty on the day of surgery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "One should anticipate the possibility of lagophthalmos and assess the blink reflex at the end of surgery. If the reflex is poor, patching the eye or taping the lids should be undertaken to prevent this complication."
        }
      ]},
