      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To present a case of optic disc swelling caused by sinusitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Ocular symptoms were investigated using computed tomography imaging of the facial bones to detect the relationship between the sinus inflammation and the optic nerve."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A particular configuration of the optic nerve was detected. Optic nerve course through the inflamed sphenoidal sinus is a condition associated with a greater risk of inflammation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Sinusitis is a rare but treatable cause of optic neuritis. The choice of the correct radiological investigation to be done to set up a proper treatment of the sinus pathological condition is also essential for the resolution of ocular symptoms."
        }
      ]},
