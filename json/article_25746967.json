      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Academy of Allergy, Asthma & Immunology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Inpp5d (Src homology 2 domain-containing inositol-5-phosphatase [Ship1])-deficient mice experience spontaneous airway inflammation and have enhanced sensitivity to allergen-induced airway inflammation."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We hypothesized that lineage-specific deletion of Ship1 expression in cells known to be crucial for adaptive TH2 responses would uncover distinct roles that could either positively or negatively regulate susceptibility to allergic airway inflammation (AAI)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Ship1 expression was deleted in B cells, T cells, or dendritic cells (DCs), and the resulting Ship1(ΔB cell), Ship1(ΔT cell), Ship1(ΔDC), or Ship1(F/F) (wild-type) control mice were evaluated in a model of house dust mite (HDM)-induced AAI."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Unlike germline panhematopoietic Ship1 deletion, deletion of Ship1 selectively in either the B-cell, T-cell, or DC lineages did not result in spontaneous airway inflammation. Strikingly, although loss of Ship1 in the B-cell lineage did not affect HDM-induced AAI, loss of Ship1 in either of the T-cell or DC lineages protected mice from AAI by skewing the typical TH2 immune response toward a TH1 response."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Although panhematopoietic deletion of Ship1 leads to spontaneous lung inflammation, selective deletion of Ship1 in T cells or DCs impairs the formation of an adaptive TH2 response and protects animals from HDM-induced AAI."
          }
        ]
      },
