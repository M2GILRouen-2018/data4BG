      "Abstract": {"AbstractText": [
        {
          "Label": "UNLABELLED",
          "content": "Escolar-Reina P, Medina-Mirapeix F, Gascón-Cánovas JJ, Montilla-Herrador J, Valera-Garrido JF, Collins SM. Self-management of chronic neck and low back pain and relevance of information provided during clinical encounters: an observational study."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the relative influence of information provided during physical therapy on a patient's adherence to self-management strategies in relation to other predictors of adherence (patient and pain characteristics, use of self-management strategies before intervention)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A longitudinal observational study of the relationship between the information provided during physical therapy and adherence to self-management strategies."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Data came from a clinical-based population in 8 primary health care centers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Patients (N=184) with chronic neck or low back pain (77% under the age of 59y) were surveyed at the beginning and 1 month after completion of physical therapy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Not applicable."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Specific and overall adherence to 2 types of strategies: (1) nonpharmacologic pain management strategies, and (2) neck/back care in activities of daily life."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Adherence to strategies of nonpharmacologic self-management of pain was more probable when patients received information explaining the effectiveness of the self-management strategies (adjusted odds ratio [AOR]=10.1; P<.05) and information about their illness (AOR=3.4; P<.05) during clinical encounters. Information provided by the physical therapist did not have any influence on the adherence to neck/back care in activity of daily life (P>.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Information provided during clinical encounters is associated with adherence to different kinds of self-management strategies. While further study is required, it is suggested that more attention be given to clinical practice strategies for improving adherence to self-management of chronic pain."
        }
      ]},
