      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "Single photon emission computed tomography (SPECT) bone scans of the lumbar spine were evaluated in the management of patients with low back pain and suspected spondylolysis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Thirty-three patients (mean age, 30 years) with high clinical suspicion of pars interarticularis defects were included in the study. The results of lumbar radiographs and SPECT bone scintigraphy were compared and the influence of these results on patient management was evaluated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Twenty-six of the 33 patients had abnormal results of lumbar radiographs. Of the 21 patients with radiographs indicating spondylolysis, six had abnormal uptake in the pars regions on bone scintigraphy. One patient with normal results of lumbar radiographs had a SPECT bone scan showing uptake in the region of the pars interarticularis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "SPECT bone scanning of the lumbar spine has a role in the treatment of patients with symptomatic spondylolysis."
        }
      ]},
