      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To review the problem of bone metastases and strategies aimed at the management of bone metastases."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Review articles, book chapters, research studies, and clinical practice."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "As patients survive for longer periods, effective management of bone metastases becomes critical to maintaining or improving quality of life. Controlling pain, preventing fractures and oncologic emergencies, and promoting mobility and function are the outcomes of successful management."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Use of a clinical algorithm may assist the nurse in identifying bone metastases and managing the clinical sequelae, such as pain."
        }
      ]},
