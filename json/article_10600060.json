      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "Describe self-reported and measured height, weight, and body mass index (BMI) stratified by sex and ethnicity in the United States, explore ethnic variations in the likelihood of under-reporting BMI, and investigate pathways linking race/ethnicity to the underassessment of BMI."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "An observational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The entire United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS OR PARTICIPANTS",
          "content": "Data were from the 2007-2008 National Health and Nutrition Examination Survey, a nationally representative sample of non-institutionalized civilian Americans."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MAIN OUTCOME",
          "content": "Objectively measured and subjectively reported BMI."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASURES",
          "content": "Independent variables include race/ethnicity (non-Hispanic Whites, non-Hispanic Blacks, Hispanics, and others), sex, age groups (age 20-29, 30-49, 50-69, and > or =70), marital status (currently married vs other marital categories), education (less than high school, high school graduate or equivalent, some college, college graduate or above), and poverty income ratio (PIR)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "This study confirmed that the use of reported BMI led to underestimates of the population prevalence of overweight and obesity due to the general tendency towards over-reporting height and under-reporting weight. Women were more likely than men to under-report BMI. And whites were more likely than Blacks and Hispanics to under-report BMI. Other factors positively associated with higher likelihood of under-reporting of BMI included overweight and obese weight status, aged > or =60 years, and college education. Among women, family income was an additional positive covariate."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The results from this study underscore the need for frequently monitoring ethnic differences in validity of reported BMI and highlight the care which needs to be taken in making comparisons across sociodemographic groups based on reported BMI."
        }
      ]},
