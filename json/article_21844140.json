      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effect of pregnancy on ankylosing spondylitis (AS)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Our study aimed to determine the severity of back pain and stiffness pre-, during, and postpartum in patients with AS and controls, and corresponding extraarticular symptoms."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Nineteen female patients with AS (35 pregnancies) and 33 controls (77 pregnancies) were studied. Improvement in pain was reported in 51% of AS patients, predominantly in the first trimester, with significant improvement in pain than stiffness. In both groups, pain worsened in later stages, likely secondary to biomechanical loading. Postpartum pain scores in AS returned to prepartum levels in general."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Pregnancy does not substantially aggravate disease activity or severity in AS."
        }
      ]},
