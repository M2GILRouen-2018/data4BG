      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The incidence of obesity has increased significantly worldwide. Our hypothesis was that patients with obesity have a more severe distal radius fracture and we realized a study to evaluate this correlation between obesity and severity of distal radius fractures caused by low-energy injuries."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "A total of 114 patients with distal radius fracture were examined in a cross-sectional, observational study. Fractures were classified according to the international AO-Müller/Orthopedic Trauma Association (AO/OTA) classification in order to determine the severity. The patient's Body Mass Index (BMI) was calculated and a Pearson correlation was performed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The patients were predominantly female, and left side was more frequently affected. Most of the fractures were AO/OTA type A (71 patients). The majority of the involved patients in our study were overweighed or obese. We do not observe a direct correlation between grade of obesity and distal radius fracture severity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Based on the results of this study obesity and severity of distal radius fractures do not correlate."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "Prognostic. Level IV."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE SERIES"
          }
        ]
      },
