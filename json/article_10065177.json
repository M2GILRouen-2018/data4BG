      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the efficacy and safety of hepaccine B."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Vaccination on first-come-first-served basis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Kenya Medical Research Institute (KEMRI) staff and families at Nairobi, Kenya."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "A total of 107 vaccinees aged 0-10 years and 10 years and above."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MAIN OUTCOME",
          "content": "Antibody to hepatitis B surface antigen (anti HBs) checked one month after the third dose of the vaccine."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Ninety seven per cent of the vaccinees developed antiHBs. Side effects were few in the form of soreness at site of injection and headache."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Hepaccine B produced good immune response in vaccinees with minimal side effects."
        }
      ]},
