      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate each item in a patient questionnaire for the purpose of investigating whether the validity of each item is acceptable."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "The questionnaire was completed by the patients at an ordinary follow-up visit for their asthma, and within 1 week a nurse interviewed them by telephone with the aim of analysing the validity of each item through the use of predetermined criteria."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTINGS",
          "content": "Patients with asthma in primary health care settings in Sweden."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY PARTICIPANTS",
          "content": "Fifty-one patients were consecutively included from three different primary health care units."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Nine of 13 items had an acceptable validity. The four items that were not found to have acceptable validity were developed further."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Evaluating each item in a questionnaire by means of interviews with the specific patient population is a useful method of assuring that the intention of the patient questionnaire has been met."
        }
      ]},
