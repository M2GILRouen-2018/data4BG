      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To determine laxative utilization over time among chronic noncancer pain patients with opioid-induced constipation (OIC)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A prospective longitudinal study conducted in the USA, Canada, Germany and UK."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Patients on daily opioid therapy for treatment of chronic noncancer pain with OIC were recruited from clinics to complete a survey at Baseline and weeks 2, 4, 6, 8, 12, 16, 20 and 24."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "489 patients completed baseline with 452 completing one or more follow-up visits. 128 (28%) were nonlaxative users, 112 (25%) were insufficient laxative users and 212 (47%) were sufficient laxative users. The consistent sufficient laxative users reported the most bowel movements per week."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The majority of OIC patients do not take or only intermittently take laxatives."
        }
      ]},
