      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To evaluate the changes in quality of life following conventional abdominal aortic aneurysm repair."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Fifty-nine consecutive patients (50 men; nine women) in two surgical centres were investigated preoperatively, and at 6 weeks, 3 months and 6 months postoperatively. Quality of life was measured using the Short Form 36 (SF 36) questionnaire and the York Quality of Life questionnaire, from which the Rosser index was calculated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Rosser index assessment showed restoration of quality of life to preoperative levels by 3 months, and significant improvement at 6 months. Changes in the SF 36 revealed significant improvement in mental health, and physical role limitation at all times postoperatively. Social function worsened at 6 weeks but improved to preoperative levels by 3 and 6 months after surgery."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Quality of life was improved after open aortic aneurysm repair. The time course of recovery shows a predominant improvement between 6 weeks and 3 months postoperatively."
        }
      ]},
