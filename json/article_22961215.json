      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Painful procedures for premature infants in neonatal intensive care units remain inevitable. The goal of this study is to evaluate the effect of an eutectic mixture of local anesthetic (EMLA) cream for minimizing pain in premature infants during venipuncture in neonatal intensive care units."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This study enrolled 32 premature infants. A repeated-measures design was used. The scores of the 'Neonatal Pain, Agitation and Sedation Scale' (N-PASS) of each enrolled preterm infant were measured before, during and 10\u2009min after venipuncture without and with EMLA cream use. Paired t-tests were used to compare the difference of N-PASS scores without and with EMLA cream use."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Paired t-tests revealed a significant decrease in N-PASS scores during venipuncture in infants with EMLA cream. There was no significant change of N-PASS scores before, during and 10\u2009min after venipuncture with EMLA cream by analysis of repeated analysis of variance."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "EMLA cream for minimizing pain during venipuncture could be recommended for premature infants."
        }
      ]},
