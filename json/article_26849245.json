      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Several anatomical factors, such as prognathism, sex, short thyromental distance and others are known to make direct laryngoscopy difficult."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We investigated the hypothesis that the anatomical position of the vocal cords in relation to the cervical vertebrae correlates with difficult laryngoscopy. Existing MRI was used to identify the position of the vocal cords relative to the cervical spine in patients with and without difficult laryngoscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Observational study with adaptive enrichment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "A total of 142 adult patients, 91 with easy (Cormack-Lehane class 1 or 2) and 51 with difficult (Cormack-Lehane class 3 or 4) laryngoscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Position of the vocal cords relative to cervical vertebrae in patients with easy vs. difficult laryngoscopy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In patients with difficult laryngoscopy, we found a higher incidence of cranial position of the vocal cords in relation to the cervical spine compared with patients with easy laryngoscopy (P\u200a<\u200a0.001)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Anaesthesiologists should take advantage of existing imaging of the cervical spine when assessing the patient's airway."
        }
      ]},
