      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Peripheral neuropathies sometimes complicate bariatric surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "We report the detailed clinical, electrophysiological, biological and histological characteristics of five patients who developed peripheral neuropathy after bariatric surgery."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Three patients presented with small fiber neuropathy, one presented with axonal polyneuropathy, and one with demyelinating polyradiculoneuropathy. All patients had in common prominent neuropathic pain, massive weight loss, and multiple nutritional deficiencies. The pathophysiology of postbariatric surgery polyneuropathies is complex and involves nutritional, infectious and dysimmune mechanisms."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The spectrum of peripheral neuropathies complicating bariatric surgery is wide, and includes pure small fiber neuropathy, axonal polyneuropathy, and demyelinating polyradiculoneuropathy. Treatment is mainly preventive, but sometimes surgical revision is needed."
          }
        ]
      },
