      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate associations between home environmental factors and BMI of young American-Indian children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cross-sectional and prospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "School-based obesity prevention trial (Bright Start) on a Northern Plains Indian reservation in South Dakota. Mixed model multivariable analysis was used to examine associations between child BMI categories (normal, overweight and obese) and home food availability, children's dietary intake and physical activity. Analyses were adjusted for age, gender, socio-economic status, parent BMI and school; prospective analyses also adjusted for study condition and baseline predictor and outcome variables."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Kindergarten children (n = 424, 51 % male; mean age = 5.8 years, 30 % overweight/obese) and parents/caregivers (89 % female; 86 % overweight/obese) had their height and weight measured and parents/caregivers completed surveys on home environmental factors (baseline and 2 years later)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Higher fast-food intake and parent-perceived barriers to physical activity were marginally associated with higher probabilities of a child being overweight and obese. Vegetable availability was marginally associated with lower probabilities of being overweight and obese. The associations between home environmental factors and child weight status at follow-up were not significant."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Findings indicate that selected aspects of the home environment are associated with weight status of American-Indian children. Obesity interventions with this population should consider helping parents to engage and model healthful behaviours and to increase availability of healthful foods at home."
        }
      ]},
