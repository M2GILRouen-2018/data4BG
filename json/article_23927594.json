      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "A novel product Cynatine® FLX was evaluated on symptoms associated with knee osteoarthritis in a randomized, double-blind, placebo-controlled clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A total of 50 males and females were included and randomized into two groups. The active group (n = 25) received two capsules totaling 500 mg of Cynatine® FLX per day and the placebo group (n = 25) received an identical two capsules of maltodextrin per day for 60 days. The WOMAC® Osteoarthritis Index, SF-36, and Lequesne Index of Severity were used to evaluate the symptoms."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The results show that Cynatine® FLX was twice as effective in reducing pain scores as compared to placebo. Cynatine® FLX showed the same effectiveness in reducing stiffness."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This new product may be effective in relieving symptoms of knee osteoarthritis."
        }
      ]},
