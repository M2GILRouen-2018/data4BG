      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To examine the influence of a formal organizational pain management policy on nurses' pain management practices."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Descriptive correlational."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary-care medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "91 nurses providing direct patient care on five study units during a 72-hour study period."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Off-going nurses completed three self-administered questionnaires one-half hour before the end of each eight-hour work shift. Opioid administration data also were collected. Data were analyzed using correlational, t test, chi-square, and analysis of variance analyses and descriptive statistics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Nurses' knowledge of the healthcare organization's chronic pain management policy; nurses' knowledge of pain and pain management; nurses' perceived accountability for pain management activities; the ratio of actual amounts of opioid analgesics administered compared with maximum amounts ordered."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Nurses' knowledge of pain management and their perceived accountability for pain management were significantly related to knowledge of the organization's chronic pain management policy. Correlations were lower than expected, based on theoretical relationships proposed in the open system study framework."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Further research is needed to explore the influence of a high-quality pain management policy on nursing practice and clinical pain management."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Better understanding of the influence of organizational policy could lead to much needed improvements in pain management."
        }
      ]},
