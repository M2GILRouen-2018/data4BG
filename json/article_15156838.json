      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To explore the caregiving role of nonprofessional caregivers of patients with chronic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Descriptive study of 30 caregivers."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Twenty-eight (93%) caregivers demonstrated 1 to 6 defining characteristics of caregiver role strain, and 2 (7%) had at least two factors of risk for caregiver role strain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Caring for patients with chronic pain has a meaningful impact on caregivers' lives."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "PRACTICE IMPLICATIONS",
          "content": "Caregivers of patients with chronic pain deserve care, not only with the objective of optimizing relief for the patients, but also to help them seek and attain optimal functionality."
        }
      ]},
