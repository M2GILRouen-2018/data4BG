      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To determine the efficacy of transdermal scopolamine in addition to ondansetron in decreasing the incidence of postoperative nausea and vomiting (PONV)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Academic hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "126 ASA physical status I and II patients undergoing outpatient plastic surgery with three or more risk factors for PONV."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients were randomly assigned to one of two groups to receive (Group 1) a transdermal scopolamine (TDS) patch or (Group 2), a placebo patch two hours before surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Occurrence of vomiting, severity of nausea using a visual analog scale (VAS), rescue medication, pain intensity and pain medications, and side effects were recorded every hour until discharge from hospital, then every 4 hours thereafter for a total of 24 hours."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MAIN RESULTS",
          "content": "A statistically significant reduction in postoperative nausea between 8 and 24 hours in patients receiving TDS was noted."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Transdermal scopolamine in addition to ondansetron benefits patients at high risk for PONV undergoing outpatient plastic surgery for up to 20 hours after surgery."
        }
      ]},
