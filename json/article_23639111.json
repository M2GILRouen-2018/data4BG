      "Abstract": {
        "CopyrightInformation": "© 2013 The Authors BJOG An International Journal of Obstetrics and Gynaecology © 2013 RCOG.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the risk for obstetric anal sphincter lacerations in relation to maternal obesity among primiparous women in Sweden."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A population-based study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Sweden."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "POPULATION",
            "content": "All women with vaginal delivery and singleton pregnancy in Sweden in the years 2003-2008 (n = 210,678)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The Medical Birth Registry, the National Board of Health and Welfare, was used to identify cases of rupture and body mass index (BMI) classes. The population was categorised into four classes with BMI of <25, 25 to <30, 30 to <35 and >35 kg/m²."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Odds ratios were estimated with 95% confidence intervals. In order to estimate the effect of BMI on obstetric anal sphincter lacerations, with possible confounders accounted for, uni- and multivariate logistic regressions were performed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In total, 8958 (4.25%) cases of anal sphincter lacerations (grade III-IV) occurred; increasing BMI showed a significant near-dose-response type of protective effect against grade III-IV lacerations when compared with women with BMI <25 kg/m²: BMI 25 to <30 kg/m², 0.89; BMI 30 to <35 kg/m², 0.84; BMI > 35 kg/m², 0.70."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Overweight and obesity were associated with a decreased risk for obstetric anal sphincter lacerations."
          }
        ]
      },
