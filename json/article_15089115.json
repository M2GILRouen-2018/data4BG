      "Abstract": {
        "CopyrightInformation": "© 2015, Copyright the Authors Journal compilation © 2015, The American Geriatrics Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To examine the association between sleep complaints, use of sleep-promoting medications, and persistent severe fatigue (PSF)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Analysis of data from the National Health Aging Trends Study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Contiguous United States."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "A representative sample of Medicare beneficiaries aged 65 and older."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Difficulty initiating sleep, difficulty staying asleep, use of sleep-promoting medications, demographic characteristics, presence of pain, use of pain medications, depression, chronic medical disease, physical activity level, and Short Physical Performance Battery score measured at baseline. The outcome of interest was PSF (fatigue that limits daily activities reported at baseline and 12-month follow-up)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 8,245 participants at baseline, 7,075 completed 12-month follow-up; 31% reported severe fatigue at baseline and 31% at follow-up, and 19% reported PSF. In a logistic regression model, difficulty staying asleep some nights (odds ratio (OR) = 1.32, 95% confidence interval (CI) = 1.08-1.60) and most nights or every night (OR = 1.40, 95% CI = 1.09-1.79) and use of sleep-promoting medications most nights or every night (OR = 1.35, 95% CI = 1.08-1.67) independently predicted PSF."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The results indicate greater risk of PSF in older adults with difficulty staying asleep and those who use sleep-promoting medications. These findings underscore the significance of sleep problems and present potential targets for interventional studies that aim to improve fatigue in older adults."
          }
        ]
      },
