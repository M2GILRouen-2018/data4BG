      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To analyse the influence of chronic pain on muscle strength."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Muscle strength of patients with unilateral nonspecific chronic pain, in an upper or lower limb, were measured according to a standardized protocol using a hand-held dynamometer. Before and after muscle strength measurement, a visual analogue scale for pain intensity was assessed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Forty patients were measured and the muscle strength of the painful side was 20-30% less than that of the nonpainful side. Strength reduction was seen in the whole limb. A significant correlation between pain intensity and reduced muscle strength in the painful limb existed for hip flexion, knee flexion, knee extension and three-point grip."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A strength reduction of 20-30% in a painful limb seems to be 'normal' in chronic pain patients."
        }
      ]},
