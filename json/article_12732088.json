      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study evaluates whether patients with coronary artery disease and severely depressed left ventricular ejection fraction (LVEF) benefit from complete revascularization by multivessel coronary artery bypass."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "From April 1994 to May 2002, 42 patients who underwent coronary artery bypass grafting (CABG) at our institution had impaired left ventricular (LV) function [an ejection fraction (EF) of 30% or less]. The average preoperative LVEF was 23.8%. The mean number of grafts was 4.6. Complete revascularization by multivessel bypass grafting was the goal for all patients."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Thirty days mortality was 0 and hospital mortality was 2.4%. The mean graft patency rate for 35 (83%) patients at one month was 98.8%. The mean postoperative LVEF improved significantly, from 23.8% to 35.2% (p<0.05), and the New York Heart Association (NYHA) classification was improved in most patients. The Kaplan-Meier estimate of survival at 5 years was 83.1%, and that of the cardiac event-free rate at 5 years was 77.5%."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "For patients with poor LV function, complete surgical revascularization by multivessel bypass grafting can be performed safely, with satisfactory hospital mortality and long-term results."
        }
      ]},
