      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 The Authors. Published by Elsevier Ireland Ltd.. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We aimed to explore how patients with long-term conditions choose between available healthcare options during a health crisis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Patients in North-West England with one or more of four long-term conditions were invited to take part in a questionnaire cohort study of healthcare use. Semi-structured interviews were conducted with a sub-sample of fifty consenting patients. Data were analysed qualitatively, using a framework approach."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patients described using emergency care only in response to perceived urgent need. Their judgements about urgency of need, and their choices about what services to use were guided by previous experiences of care, particularly how accessible services were and the perceived expertise of practitioners."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Recursivity and candidacy provide a framework for understanding patient decision-making around emergency care use. Patients were knowledgeable and discriminating users of services, drawing on experiential knowledge of healthcare to choose between services. Their sense of 'candidacy' for specific emergency care services, was recursively shaped by previous experiences."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Strategies that emphasise the need to educate patients about healthcare services use alone are unlikely to change care-seeking behaviour. Practitioners need to modify care experiences that recursively shape patients' judgements of candidacy and their perceptions of accessible expertise in alternative services."
          }
        ]
      },
