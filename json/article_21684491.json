      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Australian Physiotherapy Association. Published by .. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "QUESTION",
            "content": "Can real-time visual feedback facilitate the activity of serratus anterior in individuals with scapular winging during shoulder flexion?"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Comparative, repeated-measures experimental study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Nineteen subjects with scapular winging."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Participants performed isometric shoulder flexion at 60° and 90° with and without real-time visual feedback using a video camera to monitor scapular winging."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "Activity in the upper trapezius, lower trapezius, and serratus anterior muscles was measured using surface electromyography. A video motion analysis system measured the displacement of a marker attached to the acromion in the frontal and sagittal planes."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Visual feedback significantly increased activity in the upper trapezius at 60° of shoulder flexion by 2.3% of maximum voluntary isometric contraction (95% CI 0.7 to 4.0). Visual feedback also significantly increased activity in the serratus anterior at 60° and 90° of shoulder flexion, by 3.0% (95% CI 2.3 to 3.6) and 5.9% (95% CI 3.3 to 8.5) of maximum voluntary isometric contraction respectively. These effects equated to effect sizes from 0.29 to 0.46. Visual feedback also significantly improved movement of the acromion superiorly at 60° of shoulder flexion and anteriorly at 60° and 90° of shoulder flexion."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Real-time visual feedback can be used to activate the upper trapezius and serratus anterior muscles and to improve movement of the scapula during shoulder flexion in people with scapular winging."
          }
        ]
      },
