      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To investigate if neurodynamic treatment is more effective than advice to remain active in patients with nerve-related leg pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Parallel-group randomized controlled trial blinded to the outcome assessor conducted in Porto Alegre, Brazil."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Sixty patients recruited from the community and private practices."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Patients will be randomly assigned to receive four sessions of neurodynamic treatment over two weeks comprising passive lumbar foramen opening and neurodynamic sliders plus home exercises or advice to remain active."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Leg pain intensity, disability, low back pain intensity, functional ability, symptoms distribution and global impression of recovery will be assessed at two and four weeks after randomization."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "A linear mixed model will be employed for each outcome following intention to treat principles."
          }
        ]
      },
