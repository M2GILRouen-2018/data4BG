      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 American Society for Gastrointestinal Endoscopy. Published by Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "GI neuromuscular diseases (GINMD) can cause severe dysmotility and symptoms. Full-thickness biopsy specimens may help diagnose these disorders histologically."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess a novel percutaneous endoscopically assisted transenteric (PEATE) biopsy method for obtaining full-thickness gastric tissue in patients with suspected GINMD."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective proof-of-concept case series."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Tertiary care gastroenterology unit."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Ten patients (8 women, mean [standard deviation] age 43 [10] years) with gastroparesis-like symptoms (mean [standard deviation] gastroparesis cardinal symptom index 3.28 [1.46] out of 5) and/or clinical findings suggestive of a gastric GINMD."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "All patients underwent PEATE biopsy during standard gastroscopy as an outpatient procedure. Tissue was stained for histology and immunohistochemistry of gut wall elements. Interstitial cells of Cajal (ICC) counts were compared with archived normal gastric tissue from control gastrectomies."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASUREMENTS",
            "content": "Biopsy success, complications, histopathological findings according to the London Classification of GINMD."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Full-thickness antral tissue suitable for analysis was obtained in 9 in 10 patients (90%). PEATE biopsy was well tolerated by all patients without complications. Histology suggested GINMD in 4 of 9 cases (44%), with possible degenerative leiomyopathy in 2, probable inflammatory leiomyopathy in 1, and abnormal ICC networks (>50% reduction in ICC counts) in 1 patient."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "PEATE biopsy specimen size is smaller than a standard laparoscopic full-thickness biopsy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "PEATE full-thickness gastric biopsy is a simple and safe method of assessing histopathological abnormalities in gastric GINMD without the need for laparoscopy or general anesthesia."
          }
        ]
      },
