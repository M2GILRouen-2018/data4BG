      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To illustrate the potential value of pharmacogenetic testing to identify patients at risk for nonsteroidal anti-inflammatory drug-induced gastropathy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Case report."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "We report a case encountered in an outpatient setting for pain management."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT",
            "content": "We present a case of a patient treated with celecoxib who developed severe nonsteroidal anti-inflammatory drug-induced gastropathy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Suspecting a relation between this adverse event and altered drug metabolism, pharmacogenetic testing was performed to assess the role of the cytochrome P450 (CP450) enzyme profile."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pharmacogenetic testing revealed a relation between this adverse event and an allelic variant of cytochrome P450, CYP2C9, subsequently leading to discontinuation of the drug along with counseling to caution the patient to avoid the use of celecoxib and other drugs metabolized by the same enzyme."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Although pharmacogenetic testing is not routinely used in clinical decision making, pain physicians must be aware of the potential benefits of this testing for managing patients with pain, and to improve drug efficacy and safety profile."
          }
        ]
      },
