      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Concern regarding the risk of sudden unexpected cardiac death has fueled interest in athletes who experience chest pain, syncope, or palpitations during training and competition. This review examines the etiology and evaluation of these symptoms in young athletes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES/SYNTHESIS",
          "content": "Previously published reports that have provided a base of expert opinion were examined to define the optimal means of assessment before returning athletes to play."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A well-defined differential diagnosis must be considered to rule out heart disease and define noncardiac causes of these symptoms."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Athletes who experience symptoms such as chest pain, syncope, and palpitations during competition and training can be safely returned to play only after the evaluation is completed."
        }
      ]},
