      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine the one-week period prevalence of depressive symptomatology among Saskatchewan adults and to identify sociodemographic and health factors associated with depressive symptomatology."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The Saskatchewan Health and Back Pain Survey was mailed to an age-stratified random sample of adults. Of the 2,184 eligible subjects, 55% (n = 1131) responded to the survey. We report age-standardized prevalence estimates stratified by age, gender and spinal pain severity. Logistic regression was used to measure the presence and strength of association between various factors and depressive symptomatology."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "22.2% (95% CI 19.6-24.9) of adults experienced depressive symptomatology during the previous week, with higher rates in younger adults, in females, and in those with disabling spinal pain. Depressive symptomatology was associated with age, income, smoking, health status, gastro-intestinal problems, headaches and spinal pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Depressive symptomatology is common in the Saskatchewan adult population, and is related to age, pain severity and general health."
        }
      ]},
