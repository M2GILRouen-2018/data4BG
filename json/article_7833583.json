      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To demonstrate the possibilities of the use of oral ketamine in the treatment of postherpetic neuralgia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A pain clinic in a university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT",
          "content": "A patient with postherpetic neuralgia of the ophthalmic nerve."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Subcutaneous and later oral ketamine after classical treatment had failed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A complete recovery was accomplished without any sign of side effects."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Oral ketamine may provide an alternative in the treatment of postherpetic neuralgia. The possible mechanism of action by its N-methyl-D-aspartate (NMDA) blocking properties is discussed."
        }
      ]},
