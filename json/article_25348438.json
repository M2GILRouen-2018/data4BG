      "Abstract": {
        "CopyrightInformation": "© 2014 The Authors. BJOG An International Journal of Obstetrics and Gynaecology published by John Wiley & Sons Ltd on behalf of Royal College of Obstetricians and Gynaecologists.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To identify if gestational diabetes mellitus (GDM) is a clinically useful marker of future cardiovascular disease (CVD) risk and if GDM combined with other risks (smoking, hypertension or body mass) identifies high-risk groups."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Population-based matched case-control study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "National Swedish register data from 1991 to 2008."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "POPULATION",
            "content": "A total of 2639 women with a cardiovascular event and matched controls."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Conditional logistic regression examined associations with CVD before and after adjustment for conventional risk factors and confounders. Effect modification for the association of GDM with CVD by body mass index (BMI), smoking and chronic hypertension was assessed by stratification and interaction testing. Adjustment for diabetes post-pregnancy evaluated its mediating role."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Inpatient diagnoses or causes of death identifying ischemic heart disease, ischemic stroke, atherosclerosis or peripheral vascular disease."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The adjusted odds ratios (and 95% confidence intervals) for the association of CVD with GDM are 1.51 (1.07-2.14), 2.23 (2.01-2.48) for smoking, 1.98 (1.71-2.29) for obesity and 5.10 (3.18-8.18) for chronic hypertension. In stratified analysis the association of CVD with GDM was only seen among women with BMI ≥25, with an odds ratio of 2.39 (1.39-4.10), but only women with a BMI <30 accounted for this increased risk. Adjustment for post-pregnancy diabetes attenuated it somewhat to 1.99 (1.13-3.52)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In the absence of other recognised cardiovascular risk factors, such as smoking, obesity or chronic hypertension, GDM is a useful marker of raised CVD risk among women with BMI between 25 and 29."
          }
        ]
      },
