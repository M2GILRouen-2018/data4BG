      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND/OBJECTIVE",
          "content": "The aim of this study was to identify factors related to muscle tension in patients with major depressive disorder (MDD) with comorbid anxiety and migraine."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Consecutive psychiatric outpatients with MDD were enrolled. Self-reported muscle tension (SMT) during the previous week was evaluated with a 0-10 scale."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of 135 participants with MDD, 63 (46.7%) had migraine. Multiple-regression analyses showed that migraine and headache intensity were two major independent factors related to SMT."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Further studies on musculoskeletal symptoms in MDD should not neglect the impact of migraine."
        }
      ]},
