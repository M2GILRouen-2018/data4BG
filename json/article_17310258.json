      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To report a novel management strategy for neuropathic pain management after spinal cord injury."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient spinal cord injury (SCI) clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The patient demonstrated two neuropathic pain syndromes, namely at- and below-level pain. These syndromes were recalcitrant to conservative measures and a decision was made to proceed with intrathecal therapies."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The patient's at-level pain was responsive to intrathecal hydromorphone but the below-level pain was unaffected by this intervention. Intrathecal ziconotide provided an opposite response with a positive effect observed on the below-level pain and minimal effect on the at-level pain. The combination of intrathecal ziconotide and hydromorphone provided effective relief for both components of the patient's SCI associated neuropathic pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The combination of intrathecal ziconotide and hydromorphone has the potential to provide significant pain relief for patients with neuropathic pain associated with spinal cord injury."
        }
      ]},
