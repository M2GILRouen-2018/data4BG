      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "A follow-up study of musculoskeletal symptoms after Pogosta virus infection."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Twenty-six patients with earlier serologically confirmed Pogosta disease were examined. Ultrasonography of affected joints was performed in patients who had chronic musculoskeletal symptoms. Serum antibodies against Sindbis virus were determined. The patients were typed for HLA-DR and B27. Efforts were made using the polymerase chain reaction to demonstrate the virus."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Only 50% of the patients were symptomless 2.5 yr after onset of Pogosta disease. Three patients had fibromyalgia, six had occasional arthralgia and two had chronic arthritis."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The epidemiology of Pogosta disease is changing and practitioners should be better aware of it. Pogosta virus infection may lead to chronic musculoskeletal discomfort and arthritis."
        }
      ]},
