      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2014.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the effects of the CORE programme on pain at rest, movement-induced pain, secondary pain, active range of motion, and proprioception deficits in female office workers with chronic low back pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Rehabilitation clinics."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "A total of 53 participants with chronic low back pain were randomized into the CORE group and the control group."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "CORE group participants underwent the 30-minute CORE programme, five times per week, for eight weeks, with additional use of hot-packs and transcutaneous electrical nerve stimulation, while the control group used only hot-packs and transcutaneous electrical nerve stimulation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN MEASURES",
            "content": "Participants were evaluated pretest, posttest, and two months after the intervention period to measure resting and movement-induced pain, pressure pain as secondary pain, active range of pain-free motion, and trunk proprioception."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pain intensity at rest (35.6 ±5.9\u2009mm) and during movement (39.4 ±9.1\u2009mm) was significantly decreased in the CORE group following intervention compared with the control group. There were significant improvements in pressure pain thresholds (quadratus lumborum: 2.2 ±0.7\u2009kg/cm(2); sacroiliac joint: 2.0 ±0.7\u2009kg/cm(2)), active range of motion (flexion: 30.8 ±14.3°; extension: 6.6 ±2.5°), and proprioception (20° flexion: 4.3 ±2.4°; 10° extension: 3.1 ±2.0°) in the CORE group following intervention (all p < 0.05). These improvements were maintained at the two-month follow-up. The control group did not show significant improvements in any measured parameter."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The CORE programme is an effective intervention for reducing pain at rest and movement-induced pain, and for improving the active range of motion and trunk proprioception in female office workers with chronic low back pain."
          }
        ]
      },
