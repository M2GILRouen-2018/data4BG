      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "In this retrospective study, we evaluated the efficacy of the reverse less invasive plating system (LISS) in the management of subtrochanteric fractures (STF) in elderly patients that are expected to be difficult to nail."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS AND METHODS",
            "content": "Fifty-five patients with STF were treated from April 2005 to December 2007. Of these, 26 (16 females and 10 males, age >65 years, average 79.8 ± 3) had nonpathologic fractures that were internally fixed with a LISS device. The average follow-up period was 24 months (range 15-30). The main outcome measures evaluated were pain, union, varus deformity and implant failure. Radiographic and clinical evidence of functional outcome and complications were also evaluated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Mean perioperative blood loss was 120.5 ± 12 ml (range 65-285), and mean postoperative hospital stay was 7.8 ± 2 days (range 4-14). Using the reverse LISS plates led to complete union of STF in all of the 26 elderly patients without additional procedures."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Due to advantages like high union rate, early postoperative mobilization and short operation time, the reverse LISS device offers an alternative management of STF in elderly patients unsuitable for nailing procedures."
          }
        ]
      },
