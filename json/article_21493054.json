      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Potential benefit of physical activity in asthma incidence is scarce and controversial. We aimed to assess the association between regular physical activity and adult-onset asthma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We included 51,080 women from a French cohort study, and followed them from 1993 to 2003. Physical activity at baseline was defined as time spent in household and leisure time physical activity, converted to metabolic equivalents (METs), and categorised in tertiles. Adult-onset asthma during follow-up was defined according to the American Thoracic Society criteria."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Mean age at baseline was 53 years, 13% of women were current smokers, 19% were overweight or obese, and 56% were postmenopausal; 512 (1%) developed asthma. No association was found between physical activity and asthma incidence in the crude or in the adjusted Cox regression model (adjusted HR 1.03 and 1.01 for the 2nd and 3rd tertiles compared to the 1st tertile, p for trend = 0.979)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Physical activity is not related to adult-onset asthma in this cohort of French middle-aged women."
          }
        ]
      },
