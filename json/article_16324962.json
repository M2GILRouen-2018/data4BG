      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The objective was to determine whether a pediatric asthma disease management program (ADMP) provided by respiratory therapists can improve patient outcomes and reduce cost."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "This was a pre-and post-intervention observational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Hospitalizations, non-intensive care unit (ICU) hospital days, ICU days, emergency department visits, doctor's office visits, school days missed, and associated costs were collected on 18 children with moderate to severe asthma, ages 3 to 18 years, 12 months before and after implementation of the ADMP. The ADMP consisted of eight home visits for assessment, environmental review, and patient education."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were significant reductions (P < .05) in hospitalizations, hospitalization cost, ICU days, non-ICU days, length of stay, emergency department visits and cost, physician office visits and cost, and school days missed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A pediatric in-home ADMP provided by respiratory therapists can improve outcomes and reduce cost in patients with moderate to severe asthma."
        }
      ]},
