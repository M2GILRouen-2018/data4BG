      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A lower maintenance dose of clopidogrel may be appropriate in Japanese patients because the maintenance dose of ticlopidine is lower in Japan than that used in the United States."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "METHODS AND RESULTS",
          "content": "A total of 126 patients with 153 lesions who consented to take 50-mg clopidogrel to prevent stent thrombosis were enrolled. There was 1 case of early stent thrombosis (0.65%). Side-effects of clopidogrel occurred in 5 patients (4.0%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This preliminary study shows that 50 mg clopidogrel may be acceptable in Japanese patients."
        }
      ]},
