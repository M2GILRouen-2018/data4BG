      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND/AIMS",
            "content": "Patients with hypothalamic tumors frequently experience severe obesity, and its treatment with diet, exercise, and/or pharmacologic treatment has had limited effect. Glucagon-like peptide-1 agonist exenatide (exendin-4), used for treatment of type 2 diabetes, causes persistent weight loss via signaling in the brainstem."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We report the case of a 17-year-old patient with obesity resulting from a hypothalamic germ cell tumor. He was treated by chemoradiotherapy and exenatide at a dose of 5 µg subcutaneously twice daily."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Exenatide resulted in a 29-kg weight loss (BMI reduction from 37.1 to 29.1) after 2.5 years of treatment; significant weight gain occurred shortly after exenatide was discontinued."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Exenatide resulted in considerable reduction of body weight in a patient with severe hypothalamic obesity. This novel observation requires follow-up clinical studies for establishing the effects of exenatide in patients with disrupted hypothalamic energy regulatory pathways."
          }
        ]
      },
