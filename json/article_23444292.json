      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS/HYPOTHESIS",
          "content": "Hygiene hypothesis has been shown valid in respect of allergies and asthma but has not been, however, sufficiently studied in relation to type 1 diabetes mellitus. This study investigates the effect of childhood farm environment on the prevalence of type 1 diabetes mellitus in Finnish children and young adults."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Data come from a questionnaire study carried out in 2007 (N = 5805). Prevalence of type 1 diabetes mellitus was analysed according to the type of the rural exposure below the age of 18 years. Associations were estimated and tested using Bayesian methods."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Consistent suggestive evidence of the inverse association of childhood's farm environment with the occurrence of type 1 diabetes mellitus was shown, even though conclusive results were not reached."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION/INTERPRETATION",
          "content": "Exposure to a broad variety of non-pathogenic environmental microorganisms during childhood might have a protective effect on type 1 diabetes mellitus. Results clearly suggest that further research is well grounded with larger samples."
        }
      ]},
