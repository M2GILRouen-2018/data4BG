      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report the case of a patient submitted to laparoscopic bowel resection in whom histology revealed endometriosis and schistosomiasis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Multidisciplinary group practice and teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 31-year-old patient with pelvic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Laparoscopic bowel resection."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Laparoscopic treatment of endometriosis affecting the sigmoid."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Histology performed on tissue removed at surgery revealed epithelioid granulomas with birefringent and partially calcified eggs characteristic of Schistosoma mansoni within an endometriotic lesion affecting the entire width of the sigmoid."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Endometriosis and schistosomiasis may be present simultaneously in patients with bowel symptoms and pelvic pain."
        }
      ]},
