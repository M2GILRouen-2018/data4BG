      "Abstract": {
        "CopyrightInformation": "© 2012 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "Patient perception measures are gaining increasing interest among scholars and practitioners. The aim of this study was to empirically examine a conceptual model of patient-centred care using patient perception survey data."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Patient-centred care is one of the Institute of Medicine's objectives for improving health care in the 21st century. Patient interviews conducted by the Picker Institute/Commonwealth Fund in the 1980s resulted in a theoretical model and survey questions with dimensions and attributes patients defined as patient-centered."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "The present study used survey data from patients with overnight visits at 142 U.S. hospitals."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Regression analysis found significant support for the theoretical model. Perceptions of emotional support had the strongest relationship with overall care ratings. Coordination of care, and physical comfort were strongly related as well."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Understanding how patients experience their care can help improve understanding of what patients believe is patient-centred, and of how care processes relate to important patient outcomes."
          }
        ]
      },
