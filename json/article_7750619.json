      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the efficacy of laser laparoscopic surgery in the treatment of pain associated with minimal, mild, and moderate endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective, randomized, double-blind, and controlled clinical study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Royal Surrey County Hospital, Guildford, United Kingdom, a referral center for the laser laparoscopic treatment of endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Sixty-three patients with pain (dysmenorrhoea, pelvic pain, or dyspareunia) and minimal to moderate endometriosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "The patients were randomized at the time of laparoscopy to laser ablation of endometriotic deposits and laparoscopic uterine nerve ablation or expectant management. Pain symptoms were recorded subjectively and by visual analogue scale. The women were unaware of the treatment allocated as was the nurse who assessed them at 3 and 6 months after surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Improvement or resolution of pain symptoms assessed subjectively and by visual analogue score."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Laser laparoscopy results in statistically significant pain relief compared with expectant management at 6 months after surgery. Sixty-two and a half percent of the lasered patients reported improvement or resolution of symptoms compared with 22.6% in the expectant group. Results were poorest for minimal disease and, if patients with mild and moderate disease only are included, 73.7% of patients achieved pain relief. There were no operative or laser complications."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Laser laparoscopy is a safe, simple, and effective treatment in alleviating pain symptoms in women with stages I, II, and III endometriosis."
        }
      ]},
