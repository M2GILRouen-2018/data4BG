      "Abstract": {
        "CopyrightInformation": "© 2015 International Society for Sexual Medicine.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Therapist-aided exposure seems an effective treatment for lifelong vaginismus, but mechanisms of action have not yet been established."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "The purpose of the present study was to investigate whether treatment outcome of a therapist-aided exposure treatment was mediated by changes in positive and negative penetration beliefs or feelings of sexual disgust."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Participants with lifelong vaginismus were allocated at random to a 3-month exposure (n\u2009=\u200935) or a waiting list control condition (n\u2009=\u200935)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE",
            "content": "Full intercourse was assessed daily during 12 weeks. Secondary outcome measures (complaints about vaginismus and coital pain) were assessed at baseline and after 12 weeks. Possible mediators: penetration beliefs (catastrophic pain beliefs, genital incompatibility beliefs, perceived control beliefs) and feelings of sexual disgust were assessed at baseline and 6 weeks."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Treatment outcome (coital frequency, symptoms of vaginismus, and coital pain) at 12 weeks was mediated by changes in negative and positive penetration beliefs at 6 weeks, in particular by more pronounced reduction of catastrophic pain penetration beliefs. No evidence was found that changes in feelings of sexual disgust mediated treatment outcome."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The results strongly suggest that therapist-aided exposure affects negative penetration beliefs and that these changes in negative penetration beliefs mediate treatment outcome in women with lifelong vaginismus. Implications for treatment are discussed."
          }
        ]
      },
