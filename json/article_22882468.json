      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The objective of the study was to see if transforaminal injection of steroids might be an effective treatment for persistent radicular pain after disc surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "The study was designed as a retrospective practice audit covering a time period of 2 years."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "The study was set in a single spine center in which all patients underwent lumbar disc surgery, postoperative follow-up, and subsequent treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Patients with postsurgical radicular pain were treated with a transforaminal injection of a steroid. The effect was evaluated in terms of pain reduction, duration of pain relief, and in relation to a recurrent disc herniation in postperative magnetic resonance imaging."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 479 patients who underwent microsurgical lumbar disc surgery, 69 had persistent radicular pain. Transforaminal injection of steroid achieved pain reduction of at least 50% in 26.8% of these patients. The success rate was higher (43%) in patients without a recurrent disc herniation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Transforaminal injection of steroid appears to be effective in only a minority of patients with radicular pain persisting after disc surgery, but is more often effective in patients without recurrent disc herniation."
          }
        ]
      },
