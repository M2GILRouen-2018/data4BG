      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "HYPOTHESIS",
            "content": "A multi-modal treatment program (MMT) is more effective than exercise therapy (ET) for the treatment of long-standing adductor-related groin pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Single blinded, prospective, randomised controlled trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Athletes with pain at the proximal insertion of the adductor muscles on palpation and resisted adduction for at least two months."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "ET: a home-based ET and a structured return to running program with instruction on three occasions from a sports physical therapist. MMT: Heat, Van den Akker manual therapy followed by stretching and a return to running program."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PRIMARY OUTCOME",
            "content": "time to return to full sports participation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SECONDARY OUTCOME MEASURES",
            "content": "objective outcome score and the visual analogue pain score during sports activities. Outcome was assessed at 0, 6, 16 and 24 weeks."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Athletes who received MMT returned to sports quicker (12.8 weeks, SD 6.0) than athletes in the ET group (17.3 weeks, SD 4.4. p = 0.043). Only 50-55% of athletes in both groups made a full return to sports. There was no difference between the groups in objective outcome (p = 0.72) or VAS during sports (p = 0.12)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The multi-modal program resulted in a significantly quicker return to sports than ET plus return to running but neither treatment was very effective."
          }
        ]
      },
