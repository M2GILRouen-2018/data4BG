      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Dysmenorrhea, dyspareunia, and non-cyclic pelvic pain are health concerns for factory workers in China and may be increased by occupational stress."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To estimate the prevalence and demographic and occupational factors associated with three types of gynecologic pain among female factory workers in Tianjin."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The study included 651 female workers from three factories in Tianjin, China. Logistic regression models were estimated to determine associations between occupational stress and gynecologic pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Occupational stress including high job strain, exhaustion, and stress related to working conditions was a risk factor for gynecologic pain. High job strain and poor job security were associated with an increased risk for dysmenorrhea. Compulsory overtime and exhaustion were associated with increased non-cyclic pelvic pain. Working overtime and exhaustion were associated with increased dyspareunia."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "As China's population of female factory workers grows, research on the reproductive health of this population is essential."
        }
      ]},
