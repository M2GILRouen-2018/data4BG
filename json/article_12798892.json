      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effectiveness of transcutaneous electrical nerve stimulation (TENS) as a pain control method during office hysteroscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective, randomized study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Centre for Minimally Invasive Surgery, Department of Gynecological Science and Perinatology, \"La Sapienza\" University, Rome, Italy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "One hundred forty-two patients undergoing office hysteroscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Application of a TENS device on the patient's abdomen before and during office hysteroscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The level of pain experienced by the patients was assessed using a 10 cm visual analog scale; the side effects and changes in the hemodynamic parameters were evaluated."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "The patients treated with TENS during hysteroscopy (group A, n = 71) were compared with a control group (group B, n = 71) on whom the TENS device was not used. The women in the TENS group experienced a significantly lower level of pain during hysteroscopy. No differences in side effects were observed between both group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "TENS is a simple, efficient, and safe method of relieve pain during office hysteroscopy."
        }
      ]},
