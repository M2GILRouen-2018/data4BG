      "Abstract": {
        "CopyrightInformation": "© 2015, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "We apply Critical Theory to examine menu labeling with the aim of uncovering important implications for nursing practice, research, and policy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our critical analysis uncovers barriers to menu labeling's effectiveness, particularly for vulnerable populations. Nurses must work to minimize the impact of these barriers and optimize the effectiveness of menu labeling, in order to strengthen the fight against obesity."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "We suggest changes, guided by this critical analysis, which can be implemented by nurses working in clinical practice, research, and policy."
          }
        ]
      },
