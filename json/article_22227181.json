      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 National Kidney Foundation, Inc. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To analyze the reported energy intake (EI(rep)) in hemodialysis (HD) patients by total energy expenditure (TEE) measured by a dedicated device."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "RenalCor and RenalVida Clinics (Rio de Janeiro, Brazil)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND OTHERS PARTICIPANTS",
            "content": "Forty-eight HD patients (51.4 ± 12.2 years, 62% men, body mass index [BMI], 23.8 ± 4.5 kg/m(2)) were studied."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE",
            "content": "EI(rep) was evaluated using a 3-day food record. TEE was measured over a 2-day period by SWA (SenseWear Pro2 Armband, BodyMedia Inc., Pittsburgh, PA). Subjects were identified as underreporters (URs), acceptable reporters (ARs), or overreporters (ORs) from their EI(rep)/TEE ratio. ARs were defined as having the EI(rep)/TEE ratio in the range of 0.76 to 1.24, URs as EI(rep)/TEE <0.76, ORs as EI(rep)/TEE >1.24 according to Goldberg index."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The mean TEE and EI(rep) were 34.7 ± 9.4 kcal/kg/day and 22.8 ± 10.6 kcal/kg/day, respectively, and 37.5% of patients presented overweight or obesity. Thirty-one patients (65%) were identified as URs, and the mean of Goldberg index was 0.54 ± 0.12 (0.23 to 0.75), versus 0.95 ± 0.12 (0.79 to 1.2) for ARs. There were no ORs among the patients studied. There were negative correlations between Goldberg index and BMI (r = -0.35, P < .01) and % body fat (r = -0.4, P < .01) and between EI(rep) and BMI (r = -0.58, P < .001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These results confirm a high prevalence of underreporting of EI in HD patients, particularly in patients with high BMI."
          }
        ]
      },
