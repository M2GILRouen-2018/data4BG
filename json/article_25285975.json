      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of this article was to address common clinical questions pertaining to work-related asthma (WRA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "This review is based on a presentation on WRA at the American College of Chest Physicians Course on Clinical Aspects of Occupational and Environmental Lung Disease, held in Toronto in 2013, and supplemented by a PubMed search of publications to 2013."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Seven clinical questions are addressed in relation to definitions, causes, diagnosis, management and emerging triggers, and challenges of WRA."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Although knowledge is expanding in this area, there remain challenges and uncertainties, particularly in the prevention of WRA."
        }
      ]},
