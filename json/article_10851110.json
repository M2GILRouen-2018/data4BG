      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A case report of ureteral injury as a complication incurred during a laparoscopy-assisted lumbar fusion."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To alert orthopedic surgeons to this injury, which may occur during such surgery."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Laparoscopy-assisted lumbar fusion is a minimally invasive surgical technique to accomplish lumbar fusion with excellent patient satisfaction, reduced hospital stay, and decreased rehabilitative time."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "METHOD AND RESULTS",
          "content": "A case report is presented detailing ureteral injury as a complication of laparoscopy-assisted lumbar fusion and the subsequent treatment of the injury."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Laparoscopy-assisted lumbar fusion is a new, less invasive technique with excellent patient satisfaction; however, ureteral injury may occur, and the surgeon should keep this in mind if a postoperative fluid collection occurs in the pelvis."
        }
      ]},
