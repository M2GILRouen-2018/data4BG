      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess whether transcervical intrauterine topical instillation of a local anesthetic agent reduces pain at hysterosalpingography."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, randomized, double-blind, placebo-controlled study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Department of reproductive medicine at a university teaching hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "One hundred ten women undergoing hysterosalpingography (HSG)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Subjects were randomized to receive either 2 mL of 2% plain lignocaine or 2 mL of 0.9% sodium chloride solution (placebo) topically into the uterine cavity before the HSG was performed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "The degree of lower abdominal pain experienced both during the injection of contrast media at HSG and 10 minutes after the procedure using a 20-cm visual analogue scale (VAS) and a four-point verbal descriptor scale (VDS)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "There was no difference in pain scores between lignocaine and placebo during the HSG. However, at 10 minutes after the HSG, subjects receiving lignocaine experienced more pain than those on placebo."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Transcervical intrauterine topical instillation of 2 mL of 2% plain lignocaine does not reduce pain during HSG and may lead to increased pain immediately after the procedure."
        }
      ]},
