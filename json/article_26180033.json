      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 SEHLELHA. Published by Elsevier Espana. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Cardiovascular diseases are responsible for the largest burden of global mortality. The study of the degree of knowledge of their population risk factors and cardiovascular risk is a priority preventive strategy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "A cross-sectional study with 369 people was performed. The sociodemographic variables were cardiovascular risk and perception as well as physical and anthropometric factors. The risk was stratified with the SCORE table."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 49.6% were men and 50.4% were women. The proportion of diagnosis was 23.8% in HTA, 39% in hypercholesterolemia, 31.4% in smoking, 26.3% in obesity and 4.6% in diabetes. Concordance between perceived and real cardiovascular risk was very weak."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "The population has good knowledge about diabetes and acceptable knowledge about hypertension, and hypercholesterolemia but knowledge in prediabetic states and perception of the associated cardiovascular risk is low."
          }
        ]
      },
