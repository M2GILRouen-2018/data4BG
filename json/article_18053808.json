      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The role of SLC19A1 -43T>C, MTHFR 677C>T and MS 2756A>G polymorphisms on red cell and plasma folate levels."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND METHODS",
          "content": "Genotype analysis of the three polymorphisms. Red cell and plasma folate measurements in 64 patients with coronary artery disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The non-wild type allele of SLC19A1 polymorphism -43T>C was associated with low red cell folate levels and the non-wild type allele of MTHFR polymorphism 677C>T with low plasma folate levels."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "SLC19A1 and MTHFR genes are differently associated with red cell and plasma folate levels."
        }
      ]},
