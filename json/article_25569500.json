      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Dental Association. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND AND OVERVIEW",
            "content": "The World Health Organization has recommended a reduction in free sugars intake throughout one's life span to decrease the burden of noncommunicable diseases, including caries and obesity. The author defines sugars' nomenclature, describes sugars' roles in food, and identifies current sugars intake."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The oral health care practitioner can identify added sugars intake and provide guidance to patients to decrease their intake of added sugars while improving nutrient intake and reducing caries risk."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICAL IMPLICATIONS",
            "content": "Intake of added sugars increases the burden of chronic diseases in the United States. The oral health care practitioner is in a position to provide dietary guidance to patients to reduce both oral and systemic diseases."
          }
        ]
      },
