      "Abstract": {
        "CopyrightInformation": "Crown Copyright © 2011. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The present report describes a flapless extraction method for partially impacted mandibular third molars and compares the effects of flap and flapless extractions of the teeth in terms of postoperative pain, swelling, and pocket depth of the second molar."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "A prospective study was performed of 27 patients who underwent bilateral extraction of partially impacted mandibular third molars. Two molars in the same patient were extracted on each side, either with or without a buccal flap."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The postoperative pain, swelling, and pocket depth of the second molar were all significantly greater on the side that underwent flap extraction than on the side that underwent flapless extraction (P < .05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our results support the clinical use of flapless extractions when the distal surface of the crown is completely anterior to the anterior border of the mandibular ramus and the occlusal surface of the impacted tooth is level or nearly level with the occlusal plane of the second molar."
          }
        ]
      },
