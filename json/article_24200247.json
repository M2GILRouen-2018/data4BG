      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "Examine whether individual-level childhood obesity is related to residential availability of fast food and healthy food outlets."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective cross-sectional study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Perth, Western Australia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "A total of 1850 children aged 5 to 15 years in 2005-2010 who participated in the Western Australian Health and Wellbeing Surveillance System survey."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASURES",
          "content": "Geographical Information Systems were used to calculate a range of measures of fast food and healthy food outlet access and availability. For example, distance to nearest and access and density measures within 800 m and 3 km of each child's residence were all tested."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANALYSIS",
          "content": "Multivariate logistic regression analysis, controlling for individual-level sociodemographic factors and lifestyle behaviors."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "An increasing number of healthy food outlets within 800 m of a child's home was associated with a significantly reduced risk of being overweight/obese in all models tested. After controlling for age, physical activity, time spent sedentary, weekly takeaway consumption, area disadvantage, and count of fast food outlets, each additional healthy food outlet within 800 m was associated with a 20% decrease in the likelihood of a child being overweight or obese (odds ratio: .800, 95% confidence intervals: .686-.933)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The local food environment around children's homes has an independent effect on child weight status. These findings highlight the importance of the built environment as a potential contributor towards child health, which should be considered when developing community health promotion programs."
        }
      ]},
