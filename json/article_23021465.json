      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine if closing the tonsil fossa after tonsillectomy leads to less pain and bleeding."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Interventional, Randomized, Single Blind, Active Control, Single Group Assignment, Safety/Efficacy Study."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FOLLOW-UP",
            "content": "2 months."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Generalized Estimating Equations (GEE) analyzed effects of tonsillar pillar closure, surgeon experience and interaction on outcomes."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Primarily academic tertiary care referral center, institutional practice, primarily children, both ambulatory and hospitalized care."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "763 subjects (age 8-264 months) undergoing tonsillectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "EXCLUSIONS",
            "content": "suspected malignancy or active peritonsillar abscess. At the discretion of the attending surgeon, patients undergoing tonsillectomy during the 4 year study period were offered participation. A computer selected the side closed. 131 subjects withdrew (complete lack of follow-up information) after the first 72 h."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "3-0 chromic sutures on tapered needles to close one tonsillar fossa. The subject was not told which side was closed."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "postoperative bleeding (at any time) and pain reported was sought on days 1, 7, 14, 21, and 28."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Closure of the tonsillar fossa did not change the risk of bleeding. Closing the tonsillar fossa had a 40% increase in the odds ratio of postoperative pain. In the tonsillar fossa sides left open, greater surgeon experience decreased the risk of bleeding. In closed sides, enriched surgeon experience increased the risk of bleeding (p<.0.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Suture closure of the tonsillar fossa after tonsillectomy does not reduce the risk of bleeding. Additionally, closing the tonsillar fossa increased postoperative pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "1b (individual randomized controlled trial)."
          }
        ]
      },
