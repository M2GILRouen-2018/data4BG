      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Identification of the genetic basis of asthma may contribute to the discovery of effective asthma drugs."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Our aim was to estimate the association between B2 adrenergic receptor (ADRB2) polymorphisms and nocturnal asthma in Egyptian children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "ADRB2 polymorphisms Gly16 and Glu27 were genotyped in 200 Egyptian children (90 with nocturnal asthma and 110 healthy controls) using allele-specific polymerase chain reaction."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The homozygous (Gly16) genotype significantly increased the risk of nocturnal asthma (odds ratio [OR], 3.2; 95% CI, 1.3-7.7; P = .003), as did the Gly allele (OR, 1.8: 95% CI, 1.2-2.8)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Our study demonstrated that nocturnal asthma was associated with ADRB2 Arg/Gly polymorphisms but not with ADRB2 Gln/Glu polymorphisms."
        }
      ]},
