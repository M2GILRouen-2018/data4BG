      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 International Federation of Clinical Neurophysiology. Published by Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To test if orofacial somatosensory perception can be modulated by experimental thermal application in healthy human."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twelve men and twelve age-matched women participated. In each session thermal application with 10, 42 or 32°C (cooling, warming, control) was applied to the skin over the right masseter using a thermode. Quantitative sensory testing was performed at the skin over the right (testing side) and left (contralateral side) masseter before, during, after the thermal application."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "During the cooling, mechanical detection threshold (MDT), mechanical pain threshold (MPT) and pressure pain threshold (PPT) were increased, and mechanical pain sensitivity was decreased at testing side compared with baseline (P<0.005). The MPT and PPT at the contralateral side were also increased (P<0.004). During the warming and control, the MDT was increased at the testing side compared with baseline (P=0.002). The somatosensory sensitivity was decreased during cooling compared to warming and control (P<0.05). No gender differences were found."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This study shows an ipsilateral decrease of cutaneous sensation or pain sensitivity during cooling without gender differences. In addition, hypoalgesia on the contralateral side suggests a central mode of action."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "SIGNIFICANCE",
            "content": "The results support clinical experiences that cooling may alleviates pain both locally and generally."
          }
        ]
      },
