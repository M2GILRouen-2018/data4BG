      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To review scientific evidence related to the benefits of swimming and present an evidence-based approach to prescribing swim training for children and adolescents with asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Extensive literature review of all research that has been done on swim training in asthmatic children and adolescents, using the databases CINAHL, Medline, and ProQuest."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "When swimming is compared to other sports in the scientific literature, it has been found to have a lower asthmogenicity. It has also been shown to decrease the severity of asthma symptoms. Swimming may be an effective nonpharmacological intervention for the child or adolescent with asthma."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR PRACTICE",
          "content": "Research findings are summarized regarding the benefits of swim training on children and adolescents with asthma, and a stepped three-level approach to swim prescription is outlined along with safety recommendations."
        }
      ]},
