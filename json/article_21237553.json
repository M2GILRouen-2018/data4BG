      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 SEICAP. Published by Elsevier Espana. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The objectives of this study were to determine the prevalence of asthma and allergies in 13- to 14-year-old adolescents in the city of Taubaté, São Paulo, Brazil using the INTERNATIONAL STUDY OF ASTHMA AND ALLERGIES IN CHILDHOOD (ISAAC) questionnaire and to describe the presence of risk factors in current asthma carriers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We used a cross-sectional study involving 920 adolescents who completed the ISAAC questionnaire and answered additional questions regarding smoking and the presence of pets and/or insects at home."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The mean prevalence rate of \"current asthma\" was 15.3% and \"asthma ever\" was 6.8%. The mean prevalence rate of \"current rhinitis\" was 36.6% and \"rhinitis ever\" 37.6%. The prevalence of \"eczema ever\" was 16.2%. The frequency of active smoking was low (0.7%), and the presence of indoor animals (34%) and of insects (55.1%) was high."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The prevalence of \"current asthma\" was twice as high as that of \"asthma ever\". There was no association between risk factors studied and current asthma."
          }
        ]
      },
