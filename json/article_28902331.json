      "Abstract": {
        "CopyrightInformation": "Copyright 2017, SLACK Incorporated.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVE",
            "content": "To identify qualitative and quantitative features of spectral-domain optical coherence tomography (SD-OCT) as prognostic indicators of visual acuity (VA) loss in patients with choroideremia (CHM)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Retrospective study of 57 male patients with CHM. Central foveal thickness (CFT), subfoveal choroidal thickness (SCT), fundus autofluorescence area, and evidence of outer retinal and choroidal degeneration were analyzed by SD-OCT."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Best-corrected VA logMAR at baseline was associated with CFT at baseline (r = -0.47; P < .01), CFT at most recent follow-up (r = -0.27; P < .01), and SCT at baseline (r = -0.31; P < .01). Ellipsoid zone (EZ) rupture was associated with a higher CFT loss (r = 0.33; P < .01) and macular cystic spaces (MCS) with a reduction in VA over time (hazard risk = 0.48; P = .05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Reduced CFT at baseline, EZ rupture, and MCS are poor prognostic indicators for VA outcome. [Ophthalmic Surg Lasers Imaging Retina. 2017;48:711-716.]."
          }
        ]
      },
