      "Abstract": {
        "CopyrightInformation": "© International Headache Society 2015.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Several treatment guidelines exist for cluster headache. However, it is not yet known how many cluster headache patients are treated according to these guidelines."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We enrolled 434 cluster headache patients with confirmed diagnosis referred to two tertiary pain centers. The history of treatment was registered and analyzed according to the treatment guidelines of the European Federation of Neurological Societies."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Regarding acute attack treatment, 62.1% of the episodic and 71.0% of the chronic cluster headache patients were treated according to the guidelines. The efficacy rate was above 92% in both groups. Regarding prophylactic treatment, 31.3% of the episodic and 50.9% of the chronic cluster headache patients were treated according to the guidelines. The efficacy rate was 92.8% for episodic and 70.9% for chronic cluster headache."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The rate of guideline-adherent treatment in cluster headache is about 70% for acute treatment and about 35% for prophylactic treatment. The efficacy of this treatment is significantly higher than the efficacy of non-guideline-adherent treatment."
          }
        ]
      },
