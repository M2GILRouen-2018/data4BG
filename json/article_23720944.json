      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Data about the implementation of long-term follow-up of weight loss operation patients and their nutritional status has been lacking in Finland."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "We examined the postoperative complications and long-term outcome in respect of weight control, symptoms, nutritional status and medication of 173 patients having undergone gastric bypass. The data were collected from patient records and by questionnaires."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Postoperative complications and weight loss were at the international level. The number of those using antidiabetic and antihypertensive drugs decreased."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The results are in agreement with the international level, but follow-up treatment requires attention in Finland."
        }
      ]},
