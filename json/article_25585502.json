      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Our objective is to investigate the efficacy and safety of intraperitoneal dexmedetomidine (Dex) combined with bupivacaine in patients undergoing laparoscopic colorectal cancer surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized double-blind study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Academic medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "Forty-five patients scheduled for laparoscopic colorectal cancer surgery were randomly assigned for intraperitoneal administration of 50 mL saline (control group; GI, n\u2009=\u200915), 50 mL bupivacaine 0.25% (125 mg; GII, n\u2009=\u200915), or 50 mL bupivacaine 0.25% (125 mg) +1 μg/kg Dex (GIII, n\u2009=\u200915). Patients were assessed during the first 24 hours postoperatively for hemodynamics, visual analogue scale (VAS), time to first request of analgesia, total analgesic consumption, shoulder pain, and side effects."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A significant reduction was observed in VAS in GIII at base line, 2, 4, and 24 hours postoperatively in comparison to GI and GII (P\u2009<\u20090.05). The time to first analgesic requirement was significantly prolonged in GIII (P\u2009<\u20090.05). The mean total consumption of rescue analgesia was significantly reduced in GIII."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "We conclude that intraperitoneal administration of Dex 1 μg/kg combined with bupivacaine improves the quality and the duration of postoperative analgesia and provides an analgesic sparing effect compared to bupivacaine alone without significant adverse effects in patients undergoing laparoscopic colorectal cancer surgery."
          }
        ]
      },
