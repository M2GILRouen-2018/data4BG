      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To describe a novel treatment of chronic pelvic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Dextroamphetamine sulfate was prescribed to a woman with unexplained chronic pelvic pain. Pelvic ultrasound, colonoscopy, and lower gastrointestinal radiographic studies were negative. Laparoscopy was offered as the next diagnostic test but the woman requested an attempt at medical therapy first. Based on previous experience of dramatic relief of chronic pelvic pain of bladder origin with sympathomimetic amine therapy she was started on dextroamphetamine sulfate."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The relief of pain approximated 100% almost immediately and the pain relief has persisted for six months. Inadvertent failure to take the prescribed medication allowed the pain to return immediately only to disappear again once the medication was taken."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Disorders of the sympathomimetic nervous system may be a cause of chronic pelvic pain and are relieved by treatment with sympathomimetic amines."
        }
      ]},
