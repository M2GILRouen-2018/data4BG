      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The management of intractable pain in chronic pancreatitis is difficult. A novel method for its relief is described."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Twelve patients were given a mixture of buprenorphine (0.3 mg) and blood (10-15 mL) into the epidural space."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "All patients had pain relief lasting up to six months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Epidural buprenorphine injection is a simple, safe and effective method for pain relief in chronic pancreatitis."
        }
      ]},
