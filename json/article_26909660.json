      "Abstract": {
        "CopyrightInformation": "© 2016 World Obesity Federation.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Increased consumption of sweetened beverages has previously been linked to the degree of childhood obesity."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of the present study was to assess whether the intake of sweetened beverages, candy, snacks or fast food at baseline in a multidisciplinary childhood obesity treatment program was associated with the baseline degree of obesity or the treatment effect."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This prospective study included 1349 overweight and obese children (body mass index standard deviation scores (BMI SDS)\u2009≥\u20091.64) enrolled in treatment at The Children's Obesity Clinic, Copenhagen University Hospital Holbaek. The children were evaluated at baseline and after up to 5.9\u2009years of treatment (median 1.3\u2009years)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Both boys and girls decreased their BMI SDS during treatment with a mean decrease in boys of 0.35 (p\u2009<\u20090.0001) and in girls of 0.22 (p\u2009<\u20090.0001) after 1\u2009year of treatment. There were no associations between the baseline intake of sweetened beverages, candy, snacks, and/or fast food and BMI SDS at baseline or the change in BMI SDS during treatment."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The intake of sweetened beverages, candy, snacks or fast food when entering a childhood obesity treatment program was not associated with the degree of obesity at baseline or the degree of weight loss during treatment."
          }
        ]
      },
