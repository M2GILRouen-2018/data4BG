      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To explore the methodology for investigating the tenderness of acupuncture points, with particular reference to the hypothesis that the point Spleen 6 (SP6) is more tender in women than in men."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Single-blind, observational study with volunteers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "University of Exeter, U.K."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Student volunteers, 13 male and 13 female."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Pressure thresholds at SP6, a control acupuncture point Stomach 36, and two nonacupuncture control sites in each leg were measured weekly for 4 weeks."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No statistically significant differences were found between the pressure thresholds of SP6 in women and those in men."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The present study provides no strong evidence to support the hypothesis that the acupuncture point SP6 is more tender in women and in men. Recommendations for further investigations are discussed."
        }
      ]},
