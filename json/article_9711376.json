      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "We describe a patient in whom a manic episode was precipitated by use of panadeine forte, a preparation containing codeine and paracetamol."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CLINICAL PICTURE",
          "content": "The patient developed a discrete manic psychotic episode."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "TREATMENT",
          "content": "The treatment consisted of cessation of the Panadeine forte and antipsychotic medication."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "OUTCOME",
          "content": "The patient made a complete recovery after 1 week."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Mania can be induced by large doses of Panadeine forte, particularly if there is a biological predisposition."
        }
      ]},
