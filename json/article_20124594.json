      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The optimal combination of anticoagulant and antiplatelet therapy following percutaneous coronary intervention with stenting (PCI-S) among patients requiring oral anticoagulation (OAC) is unknown."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "We sought to compare the efficacy of a modified dual-antiplatelet regimen (daily aspirin and every other day clopidogrel) to conventional treatment (daily aspirin and daily clopidogrel) following percutaneous coronary intervention (PCI) with drug-eluting stents (DES) among patients who are also discharged on warfarin."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We performed a single-center, retrospective analysis of consecutive patients (n = 454) who underwent PCI-S with DES and were discharged on warfarin and either a conventional (n = 170) or modified (n = 284) antiplatelet regimen between March 2003 and May 2007. In-hospital and 1-year events were compared between the two groups."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "There were no differences in 1-year rates of death, myocardial infarction, stent thrombosis or target lesion revascularization between patients receiving a conventional compared to a modified antiplatelet regimen. In-hospital bleeding rates were also similar between the two groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "An antiplatelet regimen of aspirin with every-other-day clopidogrel may be as efficacious as daily aspirin and clopidogrel among patients receiving warfarin following PCI-S with DES."
        }
      ]},
