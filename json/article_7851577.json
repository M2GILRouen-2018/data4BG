      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether the symptoms of endometriosis were related to the number and/or location of endometrial implants and the number and/or location of adhesions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, double-blind study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Seventy consecutive female surgical patients undergoing diagnostic and operative laparoscopy for pain, infertility, or both."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients completed a self-administered questionnaire one day before laparoscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The number, type, and location of endometrial implants and the number, type, and location of adhesions were evaluated during laparoscopy. These were compared with the type and severity of endometriosis symptoms as reported by patients."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The total number of ectopic endometrial implants was associated directly with the intensity of dysmenorrhea experienced by patients in the 60 days before operative laparoscopy (n = 47). Patients with low pain scores had significantly fewer implants than patients with high pain scores."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The intensity of menstrual pain is related to the number of endometrial implants in patients with endometriosis."
        }
      ]},
