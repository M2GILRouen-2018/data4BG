      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the relationship between physical activity (PA) and health-related quality of life among university employees who enrolled in a worksite wellness program (WWP)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The study was an interim analysis of data collected in a WWP. The sample consisted of 64 participants who completed 12- and 26-week follow-up appointments."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Self-reported anxiety days significantly decreased from baseline to week 12. There were positive trends in self-rated health, vitality days, and summative unhealthy days from baseline to week 26. Among those with a self-reported history of hypertension (HTN), there was an inverse correlation between PA and summative physically and mentally unhealthy days at week 12."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Among participants in this WWP with HTN, as PA increased there was a significant decrease in summative physically and mentally unhealthy days at week 12."
        }
      ]},
