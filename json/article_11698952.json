      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "We report an intraoperative retrograde dissection of the aorta and its subsequent evaluation by transesophageal echocardiography (TEE)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE PRESENTATION",
          "content": "A 78 year old woman with an ascending aortic aneurysm without dissection and coronary artery disease was brought to the operating room for aneurysm repair and coronary artery bypass grafting. After initiation of cardiopulmonary bypass through a femoral artery cannula, aortic dissection was noted and subsequently imaged by TEE."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Retrograde aortic dissection through the femoral artery is life-threatening. Intraoperative TEE can be used to diagnose this uncommon event, and should be considered after initiation of bypass."
        }
      ]},
