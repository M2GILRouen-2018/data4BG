      "Abstract": {
        "CopyrightInformation": "Copyright © 2017. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Hybrid operation combining endovascular and open surgery procedure is supposed to achieve the recanalization for post-stenting long-segmental occlusion of VA ostium simultaneously."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE DESCRIPTION",
            "content": "One patient with post-stenting long-segmental occlusion in VA ostium was reported. His symptoms could not be relieved by medical therapy. Recanalization combining endovascular and open surgery procedure simultaneously was performed. The hybrid recanalization was success and the patient demonstrated with no symptoms attacked during the follow-up."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Hybrid operation is a potential and feasible method to recanalize the long-segmental occlusion in VA ostium post-stenting treatment."
          }
        ]
      },
