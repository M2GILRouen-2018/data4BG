        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Primary aim was to compare the functional results at 3 months and 2 years between short and conventional cementless stem total hip arthroplasty (THA). Secondary aim was to determine the feasibility of a double-blind implant-related trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A prospective blinded randomised controlled multicentre trial in patients with osteoarthritis of the hip. All patients, research assistants, clinical assessors, investigators and data analysts were blinded to the type of prosthesis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "POPULATION",
            "content": "150 patients between 18 and 70 years with osteoarthritis of the hip, 75 in the short stem and 75 in the conventional stem group. Mean age: 60 years (SD 7)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "the Collum Femoris Preserving short stem versus the Zweymuller Alloclassic conventional stem."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "The Dutch version of the Hip Disability and Osteoarthritis Outcome Score (HOOS). Secondary outcomes measures: Harris Hip Score, the Physical Component Scale of the SF12, the Timed Up and Go test, Pain and the EQ-5D. Feasibility outcomes: continued blinding, protocol adherence and follow-up success rate."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No significant difference between the two groups. Mean HOOS total score in the short stem group increased 32.7 points from 36.6 (95% CI 32.9 to 40.2) preoperatively to 69.3 (95% CI 66.4 to 72.1) at 3 months follow-up. Mean HOOS total score in the conventional straight stem group increased 36.3 points from 37.1 (95% CI 33.9 to 40.3) preoperatively to 73.4 (95% CI 70.3 to 76.4) at 3 months follow-up. 91.2% of patients remained blinded at 2\u2009years follow-up. Both protocol adherence and follow-up success rate were 98%."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Functional result at 3 months and 2 years after short stem THA is not superior to conventional cementless THA. There were more perioperative and postoperative complications in the short stem group. Direct comparison of two hip implants in a double-blinded randomised controlled trial is feasible."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "TRIAL REGISTRATION NUMBER",
            "content": "NTR1560."
          }
        ]
      },
