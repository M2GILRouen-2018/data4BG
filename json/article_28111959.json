      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "In metabolomics research, the use of different blood collection methods may influence endogenous metabolites."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS & METHODS",
          "content": "Ultra HPLC coupled with MS/MS was applied together with multivariate statistics to investigate metabolomics differences in serum and plasma samples handled by different anticoagulants. A total of 135 known representative metabolites were assessed for comprehensive evaluation of the effects of anticoagulants."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Exogenous factors, including separation gel ingredients from the serum collection tubes and the anticoagulants, affected mass spectrometer detection. Heparin plasma yielded the best detection of different functional groups and is therefore the optimal blood specimen for metabolomics research, followed by potassium oxalate plasma."
        }
      ]},
