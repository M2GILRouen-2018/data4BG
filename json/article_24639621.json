      "Abstract": {
        "CopyrightInformation": "© 2017 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To describe infant activity at 3 months old and to test the efficacy of a primary care-based child obesity prevention intervention on promoting infant activity in low-income Hispanic families."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This study was a randomized controlled trial (n\u2009=\u2009533) comparing a control group of mother-infant dyads receiving standard prenatal and pediatric primary care with an intervention group receiving \"Starting Early,\" with individual nutrition counseling and nutrition and parenting support groups coordinated with prenatal and pediatric visits. Outcomes included infant activity (tummy time, unrestrained floor time, time in movement-restricting devices). Health literacy was assessed using the Newest Vital Sign."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Four hundred fifty-six mothers completed 3-month assessments. Infant activity results were: 82.6% ever practiced tummy time; 32.0% practiced tummy time on the floor; 34.4% reported unrestrained floor time; 56.4% reported ≥1 h/d in movement-restricting devices. Inadequate health literacy was associated with reduced tummy time and unrestrained floor time. The intervention group reported more floor tummy time (OR 2.16, 95% CI 1.44-3.23) and unrestrained floor time (OR 1.69, 95% CI 1.14-2.49) compared to controls. No difference in the time spent in movement-restricting devices was found."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Tummy time and unrestrained floor time were low. Primary care-based obesity prevention programs have potential to promote these activities."
          }
        ]
      },
