      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This study aimed to compare the results of knee MRIs of former football players with no previous knee surgeries with non-regular practitioners of impact sports, matched by age and sex, and combine these results with other variables such as current quality of life and pain in the knees."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The study participants were 16 male former professional football players and 21 male volunteers from different non-sports professional areas. All participants underwent bilateral magnetic resonances. Specific knee evaluations with regard to osteoarthritis and quality of life were performed in both groups by applying the Knee Injury and Osteoarthritis Outcome Score (KOOS) subjective questionnaires and SF-36, respectively."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The between-group comparison revealed significant differences on: pain, symptoms, and quality of life related to the knee in KOOS subscales; physical aspects and vitality subscale of SF-36; and former soccer players had worst magnetic resonances scores than controls."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Results of this study indicate probable specific adverse effects associated with participating in professional football."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "LEVEL OF EVIDENCE",
          "content": "Cross-sectional study, Level III."
        }
      ]},
