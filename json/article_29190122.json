      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "This project used Boot Camp Translation (BCT) to translate the complex medical jargon of biobanking into locally relevant evidence-based messages and materials to support increased knowledge and understanding in the local community."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Biobank BCT was a partnership of 16 community members and 5 academic researchers. The partnership met for 8 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The partnership developed five main and seven submessages to assist patients and community members in making an informed decision about enrollment in a biobank."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "The resulting messages balance an individual's right to privacy and choice, while encouraging participation for the greater good."
        }
      ]},
