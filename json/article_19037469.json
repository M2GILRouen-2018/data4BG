      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The painful mouth presents a diagnostic challenge to the general practitioner. Despite curriculum revision of most medical courses, oro-pharyngeal diseases are still inadequately covered."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This article aims to alert the GP to common causes of a painful mouth and provides a guide to diagnosis and management."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Four case studies are presented to illustrate common problems presenting in general practice, and their optimal treatment."
        }
      ]},
