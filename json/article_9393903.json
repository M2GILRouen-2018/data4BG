      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Despite the significant attention directed toward optimizing arthroscopic rotator cuff repair, there has been less focus on rehabilitation after rotator cuff repair surgery."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the effect of different rehabilitation protocols on clinical outcomes by comparing early versus late mobilization approaches and continuous passive mobilization (CPM) versus manual therapy after arthroscopic rotator cuff repair."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "PubMed was searched for relevant articles using the keywords rotator cuff, rotator, cuff, tears, lacerations, and rehabilitation to identify articles published from January 1980 to March 2014."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY SELECTION",
          "content": "Inclusion criteria consisted of articles of level 1 or 2 evidence, written in the English language, and with reported outcomes for early versus late mobilization or rehabilitation with CPM versus manual therapy after primary arthroscopic rotator cuff repair. Exclusion criteria consisted of articles of level 3, 4, or 5 evidence, non-English language, and those with significantly different demographic variables between study groups. Included studies were evaluated with the Consolidated Standards of Reporting Trials criteria."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Systematic review."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "LEVEL OF EVIDENCE",
          "content": "Level 2."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA EXTRACTION",
          "content": "Level of evidence, study type, number of patients enrolled, number of patients at final follow-up, length of follow-up, age, sex, rotator cuff tear size, surgical technique, and concomitant operative procedures were extracted from included articles. Postoperative data included clinical outcome scores, visual analog score for pain, shoulder range of motion, strength, and rotator cuff retear rates."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of 7 studies met all criteria and were included in the final analysis. Five studies compared early and late mobilization. Two studies compared CPM and manual therapy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In general, current data do not definitively demonstrate a significant difference between postoperative rotator cuff rehabilitation protocols that stress different timing of mobilization and use of CPM."
        }
      ]},
