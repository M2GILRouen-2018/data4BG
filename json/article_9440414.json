      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To evaluate the relation between variability of the torque curves and factors such as age, gender, measurement speeds, and period from low back pain (LBP) onset at isokinetic trunk strength testing."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Observational."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "One hundred forty-three consecutive LBP patients (acute, subacute, and chronic) who received physical therapy, and 200 healthy volunteer subjects."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "The variability of the torque curves is an indicator of consistency of effort, and was measured as the coefficient of variance (CV) at different measurement speeds in isokinetic trunk flexion/extension strength testing."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The CV was lower in men than in women at the faster measurement speed. LBP patients had higher CV values than healthy subjects. The CV was different according to gender and measurement speed, but not different according to age and periods from LBP onset."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The CV was affected by measurement speed and gender, but not by age or period from LBP onset. Because the CV was higher in LBP patients than in healthy subjects, this value may be usable as an adjunctive index of LBP."
        }
      ]},
