      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 International Federation of Clinical Neurophysiology. Published by Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Disruption in the neural activation of the prefrontal cortex (PFC) in modulating arousal was explored in children with heavy prenatal alcohol exposure (PAE), who have known neurobehavioral impairment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "During a task that elicits frustration, functional near-infrared spectroscopy (fNIRS) was used to measure PFC activation, specifically levels of oxygenated (HBO) and deoxygenated (HBR) hemoglobin, in children with PAE (n=18) relative to typically developing Controls (n=12) and a Clinical Contrast group with other neurodevelopmental or behavioral problems (n=14)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Children with PAE had less activation during conditions with positive emotional arousal, as indicated by lower levels of HBO in the medial areas of the PFC and higher levels of HBR in all areas of the PFC sampled relative to both other groups. Children in the Control group demonstrated greater differentiation of PFC activity than did children with PAE. Children in the Clinical Contrast group demonstrated the greatest differences in PFC activity between valences of task conditions."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Specific patterns of PFC activation differentiated children with PAE from typically developing children and children with other clinical problems."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "SIGNIFICANCE",
            "content": "FNIRS assessments of PFC activity provide new insights regarding the mechanisms of commonly seen neurobehavioral dysfunction in children with PAE."
          }
        ]
      },
