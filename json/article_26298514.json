      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Society for Nutrition Education and Behavior. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The cross-site process evaluation plan for the Childhood Obesity Research Demonstration (CORD) project is described here."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "The CORD project comprises 3 unique demonstration projects designed to integrate multi-level, multi-setting health care and public health interventions over a 4-year funding period."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Three different communities in California, Massachusetts, and Texas."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "All CORD demonstration projects targeted 2-12-year-old children whose families are eligible for benefits under Title XXI (CHIP) or Title XIX (Medicaid)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "The CORD projects were developed independently and consisted of evidence-based interventions that aim to prevent childhood obesity. The interventions promote healthy behaviors in children by applying strategies in 4 key settings (primary care clinics, early care and education centers, public schools, and community institutions)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "The CORD process evaluation outlined 3 main outcome measures: reach, dose, and fidelity, on 2 levels (researcher to provider, and provider to participant)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "The plan described here provides insight into the complex nature of process evaluation for consortia of independently designed multi-level, multi-setting intervention studies. The process evaluation results will provide contextual information about intervention implementation and delivery with which to interpret other aspects of the program."
          }
        ]
      },
