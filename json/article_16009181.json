      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To construct a uterovaginal canal in a patient with a complete cervical agenesis and partial vaginal agenesis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Zeynep Kamil Women's and Children Hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A 15-year-old woman presented with lower abdominal pain. On examination, partial vaginal agenesis with a 4-cm vagina was noted. A pelvic ultrasonography revealed hematometra and the absence of a cervix."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Surgical therapy included creation of an ostium by making 1.5-cm midline vertical hysterotomy incision, trimming away the fibrous tissue at the distal portion of uterus, and attaching the proximal end of the vagina to the uterus by the abdominal route. A stent was left in place for 2 weeks."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Pelvic ultrasonography and clinical follow-up evaluation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Regular menstrual periods were observed for 6 months beginning at the first month. The follow-up pelvic ultrasonography was normal."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Cervicoplasty attaching the mucosal lining of the endometrium to that of the vagina permits the creation of a patent cervical canal with short stenting time."
        }
      ]},
