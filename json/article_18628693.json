      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A randomized prospective cohort study of participants with chronic low back pain, seeking physical therapy, with follow-up at weeks 6 and 28. Effects of conventional physiotherapy and physiotherapy with the addition of postural biofeedback were compared."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the benefits of postural biofeedback in chronic low back pain participants."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "SUMMARY OF BACKGROUND DATA",
          "content": "Biofeedback using electromyographic signals has been used in chronic low back pain with mixed results. Postural feedback had not been previously used."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Demographic and psychological baseline data along with range of motion were analyzed from a sample of 47 chronic participants with low back pain randomized into conventional physiotherapy with or without the addition of postural biofeedback."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After 6 months, there were 21 dropouts. The participants with biofeedback had markedly improved status in visual analog pain scales, short form-36, and range of motion."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The study strongly suggests that postural feedback is a useful adjunct to conventional physiotherapy of chronic low back pain participants."
        }
      ]},
