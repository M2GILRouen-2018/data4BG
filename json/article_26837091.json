      "Abstract": {
        "CopyrightInformation": "Reprint & Copyright © 2016 Association of Military Surgeons of the U.S.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "Here we present a rare finding of a discoid medial meniscus."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Clinical reports, radiographs, magnetic resonance imaging (MRI) results, and intraoperative arthroscopic images highlight this rare clinical entity."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We have demonstrated successful treatment with arthroscopic partial meniscectomy and saucerization of discoid medial meniscus."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Discoid medial menisci are a rare cause of medial knee pain and should be considered if classic MRI findings are associated with mechanical symptoms."
          }
        ]
      },
