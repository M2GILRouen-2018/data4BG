      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "This study sought to determine the predictors of smoking and time until smoking cessation in a cohort of adults with asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Adults with asthma (n = 374) in northern California completed structured telephone interviews at baseline and 18-month follow-up."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of the 374 subjects, 156 reported ever having smoked, and 39 indicated that they currently smoked. Earlier birth cohort, lower educational attainment. White race, and presence in childhood residence of an adult who smoked were associated with a greater risk of ever smoking. Lower educational attainment, early smoking initiation, higher daily cigarette consumption, and late-childhood-onset asthma were associated with a longer interval until smoking cessation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Persons with asthma at high risk of cigarette smoking and delayed quitting can be identified on the basis of clinical and demographic characteristics."
        }
      ]},
