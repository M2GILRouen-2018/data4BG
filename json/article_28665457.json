      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Perineal schwannomas (PS) are very rare benign tumors with few cases reported in literature and none of these reports erectile dysfunction among clinical presentations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE DESCRIPTION",
          "content": "We report a case of PS with unusual clinical presentation showing erectile dysfunction associated with perineal pain and discomfort during defecation, and the postoperative residual pain and erectile dysfunction treatment."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "On the basis of a literature review of all cases reported and on our case reported, we have delineated a clinical, diagnostic, and therapeutic profile of PS, summarized in a useful table."
        }
      ]},
