      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "This report highlights the significance of endovascular training for invasive cardiologists."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "78-year-old morbidly obese male with an inferior wall myocardial infarction underwent primary percutaneous coronary intervention (PCI) which was complicated by laceration of the profunda femoris artery. Endovascular repair of the profunda femoris artery was performed by using Jomed covered stents."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This case report of endovascular repair of lacerated profunda femoris artery signifies the importance of endovascular training for invasive cardiologist."
        }
      ]},
