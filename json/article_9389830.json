      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To review the use of radiotherapy for relieving the symptoms of recurrent endometriosis caused by functioning ovarian remnants."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective study (case report)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "A woman with recurrent endometriosis of 14 years' duration."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "After hysterectomy and bilateral oophorectomy, hormonal management, and multiple explorations for recurrent endometriosis, cycling ovarian remnants were confirmed histologically. Pelvic irradiation was used to ablate this tissue. A dose of 15 Gy in 10 daily fractions was given through anterior and posterior opposed fields using 18-mV photons."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "The patient had a prompt increase in FSH levels associated with castration levels of serum E2. A review of the literature on the use of radiotherapy in this clinical situation is presented."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Radiotherapy should be considered in selected patients when ovarian castration is not a viable surgical option and hormonal therapies have failed."
        }
      ]},
