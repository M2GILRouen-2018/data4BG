      "Abstract": {
        "CopyrightInformation": "Copyright (c) 2007 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the effect of the addition of Tonimer gel spray into nasal mucosa care on nasal mucosal findings and patient comfort in the postoperative period of endonasal surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHOD",
            "content": "40 patients who underwent endonasal surgery were included in the study. For the postoperative nasal care, isotonic saline was applied to both nasal cavities, and subsequently, Tonimer nasal gel spray was additionally applied to the right nasal cavity. Patients were examined on the 2nd, 7th, and 15th postoperative days. The findings of the examinations were scored with respect to crusting and the patient nasal comfort was assessed using the visual analog scale (VAS)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The VAS values which measure patient comfort and crusting were significantly lower on the Tonimer side compared to control (p < 0.01)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Tonimer and saline combination was found to be superior to saline per se in decreasing crusting and improving patient nasal comfort in the postoperative period."
          }
        ]
      },
