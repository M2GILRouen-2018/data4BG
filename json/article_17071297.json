      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Comparison of coblation and monopolar electrocautery tonsillectomy in terms of postoperative pain and recovery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Prospective double-blind randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Patients with recurrent tonsillitis requiring tonsillectomy were randomized to 2 groups: coblation or monopolar electrocautery tonsillectomy. Postoperative pain, complications, and days taken to return to work and normal diet were compared and analyzed with the aid of a pain diary, given to the patient."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "67 patients were recruited. Patients undergoing coblation tonsillectomy were able to return to normal diet in a shorter space of time following surgery. Patients undergoing coblation tonsillectomy were more likely to recommend the surgery than patients undergoing electrocautery tonsillectomy. No significant differences in the daily visual analog score for pain were seen for both groups of patients."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Our results showed that coblation tonsillectomy has a faster recovery period and may offer advantages when compared to monopolar electrocautery tonsillectomy."
        }
      ]},
