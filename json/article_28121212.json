      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report for the first time a case report of a Stargardt disease patient who developed a macular hole (MH) which was treated with a surgical approach."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Case report."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After vitrectomy a complete closure of the MH was obtained and the best-corrected visual acuity remained stable. No complications were reported after one year of follow-up. An ultra-structural examination of the removed internal limiting membrane (ILM) and epiretinal membrane (ERM) was carried out under electron microscopy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Vitreo-retinal surgery could represent a therapeutic option to treat vitreo-retinal interface abnormalities associated with inherited retinal diseases."
        }
      ]},
