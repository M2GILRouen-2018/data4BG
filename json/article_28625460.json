      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "Clinical repercussions of perioperative treatment with ACEIs/ARBs."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Systematic review according to PRISMA statement."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Perioperative period."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "29 studies 11 cases/cases series, 12 observational studies and 6 randomized studies."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Arterial blood pressure differences, refractory hypotension, other comorbidities."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "The studies show different results regarding the topics measured. They are divided in the results regarding blood pressure, long term morbidities and effects in neuraxial anesthesia."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Withholding AECI/ARBs on the morning prior to surgery could be recommended as a potentially effective measure, with a low level of evidence, in order to reduce the appearance of hypotension in the perioperative period of non-cardiac surgery."
          }
        ]
      },
