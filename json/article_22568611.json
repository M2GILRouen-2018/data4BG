      "Abstract": {
        "CopyrightInformation": "© 2012 The Authors. Journal of Obstetrics and Gynaecology Research © 2012 Japan Society of Obstetrics and Gynecology.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "We evaluated the effectiveness of high-frequency transcutaneous electrical nerve stimulation (TENS) as a pain relief resource for primiparous puerpere who had experienced natural childbirth with an episiotomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A controlled, randomized clinical study was conducted in a Brazilian maternity ward. Forty puerpere were randomly divided into two groups: TENS high frequency and a no treatment control group. Post-episiotomy pain was assessed in the resting and sitting positions and during ambulation. An 11-point numeric rating scale was performed in three separate evaluations (at the beginning of the study, after 60 min and after 120 min). The McGill pain questionnaire was employed at the beginning and 60 min later. TENS with 100 Hz frequency and 75 µs pulse for 60 min was employed without causing any pain. Four electrodes ware placed in parallel near the episiotomy site, in the area of the pudendal and genitofemoral nerves."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "An 11-point numeric rating scale and McGill pain questionnaire showed a significant statistical difference in pain reduction in the TENS group, while the control group showed no alteration in the level of discomfort. Hence, high-frequency TENS treatment significantly reduced pain intensity immediately after its use and 60 min later."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "TENS is a safe and viable non-pharmacological analgesic resource to be employed for pain relief post-episiotomy. The routine use of TENS post-episiotomy is recommended."
          }
        ]
      },
