      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Simultaneous pregnancy in each horn of a uterus didelphys is a rare and complex clinical situation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "Torsion of one horn of a gravid didelphic uterus during a twin pregnancy was diagnosed during cesarean delivery after erroneous diagnosis of abruptio placentae."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Localization of the placenta in a pregnancy complicated by uterine didelphys may improve the ability to diagnose hemiuterus torsion."
        }
      ]},
