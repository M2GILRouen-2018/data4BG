      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To study the effects of two resolvins of D series, RvD1 and 17(R)-RvD1, on inflammatory signs associated with endometriosis (ENDO)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "In vivo research study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Research laboratory."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANIMAL(S)",
            "content": "Female Sprague-Dawley rats."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Intravenous or intraperitoneal injections of RvD1 (300 ng/kg) or 17(R)-RvD1 (300 and 900 ng/kg) in rats with surgically induced ENDO."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Vascular permeability of ectopic endometrial growths was assessed by Evans Blue extravasation; vaginal hyperalgesia was assessed with telemetered visceromotor response."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Both resolvins, but not vehicle, significantly decreased vascular permeability in ectopic endometrial tissue. 17(R)-RvD1 also significantly alleviated severity of vaginal hyperalgesia."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Our results suggest that RvD1 and 17(R)-RvD1 can be considered for further investigation of their therapeutic potential for treating ENDO."
          }
        ]
      },
