      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "We studied the analgesic effects of 1 g paracetamol given rectally at the end of surgery in a prospective, randomised, double-blind study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "One hundred and forty ASA I-II women scheduled for elective termination of pregnancy under general anaesthesia were randomly allocated to receive paracetamol or placebo. All patients had standardised anaesthesia with propofol, fentanyl and oxygen in nitrous oxide. Postoperative pain was assessed by VAS score."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "We could find no difference regarding postoperative pain, need for analgesics or time to discharge between the groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The routine use of 1 g paracetamol given rectally at the end of surgery after termination of pregnancy seems not to be justified."
        }
      ]},
