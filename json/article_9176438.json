      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the efficacy of lignocaine spray during outpatient hysteroscopy in reducing the need for additional anesthesia and reducing the discomfort of the procedure."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A randomized double-blind, placebo-controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "An undergraduate university teaching hospital in London."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "One hundred twenty patients undergoing outpatient hysteroscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Application of lignocaine spray to the cervix, cervical canal, and uterine cavity during outpatient hysteroscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "The need to use additional anesthesia and the pain experienced at various steps of the procedure."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "Women treated with active spray experienced significantly less pain when the cervix was grasped with a tenaculum at the start of hysteroscopy. There were no other significant differences in the outcome of hysteroscopy between the placebo and lignocaine groups, although there was a significant reduction in the use of additional anesthesia in both groups compared with historical controls."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Lignocaine spray has beneficial effects on cervical but not uterine sensation. Pretreatment with either lignocaine or placebo seems to reduce the need for additional intracervical anesthesia during hysteroscopy."
        }
      ]},
