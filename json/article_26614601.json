      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Pelvic girdle pain is a frequent cause of sick leave among pregnant women in Denmark. Studies regarding prevention of pelvic girdle pain are sparse. The aim of this study was to examine the association between physical exercise and pelvic girdle pain in pregnancy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "A nested case-control study within the Danish National Birth Cohort (n\u2009=\u20095304)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This study used self-reported data on pelvic girdle pain obtained from an interview six months after childbirth. Information on physical exercise was obtained from the pregnancy interview around gestational week 16. The association was estimated using logistic regression analysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Physical exercise in pregnancy was associated with decreased risk of overall pelvic girdle pain (OR\u2009=\u20090.87; 95% CI: 0.77-0.99, p\u2009=\u20090.028). Tests for trend indicated decreasing odds for pelvic girdle pain with increasing number of hours per week spent on exercise (p\u2009<\u20090.001). Compared to no exercise, swimming was associated with a decreased risk of pelvic girdle pain (OR\u2009=\u20090.73; 95% CI: 0.58-0.91, p\u2009=\u20090.005)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The findings suggest a possible protective effect of physical exercise on pelvic girdle pain during pregnancy."
          }
        ]
      },
