      "Abstract": {
        "CopyrightInformation": "Copyright 2009. Published by Elsevier Masson SAS.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Horton's disease is the most common vasculitis of elder people. Several neurological complications are reported, but pachymeningitis is exceptional."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OBSERVATION",
            "content": "A 71-year-old patient who presented headache, hyperesthesia of the scalp, weight loss with a biological inflammatory syndrome and meningeal thickening on MRI. The diagnosis of pachymeningitis related to Horton's disease was retained. The patient was treated by corticosteroids with a good clinical, biological and radiological course after 22 months."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Horton's disease is a potential diagnosis in elderly persons with pachymeningitis and inflammatory syndrome."
          }
        ]
      },
