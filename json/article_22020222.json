      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 The Canadian Society of Clinical Chemists. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine if the pro-MMP-9/TIMP-1 ratio is an accurate surrogate for endogenously active MMP-9 levels."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Plasma active MMP-9, pro-MMP-9 and TIMP-1 were measured in 295 patients."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was a weak negative correlation between the pro-MMP-9/TIMP-1 ratio and active MMP-9. TIMP-1 was more closely correlated with active MMP-9 than pro-MMP-9."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Pro-MMP-9/TIMP-1 ratio measured with ELISA is not a good surrogate measure for active MMP-9, and direct measurements of active MMP-9 are therefore recommended."
          }
        ]
      },
