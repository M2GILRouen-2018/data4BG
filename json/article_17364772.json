      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The aim of this study was to identify predicting factors for successful vocational rehabilitation for people with back pain problems."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "The study was based on data from 347 long-term sick-listed clients collected at the onset of vocational rehabilitation. The outcome was measured 6 months after the conclusion of rehabilitation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In a first bi-variate analysis, a considerable number of variables were associated with the rehabilitation outcome. In a second multivariate analysis, only four associations remained. These were age, general health, vitality and internal locus of control. Young vital clients in good general health, with a high internal locus of control were more likely than others to return to work."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The findings regarding age, general health and vitality are well in line with previous studies. The findings regarding internal locus of control are more unique."
        }
      ]},
