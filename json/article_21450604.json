      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "We investigated the prevalence of the myocyte enhancer factor (MEF)2A exon 11 deletion, a putative coronary artery disease (CAD) susceptibility gene, in patients referred for coronary angiography."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "METHODS AND RESULTS",
          "content": "In total, 1079 consecutive patients referred for coronary angiography in the GENICA Study were genotyped and 301 low-risk subjects were used as controls. One patient with early onset three vessels CAD, carrying the MEF2A deletion was found in the GENICA Study cohort and none in the control group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In a cohort of patients undergoing coronary angiography for suspected CAD the MEF2A exon 11 deletion occurred in 0.09%."
        }
      ]},
