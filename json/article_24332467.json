      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "The purpose of this study was to describe how patients perceive the use of the numeric rating scale in postoperative pain assessments."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "There are recommendations to use a pain scale to follow patients' postoperative pain. Most patients prefer the NRS but there is a discrepancy between patients and healthcare professionals how to interpret the ratings from the pain assessments."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A descriptive design with a phenomenographic approach was used. Semi structured interviews were held with 25 patients."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Three description categories emerged that illustrate patients' perceptions; use of the NRS facilitated communication of pain, it put demands on healthcare professionals and care routines and it contained interpretation difficulties."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The NRS has a place in pain management according to the patients but there is a need for a dialogue to give the patients the opportunity to describe their pain and set a common goal."
          }
        ]
      },
