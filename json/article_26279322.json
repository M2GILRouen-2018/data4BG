      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 The Voice Foundation. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To characterize the presence of and risk factors for throat pain or irritation among male and female university teachers in private institutions within the city of São Paulo."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "This is a cross-sectional survey."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Voice self-evaluation forms prepared by the Brazilian Ministry of Labor were administered to 846 university teachers in a private institution in the city of São Paulo, Brazil."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The prevalence of throat pain or irritation was 50.8% and was higher in the women (62.7%) than in the men (43.5%). The prevalence of throat pain or irritation was higher among professionals ≤60 years old and among those who spent most of their time teaching compared with those who spent most of their time performing other professional activities. Other factors, such as noise and sound competition, air pollution, stress and anxiety, personal habits, and lifestyle/quality of life, were related to the presence of throat pain or irritation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "University teachers demonstrated a high prevalence of throat pain or irritation. Factors such as age ≤60 years, female gender, time-consuming professional activities, noise and sound competition in the work environment, stress and anxiety, air pollution, access to water, personal habits, and lifestyle/quality of life were related to the presence of throat pain or irritation."
          }
        ]
      },
