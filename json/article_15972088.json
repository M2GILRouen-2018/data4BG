      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Pain continues to be a problem in ambulatory patients with cancer. Disparities in minority patients with pain have been previously identified."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine the effect of perception of control over pain on disparities in pain, symptom distress, and functional status in white and black patients with cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Cross-sectional, descriptive."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient clinic in a large urban cancer center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "A total of 281 patients who reported having pain within the last month and were receiving treatment in the cancer center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Pain intensity, pain-related distress, functional status, perception of control over pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Black patients had significantly higher pain intensity, more pain-related distress, and reported more pain-related interference with function than white patients. Disparities in pain-related distress and functional status were significantly reduced and only disparities in pain intensity remained when perception of control over pain was held constant."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Perception of control over pain is an important factor in understanding responses to pain. Increasing a patient's perception of control over pain may decrease disparities and increase functional status."
        }
      ]},
