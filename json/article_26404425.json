      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Keloids may follow local skin trauma or inflammation leading to pruritus, pain, restriction of movement or cosmetic disfigurement."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To compare between the efficacy and tolerability of spray versus intralesional cryotherapy for keloids."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS AND METHODS",
          "content": "Fifty patients with keloids were randomized to treatment with spray cryotherapy (group I) or intralesional cryotherapy (group II). Swada and Sone scoring of scars was performed at treatment and follow-up (6 months). Histopathological examination was done before and after end of treatment sessions."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Intralesional cryotherapy showed greater efficacy than spray cryotherapy. Fewer treatments were required with intralesional cryotherapy than with spray cryotherapy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Intralesional cryotherapy was more effective and tolerable modality for treatment of keloids than spray technique with greater internal freezing area."
        }
      ]},
