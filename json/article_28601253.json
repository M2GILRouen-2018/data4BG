      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "Drawn from one of the keynote addresses at the State of the Science Conference held by the Council for the Advancement of Nursing Science (CANS), the purpose of this paper is to review the evidence from clinical trials about the importance of lifestyle behaviors in human health."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Evidence from trials on the impact of lifestyle interventions on outcomes in diabetes and prediabetes are presented."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "These findings suggest that lifestyle behaviors are important to diabetes prevention and outcomes in youth and adults."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS",
            "content": "More research is needed on the factors that predict these outcomes, especially genetics and environment."
          }
        ]
      },
