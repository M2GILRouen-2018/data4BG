      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "Critically ill or injured patients who are transported experience pain. Pain is associated with multiple adverse affects including tachycardia, hypertension, anxiety, elevated blood glucose levels, and diaphoresis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Using multiple search terms, the Cumulative Index of Nursing and Allied Health Literature and MEDLINE databases as well as pertinent Web sites were searched for relevant information."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "An important component of pain management is pain assessment, yet little empirically based literature is available regarding pain assessment for patients who are transported."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "The purpose of this article is to review the literature regarding the transport nursing environment and barriers to pain assessment during transport."
        }
      ]},
