      "Abstract": {
        "CopyrightInformation": "Copyright 2003, Elsevier Science (USA). All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "A series of 4 cases of omental infarction are analyzed. It is shown that obesity, as well as idiosyncratic anatomy, are factors in the development of this rare clinicopathologic entity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The authors reviewed the preoperative and operative records of all patients."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "All of the cases of omental infarction were seen in obese children. Other than persistent right-sided abdominal pain, there were no other signs or symptoms. None of the patients had an elevated white blood cell count, and none had fever."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Computed tomography scanning is noted to be helpful in making the diagnosis. Laparoscopy is noted to be the procedure of choice, because standard incisions may preclude one from a proper exploration."
          }
        ]
      },
