      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare the efficacy of high-dose (3,600\u2009mg/day) vs low-dose (1,200\u2009mg/day) oral gabapentin enacarbil (GEn) on pain intensity in adults with postherpetic neuralgia (PHN) and a history of inadequate response to ≥1,800\u2009mg/day gabapentin."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Multicenter, randomized, double-blind, crossover study (NCT00617461)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Thirty-five outpatient centers in Germany and the United States."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "Subjects aged ≥18 years with a diagnosis of PHN."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "During a 2-week baseline period, subjects received open-label treatment with 1,800\u2009mg/day gabapentin. Subjects who had a mean 24-hour average pain intensity score ≥4 during the last 7 days of the baseline period were randomized to receive GEn (1,200 or 3,600\u2009mg/day) for treatment period 1 (28 days), followed by GEn 2,400\u2009mg/day (4 days), and the alternate GEn dose for treatment period 2 (28 days)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was a modest but significant improvement in pain intensity scores with GEn 3,600\u2009mg vs 1,200\u2009mg (adjusted mean [90% confidence interval] treatment difference, -0.29 [-0.48 to -0.10]; P\u2009=\u20090.013). The difference in efficacy between doses was observed primarily in subjects who received the higher dose during treatment period 2; certain aspects of the study design may have contributed to this outcome. Plasma steady-state gabapentin exposure during GEn treatment was as expected and consistent between treatment periods. No new safety signals or adverse event trends relating to GEn exposure were identified."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "While the overall results demonstrated efficacy in a PHN population, the differences between treatment periods confound the interpretation. These findings could provide insight into future trial designs."
          }
        ]
      },
