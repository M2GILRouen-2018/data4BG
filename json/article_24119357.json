      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 AUR. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "RATIONALE AND OBJECTIVES",
            "content": "To evaluate the presence of nonalcoholic fatty liver disease (NAFLD) in eutrophic and obese adolescents with magnetic resonance imaging (MRI) and its relationship to insulin resistance and other potential biomarkers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "A total of 50 adolescents (aged 11-17 years), including 24 obese and 26 eutrophic adolescents, were evaluated using MRI exams for NAFLD diagnosis. Blood analysis was performed to measure glucose, insulin, total cholesterol, high-density lipoprotein cholesterol, triglycerides, fibrinogen, aminotransferases, alkaline phosphatase, gamma-gt, and C-reactive protein. The Homeostatic Model Assessment of Insulin Resistance (HOMA-IR) index was also calculated. Laboratory test results and anthropometric assessment were statistically analyzed to determine potential correlation with NAFLD prevalence."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The prevalence of NAFLD among the obese was significantly higher (83.3%; CI 95: 64.5-94.5%) than that of the eutrophic group (19.2%; CI 95: 7.4-37.6%). In multivariate analysis, only HOMA-IR was an independent risk factor for diagnosis NAFLD using MRI. Compared to eutrophic adolescents, the obese adolescents had significantly higher levels for all parameters measured except for total and high-density lipoprotein cholesterol, which were significantly lower."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The prevalence of NAFLD was 19.2% among eutrophic patients and 83.3% among obese patients. Only HOMA-IR was determined to be an independent risk factor for NAFLD."
          }
        ]
      },
