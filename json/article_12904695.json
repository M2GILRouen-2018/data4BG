      "Abstract": {
        "CopyrightInformation": "Copyright 2003 S. Karger AG, Basel",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the long-term outcome of patients undergoing uterine ventrosuspension for chronic pelvic pain and deep dyspareunia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Eighty-two patients, presenting with retroverted uterus, pelvic pain and deep dyspareunia, underwent uterine ventrosuspension by laparotomy or laparoscopy during the period from 1981 to 1996. Only patients (56) with no pelvic pathologic condition, as identified intraoperatively, participated in the study. At the beginning of the year 2002, 41 out of 56 patients (73.2%) were attained by telephonic questionnaire, and they were asked to refer to the uterine ventrosuspension procedure."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patients' average age was 32.3 years, and the mean duration of preoperative symptoms was 3 years. The mean follow-up period was 12 (range 5-20) years. The initial improvement in preoperative symptoms was observed in 70.7% of patients, whereas the final improvement was observed in 46.3% of patients, with no significant difference comparing the approach of laparotomy versus laparoscopy. Hysterectomy after uterine suspension was performed in 12.1% of patients (4.3% after laparotomy and 22.2% after laparoscopy). Twenty-three patients (56.1%) would recommend this operative procedure to others."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The long-term outcome of patients undergoing uterine ventrosuspesnion approximates to 50% success rate, with no significant difference comparing the approach of laparotomy versus laparoscopy."
          }
        ]
      },
