      "Abstract": {
        "CopyrightInformation": "Copyright 2010 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of the present study was to examine the relation between monocyte subsets and the presence, extent, and vulnerability characteristics of non-calcified coronary plaques (NCPs) as assessed by multidetector computed tomography (MDCT)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We studied 73 patients with stable angina pectoris who underwent MDCT. Two monocyte subsets (CD14(+)CD16(-) and CD14(+)CD16(+)) were measured by flow cytometry. Coronary artery plaques were assessed by 64-slice MDCT. We defined NCP vulnerability according to the presence of positive remodeling (remodeling index>1.05) and/or low CT attenuation plaques (<35 HU)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 40 (55%) patients had identifiable vulnerable plaques. The relative proportion of CD14(+)CD16(+) monocytes was significantly greater in patients with 1 or multiple vulnerable plaques than in patients with no vulnerable plaques or control (healthy) subjects. In addition, the relative proportion of CD14(+)CD16(+) monocytes was positively correlated with remodeling index (r=0.40, P<0.01) and negatively correlated with CT attenuation value (r=-0.34, P<0.01)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The present results suggest that an increased subset of CD14(+)CD16(+) monocytes is related to coronary plaque vulnerability in patients with stable angina pectoris."
          }
        ]
      },
