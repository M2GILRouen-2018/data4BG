      "Language": "rus",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To characterize clinical course of hepatogastroduodenal diseases (HGDD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "897 patients with HGDD were examined aged 15 to 82 years."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Three groups of patients were recognized: with predominant symptoms of pains in epigastric and hepatic area; with motor-evacuatory disturbances of the stomach and duodenum; with prevailing symptoms of asthenovegetative and depressive disorders."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Distribution of the patients by type of clinical course provides algorithm of examination and helps to formulate optimal therapeutic policy."
        }
      ]},
