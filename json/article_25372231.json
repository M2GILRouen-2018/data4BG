      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To examine predictors for persistent overweight/obesity, deteriorated weight status, and improved weight status among students who participated in a school-based obesity prevention intervention from fall 2009 to spring 2011."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Longitudinal assessment of a school-based cohort was conducted to determine the characteristics of students who remained overweight/obese, improved their weight status, or showed deteriorated weight status during an 18-month period."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Eleven schools in southern Indiana, northwestern Kentucky, and southeastern Illinois."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "N = 5309 students in 4th through 12th grade."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASURES",
          "content": "Weight, height, and self-reported physical activity and nutrition behaviors of students were measured at baseline and 6, 12, and 18 months."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANALYSIS",
          "content": "SAS 9.3 was employed to examine predictors for the three different weight categories using logistic regression."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Low socioeconomic status (SES) (adjusted odds ratio [AOR] = 1.56 and p < .001, AOR = 1.35 and p = .0069, respectively) and higher soda intake (AOR = 1.07 and p = .0016, AOR = 1.08 and p = .0278, respectively) increased the odds of belonging to persistent overweight/obesity (30.6%) and deteriorated weight status (6.9%), compared to the persistent nonoverweight status group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "While SES is an important determinant of weight category change, students' screen time and soda consumption may be important factors. Schools and families may be able to successfully focus on these modifiable risk factors, decreasing the burden of childhood obesity."
        }
      ]},
