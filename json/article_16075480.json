      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Preterm infants receive repeated heelsticks over their hospitalization, yet contradictions exist regarding the influence of prior heelsticks, prior painful procedures, and severity of illness on assessment of the pain responses."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSES",
          "content": "Compare pain responses to repeated heelsticks in infants of varying gestational age groups, and determine the influence of number of prior heelsticks, total number of prior painful procedures, and severity of illness on pain responses over time."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND METHODS",
          "content": "The descriptive longitudinal design utilized a convenience sample of 81 preterm infants from a Midwestern Level III newborn intensive care unit (NICU)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Significant differences in Preterm Infant Pain Profile (PIPP) scores were found between age groups. Both the severity of illness and the total number of prior painful procedures had a significant influence on pain scores."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Nurses' use of developmental care and the QuickHeel device may result in lower pain scores. Higher severity of illness and number of prior heelsticks may lower pain scores."
        }
      ]},
