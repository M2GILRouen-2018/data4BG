      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To define the utility of the DSM-IV-TR definition of binge eating, as it applies to anorexia nervosa (AN) and underweight eating disorder not otherwise specified (ED-NOS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "We investigated the psychopathological features associated with bulimic episodes in 105 underweight individuals with eating disorders who reported regular objective bulimic episodes with or without subjective bulimic episodes (OBE group, n = 33), regular subjective bulimic episodes only (SBE group, n = 36) and neither objective nor subjective bulimic episodes (n = 36, no-RBE group). The Eating Disorder Examination (EDE), anxiety, depression, and personality tests were administered before and upon completion of inpatient cognitive behavior therapy (CBT) treatment 6 months later."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Compared with the SBE group, OBE subjects had higher body mass index, and more frequent self-induced vomiting, while both OBE and SBE groups had more severe eating disorder psychopathology and lower self-directness than the no-RBE group. Dropout rates and outcomes in response to inpatient CBT were similar in the three groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Despite a few significant differences at baseline, the similar outcome in response to CBT indicates that categorizing patients with underweight eating disorder on the basis of the type or frequency of bulimic episodes is of limited clinical utility."
          }
        ]
      },
