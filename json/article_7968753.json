      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess coronary risk factors and management 6-12 months after coronary artery bypass grafting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Patient survey by questionnaire after discharge from hospital in 1994 and comparison with similar surveys from 1990 and 1986."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING AND PATIENTS",
          "content": "One hundred and ninety-four patients undergoing coronary artery bypass grafting at one hospital campus between 1 March 1993 and 31 August 1993. Replies to questionnaires were received from 175 patients (90%); we had clinical and biochemical data for 166-175 patients (86%-90%)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The proportion with hypercholesterolaemia (serum cholesterol levels > or = 6.5 mmol/L) declined from 60% in 1986 to 9% in 1994. Those with diastolic hypertension (> or = 95 mmHg) declined from 23% to 3%. The proportion of current smokers remained low at 6%. The proportion overweight had increased from 32% in 1986 to 47% in 1994. The proportion taking lipid-regulating drugs increased from 2% in 1986 to 37% in 1994."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Coronary risk factors after coronary artery bypass grafting appear to be better managed in 1994 than in earlier years, but there may still be a need for improvement in lipid disorders and weight."
        }
      ]},
