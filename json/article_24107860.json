      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the sensitivity of MRI of the spine compared with CT myelography (CTM) in detecting CSF leaks."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Between July 1998 and October 2010, 12 patients with orthostatic headache and a CTM-confirmed spinal CSF leak underwent an MRI of the spine with and without contrast. Using CTM as the gold standard, we retrospectively investigated the sensitivity of spinal MRI in detecting a CSF leak."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Eleven of 12 patients with a CSF leak documented by CTM also had extradural fluid collections on spinal MRI (sensitivity 91.7%). Six patients with extradural fluid collections on spinal MRI also had spinal dural enhancement."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "When compared with the gold standard of CTM, MRI of the spine appears to be a sensitive and less invasive imaging modality for detecting a spinal CSF leak, suggesting that MRI of the spine should be the imaging modality of first choice for the detection of spinal CSF leaks."
        }
      ]},
