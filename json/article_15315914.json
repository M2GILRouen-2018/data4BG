      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Pain is a significant problem in the elderly, but the impact of dementia on perceived pain has not been studied in population-based study settings."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To analyse the prevalence of daily pain and analgesic use among home-dwelling older people with and without dementia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A cross-sectional population-based survey."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Population of Kuopio city, Finland."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "523 home-dwelling subjects aged 75 years and older."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Structured clinical examination and interview."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Prevalence rates for any pain, any daily pain, pain every day interfering with routine activities, and daily pain at rest were significantly lower in those subjects with dementia (43%, 23%, 19% and 4%, respectively) compared to those subjects without dementia (69%, 40%, 36% and 13%, respectively). The subjects with dementia were less likely to use analgesics (33%) than the non-demented (47%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Dementia was related to a lower prevalence of reported pain and analgesic use among home-dwelling elderly people."
        }
      ]},
