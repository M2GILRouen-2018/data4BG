      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine the incidence and severity of post-operative pain and use of analgesics following biopsy of oral mucosal lesions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A patient survey using a self-completed pain diary."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS AND METHODS",
          "content": "Seventy-six patients attending an oral medicine clinic for investigation of oral mucosal disease recorded overall and worst pain experiences and analgesic usage over 7 post-operative days following biopsy using visual analogue scales in patient completed diaries."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "One third of patients reported no post-operative pain on any day. Most patients recorded no pain or mild pain. The percentage experiencing pain dropped from the first day (61%) to the seventh day (21%). Most patients did not use any analgesics. Analgesic use was not related to the presence of pain. Only a small minority of patients recorded severe pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Biopsy of oral mucosal lesions does not cause undue pain in most patients."
        }
      ]},
