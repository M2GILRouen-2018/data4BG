      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Cardiological Society of India. Published by Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "We assessed the association of aortic valve sclerosis (AVS) with atherosclerotic risk factors and severity and complexity of coronary artery disease (CAD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "In this retrospective study, a total of 482 eligible patients were divided into 2 groups: AVS present and AVS absent. All major cardiovascular risk factors and coronary lesion characteristics were included."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Age was the only independent predictor of AVS. AVS was not independently associated with the number of obstructive vessels, degree of lesion obstruction and SYNTAX score."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "AVS is probably a benign marker of age-related degenerative changes in the heart independent of the severity and complexity of CAD."
          }
        ]
      },
