      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Asian Oceanian Association for the Study of Obesity. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the frequencies of common polymorphisms of genes associated with energy expenditure among Hungarian obese children and investigate their influences on obesity-related traits and metabolic complications of common childhood obesity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "RESEARCH METHODS AND PROCEDURES",
            "content": "In a total of 528 obese children (age 13.2±2.6 years) an oral glucose tolerance test and determination of fasting serum lipid levels were carried out, blood pressure and resting energy expenditure were measured and the children were genotyped for the following gene polymorphisms: Trp64Arg of β3-adrenoreceptor (ADRB3), -3826 A/G of uncoupling protein (UCP)-1, exon 8 45 bp del/ins and -866 G/A of UCP-2, -55 C/T of UCP-3, and Pro12Ala of peroxisome-proliferator activated receptor gamma-2."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Carriers of the ADRB3 Arg64 allele had a significantly higher relative body weight and relative body mass index compared with non-carriers. The UCP-2 exon 8 del/ins polymorphism was associated with higher degree of obesity, insulin resistance, dyslipideamia and lower adjusted metabolic rate. Children with UCP-3 -55 T/T genotype had a significantly lower adjusted metabolic rate than the C allele carriers."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "We found evidence for associations between common polymorphisms of the ADRB3, the UCP-2 and UCP-3 genes and basic metabolic rate as well as level and metabolic consequences of common obesity among Hungarian school-aged children."
          }
        ]
      },
