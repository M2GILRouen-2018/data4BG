      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To evaluate the efficacy of IM ketorolac versus that of oral ibuprofen in acute musculoskeletal pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, prospective, double-blind clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Urban teaching emergency department with an annual census of 43,000."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Convenience sample of 82 patients aged 18 to 70 years with acute musculoskeletal pain due to trauma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Forty-two subjects each received 60 mg ketorolac by IM injection and ingested a placebo capsule. Forty subjects each ingested 800 mg ibuprofen and received a placebo (saline) IM injection. Pain was evaluated with a 100-mm visual analog scale at baseline and 15, 30, 45, 60, 75, 90, and 120 minutes after dosing. The prevalence of side effects was elicited in each patient."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Mean pain scores improved in each group during the course of the study but did not significantly differ between groups at baseline or at any subsequent interval. The numbers of dropouts due to inadequate analgesia and prevalence of side effects in the two groups did not differ significantly."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "IM ketorolac and oral ibuprofen provide comparable analgesia in ED patients with acute musculoskeletal pain."
        }
      ]},
