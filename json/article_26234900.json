      "Abstract": {
        "CopyrightInformation": "Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the efficacy of a lumbosacral spine phantom to improve novices' proficiency in performing ultrasound-guided facet joint injection and medial branch block."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND SETTING",
            "content": "Prospective study in a university hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "In total, 30 participants with no experience of spinal ultrasonography were included and were allocated to one of two groups (control group, N\u2009=\u200910 and training group, N\u2009=\u200920)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A lumbosacral spine phantom was prepared using a lumbosacral spine model embedded in a mixture of gelatin and psyllium husk. All participants were tested (test-1) following a basic education introductory program. Participants in the control group were then tested again after 1 week (test-2). Those in the training group received a further 3-h training, individually, and were tested again after 1 week (test-2)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The mean performance scores on test-1 were 57.6\u2009±\u20096.0 in the control group and 57.3\u2009±\u20096.7 in the training group; and at test-2, 61.0\u2009±\u20098.6 and 91.7\u2009±\u20094.9 (P\u2009<\u20090.001), respectively. The median time of performance at test-1 was 158.3\u2009±\u200941.9 seconds in the control group and 185.3\u2009±\u200968.1 seconds in the training group; and at test-2, 146.9\u2009±\u200938.9 seconds and 69.9\u2009±\u200922.0 seconds (P\u2009<\u20090.001), respectively. In the training group, the mean self-rating level of proficiency scores were 2.2\u2009±\u20091.0 at pretraining, and 6.8\u2009±\u20090.8 at post-training, respectively (P\u2009<\u20090.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Training using a gelatin-based spine phantom helped novices to acquire the skills necessary to perform ultrasound-guided lumbar facet joint injections and medial branch blocks."
          }
        ]
      },
