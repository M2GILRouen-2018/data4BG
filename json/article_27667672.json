      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 John Wiley & Sons, Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Passive smoking increased type 2 diabetes mellitus risk, but it is uncertain whether it also increased gestational diabetes mellitus (GDM) risk. We aimed to examine the association of passive smoking during pregnancy and its interaction with maternal obesity for GDM."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "From 2010 to 2012, 12 786 Chinese women underwent a 50-g 1-hour glucose challenge test at 24 to 28 weeks of gestation and further underwent a 75-g 2-hour oral glucose tolerance test if the glucose challenge test result was ≥7.8 mmol/L. GDM was defined by the International Association of Diabetes and Pregnancy Study Group's cut points. Self-reported passive smoking during pregnancy was collected by a questionnaire. Logistic regression was used to obtain odds ratios (ORs) and 95% confidence intervals (CIs). Additive interaction between maternal obesity and passive smoking was estimated using relative excess risk due to interaction (RERI), attributable proportion due to interaction (AP), and synergy index (S). Significant RERI > 0, AP > 0, or S > 1 indicated additive interaction."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 8331 women (65.2%) were exposed to passive smoking during pregnancy. More women exposed to passive smoking developed GDM than nonexposed women (7.8% versus 6.3%, P = 0.002) with an adjusted OR of 1.29 (95%CI, 1.11 to 1.50). Compared with nonobesity and nonpassive smoking, prepregnancy obesity and passive smoking was associated with GDM risk with an adjusted OR of 3.09 (95%CI, 2.38-4.02) with significant additive interaction (P < .05 for RERI and AP)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Passive smoking during pregnancy increased GDM risk in Chinese women independently and synergistically with prepregnancy obesity."
          }
        ]
      },
