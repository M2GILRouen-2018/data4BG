      "Abstract": {
        "CopyrightInformation": "© 2015 American Academy of Pain Medicine. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine the effectiveness and risks of fluoroscopically-guided cervical medial branch thermal radiofrequency neurotomy (CMBTRFN) for treating chronic neck pain of zygapophysial joint origin."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Systematic review of the literature with comprehensive analysis of the published data."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Four reviewers formally trained in evidence-based medicine searched the literature on CMBTRFN. Each assessed the methodologies of studies found and appraised the quality of evidence presented."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "The primary outcomes assessed were 100% relief of pain 6 and 12 months after treatment. Other outcomes were noted if reported. The evidence was evaluated in accordance with the Grades of Recommendation, Assessment, Development, and Evaluation (GRADE) system."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The searches yielded eight primary publications on the effectiveness of the procedure. The evidence shows a majority of patients were pain free at 6 months and over a third were pain free at 1 year. The number needed to treat for complete pain relief at 6 months is 2. The evidence of effectiveness is of high quality according to the GRADE system. Twelve papers were found reporting unwanted effects, most of which are minor and temporary. No serious complications have ever been reported from procedures performed according to the published guidelines. The evidence of risks is of low quality according to the GRADE system."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "If performed as described in the International Spine Intervention Society Guidelines, fluoroscopically-guided CMBTRFN is effective for abolishing zygapophysial joint pain and carries only minor risks."
          }
        ]
      },
