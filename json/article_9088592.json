      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "The plasma profile of a single dose of isosorbide mononitrate 25 mg (Elantan LA25) in healthy volunteers and in angina patients was examined."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "In volunteers and patients, blood samples for pharmacokinetics were obtained pre-dosing and at intervals for 24 h after dosing."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "This formulation exhibited rapid absorption and plasma levels were maintained at > 100 ng ml-1 for up to 9 to 12 h."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A comparison of the pharmacokinetics of Elantan LA25 in volunteers and patients indicates that the profiles are similar."
        }
      ]},
