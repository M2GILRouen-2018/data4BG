      "Abstract": {
        "CopyrightInformation": "© 2010, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose of this study was to examine nurses' use of nonpharmacological methods for school-age children's postoperative pain relief."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "A survey was conducted in 2008 with a convenience sample of 134 registered nurses from 7 pediatric wards in Singapore."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Nurses who were younger, had less education, lower designation, less working experience, and no children of their own used nonpharmacological methods less frequently."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Nurses need training and education on nonpharmacological pain relief methods, particularly on methods that have been shown to be effective in prior research but that were less often used by nurses in this study: massage, thermal regulation, imagery, and positive reinforcement."
          }
        ]
      },
