      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Self-myofascial release (SMFR) is a type of myofascial release performed by the individual themselves rather than by a clinician, typically using a tool."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To review the literature regarding studies exploring acute and chronic clinical effects of SMFR."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "PubMed and Google Scholar databases were searched during February 2015 for studies containing words related to the topic of SMFR."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Acutely, SMFR seems to increase flexibility and reduce muscle soreness but does not impede athletic performance. It may lead to improved arterial function, improved vascular endothelial function, and increased parasympathetic nervous system activity acutely, which could be useful in recovery. There is conflicting evidence whether SMFR can improve flexibility long-term."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "SMFR appears to have a range of potentially valuable effects for both athletes and the general population, including increasing flexibility and enhancing recovery."
          }
        ]
      },
