      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To describe the development, implementation, and evaluation of a tool to standardize assessment, monitoring, management, and documentation of acute and chronic pain in hospitalized patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "A multidisciplinary hospital committee, nursing staff, a pain consultant, published standards, and hospital standards."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "DATA SYNTHESIS",
          "content": "A comprehensive pain flow sheet and pain protocol was developed to assess, monitor, document, and evaluate clients at risk for or with actual pain. The tool was designed to assess and document acute and chronic pain in patients with cancer."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Based on an initial review of quality assurance indicators, the tool has demonstrated increased consistency in documentation of pain management activities."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "The use of a pain assessment and management flow sheet with a pain protocol provides an organized, consistent approach that maximizes quality, cost-effective care."
        }
      ]},
