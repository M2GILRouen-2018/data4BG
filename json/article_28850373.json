      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Scandinavian Association for the Study of Pain. Published by Elsevier B.V. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND AIM",
            "content": "Chronic pain conditions can be diagnosed and treated in both somatic and psychiatric settings. It is still a discussed and unanswered question whether the two groups of patients differ. The purpose of this short article is to inform further reflections concerning the classifications of somatoform pain and complex pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Sociodemographic and questionnaire data concerning anxiety and depression, perceived injustice, well-being, and levels of psycho-physiological functioning were compared for patients diagnosed with complex pain (somatic diagnosis) at a pain clinic and somatoform pain (psychiatric diagnosis) at a Liaison-psychiatric clinic."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Very little differences were found between patients with complex pain (N=162) and somatoform conditions (N=89). Both patient groups were seriously impaired both physically and mentally."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These comparisons lend support to the viewpoint of non-segregation of somatoform and complex pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS",
            "content": "Pain treatment might be better-managed in common multidisciplinary centers with specialists in both pain treatment and psychiatric aid."
          }
        ]
      },
