      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND OBJECTIVES",
          "content": "Myofascial trigger points are often not considered in the differential diagnosis of headaches."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A patient who presented with severe bifrontal headaches was treated by injections of the sternocleidomastoid muscle trigger points with local anesthetics."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The patient experienced complete resolution of all symptoms, which had not reappeared after 14 months."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Myofascial pain may mimic other disorders, and myofascial headaches can be easily treated once properly diagnosed."
        }
      ]},
