      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the effects of low-dose butorphanol on hyperalgesia induced by high-dose remifetanil in patients undergoing laparoscopic cholecystectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized double-blind clinical trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Intraoperative."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Seventy-five patients scheduled for laparoscopic cholecystectomy were enrolled."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Randomly allocated into 3 groups, low dose of remifentanil (LR) group and high dose of remifentanil (HR) group received low (0.1μg kg(-1) min(-1)) or high (0.3μg kg(-1) min(-1)) doses of remifentanil, respectively, and butorphanol combined with remifentanil (BR) group received remifentanil (0.3μg kg(-1) min(-1)) and butorphanol (0.2μg/kg)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "The visual analog scale scores and cumulative consumption of fentanyl were recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Visual analog scale scores were significantly higher in the HR group than in the LR and BR groups (P<.001). The dose of intravenously given fentanyl was significantly higher in the HR group than in the LR and BR groups (P<.001). In addition, the HR group showed a significantly higher cumulative consumption of fentanyl during 5 to 8 hours after the operation (P<.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A high dose of remifentanil induces postoperative hyperalgesia, which could be prevented by a continuous intravenous administration of a low dose of butorphanol."
          }
        ]
      },
