      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe the influence of antidepressive therapy on short-term prognosis in elderly unstable angina pectoris patients with depression."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "76 unstable angina pectoris patients were random into a therapy group (38) and control group (38). Patients in the therapy group were treated with psychotherapy and administration of antidepressant Fluoxetine (Prozac Eli Lilly, USA) 20mg once a day on the basis of regular cardiac medicine therapy for 12 weeks, Patients in the control group were only treated with regular cardiac medicine therapy."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Myocardial ischaemia in the therapy group was significantly improved. The recurrence rate of angina pectoris and incidence ratio of acute myocardial infarction in the therapy group were low. There was significant difference in comparison with the control group (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Antidepression can significantly improve the short-term prognosis in elderly unstable angina pectoris patients."
        }
      ]},
