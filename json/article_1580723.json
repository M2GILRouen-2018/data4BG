      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Patients with concurrent medical conditions such as Reactive airway disease presenting for anaesthesia, and surgery have potentially increased risk of perioperative morbidity and mortality if not well managed."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To highlight the need for adequate perioperative care and review the evidence for selection of techniques in the anesthesia for such cases\""
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "An illustrative case is presented."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The main goal of the anaesthetist is to administer safe and sufficient anaestheia without precipitating bronchospasm."
        }
      ]},
