      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To determine whether adding ephedrine to propofol is as effective as adding lidocaine at reducing injection pain, and its effects on hemodynamics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized, double-blinded, controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "District general hospital in the United Kingdom."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "156 adult, ASA physical status I, II, and III patients undergoing elective or emergency general anesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients were randomized to one of three groups to receive one mL of 1% lidocaine per 20 mL of 1% propofol (Group L), 15 mg of ephedrine per 20 mL of propofol (Group E15), or 30 mg of ephedrine per 20 mL of propofol (Group E30)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Pain on injection, heart rate, and blood pressure at one-minute intervals for ten minutes were recorded. There was no significant difference in injection pain among groups. Group E30 had the least amount of hemodynamic change."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Adding 30 mg of ephedrine to 20 mL of 1% propofol is as effective as adding lidocaine in preventing injection pain, and it results in a more stable hemodynamic profile."
        }
      ]},
