      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "The aim of the present study was to assess the effectiveness of belly dance as a treatment option for patients with fibromyalgia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Eighty female patients with fibromyalgia between 18 to 65 years were randomly allocated to a dance group (n=40) and control group (n=40). Patients in the dance group underwent 16 weeks of belly dance twice a week, while the patients in the control group remained on a waiting list. The patients were evaluated with regard to pain (VAS), function (6MWT), quality of life (FIQ and SF-36), depression (Beck Inventory), anxiety (STAI) and self-image (BDDE). Evaluations were carried out at baseline, 16 weeks and 32 weeks by a blinded assessor."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The dance group achieved significant improvements in VAS for pain (p<0.001), six-minute walk test (p<0.001), FIQ (p=0.003), BDDE (p<0.009) as well as the pain (p<0.001), emotional aspects (p<0.003) and mental health (p<0.021) subscales on the SF-36."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Belly dance can be used in the treatment of fibromyalgia to reduce pain and improve functional capacity, quality of life and self-image."
        }
      ]},
