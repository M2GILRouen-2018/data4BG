      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess and describe life satisfaction in individuals with spinal cord injury (SCI) with regard to pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A cross-sectional descriptive study of self-reported life satisfaction in individuals with SCI, with and without pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Spinal outpatient clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Two hundred and thirty patients with SCI were mailed a questionnaire."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Mailed survey."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN MEASURES",
          "content": "Ratings of pain intensity, pain unpleasantness, mood, and life satisfaction (LiSat-9)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In total 191 (83%) of the questionnaires were returned and analysed. Patients with pain experienced lower life satisfaction compared with individuals who were pain free. Continuous pain interfered to a greater extent than did intermittent pain. In logistic regression analysis the univariate relationship between pain and low life satisfaction was removed. Predictive for lower scores of life satisfaction were higher ratings of mood disorders."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Life satisfaction is negatively affected in patients with SCI and pain compared to patients with SCI but without pain. Higher levels of anxiety and depression seem to be predictive for this decreased life satisfaction."
        }
      ]},
