      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American College of Allergy, Asthma & Immunology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Anaphylaxis is a serious allergic or hypersensitivity reaction, which is rapid in onset and sometimes can prove fatal. Although H2-antihistamines are often administered for emergency treatment in anaphylaxis, there is uncertainty about their effectiveness in this disease."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the benefits and harms of H2-antihistamines in the treatment of anaphylaxis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A systematic review was performed of randomized controlled trials and quasi-randomized controlled trials comparing H2-antihistamines with placebo or no intervention in patients with anaphylaxis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The authors failed to identify any eligible studies for inclusion in this systematic review."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "When H2-antihistamines are recommended for anaphylaxis treatment, the status of the evidence base supporting their use should be described. Well-designed randomized controlled trials investigating the role of H2-antihistamines in anaphylaxis treatment are urgently needed."
          }
        ]
      },
