      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the intra-operative experience and postoperative sequelae between the standard Marie Stopes scalpel vasectomy procedure and electrocautery non-scalpel vasectomy (ENSV) techniques."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomised prospective comparative study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Marie Stopes vasectomy centres in the UK."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "A total of 325 men undergoing vasectomy between January and June 1999."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Random allocation to the two study arms plus questionnaires at 4 and 14 weeks postoperatively."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Ease and speed of the procedure; pain levels during and after the procedure; early postoperative complications and time taken to return to work and sexual activity."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The ENSV technique was marginally quicker to perform. Pain levels intra-operatively were comparable. Response rates to the questionnaire were 84.6% and 37% at 4 and 14 weeks, respectively. The ENSV group experienced less pain and bleeding from the wound postoperatively and were quicker to heal. For men who experienced postoperative problems, the time taken to return to work was marginally better in the ENSV group. The time taken to return to sexual activity was marginally faster in the ENSV group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The ENSV procedure appears to be suitable for mass application in locations where electricity is available."
        }
      ]},
