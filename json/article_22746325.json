      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To evaluate the prevalence of abnormal spiral arteries modification (ASAM) in stillbirths and its anatomo-clinical correlations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Two-hundred and three placentas of stillbirth ≥20 weeks of gestation were analyzed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "ASAM was present in 69/203 cases (33.9%). The only maternal characteristic that significantly differed in ASAM versus normal spiral arteries modification (NSAM) cases was the prepregnancy body mass index (BMI) (25.9\u2009±\u20096.1 and 23.1\u2009±\u20094.2\u2009kg/m(2), respectively) with 15.9% of obesity in ASAM mothers versus 5.2% in NSAM (p = 0.02)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Given the association between obesity and adverse pregnancy outcome, our data suggest that counselling obese women to lose weight before pregnancy becomes increasingly imperative."
        }
      ]},
