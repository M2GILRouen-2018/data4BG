        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To report a conservative treatment of a rare developmental anomaly."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "A 73-year-old patient with previously initiated therapy and acute apical abscess of a maxillary right central incisor fused with the supernumerary tooth sought treatment. The conservative approach included nonsurgical root canal treatment and composite restoration."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This case illustrates the importance of an individual approach when treating anomalous teeth. Priorities in pain and infection management to properly and functionally restore teeth should be unaffected by age."
          }
        ]
      },
