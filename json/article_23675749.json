      "Abstract": {
        "CopyrightInformation": "© 2013 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Post-cardiotomy cardiogenic shock is an infrequent devastating complication with few options for support."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "We present a case highlighting use of the Impella 5.0 (ABIOMED; Danvers, MA) for postcardiotomy cardiogenic shock after coronary artery bypass and bioprosthetic aortic valve replacement."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Support was maintained for 7 days before being successfully weaned with myocardial recovery and no damage to the bioprosthetic aortic valve."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This is the first published report of successful use of an Impella 5.0 (ABIOMED; Danvers, MA) for post-cardiotomy cardiogenic shock through a new implanted bioprosthetic aortic valve."
          }
        ]
      },
