      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The goal of this study was to evaluate the immediate and long-term outcomes after the combined Frey and Beger procedure for chronic pancreatitis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "From March 2008 to July 2011, 50 consecutive patients with chronic pancreatitis, confirmed by pathology, underwent the combined Frey and Beger procedure in the gastrointestinal surgery unit of Viet Duc hospital (Hanoi, Vietnam)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The mean duration of operation was 280 ± 48.3min. The mean duration of postoperative hospital stay was 8.4 ± 1.8 days. Morbidity was 6%, and there was no postoperative mortality. After a mean follow-up of 24.8 months, pain subsided in 97.8% of patients, regain of weight was observed in 68.1% of patients (mean 3.7 kg), and 78.2% of patients were able to go back to normal activities. Endocrine and exocrine function was preserved in 83.0% and 91.5% of patients, respectively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The combined Frey and Beger procedure provides good antalgic control while preserving pancreatic function, with acceptable morbidity and mortality."
          }
        ]
      },
