      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Sociedade Portuguesa de Cardiologia. Published by Elsevier España. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Pediatric obesity is increasingly prevalent in the Portuguese population. Adipocyte dysfunction results in the expression of pro-inflammatory mediators that are responsible for the low-grade inflammatory process that characterizes obesity."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aim of this study was to investigate the relationship between markers of adiposity, inflammation and adipokines in a Portuguese obese pediatric population."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "One hundred and twenty children of both sexes, aged 6-17 years, were included in this study. The control group consisted of 41 healthy normal-weight children. The variables analyzed were age, gender, body mass index, waist circumference, fat mass percentage, high-sensitivity C-reactive protein (hs-CRP), leptin and adiponectin."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There were significant differences between controls and obese children for all parameters analyzed. In the obese group, after controlling for age and gender, hs-CRP (p=0.041), adiponectin (p=0.019) and leptin (p<0.001) still showed significant statistical differences. A direct correlation was found between hs-CRP, leptin, body mass index and waist circumference, the strongest being with leptin (r=0.568; p<0.001). This trend remained statistically significant, regardless of gender or pubertal age."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Considering the role of leptin, adiponectin and hs-CRP in the genesis of endothelial dysfunction, they may be used in clinical practice for risk stratification, as well as in the assessment of weight control programs."
          }
        ]
      },
