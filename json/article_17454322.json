      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To identify patient, home residence, and neighborhood characteristics of children with asthma-related emergency department visits."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Medical records of children with one (group A) or more than one (group B) asthma-related pediatric emergency department visit were reviewed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A significantly higher percentage of group B had Medicaid insurance (p = 0.04), history of asthma-related hospitalizations (p = 0.04), and passive tobacco smoke exposure (p = 0.03). Neighborhood characteristics were similar between the two groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Smoking cessation counseling and close monitoring of patients with a history of asthma-related hospitalizations and patients with Medicaid insurance may be helpful in decreasing emergency department visits."
        }
      ]},
