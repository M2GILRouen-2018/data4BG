      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe the therapeutic effects in acupunture treatment of primary dysmenorrhea combined with spinal Tui Na, and study its mechanism."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Thirty cases of the treatment group were treated by acupuncture combined with spinal Tui Na, and thirty cases in the control group were treated by routine acupuncture."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The total effective rate was 93.3% in the treatment group, and 73.3% in the control group, with a significant difference between the two groups (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Acupuncture combined with spinal Tui Na has good prospects for treatment of primary dysmenorrhea."
        }
      ]},
