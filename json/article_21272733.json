      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "Label": "UNLABELLED",
          "content": "A randomized controlled trial comparing manipulation with mobilization for recent onset neck pain."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine whether neck manipulation is more effective for neck pain than mobilization."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized controlled trial with blind assessment of outcome."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Primary care physiotherapy, chiropractic, and osteopathy clinics in Sydney, Australia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Patients (N=182) with nonspecific neck pain less than 3 months in duration and deemed suitable for treatment with manipulation by the treating practitioner."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Participants were randomly assigned to receive treatment with neck manipulation (n=91) or mobilization (n=91). Patients in both groups received 4 treatments over 2 weeks."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "The number of days taken to recover from the episode of neck pain."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The median number of days to recovery of pain was 47 in the manipulation group and 43 in the mobilization group. Participants treated with neck manipulation did not experience more rapid recovery than those treated with neck mobilization (hazard ratio=.98; 95% confidence interval, .66-1.46)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Neck manipulation is not appreciably more effective than mobilization. The use of neck manipulation therefore cannot be justified on the basis of superior effectiveness."
        }
      ]},
