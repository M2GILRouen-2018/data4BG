      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The use of cyclooxygenase-2 inhibitors, a new class of analgesic drugs, is suggested in patients with hypersensitivity to nonsteroidal anti-inflammatory drugs (NSAIDs)."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate tolerance to etoricoxib, a new cyclooxygenase-2 inhibitor, in NSAID-sensitive patients with urticaria-type adverse reactions."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Thirty-seven patients with adverse reactions to NSAIDs."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Single-blind, placebo-controlled oral challenge with increasing doses of etoricoxib."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Thirty-four patients tolerated etoricoxib treatment without adverse reactions, but a generalized urticarial rash developed in 3 patients (8%)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Etoricoxib, like other cyclooxygenase-2 inhibitors, is a well-tolerated drug in most NSAID-sensitive patients. However, according to our experience, a previous challenge test in a safe environment may be necessary before prescribing the drug to such patients."
        }
      ]},
