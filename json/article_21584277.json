      "Abstract": {
        "CopyrightInformation": "Published by the BMJ Publishing Group Limited. For permission to use (where not already granted under a licence) please go to http://www.bmj.com/company/products-services/rights-and-licensing/",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate the efficacy and safety of intra-articular (IA) bupivacaine administered for pain relief after joint arthroplasty."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Meta-analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A systematic review was conducted to identify the randomised controlled trials using IA bupivacaine for postoperative pain relief from MEDLINE, Cochrane Library and EMBASE databases (up to October 2015). The standardised mean difference (SMD), the relative risk (RR) and their corresponding 95% CIs were calculated using the RevMan statistical software."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 11 randomised controlled trials were included. Statistically significant differences between IA bupivacaine and placebo were observed for the mean visual analogue scale (VAS) values (SMD -0.55; 95% CI -0.89 to -0.22; p<0.001) and narcotic consumption (SMD -0.32; 95% CI -0.55 to -0.08; p=0.008) during the period of 24\u2005hours postoperatively and narcotic consumption during the period between 24 and 48\u2005hours postoperatively (SMD -0.32; 95% CI -0.55 to -0.08; p=0.009). However, there was no significant difference in the mean VAS pain score during the period between 24\u2005 and 48\u2005hours postoperatively (SMD -0.09, 95% CI -0.30 to 0.11; p=0.37) and in the incidence of adverse effects 24-72\u2005hours postoperatively (RR 0.97; 95% CI 0.60 to 1.57; p=0.91)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The administration of IA bupivacaine after joint arthroplasty is effective for pain relief without increasing adverse effects."
          }
        ]
      },
