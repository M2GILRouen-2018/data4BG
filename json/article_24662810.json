      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the efficacy of extracorporeal shockwave therapy (ESWT) and provide clinicians with an evidence base for their clinical decision making."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "PubMed, MEDLINE, Embase, Cochrane Central Register of Controlled Trials, and Evidence-Based Medicine Reviews."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY SELECTION",
            "content": "All randomized or quasi-randomized controlled trials of ESWT for chronic recalcitrant plantar fasciitis were searched. Searching identified 108 potentially relevant articles; of these, 7 studies with 550 participants met inclusion criteria."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA EXTRACTION",
            "content": "Number of patients, population, body mass index, duration of symptoms, adverse effects, blinding method, and details of shockwave therapy were extracted."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "DATA SYNTHESIS",
            "content": "For intervention success rate, ESWT of low intensity was more effective than control treatment of low intensity. For pain relief, the pooled data showed a significant difference between the ESWT and control groups. For function, only low-intensity ESWT was significantly superior over the control treatment."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The efficacy of low-intensity ESWT is worthy of recognition. The short-term pain relief and functional outcomes of this treatment are satisfactory. However, owing to the lack of a long-term follow-up, its long-term efficacy remains unknown."
          }
        ]
      },
