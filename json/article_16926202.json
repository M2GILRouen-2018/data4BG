      "Abstract": {
        "CopyrightInformation": "© 2015, Copyright the Authors Journal compilation © 2015, The American Geriatrics Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To examine the prevalence of mobility device use in community-dwelling older adults in the United States and to investigate the incidence of falls and worry about falling according to type and number of mobility devices used."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Analysis of cross-sectional and longitudinal data from the 2011-12 National Health and Aging Trends Study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "In-person interviews in the homes of study participants."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Nationally representative sample of Medicare beneficiaries (n=7,609)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Participants were asked about mobility device use (e.g., canes, walkers, wheelchairs and scooters) in the last month, 1-year fall history and worry about falling."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Twenty-four percent of adults aged 65 and older reported mobility device use in 2011, and 9.3% reported using multiple devices within the last month. Mobility device use increased with advancing age and was associated with nonwhite race and ethnicity, female sex, lower education level, greater multimorbidity, and obesity (all P<.001). Adjusting for demographic and health characteristics and physical function, the incidence of falls and recurrent falls was not associated with the use of multiple devices or any particular type of mobility device. Activity-limiting worry about falling was significantly higher in cane-only users than in nonusers."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The percentage of older adults reporting mobility device use is higher than results from previous national surveys, and multiple device use is common in those who use any device. Mobility device use is not associated with greater incidence of falls. Cane-only users may compensate for worry about falling by limiting activity."
          }
        ]
      },
