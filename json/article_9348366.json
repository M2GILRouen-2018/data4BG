      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To present the technique and usefulness of conscious pain mapping."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, observational study (Canadian Task Force classification II-2)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Gynecology departments of a university-affiliated hospital and a private community hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Fifty consecutive women undergoing diagnostic microlaparoscopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Conscious pain mapping was performed in all 50 women."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Conscious pain mapping helped to identify foci of chronic pelvic pain. The appendix and pelvic adhesions accounted for a significant amount of pelvic pain in these women."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Conscious pain mapping helps to uncover sites of pelvic pain that might not be identified during traditional laparoscopy under general anesthesia."
        }
      ]},
