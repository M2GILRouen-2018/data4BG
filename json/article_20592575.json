      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report a serious complication of the StaXx FX system used to stabilize an osteoporotic vertebral fracture."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE REPORT",
          "content": "A 76-year-old woman presented with a painful vertebral fracture. Treatment by means of a PEEK wafer kyphoplasty was complicated by malposition of the wafers. The patient recovered fully after removal of the wafers by means of a thoracotomy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "New treatment modalities have their own pitfalls and possible complications, as demonstrated in this case report. Caution regarding implementation of new treatment modalities should be practiced."
        }
      ]},
