      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "BACKGROUND AND OBJECTIVES",
          "content": "A 36-year-old woman was scheduled for surgery of bicornuate uterus under epidural anesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "As a test dose, 3 mL 2.5% thiamylal was injected unintentionally through the epidural catheter instead of 1.5% lidocaine with 15 micrograms epinephrine."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Immediately the patient complained of burning pain in the low back area. Administrations of 10 mL 2% lidocaine without epinephrine and 10 mL normal saline containing hydrocortisone 100 mg were performed through the epidural catheter."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The patient recovered without permanent neurologic sequelae."
        }
      ]},
