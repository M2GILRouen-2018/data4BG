      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "The aims of this study were to determine the prevalence of anxiety related to dental care and analyse associated factors in children and adolescents in a low-income community in Recife, Brazil."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A cross-sectional study was conducted with 101 children and adolescents from both genders, aged from 6 to 16 years."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The dependent variable, anxiety related to dental care, was obtained by the dental anxiety questionnaire (DAQ). The independent variables were: the previous experience, the pain history and DMFT-dmft."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STATISTICS",
          "content": "Chi square test was performed to analyse the associations. In the multivariate analysis, binary logistic regression was performed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The probability of females in the sample experiencing anxiety was 3.1 times higher compared to males (OR 3.1 [1.3-7.2]). Children and adolescents who had never visited a dentist showed a level of anxiety 5.6 times higher than those who did (OR 5.6 [1.3-22.7])."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Anxiety related to the dental care presented a prevalence of 36.6 % in a population aged 6-16 years. Females in this group, as well as subjects who had never been to the dentist were more likely to present anxiety."
        }
      ]},
