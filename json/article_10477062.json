      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Accelerated gastric emptying (GE) may lead to reduced satiation, increased food intake and is associated with obesity and type 2 diabetes. Domperidone is a dopamine 2 (D(2)) receptor antagonist with claims of gastrointestinal tract pro-kinetic activity. In humans, domperidone is used as an anti-emetic and treatment for gastrointestinal bloating and discomfort."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To determine the effect of acute domperidone administration on GE rate and appetite sensations in healthy adults."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A single-blind block randomised placebo-controlled crossover study assessed 13 healthy adults. Subjects ingested 10 mg domperidone or placebo 30 min before a high-fat (HF) test meal. GE rate was determined using the (13)CO(2) octanoic acid breath test. Breath samples and subjective appetite ratings were collected in the fasted and during the 360 min postprandial period."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Gastric emptying half-time was similar following placebo (254 ± 54 min) and 10 mg domperidone (236 ± 65 min). Domperidone did not change appetite sensations during the 360 min postprandial period (P > 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In healthy adults, acute administration of 10 mg domperidone did not change GE or appetite sensations following a HF test meal."
        }
      ]},
