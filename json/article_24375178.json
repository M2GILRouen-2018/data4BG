      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "A diet rich in fruits and vegetables is associated with reduced risk of diet-related chronic diseases. However, fewer than half of children in the United States consume the recommended amount."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "This article describes the community-based participatory research (CBPR) process used to develop the Harvest for Healthy Kids curriculum."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Harvest for Healthy Kids is a intervention research project designed to increase access to and intake of fruits and vegetables among preschoolers enrolled in Head Start. The curriculum is composed of eight kits, each focusing on a different fruit or vegetable."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The Harvest for Healthy Kids curriculum was developed through an iterative process in which Head Start teachers were highly involved. The final product reflects the teachers' experiences using the curriculum and their suggestions for improving."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The CBPR process used to develop the Harvest for Healthy Kids curriculum led to a product that is grounded in theory and practice."
        }
      ]},
