      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine whether the Feldenkrais method is an effective intervention for chronic neck/scapular pain in patients with visual impairment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Randomized controlled trial with an untreated control group."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Low vision center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Patients (N=61) with visual impairment (mean, 53.3 y) and nonspecific chronic (mean, 23.8 y) neck/scapular pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Participants were randomly assigned to the Feldenkrais method group (n=30) or untreated control group (n=31). Patients in the treatment group underwent one 2-hour Feldenkrais method session per week for 12 consecutive weeks."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Blind assessment of perceived pain (visual analog scale [VAS]) during physical therapist palpation of the left and right occipital, upper trapezius, and levator scapulae muscle areas; self-assessed degree of pain on the Visual, Musculoskeletal, and Balance Complaints questionnaire; and the Medical Outcomes Study 36-Item Short-Form Health Survey bodily pain scale."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Patients undergoing Feldenkrais method reported significantly less pain than the controls according to the VAS and Visual, Musculoskeletal, and Balance Complaints questionnaire ratings at posttreatment follow-up and 1-year follow-up. There were no significant differences regarding the Medical Outcomes Study 36-Item Short-Form Health Survey bodily pain scale ratings."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Feldenkrais method is an effective intervention for chronic neck/scapular pain in patients with visual impairment."
          }
        ]
      },
