      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To present an uncommon cause of chest pain in an athlete."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE SUMMARY",
          "content": "A 17-year-old black man suffered recurrent episodes of chest pain due to pericarditis. Based on presentation and serology, he was diagnosed as having unspecified connective tissue disease."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Rheumatologic disease will often manifest over a period of time. Diagnosis and treatment is often elusive."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RELEVANCE",
          "content": "Rheumatologic disorders should be included in the differential diagnosis of chest pain in athletes."
        }
      ]},
