      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Hanley & Belfus. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Patient interpretation of advice from hand therapists may be related to nonadaptive pain thoughts (automatic, overprotective, unduly pessimistic statements triggered by nociception and exacerbated by psychological distress)."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE OF THE STUDY",
            "content": "This study aimed to determine whether there were correlations between participants' hand therapy goals, interpretation of advice from hand therapists, nonadaptive pain thoughts, and upper extremity-specific disability."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "One hundred and five participants completed questionnaires assessing nonadaptive pain thoughts, upper extremity-specific disability, lessons from hand therapists, and hand therapy goals."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Nonadaptive pain thoughts correlated with disability and were bi-directionally related to participant goals and interpretation of advice from hand therapists."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Patients' nonadapative pain thoughts and the words/concepts used by hand therapists are both important in recovery from upper extremity illness."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Hand therapists should be mindful that nonadaptive pain thoughts are an important determinant of disability and that such thoughts can affect and be affected by their recommendations."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "n/a."
          }
        ]
      },
