      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Chronic complex regional pain syndrome (CRPS) is a chronic pain condition that leads to sympathetic nervous system involvement and trophic changes."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study describes the use of acupuncture in a case study of CRPS."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN, SETTING, AND PATIENT",
          "content": "This is a single case report of a 34-year-old patient diagnosed with CRPS."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Acupuncture treatment including acupoints along the Gallbladder, Liver, Spleen, Heart, and Kidney meridians. Self-treatment plan included a laser acupuncture pen device and disposable press needles."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Beck Depression Inventory (BDI), McGill Pain Questionnaire, and Sheehan Disability Scale (SDS)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The Patient reported a decrease in pain levels, depression, and an improved quality of life. Pretreatment SDS score of 17, a 12 on the BDI, and a 67 on the McGill Pain Questionnaire. Post-treatment SDS decreased to 4, her BDI went to 0, and her McGill Pain Questionnaire decreased to a 10."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "More research is needed and case studies performed to support our findings."
        }
      ]},
