      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report a case of rofecoxib (Vioxx)-associated Stevens-Johnson syndrome with corneal and conjunctival changes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Interventional case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Case report of a 62-year-old woman with systemic lupus erythematosus (SLE) taking rofecoxib for arthritis for 3 weeks."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Stevens-Johnson syndrome after 3 weeks of rofecoxib therapy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This case report suggests that oral rofecoxib may trigger Stevens-Johnson syndrome, potentially causing symblepharons, corneal neovascularization and cicatricial ectropions."
        }
      ]},
