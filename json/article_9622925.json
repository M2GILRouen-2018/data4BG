      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe a case of acute abdomen arising from an underlying urological condition."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "METHODS/RESULTS",
          "content": "Herein we describe a patient with acute abdomen arising from a pyonephrotic kidney with fistulization to the peritoneal cavity. The clinical manifestations disappeared following nephrectomy by the anterior approach and drainage of the intraperitoneal cavity."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Although infrequent, it should be taken into account that peritoneal abscess and/or pyonephrosis can cause acute abdomen when they fistulize to the peritoneal cavity."
        }
      ]},
