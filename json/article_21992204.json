      "Abstract": {
        "CopyrightInformation": "© 2011 International Neuromodulation Society.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Autologous iliac crest bone graft (ICBG) harvest is a common procedure performed at the time of many spinal surgical procedures and associated with morbidity incurred at the harvest site, the most troublesome being chronic donor site pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The patient underwent an uneventful peripheral nerve field stimulation (PNFS) trial with percutaneous placement of two temporary eight-electrode leads (Medtronic Inc., Minneapolis, MN, USA) placed in epifascial plane over the left ICBG harvest site."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After experiencing excellent pain relief over the next two days, the patient was implanted with permanent leads and generator two weeks later and reported sustained pain relief at 12-month follow-up visit."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "Peripheral nerve field stimulation provides an effective treatment option for patients suffering from chronic hip pain after ICBG harvest who have failed conservative treatment. PNFS may provide pain relief with advantages over conservative treatments and more invasive techniques."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Peripheral nerve field stimulation offers an alternative treatment option for select patients with chronic hip pain after ICBG harvest."
          }
        ]
      },
