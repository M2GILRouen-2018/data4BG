      "Abstract": {
        "CopyrightInformation": "© Georg Thieme Verlag KG Stuttgart · New York.",
        "AbstractText": [
          {
            "NlmCategory": "METHODS",
            "Label": "HISTORY AND ADMISSION FINDINGS",
            "content": "A 28-year-old man without a significant past medical history presented to our emergency department with severe chest pain and dyspnoa. Vital signs and the rest of the physical examination were unremarkable."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INVESTIGATIONS",
            "content": "The electrocardiogram showed T-wave inversions and the cardiac enzymes were elevated."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "TREATMENT AND COURSE",
            "content": "Angiocardiography showed an aneurysm of the right coronary artery and a thrombus formation in its distal part. Intracoronary thrombolytic therapy was attempted an oral anticoagulation was started. Further investigations did not find the cause of the aneurysmatic RCA. The patient had no further episode of chest pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Acute coronary syndrome is a rare finding in patients under the age of 30 years. Coronary aneurysms with associated thrombus can be the cause of it."
          }
        ]
      },
