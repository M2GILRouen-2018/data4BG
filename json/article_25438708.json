      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 North American Society for Pediatric and Adolescent Gynecology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Approximately 7% of girls will have an anatomic abnormality in their reproductive tract, diagnosed before or after puberty."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "It is important for providers to be aware of the obstructive reproductive tract conditions, the way in which various conditions present, and the way in which such conditions should be managed."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Systematic review of the literature using the GRADE evidence system."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There is limited data in most areas of obstructive reproductive tract anomalies; however, some retrospective and prospective series with small numbers are still useful to guide clinical practice."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Recommendations are based on limited or inconsistent scientific evidence. Recommendations are based primarily on consensus and expert opinion."
          }
        ]
      },
