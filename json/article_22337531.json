      },
      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© 2011 European Federation of International Association for the Study of Pain Chapters.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate the efficacy of transcutaneous electrical neurostimulation (TENS) in patients with chronic low back pain (LBP)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, randomized, multicentre, single-blind study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Twenty-one French pain centres."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Two hundred thirty-six consecutive adult patients consulting for chronic LBP, with or without radicular pain (mean age\u2009±\u2009standard deviation: 53\u2009±\u200913 years; range: 28-86 years)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Patients were randomly assigned to receive either active (n\u2009=\u2009117) or sham (n\u2009=\u2009119) TENS in four 1-h daily treatment sessions for 3 months."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "The primary outcome measured was improvement of functional status at 6 weeks (Roland-Morris Disability Questionnaire). Secondary outcome measures were improvement of functional status at 3 months, pain relief (weekly visual analogue scale assessments), positive functional repercussions of pain levels on quality of life, a diminution of the use of analgesic and anti-inflammatory medication, satisfaction with the overall treatment strategy and compliance."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Functional status did not differ between the groups, whether at 6 weeks or 3 months (p\u2009=\u20090.351 at 6 weeks). A significant improvement between the first and last visual analogue scale assessments was observed in patients with either lumbar pain alone or lumbar and radicular pain treated with active TENS. Other outcome measures did not differ significantly between the two groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "There was no functional benefit of TENS in the treatment of patients with chronic LBP."
          }
        ]
      },
