      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2014.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Primary care is an ideal setting to treat pediatric obesity. Effective, low-intensity (≤25 contact hours over 6 months) interventions that reduce standardized body mass index (z-BMI) and can be delivered by primary care providers are needed."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "This pilot randomized controlled trial investigated the effect of 3 low-intensity (≤25 contact hours over 6 months) pediatric obesity treatments on z-BMI."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Twenty-two families (children 8.0 ± 1.8 years, z-BMI of 2.34 ± 0.48) were randomized into 1 of 3, 6-month, low-intensity conditions: newsletter (N), newsletter and growth monitoring (N + GM), or newsletter and growth monitoring plus family-based behavioral counseling (N + GM + BC). Anthropometrics and child eating and leisure-time behaviors were measured."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Mixed-factor analyses of variance found a significant (P < .05) main effect of time for z-BMI and servings per day of sugar sweetened beverages, with both decreasing over time."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Low-intensity obesity treatments can reduce z-BMI and may be more feasible in primary care."
          }
        ]
      },
