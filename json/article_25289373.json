      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Acute mesenteric ischemia is a life-threatening vascular emergency that requires early diagnosis, immediate anticoagulation, and intervention to restore mesenteric blood flow adequately."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "To investigate the effect of rectus sheath block (RSB) for postoperative analgesia in patients with mesenteric vascular occlusion."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTINGS AND DESIGN",
          "content": "Forty patients with mesenteric vascular occlusion, American Society of Anesthesiologists physical status I or II or III, scheduled for laparotomy were enrolled in this study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS AND METHODS",
          "content": "Patients were randomized into two groups; control group (C Group) and rectus block group (RB Group). In both groups, general anesthesia was induced fentanyl 1 μg/kg with sleeping dose of propofol and 0.15 mg/kg cisatracurium. Then, anesthesia was maintained with sevoflurane in oxygen 100%. In RB Group, under aseptic condition, RSB guided by ultrasound was performed. Surgery is then continued and intravenous fentanyl patient-controlled analgesia pump started. Postoperative pain, sedation, and opioid side effects were assessed."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STATISTICAL ANALYSIS USED",
          "content": "Statistical analysis was done using Statistical Package for Social Sciences (SPSS 19.0, Chicago, IL, USA)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients in the RB Group consumed statistically significant less opioid in comparison to control group either intraoperatively or postoperatively. Mean pain scores were statistically significant less in RB Group than in the control group at 2, 4, and 6 h postoperatively. Sedation score, incidence of nausea and vomiting were statistically significant less in the RB Group in comparison to control group. More patients' satisfaction was reported in the RB Group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Ultrasound-guided RSB resulted in postoperative reduction of pain scores and opioid consumption compared with general anesthesia alone. Moreover, RSB was associated with better patient satisfaction and less nausea and vomiting."
        }
      ]},
