      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the effect of carrier frequency of interferential current (IFC) on pressure pain threshold (PPT) and sensory comfort in healthy subjects."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A double-blind randomized trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University research laboratory."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Healthy subjects (N=150)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Application of the IFC for 20 minutes and measures of PPT collected in the regions of the nondominant hand and forearm."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOMES MEASURES",
            "content": "We measured PPT and comfort at frequencies of 1kHz, 2kHz, 4kHz, 8kHz, and 10kHz."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was a significant increase in PPT in the 1-kHz group when compared with the 8-kHz and 10-kHz groups. There was a greater discomfort in the 1-kHz and 2-kHz groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "IFC with a carrier frequency of 1kHz promotes a higher hypoalgesic response during and after stimulation than IFC with carrier frequencies of 8kHz and 10kHz. Carrier frequencies of 1kHz and 2kHz are perceived as more uncomfortable than carrier frequencies of 4kHz, 8kHz, and 10kHz."
          }
        ]
      },
