      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Effect of formoterol, long-acting beta(2 )agonists, on T cell cytokine synthesis was examined."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Human peripheral blood mononuclear cells were obtained from atopic asthmatics, and stimulated with Dermatophagoidesfarinae extract. Various concentrations of formoterol were added from the start of some cultures. Cytokine production and cell proliferation were analyzed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Allergen-induced IL-5, IL-13, and IFN-gamma production of PBMC were significantly suppressed by formoterol in a dose-dependent manner, whereas the proliferation response was not suppressed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Formoterol downregulates T cell functions of atopic asthmatics in vitro."
        }
      ]},
