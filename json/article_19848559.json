      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Chronic low back pain is often accompanied by fear-avoidance cognitions, increased depressive symptoms and decreased quality of life."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Is the relationship between fear-avoidance cognitions and quality of life mediated by depressive symptoms?"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Mediation analyses were conducted to predict the long-term quality of life with depressive symptoms as mediator using longitudinal data from 131 patients."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Fear-avoidance cognitions prior to rehabilitation predicted the physical quality of life 24 months after rehabilitation, which was mediated by the degree of depressive symptoms 6 months after rehabilitation. The other assumed models could not be tested due to non-significant correlations between the model variables."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "To improve the physical quality of life, depressive symptoms should be included into the treatment of chronic low back pain."
        }
      ]},
