      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This report investigates the association among the bisphosphonate etidronate and relief of metastatic bone pain. Maintaining cognitive function while providing adequate relief from metastatic bone pain can be particularly difficult in elderly patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Case Series."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Rural community dwellings (Carroll County, Maryland) and an urban nursing home (Baltimore, MD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "One patient residing in a skilled nursing facility and two patients from a home hospice program (Carroll Hospice)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Administration of 400 mg of etidronate in cases of refractory metastatic bone pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Reduction in analgesic dosing, improvement in cognitive function, and subjective pain improvement."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Three cases are presented in which the use of the bisphosphonate etidronate allowed for a reduction in opiate use with improvement in pain control and preservation of cognitive function."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Etidronate and perhaps bisphosphonates, in general, should be considered in the management of refractory metastatic bone pain, particularly in the hospice population."
        }
      ]},
