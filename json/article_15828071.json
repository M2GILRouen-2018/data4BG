      "Abstract": {
        "CopyrightInformation": "(c) 2005 Wiley-Liss, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The etiology of work-related back disorders is often population specific. The objective of this study was to identify and establish the association of occupational risk factors with the prevalence of low back (LB) problems in a semi-automated South African Steel industry."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The design entailed an analytical cross-sectional epidemiological study among a group of 366 steel plant workers. Outcome of LB problems was defined using a guided questionnaire and a functional rating index. Exposure to occupational risk factors was determined using self-reported questionnaires."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Multivariate logistic regression analyses indicated significant adjusted odds ratios (OR) for twisting and bending (OR 2.81; CI 1.02-7.73); bulky manual handling (5.58; 1.16-26.71); load carriage (7.20; 1.60-32.37); prolonged sitting (2.33; 1.01-5.37); kneeling and squatting (4.62; 1.28-16.60); and working on slippery and uneven surfaces (3.63; 1.20-10.90)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This study supports the current view of a multifactorial etiology in idiopathic LB problems, and emphasizes the importance of multiple intervention strategies in industrial settings."
          }
        ]
      },
