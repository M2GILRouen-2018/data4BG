      "Language": "nor",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Chronic pain is a serious and frequent health problem in elderly people. We have assessed main characteristics of chronic pain in elderly patients referred to a Norwegian multidisciplinary pain clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Medical records were assessed for patients with chronic pain who were at least 60 years old (n = 48) and treated at the Pain clinic, Haukeland University hospital in 2004. Pain was assessed in relation to sociodemographic, somatic and psychosocial factors."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Pain in the lower extremities and various types of back pain were most frequently reported. Somatic and psychiatric comorbidity (including sleep disturbances) was prevalent."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "INTERPRETATION",
          "content": "The results confirm findings from a number of studies on main characteristics of chronic pain conditions in the elderly. It is important that regular general practitioners emphasize psychosocial factors when assessing and treating chronic pain in the elderly."
        }
      ]},
