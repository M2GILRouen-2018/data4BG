      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To review the presentation, imaging, clinical management, and outcomes in patients with mycotic aneurysm (MA)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Fifty-five cases in 49 patients (33 men, 16 women, average age: 66.2years) were identified."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 49 patients, only 20% presented with the classic clinical triad of fever, elevated white count, and pain. Computed tomography was the most utilized imaging modality; focal vascular outpouching was the most frequent imaging finding (76%). There was 17% mortality rate within 6months of diagnosis despite intervention."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Clinical presentation and blood cultures can be nonspecific, highlighting the importance of imaging diagnosis of MA to expedite treatment."
          }
        ]
      },
