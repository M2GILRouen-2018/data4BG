      "Abstract": {
        "CopyrightInformation": "© The Author 2014. Published by Oxford University Press. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Pain is common in people with dementia, representing a critical aspect of treatment and care. However, there remain considerable gaps in evidence to support pain assessment and treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SOURCES OF DATA",
            "content": "An updated literature search focussing on systematic reviews and randomized controlled trials."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "AREAS OF AGREEMENT",
            "content": "There are key areas of consistency around the prevalence, causes and current treatment trends for pain in dementia, the impact of untreated pain and the need for an accurate, fully validated assessment tool."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "AREAS OF CONTROVERSY",
            "content": "Accurate assessment due to inherent issues in dementia is a critical challenge. There is also a lack of evidence around alternative treatment options."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "GROWING POINTS",
            "content": "New pain predictors are being identified, including physical function, depression and specific pain types, which should inform assessment methodology."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "AREAS TIMELY FOR DEVELOPING RESEARCH",
            "content": "Future research should focus on developing integrated pain management approaches with optimized assessment and evidence-based treatment guidance."
          }
        ]
      },
