      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The aryl hydrocarbon receptor has been shown to be involved in wound healing."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The aim of this study was to assess the effect of tryptophan on wound healing in vitro and in a clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The ability of tryptophan and 2,3,7,8-tetrachlorodibenzo-p-dioxin (TCDD) to increase wound healing was assessed in an in vitro scratch wound model in human keratinocytes. Topical tryptophan and vehicle were assessed for 12 weeks in 51 patients with lower limb ulcers that were resistant to conventional therapies."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "TCDD 0.1 nM and tryptophan 1 µM increased the rate of scratch recovery in a culture model. Topical tryptophan induced stronger pain relief and faster re-epithelialization than its vehicle in patients with lower limb ulcers."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Tryptophan shows promising potential as a novel topical treatment for wound healing."
        }
      ]},
