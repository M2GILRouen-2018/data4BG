      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the acute effect of knee joint icing on knee extension strength and knee pain in patients shortly after total knee arthroplasty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective, single-blinded, randomized, cross-over study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A fast-track orthopaedic arthroplasty unit at a university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Twenty patients (mean age 66 years; 10 women) scheduled for primary unilateral total knee arthroplasty."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "The patients were treated on two days (day 7 and day 10) postoperatively. On one day they received 30 minutes of knee icing (active treatment) and on the other day they received 30 minutes of elbow icing (control treatment). The order of treatments was randomized."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Maximal knee extension strength (primary outcome), knee pain at rest and knee pain during the maximal knee extensions were measured 2-5 minutes before and 2-5 minutes after both treatments by an assessor blinded for active or control treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The change in knee extension strength associated with knee icing was not significantly different from that of elbow icing (knee icing change (mean (1 SD)) -0.01 (0.07) Nm/kg, elbow icing change -0.02 (0.07) Nm/kg, P = 0.493). Likewise, the changes in knee pain at rest (P = 0.475), or knee pain during the knee extension strength measurements (P = 0.422) were not different between treatments."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "In contrast to observations in experimental knee effusion models and inflamed knee joints, knee joint icing for 30 minutes shortly after total knee arthroplasty had no acute effect on knee extension strength or knee pain."
        }
      ]},
