      "Abstract": {
        "CopyrightInformation": "Copyright 2010 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Peak flow is used extensively in emergency departments (EDs) to both assess asthma patient's status on arrival as well as to document clinical improvement during treatment. Many algorithms suggest serial peak expiratory flow (PEF) measurements during an ED stay."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of the study was to assess the contribution of serial PEF in describing the overall improvement of asthmatics over the course of an ED visit for acute exacerbation of their asthma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This was a prospective institutional review board-approved study of mild/moderate asthmatics presenting to an inner-city ED serving a large Latino population. Peak expiratory flow was measured before treatment (baseline PEF) and after each inhaled treatment (PEF post RX#1, PEF post RX#2, PEF post RX#3) while in the ED."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "One hundred consecutive patients made up this study cohort. The change from baseline PEF to PEF #1 represented 86% (95% confidence interval [CI], 76%-96%) of the total improvement experienced by these patients with asthma. The change from PEF post RX#1 to PEF post RX#2 represented 7.5% (95% CI, -4.2% to 26%) of the total improvement and PEF post RX#2 to PEF post RX#3 represented 8.6% (95% CI, -1% to 34%) of the total PEF improvement seen."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATION",
            "content": "No correlation between outcome and PEF% of predicted was made or implied."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The improvement in PEF seen after the first ED inhaled therapy appears to describe most of the total improvement seen in asthmatic patients. Subsequent PEFs provided little additional information."
          }
        ]
      },
