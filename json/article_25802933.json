      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Athletic pelvic and groin injuries are a common yet challenging problem. Pelvic belts have been successfully used to reduce pain and improve function but are not a practical solution for athletes. Therefore, there is scope to explore the use of a more dynamic intervention developed to aid in the management of this type of injury."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To undertake a preliminary investigation into the effectiveness of a dynamic elastomeric fabric orthosis (DEFO) in supporting the management of athletic pelvic and groin injury."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A case series with an AB design. Daily assessments were undertaken over 15 days; the onset of intervention was randomized with a minimum baseline period of 6 d. Follow-up assessment was undertaken after 1 mo."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTINGS",
          "content": "Community and university."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "8 athletes presenting with pelvic or groin injury confirmed through clinical screening."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "A bespoke DEFO."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Force produced on bilateral resisted hip adduction and self-scored pain (using a numerical rating scale of 0-10) at rest and during an active straight-leg raise and a broad jump."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In 7 cases a significant improvement was observed on at least 1 measure (2-SD method, celeration line, and/or the point of nonoverlapping data). The remaining case showed minimal symptoms during testing."
        }
      ]},
