      "Abstract": {
        "CopyrightInformation": "© 2015, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To develop profiles of obesity risk behaviors for children and adolescents."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "Risk assessments were obtained from patients (n = 971) at a school-based health center. Latent class analysis was used to create subgroups based on seven indicators measuring diet, activity, and screen time."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Four classes emerged, with 44% classified as the \"Healthiest,\" 8% as the \"Least Healthy,\" 37% as \"Mixed Diet/Low Activity/Low Screen Time,\" and 11% as \"Mixed Diet/High Activity/High Screen Time.\" Several demographic predictors distinguished the classes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Obesity risk factor profiles may help providers identify strengths and risks, tailor counseling, and plan interventions with families."
          }
        ]
      },
