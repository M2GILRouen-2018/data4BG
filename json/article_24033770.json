      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "© Copyright 2013 by The American College of Veterinary Surgeons.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate equine cardiopulmonary function and recovery quality after administration of 0.25 or 0.50 mg/kg xylazine intravenously (IV) during recovery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Randomized, blinded, prospective, clinical study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANIMALS",
            "content": "Horses (n = 20)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "During recovery after 3 hours of isoflurane anesthesia for arthroscopic surgery, horses were administered either 0.25 mg/kg (G25, n = 10) or 0.50 mg/kg (G50, n = 10) xylazine intravenously. Vital signs and arterial blood samples were obtained during recovery before sedation (baseline), 5, 10, 20, 30, and 45 minutes after xylazine and 30 minutes after standing. The quality of recovery scores ranged from 10 to 72 (10 = best, 72 = worst)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "G25 horses recovered faster (mean ± SD, 33 ± 5 min) than G50 horses (50 ± 7 min, P < .0001). Mean maximal decrease in arterial oxygen tension was 55 ± 11 mmHg in G25 (at 10 minutes; P < .05) and 54 ± 7 mmHg in G50 (at 20 minutes; P < .01). G25 group had a total recovery score (23 [range 18-29]) and number of attempts to stand (4 ± 2) greater than the G50 group (18 [10-23] and 1 ± 1, respectively; P < .001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Both doses of xylazine promoted a moderate and transient hypoxemia during recovery; however, the 0.5 mg/kg dose produced a longer and improved quality of recovery from anesthesia."
          }
        ]
      },
