      "Abstract": {
        "CopyrightInformation": "© 2014 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND AIMS",
            "content": "There is little information supporting the relationships between macronutrients and pre-clinical atherosclerosis. The aim of this study was to identify whether dietary macronutrient content is related with CAC."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "10,793 healthy Korean adults in a cohort were enrolled. Subjects were divided into CAC (CAC score >0) or non-CAC group (CAC score = 0). Intake of energy, carbohydrate (CHO), protein and fat were obtained using food frequency questionnaire (FFQ). Macronutrient composition was expressed as the ratio of energy from each macronutrient to total energy. Subjects were classified into three groups according to tertiles of intake for each macronutrient. To investigate the association between macronutrient intake and CAC, multiple regression analysis was conducted according to tertile groups of each macronutrient."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The prevalence of CAC significantly differed among tertile groups of CHO and fat intake in men (p < 0.001, p < 0.01) and women (p < 0.05, p < 0.01). However, multiple logistic regression analysis revealed that the odds ratios (ORs) for CAC were not significantly different among tertile groups of each macronutrient intake after adjustment in men (CHO: OR = 0.965 [95% CI = 0.826-1.129]; protein: OR = 1.029 [95% CI = 0.881-1.201]; fat: OR = 1.015 [95% CI = 0.868-1.188]) and women (CHO: OR = 1.158 [95% CI = 0.550-2.438]; protein: OR = 1.261 [95% CI = 0.629-2.528]; fat: OR = 0.625 [95% CI = 0.286-1.365])."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The prevalence of CAC may not be associated with composition of dietary macronutrient intake in in healthy Korean adults."
          }
        ]
      },
