      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Peripheral nerve stimulation for chronic pain states is a safe and efficacious technique, being used with increasing frequency. The incidence of hardware-related complications requiring revision remains high."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The authors describe a technique of distal to proximal neurostimulator lead revision, which does not require the changing of generators or extension leads, and thus presumably will minimize further device-related complications."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The authors present a case series of 3 patients where the distal to proximal neurostimulator lead revision technique was utilized."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The technique was well tolerated in each instance and all patients reported >50% pain reduction at long-term follow-up."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The distal to proximal neurostimulator lead revision technique quickly and safely adjusts lead position, including both lead depth and lead tip location, without a need for replacement of components or revision of the entire system."
          }
        ]
      },
