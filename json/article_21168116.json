      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Qigong is a Chinese health promoting exercise with a rhythmic pattern of slow movements and breathing affecting the autonomous nervous system."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To examine the implementation of Qigong for half an hour daily in a computerised office, and to study effects on health state, general health, neck-shoulder and lumbar spine symptoms and stress after six weeks training"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A crossover intervention study with 37 employees randomised in two groups. A questionnaire was completed one week before starting study and every second week during the training period. After 6 weeks the first group stopped and the second group started the training."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was a small significant improvement of neck pain and disability following therapy."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Qigong training may reduce neck disability in office workers. A longer training period might be needed in further Qigong studies in healthy, normal populations."
          }
        ]
      },
