      "Abstract": {
        "CopyrightInformation": "© 2014 NANDA International, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The main purpose of the study was to validate the defining characteristics of the nursing diagnosis acute pain in the Czech Republic and Slovakia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "This is a descriptive study. The validation process involved was based on Fehring's diagnostic content validity model."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "Four defining characteristics were classified as major by Slovak nurses and eight defining characteristics were classified as major by Czech nurses."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Validation of the nursing diagnosis acute pain in the Czech and Slovak sociocultural context has shown that nurses prioritize characteristics that are behavioral in nature as well as patients' verbal reports of pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Verbal reports of pain and behavioral indicators are important for arriving at the nursing diagnosis acute pain."
          }
        ]
      },
