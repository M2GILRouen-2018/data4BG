      "Abstract": {
        "CopyrightInformation": "© 2015 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The G-protein coupled receptor family C group 6 member A (GPRC6A) is activated by proteinogenic amino acids and may sense amino acids in the gastrointestinal tract and the brain. The study investigated whether GPRC6A was necessary for the effects of low- and high-protein diets on body weight and food intake in mice."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The role of GPRC6A in mediating the effects of a low-protein diet on body weight was investigated in GPRC6a knockout (GPRC6a-KO) and wild-type (WT) mice fed a control diet (18% protein) or a low-protein diet (6% protein) for 9 days. The role of GPRC6A in mediating the effects of a high-protein diet on body weight was investigated in GPRC6a-KO and WT mice fed a control diet (18% protein) or a high-protein diet (50% protein) for 5 weeks."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A high-protein diet reduced body weight gain and food intake compared with a control diet in both WT and GPRC6a-KO mice. A low-protein diet decreased body weight gain in GPRC6a-KO mice."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "GPRC6A was not necessary for the effects of a low- or high-protein diet on body weight and likely does not play a role in protein-induced satiety."
          }
        ]
      },
