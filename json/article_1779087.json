      "Abstract": {
        "CopyrightInformation": "Published by the BMJ Publishing Group Limited. For permission to use (where not already granted under a licence) please go to http://www.bmj.com/company/products-services/rights-and-licensing/.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To investigate the association between rheumatoid arthritis (RA) and self-reported sleep duration."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "The present study analysed 7\u2005years of aggregated cross-sectional data (2007-2013) from the Korea National Health and Nutrition Examination Surveys (KNHANES)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "A total of 37\u2005979 individuals were selected for the analyses."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "RA."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "PRIMARY AND SECONDARY OUTCOME MEASURES",
            "content": "Sleep duration."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After adjusting for confounding factors, the odds of short-duration sleepers (≤6\u2005hours/day) and long-duration sleepers (≥9\u2005hours/day) for RA were 1.23-fold (95% CI 1.101 to 1.51) and 1.27-fold (95% CI 0.85 to 1.88) higher, respectively, than those for persons with sleep duration of 7-8\u2005hours/day. A subgroup analysis according to the extent of pain in RA revealed that the strong relationship between RA and sleep disturbances was observed in those with high pain from RA (OR: 1.28 CI 1.04 to 1.58)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Individuals with RA may be at a higher risk for sleep disturbances compared with individuals without RA. Therefore, the provision of comprehensive care for patients with RA by healthcare professionals should include assessments of sleep duration and patients with RA should be encouraged to report sleep problems."
          }
        ]
      },
