      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To observe the clinical efficacy of puerarin in treating patients with unstable angina (UA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Frequency of angina events, consumed doses of nitrates, heart rate, blood pressure, rest electrocardiogram (ECG) and myocardial oxygen consumption were observed before and after drug therapy in puerarin group (21 cases) and control group (18 cases) respectively."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The puerarin group not only showed more effective than that in control group in reducing frequency of angina events and consumed doses of nitrates and improving abnormal rest ECG, but also appeared to be preferable to the control group in reducing myocardial oxygen consumption and increasing exercise duration (P < 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Puerarin is a safe and effective drug in treating patients with UA."
        }
      ]},
