      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To evaluate the success of a multifaceted, hospicewide, nurse-focused pain-management intervention for improving patient pain outcomes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Comparative, descriptive."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A large, nonprofit hospice that primarily provides home care."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "Two samples were included in the study. One sample (n = 47) was from a study completed in 1995 before the intervention, and one (n = 255) was from a study completed in 1997 after the intervention. All patients had been diagnosed with cancer and were alert and able to self-report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Secondary analysis of data that were collected as part of two quality-of-life studies. The four-part intervention included intensive pain-management education for the nurses, development and implementation of pain-management policies and procedures, changes in pain assessment and management documentation, and development and use of quality assurance monitors by the nursing staff."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Pain at its worst, pain relief, and quality of life."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "Adjusted mean pain-relief scores were significantly lower in 1995 (X = 5.8) than in 1997 (X = 8.4). In 1995, 43% of patients reported pain relief at a level of 5 or less (on a 0-10 scale). This number dropped to 10% by 1997. Adjusted mean pain-at-its-worst scores were significantly lower in 1997 (X = 6.1) than in 1995 (X = 6.7). Pain relief was found to be positively correlated (r = 0.41-0.51) with quality of life in both samples."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The hospicewide pain-management intervention was effective."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "Through careful study and multifaceted nurse-focused interventions, pain outcomes of hospice patients with cancer can be improved."
        }
      ]},
