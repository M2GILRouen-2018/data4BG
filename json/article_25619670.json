        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Scurvy is a disease with well-known peripheral symptoms, such as bleeding and pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The clinical and historical evidence for a distinct form of scurvy affecting the central nervous system, called neuropsychiatric scurvy, is reviewed. Pathophysiologic factors are described, as well as its diagnosis and management."
          }
        ]
