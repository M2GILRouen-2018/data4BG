      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To evaluate the differences of MR imaging findings between intracranial and extracranial schwannomas."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We retrospectively reviewed the MR images of 98 schwannomas and compared the imaging findings between intracranial and extracranial schwannomas."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The number of intratumoral cysts was greater in intracranial than in extracranial schwannomas (4.8±7.2 vs 1.8±4.1; p<0.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The number of intratumoral cysts was different between intracranial and extracranial schwannomas."
          }
        ]
      },
