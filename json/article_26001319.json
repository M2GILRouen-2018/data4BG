      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "We evaluated the effectiveness of anesthesia education delivered via Internet videoconferencing between the Massachusetts General Hospital, Boston, MA, and Mbarara Regional Referral Hospital, Uganda."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "This is a prospective educational study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "The setting is the education in 2 hospitals in Uganda and the United States."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS",
            "content": "The subjects are anesthesia residents."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "The interventions are anesthesia education lectures delivered in person and via Internet videoconferencing."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "The average pre-lecture and post-lecture scores of the local, remote, and combined audiences were compared."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "Post-lecture test scores improved over pre-lecture scores: local audience, 59% ± 22% to 81% ± 16%, P = .0002, g = 1.144; remote audience, 51% ± 19% to 81% ± 8%, P < .0001, g = 2.058; and combined scores, 56% ± 14% to 82% ± 8%, P < .0001, g = 2.069)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Transfer of anesthetic knowledge occurs via small group lectures delivered both in person and remotely via synchronous Internet videoconferencing. This technique may be useful to expand educational capacity and international cooperation between academic institutions, a particular priority in the growing field of global health."
          }
        ]
      },
