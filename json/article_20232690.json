      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To investigate the oral health status, access, and the role of mobile dental clinics in improving the oral health of migrant children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Parents attending University of Southern California's Mobile Dental Clinics completed a questionnaire about their children's access to dental care."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "54 percent of children were unable to access needed care, and prevalence of untreated decay was 87.4 percent."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Dental needs are high among migrant children. Mobile clinics provide a safety net for them."
        }
      ]},
