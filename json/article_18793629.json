      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "Point of care testing and multimarker panels are rapidly expanding in emergency departments. We determined the reliability of Short-of-Breath SOB panel in patients admitted for acute dyspnea and/or chest pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND METHODS",
          "content": "SOB D-dimer, BNP, cTnI, CK-MB and myoglobin assays were compared with references in 97 outpatients."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The correlation between SOB and references methods was acceptable, but with limited precision and accuracy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Diagnostic performances and cut-off values should be further validated before clinicians replace traditional cardio-respiratory biomarkers by the new SOB panel."
        }
      ]},
