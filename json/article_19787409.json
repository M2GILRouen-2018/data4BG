      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Reprint & Copyright © 2015 Association of Military Surgeons of the U.S.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess health status among student veterans at a community college utilizing a partnership between a Veterans Affairs Medical Center and a community college."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Student veterans at Cuyahoga Community College in Cleveland, Ohio, in January to April 2013."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A health assessment survey was sent to 978 veteran students. Descriptive analyses to assess prevalence of clinical diagnoses and health behaviors were performed. Logistic regression analyses were performed to assess for independent predictors of functional limitations."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "204 students participated in the survey (21% response rate). Self-reported depression and unhealthy behaviors were high. Physical and emotional limitations (45% and 35%, respectively), and pain interfering with work (42%) were reported. Logistic regression analyses confirmed the independent association of self-reported depression with functional limitation (odds ratio [OR] = 3.3, 95% confidence interval [CI] 1.4-7.8, p < 0.05, and C statistic 0.72) and of post-traumatic stress disorder with pain interfering with work (OR 3.9, CI 1.1-13.6, p < 0.05, and C statistic 0.75)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "A health assessment survey identified priority areas to inform targeted health promotion for student veterans at a community college. A partnership between a Veterans Affairs Medical Center and a community college can be utilized to help understand the health needs of veteran students."
          }
        ]
      },
