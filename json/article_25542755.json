      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "In the study, we describe eight cases in which pelvic congestion syndrome (PCS) was a direct complication of abdominal aortic dissection (AD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We recorded computed tomographic (CT) details of the AD and PCS. The patterns of pelvic varices and reflux were identified as well."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "All eight had abdominal AD (diameter, 23.44-33.98 mm). The compressed left renal vein revealed stenosis in situ (diameter, 1.17-2.69 mm). CT also revealed dilation of left ovarian vein with left pelvic varices in all cases."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Some cases of PCS and dilation of the left ovarian vein can be directly correlated with abdominal AD."
          }
        ]
      },
