      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The clinical efficacy of a wearable pulsed electromagnetic field (PEMF) therapy device was assessed in terms of pain and quality of healing after tooth extraction."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "This randomized, parallel design, placebo-controlled study involved 120 patients undergoing unilateral mandibular third molar extraction and assigned to three groups after surgery. Test and placebo patients wore enabled or disabled PEMF devices, respectively, and controls wore no device. Patients recorded pain (on the visual analog scale) and analgesic use for a week, after which healing complications were assessed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Test patients had only slightly lower visual analog scale scores and analgesic use, but significantly fewer cases of dehiscence than placebo patients."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "PEMF therapy delivered by a wearable device improved soft tissue healing and may be a useful adjunct for pain management after oral surgery."
          }
        ]
      },
