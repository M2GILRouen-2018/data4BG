      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE/OBJECTIVES",
          "content": "To examine the trajectory of changes in body composition and metabolic profile in men who receive androgen-deprivation therapy (ADT) for prostate cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective longitudinal design with repeated measures."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Urban medical center in the southwestern United States."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "55 men starting radiation therapy for prostate cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Changes in the parameters of metabolic syndrome were estimated with ADT (n=31) and non-ADT (n=24) groups by repeated-measures analysis of variance implemented by general linear mixed-effects models. Models included interactions between groups and follow-up time to test differences between the groups."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN RESEARCH VARIABLES",
          "content": "Body composition and metabolic variables."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "FINDINGS",
          "content": "The ADT group demonstrated a transient increase in waist circumference at the nine-month time point and significant changes in measures of insulin resistance were noted at the three month point. Values for diastolic and systolic blood pressure, plasma glucose, high-density lipoprotein, and triglycerides were not altered for either group. Differences in metabolic variables or measures of body composition did not differ significantly between the groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The findings demonstrate the development of insulin resistance in men receiving ADT as early as three months after starting ADT."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING",
          "content": "Addressing survivorship concerns can lead to the development of nursing interventions designed to reduce adverse effects associated with ADT."
        }
      ]},
