      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the effectiveness of patient-controlled analgesia (PCA) in postoperative cardiac surgery patients."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective evaluation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SAMPLE",
          "content": "Ten patients who had undergone coronary artery vein grafting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A cardiac intensive care unit in a private clinic in London, UK."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MEASUREMENTS",
          "content": "Pain scores, level of sedation and amount of analgesia and sedation required were recorded, together with each patient's perception of PCA."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Patients had very little recall of their time in the ICU and none was aware of pain during this period. Patients liked managing their own pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "PCA is an effective means of controlling postoperative pain in cardiac surgery patients."
        }
      ]},
