      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The description of this case is due to the rarity of this clinical entity and its semiotic diversity, which implies a high level of suspicion for a correct diagnosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Description of a clinical case, based on the data referred to in the clinical process."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The case describes a young male patient, attended to at the emergency room due to right chest pain, which further investigation revealed to be consistent with spontaneous pneumomediastinum. He underwent medical treatment, with favorable outcome."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The clinical course is usually benign, self-limited, involves only conservative treatment, and use of drugs is recommended only in symptomatic patients."
        }
      ]},
