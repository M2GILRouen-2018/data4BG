      "Abstract": {
        "CopyrightInformation": "Published by the BMJ Publishing Group Limited. For permission to use (where not already granted under a licence) please go to http://www.bmj.com/company/products-services/rights-and-licensing/",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To run a UK based James Lind Alliance Priority Setting Partnership for 'Surgery for Common Shoulder Problems'."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "This was a nationally funded and conducted process. It was organised from a musculoskeletal research centre and Biomedical Research Unit in Oxford."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "UK shoulder patients, carers and clinicians, involved in treating patients with shoulder pain and shoulder problems that might require surgery."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "These were national electronic and paper surveys capturing treatment uncertainties that are important to shoulder patients, carers and clinicians."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "The outcomes relevant to this study were the survey results and rankings."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The process took 18\u2005months to complete, with 371 participants contributing 404 in scope questions. The James Lind process then produced a final 10 research priorities and uncertainties that relate to the scope of 'Surgery for Common Shoulder Problems'."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The final top 10 UK research priorities have been produced and are now being disseminated to partner organisations and funders to guide funding of shoulder research for the next 5-10\u2005years on topics that are important to patients, their carers and clinicians."
          }
        ]
      },
