      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To analyze the histologic and immunohistochemical structure of uterine rudiments focusing on the endometrium in a representative group of patients with Mayer-Rokitansky-Küster-Hauser (MRKH) syndrome compared with a control group."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective comparative study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Forty-two patients with MRKH syndrome and 13 control subjects."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Representative biopsies or whole uterine rudiments were removed during surgery and processed by a standardized procedure including immunohistochemical staining and analysis."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Histologic structure, tissue types, hormone receptor expression, endometrial proliferative capacity, and type in correlation with cycle phase."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Twenty-two of the uterine rudiments showed a duct-like structure or small cavity, 17 of which contained endometrial epithelium and CD10-positive stroma. All rudiments contained an intact myometrial layer. Tubal epithelium and stroma were found in three rudiment samples. No significant differences were observed with regard to estrogen receptor (ER) or progesterone receptor (PR) expression in endometrium or myometrium. Interestingly, patients showed predominantly basalis-like endometrium with specific lack of CD90 expression and significantly lower proliferation compared with controls."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "All typical uterine tissues can be found in uterine rudiments of patients with MRKH syndrome. Expression of hormonal receptors in the latter and controls did not differ significantly. Endometrium shows predominantly basalis-like features in uterine rudiments."
          }
        ]
      },
