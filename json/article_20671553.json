      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE OF REVIEW",
          "content": "To highlight recent advances in the medical management of metastatic bone disease."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RECENT FINDINGS",
          "content": "Progress has been made in quality of life assessment and pain measurement; in novel ways to use bisphosphonates, especially in the adjuvant setting for prevention of bone metastases and in combination with other pharmaceutical agents, where synergistic enhancement holds high potential; in targeted therapies using novel agents, especially with denosumab which is approaching registration; in the use of bone biomarkers to direct therapy and as surrogate endpoints; in development of radiopharmaceuticals for improved treatment of disseminated bone pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "Metastatic bone disease continues to present management challenges, but these challenges are being met with an increased armamentarium of available interventions."
        }
      ]},
