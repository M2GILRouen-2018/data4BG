      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the feasibility and accuracy of CT coronary angiography (CTCA) combined with CT first-pass myocardial perfusion imaging (CT first-pass MPI) at rest for diagnosis of obstructive coronary artery disease (CAD)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Fifty-five patients, suspected or diagnosed as CAD, were performed with CTCA and CAG within 2 weeks. CT first-pass MPI detected myocardial ischemia through analyzing the raw date of CTCA."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Comparison with the results of CAG, the sensibility, specificity, positive predictive value (PPV), negative predictive value (NPV) and accuracy of CT first-pass MPI at rest for detecting obstructive CAD were 84.6%, 68.8%, 86.8%, 64.7% and 80.0%, respectively; and 92.3%, 93.8%, 97.3%, 83.3%, 92.7% for CTCA combined with CT first-pass MPI, respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "CTCA combined with CT first-pass MPI at rest could detect obstructive CAD feasible and accurately."
        }
      ]},
