      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To compare efficacy of the levonorgestrel-releasing intrauterine system (LNG-IUS; Mirena) with depot GnRH analogue (GnRH-a; gosareline acetate; Zoladex) on endometriosis-related chronic pelvic pain (CPP) in patients with severe endometriosis during 12 months."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, randomized, controlled study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "The reproductive endocrinology unit of a tertiary, research and education hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "Forty women with severe endometriosis (revised The American Fertility Society [AFS] classification >40) and endometriosis-related CPP and control groups were enrolled in the study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "The patients were treated with either LNG-IUS (n = 20) or GnRH-a (n = 20). The GnRH-a dose was repeated every 4 weeks for 24 weeks."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Scores of CPP were evaluated using a visual analogue scale (VAS) and total endometriosis severity profile (TESP)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "The TESP score decreased in the LNG-IUS group at first, third, and sixth month follow-up visits, whereas at the 12th month follow-up visit, the TESP scores were increased to values similar to pretreatment values. Although the VAS score had no significant alteration during the follow-up period in the LNG-IUS group, the GnRH-a group showed a significant decrease in the VAS score and TESP score at the end of 1 year. The LNG-IUS treatment showed a lower patient satisfaction."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "Both treatment modalities showed comparable effectiveness in the treatment of CPP-related endometriosis."
          }
        ]
      },
