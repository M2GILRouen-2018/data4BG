      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Anterior cutaneous nerve entrapment syndrome (ACNES) is a relatively unknown cause of severe neuralgic abdominal pain. Treatment includes medication, local nerve blocks or, if unresponsive, a neurectomy of nerve endings. In children, the outcome of neurectomy for ACNES is scantly described in retrospective studies. The objective of this first prospective study was to investigate the safety and short term success rate of anterior neurectomy in a large pediatric population with ACNES."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "All children <18years with failed non-surgical treatments for ACNES who underwent an anterior neurectomy in a pediatric surgical referral center between March 2012 and June 2015 were prospectively followed. Patients with previous ACNES surgery were excluded. Primary outcome measures were pain relief and adverse events."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "60 children were included (80% female, mean age 15years±2 SD). 75% had right lower abdominal pain. At first follow-up, 47 children were free of pain (78% success rate). Complications other than an occasional local hematoma were not reported. Outcome was not related to demographics, preoperative pain intensity, pain duration or localization."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Anterior neurectomy is safe and successful in most children with abdominal pain failing a conservative treatment for ACNES."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "TYPE OF STUDY",
            "content": "Treatment study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "IV."
          }
        ]
      },
