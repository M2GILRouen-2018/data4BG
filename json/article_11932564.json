      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The purpose of the present study was to examine the effect of aerobic exercise training on the immune system in coronary artery disease patients treated with beta-blockers."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Twenty-five patients (46.1 +/- 2 yr) treated with atenolol, a beta-blocker agent, for 3 months before exercising were divided randomly into two groups: 15 underwent an aerobic exercise training program for 12 wk at 65-70% of their work capacity, whereas the other 10 patients served as controls."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "After training, levels of CD4 and CD8 cells were significantly (P < 0.05) higher and concomitantly the CD4/CD8 ratio decreased significantly (P < 0.05) in the exercising group compared with the control group."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Data suggest that coronary artery disease patients exercising aerobically at 65-70% of their work capacity gain a statistically significant higher lymphocyte T cell function as compared with their untrained counterparts."
        }
      ]},
