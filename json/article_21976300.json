      "Abstract": {
        "CopyrightInformation": "© Georg Thieme Verlag KG Stuttgart · New York.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE OF THIS STUDY",
            "content": "To examine the impact of the subjective health impairment due to pain, intention and planning on long-term physical activity."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "A longitudinal questionnaire study with rehabilitation patients was performed over a time-span of more than 3 years. Data analyses were performed with binary logistic regressions."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "After controlling for social-cognitive variables subjective health impairment due to pain at the beginning of rehabilitation was a significant positive predictor of increased physical activity after rehabilitation. However, subjective health impairment due to pain 6 months after discharge was significantly negatively correlated with physical activity 3 years after rehabilitation."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "These findings suggest that subjective impairment due to pain should be considered when motivating people, e. g. by anticipating pain and possibilities for its improvement, respectively, or by coping planning on how to be physically active even in the face of pain. Especially during the time after rehabilitation patients may benefit from more help to manage pain."
          }
        ]
      },
