      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier España, S.L. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "BACKGROUND AND OBJECTIVE",
            "content": "Hypertension is the most prevalent risk factor in the community. The aim of this study was to describe the risk factors for the progression of blood pressure (BP) from correct values."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SUBJECTS AND METHODS",
            "content": "Prospective and observational study with 7 years follow-up. BP>140/90 mmHg was considered hypertension. A multivariate model was performed to assess risk factors for BP progression and a predictive score."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The 2,236 males, median age 42 years, had differential characteristics according to their baseline BP category. At the end of the 7-years follow-up 31.9% of baseline-normotensive subjects had an increase of their BP to the range of hypertension. Baseline-normotensive subjects who experienced a progression of BP had higher baseline BP and less favourable lipid profile. A risk score was performed using the following variables: age, hypertension familiar history, overweight and obesity, glucose>100mg/dl, triglycerides>150 mg/dl and uric acid. Total score ranged between -2 and 24; the risk of BP progression beyond normal thresholds increased linearly as the score increased."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Progression of BP from normotension to higher BP categories into the next 7 years in young males and the risk can be estimated by a simple score."
          }
        ]
      },
