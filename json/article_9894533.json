      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "Past literature finds considerable variation in the cost of physician care and in the utilization of medical procedures. Variation in the cost of hospitalized care has received little attention. We examine injury costs of hospitalized claims across states."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Multivariate regression analysis is used to isolate state variations, while controlling for personal and injury characteristics, and state characteristics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Injuries to workers filing Workers' Compensation lost workday claims."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "About 35,000 randomly sampled Workers' Compensation claims from 17 states filed between 1979 and 1988."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Medical payments per episode of three injury groups: upper and lower extremity fractures and dislocations, other upper extremity injuries, and back strains and sprains."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Statistical analyses reveal considerable variation in expenditures for hospitalized injuries across states, even after controlling for case mix and state characteristics. A substantial portion of the variation is explained by state rate regulations; regulated states have lower costs."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The large variation in costs suggests a potential to affect the costs of hospitalized care. Efforts should be directed at those areas that have higher costs without sufficient input price, quality, or case mix justification."
        }
      ]},
