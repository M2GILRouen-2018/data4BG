      "Abstract": {
        "CopyrightInformation": "© 2016 John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the economic burden of underweight and overweight among adults in the Asia-Pacific region."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "Systematic review of articles published until March 2015."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Seventeen suitable articles were found, of which 13 assess the economic burden of overweight/obesity and estimate that it accounts for 1.5-9.9% of a country's total healthcare expenditure. Four articles on the economic burden of underweight estimate it at 2.5-3.8% of the country's total GDP. Using hospital data, and compared to normal weight individuals, four articles estimated extra healthcare costs for overweight individuals of 7-9.8% and more, and extra healthcare costs for obese individuals of 17-22.3% and higher."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Despite methodological diversity across the studies, there is a consensus that both underweight and overweight impose a substantial financial burden on healthcare systems in the Asia-Pacific region."
          }
        ]
      },
