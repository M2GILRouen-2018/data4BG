      "Abstract": {
        "CopyrightInformation": "© 2015 The Acta Anaesthesiologica Scandinavica Foundation. Published by John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The Chronic Pain Acceptance Questionnaire (CPAQ, 20 items) measures patients' acceptance of chronic pain. This questionnaire has demonstrated good psychometric qualities and versions have been validated in several different languages. This study describes the validation of the Danish version of the CPAQ."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A total of 114 patients with chronic pain completed the questionnaire as well as other measures of pain, anxiety, depression, coping, and health-related quality of life."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Internal consistency was satisfactory and the factorial analysis yielded a two-factor solution, confirming the original structure of the questionnaire."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The psychometric properties of the Danish version of the 20-item CPAQ were satisfactory, showing that the Danish version of CPAQ is valid and reliable."
          }
        ]
      },
