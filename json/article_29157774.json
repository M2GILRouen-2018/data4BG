      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Society of PeriAnesthesia Nurses. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The aim of this study was to determine if nurse anesthetists (NAs) have access, knowledge, and adhere to recommended guidelines to maintain normal body temperature during the perioperative period."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A descriptive survey design."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Questionnaires were sent to heads of the department (n = 56) and NAs in the operating departments in Sweden."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDING",
            "content": "The level of access to the recommendations is high, but only one third of the operating departments have included the recommendations in their own local guidelines. The NAs' adherence was low, between 5% and 67%, and their knowledge levels were 57% to 60%."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A high level of knowledge, access, and adherence are important for the organization of operating departments to prevent barriers against implementation of new recommendations or guidelines. There are needs for education about patients' heat loss due to redistribution and clear recommendations."
          }
        ]
      },
