      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Surface for perceptive rehabilitation (Su-Per treatment) is a hopeful therapeutic system in the treatment of non-specific chronic low back pain (CLBP). During treatment, some patients poorly tolerate the presence of the less elastic cones at the back midline."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To assess the importance of an increased awareness of body midline through higher stimulus at interspinous line during Su-Per treatment for non-specific CLBP."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Single-blind, randomized, controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Outpatient academic hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "POPULATION",
          "content": "Forty patients with non-specific CLBP, for at least 12 weeks before treatment."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The patients were distributed in 2 groups: Group A (20 patients) received standard Su-Per treatment; Group B (20 patients) received Su-Per treatment without higher stimulus at interspinous line. Pain was assessed using the Visual Analogue Scale and the Present Pain Intensity and Pain Rating Index of the McGill Pain Questionnaire. Disability was evaluated using the Oswestry Disability Index."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In both groups, a significant reduction of pain and disability scores was observed at the first follow-up (end of treatment), and was maintained at later evaluations (4-weeks, and 12-weeks follow up). No significant difference was observed between the two groups in all outcome measures at all time points (P>0.05 for all)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Su-Per treatment is a valid modality in a cognitive-perceptive therapeutic concept for non-specific CLBP. It does not necessarily require external stimulation of the body midline to be effective."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CLINICAL REHABILITATION IMPACT",
          "content": "Modifying the standard distribution of the cones, without less deformable cones along interspinous line, makes the Su-Per treatment more acceptable to patients."
        }
      ]},
