      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine the incidence, clinical stage, and lesion type of endometriosis in adolescent girls."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective review of patient records of adolescent girls (11-19) admitted to Emory University Affiliated Hospitals."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Patients from a private practice institutional setting."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "67 adolescent girls who had not responded to analgesia or oral contraceptives for pelvic pain."
        },
        {
          "NlmCategory": "UNASSIGNED",
          "Label": "INFORMATION",
          "content": "Laparoscopy or exploratory laparotomy to determine the etiology of pelvic pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE",
          "content": "Stage of endometriosis by the American Fertility Society classification system and description of lesion type."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Endometriosis was diagnosed in 49 (73%) patients. The majority of patients had stage I disease. Superficial red lesions were most commonly observed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Adolescent girls with pelvic pain have a high incidence of endometriosis. Minimal disease is most often encountered. Meticulous inspection of the pelvic peritoneal surfaces will often reveal superficial or atypical lesions."
        }
      ]},
