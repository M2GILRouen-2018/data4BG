      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 SIR. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To evaluate the safety and effectiveness of a curved needle compared with traditional (noncurved needle) techniques in a large single-center experience."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "This study was a retrospective analysis of 243 consecutive vertebral augmentation procedures over a 17-month period. Curved needle procedures were compared with noncurved needle procedures for baseline clinical variables, complication rate, pain relief, and improvement in disability. Procedure duration and fluoroscopy time were compared between the two cohorts."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Between curved needle and noncurved needle procedures, there were no statistically significant differences in the baseline clinical variables, fracture location, and fracture etiology. No complications were noted in either group. In both groups, there was a median improvement in the visual analog scale (VAS) score of 2.0 points (P = .62). More than 90% of procedures in both groups resulted in some pain improvement (P = .78). For both groups, the median improvement in disability on the Roland Morris Disability Questionnaire (RMDQ) was 4.0 points (P = .69). Approximately 70% of procedures in both groups resulted in improvement in disability (P = 1.00). In single-level cases, there were shorter procedure times (51.8 min ± 2.7 vs 62.8 min ± 2.2, P = .002) and shorter fluoroscopy times (P = .31) for curved needle procedures."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The curved needle is as safe and effective as traditional vertebral augmentation techniques in treating the pain and disability related to vertebral compression fractures. Additionally, the curved needle is associated with shorter procedure duration and reduced fluoroscopy time."
          }
        ]
      },
