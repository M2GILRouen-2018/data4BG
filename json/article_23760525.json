      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "IMPORTANCE",
          "content": "Regional anesthetic techniques can be used to alleviate postoperative pain in children undergoing pediatric surgical procedures. Use of ultrasonographic guidance for bilateral rectus sheath block (BRSB) has been shown to improve immediate pain scores and reduce use of postoperative analgesia in the postanesthesia care unit (PACU)."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare efficacy of ultrasonography-guided BRSB and local anesthetic infiltration (LAI) in providing postoperative analgesia after pediatric umbilical hernia repair."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective, observer-blinded, randomized clinical trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Tertiary-referral urban children's hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Eligible children 3 to 12 years of age undergoing elective umbilical hernia repair from November 16, 2009, through May 31, 2011."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Ropivacaine hydrochloride administered at the conclusion of surgery as LAI by the surgeon (n\u2009=\u200925) or as ultrasonography-guided BRSB by the anesthesiologist (n\u2009=\u200927)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOMES AND MEASURES",
          "content": "Scores on the FACES Pain Rating Scale measured at 10-minute intervals and all use of analgesic medications in the PACU."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Median FACES scores in the PACU were lower in the BRSB group compared with the LAI group at 10 minutes (0 vs 1; P\u2009=\u2009.04), 30 minutes (0 vs 1; P\u2009=\u2009.01), and 40 minutes or later (0 vs 1; P\u2009=\u2009.03). Fewer doses of opioid and nonopioid medications were given to the BRSB group compared with the LAI group (5 vs 11 doses for opioids; 5 vs 10 for nonopioids)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS AND RELEVANCE",
          "content": "In the PACU, ultrasonography-guided BRSB after umbilical hernia repair in children is associated with lower median FACES scores and decreased use of opioid and nonopioid medications compared with LAI. Future studies could examine the use of longer-acting anesthetic agents with ultrasonography-guided BRSB."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "TRIAL REGISTRATION",
          "content": "clinicaltrials.gov Identifier: NCT01015053."
        }
      ]},
