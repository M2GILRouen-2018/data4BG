      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE OF REVIEW",
          "content": "The transversus abdominis plane (TAP) block is a relatively new regional anaesthesia technique that has shown analgesic benefit in abdominal and pelvic surgery. There has been recent interest in expanding this regional technique to enhance analgesia following caesarean delivery."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RECENT FINDINGS",
          "content": "We will discuss the gross anatomy and neuroanatomy relevant to the TAP, contrast studies looking at the spread of solution within the TAP and the clinical analgesia achieved with the TAP block. We will also present the most recent publications on TAP block analgesia for caesarean delivery and compare the TAP block to intrathecal morphine."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "The TAP block significantly improves postoperative analgesia and reduces opioid consumption and opioid-related side-effects in women undergoing caesarean delivery who did not receive intrathecal morphine."
        }
      ]},
