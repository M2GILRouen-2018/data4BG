      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To demonstrate the feasibility of copper IUD insertion following cesarean deliveries and assess its safety."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "This is a prospective pilot study at Pikine national hospital from February 15 to November 15, 2012. Were evaluated the efficacy, incidence and spectrum of complications and continuation rates."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Fifty-nine subjects were enrolled and 46 received an IUD. The average age of patients was 28 years. No patient had previously used IUDs. Forty-four patients (97.5%) were returned to the first follow-up visit at the first month, 41 patients (89.1%) at the second visit and 39 patients (86.9%) at the third visit. The rate of lost sight was 8.7%. Pain and bleeding were reported rarely: 2.3% at the first month, 4.9% at the third month and 7.7% at the sixth month for the bleeding and 6.8% at the first month, 2.4% at the third month and 2% at the sixth month for pain. The rate of expulsion was 2.2%."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The insertion of the IUD following cesarean delivery has an acceptable rate of expulsion and no increased rate of adverse effects. This technique should be popularized."
          }
        ]
      },
