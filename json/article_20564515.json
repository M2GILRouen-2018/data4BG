      "Abstract": {
        "CopyrightInformation": "© 2010 Wiley-Liss, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We examined disparities in workers' occupational health experiences."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We surveyed 941 unionized Las Vegas hotel room cleaners about their experiences with work-related pain and with employers, physicians, and workers' compensation. Data were analyzed for all workers and by ethnicity, language, and immigrant status."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Hispanic and English as second language (ESL) workers were more likely than their counterparts to report work-related pain and, along with immigrant workers, to miss work because of this pain. Hispanic, ESL, and immigrant workers were not consistently at a disadvantage with regard to their own responses to work-related pain but were so with respect to reported responses by workers' compensation, physicians, and employers."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "There are indications of disparities in occupational health experiences within this job title. The use of different group classifications, while implying different mechanisms, produced similar results."
          }
        ]
      },
