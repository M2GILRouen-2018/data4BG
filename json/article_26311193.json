      "Abstract": {
        "CopyrightInformation": "© 2017 The American Laryngological, Rhinological and Otological Society, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The objective of this study was to compare the timing of hearing aid (HA) acquisition between adults in rural and urban communities. We hypothesized that time of acquisition of HA after onset of hearing loss is greater in rural adults compared with urban adults. Secondary objectives included assessment of socioeconomic/educational status and impact of hearing loss and hearing rehabilitation of urban and rural HA recipients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Cross-sectional questionnaire survey."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "We assessed demographics, timing of HA fitting from onset of hearing loss, and impact of hearing impairment in 336 adult HA recipients (273 urban, 63 rural) from a tertiary referral center. Amplification benefit was assessed using the International Outcome Inventory for Hearing Aids (IOI)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The time to HA acquisition was greater for rural participants compared to urban participants (19.1 vs. 25.7 years, P = 0.024) for those with untreated hearing loss for at least 8 years. Age at hearing loss onset was correlated with time to HA acquisition (P = -0.54, P < 0.001). Rural HA participants experienced longer commutes to hearing specialists (68 vs. 32 minutes, P < 0.001), were less likely to achieve a degree beyond high school (P < 0.001), and were more likely to possess Medicaid coverage (P = 0.012) compared to urban participants. Hearing impairment caused job performance difficulty in 60% of all participants."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Rural adults are at risk for delayed HA acquisition, which may be related to distance to hearing specialists. Further research is indicated to investigate barriers to care and expand access for vulnerable populations."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LEVEL OF EVIDENCE",
            "content": "4. Laryngoscope, 127:2362-2367, 2017."
          }
        ]
      },
