      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the expression of smooth muscle actin(SMA)-alpha mRNA in the lung of rat with asthma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A rat model of asthma was established by exposing the animal to aerosolized ovalbumin (OA). After being sensitized, the rat was subjected to laboratory tests. alpha-SMA mRNA of the lung tissue was measured by RT-PCR. The thickness of the airway smooth muscle(ASM) was measured by an image analysis system at the same time."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The thickness of ASM increased 2 weeks after OA challenge. The expression of alpha-SMA mRNA increased 1 week after OA challenge and increased more significantly after 2 weeks."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "In the rat model of asthma, hypertrophy and hyperplasia of the airway smooth muscle were noted, and the phenotype was changed."
        }
      ]},
