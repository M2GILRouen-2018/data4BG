      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To characterize the clinical picture of Pogosta disease."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "The data of 73 patients who had had Pogosta disease in 1981 and who then had been seen by a local physician in North Karelia were analysed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The main manifestations were fever (23%), rash (88%) and joint symptoms (93%). The joint symptoms in some patients lasted for several months and were severe enough to cause immobilization. The clinical picture was identical in those patients who had a definite serological diagnosis and those who did not have a detectable antibody response."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The symptoms of Sindbis virus-induced Pogosta discase consist of fever, rash and joint symptoms, whic may be severe and prolonged."
        }
      ]},
