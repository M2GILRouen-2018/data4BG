      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To report a case of anesthetic abuse keratopathy and to suggest the use of topical diclofenac sodium in the management of this disorder."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "Narcotics and topical diclofenac were used to control pain in a patient who developed a corneal ulcer after abusing topical anesthetics."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "After the institution of topical diclofenac, the patient reported substantial improvement in comfort and less reliance on narcotic agents for analgesia."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "We found topical diclofenac to be useful in controlling pain in this patient with anesthetic abuse keratopathy."
        }
      ]},
