      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The lack of evidence of conservative treatment has led to an interest in exploring myofascial release (MFR) as an effective means of controlling spinal curvature progression in adolescents with idiopathic scoliosis."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The purpose of this case study is to measure the effects of MFR as a manual therapy technique in the treatment of idiopathic scoliosis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "One 18-year-old female subject underwent 6 weeks of MFR treatment consisting of two sessions each week for 60min. Pain, pulmonary function, and quality of life were measured. Six goniometric measurements were taken encompassing trunk flexion, extension, and rotation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The subject improved with pain levels, trunk rotation, posture, quality of life, and pulmonary function."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The results suggest further investigation is needed using MFR, as an effective manual therapy treatment for idiopathic scoliosis."
        }
      ]},
