      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Allergic reactions to peanut and tree nuts can present as upper airway obstruction."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To increase awareness that food allergy should be considered in the differential diagnosis of upper airway obstruction in children."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We report an allergic reaction to cashew that was initially misdiagnosed as foreign body aspiration."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "When the presenting signs and symptoms of food allergy are limited to upper airway obstruction, they can be confused with foreign body aspiration."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "As peanuts and tree nuts are common causes of both food allergy and foreign body aspiration in children, both of these diagnoses should be considered in the differential diagnosis of airway obstruction."
        }
      ]},
