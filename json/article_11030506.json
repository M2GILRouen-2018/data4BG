      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the criterion validity and responsiveness to change of spine kinematic variables to assess disability in patients with low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Blinded comparison between spine kinematic variables, Oswestry disability questionnaire scores, and work status."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Multidisciplinary occupational rehabilitation clinic of a university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Population-based cohort of 111 patients with subacute work-related back pain who were absent from regular work for more than 4 weeks because of back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "This study was part of a population-based randomized clinical trial. Patients were randomized to 4 different methods of management: usual care, rehabilitation, ergonomics, or rehabilitation and ergonomics."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Oswestry disability questionnaire, kinematic analysis of the spine during flexion and extension of the trunk, and work status were collected at weeks 4, 12, 24, and 52 after the back accident."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Kinematic variables were poorly to moderately related to work status and Oswestry questionnaire scores. Kinematic variables were also unresponsive to change in work status and Oswestry questionnaire scores over time."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Spine kinematics during flexion and extension of the trunk do not appear to be a valid measure of disability in patients with subacute and chronic back pain."
        }
      ]},
