      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the effect of granisetron pretreatment in alleviating propofol injection pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A randomized, controlled, double-blind study, using venous retention with a tourniquet."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "One hundred fifty adult patients were randomly assigned to one of three groups: group 1 (who received 5 mL of 0.9% saline pretreatment), group 2 (who received 5 mL lidocaine [40 mg in 0.9% saline] pretreatment), and group 3 (who received 5 mL granisetron [2 mg in 0.9% saline] pretreatment). Injections were given in the largest vein on the dorsum of the hand. After 2 minutes, the tourniquet was released and one fourth of the total calculated dose of propofol (2.5 mg/kg body weight) was administered and pain assessment was made."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Lidocaine and granisetron significantly reduced the incidence and severity of propofol injection pain more than placebo (P < 0.001). The efficacy of granisetron in alleviating the pain on injection of propofol was no different from lidocaine."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Granisetron pretreatment may be used to reduce the incidence of pain on injection of propofol, an advantage added to the useful prevention of postoperative nausea and vomiting."
        }
      ]},
