      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Primary care patients with Panic Disorder (PD) and Generalized Anxiety Disorder (GAD) experience poorer than expected clinical outcomes, despite the availability of efficacious pharmacologic and non-pharmacologic treatments. A barrier to recovery from PD/GAD may be the co-occurrence of pain."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate whether pain intensity interfered with treatment response for PD and/or GAD in primary care patients who had received collaborative care for anxiety disorders."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A secondary data analysis of a randomized, controlled effectiveness trial comparing a telephone-delivered collaborative care intervention for primary care patients with severe PD and/or GAD to their doctor's \"usual\" care."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Patients had to have a diagnosis of PD and/or GAD and a severe level of anxiety symptoms. The 124 patients randomized at baseline to the collaborative care intervention were analyzed. Participants were divided into two pain intensity groups based on their response to the SF-36 Bodily Pain scale (none or mild pain vs. at least moderate pain)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN MEASURES",
          "content": "Pain was assessed using the Bodily Pain scale of the SF-36. Anxiety symptoms were measured with the Hamilton Anxiety Rating Scale (HRS-A), Panic Disorder Severity Scale (PDSS) and Generalized Anxiety Disorder Severity Scale (GADSS). Measures were collected over 12 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "KEY RESULTS",
          "content": "At baseline, patients with at least moderate pain were significantly more likely to endorse more anxiety symptoms on the HRS-A than patients with no pain or mild pain (P\u2009<\u2009.001). Among patients with severe anxiety symptoms, 65 % (80/124) endorsed experiencing at least moderate pain in the previous month. A significantly lesser number of patients achieved a 50 % improvement at 12 months on the HRS-A and GADSS if they had at least moderate pain as compared to patients with little or no pain (P\u2009=\u20090.01 and P\u2009=\u20090.04, respectively)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Coexisting pain was common in a sample of primary care patients with severe PD/GAD, and appeared to negatively affect response to anxiety treatment."
        }
      ]},
