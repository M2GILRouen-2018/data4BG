      "Abstract": {
        "CopyrightInformation": "© 2011 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Coronary artery anomalies are very rare. Recognizing these anomalies are clinically relevant as they can mimic symptoms of coronary artery disease, and sporadic cases of sudden death have been described in these patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHOD",
            "content": "This report describes a 55-year-old patient with left main disease and an anomalous left anterior descending artery arising from anterior coronary sinus who presented with palpitations."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT",
            "content": "Patient underwent coronary artery bypass grafting with left internal mammary artery to the ramus intermedius with cardiopulmonary bypass using antegrade blood cardioplegia. The anomalous left anterior descending artery was crossing the right ventricular outflow tract and running on the interventricular groove."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The diagnosis and management of coronary artery anomalies is the subject of this review."
          }
        ]
      },
