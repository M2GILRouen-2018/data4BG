      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 John Wiley & Sons, Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "The aim of this study was to describe experience with robotic assisted hemi-nephrectomy (RAHN) for the management of duplicated renal collecting system."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The authors' institutional database was queried to identify patients who underwent RAHN from 2007 to 2013 for the management of a duplicated system. Patient demographics, indications and surgical outcomes were reviewed and analyzed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Five patients were identified with a duplicated system of which all had a history of pain and recurrent infection. Three patients underwent hemi-nephrectomy for a poorly functioning lower pole and two for an abnormal upper pole moiety. All operations were completed successfully using a robotic approach. There were only two minor (Clavien grade 1-2) complications."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "RAHN is a viable option for the surgical treatment of an atrophic, chronically infected duplicated system. The unique features of robotic technology offer enhanced dexterity and vision facilitating the management of complex vascular and ureteral anatomy."
          }
        ]
      },
