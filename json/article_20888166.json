      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Successful shock management requires prompt identification, classification, and treatment; however, the triage of patients with non-hemorrhagic shock to the trauma room can lead to delayed diagnosis with increased morbidity and mortality."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Our goal is to emphasize the importance of shock identification and classification to facilitate the delivery of the appropriate and timely therapy, no matter how the patient is triaged."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CASE REPORT",
            "content": "We describe a patient triaged as a trauma patient with suspected hemorrhagic shock yet who was found to have anaphylaxis as the etiology of his condition. Abdominal anaphylaxis, a less recognized presentation of anaphylaxis, is reviewed and discussed."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "We hope to increase awareness of a less common presentation of anaphylaxis and discuss its management."
          }
        ]
      },
