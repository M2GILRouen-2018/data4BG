      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate the application of local anaesthesia for reduction of acute anterior shoulder dislocation"
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective study of patients coming with anterior dislocation of shoulder to KMCTH from July 2002 to Sep 2003."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Patients of aged 15-55 years with no associated fractures of adjoining bones."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "A total of fifteen patients with anterior inferior shoulder dislocation were studied and all were reduced safely under local anaesthesia."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Use of intra-articular lignocaine for reduction of shoulder dislocation is safe and effective and is beneficial for countries like Nepal where health facilities are minimum in rural and suburban areas."
        }
      ]},
