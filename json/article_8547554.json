      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To evaluate postthoractomy analgesia in patients receiving lumbar epidural hydromorphone versus intrapleural bupivacaine."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A randomized, prospective, double-blind study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A university-affiliated medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Twenty patients undergoing lateral thoracotomy for either pulmonary wedge resection, lobectomy, or pneumonectomy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Nine patients received epidural hydromorphone, and 11 patients received intrapleural bupivacaine in the postoperative period."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Severity of pain was assessed using a visual analog pain scale (VAPS) (0 to 100 mm) at 1, 3, and 5 hours. Patients receiving epidural hydromorphone had a statistically significant improvement in VAPS scores. Patients who received intrapleural bupivacaine did not achieve a significant reduction in pain scores. Nine of 11 patients in the intrapleural bupivacaine group had \"failed\" postoperative analgesia as defined by a VAPS greater than 30. Only 3 of 9 patients in the continuous epidural hydromorphone group had \"failed\" analgesia."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Epidural hydromorphone is superior to intrapleural bupivacaine in achieving satisfactory pain outcomes during the first 5 hours after thoracotomy."
        }
      ]},
