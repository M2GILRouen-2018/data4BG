      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "We examined a population-wide program, Pennsylvania's Healthy Steps for Older Adults (HSOA), designed to reduce the incidence of falls among older adults. Older adults completing HSOA are screened and educated regarding fall risk, and those identified as being at high risk are referred to primary care providers and home safety resources."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "From 2010 to 2011, older adults who completed HSOA at various senior center sites (n\u2009=\u2009814) and a comparison group of older adults from the same sites who did not complete the program (n\u2009=\u20091019) were recruited and followed monthly. Although participants were not randomly allocated to study conditions, the 2 groups did not differ in fall risk at baseline or attrition. We used a telephone interactive voice response system to ascertain the number of falls that occurred each month."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "In multivariate models, adjusted fall incidence rate ratios (IRRs) were lower in the HSOA group than in the comparison group for both total (IRR\u2009=\u20090.83; 95% confidence interval [CI]\u2009=\u20090.72, 0.96) and activity-adjusted (IRR\u2009=\u20090.81; 95% CI\u2009=\u20090.70, 0.93) months of follow-up."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Use of existing aging services in primary prevention of falls is feasible, resulting in a 17% reduction in our sample in the rate of falls over the follow-up period."
        }
      ]},
