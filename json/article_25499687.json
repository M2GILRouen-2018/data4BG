      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess if a 12-week exercise intervention to improve aerobic fitness, muscle strength, and core stability also had an impact on fatigue, pain, activity, and participation in adults with Pompe disease, an inherited neuromuscular disorder."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Open-label trial. Change was assessed by the chi-square test and Wilcoxon signed-rank test."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Physiotherapy practices."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Mildly affected adult patients with Pompe disease who were not dependent on ventilators and/or walking devices and were receiving enzyme replacement therapy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Patients participated in a 12-week exercise program, which included 36 sessions of standardized aerobic, resistance, and core stability exercises."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Before and after the training program we evaluated fatigue (Fatigue Severity Scale), pain (yes/no), motor function (Quantitative Muscle Function Test, Rasch-built Pompe-specific Activity Scale), amount of physical activity (activity monitor), and health status (Medical Outcomes Study 36-Item Short-Form Health Survey)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of the 25 patients enrolled, 23 completed the program. At the end of the program, levels of fatigue (median, 5.33 to 4.78, P=.01) and pain (56.5% to 21.7%, P=.04) improved. The quality of motor function and the amount of physical activity patients engaged in did not change. Changes in pain and fatigue were not related to improvements in aerobic fitness or muscle strength."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "This study in mildly affected adult patients with Pompe disease suggests that a combined training program aiming to increase aerobic fitness, muscle strength, and core stability also leads to improvements in fatigue and pain."
          }
        ]
      },
