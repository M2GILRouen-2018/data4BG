      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "The aim of this study was to evaluate the clinical effect of therapeutic embolization in the pelvic congestion syndrome caused by ovarian varices."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "Six women, aged 25-40 years, with pelvic pain syndrome and marked left (n = 5) or bilateral (n = 1) ovarian varicocele were treated by transcatheter retrograde venous embolization."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The pelvic pain syndrome disappeared in all patients within 4 weeks, and there was regression of the periodic pain in 2 women with dysmenorrhoea. The patients were free of symptoms during the 1-4-year follow-up."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Marked ovarian varices may cause a pelvic pain syndrome. Percutaneous embolization improves both the chronic pain and the dysmenorrhea in these patients. Transcatheter treatment could be considered as an alternative to surgical or laparoscopic ligation in ovarian varicocele."
        }
      ]},
