      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Preoperative atrial fibrillation (AF) is associated with increased morbidity and mortality after open heart surgery. However, the impact of preoperative AF on long-term survival after open heart surgery has not been widely examined in rural populations. Patients from rural regions are less likely to receive treatment for cardiac conditions and to have adequate medical insurance coverage."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To examine the influence of preoperative AF on long-term survival following open heart surgery in rural eastern North Carolina."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Long-term survival was compared in patients with and without preoperative AF after coronary artery bypass grafting (CABG) and CABG plus valve (CABG + V) surgery between 2002 and 2011. Hazard ratios (HR) and 95% confidence intervals (CI) were computed using a Cox regression model."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The study population consisted of 5438 patients. A total of 263 (5%) patients had preoperative AF. Preoperative AF was an independent predictor of long-term survival (open heart surgery: adjusted HR = 1.6, 95% CI = 1.3-2.0; CABG: adjusted HR = 1.6, 95% CI = 1.3-2.1; CABG + V: adjusted HR = 1.6, 95% CI = 1.1-2.3)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Preoperative AF is an important predictor of long-term survival after open heart surgery in this rural population."
          }
        ]
      },
