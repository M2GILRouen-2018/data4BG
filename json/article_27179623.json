      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND CONTEXT",
            "content": "No previous cases of atlantoaxial instability due to granulomatosis with polyangiitis have been reported."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The aim of this study was to report a case of granulomatosis with polyangiitis causing atlantoaxial instability."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "This is a case report."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT SAMPLE",
            "content": "A 45-year-old woman participated in this study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "OUTCOME MEASURES",
            "content": "The patient's pain and atlantoaxial instability were resolved."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A 45-year-old Caucasian woman with a large ulcerative lesion in her oropharynx initially presented with chronic sinusitis, pharyngitis, and severe odynophagia. Years after her original symptoms began, she developed neck pain radiating into her upper trapezial region and shoulders."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Atlantoaxial fusion was performed on the patient, resolving her neck, upper trapezial, and shoulder pain. She was diagnosed with granulomatosis with polyangiitis (formerly Wegener's granulomatosis) and treated with cyclophosphamide."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Granulomatosis with polyangiitis should be part of the working differential diagnosis for non-traumatic cervical spine injury. The atlantoaxial instability can be managed with stabilization, and the disease process itself can be treated with cyclophosphamide."
          }
        ]
      },
