      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE OF REVIEW",
          "content": "Procedural sedation has become the standard of care for managing pain and anxiety in children in the emergency department."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RECENT FINDINGS",
          "content": "Numerous articles have been published on pediatric procedural sedation with, however, little in-depth discussion of the pharmacodynamics and pharmacokinetics of the sedation agents utilized."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "We review the pharmacokinetics and pharmacodynamics of the pediatric procedural sedation pharmacopeia from a clinical perspective with emphasis on the practical implications for drug titration and dosing."
        }
      ]},
