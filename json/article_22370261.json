      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To examine longitudinal trajectories of perceived weight from adolescence to early adulthood by gender."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We analyzed 9 waves (1997-2005) of data from the National Longitudinal Survey of Youth (N = 8302) using Mplus."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Perceived overweight increased over time among girls and did not level off until 23 years of age. Blacks had a lower perceived weight for their actual weight and a slower rate of increase in perceived weight than did whites."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Intervention programs designed to prevent or reduce obesity should evaluate weight perceptions for both adolescents and young adults prior to implementing each intervention."
        }
      ]},
