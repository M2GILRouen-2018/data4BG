      "Abstract": {
        "CopyrightInformation": "Copyright 2010 Mosby, Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to determine if there is an association between violin playing and the presence of signs and symptoms of temporomandibular disorder (TMD)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "We studied a group of violinists in the Murcia region of Spain, who were examined for TMD. The results were compared with those from a random control group who did not play any musical instrument. The groups were matched by age and gender. Statistical analysis was carried out using SPSS 15.0 statistical software."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Compared with the control subjects, the violinists as a group had significantly more pain in maximum mouth opening (P < .005), parafunctional habits (P = .001), and occurrence of temporomandibular joint sounds (P < .005) as determined by chi-squared."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Violin playing appears to be a factor associated with TMD-related findings."
          }
        ]
      },
