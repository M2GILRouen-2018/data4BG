      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe a rare case of mucocele of the appendix that simulated a cystic image by pelvic ultrasound (US)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CASE",
          "content": "A patient with pelvic pain for two months and cystic image on the right ovary by US. After laparoscopy, the image showed a mucocele of the appendix. The patient underwent right colectomy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Mucocele may be a cause of pelvic pain and may simulate a cystic image on the right adnexa."
        }
      ]},
