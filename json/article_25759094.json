      "Abstract": {
        "CopyrightInformation": "© 2015 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "A qualitative study among Operation Enduring Freedom/Operation Iraqi Freedom (OEF/OIF) Soldiers was conducted to explore potential constructs underlying suicide according to the interpersonal-psychological theory of suicide (IPTS); these include burdensomeness, failed belonging, and acquired capability."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Qualitative semistructured interviews were conducted with 68 Soldiers at 3 months post-OEF/OIF deployment. Soldiers were asked about changes in their experiences of pain, burdensomeness, and lack of belonging. The methodology employed was descriptive phenomenological."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Transcripts were reviewed and themes related to the IPTS constructs emerged. Soldiers' postdeployment transition experiences included higher pain tolerance, chronic pain, emotional reactivity, emotional numbing and distancing, changes in physical functioning, combat guilt, discomfort with care seeking, and difficulties reintegrating into family and society."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Findings highlight the utility of the IPTS in understanding precursors to suicide associated with transition from deployment, as well as treatment strategies that may reduce risk in Soldiers during reintegration."
          }
        ]
      },
