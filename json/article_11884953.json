      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright 2002 by The American College of Veterinary Surgeons",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the analgesic effects of medetomidine (MED) and butorphanol (BTO) in cats after ovariohysterectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "A placebo-controlled, blinded monocenter clinical study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANIMALS",
            "content": "Healthy adult female client-owned cats."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Sixty-four cats weighing 3.15 +/- 0.6 kg, presented to the University of Helsinki's Small Animal Teaching Hospital for routine elective ovariohysterectomy, received MED at 15 microg/kg (n = 18), BTO at 0.1 mg/kg (n = 23), or saline (PL) (n = 23) intramuscularly immediately after ovariohysterectomy. Level of pain perception, degree of restlessness, and extent of sedation were scored subjectively before and at 30, 60, 90, and 120 minutes after test-drug administration."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "BTO provided the best pain relief, followed by MED. Saline provided the least pain relief. Both MED and BTO effectively and identically prevented postoperative restlessness. MED and BTO produced an identical degree of sedation that was better than the PL."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Both MED (at 15 microg/kg) and BTO (at 0.1 mg/kg) prevent postoperative pain in cats after ovariohysterectomy. Clinical Relevance-MED and BTO are useful for preventing postoperative pain in cats."
          }
        ]
      },
