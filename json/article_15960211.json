      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the use of diclofenac intramuscular single dose to decrease pain in post operative Caesarean section with none used."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "A double blind randomized controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Department of Obstetrics and Gynecology, Ranong Hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "Sixty-four patients who underwent post operative Caesarean section in Ranong Hospital from October 2003 to March 2004."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "The subjects were randomized by allocation to receive diclofenac intramuscular or placebo, both groups received morphine by Patient Controlled Analgesia (PCA)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Amount of morphine sulfate used, in both groups by Patient Controlled Analgesia (PCA) and level of pain using Visual Analog Score (VAscore)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Morphine was used significantly less in the group of patients who had diclofenac intramuscular single dose in post operative Caesarean section but the level of pain was not significantly different."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "A single dose of diclofenac intramuscularly decreases the use of morphine during the in post operative period of Caesarean section."
        }
      ]},
