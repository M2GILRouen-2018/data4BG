      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To define vulvodynia and to describe the main approaches to treatment."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIAL AND METHODS",
            "content": "Review of the literature concerning vulvodynia."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Vulvodynia is defined as chronic vulvar discomfort, usually with a burning nature, with no relevant clinical lesions and no clinically identifiable neurological lesion. Localized provoked vulvodynia essentially affects young women and is responsible for major sexual and psychological repercussions. Treatment consists of local anaesthetics, drugs used to treat neuropathic pain, physiotherapy and psychotherapy. Vestibulectomy is only very rarely indicated."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Many unknowns persist especially concerning the aetiology of vulvodynia. Evaluation of symptoms and treatment have not been clearly defined. However, symptomatic management provide satisfactory long-term results."
          }
        ]
      },
