      "Abstract": {
        "CopyrightInformation": "Copyright © 2017 Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The assessment of asthma control is based on objective measures: clinical, pharmacological and spirometry. However subjective component may be also necessary for assessing asthma control."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To study the feasibility and clinical value of the assessment of the quality of life of patients with asthma by the SF-36 (Medical Outcomes Study Short Form) and the possible existence of a correlation between controlled asthma and a better quality of life."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "A prospective study that included 167 patients with asthma in a stable condition. Control of asthma and SF-36 were established three months after the inclusion of patients."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The SF-36 was lower in the uncontrolled group in all areas of the physical component and the difference was significant in the \"limitation related to physical activity\" and \"perceived health\". In the mental component, the score was lower in \"mental health\" and the \"limitation due to mental state\" in the group with uncontrolled asthma and the difference was significant only in the limitation due to mental state (P=0.043)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The quality of life of asthmatic patients is correlated to the control of this disease."
          }
        ]
      },
