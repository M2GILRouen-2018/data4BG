      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American College of Allergy, Asthma & Immunology. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To review the methods and materials used for collection, purification, commercial production, and clinical application of Hymenoptera venoms."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DATA SOURCES",
            "content": "Most of the sources for this review are the experience and expertise of the authors. Published reports and review articles on Hymenoptera venom collection and production were identified through database searches (PubMed)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY SELECTIONS",
            "content": "Studies describing the methods for Hymenoptera venom collection and production were selected for review."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Meticulous methods for identification and collection of the insects are required. Collection and purification of the venoms from the insects are based on validated methods and result in a commercial extract that is standardized for the major allergenic proteins required for accurate diagnosis and safe and effective treatment of patients allergic to insect sting. The steps required for mixing, purifying, testing, and standardizing the products are described."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Hymenoptera venom extracts were developed using many new methods for the collection, purification, and commercial production of the unique materials required for this product. Clinical applications for diagnosis and treatment are affected by the integrity and stability of the allergens after processing and purification."
          }
        ]
      },
