      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the short-term efficacy of transregional interferential current therapy on pain perception and disability level in chronic non-specific low back pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A randomized, single-blinded (the assessor collecting the outcome data was blinded), controlled trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A private physiotherapy research clinic."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "A total of 64 individuals, 20 men and 44 women, mean (SD) age was 51\u2009years (11.93), with low back pain of more than three months, with or without pain radiating to the lower extremities above the knee, were distributed into a control ( n\u2009=\u200920) or an experimental group ( n\u2009=\u200944). A 2:1 randomization ratio was used in favour of the latter."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "A transregional interferential current electrotherapy protocol was performed for participants in the experimental group, while the control group underwent a 'usual care' treatment (massage, mobilization and soft-tissue techniques). All subjects received up to 10 treatment sessions of 25\u2009minutes over a two-week period, and completed the intervention and follow-up evaluations."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Self-perceived pain was assessed with a Visual Analogue Scale. Secondary measure included the Oswestry Low Back Disability Index. Evaluations were collected at baseline and after the intervention protocol."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Significant between-group differences were found for interferential current therapy on pain perception ( p\u2009=\u20090.032) and disability level ( p\u2009=\u20090.002). The observed differences in the between-group mean changes were of 11.34\u2009mm (1.77/20.91) and 13.38 points (4.97/21.78), respectively."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "A two-week transregional interferential current treatment has shown significant short-term efficacy, when compared with a 'usual care' protocol, on self-perceived pain and functionality in subjects with chronic low back pain."
        }
      ]},
