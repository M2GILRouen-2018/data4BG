      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To establish the analgesic effective doses as defined as a visual analog pain scale (VAS) of at least 10 for 95% of parturients (ED95) receiving either epidural fentanyl or sufentanil with bupivacaine 0.125% for labor analgesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Double-blind, randomized controlled study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Two tertiary-care teaching hospitals."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "100 female patients, at full-term pregnancy, in active early labor (< 5 cm cervical dilation) and requesting obstetric anesthesia services for labor analgesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients were randomized and equally distributed to receive one of ten epidural dosing regimens of bupivacaine 0.125% alone or with either fentanyl 25, 50, 75, or 100 micrograms or sufentanil 5, 10, 15, 20, or 25 micrograms in a 10-ml bolus after a 3-ml test dose of bupivacaine 0.25%."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "VAS scores were obtained from each parturient using a 10-cm plastic VAS slide rule at times 0, 1, 5, 10, 15, 20, 25, and 30 minutes, and then again when the patient requested additional analgesia. Analgesic duration and demographic and obstetric data also were obtained. Using a log-probit dose-response analysis, analgesic success as defined as a VAS of at least 10 with each opioid dose was plotted and an ED95 value of 8 micrograms and 50 micrograms was established for sufentanil and fentanyl, respectively, in bupivacaine 0.125%. No statistical difference was detected for analgesic duration or incidence of side effects between analgesic groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Epidural analgesia with fentanyl and sufentanil in bupivacaine 0.125% behaves in a dose-response fashion allowing for the determination of equipotent dose of each."
        }
      ]},
