      "Abstract": {
        "CopyrightInformation": "© 2014 The Obesity Society.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The degree of subclinical coronary atherosclerosis detected by coronary multidetector computed tomography (MDCT) in four groups defined by the state of metabolic health and obesity in an asymptomatic Korean population was compared."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The data of 4009 asymptomatic subjects who participated in a routine health screening examination were collected. Significant coronary artery stenosis defined as >50% stenosis, plaque, and coronary artery calcium scores (CACS) were assessed by MDCT. Participants were stratified by BMI (cut-off value, 25 kg/m(2) ) and metabolically healthy state, which was defined by Wildman criteria."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Metabolically healthy obese (MHO) subjects had a significantly higher prevalence of significant subclinical coronary atherosclerotic burden compared with metabolically healthy nonobese (MHNO) subjects. The adjusted odds ratios of the MHO group for various coronary MDCT findings (MHNO group as the reference), such as coronary artery stenosis, any plaque, calcified plaque, mixed plaque, CACS > 0, and CACS > 100, were 1.87 (95% CI 1.15-3.03), 1.31 (1.01-1.71), 1.40 (1.05-1.86), 1.57 (1.01-2.48), 1.38 (1.04-1.82), and 1.69 (1.03-2.78), respectively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our data illustrate that MHO subjects have substantial subclinical coronary atherosclerotic burden. Thus, it is important to consider the metabolic health state and obesity in evaluating cardiovascular risk."
          }
        ]
      },
