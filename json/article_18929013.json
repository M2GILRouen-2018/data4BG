      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To quantify the preventive effect of a neutral functional realignment orthosis on pain, mobility, and edema of the hand in subacute hemiparetic poststroke patients with severe motor deficits."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Randomized trial."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Rehabilitation center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Poststroke patients (N=30) with subacute hemiparesis and severe deficits of the upper limb were enrolled. Fifteen patients were randomized to a standard rehabilitation program without orthosis and 15 patients received an experimental orthosis in addition to their standard rehabilitation program."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "The orthosis group wore the neutral functional realignment orthosis for at least 6 hours daily."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Hand pain at rest (visual analog scale), wrist range of motion (Fugl-Meyer Assessment subscale), and edema of hand and wrist (circumferences). Outcome measures were assessed at time of randomization and after 13 weeks between groups."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "At baseline, 2 patients in each group complained about a painful hand. After 13 weeks, 8 subjects in the control group and 1 subject in the orthosis group complained of hand pain (P=.004). Mobility and edema evolved similarly in both groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Neutral functional realignment orthoses have a preventive effect on poststroke hand pain, but not on mobility and edema in the subacute phase of recovery."
        }
      ]},
