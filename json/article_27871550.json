      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "STUDY OBJECTIVE",
            "content": "The aim of the study was to compare the incidence of the use of additional uterotonics before and after the change of carbetocin to oxytocin for the prevention of postpartum hemorrhage after cesarean delivery in women with severe preeclampsia."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "This was an observational retrospective before-and-after study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Operating room, postoperative recovery area."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "Sixty women with severe preeclampsia undergoing cesarean delivery under spinal anesthesia; American Society of Anesthesiologists 3."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTIONS",
            "content": "Observational study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASUREMENTS",
            "content": "Blood pressure, heart rate, and biological data (hemoglobin, platelets, haptoglobin, prothrombin time index, activated partial thromboplastin time ratio, blood uric acid, aspartate aminotransferase, alanine aminotransferase, serum urea, serum creatinine, and albumin)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "MAIN RESULTS",
            "content": "The incidence of additional uterotonic administration in the carbetocin and oxytocin groups was 15% and 10%, respectively (P=.70)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "As carbetocin appears to be as effective and safe as oxytocin in preeclamptic women, its advantages make it a good uterotonic option in this particular setting."
          }
        ]
      },
