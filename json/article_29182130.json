      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "Correlation of Pirani score and Foot bimalleolar (FBM) angle in the treatment of idiopathic congenital talipes equino varus (CTEV) by Ponseti method in infants."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "35 feet with idiopathic CTEV deformity <1 year were prospectively treated by Ponseti method. Deformity evaluated each successive week of treatment by Pirani score and FBM angle. Feet were divided according to Pirani score in groups\u202f: one(0-2.0), two(2.5-4) and three(4.5-6). Correlation between mean Pirani score and mean FBM angle was evaluated every week and at follow up, firstly by using Pearson's and Spearman's correlation and then, after dividing data in groups by using ANOVA."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Correlation between Pirani score and FBM angle was statistically significant(p value <0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Pirani score decreases and FBM angle increases with correction. Pirani score and FBM angle correlated in severity of deformity and correction achieved, thus FBM angle provides objective evidence of clubfoot deformity/improvement/deterioration."
        }
      ]},
