      "Abstract": {
        "CopyrightInformation": "Copyright © 2013 American Congress of Rehabilitation Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the therapeutic effectiveness of trigger point injection into the muscles around the groin in patients with clinically diagnosed chronic prostatitis/chronic pelvic pain syndrome (CP/CPPS)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, unicenter trial."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "University rehabilitation hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Patients (N=21) with clinically diagnosed CP/CPPS who are suspected of having myofascial pain syndrome."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Ultrasound-guided trigger point injection."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Visual analog scale (VAS), National Institutes of Health Chronic Prostatitis Symptom Index (NIH-CPSI) score, and injection-associated complications."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Ultrasound (US)-guided trigger point injection of the iliopsoas, hip adductor, and lower abdominal muscles resulted in excellent outcomes. The mean values of the NIH-CPSI score decreased significantly from 20.2 pretreatment to 12.5 after the first treatment (P<.05). The mean values of VAS decreased significantly from 6.3 pretreatment to 2.9 after the first treatment (P<.05)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In patients with CP/CPPS, US-guided trigger point injections of the iliopsoas, hip adductor, and abdominal muscles are safe and effective for both diagnosis and treatment when the cause of groin pain is suspected to originate from muscles. In particular, the iliopsoas muscle was affected in all patients in this study."
          }
        ]
      },
