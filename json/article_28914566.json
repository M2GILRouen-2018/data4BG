      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM OF THE STUDY",
          "content": "To report a novel mutation in the electron transfer flavoprotein dehydrogenase (ETFDH) gene in an adult patient with late-onset riboflavin-responsive multiple acyl-CoA dehydrogenase deficiency."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "The genomic DNAs from a patient whose main clinical presentations are muscles weakness and hypoglycemia was analysed."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The patient was identified to carry compound heterozygous mutations in ETFDH gene. Two missense mutations c.814 G > A and c.389 A > T were found."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "This is the first report of c.814G > A mutation in ETFDH in adult patient with MADD."
        }
      ]},
