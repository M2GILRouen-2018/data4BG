      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "The gut microbiota is modulated by metabolic derangements, such as nutrition overload and obesity."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "The aim of this systematic review is to summarize the role of these gut modifiers in nonalcoholic fatty liver disease (NAFLD) and obesity."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A systematic search of MEDLINE (from 1946), PubMed (from 1946) and EMBASE (from 1949) databases through May 2014 was carried out to identify relevant articles. The search terms were 'probiotic' AND 'NAFLD', 'prebiotic' AND 'NAFLD', 'antibiotic' AND 'NAFLD', 'probiotics' AND 'obesity', 'prebiotic' AND 'obesity' or 'antibiotic' AND 'obesity'; these terms were searched as text word in 'clinical trials' and as exploded medical subject headings where possible."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The evidence in the literature is scant, due to the scarcity of appropriately powered, randomized, controlled clinical trials, involving various centers and population of different origin."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Although probiotics and prebiotics have been proposed in the treatment and prevention of patients with obesity-related NAFLD, their therapeutic use is not supported by high-quality clinical studies."
        }
      ]},
