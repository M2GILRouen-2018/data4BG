      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Tissue Viability Society. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Plantar callosities are a common cause of pain in the forefoot and also a cause of alterations in plantar pressure. Mechanical debridement with a scalpel can relieve pain and increase functional capacity."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of the study was to analyse if debridement of plantar callosities and corns modify walking."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Thirty four patients with plantar foot pain due to callosities and corns, and up to 5 in the visual analogical scale (VAS) of pain, (20 women, age 29 ± 11.57 years) were analysed by taking into account the changes of their gait. The outcome measurement was the VAS scale and the Win-track system, cycle of the gait(milliseconds), angle(degrees), cadence(number/minutes) and step(centimetres) were measured, 24 h before and after the debridement with a scalpel."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There were significant differences in foot pain (mean 67.7, p < 0.001) but there were no significant differences in measures of gait variables before the debridement of the callosities, and 24 h after the procedure, being all those above 0.05."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our study shows that the debridement with scalpel does not change the variables of the gait 24 h after the procedure."
          }
        ]
      },
