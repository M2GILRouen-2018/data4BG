      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To explore the relationship between the asthmatic Uyghur patients with abnormal Savda in Xinjiang and the gene polymorphism of interleukin-4 (IL-4)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Totally 76 asthmatic patients were syndrome typed according to the body fluid theory of Uyghur medicine. Among them, there were 30 asthmatic patients with abnormal Savda and 46 asthmatic patients without abnormal Savda. A comparison study was performed in 89 healthy individuals (as the healthy control group). The gene polymorphism of IL-4 promoter area-589 (C/T) site were detected by using PCR-RFLP."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The distribution rate of genotype CT in asthmatic patients with abnormal Savda was significantly higher than that of the asthmatic patients with non-abnormal Savda and the healthy control group (P < 0.01). The distribution rate of genotype CT in asthmatic patients with non-abnormal Savda group was significantly higher than that of the healthy control group (P < 0.05). There was no difference in the distribution frequency of genotype CC or TT, or in the distribution frequency of allele C and T among the three groups (P > 0.05)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Asthma in Uyghur patients with abnormal Savda in Xinjiang might be correlated to the gene polymorphism of IL-4 promoter area-589 (C/T)."
        }
      ]},
