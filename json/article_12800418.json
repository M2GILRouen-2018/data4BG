      "Language": "chi",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate the therapeutic mechanism of Jiawei Mojie Tablet (JMT) in treating primary dysmenorrhea (PD) by observing its effect on plasma oxytocin (OT) level in patients in menstrual period."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Sixty-three patients with PD enrolled in the study were randomly divided into the JMT group (n = 33) and the control Group (n = 30, treated with Yueyueshu Granule) to observe the change of OT level in the menstrual period before and after treatment."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "OT level in patients with PD was obviously higher than that in healthy subjects (P < 0.01), and was positively correlated with the degree of pain (r = 0.738, P < 0.01). OT level reduced significantly after treatment (P < 0.01), the reduction was more significant in the JMT group than that in the control group (P < 0.01)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "JMT could reduce the OT level in menstrual period."
        }
      ]},
