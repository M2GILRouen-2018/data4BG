      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "The aim of this study was to investigate the fatty acid (FA) pattern in breast milk of obese mothers and their neonates' plasma compared to those of normal weight mothers."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS AND METHODS",
            "content": "This was an observational study of 41 obese and 41 normal weight pregnant women. Twenty-nine obese women participating in a weight reduction program were investigated for comparison. FAs were analyzed in breast milk collected at 3 and 10 days and one and two months postnatally and in infant's plasma 3 days after birth."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "RESULTS AND CONCLUSIONS",
            "content": "The concentration of long-chain n-3 FA were lower and the ratio n-6/n-3 FA higher in neonates and in consecutive samples of breast milk of obese mothers compared to normal weight mothers. The obese mothers that participated in an intervention program with general dietary advice had FA concentrations approaching that of the normal-weight mothers. The study indicates importance of dietary advice in pregnancy."
          }
        ]
      },
