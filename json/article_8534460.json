      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To determine the immediate effect of epidural blood patch (EBP) on the hearing loss that can accompany postdural puncture headache (PDPH)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective open study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Anesthetic and otolaryngologic departments at a university hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SUBJECTS",
          "content": "16 patients who developed severe PDPH following either myelography or spinal anesthesia."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Epidural injection of 15 ml of autologous blood."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "Audiometry at 250, 500, 1,000, 2,000, 4,000, and 8,000 Hz before and one hour after the epidural blood patch was performed. Hearing was significantly improved in 12 of the 16 patients studied. The improvement was at least 10 dB at two or more consecutive frequencies, or 5 dB at four or more consecutive frequencies."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Epidural blood patch improves hearing within one hour in the majority of patients with severe PDPH."
        }
      ]},
