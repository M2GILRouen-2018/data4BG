      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Individuals with lower limb amputation (LLA) commonly experience low back pain (LBP). Although massage effects on LBP are well-documented, research regarding massage for individuals with LLA is scarce."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "This study evaluated the effectiveness of massage therapy to promote activity level, decrease LBP, and improve health-related quality of life (HRQOL) in a long-term prosthetic user."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The 50-day study consisted of two baseline sessions, seven treatment sessions that included a 50-min massage applied to major gait muscles, and two follow-up sessions. Pedometer-measured ambulatory activity level, visual analog scale-measured pain level, and RAND-36 Health Survey 1.0-determined HRQOL were assessed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Pain level decreased, HRQOL increased, and no change occurred in ambulatory activity level."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "For the participant, therapeutic massage intervention lead to successful LBP symptom management."
          }
        ]
      },
