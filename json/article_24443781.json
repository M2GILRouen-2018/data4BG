      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2016.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "We assessed public support for required water access in schools and parks and perceived safety and taste of water in these settings to inform efforts to increase access to and consumption of tap water."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional survey of the US public collected from August to November 2011."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Random digit-dialed telephone survey."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "Participants (n = 1218) aged 17 and older from 1055 US counties in 46 states."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MEASURES",
            "content": "Perceived safety and taste of water in schools and parks as well as support for required access to water in these settings."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Survey-adjusted perceived safety and taste as well as support for required access were estimated."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was broad support for required access to water throughout the day in schools (96%) and parks (89%). Few participants believed water was unsafe in schools (10%) or parks (18%)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This study provides evidence of public support for efforts to increase access to drinking water in schools and parks and documents overall high levels of perceived taste and safety of water provided in these settings."
          }
        ]
      },
