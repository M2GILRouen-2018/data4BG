      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "Reduction of burden insufficiency."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INDICATION",
          "content": "Chronic lateral epicondylitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CONTRAINDICATIONS",
          "content": "Acute infection in the surgical area. C6/7 nerve root and plexus irritation. Frohse Arcade syndrome. Posterolateral rotatory instability."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SURGICAL TECHNIQUE",
          "content": "Incision slightly cranial to the radial epicondyle. Identification of the extensor carpi radial brevis tendon (ERCB) and longus (ECRL). Mobilisation of the ECRL tendon, identification of degenerative tendons of the ECRB. Excision of degenerative tissue. Drill holes in the area of the smoothed radial epicondyle, thermal denervation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "POSTOPERATIVE MANAGEMENT",
          "content": "Arm plaster splint for 14 days. Unrestricted activity after 4-6 weeks. Maximum loading after 6 months."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Of the 24 consecutively operated patients, 83.3\u2009% were included. High patient satisfaction. Nirschl tennis and elbow score improved from 35 to 75 points postoperatively. Pain levels decreased from 6.8 to 1.4 points postoperatively."
        }
      ]},
