      "Abstract": {
        "CopyrightInformation": "Copyright 2002 by the American Congress of Rehabilitation Medicine and the American Academy of Physical Medicine and Rehabilitation",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the association of aerobic fitness (VO(2)max) with pain intensity as reported by a sample of patients with chronic low back pain (LBP)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Cross-sectional with partial longitudinal follow-up."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Outpatient interdisciplinary pain management program in a teaching hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENTS",
            "content": "A convenience sample of 75 patients with chronic LBP."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Patients reported pain intensity before and after undergoing a modified treadmill test. Peak VO(2) was measured by using indirect calorimetry. Predicted VO(2)max was determined by extrapolating peak VO(2) and heart rate values during testing to predicted maximal heart rate."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Aerobic fitness and pain intensity before and after testing."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No significant relation was found between pain intensity and predicted VO(2)max or aerobic fitness."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "There is no association between pain intensity and aerobic fitness. Deconditioning, defined as a lack of cardiovascular fitness levels normal for age and gender, therefore does not contribute to pain intensity in patients with chronic LBP."
          }
        ]
      },
