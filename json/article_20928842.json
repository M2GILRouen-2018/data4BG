      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2010 Wiley-Liss, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "The aims of this study were to identify the efficacy of optimal stent expansion (OSE) according to the Multicenter Ultrasound Stenting in Coronaries Study (MUSIC Study) criteria in drug-eluting stent (DES) and compare paclitaxel-eluting stent (PES) to sirolimus-eluting stent (SES)."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Although poststent high-pressure balloon dilatation is proposed after bare metal stent implantation according to OSE, defined by the criteria of the MUSIC Study, very little data are available in DES."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Two hundred fifty patients (M:F = 149:101; age, 61.5 ± 9.2 years) who underwent 9-month follow-up angiography in the Poststent Optimal Stent Expansion Trial (POET) were included in this study. We assessed angiographic in-stent restenosis (ISR) and neointima volume (NV) using IVUS at 9 months."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "At 9-month follow up, there were no significant differences in ISR and NV index (NV/stent length, mm(2) ) between patients with and without OSE. However, the rate of ISR and NV index were higher in PES [ISR: 18 (13.7%) and 4 (3.4%), P = 0.004; NV index: 1.02 ± 0.99 mm(2) and 0.21 ± 0.37, P < 0.001 in PES and SES]."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "OSE according to the MUSIC Study criteria was not related to ISR and NV in the DES era but PES had a significantly higher ISR rate and NV than SES after poststent high-pressure balloon dilatation."
          }
        ]
      },
