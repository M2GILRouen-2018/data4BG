      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "CONTEXT",
          "content": "Cardiac surgery."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare plasma and urinary neutrophil gelatinase-associated lipocalin (P-/U-NGAL) in on-pump (n\u2009=\u200943) versus off-pump (n\u2009=\u200940) surgery."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "We obtained perioperative P-/U-NGAL and outcome data."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "P-/U-NGAL increased after surgery. P-NGAL was higher post-surgery in on pump patients (139 versus 67\u2009µg L(-1); p\u2009<\u20090.001), but not at 24\u2009h. There were no differences in U-NGAL. Correlation between P-/U-NGAL and plasma creatinine was weak."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "P-NGAL acts like a neutrophil activation biomarker and U-NGAL like a tubular injury marker."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "On-pump patients had greater neutrophil activation. On- versus off-pump surgery had similar impact on tubular cells."
        }
      ]},
