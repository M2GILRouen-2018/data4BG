      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 Elsevier España, S.L. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To evaluate the effectiveness of a joint team intervention between primary care (PC) and mental health (MH) to improve information on cardiovascular risk factors (CVRF) in psychotic patients."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Multicenter before-after intervention study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "LOCATION",
            "content": "Seven primary care and 2 mental health centers in Barcelona participated."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PARTICIPANTS",
            "content": "All patients between 18-65 years old with a confirmed diagnosis of psychosis assigned to PC teams (n = 690) are included."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION",
            "content": "Shared clinical sessions, developing a joint GP-MH protocol and implement it."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PRIMARY MEASUREMENTS"
          },
          {
            "NlmCategory": "METHODS",
            "Label": "VARIABLES",
            "content": "Gender, age, number of Appointments per center/year, smoking, blood pressure, body mass index (BMI), total cholesterol, HDL cholesterol, triglycerides, glucose, waist circumference (WC), Cardiovascular Risk."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "ANALYSIS",
            "content": "Comparison of CVRF records from 2008 to 2010 using statistical tests for paired data. Calculation of CVRF prevalence in accordance with metabolic syndrome criteria and the criteria for referral to GP."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The mean age was 42.3 (SD 11.4) years, with 67% males. All CVRF significantly Increased in clinical notes, particularly all blood test parameters and WC. More than 35% of patients had a CVRF according to metabolic syndrome criteria. Criteria to refer to PC physician (2010) identified: obesity 51.9%, 23.9% hypertension, high cholesterol 20.4% and 11.6% diabetes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "CVRF recording improvement. High percentage of patients needed GP intervention due to a CVRF."
          }
        ]
      },
