      "Language": "spa",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Chronic airway inflammation is a central process in asthma. Measurement of exhaled nitric oxide (eNO) is a non-invasive biomarker of eosinophilic airway inflammation."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To measure eNO levels in a population of asthmatic and non-asthmatic children and to evaluate their relationship with asthma and atopy."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIAL AND METHODS",
          "content": "We studied 143 asthmatic and non-asthmatic children aged 6 to 14 years attended a hospital and primary health service. Participants were tested for allergies and followed during the winter months of 2010 and 2011. They were visited regularly at their homes and eNO levels were measured on each visit using a handheld equipment. Mean eNO distribution were compared by the presence of asthma or atopy using t-test and regression models."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "No significant differences for mean eNO levels were detected, according to presence of asthma or atopy, by any of the statistical methods used. Regression models showed significant effects for age but not for sex."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "There were no differences in eNO levels in the studied children by the presence of asthma or atopy."
        }
      ]},
