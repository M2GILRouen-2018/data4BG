      "Abstract": {
        "CopyrightInformation": "©2014 Foundation Acta Paediatrica. Published by John Wiley & Sons Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "Childhood obesity is now an established public health problem in most developed countries, and there is concern about a parallel increase of type 2 diabetes. The aim of this study was to estimate the prevalence of undiagnosed type 2 diabetes in overweight Swedish school children from 11 to 13 years of age."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Body mass index (BMI) was measured in 5528 schoolchildren in the 6th grade, from 11 to 13 years of age, in five different regions in Sweden. Overweight was defined by international age- and sex-specific BMI cut-offs, corresponding to adult BMI cut-offs of 25 kg/m(2) at 18 years of age (ISO-BMI ≥25, n = 1275). Haemoglobin A1c (HbA1c) was measured in 1126 children with ISO-BMI ≥25. Children with a Diabetes Control and Complications Trial aligned HbA1c ≥6.1% on two occasions underwent an oral glucose tolerance test (OGTT) to establish the diabetes diagnosis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 1126 children with ISO-BMI ≥25, 24 (2.1%) had at least one HbA1c value ≥6.1%. Three of them had HbA1c ≥6.1% on two occasions, and all of them had a normal OGTT."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "In this cross-sectional, population-based screening study of a high-risk group of 11- to 13-year-old Swedish school children, we found no indication of undiagnosed diabetes or impaired glucose tolerance."
          }
        ]
      },
