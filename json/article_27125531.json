      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 American Academy of Dermatology, Inc. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Guided imagery and music can reportedly reduce pain and anxiety during surgery, but no comparative study has been performed for cutaneous surgery to our knowledge."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "We sought to determine whether short-contact recorded guided imagery or relaxing music could reduce patient pain and anxiety, and surgeon anxiety, during cutaneous surgical procedures."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Subjects were adults undergoing excisional surgery for basal and squamous cell carcinoma. Randomization was to guided imagery (n = 50), relaxing music (n = 54), or control group (n = 51). Primary outcomes were pain and anxiety measured using visual analog scale and 6-item short-form of the State-Trait Anxiety Inventory, respectively. Secondary outcomes were anxiety of surgeons measured by the 6-item short-form of the State-Trait Anxiety Inventory and physical stress of patients conveyed by vital signs, respectively."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There were no significant differences in subjects' pain, anxiety, blood pressure, and pulse rate across groups. In the recorded guided imagery and the relaxing music group, surgeon anxiety was significantly lower than in the control group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "LIMITATIONS",
            "content": "Patients could not be blinded."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Short-contact recorded guided imagery and relaxing music appear not to reduce patient pain and anxiety during excisional procedures under local anesthetic. However, surgeon anxiety may be reduced when patients are listening to such recordings."
          }
        ]
      },
