      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Vertebral fractures and fibromyalgia, while very different and unrelated clinical conditions, are common pain conditions that can, at times, be difficult to diagnose and manage."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To discuss the investigation and treatment of two common pain conditions."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "DISCUSSION",
          "content": "Following a structured program for assessment and treatment, most people with both of these conditions can experience substantial improvement in the quality of their life."
        }
