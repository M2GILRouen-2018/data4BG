      "Abstract": {
        "CopyrightInformation": "© 2017 Royal College of Obstetricians and Gynaecologists.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "We sought to classify causes of stillbirth for six low-middle-income countries using a prospectively defined algorithm."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Prospective, observational study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Communities in India, Pakistan, Guatemala, Democratic Republic of Congo, Zambia and Kenya."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "POPULATION",
            "content": "Pregnant women residing in defined study regions."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Basic data regarding conditions present during pregnancy and delivery were collected. Using these data, a computer-based hierarchal algorithm assigned cause of stillbirth. Causes included birth trauma, congenital anomaly, infection, asphyxia, and preterm birth, based on existing cause of death classifications and included contributing maternal conditions."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Primary cause of stillbirth."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Of 109 911 women who were enrolled and delivered (99% of those screened in pregnancy), 2847 had a stillbirth (a rate of 27.2 per 1000 births). Asphyxia was the cause of 46.6% of the stillbirths, followed by infection (20.8%), congenital anomalies (8.4%) and prematurity (6.6%). Among those caused by asphyxia, 38% had prolonged or obstructed labour, 19% antepartum haemorrhage and 18% pre-eclampsia/eclampsia. About two-thirds (67.4%) of the stillbirths did not have signs of maceration."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Our algorithm determined cause of stillbirth from basic data obtained from lay-health providers. The major cause of stillbirth was fetal asphyxia associated with prolonged or obstructed labour, pre-eclampsia and antepartum haemorrhage. In the African sites, infection also was an important contributor to stillbirth. Using this algorithm, we documented cause of stillbirth and its trends to inform public health programs, using consistency, transparency, and comparability across time or regions with minimal burden on the healthcare system."
          },
          {
            "NlmCategory": "UNASSIGNED",
            "Label": "TWEETABLE ABSTRACT",
            "content": "Major causes of stillbirth are asphyxia, pre-eclampsia and haemorrhage. Infections are important in Africa."
          }
        ]
      },
