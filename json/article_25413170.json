      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2014.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To determine the effectiveness of an Early Rehabilitation Intervention (ERI ) versus a Brief Education Intervention (BEI) following road trauma."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PRIMARY OBJECTIVE",
            "content": "return to work or usual activities at 12 weeks (for minor/moderate injury) and 24 weeks for major injury."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "SECONDARY OBJECTIVES",
            "content": "Reduction in pain, anxiety, depression, disability and incidence of Post Traumatic Stress Disorder and improved quality of life."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "A multi-site single-blinded stratified randomized clinical trial (RCT)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "184 patients (92 in each arm) were recruited over 18 months and followed for 12 weeks (minor/moderate injury) and 24 weeks (major injury). Screening questionnaires at 2-4 weeks and follow-up interviews by phone for all outcome measures were undertaken. For those in the ERI group with a positive screen for high risk of persistent symptoms, an early assessment and intervention by a Rehabilitation Physician was offered. Those in the BEI group were sent written information and advised to see their GP."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "89.4% of injuries were mild in this cohort. At 12 weeks 73.8% and 69.1% of patients in the ERI and the BEI groups respectively had returned to work or usual activities. There were no significant differences between the two intervention groups with respect to the primary or any secondary outcome measures."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "This is the first RCT of an ERI following road trauma in Australia. A targeted ERI is as effective as a BEI in assisting those with mild/moderate trauma to return to work or usual activities."
          }
        ]
      },
