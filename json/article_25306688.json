      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "We studied 90 patients with radicular acute pain syndrome of lumbosacral localizations in the Petrovsky Russian Research Center of Surgery from 2009 to 2013. The patients were divided into two groups. We assessed an effectiveness of epidural blockades in complex therapy."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The treatment of radicular pain syndrome with intensity over 5 points according to visual analog scale should be started with epidural blockade with local anesthetics and small doses of steroids."
        }
      ]},
