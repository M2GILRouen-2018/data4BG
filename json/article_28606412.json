      "Abstract": {
        "CopyrightInformation": "Copyright © 2017. Published by Elsevier Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To present a case with visual images of an aortic dissection with aneurysmal degeneration."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A case report was described of a patient presenting to the emergency department with back pain. An aortic dissection with aneurysmal degeneration was rapidly identified with bedside ultrasound in the emergency department."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "An aortic dissection was detected rapidly by emergency physician preformed bedside ultrasound. This led to rapid identification and treatment CONCLUSION: Rapid bedside emergency ultrasound can quickly and accurately diagnosis an aortic dissection and lead to rapid treatment."
          }
        ]
      },
