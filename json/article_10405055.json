      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "STUDY OBJECTIVE",
          "content": "To evaluate the effect of epidural and pethidine analgesia on the frequency of uterine contractions during the first stage of labor."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Retrospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Delivery ward of a public hospital."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Forty consecutive parturients."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "MEASUREMENTS AND MAIN RESULTS",
          "content": "The mean number of contractions in the 30 min before administration of pethidine analgesia was 8.2+/-1.7 as compared to 8.7+/-1.3 after administration of the analgesia. The mean number of contractions in the 30 min before administration of epidural analgesia was 8.0+/-1.4 as compared to 8.8+/-1.9 after administration of the analgesia. The differences between the two groups and between the number of contractions before and after the administration of both types of analgesia were not statistically significant."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Properly and timely administered epidural analgesia during the first stage of labor has no effect on frequency of uterine activity."
        }
      ]},
