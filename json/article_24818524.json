      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Sociedade Brasileira de Pediatria. Published by Elsevier Editora Ltda. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate the association between 3111T/C polymorphism of the CLOCK gene and the presence of obesity and sleep duration in children aged 6-13 years. In adults, this genetic variant has been associated with duration of sleep, ghrelin levels, weight, and eating habits. Although short sleep duration has been linked to obesity in children, no study has aimed to identify the possible molecular mechanisms of this association to date."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Weight, height, and circumferences were transformed into Z-scores for age and gender. Genotyping was performed using TaqMan methodology. A questionnaire regarding hours of sleep was provided to parents. The appropriate statistical tests were performed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "This study evaluated 370 children (45% males, 55% females, mean age 8.5 ± 1.5 years). The prevalence of overweight was 18%. The duration of sleep was, on average, 9.7hours, and was inversely related to age (p<0.001). Genotype distribution was: 4% CC, 31% CT, and 65% TT. There was a trend toward higher prevalence of overweight in children who slept less than nine hours (23%) when compared to those who slept more than ten hours (16%, p=0.06). Genotype was not significantly correlated to any of the assessed outcomes."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The CLOCK 3111T/C polymorphism was not significantly associated with overweight or sleep duration in children in this city."
          }
        ]
      },
