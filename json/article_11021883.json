      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To assess the incidence of prognostically important myocardial damage in patients with chest pain discharged from the emergency department."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective observational study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "District general hospital emergency department."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "110 patients presenting with chest pain of unknown cause who were subsequently discharged home after cardiac causes of chest pain were ruled out by clinical and electrocardiographic investigation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTIONS",
          "content": "Patients were reviewed 12-48 hours after presentation by repeat electrocardiography and measurement of cardiac troponin T."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURES",
          "content": "Incidence of missed myocardial damage."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Eight (7%) patients had detectable cardiac troponin T on review and seven had concentrations >/=0.1 microg/l. The repeat electrocardiogram showed no abnormality in any patient."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "6% of the patients discharged from the emergency department had missed prognostically important myocardial damage. Follow up measurement of cardiac troponin T allows convenient audit of clinical performance in the emergency department."
        }
      ]},
