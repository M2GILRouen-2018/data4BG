      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the prevalence of Prader-Willi syndrome (PWS) in infants with hypotonia between the ages of 0 and 2 years."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "Karyotyping studies were performed in all infants with hypotonia. The study group was composed of infants with hypotonia for whom the karyotyping was found to be normal. Fluorescence in situ hybridization and methylation analysis were performed simultaneously in the study group. Molecular studies for uniparental disomy were undertaken in the patients without deletions with an abnormal methylation pattern."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Sixty-five infants with hypotonia with a mean age of 8 months were enrolled. A deletion was detected in 6 patients by fluorescence in situ hybridization analysis. Only 1 patient had no deletion but had an abnormal methylation pattern. A maternal uniparental disomy was observed in this patient. PWS was diagnosed in 10.7 % (7/65) of the infants with hypotonia."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The prevalence of PWS syndrome is high among infants with hypotonia. PWS should be considered by pediatricians and neonatologists in the differential diagnosis of all newborns with hypotonia. Early diagnosis of PWS is important for the management of these patients."
          }
        ]
      },
