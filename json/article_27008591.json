      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To determine: (i) the prevalence of opioid-naïve patients discharged on opioids from a musculoskeletal rehabilitation inpatient unit; (ii) the prevalence of opioid use 6 months after discharge; and (iii) the efficacy of the Opioid Risk Tool in identifying long-term opioid use."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Prospective study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Sixty-four opioid-naïve patients who were exposed to opioids during admission and who were discharged on an opioid."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Potentially eligible patients' charts were reviewed. Participants were interviewed during admission to obtain the opioid risk score and contacted 6 months after discharge via a semi-structured telephone interview."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Twenty-eight percent of opioid-naïve patients, who were discharged on opioids were still using opioids 6 months after discharge from rehabilitation. There was a trend for higher Opioid Risk Tool scores in those still using opioids than in individuals who were not using opioids at 6 months (p\u2009=\u20090.053)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Patients who are prescribed opioids during a hospital admission should be screened for risk of opioid misuse. This data suggests that the Opioid Risk Tool could identify a patient's potential for becoming a long-term user of opioids."
        }
      ]},
