      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To discuss the diagnosis and management of a Salter-Harris type II fracture in a nine-year-old girl who was managed conservatively."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "CLINICAL FEATURES",
          "content": "A nine-year-old girl fell while playing in bare feet in the grass. She experienced pain when she walked or moved her toe. There was minor swelling and bruising."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "INTERVENTION AND OUTCOME",
          "content": "Plain film radiographs revealed a Salter-Harris type II fracture of the 2(nd) proximal phalanx. Her toe was stabilized and she was referred to an orthopedist. Orthopedic management involved a taping procedure. After three weeks, her fracture healed and she was pain free."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "Chiropractors may consider radiography of post-traumatic injury sites even with equivocal examination findings despite histories suggesting seemingly innocuous mechanisms of injury."
        }
      ]},
