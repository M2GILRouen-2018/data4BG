      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": "To evaluate the impact of cilostazol on the angiographic and clinical outcomes in patients undergoing percutaneous coronary intervention (PCI) with stents and treated with aspirin and thienopyridine."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A total of 11 randomized controlled trials including 8,525 patients comparing triple antiplatelet therapy (aspirin, thienopyridine and cilostazol) with standard dual antiplatelet therapy were included in the analysis. The primary end points were in-segment late loss and angiographic restenosis at angiographic follow-up. Secondary end points included mortality, stent thrombosis, target lesion revascularization (TLR) and major adverse cardiac events (MACE)."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Triple antiplatelet therapy was associated with a significant reduction in late loss [weighted mean difference 0.14, 95% confidence interval (CI) 0.08-0.20; p < 0.001] and angiographic restenosis [odds ratio (OR) 0.58, 95% CI 0.48-0.71; p < 0.001]. Addition of cilostazol to dual antiplatelet therapy was associated with a significant reduction in TLR (OR 0.56, 95% CI 0.41-0.77; p < 0.001) and MACE (OR 0.72, 95% CI 0.60-0.86; p < 0.001) with no differences in mortality (p = 0.29), stent thrombosis (p = 0.60) or bleeding episodes (p = 0.77)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Cilostazol in addition to dual antiplatelet therapy appears to be effective in reducing the risk of restenosis and repeat revascularization after PCI without any significant benefits for mortality or stent thrombosis."
          }
        ]
      },
