      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To survey the role of IL-18 in the pathogenesis of allergic rhinitis, and to discuss the mechanism of specific immunotherapy (SIT)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "The serum levels of IL-18 in patients with allergic rhinitis and the health control were detected by ELISA before and after SIT (for l year)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT",
          "content": "The levels of IL-18 in patients before SIT were (88.33 +/- 35. 95)ng/L, significantly lower than that in healthy control(149 +/- 47.37)ng/L, and the level after SIT (199.22 +/- 58.82 )ng/L was significantly higher than that before SIT. There was no significant difference between the healthy after-SIT."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "IL-18 plays an important role in the pathogenesis of allergic inflammation and the SIT therapy."
        }
      ]},
