      "Abstract": {
        "CopyrightInformation": "Copyright © 2014 American Society for Reproductive Medicine. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To analyze follicular fluid leptin (FFL) levels, abdominal obesity, and insulin resistance as predictors of in vitro fertilization (IVF)-intracytoplasmic sperm injection (ICSI) outcome."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN",
            "content": "Observational study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "SETTING",
            "content": "Academic medical center."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "PATIENT(S)",
            "content": "A sample of 130 infertile women aged 26-40 years without polycystic ovary syndrome."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "INTERVENTION(S)",
            "content": "Measurement of FFL levels in controlled ovarian hyperstimulation cycles with an antagonist and agonist protocol for IVF-ICSI."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURE(S)",
            "content": "Live birth rate."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULT(S)",
            "content": "Mean FFL values were significantly higher in pregnancies not ending in a live birth, even after adjustment for waist circumference and insulin resistance. A multivariable model obtained with the use of logistic binary regression analysis showed that waist circumference and insulin resistance had no influence over IVF-ICSI outcomes, but a higher number of follicles, lower serum progesterone levels on the day before α-hCG administration, and lower FFL concentrations were significantly associated with a higher probability of having a live birth. The multivariate model reached a sensitivity of 87% and a specificity of 71% for predicting the possibility of pregnancy ending in a live birth."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION(S)",
            "content": "High FFL levels were associated with abdominal obesity, insulin resistance, and a lower live birth rate after IVF-ICSI. Further investigations are warranted to define the precise roles of leptin, obesity, and insulin resistance on IVF-ICSI outcomes."
          }
        ]
      },
