      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 Elsevier España, S.L. y SEEIUC. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To determine the prevalence of metabolic syndrome (MS) and its risk factors in patients with Acute Ischemic Coronary Syndrome (AICS) in a tertiary hospital."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "A total of 65 patients admitted to Cardiac Intensive Care Unit with myocardial infarction or unstable angina participated. MS was diagnosed in accordance to the Adult Treatment Panel III (ATPIII) criteria."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The total prevalence of MS was 84.6% (95% CI: 75.6 to 93.6). MS was more frequent in women, persons with obesity according to the body mass index (BMI), family background diabetes, and dyslipidemia. Phenotype predictors of MS were: BMI (OR=2.12, 95% CI: 1.24, 3.17) and familiar history of dyslipidemia (OR=0.026, 95% CI: 0.003, 0.587)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "The prevalence of MS with AICS is higher than that reported in other populations. This fact is alarming if this risk is maintained in the Mexican population."
          }
        ]
      },
