      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To determine the minimally modified electronegative LDL (LDL-) and its autoantibodies in coronary syndromes."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN AND METHODS",
          "content": "LDL(-) and its autoantibodies were determined by ELISA in patients with acute (ACS, unstable angina; AMI, acute myocardial infarction) and chronic coronary syndromes (stable angina, SA) and compared to subjects without coronary disease (controls). Results are expressed as median of LDL- (microg/mL) and anti-LDL(-) IgG (OD405 nm)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The concentrations of LDL(-) were higher in patients with coronary disease (ACS: 40.7 microg/mL; SA: 35.0 microg/mL) as compared to controls (21.6 microg/mL). The highest LDL- concentrations were found in patients with AMI (41.8 microg/mL). Anti-LDL(-) IgG was elevated in ACS (1.143) in relation to CCS (0.527) and controls (0.467). A positive correlation was observed between anti-LDL- IgG and CRP levels (r = 0.34, p <0.01) in the studied groups."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "LDL(-) and anti-LDL(-) autoantibodies may be useful markers to follow patients with high risk for coronary events."
        }
      ]},
