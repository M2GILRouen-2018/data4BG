      "Abstract": {
        "CopyrightInformation": "© 2017 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "To determine the effects of ropinirole on manic switching and disease severity in bipolar disorder."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "A cross-sectional survey was conducted in 23 bipolar depressed patients using ropinirole combination therapy (Young Mania Rating Scale [YMRS], Bipolar Inventory of Symptoms Scale [BISS]). Retrospective Clinical Global Impression of Change (CGI-C) and CGI-S (Severity) were captured via chart review."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "FINDINGS",
            "content": "One patient (4.3%) experienced induction of mania (YMRS). All patients responded or partially responded to ropinirole (CGIs). YMRS and BISS mania scores were correlated."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "Ropinirole has a low rate of manic switching and significantly reduces bipolar depression severity."
          }
        ]
      },
