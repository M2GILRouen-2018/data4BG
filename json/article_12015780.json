      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "Label": "UNLABELLED",
          "content": "The aim of this study is to determine whether use of supplemental registered nurses (SRNs) from agencies is associated with patients' satisfaction."
        },
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Employment of SRNs is common, but little is known about whether their use is associated with patients' satisfaction with hospital care."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "Cross-sectional survey data from nurses in 427 hospitals were linked to American Hospital Association data and patient data from the Hospital Consumer Assessment of Healthcare Providers and Systems survey."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "We found little evidence that patients' satisfaction with care is related to the use of SRNs. After other hospital and nursing characteristics were controlled, greater use of SRNs was not associated with patients' global satisfaction, including whether they would rank their hospital highly or recommend their hospital, nor was it associated with nurse communication, medication explanation, or pain control."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Employment of SRNs does not detract from patients' overall satisfaction or satisfaction with nurses specifically."
        }
      ]},
