      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Ultrasonography (US) is the diagnostic modality of choice during work-up for ovarian torsion, although computed tomography (CT) may be used. We examined the utilization of CT in girls with ovarian torsion, and determined which patients are most likely to undergo this study."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The Nationwide Emergency Department Sample dataset was searched for patients <18 years who presented with ovarian torsion from 2006 to 2012. Hospitals were categorized by the volume of pediatric patients seen."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "A total of 1279 patients were identified. Seven hundred twelve (56%) were seen at adult hospitals, 154 (12%) at pediatric privileged, and 413 (32%) at pediatric hospitals. Patients cared for in a pediatric or pediatric privileged hospital had more US alone performed to diagnose ovarian torsion (p < 0.01)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Girls seen at pediatric hospitals are more likely to undergo US for work-up of ovarian torsion."
          }
        ]
      },
