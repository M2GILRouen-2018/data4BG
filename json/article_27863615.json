      "Abstract": {
        "CopyrightInformation": "Published by Elsevier Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The aim of this study was to investigate the effect of Lavender essence inhalation on severity of labor pain and duration of labor."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS AND MATERIALS",
            "content": "This single-blind, randomized clinical trial was conducted on 120 pregnant women in two groups. The experimental group received 2 drops of Lavender essence inhaled at three stages (4-5, 6-7, 8-9 cm cervical dilation) and severity of the labor pain and duration of labor was measured before and after intervention. The control group was treated with distilled water as a placebo in the similar ways, too."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The results showed that difference in the labor pain before and after intervention in two groups was significant (P = 0/001). But there was no difference in mean duration of the active phase and the second stage of labor between the two groups."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Lavender essence aromatherapy may be an effective therapeutic option for pain management for women in labor."
          }
        ]
      },
