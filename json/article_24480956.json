      "Abstract": {
        "CopyrightInformation": "© The Author(s) 2015.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To investigate the effect of combined prophylactic ramosetron and total intravenous anaesthesia (TIVA) on postoperative nausea and vomiting (PONV), compared with sevoflurane anaesthesia without prophylactic antiemetics, in female patients undergoing thyroidectomy."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Female patients were randomized between the sevoflurane group (anaesthesia maintained with sevoflurane) or TIVA\u2009+\u2009ramosetron group (TIVAR; 0.3\u2009mg ramosetron just before anaesthesia induction, remifentanil and propofol anaesthesia). Incidence and severity of PONV and use of rescue antiemetics were recorded during the first 24\u2009h after surgery."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "In the early postoperative period (0-6\u2009h), the incidence of PONV, severe emesis and rescue antiemetic use were significantly lower in the TIVAR group (n\u2009=\u200936) than in the sevoflurane group (n\u2009=\u200936). In the late postoperative period (6-24\u2009h), the incidence of severe emesis was significantly lower in the TIVAR group than in the sevoflurane group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A combination of TIVA and prophylactic ramosetron decreases early PONV and late postoperative severe emesis compared with sevoflurane anaesthesia."
          }
        ]
      },
