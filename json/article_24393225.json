      "Abstract": {
        "CopyrightInformation": "© 2013, Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "PURPOSE",
            "content": "The purpose of this study was to explore nurses' aims when managing postoperative pain and whether reported aims reflect actual practices."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "DESIGN AND METHODS",
            "content": "Participant observation was used to collect data regarding nurses' (n = 17) pain management practices. Nurses (n = 19) were asked: When managing postoperative pain, what is your overall aim?"
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Around half the participants (n = 10) aimed for patients to be comfortable while others aimed for a pain score of 2-3 (n = 7), or below 5 (n = 2). Observed practices matched aims for just more than half the participants (n = 9)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "PRACTICE IMPLICATIONS",
            "content": "There is evidence of individual variation in practices. This may impact on the care provided."
          }
        ]
      },
