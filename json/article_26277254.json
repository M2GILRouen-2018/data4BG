      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Ireland Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The purpose of our study was to evaluate the effects of six weeks of Pilates regarding functional balance, fear of falling and pain in community living women older than 65 years old with chronic low-back pain."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "STUDY DESIGN",
            "content": "A single blind controlled randomized trial of six weeks of Pilates in addition to physiotherapy treatment (n=50) vs. physiotherapy treatment alone (n=47) was conducted on 97 community living women (71.14 ± 3.30 years) with chronic low-back pain (CLBP)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MAIN OUTCOME MEASURES",
            "content": "Main outcome measures were fear of falling (FoF), assessed by the Falls Efficacy Scale-international; functional mobility and balance, measured with the Timed up and Go Test; and pain, evaluated using the numeric rating scale."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Only the Pilates group showed improvement in FoF (ES; d=.68) and functional mobility and balance (ES; d=1.12) after treatment, and also had better results in pain (ES; d=1.46) than the physiotherapy-only group."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Six weeks of Pilates exercises may be effective in fall prevention through the improvement of FoF, functional balance, and pain in Spanish women over 65 years old with CLBP."
          }
        ]
      },
