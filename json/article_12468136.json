      "Abstract": {
        "CopyrightInformation": "Copyright 2002 Elsevier Science Ireland Ltd.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To assess the efficacy of dexketoprofen (DEX) in reducing pain at different stages of the hysteroscopic procedure in comparison with local anaesthesia in menopausal women."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Menopausal patients affected by uterine bleeding submitted to diagnostic hysteroscopy, were randomised to receive either 25 mg DEX tablet (n = 148) or intracervical injection of 5 ml mepivacaine 2% (n = 150). Pain suffered during the procedure itself and 30, 60, 120 min after, was scored on the 11 point Visual Analogic Scale, recorded and analysed."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "No statistical difference were noted during the procedure itself in both groups of treatment. Patients treated with DEX has significantly less postoperative pain."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "DEX is not superior to mepivacaine in reducing the discomfort of the procedure but does significantly reduce postoperative pain."
          }
        ]
      },
