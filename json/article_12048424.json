      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "The objective of this case series was to determine if severe phantom limb pain could be reduced with oral methadone."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "Four cases of phantom limb pain refractory to multiple treatment modalities were treated with oral methadone."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "Pain clinic at a major university medical center."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENTS",
          "content": "Four patients with severe, intractable phantom limb pain."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION",
          "content": "Oral methadone was administered, starting with a low dose of 2 to 5 mg twice a day or three times a day and slowly titrated upward to achieve pain relief."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "OUTCOME MEASURES",
          "content": "Repeated administration of a visual analog scale for pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "RESULTS AND CONCLUSIONS",
          "content": "Administration of oral methadone may be of value in the treatment of phantom limb pain; controlled clinical trials would be appropriate to verify this observation."
        }
      ]},
