      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To investigate whether there were any differences in the quality of life, sexual function, and self-esteem of patients who underwent total laparoscopic hysterectomy (TLH) (n=42) and total abdominal hysterectomy (TAH) (n=42)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "All premenopausal patients who underwent TLH or TAH because of benign uterine disorders were enrolled. The sexual function and quality of life status were assessed preoperatively and 6 months postoperatively using three standardized validated questionnaires: the Arizona Sexual Experiences Scale (ASEX), the Symptom Checklist-90-Revised (SCL-90-R), and the Rosenberg Self-Esteem Scale (RSES)."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Preoperative ASEX, SCL-90-R and RSES scores were not different among the hysterectomy subgroups. The postoperative SCL-90-R scores were also not different among the hysterectomy subgroups. The postoperative RSES scores were significantly lower (p<0.05) than the preoperative scores for all procedures (indicating improved self-esteem) but did not differ among the groups. The postoperative ASEX scores were significantly decreased (p<0.01) as compared with the preoperative scores (indicating improved sexual function). When the average score of each item of the ASEX score was compared in both groups, significant differences were observed in sexual drive and arousal in the laparoscopy group (p<0.01)."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "Women undergoing TLH for benign uterine disease may have better outcomes related to certain sexual function parameters than women undergoing TAH."
        }
      ]},
