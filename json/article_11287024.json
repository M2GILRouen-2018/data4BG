      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To compare the pain levels during egg collection and the subsequent postoperative side effects in patients receiving a paracervical block (PCB) with and without conscious sedation."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "A prospective, randomized, double-blind, and placebo-controlled study."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "A tertiary assisted reproduction unit."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PATIENT(S)",
          "content": "150 patients undergoing egg collection."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "INTERVENTION(S)",
          "content": "Randomized to receive PCB only (control group) and PCB in conjunction with conscious sedation (sedation group)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MAIN OUTCOME MEASURE(S)",
          "content": "Vaginal and abdominal pain levels; severity of postoperative side effects."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULT(S)",
          "content": "The median pain levels during vaginal punctures were 12.0 (2.5th--97.5th centiles: 0--84.3) and 30.0 (2.5th--97.5th centiles: 0--100) in the sedation and placebo groups, respectively. The corresponding median abdominal pain levels were 16.5 (2.5th--97.5th centiles: 0--100) and 43.0 (2.5th--97.5th centiles: 0--100). The pain levels were significantly higher in the placebo group than the sedation group. There were no significant differences between the two groups in the severity of nausea, vomiting, dizziness, and drowsiness."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION(S)",
          "content": "Patients who received only a PCB during the egg collection experienced 2.5 times higher levels of vaginal and abdominal pain as compared to those who received both PCB and conscious sedation. The use of PCB along is not recommended for all patients but it may be considered with selected patients after they have been given extensive counseling."
        }
      ]},
