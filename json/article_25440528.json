      "Abstract": {
        "CopyrightInformation": "© 2014 International Council of Nurses.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Intensive care unit nurses have more ergonomic risks than nurses working in other units in hospital."
          },
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Although musculoskeletal disorders are common among intensive care nurses, studies on the prevalence of symptoms, as well as associated factors, are scarce."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "AIM",
            "content": "This is a cross-sectional study to investigate the prevalence of musculoskeletal symptoms and associated factors in intensive care nurses."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The study population comprised 1515 nurses working in the intensive care units of public, private and university hospitals in Turkey. The study sample included 323 nurses selected by stratified random sampling. Data were obtained by a tailored data collection form, a workplace observation form and a Rapid Upper Limb Assessment tool to delineate ergonomic risks. Statistical Package for the Social Sciences 21.0 software was used in the statistical analysis."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "The highest prevalence for the musculoskeletal symptoms of the nurses was in the legs, lower back and back. Most of the nurses had encountered musculoskeletal pain or discomfort related to the previous month. The risky body movements that were frequently performed by the nurses during a shift were 'turning the patient' and 'bending down'."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "DISCUSSION",
            "content": "The final Rapid Upper Limb Assessment score for the patient turning movement was found to be higher than for the bending down movement."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "Musculoskeletal symptoms, which may occur in any region of the body, are mainly associated with organizational factors, such as type of hospital, type of shift work and frequency of changes in work schedule, rather than with personal factors."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "IMPLICATIONS FOR NURSING AND HEALTH POLICY",
            "content": "Nursing administrators should determine the ergonomic risks of intensive care unit nurses by using Rapid Upper Limb Assessment tool. Health policy makers should develop occupational health teams, and 'ergonomic risk prevention programs' should be implemented throughout the units."
          }
        ]
      },
