      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Chengal is a resistant rainforest hardwood that is commonly used in South-East Asia for the construction of boats, bridges, house structures and furniture. It contains oligostilbenoids, phenolics, quinones and resins."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIMS",
          "content": "To describe a case of occupational asthma (OA) related to chengal wood dust."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The patient was evaluated clinically for asthma in relation to occupational history, serial peak flow monitoring and specific inhalation challenge (SIC) test."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Peak flow monitoring showed significant deterioration during exposure to chengal wood dust at work. SIC test resulted in an isolated immediate asthmatic reaction."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Exposure to chengal wood dust can lead to OA and possibly rhinitis. The underlying mechanism should be investigated."
        }
      ]},
