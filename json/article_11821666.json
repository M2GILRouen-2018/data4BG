      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "This study aimed to evaluate the value of testing pudendal nerve conduction in men with erectile dysfunction."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DESIGN",
          "content": "This open prospective study was conducted on 150 men with documented erectile dysfunction of at least 6 mo of duration, all of whom underwent pudendal nerve conduction by the same investigator."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Only patients with erectile dysfunction and low back pain (n = 9) showed statistically significant prolonged pathologic pudendal nerve conduction latency of 43.1 msec/div (SD +/- 11.3 msec/div, P < 0.05). There were no correlations between the pudendal nerve conduction latency in patients suffering from erectile dysfunction associated with diabetes mellitus, local trauma, pelvic surgery, or antihypertensive drugs."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Pudendal nerve conduction may contribute valuable information to the evaluation of patients with erectile dysfunction caused by neurologic deficits as manifested by low back pain."
        }
      ]},
