      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "PURPOSE",
          "content": "To evaluate the effectiveness of 8-week low-frequency plantar vibration training on patients with sensorimotor diabetic peripheral neuropathy (DPN)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "PARTICIPANTS",
          "content": "Twelve patients took part in the investigation."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "An increase of the nerve conductive velocity of soral and peroneal nerves of feet, increased postural stability, and disappearance of the pain and tingling were observed."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The obtained results provide evidence for beneficial effects of 8-week plantar vibration training in patients with DPN."
        }
      ]},
