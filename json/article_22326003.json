      "Abstract": {
        "CopyrightInformation": "Copyright © 2011 European Foot and Ankle Society. Published by Elsevier Ltd. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "Plantar fasciitis is a common diagnosis in patients presenting with heel pain. The presence of co-existing calcaneal spurs has often been reported but confusion exists as to whether it is a casual or significant association."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The lateral heel radiographs of nineteen patients with a diagnosis of plantar fasciitis and nineteen comparison subjects with a lateral ankle ligament sprain matched for age and sex, were reviewed independently by two observers. Objective measurements of calcaneal spur length and a subjective grading of spur size were recorded."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "There was a significantly higher prevalence of calcaneal spurs in the cases than the comparison group (89% versus 32%; McNemar chi-square=9.09, df=2, p=0.00257). There was good inter- and intra-observer agreement."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "The current study has demonstrated a significant association between plantar fasciitis and calcaneal spur formation. Further research is warranted to assess whether the association is causal."
          }
        ]
      },
