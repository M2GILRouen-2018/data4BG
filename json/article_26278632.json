      "Abstract": {
        "CopyrightInformation": "Copyright © 2015 Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Gabapentin, an anticonvulsant, neuroleptic, and pain medication, is widely used in both adults and children for management of epilepsy, bipolar illness, and neuropathic pain. Gabapentin use has also been recommended for hyperemesis gravidarum and restless leg syndrome in pregnant mothers."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "Although gabapentin use is deemed safe during pregnancy, no clinical reports of gabapentin withdrawal syndrome in a neonate have been described."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "We present a newborn who showed signs of withdrawal after prolonged in utero exposure to gabapentin."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CLINICAL IMPLICATIONS",
            "content": "Clinicians should be aware of possible withdrawal symptoms from drugs such as gabapentin, administered to mothers during pregnancy. We also encourage the gradual tapering of gabapentin in neonates over weeks to months similar to the adult population."
          }
        ]
      },
