      "Language": "eng",
      "Abstract": {
        "CopyrightInformation": "Copyright © 2016 The Authors. Published by Elsevier Inc. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": "QT interval prolongation has frequently been observed in patients with advanced liver disease. We investigated the influence of inhalation anesthetics on the corrected QT (QTc) interval prolongation during surgery in patients undergoing living-donor liver transplantation."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "Our study included 43 patients who were assigned to 2 groups: sevoflurane (n = 22) or desflurane anesthesia (n = 21). QTc intervals were measured at perioperative determined time points and calculated using Fridericia's formula."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Intraoperative QTc intervals increased during the peri-intubation period versus baseline (P = .003) and were prolonged during the peri-reperfusion period (P < .001). However, there was no significant difference in intraoperative QTc interval changes between patients given sevoflurane or desflurane (P = .59)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "In this prospective observational study, there was no significant difference in QTc intervals between sevoflurane and desflurane. QTc intervals increased during intubation and reperfusion relative to preoperative values in patients given either sevoflurane or desflurane."
          }
        ]
      },
