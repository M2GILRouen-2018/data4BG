      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To describe a case of jejunal obstruction due to metastatic renal adenocarcinoma."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "A 66-year-old male who underwent nephrectomy 23 months earlier developed jejunal obstruction due to metastasis of the renal adenocarcinoma. The literature is reviewed and the uncommon form and site of presentation of this case are underscored and the different treatments are discussed."
        }
