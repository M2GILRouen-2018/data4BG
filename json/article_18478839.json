      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "We describe 11 cases of myopericarditis complicating bacterial tonsillitis."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "We performed a retrospective study of all cases of myopericarditis treated at one hospital during the years 2005 and 2006."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "The patients were all young men. The average latency from the onset of throat pain to the onset of chest pain was 4.6 days. All patients complained of chest pain. The most common electrocardiographic finding was transient ST segment elevations. The levels of cardiac enzymes and troponin were elevated in all cases."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Otolaryngologists should be aware of this rare entity. Additional studies are indicated to evaluate the exact incidence of myopericarditis associated with acute streptococcal tonsillitis."
        }
      ]},
