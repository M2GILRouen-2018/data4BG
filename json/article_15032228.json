      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "To report a case demonstrating a radiolucency of developing adjacent to an unfilled post space."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "SUMMARY",
          "content": "A mandibular left first molar was root filled before post-space preparation. The tooth was restored coronally but the post space was left empty, and 14 months later, pain and furcal radiolucency developed. Cleaning, shaping, medicating and filling the post space resulted in the resolution of symptoms and healing of the radiolucency."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "KEY LEARNING POINTS",
          "content": "Post space should be prepared under conditions of asepsis. A post space must not be allowed to remain empty when a tooth is restored."
        }
      ]},
