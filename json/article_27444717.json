      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Clinical practice guidelines."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To develop the first Canadian clinical practice guidelines for screening and diagnosis of neuropathic pain in people with spinal cord injury (SCI)."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "SETTING",
          "content": "The guidelines are relevant for inpatient and outpatient SCI rehabilitation settings in Canada."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHODS",
          "content": "The CanPainSCI Working Group reviewed evidence to address clinical questions regarding screening and diagnosis of neuropathic pain after SCI. A consensus process was followed to achieve agreement on recommendations and clinical considerations."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Twelve recommendations, based on expert consensus, were developed for the screening and diagnosis of neuropathic pain after SCI. The recommendations address methods for assessment, documentation tools, team member accountability, frequency of screening and considerations for diagnostic investigation. Important clinical considerations accompany each recommendation."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "The expert Working Group developed recommendations for the screening and diagnosis of neuropathic pain after SCI that should be used to inform practice."
        }
      ]},
