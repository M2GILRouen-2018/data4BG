      "Abstract": {
        "CopyrightInformation": "© 2016 Wiley Periodicals, Inc.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Patients diagnosed with amyotrophic lateral sclerosis (ALS) generally have a limited medical history and a normal body mass index, raising the possibility of a premorbid ALS phenotype."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The prevalence of cardiometabolic factors was analyzed in 58 ALS patients via comprehensive cardiovascular assessments and compared with Australian population norms."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "ALS patients had good cardiac fitness and no reported cardiovascular events. Average blood pressure, heart rate, PR interval, and corrected QT interval were in the normal range. There were significantly fewer obese women in the ALS cohort (13.6%, P\u2009<\u20090.05) and more men with a normal body mass index than in the general population (47.2%, P\u2009<\u20090.001). The percentage of individuals who had never smoked was greater for the ALS cohort (55.8%, P\u2009≤\u20090.001), and the prevalence of dyslipidemia was lower (38.7%) compared with the general population (74.4%, P\u2009<\u20090.001)."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "ALS patients had good cardiometabolic health, with evidence of a reduced vascular risk profile. Muscle Nerve 56: 721-725, 2017."
          }
        ]
      },
