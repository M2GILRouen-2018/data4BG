      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVES",
          "content": "To provide assessment guidelines and management strategies for symptoms affecting nutritional status in patients with cancer."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "DATA SOURCES",
          "content": "Published articles, book chapters, and research reports."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Patients with cancer experience a variety of symptoms that affect their nutritional status. It is possible to reduce the impact of these symptoms on the nutritional status of the patient through effective symptom management strategies, nutritional assessments, and interventions."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "IMPLICATIONS FOR NURSING PRACTICE",
          "content": "The nutritional status of cancer patients can be supported by anticipating and managing disease- and treatment-related symptoms. Nurses contribute actively to the achievement of positive patient outcomes when they manage symptoms in a manner that enhances nutrition."
        }
      ]},
