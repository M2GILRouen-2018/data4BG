      "Language": "eng",
      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "OBJECTIVE",
          "content": "To report femoral nerve dysfunction caused by focal iliopsoas muscle injury and treated by performing tenectomy of the muscle insertion."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "STUDY DESIGN",
          "content": "Case report."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "ANIMALS",
          "content": "A 4-year-old, castrated male, English Mastiff."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Iliopsoas muscle injury caused femoral nerve deficits and severe pain. Focal injury was not detected by ultrasonography or computed tomography but was visible on magnetic resonance (MRI) images. Tenectomy of the insertion of the iliopsoas muscle relieved signs of pain."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSIONS",
          "content": "Femoral nerve dysfunction may occur with iliopsoas muscle injury."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CLINICAL RELEVANCE",
          "content": "Iliopsoas muscle injury should be considered in patients with hip pain and MRI is a useful test for diagnosis. Tenectomy may be indicated for relief of chronic iliopsoas muscle pain."
        }
      ]},
