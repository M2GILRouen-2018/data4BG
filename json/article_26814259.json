      "Abstract": {
        "CopyrightInformation": "© 2015 American Academy of Pain Medicine. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "BACKGROUND",
            "content": " Curcuminoids are natural products with potent anti-inflammatory and antioxidant properties. There have been a number of reports on the analgesic effects of curcuminoids in clinical trials, yet data have not been fully conclusive."
          },
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVES",
            "content": " To provide the highest level of evidence on the efficacy of curcuminoids in patients with painful conditions through meta-analysis of data from randomized controlled trials (RCTs)."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": " A systematic review and meta-analysis was conducted using data reported by RCTs. The primary efficacy measure was pain intensity or algofunctional status. Treatment effect was summarized with standardized mean difference (SMD) calculated from differences in means of pain measures between treatment and control groups using a random-effects model."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": " A total of eight RCTs met our inclusion criteria that included 606 randomized patients. Curcuminoids were found to significantly reduce pain (SMD:\u2009-0.57, 95% CI:\u2009-1.11 to\u2009-0.03, P\u2009=\u20090.04). This pain-relieving effect was found to be independent of administered dose and duration of treatment with curcuminoids, and was free from publication bias. Curcuminoids were safe and well tolerated in all evaluated RCTs."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": " Curcuminoids supplements may be a safe and effective strategy to improve pain severity, by warranting further rigorously conducted studies to define the long-term efficacy and safety."
          }
        ]
      },
