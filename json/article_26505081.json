      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "BACKGROUND",
          "content": "Breakthrough cancer pain (BTCP) is complex and severe, affecting quality of life and increasing hospitalisation. BTCP has a rapid onset that requires fast acting medication with minimal side effects."
        },
        {
          "NlmCategory": "OBJECTIVE",
          "Label": "AIM",
          "content": "This article compares the effectiveness of intranasal fentanyl spray (INFS) and oral transmucosal fentanyl citrate (OTFC) and their alleviation of BTCP within 10 minutes of administration."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "METHOD",
          "content": "The article considers pharmacokinetic and bioavailability studies demonstrating the efficacy of the route of administration, time-based effects of pain relief as well as patient preference."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The data collected indicates that INFS is more effective than OTFC for BTCP."
        }
      ]},
