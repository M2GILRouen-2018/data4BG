      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "The objective of this study was to determine the cell surface hydrophobicity of 40 oral Candida albicans isolates obtained from smokers, diabetics, asthmatics using steroid inhalers, and healthy individuals, following brief exposure to subtherapeutic concentrations of chlorhexidine gluconate."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "MATERIALS AND METHODS",
            "content": "Forty C. albicans oral isolates (10 isolates each from smokers, diabetics, asthmatics using steroid inhalers, and healthy individuals) were exposed to 3 subtherapeutic concentrations of chlorhexidine gluconate (0.00125, 0.0025, and 0.005%) for 30 min. Thereafter, the antiseptic was removed and the cell surface hydrophobicity was measured by a biphasic aqueous-hydrocarbon assay."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Compared to the unexposed controls, the cell surface hydrophobicity of C. albicans isolates was suppressed by 5.40% (p > 0.05), 21.17% (p < 0.05), and 44.67% (p < 0.05) following exposure to 0.00125, 0.0025, and 0.005% chlorhexidine gluconate, respectively."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSIONS",
            "content": "A brief period of transient exposure to subtherapeutic concentrations of chlorhexidine gluconate may modulate the cell surface hydrophobicity of C. albicans isolates and thereby may reduce candidal pathogenicity."
          }
        ]
      },
