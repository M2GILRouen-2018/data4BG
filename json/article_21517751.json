      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 S. Karger AG, Basel.",
        "AbstractText": [
          {
            "NlmCategory": "OBJECTIVE",
            "Label": "OBJECTIVE",
            "content": "To present an atypical manifestation in a patient with pheochromocytoma."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "CLINICAL PRESENTATION AND INTERVENTION",
            "content": "A 48-year-old man presented with chest pain, fever and leukocytosis. Elevated cardiac biomarkers and diffuse ST-T abnormalities on electrocardiography suggested myocardial infarction. However, coronary angiography showed normal coronary arteries. Abdominal computed tomography revealed a left adrenal tumor of 6.7 × 6.8 cm. Paroxysmal fluctuation of blood pressure raised the suspicion of pheochromocytoma, which was further supported by elevated urine catecholamine levels. He underwent left adrenalectomy and pathological findings confirmed the diagnosis."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Pheochromocytoma should be considered as part of the differential diagnosis in a patient with symptoms suggestive of both acute coronary syndrome and sepsis."
          }
        ]
      },
