      "Abstract": {"AbstractText": [
        {
          "NlmCategory": "BACKGROUND",
          "Label": "INTRODUCTION",
          "content": "A young adult patient was admitted for signs and symptoms of acute abdomen."
        },
        {
          "NlmCategory": "METHODS",
          "Label": "MATERIALS AND METHODS",
          "content": "Urgent CT scan was performed and small bowel volvulus was confirmed. The \"whirl sign\" diagnostic of small bowel volvulus was present."
        },
        {
          "NlmCategory": "RESULTS",
          "Label": "RESULTS",
          "content": "Furthermore, the accompanying superior mesenteric vein was noted to be truncated at the point of torsion."
        },
        {
          "NlmCategory": "CONCLUSIONS",
          "Label": "CONCLUSION",
          "content": "The \"venous cut-off sign\" can be a useful adjunct sign to the diagnosis."
        }
      ]},
