      "Abstract": {
        "CopyrightInformation": "Copyright © 2012 SPLF. Published by Elsevier Masson SAS. All rights reserved.",
        "AbstractText": [
          {
            "NlmCategory": "BACKGROUND",
            "Label": "INTRODUCTION",
            "content": "Few data on regional variations in asthma prevalence are available in France."
          },
          {
            "NlmCategory": "METHODS",
            "Label": "METHODS",
            "content": "The study was carried out during the academic year 2005-2006 in a random sample of around 20,000 children in the last year of nursery school. The lifetime prevalence of asthma and the preceding year prevalences of asthma-like symptoms and treatment for wheezing or asthma attacks were estimated by region."
          },
          {
            "NlmCategory": "RESULTS",
            "Label": "RESULTS",
            "content": "Overall, the lifetime prevalence of asthma was 9.8 % and the past-year prevalence of wheezing was 10.7 %. An increasing trend in prevalence was observed from Eastern to Western France and in overseas territories. The regional variations in past-year prevalence of wheezing remained when adjusting for gender, family structure and the number of siblings. Among children who had wheezed or received a treatment in the past year, 42 % had experienced frequent or severe symptoms."
          },
          {
            "NlmCategory": "CONCLUSIONS",
            "Label": "CONCLUSION",
            "content": "Large regional variations in asthma prevalence among young children in France exist."
          }
        ]
      },
